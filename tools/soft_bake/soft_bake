#!/usr/bin/env python3
"""Deterministic offline baseline; compile only this small CLI against existing common."""
import argparse, hashlib, json, pathlib, shlex, subprocess, tempfile, os
ROOT = pathlib.Path(__file__).resolve().parents[2]
p = argparse.ArgumentParser()
p.add_argument('--census', action='store_true', required=True)
p.add_argument('--fr3-dir', type=pathlib.Path, default=ROOT/'out/jak1/fr3')
p.add_argument('--out', type=pathlib.Path, default=ROOT/'data/soft-baseline/baseline.json')
p.add_argument('--level')
a = p.parse_args()
build = ROOT/'build'
binary = build/'tools/soft_bake/soft_bake'
binary.parent.mkdir(parents=True, exist_ok=True)
source = ROOT/'tools/soft_bake/main.cpp'
common = build/'common/libcommon.so'
if not binary.exists() or binary.stat().st_mtime < max(source.stat().st_mtime, common.stat().st_mtime):
    commands = subprocess.check_output(['ninja','-C',str(build),'-t','commands','mesh_audit'], text=True).splitlines()
    compile_cmd = next(c for c in commands if 'main.cpp.o -c' in c and '/mesh_audit/' in c)
    args = shlex.split(compile_cmd)
    # Reuse tree includes/defines, remove dependency-output flags and replace source/object.
    filtered=[]; i=0
    while i<len(args):
        if args[i] in ('-MT','-MF'): i+=2; continue
        if args[i]=='-MD': i+=1; continue
        filtered.append(args[i].replace('tools/mesh_audit/CMakeFiles/mesh_audit.dir/main.cpp.o', 'tools/soft_bake/main.o').replace(str(ROOT/'tools/mesh_audit/main.cpp'),str(source)))
        i+=1
    subprocess.run(filtered+['-ffp-contract=off'],cwd=build,check=True)
    link=shlex.split(commands[-1]); start=link.index('/usr/bin/c++'); link=link[start:link.index('&&', start)]
    link=[x.replace('tools/mesh_audit/CMakeFiles/mesh_audit.dir/main.cpp.o','tools/soft_bake/main.o').replace('tools/mesh_audit/mesh_audit','tools/soft_bake/soft_bake') for x in link if not x.startswith('-Wl,--dependency-file=')]
    subprocess.run(link,cwd=build,check=True)
files=sorted(a.fr3_dir.glob((a.level or '*')+'.fr3'))
# common.fr3 contains global assets, not a game level.
files=[f for f in files if f.stem not in ('common','GAME')]
if not files: raise SystemExit('No levels found')
sha=lambda f: hashlib.sha256(f.read_bytes()).hexdigest()
levels=[]
with tempfile.TemporaryDirectory(prefix='soft-baseline-', dir=binary.parent) as tmp:
    for f in files:
        before=sha(f); dest=pathlib.Path(tmp)/(f.stem+'.json')
        subprocess.run([str(binary),str(f.resolve()),f.stem,str(dest)],cwd=ROOT,check=True,env={**os.environ, "OG_MESH_WELD":"0"})
        if before!=sha(f): raise SystemExit('Input changed during measurement: '+str(f))
        row=json.loads(dest.read_text());row['source_sha256']=before;levels.append(row)
        print('BASELINE level='+f.stem,flush=True)
refs=[('snow',9,5968,72181),('snow',10,762,2332),('beach',5,10294,90299)]
reference_gaps=0
for name,mat,count,area in refs:
    lev=next((l for l in levels if l['level']==name),None)
    row=lev['census'][mat] if lev else None
    reference_gaps+=int(not row or row['triangles']!=count or abs(round(row['area_m2'])-area)>1)
dens=[l for l in levels if 'density' in l]
drifts=[d for l in levels for d in l.get('drifts',[])]
summary={'census_levels':len(levels),'census_level_gaps':abs(25-len(levels)),
'census_reference_gaps':reference_gaps,'density_levels':len(dens),
'density_gaps':abs(4-len(dens))+sum(not l['density']['eligible_triangles'] for l in dens),
'drift_islands':len(drifts),'drift_gaps':abs(37-len(drifts))+sum(not d['attributed'] for d in drifts),
'published_quantities':sum(len(l['census'])*3 for l in levels)+len(dens)*11+sum(sum(10 for c in d['candidates']) for d in drifts)}
def quantities(value):
    if isinstance(value, dict): return sum(quantities(v) for v in value.values())
    if isinstance(value, list): return sum(quantities(v) for v in value)
    return int(isinstance(value, (int,float)) and not isinstance(value,bool))
summary['published_quantities']=quantities(levels)
result={'schema_version':1,'units_per_metre':4096,'summary':summary,'levels':levels}
text=json.dumps(result,indent=2,sort_keys=True)+'\n'
if json.loads(text)!=result: raise SystemExit('JSON round-trip mismatch')
a.out.parent.mkdir(parents=True,exist_ok=True)
header=a.out.with_name('baseline_json.h')
htext='// GENERATED by tools/soft_bake/soft_bake --census; do not edit.\n#pragma once\nnamespace soft_baseline_data {\ninline constexpr char json_text[] = R"SOFTBASE('+text+')SOFTBASE";\ninline constexpr char sha256[] = "'+hashlib.sha256(text.encode()).hexdigest()+'";\n}\n'
# Each publication is atomic; the hash in the header identifies the exact JSON snapshot.
for dest,content in [(a.out,text),(header,htext)]:
    tmp=dest.with_suffix(dest.suffix+'.tmp');tmp.write_text(content);os.replace(tmp,dest)
print(json.dumps(summary,sort_keys=True))
