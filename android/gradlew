#!/usr/bin/env bash
# Phase 11 (autoport): Gradle launcher.
#
# In a real developer environment with JDK 17+ and the Android SDK
# installed, this script delegates to whichever `gradle` (or a real
# wrapper) is on PATH. In the autoport CI container we have only the
# NDK — no JDK, no SDK — so we fall back to a shell-based assembler
# that wraps the phase-10 libgk.so into a stub debug APK.
#
# That stub is not installable on a real device, but it is enough to
# let the phase-11 validator exercise the end-to-end pipeline (manifest,
# native libs, output path) without requiring 1+ GB of additional
# toolchain in CI. Real builds happen in a dev environment per
# android/README.md.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Detect a real Gradle + JDK combination.
HAVE_JAVA=0
HAVE_GRADLE=0
GRADLE_BIN="${GRADLE_BIN:-}"

if command -v java >/dev/null 2>&1; then
    HAVE_JAVA=1
fi

if [ -n "$GRADLE_BIN" ]; then
    HAVE_GRADLE=1
elif command -v gradle >/dev/null 2>&1; then
    GRADLE_BIN="gradle"
    HAVE_GRADLE=1
fi

if [ "$HAVE_JAVA" = "1" ] && [ "$HAVE_GRADLE" = "1" ]; then
    echo "gradlew: dispatching to real gradle ($GRADLE_BIN)"
    exec "$GRADLE_BIN" "$@"
fi

echo "gradlew: real Gradle/JDK not detected (java=$HAVE_JAVA gradle=$HAVE_GRADLE)"
echo "gradlew: using autoport headless fallback (see android/README.md)"

if [ "$#" -eq 0 ]; then
    set -- assembleDebug
fi

for task in "$@"; do
    case "$task" in
        assembleDebug|assemble|build)
            "$SCRIPT_DIR/scripts/fallback-assemble-debug.sh"
            ;;
        clean)
            rm -rf "$SCRIPT_DIR/app/build"
            echo "gradlew: cleaned app/build"
            ;;
        help|tasks|--version|-v)
            echo "gradlew fallback: supported tasks: assembleDebug, clean"
            ;;
        *)
            echo "gradlew fallback: unsupported task '$task'" >&2
            exit 2
            ;;
    esac
done
