<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 11 (autoport): manifest for the OpenGOAL Android shell.

  Required runtime permissions are limited to storage access for the
  game's data files (the user-supplied PS2 ISO extract). The activity
  itself is a thin wrapper around libgk.so; once a full SDL2/SDL3
  runtime is integrated the activity will extend org.libsdl.app.SDLActivity
  instead of androidx.appcompat.app.AppCompatActivity.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- The game data lives in app-private external storage so we don't
         need legacy WRITE_EXTERNAL_STORAGE on API 29+. The user copies
         the extracted PS2 ISO files to:
           /sdcard/Android/data/org.opengoal.gk/files/iso_data/
         on first launch (the activity prompts if missing). -->
    <uses-permission android:name="android.permission.INTERNET"
                     tools:node="remove"/>

    <!-- External-asset-root feature (autoport 2026-07): the user can point the
         app at an on-storage OpenGOAL folder (shared by all games) holding the
         PS2 ISO extract, fr3 textures, saves and custom assets. Reading that
         arbitrary path needs broad storage access:
           - API >= 30 (Android 11+): MANAGE_EXTERNAL_STORAGE (All Files Access),
             granted via Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION.
           - API <= 29 (Android 10): legacy READ/WRITE_EXTERNAL_STORAGE plus
             requestLegacyExternalStorage so raw filesystem paths still work. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
                     android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
                     android:maxSdkVersion="29"/>

    <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
    <uses-feature android:name="android.hardware.touchscreen"
                  android:required="false"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:hasFragileUserData="false"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenGoal">

        <!-- Phase 17: LoaderActivity is the LAUNCHER. It extracts the
             APK-bundled iso_data to filesDir on first launch, then
             startActivity()s MainActivity. Subsequent launches see the
             sentinel and pass through in milliseconds. -->
        <activity
            android:name=".LoaderActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Phase 18: MainActivity extends org.libsdl.app.SDLActivity. The
             configChanges set mirrors what SDLActivity expects so the SDL
             surface isn't recreated on rotation/uiMode changes (SDL
             handles those internally). launchMode=singleInstance matches
             the SDL example app; together with alwaysRetainTaskState=true
             this keeps the SDL thread alive across task switches.
             preferMinimalPostProcessing avoids the compositor adding
             color/gamma post-processing on top of the GL output.

             Supervisor rollback 2026-05-20 (REDESIGN.md §7 UX corrections):
             screenOrientation = sensorLandscape. jak 1 is a 3D game; the
             previous portrait lock existed only so `adb shell input tap`
             coords from the phase-23 validator would address the touch
             overlay, which has been removed. Primary input is now the
             Bluetooth gamepad via SDL_OpenGamepad. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:alwaysRetainTaskState="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:screenOrientation="landscape"
            android:launchMode="singleInstance"
            android:preferMinimalPostProcessing="true">
            <!-- Tell the framework which .so to load for SDL-style native
                 activities. The Java code loads libgk.so explicitly via
                 System.loadLibrary so this is only advisory metadata. -->
            <meta-data android:name="android.app.lib_name"
                       android:value="gk"/>
        </activity>

        <!-- AGP rewrites the relative class name ".LoaderActivity"
             against the build.gradle.kts `namespace` (org.opengoal.gk),
             but `am start -n <applicationId>/.LoaderActivity` resolves
             the leading-dot form against the *applicationId* (e.g.
             org.opengoal.gk.jak1.LoaderActivity). Those don't match in
             this project because namespace ≠ applicationId. This alias
             exposes the applicationId-prefixed name the phase 17+
             validators (and the launcher shortcut after install) use
             to invoke LoaderActivity. ${applicationId} is substituted
             per flavor by AGP's manifest merger. -->
        <activity-alias
            android:name="${applicationId}.LoaderActivity"
            android:targetActivity="org.opengoal.gk.LoaderActivity"
            android:exported="true"/>

        <!-- Phase E3 (autoport): SaveActivity is invoked by e3_run.sh
             via "am start -n applicationId/.SaveActivity" with the
             "writeTestSaveTo" string extra. It drives the kmemcard
             deterministic save writer through JNI without booting SDL,
             writes the file, and finishes. The validator adb-pulls from
             the path given in the intent extra. -->
        <activity
            android:name=".SaveActivity"
            android:exported="true"
            android:noHistory="true"
            android:screenOrientation="landscape"/>
        <activity-alias
            android:name="${applicationId}.SaveActivity"
            android:targetActivity="org.opengoal.gk.SaveActivity"
            android:exported="true"/>
    </application>
</manifest>
