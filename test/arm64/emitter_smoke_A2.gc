;; Phase A2 — AArch64 emitter byte-pattern smoke source.
;;
;; Each defun below exercises one cluster from the A1 inventory's blocker
;; list and intentionally encodes the patterns whose arm64 codegen this
;; phase had to make real. The cluster comments name the IR forms behind
;; the surface syntax so a later reader can correlate disasm output to
;; specific do_codegen_arm64 bodies in goalc/compiler/IR.cpp.
;;
;; Output of compiling with the arm64 backend lands at
;; `out/jak1/obj/emitter_smoke_A2.o`; the validator wraps that file as
;; raw arm64 bytes for `aarch64-linux-gnu-objdump -d`.

;;
;; A2-mem cluster — IR_LoadConstOffset, IR_StoreConstOffset, IR_GetStackAddr.
;; These exercise the new LDR/STR encoders (via load_goal_gpr / store_goal_gpr).
;;
(defun mem-load ((x int))
  (+ x 7))

;;
;; A2-call cluster — IR_FunctionCall, IR_FunctionAddr (BL placeholder + BLR).
;;
(defun call-add1 ()
  (mem-load 41))

;;
;; A2-float cluster — IR_FloatMath, IR_IntToFloat, IR_FloatToInt.
;; (+ a b) on floats picks FloatMathKind::ADD_SS → addss → arm64 FADD.
;;
(defun float-sum ((a float) (b float))
  (+ a b))

;;
;; A2-asm cluster — IR_AsmRet / IR_AsmAdd via `(.asm.ret)` / `(.asm.add)`.
;; We keep this short to avoid stressing the (incomplete) inline-asm parser;
;; the call+add path already exercises the integer arm64 encoders through
;; the regular IR forms.
;;
(defun asm-ret ((x int))
  (+ x 1))
