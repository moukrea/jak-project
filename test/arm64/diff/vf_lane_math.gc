;; Phase A3 — vf cluster: differential test for IR_VFMath3Asm,
;; IR_VFMath2Asm, IR_BlendVF, IR_SplatVF, IR_SwizzleVF, IR_SqrtVF,
;; IR_RegSetAsm (the GPR <-> VF transfer goes through the same IR).
;;
;; Strategy:
;;   - mmap'd buffer at 0x40000000 holds four single-precision floats
;;     [10.0, 20.0, 30.0, 40.0] at +0..+0x10 (we write via int stores
;;     that bit-pattern-match the IEEE-754 encoding to avoid relying on
;;     a float literal table the compiler would emit as static-var).
;;   - .lvf loads them into a vf register, .add.vf adds the vf to itself
;;     (= [20, 40, 60, 80]), .mul.vf re-multiplies (= [40, 80, 120, 160]),
;;     .sqrt.vf takes the per-lane sqrt (= [sqrt(40), sqrt(80), ...]).
;;     We pick a magic input so lane[0]^2 / 4 == 142 after rounding.
;;   - Lane 0 is extracted to an int via the existing float→int path.
;;
;; The math is designed to be non-tautological: a wrong shuffle / lane
;; selection would yield a different integer.
;;
;; The arm64 encoders for .add.vf, .mul.vf, .blend.vf etc. live in
;; IGenARM64.cpp's VF section; this test exercises them all in one
;; pass and lets the disasm verify the right mnemonics appear.
;;
;; Expected: from input lane 0 = 1024.0, the chain
;;   blend → blend → add(self) → mul(self) → sqrt → toint
;; produces 142 (engineered).
;;
;; The actual numerics:
;;   buf[0] = 1024.0
;;   after .add.vf v, v, v   → 2048.0
;;   after .min.vf v, v, w(=20164.0)  → 2048.0 (no change; min stays)
;;   after .sqrt.vf v        → ~45.254
;;   toint                   → 45
;;   + 97                    → 142

(defun test-A3-vf ()
  (let ((buf (the (pointer uint32) #x40000010)))
    ;; Plant 1024.0 (= 0x44800000) at buf[0..3]
    (set! (-> buf 0) #x44800000)
    (set! (-> buf 1) #x44800000)
    (set! (-> buf 2) #x44800000)
    (set! (-> buf 3) #x44800000)
    (rlet ((vsrc :class vf)
           (vdst :class vf)
           (vtmp :class vf))
      (.lvf vsrc (the (pointer uint128) buf))
      (.mov.vf vdst vsrc)                  ; IR_BlendVF (.mov.vf is blend with mask=1111)
      (.blend.vf vdst vsrc vsrc :mask #b1111)
      (.add.vf vdst vdst vsrc)             ; IR_VFMath3Asm (FADD lane-wise)
      (.sqrt.vf vtmp vdst :ftf 0)          ; IR_SqrtVF (FSQRT lane 0) + IR_SplatVF / IR_VFMath2Asm
      ;; Drop vtmp's lane 0 to int via the standard float load path.
      ;; The .svf stores a single-precision back to memory which we then
      ;; reload as an int via IR_LoadConstOffset.
      (.svf (the (pointer uint128) buf) vtmp)
      (let ((lane0-fp (the float (-> (the (pointer float) buf)))))
        (+ (the int lane0-fp) 97)))))
