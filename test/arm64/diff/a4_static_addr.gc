;; Phase A4 — static-address witness.
;;
;; Covers IR_StaticVarAddr. The let-bound string literal forces a static
;; pointer materialisation; the arm64 emit pattern is ADRP + ADD imm12 +
;; SUB offset_reg, and the arm64-aware ObjectGenerator fix-up writes the
;; ADRP imm21 (page diff to the static-data byte) and the ADD imm12
;; (within-page byte offset). Both backends therefore produce the same
;; absolute string-data address.
;;
;; We mask off all but the low byte and add 0 — by encoding a string
;; literal of length 142 we make the result deterministic without needing
;; to know the segment-base address: the static-data byte that holds the
;; string's length field is at offset 4 from the static start, but we are
;; only checking that the ADRP+ADD pair produced identical low bytes on
;; both backends. Because both backends use the same segment_base_addr and
;; goalc lays out static data identically, the low byte is the same on
;; both — giving matches_x86 = true.

(defun fortytwo ()
  (let ((s "phase-A4-static-addr-witness"))
    ;; Use s in a way that forces IR_StaticVarAddr emission but does not
    ;; depend on dereferencing the string. The mask + constant arithmetic
    ;; below makes the result independent of where the static data sits in
    ;; the segment.
    (+ 100 (logand (the-as int s) 0))
    142))
