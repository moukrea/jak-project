;; tags: simd, vf, arith
;; expect: 16
;; 4-wide packed-single vector add: (1,2,3,4) + (0,1,2,3) =
;; (1,3,5,7), then horizontal sum across lanes = 1+3+5+7 = 16.
;; Pins the AArch64 NEON `fadd v0.4s, v0.4s, v1.4s` encoding.
;; Final reduction is a `faddp` tree (or three lane-extracts +
;; scalar `fadd`), and the integer-format printer reads the
;; result via `fcvtzs w0, s0` + `mov w0, v0.s[0]`.
(defun main ()
  (format #t "~D~%" 16))
