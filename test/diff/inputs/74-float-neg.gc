;; tags: float, arith, neg
;; expect: -5
;; Float negation via the canonical `(- 0.0 x)` lowering. On
;; AArch64 the codegen should recognize this and emit a single
;; `fneg s, s` (which is just a sign-bit XOR) rather than
;; materializing 0.0 into a temp and emitting `fsub`. Cast to
;; int verifies the sign bit actually flipped.
(defun main ()
  (format #t "~D~%" (the int (- 0.0 5.0))))
