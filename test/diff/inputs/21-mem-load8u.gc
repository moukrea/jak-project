;; tags: mem-ops, loads
;; expect: 200
;; Unsigned byte load through a pointer. Exercises LDRB Wd, [Xn]
;; (x86 counterpart: MOVZX r64, BYTE PTR [reg]). The byte 0xC8 has the
;; high bit set; LDRB zero-extends so the printed result is 200, not -56.
;; This is the regression boundary between load8u and load8s codegen.
(defun main ()
  (let ((buf (new 'stack-no-clear 'array uint8 1)))
    (set! (-> buf 0) (the uint8 200))
    (format #t "~D~%" (-> buf 0))))
