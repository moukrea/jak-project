+// ─── Gcollision-wallslide: per-frame collision-state capture ────────────────────
+// Env OG_GWALL_LOG / Android prop debug.opengoal.coll.log — OFF by default.
+// The device has no goalc listener (android_runtime_full.cpp registers Deci2Server
+// with NO accept thread), so the wall-slide+crouch divergence must be read from
+// C++ by byte offset. Field offsets from the x86 listener `&->` oracle (jak1):
+//   *target* -> control            @ +108  (control is a collide-shape-moving)
+//   control trans (x,y,z)          @ +12,+16,+20
+//   control surface-normal (x,y,z) @ +332,+336,+340
+//   control status                 @ +268  (cshape-moving-flags)
+//   control surface-angle          @ +416  (dot(surface-normal, gravity) — slide gate >0.5 / wall vs ground)
+//   control poly-angle             @ +420
+//   control touch-angle            @ +424  (head-on-ness; duck/wall gates 0.7)
+//   control unknown-float60        @ +1300 (ground flatness; can-duck? >= 0.7)
+//   control unknown-float61        @ +1304 (footing slope; can-wheel?/can-jump?)
+//   *target* (process) next-state  @ +72   ; state.name (symbol) @ +4
+// TEMPORARY diagnostic; removed before the final build. goal_src-free, libgk-only.
+static bool gwall_log_requested() {
+  if (std::getenv("OG_GWALL_LOG")) {
+    return true;
+  }
+#if defined(__ANDROID__)
+  char buf[8] = {0};
+  if (__system_property_get("debug.opengoal.coll.log", buf) > 0 && buf[0] == '1') {
+    return true;
+  }
+#endif
+  return false;
+}
+
+static inline float gwall_rdf(u32 addr) {
+  float f = 0.f;
+  if (addr && addr < (u32)(EE_MAIN_MEM_SIZE - 4)) {
+    std::memcpy(&f, g_ee_main_mem + addr, 4);
+  }
+  return f;
+}
+static inline u32 gwall_rdu(u32 addr) {
+  u32 v = 0;
+  if (addr && addr < (u32)(EE_MAIN_MEM_SIZE - 4)) {
+    std::memcpy(&v, g_ee_main_mem + addr, 4);
+  }
+  return v;
+}
+static inline bool gwall_nonfinite(float f) {
+  u32 b = 0;
+  std::memcpy(&b, &f, 4);
+  return (b & 0x7f800000u) == 0x7f800000u;  // Inf or NaN
+}
+
+void gwall_collision_log() {
+  if (!gwall_log_requested()) {
+    return;
+  }
+  static u64 s_frame = 0;
+  static u64 s_lines = 0;
+  s_frame++;
+  if (s_lines > 8000) {
+    return;
+  }
+  u32 tgt = intern_from_c("*target*")->value;
+  if (tgt == 0 || tgt == (u32)s7.offset || tgt >= (u32)(EE_MAIN_MEM_SIZE - 4)) {
+    return;
+  }
+  u32 ctrl = gwall_rdu(tgt + 108);
+  if (ctrl == 0 || ctrl == (u32)s7.offset || ctrl >= (u32)(EE_MAIN_MEM_SIZE - 1312)) {
+    return;
+  }
+  float sa = gwall_rdf(ctrl + 416), pa = gwall_rdf(ctrl + 420), ta = gwall_rdf(ctrl + 424);
+  float f60 = gwall_rdf(ctrl + 1300), f61 = gwall_rdf(ctrl + 1304);
+  u32 status = gwall_rdu(ctrl + 268);
+  float tx = gwall_rdf(ctrl + 12), ty = gwall_rdf(ctrl + 16), tz = gwall_rdf(ctrl + 20);
+  float snx = gwall_rdf(ctrl + 332), sny = gwall_rdf(ctrl + 336), snz = gwall_rdf(ctrl + 340);
+  int nf = (gwall_nonfinite(sa) ? 1 : 0) | (gwall_nonfinite(pa) ? 2 : 0) |
+           (gwall_nonfinite(ta) ? 4 : 0) | (gwall_nonfinite(f60) ? 8 : 0) |
+           (gwall_nonfinite(f61) ? 16 : 0) |
+           ((gwall_nonfinite(snx) || gwall_nonfinite(sny) || gwall_nonfinite(snz)) ? 32 : 0);
+  const char* sname = "?";
+  u32 nstate = gwall_rdu(tgt + 72);
+  if (nstate && nstate != (u32)s7.offset && nstate < (u32)(EE_MAIN_MEM_SIZE - 8)) {
+    // state.name (symbol) — the x86 listener oracle reported its offset as 0
+    // relative to the next-state pointer; try +0 then +4 and use whichever
+    // resolves to a printable symbol string.
+    for (u32 off : {0u, 4u}) {
+      u32 namesym = gwall_rdu(nstate + off);
+      if (namesym && namesym != (u32)s7.offset && namesym < (u32)(EE_MAIN_MEM_SIZE - 4)) {
+        auto str = info(Ptr<Symbol>(namesym))->str;
+        if (str.offset && str->data() && str->data()[0] >= ' ' && str->data()[0] < 127) {
+          sname = str->data();
+          break;
+        }
+      }
+    }
+  }
+  // cpad-hold? (L1/R1) state — the other duck-stance:trans stand-up gate.
+  // control unknown-cpad-info00 (cpad-info ptr) @ +668; cpad-info number @ +32;
+  // *cpad-list* cpads[i] (ptr) @ +8+i*4; cpad-info button0-abs[0] @ +40.
+  int cpadnum = -1;
+  u32 hold = 0;
+  u32 cpadinfo = gwall_rdu(ctrl + 668);
+  if (cpadinfo && cpadinfo != (u32)s7.offset && cpadinfo < (u32)(EE_MAIN_MEM_SIZE - 48)) {
+    cpadnum = (int)gwall_rdu(cpadinfo + 32);
+    u32 clist = intern_from_c("*cpad-list*")->value;
+    if (clist && clist != (u32)s7.offset && cpadnum >= 0 && cpadnum < 4) {
+      u32 cpadp = gwall_rdu(clist + 8 + cpadnum * 4);
+      if (cpadp && cpadp != (u32)s7.offset && cpadp < (u32)(EE_MAIN_MEM_SIZE - 48)) {
+        hold = gwall_rdu(cpadp + 40);
+      }
+    }
+  }
+  bool interesting = std::strstr(sname, "fall") || std::strstr(sname, "slide") ||
+                     std::strstr(sname, "duck") || std::strstr(sname, "hit-ground") ||
+                     std::strstr(sname, "wheel") || std::strstr(sname, "jump");
+  if ((s_frame % 8 == 0) || nf || interesting) {
+    printf(
+        "GWALL f=%llu st=%s sa=%.5f pa=%.5f ta=%.5f f60=%.5f f61=%.5f status=%x snx=%.4f "
+        "sny=%.4f snz=%.4f tx=%.1f ty=%.1f tz=%.1f nf=%d cpadn=%d hold=%x\n",
+        (unsigned long long)s_frame, sname, sa, pa, ta, f60, f61, status, snx, sny, snz, tx, ty,
+        tz, nf, cpadnum, hold);
+    fflush(stdout);
+    s_lines++;
+  }
+}
