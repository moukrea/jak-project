;; Both incoming paths to a join, with distinct address bases; expected 168.
(defun test-cg-memory-branch ()
  (let ((p (the (pointer int32) #x40000000))
        (q (the (pointer int32) #x40000040))
        (total 0)
        (i 0))
    (set! (-> p 1) 100)
    (set! (-> p 2) 42)
    (set! (-> q 1) 0)
    (set! (-> q 2) 7)
    (while (< i 2)
      (if (zero? (-> q 1))
        (set! (-> p 1) (-> p 2)))
      (set! total (+ total (+ (-> p 1) (-> p 2))))
      (set! (-> q 1) 1)
      (set! i (+ i 1)))
    total))
