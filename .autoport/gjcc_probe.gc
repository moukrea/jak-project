(define *gjcc-victim* (the-as crate #f))
(define *gjcc-v* (new 'global 'vector))
(defun gjcc-scan ((tag int)) (let ((tot 0) (live 0) (bad 0)) (dotimes (li (-> *level* length)) (let ((lev (-> *level* level li))) (when (= (-> lev status) 'active) (let ((acts (-> lev bsp actors))) (when (nonzero? acts) (dotimes (ai (-> acts length)) (let ((ent (-> acts data ai actor))) (when (and (nonzero? (the-as int ent)) (type-type? (-> ent type) entity-actor) (nonzero? (the-as int (-> ent etype))) (type-type? (-> ent etype) crate)) (set! tot (+ tot 1)) (let ((pr (-> ent extra process))) (cond ((and (nonzero? (the-as int pr)) (type-type? (-> pr type) crate)) (set! live (+ live 1)) (let* ((c (the-as crate pr)) (r (-> c root)) (pm (the-as collide-shape-prim-mesh (-> r root-prim))) (hid (if (logtest? (-> c draw status) (draw-status hidden)) 1 0)) (msh (if (-> pm mesh) 1 0)) (kas (the-as int (-> pm prim-core collide-as))) (kwi (the-as int (-> pm collide-with)))) (if (and (zero? hid) (or (zero? msh) (zero? kas) (zero? kwi))) (set! bad (+ bad 1))) (format 0 "GJCC-CRATE tag=~D ai=~D live=1 look=~A def=~A hid=~D " tag ai (-> c look) (-> c defense) hid) (format 0 "mesh=~D as=~D with=~D act=~D off=~D " msh kas kwi (the-as int (-> pm prim-core action)) (the-as int (-> pm prim-core offense))) (format 0 "ex=~f ey=~f ez=~f~%" (-> ent trans x) (-> ent trans y) (-> ent trans z)))) (else (format 0 "GJCC-CRATE tag=~D ai=~D live=0 hid=9 mesh=9 as=9 with=9 " tag ai) (format 0 "ex=~f ey=~f ez=~f~%" (-> ent trans x) (-> ent trans y) (-> ent trans z))))))))))))) (format 0 "GJCC-SUM tag=~D entities=~D live=~D nocol=~D~%" tag tot live bad)) (none))
(defun gjcc-goto ((k int)) (let ((n 0)) (dotimes (li (-> *level* length)) (let ((lev (-> *level* level li))) (when (= (-> lev status) 'active) (let ((acts (-> lev bsp actors))) (when (nonzero? acts) (dotimes (ai (-> acts length)) (let ((ent (-> acts data ai actor))) (when (and (nonzero? (the-as int ent)) (type-type? (-> ent type) entity-actor) (nonzero? (the-as int (-> ent etype))) (type-type? (-> ent etype) crate)) (when (and (= n k) *target*) (set! (-> *gjcc-v* quad) (-> ent trans quad)) (set! (-> *gjcc-v* y) (+ (-> *gjcc-v* y) 12288.0)) (set! (-> *gjcc-v* x) (+ (-> *gjcc-v* x) 8192.0)) (move-to-point! (-> *target* control) *gjcc-v*) (format 0 "GJCC-GOTO k=~D ai=~D x=~f z=~f~%" k ai (-> *gjcc-v* x) (-> *gjcc-v* z))) (set! n (+ n 1)))))))))) (format 0 "GJCC-GOTO-END k=~D total=~D~%" k n)) (none))
(defun gjcc-inject ((on int)) (cond ((= on 1) (set! *gjcc-victim* (the-as crate (search-process-tree *active-pool* (lambda ((p process-tree)) (and (type-type? (-> p type) crate) (nonzero? (the-as int (-> (the-as crate p) draw))) (not (logtest? (-> (the-as crate p) draw status) (draw-status hidden)))))))) (cond (*gjcc-victim* (clear-collide-with-as (-> *gjcc-victim* root)) (format 0 "GJCC-INJECT on=1 victim=#x~X~%" (the-as int *gjcc-victim*))) (else (format 0 "GJCC-INJECT on=1 victim=none~%")))) (else (cond (*gjcc-victim* (restore-collide-with-as (-> *gjcc-victim* root)) (format 0 "GJCC-INJECT on=0 victim=#x~X~%" (the-as int *gjcc-victim*))) (else (format 0 "GJCC-INJECT on=0 victim=none~%"))))) (none))
