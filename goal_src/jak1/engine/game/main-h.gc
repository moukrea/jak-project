;;;;;;;;;;;;;;;;;;;;;;;
;; Main Loop interface
;;;;;;;;;;;;;;;;;;;;;;;

;; *dproc* is the display process.
;; It is the main loop of the game.
;; don't overwrite the dproc if we're reloading this file
(define-perm *dproc* process #f)

;; is the main display loop running? Set to #f to kill it.
(define *run* #f)

;; did we teleport on the last frame? If so, it allows mood values to change immediately
;; instead of slowly fading between.
(define *teleport* #f)

;; set to a nonzero amount to apply the *teleport* for several frames.
(define *teleport-count* 0)

;; function to call in the main loop for drawing.
(define *draw-hook* nothing)

;; function to call in the main loop to run debug code
(define *debug-hook* nothing)

;; function to call in the main loop to run the debug menu
(declare-type debug-menu-context basic)

(define *menu-hook* (the (function debug-menu-context) nothing))

;; function to call in the main loop to run the progress menu
(define *progress-hook* nothing)

;; function to call if main DMA transfer times out, to attempt to recover.
(define *dma-timeout-hook* nothing)

;; unused.
(deftype frame-stats (structure)
  ((field-time time-frame 2)
   (field      int32)))

(define *frame-stats* (new 'static 'frame-stats))

;; full screen "filter" (just a giant quad over the whole screen)
(deftype screen-filter (basic)
  ((draw? basic)
   (color rgba))
  (:methods
   (draw (_type_) none)))

(defun-extern movie? symbol)

(defun-extern set-blackout-frames time-frame none)

;; Gloading-screen : la barriere de chargement (engine/load/loader.gc) arme l'ecran de chargement
;; par ici. Meme raison d'etre ici que `set-blackout-frames` juste au-dessus : ce fichier est
;; compile avant `engine/load/loader.gc`, donc le site d'appel de la barriere voit la declaration.
;; `loading-screen-shown?` est lu par le dessin (pc/loading-screen-pc.gc), compile plus tard encore.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Gloading-screen (owner 2026-08-29, retour n.4) -- L'HORLOGE DE L'ECRAN DE CHARGEMENT
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; « la silhouette animee ... freeze par moment (quand ca charge des gros trucs je suppose) ca
;; devrait etre fluide ! »
;;
;; TOUT L'ECRAN DE CHARGEMENT -- le seuil, le chien de garde ET la cellule de silhouette -- lisait
;; `(current-time)`, c'est-a-dire `(-> *display* base-frame-counter)`. CE COMPTEUR EST ARRETE
;; QUAND LE JEU EST EN PAUSE : engine/draw/drawable.gc:1013 met son increment sous
;; `(when (not (paused?)))`. Et `paused?` (main.gc:608) est vrai des que `*progress-process*`
;; n'est pas cache -- c'est-a-dire PENDANT LE MENU, donc pendant le chargement d'une partie
;; lance depuis ce menu. Consequences, toutes deux visibles a l'ecran :
;;   - la silhouette est EXACTEMENT figee (son horloge ne bouge plus d'un tick) ;
;;   - `(- (current-time) *loading-screen-since*)` reste a ZERO, donc le SEUIL de 0,5 s n'est
;;     jamais franchi et le CONTENU n'apparait pas du tout -- c'est le retour n.2 de l'owner,
;;     « ca n'apparait pas sur le chargement de partie alors que l'ECRAN NOIR y apparait ».
;;
;; LE SECOND CANDIDAT EST REFUTE, ET IL FAUT LE DIRE : `real-frame-counter` avance bien pendant la
;; pause, mais engine/game/game-save.gc:631 le REMPLACE par la valeur stockee dans la sauvegarde
;; -- au milieu du chargement de partie, exactement le cas qu'on repare. Il saute.
;;
;; ET LE TROISIEME CANDIDAT EST REFUTE AUSSI -- PAR LA MESURE, PAS PAR LA LECTURE.
;; `real-integral-frame-counter` remplit les deux premieres conditions : il est incremente HORS du
;; garde `paused?` (drawable.gc:1025) et il est ABSENT de la table de restauration de game-save.gc
;; (:615-640 ne connait que base-time, game-time, real-time et integral-time). Je l'ai donc pris.
;; La ligne de controle `LOADSCREEN-CLOCK`, qui publie les DEUX horloges cote a cote ramenees en
;; millisecondes, a rendu `integ-ms=2466,7` contre `base-ms=4933,3` -- un facteur EXACTEMENT 2 sur
;; une course a 30 images/s forcees. Cause : il compte des FRAMES CIBLES, pas des soixantiemes.
;; `time-factor` vaut `300 / target-fps` (display.gc:48-60), donc l'unite de ce compteur SUIT le
;; reglage de frequence du joueur ; a 30 fps une « frame » y vaut 1/30 s. Le seuil de 0,5 s et la
;; periode de la boucle auraient donc double chez un joueur en 30 fps, en silence.
;;
;; ON PREND DONC L'INCREMENT LUI-MEME. `scaled-seconds` est deja la conversion du moteur vers les
;; 1/300 s, et il est calcule une fois par frame dans le meme `let` que les quatre compteurs. Un
;; seul `+!` de plus, place hors du garde `paused?`, donne une horloge qui a les trois proprietes
;; a la fois : unite FIXE (1/300 s, celle de `(seconds x)`), avance en pause, jamais restauree.
;; C'est le controle a deux colonnes qui a trouve la faute -- publier une seule des deux valeurs
;; l'aurait laissee passer.
(define *loading-screen-ticks* (the-as time-frame 0))

(defmacro loading-screen-clock ()
  "Horloge de l'ecran de chargement. UNITE : 1/300 s, LA MEME que `(seconds x)` et que
   `(current-time)`. Avance en pause ET pendant une frame lente, et aucune sauvegarde ne la
   deplace. Alimentee par un unique `+!` dans engine/draw/drawable.gc, place HORS du garde
   `paused?` mais dans le meme `let` que les compteurs du moteur : elle recoit donc exactement le
   meme increment `scaled-seconds` qu'eux."
  ;; NOTE : quote simple et pas quasiquote — GOOS refuse un quasiquote pose sur un symbole nu
  ;; (« malformed quasiquote »), et il ne le dit qu'a la compilation du PREMIER appelant.
  '*loading-screen-ticks*)

(defun-extern loading-screen-hold! none)

(defun-extern loading-screen-release! none)

;; Gloading-screen (owner 2026-08-29, retour n.2) : L'EPISODE A PLUSIEURS PROPRIETAIRES.
;; Un bit par site d'attente. L'episode vit tant qu'un bit est pose, donc le point zero du seuil
;; de 0,5 s ne bouge pas quand deux attentes se relaient (residence GPU puis niveau 'active).
;; Ces constantes vivent ICI et pas dans main.gc : `engine/load/loader.gc` (game.gp:1924),
;; `engine/game/settings.gc` (:1928) et `engine/target/target-death.gc` (:1987) sont compiles
;; AVANT `engine/game/main.gc` (:1998) et doivent pouvoir les nommer.
(defconstant LS_HOLD_SCENE 1)    ;; scene-load-gate!      (cinematique streamee)
(defconstant LS_HOLD_CONTINUE 2) ;; continue-load-gate!   (residence GPU du point de reprise)
(defconstant LS_HOLD_TARGET 4)   ;; target-continue       (niveau 'active + visibilite)
(defconstant LS_HOLD_TITLE 8)    ;; attentes du demarrage (spools ndi/logo-intro, carte memoire)
(defconstant LS_HOLD_PROBE 16)   ;; sondes de mesure uniquement

(defun-extern loading-screen-hold-by! int none)

(defun-extern loading-screen-release-by! int none)

(defun-extern loading-screen-held? symbol)

(defun-extern loading-screen-shown? symbol)

;; Gloading-screen-window (owner 2026-08-30, retour n.4) — LA FENETRE DOIT ENCADRER LA TRANSITION.
;; Ces trois-la sont declarees ICI pour la meme raison que les constantes ci-dessus :
;; `engine/load/loader.gc` et `engine/target/target-death.gc` sont compiles AVANT
;; `engine/game/main.gc` et doivent pouvoir ouvrir/fermer la fenetre depuis leurs sites d'attente.
;; La fenetre est un CONTENANT DE MESURE : elle ne pilote rien, elle horodate. Voir
;; game/system/load_gate.h pour la nature et le repere des quatre instants.
(defun-extern loading-window-open! string none)

(defun-extern loading-window-close! string none)

(defun-extern loading-window-note! string int none)

;; INTERRUPTEUR D'ABLATION, SUR LE MEME BINAIRE. #f = le comportement d'AVANT le 2026-08-30, au
;; bit pres : l'ecran n'est tenu que par les boucles d'attente qui s'executent reellement, et il
;; est rendu avant la naissance des acteurs. #t = la fenetre ENCADRE la transition.
;; Il existe parce que les deux jambes d'une comparaison avant/apres doivent tourner sur le MEME
;; binaire et le MEME etat de depart : un « avant » pris sur un autre build ne prouve rien sur
;; celui qu'on livre. Il est POSE A #t : ce que le joueur recoit est la fenetre encadrante.
;; DESARME LE 2026-08-30 (Gloadgate-crash-regression). L'owner ne peut plus charger sa sauvegarde
;; a Geyser Rock depuis le build de 16h38, et le SEUL chantier entre le build qui chargeait (14h07)
;; et celui qui plante est celui qui a pose ce drapeau a #t. Nous n'avons pas reproduit le plantage
;; -- x86 : 24 transitions enchainees + 6 passages OPTIONS, vivant ; Redmi eae4df44 : 20
;; transitions sur deux sessions, dont 19 passages OPTIONS, vivant, zero signal fatal sur 202 493
;; lignes de logcat. Le defaut est donc propre a SA machine, que nous ne pouvons pas instrumenter.
;;
;; Dans ce cas l'arbitrage est celui que l'owner a lui-meme ecrit : « Un jeu qui charge avec un
;; ecran imparfait vaut infiniment mieux qu'un jeu qui plante. » On revient donc au comportement
;; d'AVANT sur CE SEUL POINT, au bit pres, par la branche `else` deja ecrite pour l'ablation :
;;   - `target-continue` ne tient plus l'ecran des sa premiere ligne et ne differe plus la levee
;;     derriere l'attente de naissance des acteurs (target-death.gc:205-228) ;
;;   - les deux attentes de spool de `loader.gc` (:1160, :1190) ne posent plus `LS_HOLD_SCENE`.
;;
;; CE QUI N'EST PAS RETIRE, ET C'EST VOULU : l'APPARENCE, que l'owner a validee (« le look est
;; nickel bravo »). Elle vit entierement dans `pc/loading-screen-pc.gc` (taille, position, blanc
;; plein, silhouette) et ce fichier n'est pas touche -- la preuve est republiee a chaque course
;; par `LOADSCREEN-COSM` et `LSCOLOR-BRUT`.
;;
;; CE QU'ON PERD, ET IL FAUT LE DIRE : l'encadrement de la fenetre (D3/D4/D7 -- l'ecran se posait
;; AVANT le premier dessin entrant et se levait APRES le dernier). Ce defaut-la REVIENT. C'est le
;; prix assume d'un jeu qui charge, et le chantier se reprend proprement une fois que le plantage
;; de la Shield est nomme par `GLCR-MEM` (game/system/load_gate.cpp).
(define *ls-window-fix* #f)

;; Gloadgate-crash-regression (owner 2026-08-30) — L'INSTRUMENT DE FENETRE EST OPT-IN.
;; `loading-window-open!` etait appelee INCONDITIONNELLEMENT par `target-continue`, et AUCUN code
;; de jeu n'appelait jamais `loading-window-close!` : seul le harnais de mesure la ferme, par le
;; REPL. Consequence MESUREE sur une course x86 de 220 s (3 chargements) : la fenetre reste
;; ouverte pour toujours des le premier point de reprise -- `GLCR-ETAT lswin-ouvert=#t` 60 s apres
;; chaque transition -- donc `loading-window-frame!` publie CHAQUE IMAGE, a vie, vers le C++
;; (un appel par niveau, plus deux, tous sous `g_win_mutex`), et la ligne `LSWIN-RENDU` du
;; renderer, qui n'est bornee QUE par `loading_window_is_open()`, deverse l'arbre de profilage
;; entier : 4 200 vidages, 767 823 lignes, 40,5 Mo de sortie standard en 220 s.
;; Un instrument qui ne s'eteint jamais n'est plus un instrument, c'est une charge permanente
;; posee sur le chemin du joueur.
;; POSE A #f : le joueur ne paie plus rien. Le harnais l'arme (`.autoport/glcr_proof.sh`), donc
;; les quatre instants de la fenetre restent mesurables exactement comme avant.
;; CE N'EST PAS UN RETRAIT DE `*ls-window-fix*` : l'encadrement de la fenetre, lui, reste arme.
(define *ls-window-instr* #f)

;; Combien d'acteurs au plus peuvent naitre dans UNE image pendant que l'ecran de chargement
;; couvre l'image. Le jeu d'origine pose 1000 juste avant de rendre la main, ce qui fait naitre
;; tout le niveau dans UNE seule image -- un gel, et c'est exactement le defaut D1/D5 de l'owner.
;; Tant que l'ecran couvre, RIEN n'oblige a tout faire d'un coup : c'est meme la seule raison
;; d'etre d'un ecran de chargement. Apres la levee, la valeur d'origine (1000) est reposee, donc
;; le comportement hors fenetre est inchange.
(defconstant LS_BIRTH_PER_FRAME 50)

;; Plafond de tours de l'attente de naissance. C'est un PLAFOND DE SECURITE, pas une cible : une
;; barriere qui peut immobiliser le jeu serait pire que le pop-in qu'elle corrige. A 60 images/s
;; il vaut 2 secondes.
(defconstant LS_BIRTH_TOURS_MAX 120)

;; Le balayage de naissance des acteurs (`actors-update`, engine/entity/entity.gc) a-t-il pu aller
;; JUSQU'AU BOUT a la derniere image ? La methode sort en `#f` des qu'elle atteint `birth-max` et
;; rend `0` quand elle a parcouru toutes les entites de tous les niveaux actifs -- donc « balayage
;; complet » veut dire, litteralement, « plus rien n'attend de naitre ». Le signal existait dans la
;; valeur de retour et n'etait lu par personne.
;; NATURE : un ETAT (le balayage est-il alle au bout), pas une duree. REPERE : l'image courante.
;; CE QU'IL LIT QUAND LE DEFAUT EST ABSENT : #t des la premiere image ou `*spawn-actors*` est vrai
;; sur un niveau deja peuple (renaissance sur place) -- l'attente ne retient alors rien.
(define *actors-sweep-complete* #f)

;; Gjak1-crate-collision-2 : detecteur passif de traversee de caisse, defini dans
;; engine/common-obs/crates.gc (compile plus tard) et appele une fois par image
;; dessinee depuis engine/draw/drawable.gc. Meme idiome que `set-master-mode`
;; ci-dessous : declare ici, defini plus loin.
(define-extern gjcc-thru-tick! (function none))
(define *ls-birth-tours* 0)

(defun-extern on symbol process)

(defun-extern off int)

(define-extern set-master-mode (function symbol none))

(define-extern paused? (function symbol))

(define-extern toggle-pause (function int))

(defun-extern menu-respond-to-pause symbol)
