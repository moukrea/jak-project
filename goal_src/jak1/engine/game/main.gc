;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/entity/ambient.gc")
(require "pc/debug/pc-debug-methods.gc")
(require "engine/draw/drawable.gc")
(require "engine/gfx/depth-cue.gc")
(require "engine/camera/cam-interface.gc")
(require "engine/camera/cam-update.gc")
(require "engine/common-obs/generic-obs.gc")
(require "pc/pckernel.gc")

;; DECOMP BEGINS

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Letterbox and blackout
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun set-letterbox-frames ((arg0 time-frame))
  "Set the letterbox frame counter for arg0 frames in the future"
  (set! (-> *game-info* letterbox-time) (+ (current-time) arg0))
  (none))

(defun letterbox ()
  "Draw the letterbox black rectangles.

   Gcutscene-reframe (owner 2026-08-28) -- in NATIVE mode this now draws NOTHING, at any
   aspect ratio. The bars are not replaced by smaller bars: the cutscene frame is RECOMPOSED
   by update-math-camera (gfx/math-camera.gc, real-movie? branch), which keeps the authored
   16x9 VERTICAL field of view and derives the horizontal from the real screen aspect. The
   rendered frame then already has the screen's aspect, so no region is left over to mask.

   This also fixes the covered FPS counter/HUD by construction, not by moving anything: the
   bars used to be appended to bucket `debug-no-zbuf` -- one of the LAST buckets -- from
   post-sync-draw, i.e. AFTER draw-pc-fps-counter had appended the counter to the very same
   bucket from (update *pc-settings*) at the tail of the previous display-loop iteration.
   Same bucket, later in the DMA chain, so the bars painted over it. Zero bars, nothing to
   paint over.

   The `use-vis?` path is the opt-in PS2-accurate renderer: it keeps the original bars,
   because there the view cannot be extended (the game's own visibility data bounds it)."
  (#cond
    ((not PC_PORT)
     (with-dma-buffer-add-bucket ((dma-buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf)) ;; debug-no-zbuf is one of the last buckets
       (draw-sprite2d-xy dma-buf 0 0 512 25 (new 'static 'rgba :a #x80))
       (draw-sprite2d-xy dma-buf 0 199 512 26 (new 'static 'rgba :a #x80))))
    (#t
     ;; original game mode keeps the PS2 bars. native mode emits no DMA at all.
     (when (-> *pc-settings* use-vis?)
       (with-dma-buffer-add-bucket ((dma-buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
         (draw-sprite2d-xy dma-buf 0 0 512 25 (new 'static 'rgba :a #x80))
         (draw-sprite2d-xy dma-buf 0 199 512 26 (new 'static 'rgba :a #x80))))))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Gcutscene-reframe -- boot measurement of the cutscene framing operator
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; A comment is not a proof. This drives the PRODUCTION predicates to the exact state a real
;; cutscene puts them in -- the `movie` bit of (-> *kernel-context* prevent-from-run), which is
;; what real-movie? reads -- and publishes what update-math-camera and letterbox ACTUALLY produce:
;;
;;   CUTREFRAME-FOV   the camera fov the probe ran at (a zero fov would make the whole table
;;                    vacuous, so it is published next to it and not assumed)
;;   CUTREFRAME       one line per screen aspect, cut=1 (cutscene) and cut=0 (gameplay CONTROL).
;;                    `v` must be identical on every cut=1 line -- that IS "vertical field of view
;;                    preserved" -- and `frame-asp` must equal `asp`, which is what makes every
;;                    black bar unnecessary. cut=0 discriminates: it must NOT match cut=1.
;;   CUTREFRAME-BARS  bytes of DMA that `letterbox` appends. vis=0 is native mode and must be 0;
;;                    vis=1 is the POSITIVE CONTROL and must be non-zero -- a zero without a
;;                    control that fired proves nothing.
;;
;; Everything touched is saved and restored inside the same function with no suspend in between,
;; so nothing else can observe the probe state. Runs once per boot, costs nothing afterwards.
;; Accepted, declared side effect: the vis=1 positive control really does emit the two PS2 bars,
;; so exactly ONE boot frame carries them.
(define *cutscene-reframe-measured* #f)

(defun cutscene-reframe-probe ((asp float))
  "Publish the cutscene frustum and its gameplay control for one screen aspect ratio."
  (let ((vmode (-> *setting-control* current video-mode))
        (asym (-> *setting-control* current aspect-ratio)))
    (set! (-> *pc-settings* aspect-ratio) asp)
    ;; cutscene: the movie bit is what real-movie? reads.
    (logior! (-> *kernel-context* prevent-from-run) (process-mask movie))
    (update-math-camera *math-camera* vmode asym)
    (format 0
            "CUTREFRAME cut=1 asp=~f h=~f v=~f frame-asp=~f~%"
            asp
            (-> *math-camera* x-ratio)
            (-> *math-camera* y-ratio)
            (/ (-> *math-camera* x-ratio) (-> *math-camera* y-ratio)))
    ;; control: same aspect, no movie. must differ, or the probe is measuring nothing.
    (logclear! (-> *kernel-context* prevent-from-run) (process-mask movie))
    (update-math-camera *math-camera* vmode asym)
    (format 0
            "CUTREFRAME cut=0 asp=~f h=~f v=~f frame-asp=~f~%"
            asp
            (-> *math-camera* x-ratio)
            (-> *math-camera* y-ratio)
            (/ (-> *math-camera* x-ratio) (-> *math-camera* y-ratio))))
  (none))

(defun cutscene-reframe-measure ()
  "One-shot boot measurement of the cutscene reframe and of the letterbox bars."
  (let ((vis (-> *pc-settings* use-vis?))
        (asp (-> *pc-settings* aspect-ratio))
        (mask (-> *kernel-context* prevent-from-run))
        (vmode (-> *setting-control* current video-mode))
        (asym (-> *setting-control* current aspect-ratio)))
    (set! (-> *pc-settings* use-vis?) #f)
    (format 0 "CUTREFRAME-FOV fov=~f tan-half=~f~%" (-> *math-camera* fov) (tan (* 0.5 (-> *math-camera* fov))))
    (cutscene-reframe-probe ASPECT_4X3)   ;; 1.3333 -- used to draw 28px top+bottom bars
    (cutscene-reframe-probe 1.6)          ;; 16:10  -- used to draw 11px top+bottom bars
    (cutscene-reframe-probe ASPECT_16X9)  ;; 1.7778 -- reference, no bars, reframe is identity
    (cutscene-reframe-probe 2.1666667)    ;; 19.5:9 -- phone, used to draw 45px side bars
    (cutscene-reframe-probe 2.2222222)    ;; 20:9   -- phone, used to draw 51px side bars
    (cutscene-reframe-probe 2.3333333)    ;; 21:9   -- used to draw 60px side bars
    (cutscene-reframe-probe 3.5555556)    ;; 32:9   -- used to draw 128px side bars
    ;; bars. 4:3 is the aspect that used to draw the tallest ones.
    (set! (-> *pc-settings* aspect-ratio) ASPECT_4X3)
    (logior! (-> *kernel-context* prevent-from-run) (process-mask movie))
    (let ((p0 (the-as int (-> (current-frame) global-buf base))))
      (letterbox)
      (format 0
              "CUTREFRAME-BARS vis=0 asp=~f bytes=~D~%"
              ASPECT_4X3
              (- (the-as int (-> (current-frame) global-buf base)) p0)))
    (set! (-> *pc-settings* use-vis?) #t) ;; POSITIVE CONTROL
    (let ((p0 (the-as int (-> (current-frame) global-buf base))))
      (letterbox)
      (format 0
              "CUTREFRAME-BARS vis=1 asp=~f bytes=~D~%"
              ASPECT_4X3
              (- (the-as int (-> (current-frame) global-buf base)) p0)))
    ;; restore every value touched, then recompute the camera for real.
    (set! (-> *pc-settings* use-vis?) vis)
    (set! (-> *pc-settings* aspect-ratio) asp)
    (set! (-> *kernel-context* prevent-from-run) mask)
    (update-math-camera *math-camera* vmode asym))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Gloading-screen -- ETIQUETTE DE L'APPELANT DU NOIR (owner 2026-08-29)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; « ca n'apparait pas non plus sur le chargement de partie ALORS QUE L'ECRAN NOIR Y APPARAIT UN
;;   MOMENT ». Le tell est decisif : le noir EST la, le contenu non. Ce n'est donc pas « un chemin
;; non cable », c'est une condition d'affichage qui ne se declenche pas la -- et pour le savoir il
;; faut d'abord savoir QUI noircit.
;;
;; L'appelant se lit sans toucher aux 14 sites d'appel : `(-> *kernel-context* current-process)` est
;; le process en cours d'execution (kernel/gkernel-h.gc:143), et son champ `name`
;; (kernel/gkernel-h.gc:219) porte le nom que le noyau lui a donne (« pov-camera-5 », « logo-2 »...).
;; C'est une lecture, pas une convention : aucun site ne peut oublier de se declarer.
;;
;; NATURE : une IDENTITE (qui a arme), pas une duree. REPERE : le noyau de processus.
;; CE QUE CA LIT QUAND PERSONNE N'ARME : `#f`, la valeur d'initialisation -- distincte de
;; `hors-process`, qui veut dire « arme depuis du code qui ne tourne dans aucun process ».
(define *blackout-src* (the-as basic #f))
(define *blackout-dur* 0)

(defun set-blackout-frames ((arg0 time-frame))
  "Set the blackout frame counter. If arg0 is 0, disables blackout immediately.
   Otherwise, this can only be used to increase the blackout period."
  (cond
    ((zero? arg0) (set! (-> *game-info* blackout-time) (current-time)))
    (else
      ;; Gloading-screen : etiqueter l'appelant. Lecture pure, aucun effet sur le noir lui-meme.
      (let ((p (-> *kernel-context* current-process)))
        (set! *blackout-src* (if p (-> p name) 'hors-process)))
      (set! *blackout-dur* (the-as int arg0))
      (set! (-> *game-info* blackout-time) (max (-> *game-info* blackout-time) (+ (current-time) arg0)))))
  (none))

(defun blackout ()
  "Draw the blackout rectangle, convering the entire screen in darkness."
  (with-dma-buffer-add-bucket ((dma-buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf)) ;; debug-no-zbuf is one of the last buckets
    (draw-sprite2d-xy dma-buf 0 0 512 224 (new 'static 'rgba :a #x80)))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Gloading-screen -- UN ECRAN DE CHARGEMENT AU LIEU D'UN ECRAN NOIR (owner 2026-08-28)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; « ca empecherait l'utilisateur de se poser des questions quand c'est en chargement (le jeu a
;;   crash ? pourquoi cet ecran noir ?) »
;;
;; LE PIEGE, ET POURQUOI UN SEUIL NE SUFFIT PAS. L'ecran noir ne sert pas qu'au chargement : il
;; sert aussi aux COUPES DE CAMERA (pov-camera.gc:103, 0,035 s) et aux BOUTONS (basebutton.gc:348,
;; 0,05 s), et a la mort (target-death.gc). Accrocher l'ecran de chargement a `blackout-time`
;; ferait clignoter « Loading... » a chaque coupe.
;; La reponse n'est donc PAS un seuil sur `blackout-time` : c'est une HORLOGE SEPAREE. Seule la
;; barriere de chargement (`scene-load-gate!`, engine/load/loader.gc) appelle
;; `loading-screen-hold!`. Une coupe de camera, un bouton et une mort poussent `blackout-time` et
;; n'appellent JAMAIS ceci : ils sont exclus PAR CONSTRUCTION, pas par un reglage qu'on pourrait
;; rater. Le seuil qui suit ne sert pas a les ecarter -- il sert a ne pas faire clignoter le
;; CONTENU quand la barriere s'ouvre presque tout de suite.
;;
;; NATURE de la grandeur : un ETAT DE BARRIERE (fermee / ouverte), pas une duree de noir.
;; REPERE : l'horloge de la barriere elle-meme, `(current-time)` aux tours ou elle tient.
;; CE QU'ELLE LIT QUAND LE DEFAUT EST ABSENT : sur une machine ou tout est deja resident,
;; `__pc-scene-ready?` rend 1 au premier tour, la boucle d'attente ne s'execute pas,
;; `loading-screen-hold!` n'est jamais appele, et RIEN de tout ceci ne s'allume -- le rendu est
;; alors inchange au bit. C'est aussi la ligne de base du controle publie par
;; `loading-screen-probe`.

;; CHIEN DE GARDE, ET RIEN D'AUTRE. Un episode se ferme normalement par `loading-screen-release!`,
;; que la barriere appelle des que sa boucle sort. Ce sursis ne couvre que le cas ou le processus
;; de la barriere serait TUE en pleine attente : personne n'appellerait alors le relachement.
;;
;; IL EST PASSE DE 0,05 s A 1 s, ET C'EST UNE MESURE D'HORLOGE QUI L'IMPOSE, PAS UN GOUT.
;; L'horloge n'avance PAS d'un pas fixe par frame : elle recoit `scaled-seconds`, soit le nombre
;; de frames REELLEMENT ecoulees fois `time-factor`. Une frame de 33 ms l'avance donc deja de 15 --
;; exactement l'ancien sursis. Sous 30 fps, l'ancien sursis expirait entre deux tours de la boucle ;
;; or c'est precisement le regime d'un chargement sur telephone.
(defconstant LOADING_SCREEN_HOLD (seconds 1))

;; Le sursis de la TENTATIVE 1. Il ne pilote plus rien : il n'existe que pour que le controle
;; positif `LOADSCREEN-LAG` evalue le predicat d'AVANT sur l'etat reel, au lieu de l'affirmer.
(defconstant LOADING_SCREEN_HOLD_AVANT (seconds 0.05))

;; SEUIL D'AFFICHAGE DU CONTENU. En dessous, la barriere a tenu si peu qu'afficher un texte serait
;; un clignotement. Au-dessus, l'attente est perceptible -- c'est exactement le cas que l'owner
;; decrit (mesure appareil : `LOADGATE open scene=logo-intro waited=6763ms reason=resident`).
(defconstant LOADING_SCREEN_DELAY (seconds 0.5))

;; L'EPISODE EST UN ETAT EXPLICITE, PAS UNE DUREE. Vrai entre le premier tour de la boucle de la
;; barriere et son relachement. C'est ce drapeau -- et AUCUN nombre a regler -- qui decide si un
;; appel a `loading-screen-hold!` ouvre un NOUVEL episode, donc aucune frame lente ne peut le
;; rouvrir.
;;
;; DEFAUT QU'IL CORRIGE, ET IL ETAIT INVISIBLE SUR BUREAU. L'ouverture d'episode etait testee par
;; `(>= (current-time) *loading-screen-hold-until*)` : vraie des que la frame precedente avait dure
;; plus que le sursis. Le front montant -- donc le point zero du SEUIL -- se replacait alors a
;; CHAQUE frame lente, le seuil de 0,5 s n'etait jamais atteint, et le CONTENU (silhouette, texte,
;; glyphes) n'etait JAMAIS dessine : il ne restait que le fond noir, c'est-a-dire le defaut meme
;; que cette phase corrige. Sur bureau les frames font 5 unites d'horloge contre un sursis de 15,
;; le defaut ne pouvait pas se produire ; en chargement sur telephone il etait systematique.
;; Gloading-screen (owner 2026-08-29, retour n.2) -- L'EPISODE A PLUSIEURS PROPRIETAIRES.
;; Mesure du cycle : sur un chargement de partie, DEUX attentes distinctes se relaient. La
;; barriere de residence GPU (`continue-load-gate!`) s'ouvre des que le renderer a televerse le
;; niveau ; l'attente de `target-continue` (engine/target/target-death.gc:86-93 et :141-142)
;; continue, elle, jusqu'a ce que GOAL passe le niveau en 'active puis resolve la visibilite --
;; et c'est ELLE qui tient l'ecran noir que l'owner voit. Avec un simple booleen, le
;; relachement de la premiere ETEIGNAIT l'episode, la seconde le ROUVRAIT a la frame suivante,
;; et le seuil de 0,5 s repartait de zero : le contenu disparaissait puis revenait.
;; Un bit par site regle ca par CONSTRUCTION : l'episode vit tant qu'un proprietaire tient, et
;; le point zero du seuil ne bouge pas quand les proprietaires se relaient.
(define *loading-screen-mask* 0)
;; Fin du sursis du chien de garde. `(current-time)` au-dela = l'episode est repute mort meme sans
;; relachement (processus tue).
(define *loading-screen-hold-until* (the-as time-frame 0))
;; Instant du FRONT MONTANT de la barriere courante : c'est contre lui que le seuil se mesure.
(define *loading-screen-since* (the-as time-frame 0))
;; La MEME instant, lu sur l'ANCIENNE horloge (`base-frame-counter`, unite 1/300 s). Il n'est lu
;; par aucune decision : il n'existe que pour que la ligne `LOADSCREEN-CLOCK` publie, cote a cote,
;; ce que les DEUX horloges ont avance pendant l'episode. Quand le jeu est en pause -- donc
;; pendant un chargement de partie lance depuis le menu -- l'ancienne reste a ZERO pendant que la
;; nouvelle avance : c'est le controle qui montre le defaut au lieu de l'affirmer.
(define *loading-screen-since-base* (the-as time-frame 0))
;; Diagnostics de course, publies par la salle et par les traces.
(define *loading-screen-arms* 0)
(define *loading-screen-frames* 0)

;; Le dessin vit dans pc/loading-screen-pc.gc (il a besoin des quads textures `rhud-*` et des
;; textures du pool PC). Meme patron que `entity-inspect-draw` plus bas dans ce fichier.
(define-extern loading-screen-draw (function none))
(define-extern ls-capture-trace (function none))

(defun loading-screen-hold! ()
  "Arme l'ecran de chargement. Appele par `scene-load-gate!` a chaque tour ou la barriere retient
   la scene, et par personne d'autre -- c'est cette exclusivite qui ecarte les coupes de camera et
   les boutons.

   LE FRONT MONTANT EST LU SUR UN DRAPEAU, JAMAIS SUR UN ECART DE TEMPS. Un appel qui trouve
   l'episode deja arme ne fait que repousser le chien de garde : il ne redemarre pas le seuil.
   C'est ce qui rend le seuil insensible a la duree des frames -- et une frame de chargement dure
   ce qu'elle veut."
  ;; Le second terme rattrape le seul cas ou le drapeau pourrait rester colle : un processus de
  ;; barriere TUE en pleine attente, qui n'appellerait jamais `loading-screen-release!`. Sans lui,
  ;; `since` resterait vieux pour toujours et le chargement SUIVANT afficherait le contenu tout de
  ;; suite -- c'est-a-dire le clignotement que le seuil existe pour empecher.
  ;; OUI, C'EST A NOUVEAU UN NOMBRE, ET JE DIS CE QU'IL COUTE : il se franchit quand UNE frame
  ;; dure plus que le chien de garde, soit sous ~1 fps, contre 30 fps pour la valeur de la
  ;; tentative 1 -- et il ne coute alors qu'UN redemarrage du seuil, pas son blocage definitif.
  ;; Le controle `LOADSCREEN-LAG` publie ce point de bascule au lieu de le taire.
  (loading-screen-hold-by! LS_HOLD_PROBE)
  (none))

(defun loading-screen-hold-by! ((who int))
  "Armer l'ecran de chargement AU NOM d'un site d'attente. A appeler a chaque tour de la boucle
   d'attente : un appel qui trouve l'episode deja ouvert ne fait qu'ajouter son bit et repousser
   le chien de garde -- il ne redemarre PAS le seuil.

   LE FRONT MONTANT EST LU SUR LE MASQUE, JAMAIS SUR UN ECART DE TEMPS. Le second terme rattrape
   le seul cas ou un bit resterait colle : un processus TUE en pleine attente, qui n'appellerait
   jamais son relachement. Il se franchit quand UNE frame dure plus que le chien de garde (~1 fps)
   et ne coute alors qu'UN redemarrage du seuil. `LOADSCREEN-LAG` publie ce point de bascule."
  (when (or (zero? *loading-screen-mask*) (>= (loading-screen-clock) *loading-screen-hold-until*))
    (set! *loading-screen-mask* 0)
    (set! *loading-screen-since* (loading-screen-clock))
    (set! *loading-screen-since-base* (current-time))
    (set! *loading-screen-frames* 0)
    (+! *loading-screen-arms* 1))
  (set! *loading-screen-mask* (logior *loading-screen-mask* who))
  (set! *loading-screen-hold-until* (+ (loading-screen-clock) LOADING_SCREEN_HOLD))
  (none))

(defun loading-screen-release-by! ((who int))
  "Rendre la main AU NOM d'un site. L'episode ne se ferme que lorsque le DERNIER proprietaire
   l'a rendue -- c'est ce qui empeche une barriere rapide d'eteindre l'ecran alors qu'une autre
   attente, plus lente, noircit encore l'image."
  (set! *loading-screen-mask* (logand *loading-screen-mask* (lognot who)))
  (when (zero? *loading-screen-mask*)
    (set! *loading-screen-hold-until* (the-as time-frame 0)))
  (none))

(defun loading-screen-release! ()
  "Ferme l'episode courant. Appele par `scene-load-gate!` des que sa boucle d'attente sort, donc
   l'ecran s'efface a la frame ou le chargement finit -- sans attendre l'expiration d'un delai.
   Sans effet si rien n'etait arme (barriere ouverte au premier tour : le cas normal sur bureau)."
  (set! *loading-screen-mask* 0)
  (set! *loading-screen-hold-until* (the-as time-frame 0))
  (none))

(defun loading-screen-held? ()
  "Une barriere de chargement retient-elle l'image en ce moment ? Le drapeau porte l'etat ; le
   sursis n'est la que pour qu'un processus tue sans relachement n'immobilise pas l'ecran."
  (and (nonzero? *loading-screen-mask*) (< (loading-screen-clock) *loading-screen-hold-until*)))

(defun loading-screen-shown? ()
  "La barriere tient-elle depuis assez longtemps pour montrer le CONTENU (silhouette, texte,
   glyphes) ? Le fond noir, lui, est peint des que `loading-screen-held?` est vrai."
  (and (loading-screen-held?)
       (>= (- (loading-screen-clock) *loading-screen-since*) LOADING_SCREEN_DELAY)))

(defun loading-screen-force! ((dur time-frame))
  "INSTRUMENT DE MESURE. N'est appele par AUCUN code de jeu -- uniquement depuis la console de
   developpement. Force l'ecran de chargement pendant `dur`, exactement comme si une barriere le
   tenait, et place son front montant assez loin dans le passe pour que le SEUIL soit deja franchi.

   RAISON D'ETRE : sur une machine ou tout est deja resident, `__pc-scene-ready?` rend 1 au premier
   tour, la barriere ne se ferme JAMAIS, et le chemin de DESSIN n'y est donc jamais execute. Un
   zero sans controle positif qui a tire ne prouve rien -- ceci est ce controle."
  (set! *loading-screen-mask* LS_HOLD_PROBE)
  (set! *loading-screen-since* (- (loading-screen-clock) LOADING_SCREEN_DELAY))
  (set! *loading-screen-since-base* (current-time))
  (set! *loading-screen-hold-until* (+ (loading-screen-clock) dur))
  (+! *loading-screen-arms* 1)
  (set! *loading-screen-frames* 0)
  (format 0 "LOADSCREEN-FORCE dur=~D arm=~D~%" dur *loading-screen-arms*)
  (none))

(define *loading-screen-probed* #f)
(define *loading-screen-draw-probed* #f)

(defun loading-screen-draw-probe ()
  "CONTROLE POSITIF DU CHEMIN DE DESSIN. Un seul tir par demarrage, et uniquement quand le segment
   de debug est charge : un build de livraison ne dessine jamais ceci.

   RAISON D'ETRE. La sonde ci-dessus prouve la PORTE (qui arme, qui n'arme pas) ; elle ne touche
   pas un pixel. Or sur une machine ou tout est deja resident la barriere ne se ferme jamais --
   mesure : ZERO ligne `LOADGATE` sur une course x86 complete -- donc le chemin de DESSIN n'y
   serait jamais execute et son silence ne prouverait rien. Ici on met le systeme dans l'etat
   EXACT ou la barriere le met, on appelle le dessin UNE fois, et on publie ce qu'il a fait.
   Cout accepte et declare, exactement comme la sonde de reframe plus haut : UNE frame de
   demarrage porte l'ecran de chargement, dans un build de debug seulement.

   ON ATTEND QUE `*common-text*` SOIT CHARGEE. Sans elle le dessin sauterait le texte et les
   glyphes (garde volontaire, text-h.gc:1034 l'initialise a #f) et le controle ne couvrirait que
   le fond noir -- il aurait l'air de passer en ne testant qu'un tiers du chemin."
  (let ((hold *loading-screen-hold-until*)
        (armed *loading-screen-mask*)
        (since *loading-screen-since*)
        (fr *loading-screen-frames*))
    (set! *loading-screen-mask* LS_HOLD_PROBE)
    (set! *loading-screen-hold-until* (+ (loading-screen-clock) LOADING_SCREEN_HOLD))
    (set! *loading-screen-since* (- (loading-screen-clock) LOADING_SCREEN_DELAY))
    (set! *loading-screen-since-base* (current-time))
    (set! *loading-screen-frames* 0)
    (loading-screen-draw)
    (format 0
            "LOADSCREEN-DRAWPROBE shown=~A frames-dessinees=~D~%"
            (loading-screen-shown?)
            *loading-screen-frames*)
    (set! *loading-screen-hold-until* hold)
    (set! *loading-screen-mask* armed)
    (set! *loading-screen-since* since)
    (set! *loading-screen-frames* fr))
  (none))

(defun loading-screen-probe ()
  "Mesure d'amorcage de la porte de l'ecran de chargement, un seul tir par demarrage.

   Un commentaire n'est pas une preuve : cette sonde DRIVE les predicats de production avec
   exactement les appels que font les sites reels, et publie ce qu'ils rendent.
     - CONTROLE NEGATIF : `(set-blackout-frames (seconds 0.035))` est litteralement la ligne de
       pov-camera.gc:103, et `(seconds 0.05)` celle de basebutton.gc:348. `noir=` publie les frames
       de noir REELLEMENT armees : il est non nul, donc le controle A TIRE. Si `held=` restait
       vrai la, l'ecran clignoterait a chaque coupe.
     - CONTROLE POSITIF : `loading-screen-hold!` est l'appel que fait la barriere. `held=` doit
       passer vrai, et `shown=` rester faux tant que le SEUIL n'est pas franchi.
   Tout ce qui est touche est sauve et restaure dans la meme fonction, sans suspend entre les deux."
  (let ((hold *loading-screen-hold-until*)
        (armed *loading-screen-mask*)
        (since *loading-screen-since*)
        (arms *loading-screen-arms*)
        (bo (-> *game-info* blackout-time)))
    (format 0 "LOADSCREEN-SEUIL delay=~D hold=~D repere=300emes-de-seconde pause-ignoree=#t~%"
            LOADING_SCREEN_DELAY LOADING_SCREEN_HOLD)
    ;; ligne de base : rien n'arme, rien ne s'allume.
    (set! *loading-screen-mask* 0)
    (set! *loading-screen-hold-until* (the-as time-frame 0))
    (set! *loading-screen-since* (the-as time-frame 0))
    (set-blackout-frames 0)
    (format 0
            "LOADSCREEN-CTRL src=rien noir=~D held=~A shown=~A~%"
            (- (-> *game-info* blackout-time) (current-time))
            (loading-screen-held?)
            (loading-screen-shown?))
    ;; CONTROLE NEGATIF 1 -- la coupe de camera.
    (set-blackout-frames (seconds 0.035))
    (format 0
            "LOADSCREEN-CTRL src=pov-camera noir=~D held=~A shown=~A~%"
            (- (-> *game-info* blackout-time) (current-time))
            (loading-screen-held?)
            (loading-screen-shown?))
    ;; CONTROLE NEGATIF 2 -- le bouton.
    (set-blackout-frames 0)
    (set-blackout-frames (seconds 0.05))
    (format 0
            "LOADSCREEN-CTRL src=basebutton noir=~D held=~A shown=~A~%"
            (- (-> *game-info* blackout-time) (current-time))
            (loading-screen-held?)
            (loading-screen-shown?))
    ;; CONTROLE POSITIF -- la barriere de chargement, avant le seuil.
    (loading-screen-hold!)
    (format 0
            "LOADSCREEN-CTRL src=load-gate attente=0 held=~A shown=~A~%"
            (loading-screen-held?)
            (loading-screen-shown?))
    ;; CONTROLE POSITIF -- la meme barriere, une fois le seuil franchi.
    (set! *loading-screen-since* (- (loading-screen-clock) LOADING_SCREEN_DELAY))
    (format 0
            "LOADSCREEN-CTRL src=load-gate attente=~D held=~A shown=~A~%"
            LOADING_SCREEN_DELAY
            (loading-screen-held?)
            (loading-screen-shown?))
    ;; CONTROLE POSITIF DU CORRECTIF DE LA TENTATIVE 3 -- UNE FRAME LENTE NE ROUVRE PAS L'EPISODE.
    ;;
    ;; NATURE : une CONTINUITE D'EPISODE (le front montant a-t-il bouge ?), pas une duree.
    ;; REPERE : l'horloge de la barriere. Une frame lente s'emule EXACTEMENT en reculant les deux
    ;;   variables de l'episode de sa duree : les predicats ne font que comparer `(current-time)`
    ;;   a ces variables, donc reculer les variables de d equivaut a avancer le temps de d.
    ;; CE QUE LA LIGNE LIT QUAND LE DEFAUT EST PRESENT : `ancienne-regle-rearme=#t` ET
    ;;   `episode-conserve=#f` ET `shown=#f` -- le seuil serait reparti de zero.
    ;; LE CONTROLE TIRE-T-IL ? `ancienne-regle-rearme` EST le predicat d'avant, evalue sur l'etat
    ;;   reel : il doit valoir #t, sinon la frame emulee n'etait pas assez lente et la ligne ne
    ;;   prouverait rien -- c'est le `noir=` des controles negatifs ci-dessus, transpose.
    ;; Deux frames lentes, jouees chacune depuis un episode NEUF :
    ;;   lag=15  -> 30 fps. `time-ratio` vaut 3, la frame avance l'horloge de 15, soit EXACTEMENT
    ;;              l'ancien sursis : c'est le seuil ou le defaut commence.
    ;;   lag=180 -> une frame de 600 ms, regime courant d'un chargement sur telephone.
    ;;   lag=450 -> 1,5 s, AU-DELA du chien de garde : la, l'episode se rouvre bel et bien, et la
    ;;              ligne le publie (`episode-conserve=#f`). C'est la borne du correctif, dite au
    ;;              lieu d'etre tue -- et c'est aussi ce que la ligne lit quand le defaut EST la.
    ;; `ancienne-regle-rearme` est le predicat d'AVANT ecrit tel quel -- l'appel precedent avait
    ;; pose `hold-until` a (t_precedent + LOADING_SCREEN_HOLD_AVANT), et t_precedent vaut
    ;; ((current-time) - lag). Il doit valoir #t : c'est LUI qui prouve que la frame emulee est
    ;; assez lente pour declencher le defaut, donc que le controle A TIRE.
    (dotimes (i 3)
      (let ((lag (cond ((zero? i) LOADING_SCREEN_HOLD_AVANT)
                       ((= i 1) (the-as int (seconds 0.6)))
                       (else (the-as int (seconds 1.5))))))
        (set! *loading-screen-mask* 0)
        (set! *loading-screen-hold-until* (the-as time-frame 0))
        (set! *loading-screen-since* (the-as time-frame 0))
        (loading-screen-hold!)
        (let ((arms-avant *loading-screen-arms*))
          (set! *loading-screen-hold-until* (- *loading-screen-hold-until* lag))
          (set! *loading-screen-since* (- *loading-screen-since* lag))
          (loading-screen-hold!)
          (format 0
                  "LOADSCREEN-LAG lag=~D ancienne-regle-rearme=~A episode-conserve=~A held=~A shown=~A~%"
                  lag
                  (>= (loading-screen-clock) (+ (- (loading-screen-clock) lag) LOADING_SCREEN_HOLD_AVANT))
                  (= *loading-screen-arms* arms-avant)
                  (loading-screen-held?)
                  (loading-screen-shown?)))))
    ;; ET LE RELACHEMENT : la barriere s'ouvre, l'ecran s'efface a cette frame-ci.
    (loading-screen-release!)
    (format 0
            "LOADSCREEN-CTRL src=release held=~A shown=~A~%"
            (loading-screen-held?)
            (loading-screen-shown?))
    ;; restauration
    (set! *loading-screen-hold-until* hold)
    (set! *loading-screen-mask* armed)
    (set! *loading-screen-since* since)
    (set! *loading-screen-arms* arms)
    (set! (-> *game-info* blackout-time) bo))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Gloading-screen -- RECENSEMENT DES FRAMES NOIRES (owner 2026-08-29, retour n.2)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; L'owner : « ca n'apparait pas non plus sur le chargement de partie alors que l'ECRAN NOIR y
;; apparait un moment ». La directive qui en decoule est litterale : « instrumenter `blackout` pour
;; publier, a chaque declenchement, le chemin appelant et l'etat du seuil. Publier la liste des
;; declenchements observes pendant un demarrage complet plus un chargement de partie. »
;;
;; C'EST CETTE FONCTION, ET ELLE NE JUGE RIEN. Elle compte, par EPISODE de noir :
;;   - `src=`      le process qui a arme le noir (etiquette posee par `set-blackout-frames`) ;
;;   - `frames=`   la longueur de l'episode, en frames d'affichage REELLEMENT produites ;
;;   - `tenue=`    combien de ces frames une barriere de chargement retenait l'image
;;                 (`loading-screen-held?`) -- c'est le fond noir de l'ecran de chargement ;
;;   - `contenu=`  combien de ces frames le SEUIL etait franchi (`loading-screen-shown?`) -- c'est
;;                 la silhouette, le texte et les glyphes.
;; `tenue=0` sur un episode long EST le defaut que l'owner decrit : du noir que rien ne couvre.
;; `tenue=N contenu=0` serait l'autre defaut : couvert, mais le seuil n'a jamais ete franchi.
;; Les deux se distinguent sur la MEME ligne, ce qui evite de deviner lequel des deux on a.
;;
;; NATURE : un COMPTE DE FRAMES par episode, pas une duree ni une moyenne. REPERE : la boucle
;; d'affichage elle-meme -- une frame comptee est une frame qui a ete produite, donc que l'owner a
;; pu voir. C'est le seul repere ou « il y avait un ecran noir » a un sens.
;; CE QU'ELLE LIT QUAND LE DEFAUT EST ABSENT : sur un chargement couvert, `frames=N tenue=N`, les
;; deux egaux ; et rien du tout quand aucune frame n'est noire.
;;
;; POURQUOI UN PLANCHER DE 6 FRAMES. Une coupe de camera (0,035 s) et un bouton (0,05 s) font 2 a 3
;; frames et se produisent en boucle pendant le jeu : les publier ligne par ligne noierait la
;; mesure. Ils ne sont pas pour autant caches -- ils sont comptes dans `courts=` et
;; `courts-tenus=`, republies sur CHAQUE ligne longue. Un episode court qui se mettrait a etre
;; couvert (donc un clignotement de l'ecran de chargement sur une coupe) ferait monter
;; `courts-tenus=`, qui doit rester a 0 : c'est le controle negatif, gratuit et permanent.
(defconstant BLACKCENSUS_MIN 6)

(define *blk-open* #f)
(define *blk-frames* 0)
(define *blk-held* 0)
(define *blk-shown* 0)
(define *blk-src* (the-as basic #f))
(define *blk-dur* 0)
(define *blk-courts* 0)
(define *blk-courts-tenus* 0)
(define *blk-total* 0)
(define *blk-total-nues* 0)

(define *blk-via* 'aucun)

(defun blackout-census! ((noir symbol) (held symbol))
  "Compter la frame courante et publier l'episode de noir quand il se ferme.

   DEUX MECANISMES NOIRCISSENT, PAS UN. `blackout-time` (le compteur de `set-blackout-frames`) et
   `bg-a` / `bg-a-force` (l'alpha du quad PCRTC, resolu a engine/game/settings.gc:224-230). Le
   second est celui que `target-continue` pose a 1,0 pendant qu'il attend le niveau
   (engine/target/target-death.gc:56-57) -- c'est LE noir du chargement d'une partie, et un
   recensement qui ne regarderait que `blackout-time` ne le verrait pas du tout. `via=` dit lequel
   a ouvert l'episode : c'est ce qui permet de nommer le chemin sans le deviner."
  (let ((bga (-> *setting-control* current bg-a))
        (bgf (-> *setting-control* current bg-a-force)))
    (if (or (>= bga 0.99) (>= bgf 0.99)) (set! noir #t))
    (cond
      ((or noir held)
       (when (not *blk-open*)
         (set! *blk-open* #t)
         (set! *blk-frames* 0)
         (set! *blk-held* 0)
         (set! *blk-shown* 0)
         (set! *blk-src* *blackout-src*)
         (set! *blk-dur* *blackout-dur*)
         (set! *blk-via*
               (cond
                 ((< (current-time) (-> *game-info* blackout-time)) 'blackout-time)
                 ((>= bgf 0.99) 'bg-a-force)
                 ((>= bga 0.99) 'bg-a)
                 (else 'barriere-seule))))
       (+! *blk-frames* 1)
       (+! *blk-total* 1)
       (cond
         (held (+! *blk-held* 1) (if (loading-screen-shown?) (+! *blk-shown* 1)))
         (else (+! *blk-total-nues* 1))))
      (else
       (when *blk-open*
         (set! *blk-open* #f)
         (cond
           ((>= *blk-frames* BLACKCENSUS_MIN)
          ;; Une seule LIGNE, en trois appels : le compilateur GOAL plafonne un appel a 8
          ;; parametres. `~%` n'apparait que sur le dernier, donc la ligne reste entiere.
            (begin
              (format 0
                      "BLACKCENSUS via=~A src=~A dur=~D frames=~D tenue=~D contenu=~D "
                      *blk-via*
                      *blk-src*
                      *blk-dur*
                      *blk-frames*
                      *blk-held*
                      *blk-shown*)
              (format 0
                      "mm=~A lev0=~A/~A lev1=~A/~A "
                      *master-mode*
                      (-> *level* level0 name)
                      (-> *level* level0 status)
                      (-> *level* level1 name)
                      (-> *level* level1 status))
              (format 0
                      "courts=~D courts-tenus=~D total=~D nues=~D~%"
                      *blk-courts*
                      *blk-courts-tenus*
                      *blk-total*
                      *blk-total-nues*)))
           (else
            (+! *blk-courts* 1)
            (if (nonzero? *blk-held*) (+! *blk-courts-tenus* 1))))))))
  (none))

;;;;;;;;;;;;;;;;;;;;;
;; Pause/Master Mode
;;;;;;;;;;;;;;;;;;;;;

(defun paused? ()
  "Are we paused? True if *master-mode* = pause, progress is not hidden, or *master-mode* = menu"
  (the-as symbol
          (or (= *master-mode* 'pause)
              (or (and *progress-process* (not (hidden? (-> *progress-process* 0)))) (= *master-mode* 'menu)))))

(defun movie? ()
  "Are we in a movie?"
  (logtest? (-> *kernel-context* prevent-from-run) (process-mask movie)))

(defun set-master-mode ((new-mode symbol))
  "Update pause masks for the given mode, and set *master-mode*"
  ;; og:preserve-this PAL patch here
  (let ((gp-0 *master-mode*))
    ;; modified for PC port - show speedrun fast reset menu if L1+R1 held
    (cond
      ((and PC_PORT
            (or (= new-mode 'pause) (= new-mode 'progress)) ;; pausing (as opposed to un-pausing)
            (-> *pc-settings* speedrunner-mode?)
            (cpad-hold? 0 l1)
            (cpad-hold? 0 r1))
       ;; treat this as a 'progress pause to avoid funny 'pause buffers from Select button
       (set! *master-mode* 'progress)
       (if *debug-segment* (menu-respond-to-pause))
       ;; allow menu to run while in progress.
       (logclear! (-> *setting-control* default process-mask) (process-mask menu))
       ;; activate the progress menu.
       (when (not *progress-process*)
         (activate-progress *dproc* (progress-screen speedrun-options))
         (if (not *progress-process*) (set-master-mode 'game))))
      (else
       ;; vanilla logic
       (set! *master-mode* new-mode)
       (if *debug-segment* (menu-respond-to-pause))
       (case *master-mode*
         (('pause)
          ;; request the pause mask to be set in prevent-from-run.
          ;; this will block any process with pause from running, pausing most game objects.
          (if (not *debug-pause*) (logior! (-> *setting-control* default process-mask) (process-mask pause)))
          ;; allow the menu to run.
          (logclear! (-> *setting-control* default process-mask) (process-mask menu))
          ;; ??
          (set! *pause-lock* #f)
          (sound-group-pause (sound-group sfx music dialog sog3 ambient sog5 sog6 sog7))
          (hide-progress-screen))
         (('menu)
          ;; I believe these masks are just to make the progress go away work.
          (logior! (-> *setting-control* default process-mask) (process-mask menu))
          (logclear! (-> *setting-control* default process-mask) (process-mask pause progress))
          (set! *pause-lock* #f)
          (hide-progress-screen))
         (('progress)
          ;; allow menu to run while in progress.
          (logclear! (-> *setting-control* default process-mask) (process-mask menu))
          ;; activate the progress menu.
          (when (not *progress-process*)
            (activate-progress *dproc* (progress-screen fuel-cell))
            (if (not *progress-process*) (set-master-mode 'game))))
         (('game)
          ;; allow pausable/menu to run.
          (logclear! (-> *setting-control* default process-mask) (process-mask pause menu))
          (if (!= gp-0 *master-mode*) (sound-group-continue (sound-group sfx music dialog sog3 ambient sog5 sog6 sog7)))
          (hide-progress-screen))))))
  ;; apply settings now.
  (apply-settings *setting-control*)
  0
  (none))

(define *last-master-mode* 'game)

(defun toggle-pause ()
  "Do pause/menu/progress transitions"
  (case *master-mode*
    (('game)
     ;; coming from normal gameplay
     (set! *last-master-mode* *master-mode*)
     (set-master-mode (cond
                        ;; first, check if the controller fell out, and jak is spawned
                        ((and (nonzero? (logand (-> *cpad-list* cpads 0 valid) 128)) *target*)
                         (if (or *progress-process* (not (-> *setting-control* current allow-pause)))
                           *master-mode*
                           'pause ;; no controller, jak spawned, no progress open, pause allowed.
                           ))
                        (else
                         (cond
                           ;; try to open the debug menu:
                           ((cpad-hold? 0 r3)
                            ;; R3 pushed, no target.
                            (if *debug-segment*
                              'menu ;; go to debug menu, when in debug mode.
                              *master-mode*))
                           (else
                            (cond
                              ;; debug mode pause allowed with select or R2.
                              ;; og:preserve-this allow select outside debug mode
                              ((or (cpad-hold? 0 select) (and *debug-segment* (cpad-hold? 0 r2)))
                               ;; pushing select or R2, and debug. allow pause.
                               'pause)
                              (else
                               (cond
                                 ;; ignore anything below here, unless we are pressing start, or debug.
                                 ((and (not *debug-segment*) (not (cpad-hold? 0 start))) *master-mode*)
                                 ;; if you pressed start, and progress isn't allowed, but pause is, do a pause.
                                 ((not (progress-allowed?)) (if (pause-allowed?) 'pause *master-mode*))
                                 ;; pushing start.
                                 ((cpad-hold? 0 start)
                                  ;; toggle between progress/game
                                  (if *progress-process* 'game 'progress))
                                 (else
                                  ;; nothing requested, stay in game.
                                  *master-mode*))))))))))
    (('menu)
     ;; in debug menu
     (set-master-mode (cond
                        ;; push R3 to exit to previous master mode.
                        ((cpad-hold? 0 r3) *last-master-mode*)
                        ;; select/R2 to pause.
                        ((cpad-hold? 0 select r2)
                         (if *debug-segment*
                           'pause
                           *master-mode* ;; not sure we can get to menu in non-debug...
                           ))
                        (else
                         (cond
                           ((and (not (movie?)) (not *progress-process*)) (if (not *target*) 'pause 'progress))
                           (else 'game)))))
     (set! *pause-lock* (and *cheat-mode* (cpad-hold? 0 r2))))
    (('pause)
     (set! *last-master-mode* *master-mode*)
     (set-master-mode (cond
                        ;; pause -> debug menu
                        ((cpad-hold? 0 r3) (if *debug-segment* 'menu *master-mode*))
                        (else
                         (cond
                           ;; pause -> single frame advance (R2)
                           ((and *cheat-mode* (cpad-hold? 0 select r2)) 'game)
                           ;; pause -> game
                           ;; og:preserve-this changed to allow select pause in retail
                           ((cpad-hold? 0 start select) 'game)
                           (else *master-mode*)))))
     (set! *pause-lock* (and *cheat-mode* (cpad-hold? 0 r2))))
    (('progress)
     (set-master-mode (cond
                        ;; progress -> debug
                        ((cpad-hold? 0 r3) (if *debug-segment* 'menu *master-mode*))
                        (else
                         ;; un-progress
                         (if (cpad-hold? 0 start) *last-master-mode* *master-mode*))))
     (set! *pause-lock* (and *cheat-mode* (cpad-hold? 0 r2)))))
  0)

(define *screen-filter* (new 'static 'screen-filter :draw? #f :color (new 'static 'rgba :g #x20 :b #x40 :a #x50)))

(defmethod draw ((this screen-filter))
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
    (draw-sprite2d-xy buf -256 (- (-> *video-parms* screen-hy)) 512 (-> *video-parms* screen-sy) (-> this color)))
  (none))

;;;;;;;;;;;;;;;;;;;;;;
;; Cheat Codes
;;;;;;;;;;;;;;;;;;;;;;

(define *cheat-temp* (the-as (pointer int32) (malloc 'global 20))) ;; 16 -> 20 (PAL)

(define *master-exit* #f)

(define *progress-cheat* #f)

(define *first-boot* #t) ;; PAL

(defun main-cheats ()
  "Handle cheat codes and timeout"
  ;; look for codes when L3 is pushed
  (when (and (cpad-hold? 0 l3)
             (or *cheat-mode* (= *kernel-boot-message* 'play)) ;; not in demo
             )
    ;; cheat mode
    (check-cheat-code (-> *cheat-temp* 0)
                      0
                      (up up down down left right left right x x square circle square circle)
                      (cpad-clear! 0 r1)
                      ;; toggle!
                      (not! *cheat-mode*)
                      (cheats-sound-play *cheat-mode*))
    ;; debug mode
    (when *cheat-mode*
      (check-cheat-code (-> *cheat-temp* 1)
                        0
                        (circle square circle square x x right left right left down down up up)
                        (cpad-clear! 0 r1)
                        ;; toggle between #t and debug.
                        (set! *cheat-mode* (if (= *cheat-mode* 'debug) #t 'debug))
                        (cheats-sound-play *cheat-mode*)))
    ;; language cheat, REMOVED IN PC PORT because it's literally useless
    #|
    (case (scf-get-territory)
      ;; japan-only
      ((GAME_TERRITORY_SCEI)
        (check-cheat-code (-> *cheat-temp* 2) 0
            (l1 r1 l1 r1 triangle circle x square)
              (cpad-clear! 0 r1)
              (set! *progress-cheat* (if *progress-cheat*
                                           #f
                                           'language
                                           ))
              (cheats-sound-play *progress-cheat*)
            )
       )
      )
    |#
    ;; debug only PAL cheat
    (when *debug-segment*
      (check-cheat-code (-> *cheat-temp* 3)
                        0
                        (x square triangle circle x square triangle circle)
                        (cpad-clear! 0 r1)
                        (set! *progress-cheat* (if *progress-cheat* #f 'pal))
                        (cheats-sound-play *progress-cheat*))
      ;; added in PAL
      (check-cheat-code (-> *cheat-temp* 4)
                        0 ;; they erroneously used (-> *cheat-temp* 5) here!
                        (triangle x circle square triangle x circle square)
                        (cpad-clear! 0 r1)
                        (set! *cheat-mode* (if (= *cheat-mode* 'camera) #f 'camera))
                        (cond
                          (*cheat-mode*
                           (if (not *external-cam-mode*) (external-cam-reset!))
                           (set! *external-cam-mode* 'pad-1)
                           (sound-play "select-menu"))
                          (else (set! *external-cam-mode* #f) (sound-play "cursor-options"))))))
  ;; debug cheats on retail builds
  (when (and (= *cheat-mode* 'debug) (not *debug-segment*))
    ;; target start/stop with l1/r1/l2/r2
    (when (and (cpad-hold? 0 l1) (cpad-hold? 0 l2) (cpad-hold? 0 r1) (cpad-pressed? 0 r2))
      (if *target* (stop 'debug) (start 'play (get-or-create-continue! *game-info*))))
    ;; reinitialize to title-start with left, up, select
    (if (and (cpad-hold? 0 left) (cpad-hold? 0 up) (cpad-pressed? 0 select))
      (initialize! *game-info* 'game (the-as game-save #f) "title-start"))
    ;; push R3 to print global heap status. not very useful.
    (if (cpad-pressed? 1 r3) (inspect global))
    ;; push R3 to display IOP memory stats
    (when (cpad-hold? 1 r3)
      ;; grab a dma buffer
      (with-dma-buffer-add-bucket ((dma-buff (if *debug-segment* (-> (current-frame) debug-buf) (-> (current-frame) global-buf))) (bucket-id debug))
        (show-iop-memory dma-buff)))
    ;; push triangle to see level info
    (if (cpad-pressed? 1 triangle) (not! *display-level-border*)))
  ;; handle timeouts
  (when (!= *kernel-boot-message* 'play) ;; not regular game mode?
    (let ((timeout (scf-get-timeout))
          (inactive-timeout (scf-get-inactive-timeout)))
      (when (and (or
                   ;; aboslute timout elapsed.
                   (and (nonzero? timeout)
                        (>= (the-as int (+ -300000 (the-as int (-> *display* real-frame-counter)))) (the int (* 300.0 (the float timeout)))))
                   (and (nonzero? inactive-timeout)
                        (>= (the-as int (- (current-time) (cpad-change-time 0))) (the int (* 300.0 (the float inactive-timeout)))))
                   (= *master-exit* 'force))
                 (progress-allowed?)
                 (!= *master-exit* #t))
        ;; spawn a process that blacks out the screen, turns things off, and kills the game.
        (if (process-spawn-function process
              :stack
              *scratch-memory-top*
              (lambda :behavior process ()
                (set-blackout-frames (seconds 100))
                (set! (-> *setting-control* default allow-pause) #f)
                (set! (-> *setting-control* default allow-progress) #f)
                (apply-settings *setting-control*)
                (set! (-> *setting-control* default sfx-volume) 0.0)
                (set! (-> *setting-control* default music-volume) 0.0)
                (set! (-> *setting-control* default dialog-volume) 0.0)
                (set! (-> *setting-control* default ambient-volume) 0.0)
                (let ((gp-0 (current-time))) (until (>= (the-as int (- (current-time) gp-0)) (seconds 0.1)) (suspend)))
                (kernel-shutdown)
                (none)))
          (set! *master-exit* #t) ;; process created successfully, set to exit
          ))))
  0)

(defbehavior display-loop process ()
  "the main 'display loop' in GOAL. v-sync is done in this function, so all frames start and end here."
  ;; increase our stack size.
  (stack-size-set! (-> self main-thread) 512)
  (let ((disp *display*))
    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    ;; Pre loop initialization
    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    ;; the size is 0, so this doesn't actually do anything.
    ;; (dma-send-to-spr (the-as uint #x70000000) (the-as uint *terrain-context*) (the-as uint 0) #t)
    (set! *teleport* #t)
    (update *setting-control*)
    (init-time-of-day-context *time-of-day-context*)
    (display-sync disp)
    (swap-display disp)
    (free-all-prim-nodes *touching-list*)
    (blerc-init)
    ;; collide dma
    (suspend)
    (while *run*
      ;; start immediately after all process updates finish.
      (profiler-instant-event "display-loop-top")
      ;; drawing effects to be used in foreground drawing.
      (with-profiler "foreground-effects"
        ;; with FP blerc, the vertices are modified in the PC renderer, so we can just skip
        ;; this call to save time.
        (unless *use-fp-blerc*
          (blerc-execute))
        (blerc-init)
        (texscroll-execute)
        (ripple-execute))
      ;;;;;;;;;;;;;;;;;;;;
      ;; AMBIENT
      ;;;;;;;;;;;;;;;;;;;;
      ;; set defaults for weather/music/flava.
      (with-profiler "ambients"
        (set! *weather-off* #f)
        (let ((v1-13 (-> *game-info* current-continue level)))
          (dotimes (a0-8 (-> *level* length))
            (let ((a1-6 (-> *level* level a0-8)))
              (when (= (-> a1-6 status) 'active)
                (if (and (= (-> a1-6 name) v1-13) (-> *level* play?)) (set! (-> *setting-control* default music) (-> a1-6 info music-bank)))))))
        (set! (-> *setting-control* default sound-flava) (the-as uint 49))
        (set! (-> *setting-control* default sound-flava-priority) 0.0)
        ;; find any ambients, and execute them.
        (when (and *execute-ambients* (not (paused?)))
          (if *target* (set! (-> *target* draw secondary-interp) 0.0))
          (let ((s5-1 (sphere<-vector+r! (new 'stack 'sphere) (ear-trans) 0.0)))
            (let ((v1-28 (scratchpad-object terrain-context))) (set! (-> v1-28 work ambient ambient-list num-items) 0))
            (dotimes (s4-1 (-> *level* length))
              (let ((v1-32 (-> *level* level s4-1)))
                (when (= (-> v1-32 status) 'active)
                  (collect-ambients (-> v1-32 bsp) s5-1 0 (-> (scratchpad-object terrain-context) work ambient ambient-list)))))
            (countdown (s4-2 (-> (scratchpad-object terrain-context) work ambient ambient-list num-items))
              (execute-ambient (-> (scratchpad-object terrain-context) work ambient ambient-list items s4-2) s5-1)))))
      (add-ee-profile-frame 'draw :r #x40 :b #x40) ;; actor update
      ;; do math, before drawing
      (with-profiler "math-engine"
        (execute-math-engine))
      ;; DEBUG PROF
      (add-ee-profile-frame 'draw :r #x80)
      (add-ee-profile-frame 'draw :r #x40 :b #x40)
      ;; debug hook
      (with-profiler "debug"
        (*debug-hook*)
        (main-cheats))
      (add-ee-profile-frame 'draw :r #x20 :g #x20)
      (with-profiler "camera"
        (update-camera))
      (add-ee-profile-frame 'draw :r #x40 :b #x40)
      (with-profiler "draw-hook"
        (*draw-hook*))
      (add-ee-profile-frame 'draw :g #x80)
      (with-profiler "menu"
        (#when PC_PORT
          (if (and *display-sha* *debug-segment*) (draw-build-revision)))
        (*menu-hook*)
        (add-ee-profile-frame 'draw :g #x40)
        ;; finally, update hints/text
        (make-current-level-available-to-progress)
        (update-task-hints)
        (load-level-text-files -1)
        (add-ee-profile-frame 'unknown-cpu-time)
        ;; collect perf stats
        (read! (-> *perf-stats* data (perf-stat-bucket all-code))))
      (with-profiler "dma-sync"
        (when (nonzero? (sync-path 0 0))
          (*dma-timeout-hook*)
          (reset-vif1-path)
          (if *debug-segment* (format 0 "profile bar at ~D.~%" (-> (current-frame) profile-bar 1 profile-frame-count))))
        (reset! (-> *perf-stats* data (perf-stat-bucket all-code))))
      ;; depth cue
      (if (not *progress-process*) (depth-cue disp))
      ;; screen filter
      (with-profiler "post-sync-draw"
        ;; Gcutscene-reframe: one-shot boot measurement, published to the console. Placed here
        ;; because this is exactly where `letterbox` itself is called, so the frame buffer and
        ;; *math-camera* are both known-good at this point in the iteration.
        (#when PC_PORT
          (when (not *cutscene-reframe-measured*)
            (set! *cutscene-reframe-measured* #t)
            (cutscene-reframe-measure)))
        ;; add letterbox effect
        (when (or (movie?) (< (current-time) (-> *game-info* letterbox-time)))
          (if (< (-> *game-info* letterbox-time) (current-time)) (set! (-> *game-info* letterbox-time) (current-time)))
          (if (#if (not PC_PORT)
                (= (-> *setting-control* current aspect-ratio) 'aspect4x3)
                (or (= (-> *setting-control* current aspect-ratio) 'aspect4x3) (not (-> *pc-settings* use-vis?))))
            (letterbox)))
        ;; Gloading-screen : mesure d'amorcage de la porte de l'ecran de chargement. Placee ici
        ;; pour la meme raison que celle du reframe juste au-dessus : `*game-info*` et le tampon
        ;; de frame sont tous deux dans un etat connu a ce point de l'iteration.
        (#when PC_PORT
          (when (not *loading-screen-probed*)
            (set! *loading-screen-probed* #t)
            (loading-screen-probe)))
        ;; add blackout effect
        ;; Gloading-screen : quand une BARRIERE DE CHARGEMENT tient l'image, c'est l'ecran de
        ;; chargement qui possede le noir et il le peint LUI-MEME. Raison MESUREE, pas supposee :
        ;; le noir du moteur n'est pas un sprite, c'est un quad plein ecran dessine par l'etage
        ;; PCRTC APRES tous les buckets -- OpenGLRenderer.cpp:1937 sur bureau et
        ;; android_opengl_renderer.cpp:1602 sur telephone, la meme ligne des deux cotes. Rien de
        ;; ce que GOAL emet dans un bucket ne peut donc apparaitre par-dessus. On eteint
        ;; `bg-a-force` PENDANT la barriere, et `loading-screen-draw` peint son propre fond noir.
        ;; HORS barriere, ces deux lignes sont exactement celles d'avant.
        (let ((ls-held (loading-screen-held?)))
          (if (and (< (current-time) (-> *game-info* blackout-time)) (not ls-held))
            (set! (-> *setting-control* default bg-a-force) 1.0)
            (set! (-> *setting-control* default bg-a-force) 0.0))
          ;; Gloading-screen (owner 2026-08-29, retour n.2) : recenser CETTE frame. Placee ici et
          ;; pas ailleurs parce que c'est le seul point ou l'on sait a la fois que la frame va etre
          ;; produite, si le moteur la noircit, et si une barriere la retient.
          (#when PC_PORT
            (blackout-census! (< (current-time) (-> *game-info* blackout-time)) ls-held))
          (#when PC_PORT
            ;; Gloading-screen : instrument de capture de la silhouette. Eteint par defaut
            ;; (`*ls-capture-trace*` = #f), allume uniquement depuis la console pendant une
            ;; course de capture. Place ici parce que `*math-camera*` porte a ce point la matrice
            ;; de la frame qui va etre ecrite -- c'est celle-la qui decide de l'abscisse ecran.
            (ls-capture-trace)
            (when ls-held (loading-screen-draw))
            ;; controle positif du chemin de dessin -- debug uniquement, un seul tir, et seulement
            ;; une fois la banque de texte chargee (sinon il ne couvrirait que le fond noir).
            (when (and *debug-segment* (not *loading-screen-draw-probed*) *common-text* (not ls-held))
              (set! *loading-screen-draw-probed* #t)
              (loading-screen-draw-probe))))
        (read! (-> *perf-stats* data (perf-stat-bucket all-code)))
        ;; grab a buffer for drawing debug stuff.
        ;; we might draw even outside of debug mode if cheat-mode is disabled.
        (let ((debug-txt-buf (-> (if *debug-segment*
                                   (-> disp frames (-> disp on-screen) frame debug-buf)
                                   (-> disp frames (-> disp on-screen) frame global-buf))
                                 base)))
          ;; debug drawing
          (when *debug-segment*
            (#when PC_PORT
              (if *display-pad-debug* (debug-pad-display (-> *cpad-list* cpads 0)))
              (when (and (or (= *master-mode* 'game) (= *master-mode* 'pause)) (-> *entity-debug-inspect* entity))
                (define-extern entity-inspect-draw (function entity-debug-inspect object))
                (entity-inspect-draw *entity-debug-inspect*)))
            (debug-draw-buffers) ;; lines/text
            ;; debug dma
            (with-dma-buffer-add-bucket ((debug-buf (-> disp frames (-> disp on-screen) frame debug-buf)) (bucket-id debug-no-zbuf))
              (when *display-profile*
                (dma-buffer-add-gs-set debug-buf
                                       (alpha-1 (new 'static 'gs-alpha :b 1 :d 1))
                                       (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24) :zmsk 1))
                                       (test-1 (new 'static 'gs-test :zte 1 :ztst (gs-ztest always)))
                                       (pabe 0)
                                       (clamp-1 (new 'static 'gs-clamp :wms (gs-tex-wrap-mode clamp) :wmt (gs-tex-wrap-mode clamp)))
                                       (tex1-1 (new 'static 'gs-tex1 :mmag 1 :mmin 1))
                                       (texa (new 'static 'gs-texa :ta1 #x80))
                                       (texclut (new 'static 'gs-texclut :cbw 4))
                                       (fogcol *fog-color*))
                ;; draw the profile bars
                (dotimes (s2-0 2)
                  (let ((s1-0 (-> disp frames (-> disp on-screen) frame profile-bar s2-0)))
                    (add-end-frame s1-0 'end-draw (static-rgba #x40 #x40 #x40 #x40))
                    (draw s1-0 debug-buf (* 10 s2-0)))
                  0)) ;; end profiler draw
              (when *display-deci-count*
                (draw-string-xy (string-format "~D" *deci-count*) debug-buf 448 210 (font-color default) (font-flags shadow kerning)))
              ;; added
              (#when PC_PORT
                (draw *pc-settings* debug-buf)
                (draw-memory *pc-settings* debug-buf)
                (print-debug-misc *pc-settings*))
              (display-file-info)) ;; end dma let
            ) ;; end debug-segment
          ;; draw pause text.
          (with-dma-buffer-add-bucket ((s3-1 (if *debug-segment*
                                               (-> disp frames (-> disp on-screen) frame debug-buf)
                                               (-> disp frames (-> disp on-screen) frame global-buf)))
                                       (bucket-id debug))
            ;; PREUVE D'EXECUTION — phase Gfont-urbanist. UN SEUL TIR, et uniquement quand
            ;; le segment de debug est charge : un build de livraison ne dessine jamais ca.
            ;; On dessine les glyphes h p a . dans LES DEUX polices par le chemin de rendu
            ;; normal, puis on publie les nombres que ce chemin a reellement employes a
            ;; cote de ceux de la table. Sans ce tir, l'ecran-titre ne dessine ni « h » ni
            ;; « . » et la preuve ne porterait que sur « a ».
            (#when PC_PORT
              (when (and *debug-segment* (zero? *font-trace-done*))
                (set! *font-trace-done* 1)
                (draw-string-xy "hpa." s3-1 8 8 (font-color default) (font-flags shadow kerning large))
                (font-trace-dump "GRANDE POLICE font24-table" #t)
                (draw-string-xy "hpa." s3-1 8 24 (font-color default) (font-flags shadow kerning))
                (font-trace-dump "PETITE POLICE font12-table" #f)))
            (if (and (= *master-mode* 'pause) (!= *cheat-mode* 'camera))
              (draw-string-xy (lookup-text! *common-text* (text-id pause) #f)
                              s3-1
                              256
                              160
                              (font-color red)
                              (font-flags shadow kerning middle large)))
            ;; draw console text on screen
            (let ((a3-8 (the int (draw-string *stdcon0* s3-1 *font-context*))))
              (draw-string-xy *stdcon1*
                              s3-1
                              (the int (-> *font-context* origin x))
                              a3-8
                              (font-color default)
                              (font-flags shadow kerning)))
            ;; draw misc info
            (if *display-iop-info* (show-iop-info s3-1))
            (if *display-memcard-info* (show-mc-info s3-1)))
          (let ((v1-220 *dma-mem-usage*))
            (when (nonzero? v1-220)
              (set! (-> v1-220 length) (max 85 (-> v1-220 length)))
              (set! (-> v1-220 data 84 name) "debug")
              (+! (-> v1-220 data 84 count) 1)
              (+! (-> v1-220 data 84 used)
                  (&- (-> (if *debug-segment*
                            (-> disp frames (-> disp on-screen) frame debug-buf)
                            (-> disp frames (-> disp on-screen) frame global-buf))
                          base)
                      (the-as uint debug-txt-buf)))
              (set! (-> v1-220 data 84 total) (-> v1-220 data 84 used)))))
        ;; console buffers
        (set! *stdcon* (clear *stdcon0*)))
      ;; <--------------------------- SWAP DISPLAY!
      ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
      (with-profiler "swap-display"
        (swap-display disp))
      ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
      (set! (-> *time-of-day-context* title-updated) #f)
      (set! *teleport* #f)
      (when (nonzero? *teleport-count*)
        (set! *teleport* #t)
        (set! *teleport-count* (+ *teleport-count* -1)))
      ;; perf stats
      (with-profiler "process-particles"
        (process-particles))
      ;; vif0 collide
      (with-profiler "sound-update"
        (swap-sound-buffers (ear-trans) (camera-pos) (camera-angle))
        (str-play-kick))
      (with-profiler "level-update"
        (level-update *level*) ;; also updates settings.
        )
      (with-profiler "mc-run"
        (mc-run))
      ;; og:preserve-this
      ;; PC port note : this function checks to see if the memory card has been removed or swapped
      ;; and disabled auto-save if it has. the pc port can only disable auto-save manually through the menu option.
      ;; the port doesn't use memory cards so those checks will never pass.
      ;; it runs some C kernel functions which in the port also do some I/O which gets very slow very quickly.
      ;; we're just not gonna run it.
      ; (auto-save-check)
      (with-profiler "update-pc"
        (#when PC_PORT
          (update *pc-settings*)))
      ;; suspend
      (suspend)))
  0)

(defun on ((release-mode symbol))
  "Turn the game on."
  (when (not *dproc*)
    (unless release-mode
      (if (= (-> *level* level0 status) 'inactive) (bg 'halfpipe)))
    (set! *run* #t)
    (let ((new-dproc (process-spawn-function process display-loop :name 'display :from *4k-dead-pool* :to *display-pool*)))
      (set! *dproc* (the process (ppointer->process new-dproc))))
    (cond
      ((or (level-get-with-status *level* 'loaded) (level-get-with-status *level* 'alive) (level-get-with-status *level* 'active))
       (activate-levels! *level*)
       (when (not release-mode)
         (let ((entity-cam (entity-by-type camera-start)))
           (if (and entity-cam (type-type? (-> entity-cam type) entity-actor)) (camera-teleport-to-entity entity-cam)))))
      (else (kill-by-name 'display *active-pool*) (set! *dproc* #f)))
    *dproc*))

(defun off ()
  "Turn the game off."
  ;; stop the game and set the mode to debug
  (stop 'debug)
  ;; deactivate the levels
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i))) (if (= (-> lev status) 'active) (deactivate lev))))
  (set! *run* #f)
  0)
