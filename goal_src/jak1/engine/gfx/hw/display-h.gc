;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/hw/gs.gc")
(require "engine/ps2/timer-h.gc")

;; The display system takes care of managing the contexts for settings framebuffers/display settings
;; It also handles drawing the profile bars, game engine timing, and managing the two DMA buffers for
;; the double buffered rendering system.
;; The *display* global will hold the main display state, including the DMA buffers for each of the two frames

;; DECOMP BEGINS

;; display-env stores the GS settings for displaying a framebuffer on screen.
;; this is identical to the Sony sceGsDispEnv struct.
;; you can set one of these up with set-display-env, then use it with
;; put-display-env, which is implemented in the kernel and is a wrapper
;; around a Sony function.
(deftype display-env (structure)
  ((pmode   gs-pmode)
   (smode2  gs-smode2)
   (dspfb   gs-display-fb)
   (display gs-display)
   (bgcolor gs-bgcolor))
  :pack-me)

;; draw-env stores the GS settings for drawing to somewhere in VRAM.
;; the "addr" fields represent GS register addresses
;; this is identical to the Sony sceGsDrawEnv1/2 structs
;; Internally, this is register + address GIF data.
(deftype draw-env (structure)
  ((frame1         gs-frame)
   (frame1addr     gs-reg64)
   (zbuf1          gs-zbuf)
   (zbuf1addr      gs-reg64)
   (xyoffset1      gs-xy-offset)
   (xyoffset1addr  gs-reg64)
   (scissor1       gs-scissor)
   (scissor1addr   gs-reg64)
   (prmodecont     gs-prmode-cont)
   (prmodecontaddr gs-reg64)
   (colclamp       gs-color-clamp)
   (colclampaddr   gs-reg64)
   (dthe           gs-dthe)
   (dtheaddr       gs-reg64)
   (test1          gs-test)
   (test1addr      gs-reg64)))

(defun put-draw-env ((packet (pointer gif-tag)))
  "Begin DMA transfer to the GIF/GS to send a draw env packet.
   The length of the transfer is taken from the nloop field of the tag."
  ;; this is a workaround for OpenGOAL not supporting 128-bitfield access yet.
  (#when PC_PORT
    (return #f))
  (let ((packet64 (the-as (pointer gif-tag64) packet)))
    (dma-send GIF_DMA_BANK (the-as uint packet) (the-as uint (+ (the-as uint (-> packet64 0 nloop)) (the-as uint 1)))))
  (none))

;; Per frame data that is used by the renderers.
(deftype display-frame (basic)
  ((calc-buf     dma-buffer :offset 8)
   (vu1-buf      dma-buffer :overlay-at calc-buf)
   (debug-buf    dma-buffer :offset 36)
   (global-buf   dma-buffer :offset 40)
   (bucket-group (inline-array dma-bucket) :offset 44)
   (buffer       dma-buffer 11 :offset 4)
   (profile-bar  profile-bar 2 :offset 48)
   (run-time     int64 :offset 56))
  (:methods
   (new (symbol type) _type_)))

(defmethod new display-frame ((allocation symbol) (type-to-make type))
  "Allocate a new display frame"
  (let ((this (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set! (-> this calc-buf) (the-as dma-buffer 0))
    (set! (-> this global-buf) (the-as dma-buffer 0))
    (set! (-> this debug-buf) (the-as dma-buffer 0))
    ;; allocate profile-bars in the debug heap, if we're debugging.
    (when *debug-segment*
      (set! (-> this profile-bar 0) (new 'debug 'profile-bar))
      (set! (-> this profile-bar 1) (new 'debug 'profile-bar)))
    this))

;; unused?
(deftype virtual-frame (structure)
  ((display      display-env)
   (display-last display-env)
   (gif          pointer)
   (draw         draw-env)
   (frame        display-frame))
  :allow-misaligned)

;; This tracks all of the display stuff in a single global
(deftype display (basic)
  ;; first, 3x environments. Not sure why we need 3.
  ((display-env0 display-env :inline)
   (display-env1 display-env :inline)
   (display-env2 display-env :inline)
   ;; the gif-tag + draw is a gif-packet to setting the draw-env.
   ;; the draw-env is actually just a+d data.
   (gif-tag0 gs-gif-tag :inline)
   (draw0 draw-env :inline)
   (gif-tag1 gs-gif-tag :inline)
   (draw1 draw-env :inline)
   (gif-tag2 gs-gif-tag :inline)
   (draw2 draw-env :inline)
   ;; frame indices
   (on-screen int32)
   (last-screen int32)
   ;; not sure why we have 6, it seems like only the first 2 actually
   ;; have valid display-frames in them.
   (frames virtual-frame 6 :inline)
   (bg-clear-color rgba 4)
   ;; counters
   (real-frame-counter time-frame)
   (base-frame-counter time-frame)
   (game-frame-counter time-frame)
   (integral-frame-counter time-frame)
   (real-integral-frame-counter time-frame)
   (actual-frame-counter time-frame)
   (real-actual-frame-counter time-frame)
   (part-frame-counter time-frame)
   ;; the "old" counters are the values from the previous tick.
   ;; the counters above may jump during a load.
   (old-real-frame-counter time-frame)
   (old-base-frame-counter time-frame)
   (old-game-frame-counter time-frame)
   (old-integral-frame-counter time-frame)
   (old-real-integral-frame-counter time-frame)
   (old-actual-frame-counter time-frame)
   (old-real-actual-frame-counter time-frame)
   (old-part-frame-counter time-frame)
   ;; timing stats for how fast the engine is currently running.
   (time-ratio float) ;; engine speed, 1.0 = full speed
   (seconds-per-frame float) ;; 1/fps
   (frames-per-second float) ;; fps
   (time-factor float) ;; 6 on PAL, 5 on NTSC, "ticks" / frame
   (time-adjust-ratio float) ;; 1 on NTSC full speed, 1.2 PAL full speed.
   )
  (:methods
   (new (symbol type int int int int int) _type_)
   (set-time-ratios (_type_ float) float)))

(define-extern *display* display)

(define-extern set-display (function display int int int int int display))

(defmethod new display ((allocation symbol) (type-to-make type) (psm int) (w int) (h int) (ztest int) (zpsm int))
  (let ((this (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    ;; set the display size, texture format, zbuffer format, etc.
    (set-display this psm w h ztest zpsm)
    ;; set up frames. for the most part only the first 2 make sense, and
    ;; the rest have repeats.
    (set! (-> this frames 0 display) (-> this display-env0))
    (set! (-> this frames 1 display) (-> this display-env1))
    (set! (-> this frames 2 display) (-> this display-env2))
    (set! (-> this frames 3 display) (-> this display-env0))
    (set! (-> this frames 4 display) (-> this display-env1))
    (set! (-> this frames 5 display) (-> this display-env2))
    (set! (-> this frames 0 display-last) (-> this display-env2))
    (set! (-> this frames 1 display-last) (-> this display-env0))
    (set! (-> this frames 2 display-last) (-> this display-env1))
    (set! (-> this frames 3 display-last) (-> this display-env2))
    (set! (-> this frames 4 display-last) (-> this display-env0))
    (set! (-> this frames 5 display-last) (-> this display-env1))
    (set! (-> this frames 0 gif) (the-as pointer (-> this gif-tag0)))
    (set! (-> this frames 1 gif) (the-as pointer (-> this gif-tag1)))
    (set! (-> this frames 2 gif) (the-as pointer (-> this gif-tag2)))
    (set! (-> this frames 3 gif) (the-as pointer (-> this gif-tag0)))
    (set! (-> this frames 4 gif) (the-as pointer (-> this gif-tag1)))
    (set! (-> this frames 5 gif) (the-as pointer (-> this gif-tag2)))
    (set! (-> this frames 0 draw) (-> this draw0))
    (set! (-> this frames 1 draw) (-> this draw1))
    (set! (-> this frames 2 draw) (-> this draw2))
    (set! (-> this frames 3 draw) (-> this draw0))
    (set! (-> this frames 4 draw) (-> this draw1))
    (set! (-> this frames 5 draw) (-> this draw2))
    (set! (-> this frames 0 frame) (new 'global 'display-frame))
    (set! (-> this frames 1 frame) (new 'global 'display-frame))
    (set! (-> this frames 2 frame) (-> this frames 0 frame))
    (set! (-> this frames 3 frame) (-> this frames 1 frame))
    (set! (-> this frames 4 frame) (-> this frames 0 frame))
    (set! (-> this frames 5 frame) (-> this frames 1 frame))
    ;; do this again. just in case.
    (default-buffer-init *default-regs-buffer*)
    ;; set the default gray color.
    (set! (-> this bg-clear-color 0) (new 'static 'rgba :r #x80 :g #x80 :b #x80 :a #x80))
    (set! (-> this bg-clear-color 1) (new 'static 'rgba :r #x80 :g #x80 :b #x80 :a #x80))
    (set! (-> this bg-clear-color 2) (new 'static 'rgba :r #x80 :g #x80 :b #x80 :a #x80))
    (set! (-> this bg-clear-color 3) (new 'static 'rgba :r #x80 :g #x80 :b #x80 :a #x80))
    this))

(define *pre-draw-hook* (the (function object none) nothing))

(define *post-draw-hook* (the-as (function dma-buffer none) nothing))

(defmacro current-frame ()
  `(-> *display* frames (-> *display* on-screen) frame))

(defmacro current-time ()
  `(-> *display* base-frame-counter))

(defmacro integral-current-time ()
  `(-> *display* integral-frame-counter))

(defmacro real-current-time ()
  `(-> *display* real-frame-counter))

;; Gfixed-tick-interpolation (owner 2026-08-26) — LES TROIS SYMBOLES QUE L'HORLOGE A PAS
;; FIXE ECRIT DEPUIS LE NATIF (game/graphics/fixed_tick.cpp, publies par
;; game/kernel/jak1/kmachine.cpp `fixed_tick_publish`), UNE FOIS PAR IMAGE DESSINEE.
;;
;; POURQUOI DES VALEURS DE SYMBOLE ET PAS DES FONCTIONS NATIVES. Android ne passe pas
;; par `init_common_pc_port_functions` (android/android_runtime_compat.cpp
;; l'ecrase et n'enregistre AUCUN pc-*) : un symbole-fonction oublie la-bas ne casse pas
;; le lien, il fait sauter GOAL a l'adresse 0 et le processus meurt en SIGILL. Une
;; valeur de symbole non ecrite laisse au contraire `*fixed-tick-armed*` a 0, donc le
;; moteur reste EXACTEMENT sur son chemin d'origine. Le mode de defaillance est le
;; comportement d'avant, jamais un plantage.
;;
;; `*fixed-tick-armed*`   1 quand la simulation est pilotee a pas fixe de 1/60 s.
;; `*fixed-tick-catchup*` ticks de RATTRAPAGE restants : `display-loop` les execute
;;                        sans rien dessiner et decremente lui-meme ce compteur.
;; `*fixed-tick-alpha*`   alpha d'interpolation de rendu en micro-unites ; 1000000
;;                        signifie « pose courante », donc AUCUNE interpolation (c'est
;;                        ce que publie une cadence verrouillee a 60 Hz).
(define *fixed-tick-armed* 0)
(define *fixed-tick-catchup* 0)
(define *fixed-tick-alpha* 1000000)

;; Gfixed-tick-anim-interp (owner 2026-09-01) — « le pas de temps fixe a l'air bon, mais
;; les animations sont quand meme tres jittery ».
;;
;; CE QUI MANQUAIT, MESURE : l'alpha d'interpolation de rendu n'avait qu'UN SEUL
;; consommateur dans tout le moteur, la camera (`cam-render-interp!`). La pose de
;; squelette, elle, etait dessinee telle qu'elle sortait du DERNIER tick de logique,
;; donc elle sautait d'un tick a l'autre pendant que la camera, elle, avancait
;; regulierement. C'est exactement la gigue decrite.
;;
;; `*fixed-tick-skip*`     1 quand cette image DESSINEE ne porte AUCUN tick de logique.
;;                         C'est l'« etape 2 » nommee par le rapport precedent : au-dessus
;;                         de 60 Hz il faut dessiner des images sans tick, sinon la
;;                         simulation reprend la cadence de l'affichage. `time-ratio` vaut
;;                         alors 0 (engine/draw/drawable.gc) et rien n'avance.
;; `*anim-interp-on*`      interrupteur d'ABLATION, ecrit par le natif depuis
;;                         OG_ANIM_INTERP / debug.opengoal.animinterp. Defaut 1. A 0, le
;;                         moteur reprend au bit pres le chemin d'avant cette phase.
;; `*anim-interp-probe*`   sonde par image dessinee (OG_ANIM_PROBE), opt-in au PRODUCTEUR.
;; `*anim-interp-alpha*`   l'alpha EFFECTIF de l'image en cours, en [0,1]. 1.0 signifie
;;                         « pose courante », donc AUCUNE interpolation — c'est ce que
;;                         publie une cadence verrouillee a 60 Hz, et c'est ce qui rend la
;;                         sortie 60 fps identique au bit PAR CONSTRUCTION.
;; `*anim-interp-n*`       nombre de canaux d'animation reellement retimes depuis le
;;                         demarrage. PREUVE DE CABLAGE : a 60 fps il doit rester a 0.
(define *fixed-tick-skip* 0)
(define *anim-interp-on* 1)
(define *anim-interp-probe* 0)
(define *anim-interp-alpha* 1.0)
(define *anim-interp-n* 0)

;; anim-interp-low-fps essai 6 — SONDE DE POSE DESSINEE ET RECENSEMENT PAR CAUSE.
;; La grandeur de la porte de l'essai 5 etait un MODELE tenu en C++ (`pose = E - (1-alpha)*k`) :
;; elle ne lisait AUCUNE valeur produite par GOAL, donc elle restait verte quel que soit le
;; nombre de poses non retimees. Ces symboles-ci sont lus par le natif a chaque image
;; (kmachine.cpp `send_gfx_dma_chain`) et remplacent le modele par une lecture.
(define *anim-probe-on* 0)      ;; 1 pendant do-joint-math! de l'acteur sonde (recensement seul)
;; La sonde ADOPTE le premier canal eligible de chaque image et le garde tant que son
;; `frame-group` ne change pas. Restreinte a `*target*`, elle n'a tire que 10 fois sur
;; 15720 images (mesure x86 du 2026-09-05) : le canal 0 de Jak n'avance presque jamais a
;; taux constant. Une sonde qui ne tire pas ne publie pas un vert, elle publie
;; `kNoMeasurement` -- mais elle ne mesure rien non plus.
(define *anim-probe-seen* 0)    ;; 1 des qu'un canal a ete echantillonne pour CETTE image
;; VERROU D'ACTEUR. Adopter « le premier canal eligible de l'image » ne suffit pas :
;; l'ordre de l'arbre des process change, et 15049 pas sur 15055 ont ete JETES parce que
;; l'identite changeait d'une image a l'autre (mesure x86 du 2026-09-05). La sonde se
;; verrouille donc sur UN `joint-control` — un acteur — et ne le lache que s'il disparait.
;; Le `frame-group` reste publie a cote : le natif jette le pas si l'ANIMATION change.
(define *anim-probe-key* 0)     ;; joint-control verrouille (identite de l'ACTEUR)
(define *anim-probe-miss* 1)    ;; le verrou n'a pas repondu a l'image precedente : readopter
(define *anim-probe-n* 0)       ;; nombre d'echantillons de pose deposes
;; EN VIRGULE FIXE, x65536, ET PAS EN FLOTTANT. Mesure du 2026-09-05 : un symbole GOAL
;; ENTIER traverse `intern_from_c().value` sans probleme (`*anim-probe-id*` a rendu 51730292),
;; un symbole FLOTTANT rend un motif de bits NUL — 15109 pas sur 15113 jetes pour cette seule
;; raison. On convertit donc cote GOAL. Resolution 1/65536 de frame, soit 0,25 us a un tick par
;; frame : trois ordres de grandeur sous le seuil de 500 us de la porte.
(define *anim-probe-frame-q* 0) ;; frame-num DESSINE x65536
(define *anim-probe-rate-q* 0)  ;; pas d'UN tick a ratio 1 x65536 : param0 * speed
(define *anim-probe-p0-q* 0)    ;; param0 seul x65536 : separe « flottant muet » de « speed nulle »
;; QUELLE BRANCHE le canal SONDE a-t-il prise ? 1 = sortie en identite (ablation, alpha>=1,
;; spool), 2 = delta nul, 3 = REELLEMENT retime. La sonde mesure 7222 us de gigue a 45 img/s
;; la ou le modele en annonce 153 : il faut savoir si le retimeur s'applique et se trompe,
;; ou s'il ne s'applique pas du tout. Un total de canaux retimes ne repond pas pour CE canal.
(define *anim-probe-br* 0)
;; LE k QUE GOAL A REELLEMENT APPLIQUE, x65536, cumule. Le modele C++ additionne SON k ;
;; la sonde lit une pose avancee par `time-adjust-ratio`. Si les deux k divergent, le
;; modele reste vert et la pose saute — c'est exactement l'ecart de 7222 us contre 153
;; mesure a 45 img/s. On publie donc la somme des k de GOAL pour la comparer a celle du C++.
(define *anim-goal-ksum-q* 0)  ;; x1024
(define *anim-probe-id* 0)      ;; identite (frame-group) du canal ; un changement invalide le pas
;; Recensement des poses NON retimees. Recense le GESTE, pas le predicat : un recensement
;; par SITE rendrait zero alors que le defaut est dans le nombre d'occurrences par cause.
(define *anim-cen-total* 0)     ;; appels a joint-channel-render-frame
(define *anim-cen-ident* 0)     ;; sortie en identite : ablation, alpha>=1.0, ou canal spool
(define *anim-cen-zero* 0)      ;; delta = 0 : num-func hors des quatre traites, ou seek a la cible
;; `anim_cen_zero` vaut 59 % des canaux (413912 / 697775, x86 2026-09-05). Un seul chiffre
;; ne dit pas si c'est un DEFAUT : une pose statique n'a rien a retimer. On l'audite donc
;; par VALEUR de `num-func`, pas par site.
(define *anim-cen-static* 0)    ;; none/identity : frame-num n'avance pas -- rien a retimer, PAS un defaut
(define *anim-cen-seekend* 0)   ;; seek! arrive a la cible : pas nul, reponse conservatrice
(define *anim-cen-other* 0)     ;; delta nul SANS raison connue : c'est la seule part suspecte
(define *anim-cen-blend* 0)     ;; canaux num-func-blend-in! : c'est frame-interp qui avance, jamais retime
(define *anim-cen-done* 0)      ;; poses reellement retimees
(define *djm-total* 0)          ;; appels a do-joint-math!
(define *djm-shift* 0)          ;; racine decalee (trans seulement)
(define *djm-noroot* 0)         ;; root absente ou pas un trsqv : racine NON decalee
(define *djm-rotv* 0)           ;; rotv non nulle : la ROTATION monde n'est PAS retimee

;; anim-interp-low-fps — L'IMAGE DE RENDU SEUL, HORS HORLOGE A PAS FIXE.
;; `*render-pace-skip*`  1 quand l'image DESSINEE qu'on prepare ne porte aucun tick de
;;                       logique (l'affichage va plus vite que la cadence cible).
;;                       `display-frame-start` y met `time-ratio` a 0. Sans ce cas, au moins
;;                       un tick etait impose par image dessinee, la simulation passait
;;                       devant le temps reel et l'alpha se collait a 0 : mesure du
;;                       2026-09-05, 2444 images sur 2838 (86 %) a alpha nul.
;; `*render-pace-ratio*` `time-adjust-ratio` de la DERNIERE image qui a porte un tick. C'est
;;                       l'unite dans laquelle les retimeurs reculent. Sur une image de rendu
;;                       seul `time-adjust-ratio` vaut 0 : le lire la rendrait le pas nul,
;;                       donc AUCUN retimage, donc une image figee.
(define *render-pace-skip* 0)
(define *render-pace-ratio* 1.0)

;; Declaree ici (et pas seulement dans pc/pckernel-h.gc) parce que `display-frame-start`
;; en a besoin et qu'il est compile bien avant le pckernel. Le symbole est fourni par les
;; DEUX plateformes (game/kernel/common/kmachine.cpp cote bureau,
;; android/gk_android_main.cpp cote appareil) et `cam-render-interp!` l'appelle deja.
(define-extern pc-camera-interp-alpha (function int))

(defmacro seconds-per-frame ()
  `(-> *display* seconds-per-frame))

(defmacro set-time! (time)
  `(set! ,time (current-time)))

(defmacro time-elapsed? (time duration)
  `(>= (- (current-time) ,time) ,duration))

;; debug stuff really
(defmacro get-screen-x (frac)
  `(the int (* ,frac 512)))

(defmacro get-screen-y (frac)
  `(the int (* ,frac 224)))

(define *post-draw-hook* (the-as (function dma-buffer none) nothing))
