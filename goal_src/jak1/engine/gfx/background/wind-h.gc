;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/math/vector-h.gc")

;; These "wind" types are used in the tie/shrub renderers to make things sway in the breeze.
;; It generates vectors that are applied as shear to the instance matrices.

;; DECOMP BEGINS

(deftype wind-vector (structure)
  ((wind-pos vector2w :inline)
   (wind-vel vector2w :inline)))

(define *wind-scales*
  (new 'static
       'boxed-array
       :type
       uint8
       #x2
       #x5
       #x2
       #x3
       #x2
       #x2
       #x3
       #x10
       #xa
       #x2
       #x4
       #x2
       #x8
       #x2
       #x2
       #x10
       #x2
       #x2
       #x8
       #x2
       #x10
       #x2
       #x4
       #x10
       #xa
       #x2
       #x4
       #x2
       #x8
       #x2
       #x2
       #x10))

(deftype wind-work (basic)
  ((wind-array  vector 64 :inline)
   (wind-normal vector :inline)
   (wind-temp   vector :inline)
   (wind-force  float 64)
   (wind-time   uint32)))

;; Grecharged-foliage-wind3 (owner 2026-08-31, defaut D1). Deux VALEURS de symbole, aucun
;; symbole-FONCTION nouveau : sur Android la table des symboles est batie par un chemin separe et
;; un symbole-fonction oublie la-bas fait sauter GOAL a l'adresse 0 (SIGILL), alors qu'une valeur
;; non ecrite laisse simplement le defaut ci-dessous.
;;
;; `*wind-native-rate*`  1 = le vent avance d'un pas de 1/60 s par 1/60 s de temps de jeu, quelle
;;                       que soit la cadence d'affichage (le comportement d'une PS2 a 60 images/s).
;;                       0 = jambe d'ABLATION : un seul pas par image dessinee, avec le facteur
;;                       `time-adjust-ratio` d'avant cette phase. Ecrit par le natif depuis
;;                       OG_WIND_NATIVE_RATE / debug.opengoal.wind.native_rate.
;; `*wind-tick-acc*`     reste fractionnaire de pas, conserve d'une image a l'autre pour que la
;;                       moyenne longue soit exactement 60 pas par seconde.
(define *wind-native-rate* 1)
(define *wind-tick-acc* 0.0)

; This was likely originally defined inside `wind-h`
; but the decompiler won't output it, so we have to manually define it
(define-extern *wind-work* wind-work)

(defun wind-get-hashed-index ((arg0 vector))
  (logand (+ (the int (-> arg0 x)) (the int (-> arg0 z)) (-> *wind-work* wind-time)) 63))
