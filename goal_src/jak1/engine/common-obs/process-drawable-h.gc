;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/hw/display-h.gc")
(require "engine/anim/joint-h.gc")
(require "engine/game/game-h.gc")
(define-extern cspace-index-by-name (function process-drawable string int))

(define-extern cspace-by-name (function process-drawable string cspace))

(define-extern joint-control-reset! (function joint-control joint-control-channel none :behavior process-drawable))

(defun cspace-by-name-no-fail ((arg0 process-drawable) (arg1 string))
  "Get a cspace by name from the given process-drawable. If it fails, print an error and return the first one"
  (let ((result (cspace-by-name arg0 arg1)))
    (cond
      (result result)
      (else (format 0 "no cspace (~A)~%" arg1) (-> arg0 node-list data 0)))))

(defun cspace-index-by-name-no-fail ((arg0 process-drawable) (arg1 string))
  "Get the index of a cspace by name from the given process drawable. If it fails, print an error and return 0."
  (let ((v0-0 (cspace-index-by-name arg0 arg1)))
    (cond
      ((< v0-0 0) (format 0 "no cspace[ndx] (~A)~%" arg1) 0)
      (else v0-0))))

;; The following functions can be applied to a joint-control-channel to change the frame number.
;; They return the resulting frame number as well.

(defun num-func-none ((arg0 joint-control-channel) (arg1 float) (arg2 float))
  "Don't change anything."
  (-> arg0 frame-num))

(defun num-func-+! ((arg0 joint-control-channel) (arg1 float) (arg2 float))
  "Increment the frame number, taking into account the animation speed and current game rate."
  (let ((f0-1 (+ (-> arg0 frame-num) (* arg1 (* (-> arg0 frame-group speed) (-> *display* time-adjust-ratio))))))
    (set! (-> arg0 frame-num) f0-1)
    f0-1))

(defun num-func--! ((arg0 joint-control-channel) (arg1 float) (arg2 float))
  "Decrement the frame number, taking into account the animation speed and current game rate."
  (let ((f0-1 (- (-> arg0 frame-num) (* arg1 (* (-> arg0 frame-group speed) (-> *display* time-adjust-ratio))))))
    (set! (-> arg0 frame-num) f0-1)
    f0-1))

(defun num-func-loop! ((chan joint-control-channel) (inc float) (arg2 float))
  "Like num-func-+!, but will wrap to 0 after going past the end."
  ;; get the duration from the joint-animation-compressed.
  (let* ((duration (the float (+ (-> chan frame-group data 0 length) -1)))
         ;; increment (also add a full duration to it, I guess to avoid issues if inc is negative and we're near the start.)
         (after-inc (+ (-> chan frame-num) duration (* inc (* (-> chan frame-group speed) (-> *display* time-adjust-ratio)))))
         ;; wrap.
         (wrapped (- after-inc (* (the float (the int (/ after-inc duration))) duration))))
    (set! (-> chan frame-num) wrapped)
    wrapped))

(defun num-func-seek! ((arg0 joint-control-channel) (arg1 float) (arg2 float))
  "Seek toward arg1 by at most arg2 (taking into account speed etc)"
  (let ((f0-3 (seek (-> arg0 frame-num) arg1 (* arg2 (* (-> arg0 frame-group speed) (-> *display* time-adjust-ratio))))))
    ;; set it twice, just to make sure.
    (set! (-> arg0 frame-num) f0-3)
    (set! (-> arg0 frame-num) f0-3)
    f0-3))

(defun num-func-blend-in! ((arg0 joint-control-channel) (arg1 float) (arg2 float))
  "Seek frame-interp toward 1. Once its there, do a joint-control-reset."
  (let ((f30-0 (seek (-> arg0 frame-interp) 1.0 (* arg1 (-> *display* time-adjust-ratio)))))
    (set! (-> arg0 frame-interp) f30-0)
    (set! (-> arg0 frame-interp) f30-0)
    (if (= f30-0 1.0) (joint-control-reset! (-> arg0 parent) arg0))
    f30-0))

(defun num-func-chan ((arg0 joint-control-channel) (arg1 float) (arg2 float))
  "Copies the frame number from the channel arg1."
  ;; this is a super hack.
  ;; we know that we're in an inline-array of joint-control-channels
  ;; and the group-sub-index is our index in our array
  ;; so we can compute the offset of the arg1-th index from this.
  (let ((f0-2 (-> (the-as joint-control-channel
                          (+ (the-as uint arg0)
                             (the-as uint
                                     ;; 48 * (difference in indices)
                                     (* 48 (- (the int arg1) (-> arg0 group-sub-index))))))
                  frame-num)))
    (set! (-> arg0 frame-num) f0-2)
    f0-2))

(defun num-func-identity ((arg0 joint-control-channel) (arg1 float) (arg2 float))
  "seems to be the same thing as none."
  (-> arg0 frame-num))

;; ============================================================================
;; Gfixed-tick-anim-interp (owner 2026-09-01) — INTERPOLATION DE RENDU DES POSES
;; ============================================================================
;; « Le pas de temps fixe a l'air bon, mais les animations sont quand meme tres
;; jittery ». Mesure : l'alpha d'interpolation de rendu n'avait qu'UN consommateur,
;; la camera. La pose de squelette etait dessinee telle qu'elle sortait du DERNIER
;; tick, donc elle sautait pendant que la camera avancait regulierement.
;;
;; LE PRINCIPE, ET POURQUOI IL NE COUTE RIEN. `frame-num` est un FLOTTANT, et le
;; decompresseur melange DEJA les deux frames compressees voisines par sa partie
;; fractionnaire (engine/anim/joint.gc, `build-requests!` -> `frame-interp` de
;; `joint-decomp-request`, puis `process-request!`). La pose est donc une fonction
;; CONTINUE de `frame-num`. Retimer le squelette, c'est evaluer cette meme fonction
;; a `frame-num - (1 - alpha) * pas`, sans decompresser une pose de plus, sans
;; stocker une pose N-1, et sans ecrire quoi que ce soit dans l'etat de jeu : c'est
;; le chemin de melange que le contrat demande de REUTILISER plutot que de doubler.
;;
;; RIEN N'EST MEMORISE. Le pas du dernier tick se RECALCULE a partir des memes
;; facteurs que les `num-func-*` ci-dessus (`param`, `frame-group speed`,
;; `time-adjust-ratio`). Un etat memorise se serait desynchronise a la premiere
;; naissance d'acteur, au premier changement d'animation et au premier chargement.

(defun joint-channel-tick-delta-direct ((chan joint-control-channel))
  "Pas applique par le DERNIER tick de logique, pour un canal qui avance tout seul.
   Rend 0.0 pour tout le reste : ce canal ne sera pas retime."
  (let* ((nf (-> chan num-func))
         ;; Sous pas fixe, un tick vaut TOUJOURS 1.0 -- y compris sur une image de
         ;; RENDU SEUL, ou `time-adjust-ratio` vaut 0 et ou lire ce champ rendrait un
         ;; pas nul, donc aucune interpolation exactement la ou elle est necessaire.
         ;; anim-interp-low-fps : `*render-pace-ratio*` et non `time-adjust-ratio`. Les deux
         ;; sont EGAUX sur toute image qui porte un tick ; sur une image de rendu seul le
         ;; second vaut 0, et un pas nul fait sortir ce retimeur en identite — l'image se
         ;; figerait au lieu de glisser.
         (ratio (if (nonzero? *fixed-tick-armed*) 1.0 *render-pace-ratio*))
         (rate (* (-> chan frame-group speed) ratio)))
    (cond
      ((or (= nf num-func-+!) (= nf num-func-loop!)) (* (-> chan param 0) rate))
      ((= nf num-func--!) (- (* (-> chan param 0) rate)))
      ((= nf num-func-seek!)
       ;; `seek` vers (param 0) au rythme (param 1). Tant que la cible n'est pas
       ;; atteinte le pas applique est PLEIN ; une fois dessus il vaut 0 et on ne
       ;; retime pas -- c'est la reponse conservatrice, jamais une extrapolation.
       (let ((step (* (-> chan param 1) rate))
             (rest (- (-> chan param 0) (-> chan frame-num))))
         (cond ((> rest 0.0) step)
               ((< rest 0.0) (- step))
               (else 0.0))))
      (else 0.0))))

(defun joint-channel-tick-delta ((chan joint-control-channel))
  "Comme ci-dessus, mais suit la redirection de `num-func-chan`.
   Un canal `chan` RECOPIE le `frame-num` d'un autre (meme arithmetique de 48 octets
   que `num-func-chan`) : il doit reculer d'autant que sa source, sinon un groupe
   multi-canal melangerait une pose retimee avec une pose qui ne l'est pas -- pire que
   de n'en retimer aucune. UN SEUL niveau de redirection, jamais de recursion."
  (if (= (-> chan num-func) num-func-chan)
      (joint-channel-tick-delta-direct
        (the-as joint-control-channel
                (+ (the-as uint chan)
                   (the-as uint (* 48 (- (the int (-> chan param 0)) (-> chan group-sub-index)))))))
      (joint-channel-tick-delta-direct chan)))

(defun joint-channel-render-frame ((chan joint-control-channel))
  "Numero de frame a DESSINER pour ce canal : `frame-num` recule de (1 - alpha) pas.
   RENDU SEUL -- n'ecrit jamais `frame-num`, donc la logique reste identique et les
   deux bras de l'ablation jouent exactement la meme partie."
  (+! *anim-cen-total* 1)
  (let* ((fn (-> chan frame-num))
         (br 0)
         (out
           (cond
             ;; Trois sorties qui rendent le MEME flottant qu'avant cette phase, au bit pres.
             ;;  - ablation (`OG_ANIM_INTERP=0`) ;
             ;;  - alpha == 1.0, c'est-a-dire « pose courante » : ce que publie une cadence
             ;;    VERROUILLEE a 60 Hz. La non-regression 60 fps est donc obtenue par
             ;;    CONSTRUCTION, pas par un reglage ;
             ;;  - acteur de CINEMATIQUE : son `frame-num` n'est pas incremente par un
             ;;    `num-func`, il est REECRIT chaque image depuis la position du flux audio
             ;;    (engine/load/loader.gc). Sa cadence est deja le temps reel ; le retimer
             ;;    ajouterait du flou la ou il n'y en a pas.
             ((or (zero? *anim-interp-on*)
                  (>= *anim-interp-alpha* 1.0)
                  (logtest? (-> chan parent status) (janim-status spool)))
              (+! *anim-cen-ident* 1)
              (set! br 1)
              fn)
             (else
              (let ((delta (joint-channel-tick-delta chan)))
                (cond
                  ((= delta 0.0)
                   ;; RECENSEMENT : cette pose n'est PAS retimee. `num-func-blend-in!` tombe ici
                   ;; parce qu'il n'avance pas `frame-num` mais `frame-interp`, le POIDS DE
                   ;; MELANGE lu par `eval-blend-tree!` (joint.gc:166,181) — un poids qui avance
                   ;; par ticks entiers pendant que tout le reste est interpole.
                   (+! *anim-cen-zero* 1)
                   (if (= (-> chan num-func) num-func-blend-in!) (+! *anim-cen-blend* 1))
                   ;; AUDIT PAR VALEUR. Un `delta = 0` n'est un defaut que si le canal AVANCE
                   ;; malgre tout. `none`/`identity` ne bougent pas : rien a retimer. `seek!`
                   ;; arrive a sa cible ne bouge plus non plus. Ce qui reste est la seule part
                   ;; qui decrit une pose qui saute.
                   (cond
                     ((or (= (-> chan num-func) num-func-none)
                          (= (-> chan num-func) num-func-identity))
                      (+! *anim-cen-static* 1))
                     ((= (-> chan num-func) num-func-seek!) (+! *anim-cen-seekend* 1))
                     ((= (-> chan num-func) num-func-blend-in!))
                     (else (+! *anim-cen-other* 1)))
                   (set! br 2)
                   fn)
                  (else
                   (let ((len-1 (the float (+ (-> chan frame-group data 0 length) -1))))
                     (cond
                       ;; ANIMATION DEGENEREE — LE CORRECTIF FABRIQUAIT LA GIGUE ICI.
                       ;; Moins de deux frames : il n'y a rien entre quoi interpoler, et la
                       ;; duree de bouclage de `num-func-loop!` vaut 0, donc `frame-num` ne
                       ;; bouge JAMAIS d'un tick a l'autre. Le `delta` nominal
                       ;; (`param 0 * speed * ratio`), lui, vaut quand meme 1,0 : on reculait
                       ;; donc une pose IMMOBILE de -(1 - alpha), une valeur qui change a
                       ;; chaque image. Mesure x86 du 2026-09-05 (essai 7), un seul canal dans
                       ;; ce cas : `frame-num` = 0,0 constant, sortie -0,2686, pas de pose de
                       ;; -1 tick EXACTEMENT a chaque echantillon, 265 fois sur 2560 dans le
                       ;; seau 45 img/s — a lui seul les 5072 us d'ecart type du seau, les
                       ;; 2295 autres pas rendant 25 us. Et `build-requests!` (joint.gc:224)
                       ;; convertissait ce numero NEGATIF en `frac-frame` negatif, c'est-a-dire
                       ;; une extrapolation hors de l'animation.
                       ((< len-1 1.0)
                        (+! *anim-cen-degen* 1)
                        (set! br 4)
                        fn)
                       (else
                        ;; PREUVE DE CABLAGE : ce compteur est le seul temoin qu'une pose a
                        ;; REELLEMENT ete retimee. A 60 images/s il doit rester a 0.
                        (+! *anim-interp-n* 1)
                        (+! *anim-cen-done* 1)
                        (set! br 3)
                        (let ((f (- fn (* (- 1.0 *anim-interp-alpha*) delta))))
                          (cond
                            ((>= f 0.0) f)
                            ;; Animation en BOUCLE : reculer avant 0 doit revenir par la FIN,
                            ;; sinon la premiere image apres chaque bouclage saute au debut.
                            ;; Le bouclage n'est valable que s'il RAMENE dans l'animation.
                            ((and (= (-> chan num-func) num-func-loop!) (>= (+ f len-1) 0.0))
                             (+ f len-1))
                            ;; La cible sort de l'animation et rien ne l'y ramene : on ne
                            ;; retime PAS. L'ancien `0.0` epinglait la pose sur la premiere
                            ;; frame — c'est un saut, pas une identite — et il masquait le cas
                            ;; degenere ci-dessus des que le canal n'etait pas un `loop!`.
                            (else (+! *anim-cen-oob* 1) fn)))))))))))))
    ;; SONDE DE POSE DESSINEE. `out` est exactement le flottant que `build-requests!`
    ;; (joint.gc:224) transforme en `base-frame` + `frac-frame` : c'est la pose DESSINEE, pas un
    ;; modele. On ne l'echantillonne que sur le canal 0 de l'acteur sonde, et seulement quand le
    ;; canal avance a taux constant (`+!` ou `loop!`) — sinon le pas n'a pas de reference.
    ;; Elle ADOPTE le PREMIER canal eligible de chaque image, quel que soit l'acteur.
    ;; Restreinte a `*target*`, elle n'a tire que 10 fois sur 15720 images : le canal 0 de Jak
    ;; n'avance presque jamais a taux constant. L'identite du groupe est publiee a cote et le
    ;; natif JETTE tout pas dont l'identite ou le taux a change — un changement d'acteur ne
    ;; peut donc pas se lire comme un pas de pose.
    ;; ELIGIBILITE : le canal doit AVANCER. Mesure du 2026-09-05 : la sonde s'etait verrouillee
    ;; sur un canal dont `param 0` vaut 0 — une animation a l'arret — et les 15109 pas ont ete
    ;; jetes pour taux nul. Un canal immobile est une pose parfaitement lisse et ne dit rien du
    ;; defaut ; c'est une cadence NON exercee, pas un vert.
    ;; ELIGIBILITE, DEUXIEME CLAUSE (essai 7) : l'animation doit avoir au moins DEUX frames.
    ;; `param 0 * speed > 0` dit que le canal est CENSE avancer ; il ne dit pas qu'il avance.
    ;; Une animation d'une seule frame boucle sur une duree nulle : `frame-num` reste a 0,0
    ;; pour toujours et son « pas de pose » n'est que l'alpha. C'est une cadence NON exercee,
    ;; pas une pose qui saute. Le canal reste recense (`*anim-cen-degen*`) : il n'est pas
    ;; ecarte en silence.
    (when (and (zero? (-> chan group-sub-index))
               (or (= (-> chan num-func) num-func-+!)
                   (= (-> chan num-func) num-func-loop!))
               (> (-> chan frame-group data 0 length) 1)
               (> (* (-> chan param 0) (-> chan frame-group speed)) 0.0))
      (cond
        ;; L'ACTEUR VERROUILLE, ou qu'il se trouve dans l'arbre. On ne s'arrete pas au premier
        ;; canal eligible : le verrou peut apparaitre plus loin que lui.
        ((and (nonzero? *anim-probe-key*)
              (= (the-as int (-> chan parent)) *anim-probe-key*))
         (set! *anim-probe-seen* 1)
         (set! *anim-probe-frame-q* (the int (* 65536.0 out)))
         (set! *anim-probe-raw-q* (the int (* 65536.0 fn)))
         (set! *anim-probe-clamped*
               (if (or (< out 0.0)
                       (>= (the int out) (+ (the int (-> chan frame-group frames num-frames)) -1)))
                   1
                   0))
         (set! *anim-probe-rate-q* (the int (* 65536.0 (* (-> chan param 0) (-> chan frame-group speed)))))
         (set! *anim-probe-p0-q* (the int (* 65536.0 (-> chan param 0))))
         (set! *anim-probe-id* (the-as int (-> chan frame-group)))
         (set! *anim-probe-br* br)
         (+! *anim-probe-n* 1))
        ;; Le verrou n'a pas repondu a l'image precedente : on en adopte un nouveau, une seule
        ;; fois, et le natif jettera le pas qui enjambe l'adoption.
        ((and (zero? *anim-probe-seen*) (nonzero? *anim-probe-miss*))
         (set! *anim-probe-seen* 1)
         (set! *anim-probe-miss* 0)
         (set! *anim-probe-key* (the-as int (-> chan parent)))
         (set! *anim-probe-frame-q* (the int (* 65536.0 out)))
         (set! *anim-probe-raw-q* (the int (* 65536.0 fn)))
         (set! *anim-probe-clamped*
               (if (or (< out 0.0)
                       (>= (the int out) (+ (the int (-> chan frame-group frames num-frames)) -1)))
                   1
                   0))
         (set! *anim-probe-rate-q* (the int (* 65536.0 (* (-> chan param 0) (-> chan frame-group speed)))))
         (set! *anim-probe-p0-q* (the int (* 65536.0 (-> chan param 0))))
         (set! *anim-probe-id* (the-as int (-> chan frame-group)))
         (set! *anim-probe-br* br)
         (+! *anim-probe-n* 1))))
    out))

(defenum entity-perm-status
  :bitfield #t
  :type uint16
  (bit-0 0)
  (bit-1 1)
  (dead 2)
  (bit-3 3)
  (bit-4 4)
  (user-set-from-cstage 5)
  (complete 6)
  (bit-7 7)
  (real-complete 8)
  (bit-9 9)
  (bit-10 10))

(define-extern process-entity-status! (function process entity-perm-status symbol int))

(defmacro ja-group (&key (chan 0))
  "get the frame group for self. default channel is 0, the base channel. returns #f if no frame group."
  `(if (> (-> self skel active-channels) ,chan) (-> self skel root-channel ,chan frame-group)))

(defmacro ja-group? (group &key (chan 0))
  "is self in this frame group on this channel? default is channel 0, which is the base channel."
  `(= (ja-group) ,group))

(defmacro ja (&key (chan 0) &key (group! #f) &key (num! #f) &key (param0 #f) &key (param1 #f) &key (num-func #f) &key (frame-num #f) &key (frame-interp #f) &key (dist #f) &key (eval? #t))
  "set various joint anim parameters for self and eval them.
   you can use this for playing animations!

   chan         = the channel to modify. defaults to 0 (base channel). this is usually what you want.
   group!       = when not #f, set this as the new frame-group. defaults to #f
   num!         = set the frame playback function. this is what determines what frame an animation is at. funcs below.
                  #f = no func will be set, and there wont be a frame eval.
   num-func     = sets the num-func field for the channel. this lets you change the function with eval'ing.
   param0       = 1st parameter for the playback function. ONLY USE THESE WITH num-func !!
   param1       = 2nd parameter for the playback function. ONLY USE THESE WITH num-func !!
   frame-num    = set the frame-num field.
   frame-interp = set the frame-interp field.
   dist         = set the dist field.

   available num! functions:
   - (+!)       = advance anim.
   - (-!)       = reverse anim.
   - (identity num) = play 'num' frame.
   - (seek! target speed) = animate towards frame target at a speed.
                            speed is optional and defaults to 1.0 when not provided.
                            target is optional and defaults to the last frame of the animation.
                            if you want to set the speed, you therefore must also set the target.
                            target can be max (no quote), which is just the same as the default value.
   - (loop! speed)  = loop animation at a speed. default speed is 1.0 when not provided.
   - (chan channel) = copy frame from another channel.
   - min = the start of the animation.
   - max = the end of the animation.
   "
  (let* ((num-args (if (pair? num!) (cdr num!) '()))
         (num! (if (pair? num!) (car num!) num!))
         (nf (cond
               ((or (eq? num! 'identity) (eq? num! 'min) (eq? num! 'max)) 'num-func-identity)
               ((eq? num! 'none) 'num-func-none)
               ((eq? num! '+!) 'num-func-+!)
               ((eq? num! '-!) 'num-func--!)
               ((eq? num! 'seek!) 'num-func-seek!)
               ((eq? num! 'loop!) 'num-func-loop!)
               ((eq? num! 'blend-in!) 'num-func-blend-in!)
               ((eq? num! 'chan) 'num-func-chan)))
         (p0 (if param0
               param0
               (cond
                 ((eq? num! 'chan) `(the float ,(car num-args)))
                 ((eq? num! '+!) (if (null? num-args) 1.0 (car num-args)))
                 ((eq? num! '-!) (if (null? num-args) 1.0 (car num-args)))
                 ((eq? num! 'loop!)
                  (if (null? num-args)
                    1.0
                    (if (eq? 'max (car num-args))
                      (if group!
                        `(the float (1- (-> (the art-joint-anim ,group!) data 0 length)))
                        `(the float (1- (-> ja-ch frame-group data 0 length))))
                      (car num-args))))
                 ((eq? num! 'seek!)
                  (if (or (null? num-args) (eq? (car num-args) 'max))
                    (if group!
                      `(the float (1- (-> (the art-joint-anim ,group!) data 0 length)))
                      `(the float (1- (-> ja-ch frame-group data 0 length))))
                    (car num-args))))))
         (p1 (if param1 param1 (cond   ((eq? num! 'seek!) (if (or (null? num-args) (null? (cdr num-args))) 1.0 (cadr num-args))))))
         (frame-num (if (eq? 'max frame-num)
                      (if group!
                        `(the float (1- (-> (the art-joint-anim ,group!) data 0 length)))
                        `(the float (1- (-> ja-ch frame-group data 0 length))))
                      frame-num))
         (frame-group (if (or p0 p1 frame-num (not nf)) group! #f)))
    `(let ((ja-ch (-> self skel root-channel ,chan)))
      ,(if frame-interp `(set! (-> ja-ch frame-interp) ,frame-interp) `(none))
      ,(if dist `(set! (-> ja-ch dist) ,dist) `(none))
      ,(if frame-group `(set! (-> ja-ch frame-group) (the art-joint-anim ,frame-group)) `(none))
      ,(if p0 `(set! (-> ja-ch param 0) ,p0) `(none))
      ,(if p1 `(set! (-> ja-ch param 1) ,p1) `(none))
      ,(if num-func `(set! (-> ja-ch num-func) ,num-func) `(none))
      ,(if frame-num `(set! (-> ja-ch frame-num) ,frame-num) `(none))
      ,(if nf
        `(,(if eval? 'joint-control-channel-group-eval! 'joint-control-channel-group!) ja-ch (the art-joint-anim ,group!) ,nf)
        `(none))
      ,(cond
        ((eq? num! 'min) `(set! (-> ja-ch frame-num) 0.0))
        ((eq? num! 'max)
         (if group!
           `(set! (-> ja-ch frame-num) (the float (1- (-> (the art-joint-anim ,group!) data 0 length))))
           `(set! (-> ja-ch frame-num) (the float (1- (-> ja-ch frame-group data 0 length))))))
        ((eq? num! 'identity) `(set! (-> ja-ch frame-num) ,(car num-args)))
        (#t `(none))))))

(defmacro ja-no-eval (&key (chan 0) &key (group! #f) &key (num! #f) &key (param0 #f) &key (param1 #f) &key (num-func #f) &key (frame-num #f) &key (frame-interp #f) &key (dist #f))
  `(ja :eval? #f
      :chan ,chan
      :group! ,group!
      :num! ,num!
      :param0 ,param0
      :param1 ,param1
      :num-func ,num-func
      :frame-num ,frame-num
      :frame-interp ,frame-interp
      :dist ,dist))
