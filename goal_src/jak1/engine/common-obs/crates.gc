;; ============================================================================
;; Gjak1-crate-collision — SONDE DE RECENSEMENT DES CAISSES (owner 2026-08-31)
;;
;; « les caisses sont là mais je passe au travers sans pouvoir les casser... mais
;;   pas toutes, des fois aucunes, des fois certaines, c'est pas toujours les
;;   mêmes qui sont impactés. »
;;
;; Les caisses sont DESSINEES : l'acteur nait, le modele est charge. Seule la
;; COLLISION manque. Le defaut vit donc APRES la naissance, dans l'ENREGISTREMENT
;; de la forme de collision — et il est INTERMITTENT, donc c'est un etat a
;; l'execution, pas une donnee cassee.
;;
;; La sonde publie, pour CHAQUE caisse du niveau, le triplet qui departage les
;; trois familles de causes (budget epuise / course d'initialisation / allocation
;; qui echoue en silence) :
;;   - son IDENTITE          : aid, look, position
;;   - si sa forme est ENREGISTREE : onlist (est-elle sur la liste de collision
;;     que `fill-from-foreground-using-box` parcourt ?), rp/mesh/as/with
;;   - l'OCCUPATION DU POOL a cet instant : longueur / capacite des quatre
;;     moteurs de collision, et prims/tris du collide-cache
;; ============================================================================

;; definis dans engine/collide/collide-cache.gc (compile plus tot) — meme idiome de
;; declaration avancee que les externs de physique de process-drawable.gc
(define-extern gjcc-cc-report (function int none))
(define-extern *actor-collision-birth-radius* float)
(define-extern *gjcc-watch-h* handle)
(define-extern *gjcc-watch-n* int)
(define-extern gjcc-cc-reset (function int none))

(defun gjcc-list-count ((eng engine))
  "Compte les connexions VIVANTES en PARCOURANT la liste — on ne fait pas
   confiance au champ `length`, qui est un compteur tenu a la main."
  (let ((n 0)
        (it (-> eng alive-list next0)))
    (while (!= it (-> eng alive-list-end))
      (+! n 1)
      (set! it (-> it next0)))
    n))

(defun gjcc-on-list? ((eng engine) (cs collide-shape))
  "Cette collide-shape est-elle sur la liste que le joueur parcourt ?
   C'est EXACTEMENT la lecture que fait `fill-from-foreground-using-box`
   (collide-cache.gc:902 : `(the-as collide-shape (-> (the-as connection it) param1))`)."
  (let ((f 0)
        (it (-> eng alive-list next0)))
    (while (!= it (-> eng alive-list-end))
      (if (= (the-as collide-shape (-> (the-as connection it) param1)) cs)
        (set! f 1))
      (set! it (-> it next0)))
    f))

(defun gjcc-in-cache? ((cc collide-cache) (prim collide-shape-prim))
  "Cette primitive est-elle dans le collide-cache que le joueur vient de remplir ?
   Test FONCTIONNEL : c'est ce tableau-la que la resolution de collision lit."
  (let ((f 0))
    (dotimes (i (-> cc num-prims))
      (if (= (-> cc prims i prim) prim) (set! f 1)))
    f))

(defun gjcc-scan ((tag int))
  "Recensement complet. Une ligne par entite `crate` des niveaux actifs, plus un
   resume qui porte l'occupation des pools."
  (let ((ents 0) (live 0) (vis 0) (nocol 0) (nanc 0))
    (dotimes (li 3)
      (let ((lev (-> *level* level li)))
        (when (and (= (-> lev status) 'active) (nonzero? (the-as int (-> lev bsp))))
          (let ((acts (-> lev bsp actors)))
            (when (nonzero? (the-as int acts))
              (dotimes (ai (-> acts length))
                (let ((ent (-> acts data ai actor)))
                  (when (and (nonzero? (the-as int ent))
                             (nonzero? (the-as int (-> ent etype)))
                             (type-type? (-> ent etype) crate))
                    (+! ents 1)
                    (let ((pr (-> ent extra process)))
                      (cond
                        ((and (nonzero? (the-as int pr)) (type-type? (-> pr type) crate))
                         (+! live 1)
                         (let* ((c (the-as crate pr))
                                (r (-> c root))
                                (pm (the-as collide-shape-prim-mesh (if (nonzero? (the-as int r)) (-> r root-prim) (the-as collide-shape-prim 0))))
                                (hid (if (logtest? (-> c draw status) (draw-status hidden)) 1 0))
                                (rp (if (nonzero? (the-as int pm)) 1 0))
                                (msh (if (and (= rp 1) (-> pm mesh)) 1 0))
                                (kas (if (= rp 1) (the-as int (-> pm prim-core collide-as)) 0))
                                (kwi (if (= rp 1) (the-as int (-> pm collide-with)) 0))
                                (onl (if (nonzero? (the-as int r)) (gjcc-on-list? *collide-usually-hit-by-player-list* r) 0))
                                (inc (if (= rp 1) (gjcc-in-cache? *collide-cache* (the-as collide-shape-prim pm)) 0))
                                ;; le VOLUME de collision est-il la ou la caisse est dessinee ?
                                ;; `update-transforms!` n'est joue QU'UNE FOIS dans l'etat `wait`
                                ;; (crates.gc:541) : un mauvais tick fige le volume a vie.
                                (wd (if (= rp 1)
                                      (vector-vector-distance (the-as vector (-> pm prim-core world-sphere)) (-> c root trans))
                                      -1.0))
                                (wr (if (= rp 1) (-> pm prim-core world-sphere w) -1.0))
                                (d (if *target*
                                     (vector-vector-distance (-> c root trans) (-> *target* control trans))
                                     -1.0)))
                           (if (zero? hid) (+! vis 1))
                           ;; LE COMPTE DE NaN EST FAIT PAR LE JEU LUI-MEME, a cote des
                           ;; lignes brutes. Sur Android chaque `format` est UNE ligne de
                           ;; logcat : un enregistrement de caisse s'etale sur cinq lignes,
                           ;; et un `grep 'GJCC-CRATE.*NaN'` rend alors un ZERO STRUCTUREL.
                           ;; Deux lectures independantes du meme fait : si elles divergent,
                           ;; c'est le depouillement qui est faux, et on le voit.
                           ;; (`!=` compare les BITS en GOAL : `(!= x x)` est faux meme sur
                           ;;  un NaN. Le test est une appartenance a une plage.)
                           (if (and (= rp 1)
                                    (not (and (< wd 1000000000.0) (> wd -1000000000.0))))
                             (+! nanc 1))
                           (if (and (zero? hid)
                                    (or (zero? rp) (zero? msh) (zero? kas) (zero? kwi) (zero? onl)))
                             (+! nocol 1))
                           ;; (le compilateur plafonne un appel a 8 parametres : on publie en morceaux)
                           (format 0 "GJCC-CRATE tag=~D aid=~D look=~A live=1 hid=~D "
                                   tag (the-as int (-> ent aid)) (-> c look) hid)
                           (format 0 "rp=~D mesh=~D onlist=~D incache=~D " rp msh onl inc)
                           (format 0 "as=#x~X with=#x~X d=~f " kas kwi d)
                           (format 0 "wd=~f wr=~f " wd wr)
                           (format 0 "x=~f y=~f z=~f~%"
                                   (-> ent trans x) (-> ent trans y) (-> ent trans z))))
                        (else
                         (format 0 "GJCC-CRATE tag=~D aid=~D look=none live=0 hid=9 "
                                 tag (the-as int (-> ent aid)))
                         (format 0 "rp=9 mesh=9 onlist=9 incache=9 as=#x0 with=#x0 d=-1.0 wd=-1.0 wr=-1.0 ")
                         (format 0 "x=~f y=~f z=~f~%"
                                 (-> ent trans x) (-> ent trans y) (-> ent trans z)))))))))))))
    ;; (le compilateur plafonne un appel a 8 parametres : on publie en morceaux)
    (format 0 "GJCC-SUM tag=~D ents=~D live=~D vis=~D nocol=~D nan=~D " tag ents live vis nocol nanc)
    (format 0 "waitfail=~D waitn=~D guard=~D " *gjcc-waitfail* *gjcc-waitn* *gjcc-degen-guard*)
    (format 0 "uhbp=~D,~D/~D hbp=~D,~D/~D "
            (gjcc-list-count *collide-usually-hit-by-player-list*)
            (-> *collide-usually-hit-by-player-list* length)
            (-> *collide-usually-hit-by-player-list* allocated-length)
            (gjcc-list-count *collide-hit-by-player-list*)
            (-> *collide-hit-by-player-list* length)
            (-> *collide-hit-by-player-list* allocated-length))
    (format 0 "hbo=~D,~D/~D plist=~D,~D/~D "
            (gjcc-list-count *collide-hit-by-others-list*)
            (-> *collide-hit-by-others-list* length)
            (-> *collide-hit-by-others-list* allocated-length)
            (gjcc-list-count *collide-player-list*)
            (-> *collide-player-list* length)
            (-> *collide-player-list* allocated-length))
    (format 0 "ccprims=~D cctris=~D " (-> *collide-cache* num-prims) (-> *collide-cache* num-tris))
    ;; le BUDGET DE NAISSANCE et ce qui le gouverne, sur la ligne du verdict
    (format 0 "birthmax=~D runtime=~D pausedist=~f rayon=~f~%"
            (-> *ACTOR-bank* birth-max)
            (-> *display* frames (-> *display* last-screen) frame run-time)
            (-> *ACTOR-bank* pause-dist)
            *actor-collision-birth-radius*)
    (gjcc-cc-report tag))
  (none))

(defun gjcc-watch-set ((aid int) (n int))
  "Arme la surveillance image par image sur la caisse d'identite `aid`."
  (set! *gjcc-watch-h* (the-as handle #f))
  (set! *gjcc-watch-n* 0)
  (dotimes (li 3)
    (let ((lev (-> *level* level li)))
      (when (and (= (-> lev status) 'active) (nonzero? (the-as int (-> lev bsp))))
        (let ((acts (-> lev bsp actors)))
          (when (nonzero? (the-as int acts))
            (dotimes (ai (-> acts length))
              (let ((ent (-> acts data ai actor)))
                (when (and (nonzero? (the-as int ent))
                           (nonzero? (the-as int (-> ent etype)))
                           (type-type? (-> ent etype) crate)
                           (= (the-as int (-> ent aid)) aid))
                  (let ((pr (-> ent extra process)))
                    (when (and (nonzero? (the-as int pr)) (type-type? (-> pr type) crate))
                      (set! *gjcc-watch-h* (process->handle pr))
                      (set! *gjcc-watch-n* n)))))))))))
  (format 0 "GJCC-WATCH aid=~D arme=~D n=~D~%" aid (if (handle->process *gjcc-watch-h*) 1 0) n)
  (none))

(defun gjcc-land ((k int) (aid int) (cy float))
  "TEST PHYSIQUE — c'est l'experience meme de l'owner : on lache le joueur AU-DESSUS d'une
   caisse et on regarde ou il S'ARRETE. Debout dessus => elle est solide. Au niveau de sa
   base, alors qu'elle est VIVANTE et VISIBLE => il l'a TRAVERSEE.
   La ligne est AUTOPORTANTE : elle publie l'etat de la caisse VISEE au moment meme du
   verdict (nee ? dessinee ? enregistree ? maillage lie ?), pour qu'aucune correlation
   hors-ligne ne puisse se tromper de caisse."
  (let ((live 9) (hid 9) (onl 9) (msh 9))
    (dotimes (li 3)
      (let ((lev (-> *level* level li)))
        (when (and (= (-> lev status) 'active) (nonzero? (the-as int (-> lev bsp))))
          (let ((acts (-> lev bsp actors)))
            (when (nonzero? (the-as int acts))
              (dotimes (ai (-> acts length))
                (let ((ent (-> acts data ai actor)))
                  (when (and (nonzero? (the-as int ent))
                             (nonzero? (the-as int (-> ent etype)))
                             (type-type? (-> ent etype) crate)
                             (= (the-as int (-> ent aid)) aid))
                    (let ((pr (-> ent extra process)))
                      (cond
                        ((and (nonzero? (the-as int pr)) (type-type? (-> pr type) crate))
                         (let* ((c (the-as crate pr))
                                (r (-> c root))
                                (pm (the-as collide-shape-prim-mesh (if (nonzero? (the-as int r)) (-> r root-prim) (the-as collide-shape-prim 0)))))
                           (set! live 1)
                           (set! hid (if (logtest? (-> c draw status) (draw-status hidden)) 1 0))
                           (set! onl (if (nonzero? (the-as int r)) (gjcc-on-list? *collide-usually-hit-by-player-list* r) 0))
                           (set! msh (if (and (nonzero? (the-as int pm)) (-> pm mesh)) 1 0))))
                        (else (set! live 0) (set! hid 9) (set! onl 9) (set! msh 9))))))))))))
    (if *target*
      (let ((ty (-> *target* control trans y)))
        (format 0 "GJCC-LAND k=~D aid=~D cy=~f py=~f " k aid cy ty)
        (format 0 "dy=~f live=~D hid=~D onlist=~D mesh=~D " (- ty cy) live hid onl msh)
        (format 0 "px=~f pz=~f st=#x~X~%"
                (-> *target* control trans x) (-> *target* control trans z)
                (the-as int (-> *target* control status))))
      (format 0 "GJCC-LAND k=~D aid=~D cy=~f py=0.0 dy=-999999.0 live=9 hid=9 onlist=9 mesh=9 px=0.0 pz=0.0 st=#x0~%" k aid cy)))
  (none))

(define *gjcc-victim* (the-as crate #f))

(defun gjcc-inject ((on int))
  "CONTROLE POSITIF. On INJECTE le defaut sur une caisse vivante et visible :
   `clear-collide-with-as` met ses deux masques a zero — la caisse reste dessinee
   et le joueur la traverse. Le compteur `nocol` doit MONTER de 1 exactement,
   puis REDESCENDRE quand on restaure. Un zero sans ce controle ne vaut rien."
  (cond
    ((= on 1)
     (set! *gjcc-victim*
           (the-as crate (search-process-tree
                          *active-pool*
                          (lambda ((p process-tree))
                            (and (type-type? (-> p type) crate)
                                 (nonzero? (the-as int (-> (the-as crate p) draw)))
                                 (not (logtest? (-> (the-as crate p) draw status) (draw-status hidden))))))))
     (cond
       (*gjcc-victim*
        (clear-collide-with-as (-> *gjcc-victim* root))
        (format 0 "GJCC-INJECT on=1 victim=#x~X~%" (the-as int *gjcc-victim*)))
       (else (format 0 "GJCC-INJECT on=1 victim=none~%"))))
    (else
     (cond
       (*gjcc-victim*
        (restore-collide-with-as (-> *gjcc-victim* root))
        (format 0 "GJCC-INJECT on=0 victim=#x~X~%" (the-as int *gjcc-victim*)))
       (else (format 0 "GJCC-INJECT on=0 victim=none~%")))))
  (none))

;; ============================================================================
;; Gjak1-crate-collision-2 — LA SONDE PROGRAMMATIQUE. CORRECTION DE METHODE DE
;; L'OWNER, 2026-09-01 :
;;
;;   « fais ça de façon programmatique [...] impossible que tu couvre toutes les
;;     caisses de Geyser Rock à la vue »
;;
;; Il a raison, et le chiffre le prouve : conduire le personnage jusqu'aux caisses
;; avec de vraies entrees manette a couvert TROIS caisses en deux heures et demie
;; sur l'appareil. Ni le pilotage ni la lecture d'images ne sont des instruments
;; acceptables ici.
;;
;; CE QUE FAIT LA SONDE. Le niveau est charge NORMALEMENT — on ne teleporte rien,
;; on ne fabrique pas la condition « pas encore nee ». Puis, POUR CHAQUE caisse
;; vivante et dessinee, sans qu'aucune image ne soit regardee ni aucun bouton
;; presse :
;;   1. sa sphere de collision est-elle un NOMBRE (aucune composante NaN/inf) ?
;;   2. une REQUETE DE COLLISION SYNTHETIQUE lancee depuis un point proche
;;      renvoie-t-elle un CONTACT ?
;;
;; LA REQUETE EST CELLE DU JEU, PAS UNE IMITATION. C'est `fill-using-line-sphere`
;; puis `probe-using-line-sphere` sur `*collide-cache*` — exactement le couple que
;; la sonde de sol du joueur emploie (collide-shape.gc:1085). Le masque
;; `cak-2 + crate` est celui qui fait marcher la liste `usually-hit-by-player`
;; (collide-cache.gc:1007) et retenir une primitive de caisse. Donc :
;;   - une sphere NaN fait REJETER la primitive par le test de boite, `incache=0`,
;;     et la requete ne rend aucun contact — c'est le defaut de l'owner, mesure ;
;;   - une matrice d'os vierge rend le MAILLAGE degenere (les sommets sont
;;     transformes par cette matrice, mips2c collide_cache.cpp:1884), donc `tris`
;;     et le contact tombent aussi. La ligne publie `bw=`, le `w` de cette matrice,
;;     pour que les deux causes ne soient jamais confondues.
;;
;; ISOLEMENT PAR CAISSE, ET C'EST LUI QUI REND LA MESURE NON AMBIGUE. Apres le
;; remplissage on EFFACE le masque des primitives du cache qui ne sont pas la
;; notre — la copie du cache, jamais la primitive d'origine. `probe-using-line-sphere`
;; ne peut donc rendre QUE notre caisse : un contact rendu par la caisse voisine,
;; ou par une caisse empilee au-dessus, est mecaniquement impossible. Sans cet
;; isolement, une pile de caisses rendrait un vert pour la caisse du dessus et
;; un faux vert pour celles du dessous.
;;
;; LES TROIS QUESTIONS EXIGEES AVANT TOUTE MESURE :
;;   NATURE  : un ETAT (le volume existe et repond), pas une amplitude ;
;;   REPERE  : le monde, et le point de depart est ancre sur la POSE DE L'ENTITE
;;             plus la sphere LOCALE — deux grandeurs posees a la construction, qui
;;             ne peuvent pas valoir NaN. Ancrer la sonde sur la sphere du MONDE
;;             la rendrait aveugle au defaut qu'elle cherche ;
;;   LIGNE DE BASE quand le defaut est ABSENT : `contacts_ok = caisses`. Quand il
;;             est PRESENT (garde ablatee, bit 32) la meme sonde doit rendre moins.
;;             C'est l'ablation sur le MEME BINAIRE qui sert de controle.
;;
;; DETERMINISME : deux courses identiques doivent rendre les memes comptes.
;; ============================================================================

(defconstant GJCC-PB-SLOTS 1536)   ;; 3 niveaux x 512 acteurs

(define *gjcc-pb-st*    (new 'global 'array 'int32 GJCC-PB-SLOTS))
(define *gjcc-pb-tag*   0)
(define *gjcc-pb-lines* 0)
(define *gjcc-pb-n*     0)   ;; caisses sondees au moins une fois           (DENOMINATEUR)
(define *gjcc-pb-fini*  0)   ;; ... dont la sphere n'a JAMAIS ete non-finie
(define *gjcc-pb-ok*    0)   ;; ... dont la requete a TOUJOURS rendu un contact
(define *gjcc-pb-pass*  0)   ;; caisses sondees dans la DERNIERE passe
(define *gjcc-pb-np*    0)   ;; numero de passe — c'est LUI qui numerote les lignes
(define *gjcc-pb-bwz*   0)   ;; ... dont la matrice d'os etait vierge

(defun gjcc-finite? ((f float))
  "Un flottant est-il un NOMBRE ? `(!= x x)` compare les BITS en GOAL et rend donc
   FAUX meme sur un NaN — mesure au cycle precedent, le champ `nan=` publiait 0 a
   cote de coordonnees qui valaient NaN. Le seul test qui marche est
   l'APPARTENANCE A UNE PLAGE : NaN et les deux infinis echouent tous les trois."
  (if (and (< f 1000000000.0) (> f -1000000000.0)) 1 0))

(define *gjcc-inj-n* 0)   ;; caisses empoisonnees par le controle positif

(defun gjcc-degen-inject! ()
  "CONTROLE POSITIF DE LA SONDE — LE DEFAUT EST REPRODUIT A SON PRODUCTEUR.

   POURQUOI IL FAUT CELUI-LA ET PAS UN AUTRE. La sonde rend 31 contacts sur 31 dans la
   course normale — et elle rend EXACTEMENT LA MEME CHOSE avec la garde ablatee
   (courses s3 et s4, meme banc, `degen=0` des deux cotes). C'est normal : apres le
   chargement, plus aucune caisse ne renait, donc la condition ne se represente pas et
   les deux bras mesurent le meme monde. Un vert qui ne peut pas devenir rouge ne prouve
   rien — c'est la regle 1 des directives, et elle vaut contre mon propre resultat.

   CE QUE FAIT L'INJECTION. Pour CHAQUE caisse vivante : on remet a ZERO la matrice de
   l'os que designe sa primitive — c'est litteralement l'etat d'une matrice VIERGE,
   celui d'une caisse qui vient de naitre — puis on rejoue `update-transforms!`, LA
   FONCTION DU JEU, pas une imitation. Puis on REMET LA MATRICE COMME ELLE ETAIT.
   Il ne reste donc que ce que la naissance laisse derriere elle : la sphere de
   collision recalculee a partir d'une matrice vierge. Le maillage, lui, est intact —
   et c'est fidele : l'owner VOIT les caisses, donc leurs os sont calcules ; ce qui
   n'est plus recalcule, c'est la sphere, parce que la caisse dort.

   CE QUE LES DEUX BRAS DOIVENT RENDRE, ET C'EST LE MEME BINAIRE :
     garde ABLATEE (bit 32) : `1.0 / 0.0` vaut l'infini, `0.0 * infini` vaut NaN, la
       sphere n'est plus un nombre, le test de boite REJETTE la primitive et la sonde
       doit rendre `incache=0 ok=0` ;
     garde ACTIVE : le repli pose la sphere a `pose + sphere locale` et la sonde doit
       rendre `ok=1`.
   Si les deux rendent la meme chose, c'est la SONDE qui est fausse, pas le correctif."
  (let ((sav (new 'stack-no-clear 'matrix))
        (n 0))
    (dotimes (li 3)
      (let ((lev (-> *level* level li)))
        (when (and (= (-> lev status) 'active) (nonzero? (the-as int (-> lev bsp))))
          (let ((acts (-> lev bsp actors)))
            (when (nonzero? (the-as int acts))
              (dotimes (ai (-> acts length))
                (when (< ai 512)
                  (let ((ent (-> acts data ai actor)))
                    (when (and (nonzero? (the-as int ent))
                               (nonzero? (the-as int (-> ent etype)))
                               (type-type? (-> ent etype) crate))
                      (let ((pr (-> ent extra process)))
                        (when (and (nonzero? (the-as int pr)) (type-type? (-> pr type) crate))
                          (let* ((c (the-as crate pr))
                                 (r (-> c root))
                                 (pm (the-as collide-shape-prim-mesh
                                             (if (nonzero? (the-as int r))
                                               (-> r root-prim)
                                               (the-as collide-shape-prim 0))))
                                 (nl (-> c node-list)))
                            (when (and (nonzero? (the-as int pm))
                                       (nonzero? (the-as int nl))
                                       (>= (-> pm transform-index) 0)
                                       (not (logtest? (-> c draw status) (draw-status hidden))))
                              (let ((bt (-> nl data (-> pm transform-index) bone transform)))
                                (dotimes (i 4) (set! (-> sav vector i quad) (-> bt vector i quad)))
                                (dotimes (i 4) (set! (-> bt vector i quad) (the-as uint128 0)))
                                (update-transforms! r)
                                (dotimes (i 4) (set! (-> bt vector i quad) (-> sav vector i quad)))
                                (set! n (+ n 1))))))))))))))))
    (set! *gjcc-inj-n* n)
    (format 0 "GJCC-INJDEGEN caisses_empoisonnees=~D guard=~D degen=~D degenlife=~D~%"
            n *gjcc-degen-guard* *gjcc-degen-n* *gjcc-degen-life*))
  (none))

(defun gjcc-probe-all ((tag int))
  "SONDE PROGRAMMATIQUE — une passe sur TOUTES les caisses des niveaux actifs.
   Ne teleporte rien, ne presse aucun bouton, ne regarde aucune image."
  (let ((res (new 'stack-no-clear 'collide-tri-result))
        (p0  (new 'stack-no-clear 'vector))
        (dv  (new 'stack-no-clear 'vector))
        (pass 0)
        (bwz 0))
    ;; LE NUMERO DE PASSE EST COMPTE ICI, pas derive du compteur d'images. Derive, il
    ;; valait 13 a la premiere passe (le tick tourne depuis l'amorcage) et le detail par
    ;; caisse, conditionne a « passe 1 », n'etait JAMAIS imprime — mesure, course s2.
    (+! *gjcc-pb-np* 1)
    (set! tag *gjcc-pb-np*)
    (set! *gjcc-pb-tag* tag)
    ;; CONTROLE POSITIF (bit 256), joue JUSTE AVANT la mesure : il reproduit le defaut
    ;; a son producteur pour que le vert de la sonde soit falsifiable.
    (if (nonzero? (logand *gjcc-mode* 256)) (gjcc-degen-inject!))
    (dotimes (li 3)
      (let ((lev (-> *level* level li)))
        (when (and (= (-> lev status) 'active) (nonzero? (the-as int (-> lev bsp))))
          (let ((acts (-> lev bsp actors)))
            (when (nonzero? (the-as int acts))
              (dotimes (ai (-> acts length))
                (when (< ai 512)
                  (let ((ent (-> acts data ai actor)))
                    (when (and (nonzero? (the-as int ent))
                               (nonzero? (the-as int (-> ent etype)))
                               (type-type? (-> ent etype) crate))
                      (let ((pr (-> ent extra process)))
                        (when (and (nonzero? (the-as int pr)) (type-type? (-> pr type) crate))
                          (let* ((c (the-as crate pr))
                                 (r (-> c root))
                                 (pm (the-as collide-shape-prim-mesh
                                             (if (nonzero? (the-as int r))
                                               (-> r root-prim)
                                               (the-as collide-shape-prim 0)))))
                            ;; une caisse CACHEE est une caisse CASSEE : elle n'a pas a etre
                            ;; solide, et l'inclure fabriquerait un faux rouge.
                            (when (and (nonzero? (the-as int pm))
                                       (not (logtest? (-> c draw status) (draw-status hidden))))
                              (let* ((slot (+ (* li 512) ai))
                                     (st (-> *gjcc-pb-st* slot))
                                     (nl (-> c node-list))
                                     (ti (-> pm transform-index))
                                     (bw (if (and (nonzero? (the-as int nl)) (>= ti 0))
                                           (-> nl data ti bone transform vector 3 w)
                                           -1.0))
                                     (wx (-> pm prim-core world-sphere x))
                                     (wy (-> pm prim-core world-sphere y))
                                     (wz (-> pm prim-core world-sphere z))
                                     (wr (-> pm prim-core world-sphere w))
                                     (fini (if (and (= 1 (gjcc-finite? wx))
                                                    (= 1 (gjcc-finite? wy))
                                                    (= 1 (gjcc-finite? wz))
                                                    (= 1 (gjcc-finite? wr))
                                                    (> wr 0.0))
                                             1 0))
                                     (h  (* (-> pm local-sphere w) 0.5773503))
                                     (cx (+ (-> r trans x) (-> pm local-sphere x)))
                                     (cy (+ (-> r trans y) (-> pm local-sphere y)))
                                     (cz (+ (-> r trans z) (-> pm local-sphere z))))
                                (set! pass (+ pass 1))
                                (if (= bw 0.0) (set! bwz (+ bwz 1)))
                                ;; ---- LA REQUETE SYNTHETIQUE : une sphere qui descend a
                                ;; travers la caisse, depuis 2 demi-aretes au-dessus de son
                                ;; centre jusqu'a 2 en dessous. C'est la sonde de sol du jeu.
                                (set-vector! p0 cx (+ cy (* 2.0 h)) cz 1.0)
                                (set-vector! dv 0.0 (* -4.0 h) 0.0 1.0)
                                (fill-using-line-sphere *collide-cache*
                                                        p0 dv 40.96
                                                        (collide-kind cak-2 crate)
                                                        (the-as process-drawable #f)
                                                        (new 'static 'pat-surface))
                                (let ((incache 0) (ctris 0))
                                  ;; ISOLEMENT : on n'interroge QUE notre primitive.
                                  (dotimes (i (-> *collide-cache* num-prims))
                                    (cond
                                      ((= (-> *collide-cache* prims i prim) (the-as collide-shape-prim pm))
                                       (set! incache 1)
                                       (set! ctris (the-as int (-> *collide-cache* prims i num-tris))))
                                      (else
                                       (set! (-> *collide-cache* prims i prim-core collide-as)
                                             (the-as collide-kind 0)))))
                                  (let* ((u (probe-using-line-sphere *collide-cache*
                                                                    p0 dv 40.96
                                                                    (collide-kind cak-2 crate)
                                                                    res
                                                                    (new 'static 'pat-surface)))
                                         (ix (-> res intersect x))
                                         (iy (-> res intersect y))
                                         (iz (-> res intersect z))
                                         ;; le point de contact doit tomber DANS la caisse
                                         ;; sondee. Avec l'isolement c'est un controle
                                         ;; redondant — et un controle redondant qui tire
                                         ;; est ce qui distingue une mesure d'une croyance.
                                         (inb (if (and (>= u 0.0)
                                                       (< (fabs (- ix cx)) (+ h 4096.0))
                                                       (< (fabs (- iz cz)) (+ h 4096.0))
                                                       (< (fabs (- iy cy)) (+ h 4096.0)))
                                                1 0))
                                         (ok (if (and (= fini 1) (= incache 1) (= inb 1)) 1 0)))
                                    ;; accumulation PAR CAISSE : la couverture est l'UNION
                                    ;; sur la course, et un echec vu UNE FOIS est retenu.
                                    (set! st (logior st 1))
                                    (if (zero? fini) (set! st (logior st 2)))
                                    (if (= ok 1) (set! st (logior st 4)) (set! st (logior st 8)))
                                    (set! (-> *gjcc-pb-st* slot) st)
                                    ;; une ligne par caisse a la premiere passe, puis
                                    ;; uniquement les ECHECS : sur l'appareil chaque `format`
                                    ;; est une ligne de logcat, et un instrument qui inonde
                                    ;; le journal detruit la mesure qu'il porte.
                                    (when (and (< *gjcc-pb-lines* 200)
                                               (or (= tag 1) (zero? ok)))
                                      (+! *gjcc-pb-lines* 1)
                                      ;; MEME RAISON QUE LA LIGNE DE RESUME : sur Android chaque
                                      ;; `format` est UNE ligne de logcat. Le VERDICT par caisse
                                      ;; tient donc en un seul appel, et chaque ligne de detail
                                      ;; reporte `aid` pour qu'aucune ne soit orpheline.
                                      ;; MEME RAISON QUE LA LIGNE DE RESUME : sur Android chaque
                                      ;; `format` est UNE ligne de logcat, et le compilateur
                                      ;; plafonne un appel a SIX valeurs. Le VERDICT par caisse
                                      ;; tient donc en un seul appel, et chaque ligne de detail
                                      ;; reporte `aid` pour qu'aucune ne soit orpheline.
                                      (format 0 "GJCC-PROBE t=~D aid=~D ok=~D fini=~D incache=~D tris=~D~%"
                                              tag (the-as int (-> ent aid)) ok fini incache ctris)
                                      (format 0 "GJCC-PROBE2 t=~D aid=~D bw=~f u=~f inb=~D~%"
                                              tag (the-as int (-> ent aid)) bw u inb)
                                      (format 0 "GJCC-PROBE3 t=~D aid=~D wx=~f wy=~f wz=~f wr=~f~%"
                                              tag (the-as int (-> ent aid)) wx wy wz wr)
                                      (format 0 "GJCC-PROBE4 t=~D aid=~D ix=~f iy=~f iz=~f~%"
                                              tag (the-as int (-> ent aid)) ix iy iz))))))))))))))))))
    ;; RECOMPTAGE COMPLET a chaque passe : les trois comptes sont donc toujours
    ;; coherents entre eux, meme si une caisse meurt et renait entre deux passes.
    (let ((n 0) (nf 0) (nok 0))
      (dotimes (i GJCC-PB-SLOTS)
        (let ((st (-> *gjcc-pb-st* i)))
          (when (nonzero? (logand st 1))
            (set! n (+ n 1))
            (if (zero? (logand st 2)) (set! nf (+ nf 1)))
            (if (and (nonzero? (logand st 4)) (zero? (logand st 8))) (set! nok (+ nok 1))))))
      (set! *gjcc-pb-n* n) (set! *gjcc-pb-fini* nf) (set! *gjcc-pb-ok* nok)
      (set! *gjcc-pb-pass* pass) (set! *gjcc-pb-bwz* bwz)
      ;; LA LIGNE DE VERDICT EST ATOMIQUE, ET C'EST UNE CONTRAINTE D'ANDROID.
      ;; Sur l'appareil CHAQUE `format` devient UNE ligne de logcat : une ligne de verdict
      ;; ecrite en deux morceaux arrive coupee, et `fps=` se retrouve sur une ligne qui ne
      ;; porte plus le prefixe. Un depouillement par motif rendrait alors un ZERO
      ;; STRUCTUREL. Les six comptes ET la cadence tiennent donc dans UN SEUL appel
      ;; (le compilateur en plafonne les parametres a huit) ; le reste part sur une
      ;; seconde ligne qui porte son propre prefixe et ne se confond avec rien.
      (format 0 "GJCC-PROBESUM t=~D caisses=~D spheres_finies=~D contacts_ok=~D fps=~f guard=~D~%"
              tag n nf nok (-> *display* frames-per-second) *gjcc-degen-guard*)
      (format 0 "GJCC-PROBESUM2 t=~D passe=~D bwz=~D mode=~D " tag pass bwz *gjcc-mode*)
      ;; `degen` repart de zero a chaque pose de bouton ; `degenlife` compte depuis
      ;; l'amorcage, donc il porte le CHARGEMENT DU NIVEAU — ou la condition se produit
      ;; en masse. Publier l'un sans l'autre rendrait « la condition ne se produit pas »
      ;; indistinguable de « on l'a remise a zero apres ».
      (format 0 "degen=~D degenlife=~D inj=~D f=~D~%"
              *gjcc-degen-n* *gjcc-degen-life* *gjcc-inj-n*
              (the-as int (-> *display* base-frame-counter)))))
  ;; La cadence publiee sur la ligne de verdict est celle que le moteur RETIENT
  ;; (`frames-per-second`, ajustee dynamiquement) ; le journal de l'appareil porte en
  ;; plus la mesure independante `dyn-rs avg-fps`. Les deux sont republiees cote a cote
  ;; dans le rapport, parce qu'une cadence declaree par le sujet mesure ne vaut pas seule.
  (none))

;; ============================================================================
;; Gjak1-crate-collision-2 (owner 2026-08-31, RETOUR 2) — DETECTEUR PASSIF DE
;; TRAVERSEE. IL MESURE LE DEFAUT DE L'OWNER, PAS CELUI DU BANC.
;;
;; « j'ai toujours le soucis, c'est pas réglé du tout, ptêtre lié au jeux qui
;;   dépend plus du framerate »
;;
;; POURQUOI UN NOUVEL INSTRUMENT. Le banc du cycle precedent TELEPORTE le joueur
;; au-dessus de chaque caisse. Il fabrique donc la condition « la caisse n'est pas
;; encore nee » et c'est ce defaut-la qu'il a mesure puis corrige. Or les caisses
;; que le joueur a TRAVERSEES dans la course f10 publient, au moment meme du
;; verdict : `live=1 hid=0 onlist=1 mesh=1` — NEE, DESSINEE, INSCRITE, MAILLEE.
;; C'est mot pour mot ce que decrit l'owner (« les caisses sont là mais je passe
;; au travers »), et la naissance ne peut pas l'expliquer.
;;
;; CE DETECTEUR NE TELEPORTE RIEN. Il regarde le joueur COURIR et publie une
;; ligne quand il se retrouve A L'INTERIEUR d'une caisse qui est dessinee. C'est
;; la seule mesure qui vaille sur l'appareil, ou il n'y a pas de listener goalc.
;;
;; NATURE / REPERE / LIGNE DE BASE (les trois questions exigees) :
;;   NATURE  : un ETAT GEOMETRIQUE soutenu (le joueur est DANS le volume), pas une
;;             amplitude ni une variance ;
;;   REPERE  : le monde, et le test est fait contre le volume de collision REEL de
;;             la caisse (`prim-core world-sphere`), pas contre sa pose d'auteur ;
;;   LIGNE DE BASE quand le defaut est ABSENT : ZERO ligne. Un joueur qui marche
;;             CONTRE une caisse a son centre a au moins (demi-arete + rayon du
;;             joueur) du centre, soit ~8100 unites, quand le seuil est a ~3000 :
;;             la marge est d'un facteur 2,7, il n'y a pas de zone grise.
;;   Le joueur DEBOUT SUR la caisse est exclu par la bande verticale (il est a
;;             +8368 alors que la bande s'arrete a +4824).
;;
;; CONTROLE POSITIF : `gjcc-inject 1` retire ses masques a une caisse vivante ; le
;; joueur la traverse et CE compteur doit monter, puis se taire a la restauration.
;;
;; COUT : une rejection par boite sur x/z avant tout calcul, sur les entites de
;; type `crate` des niveaux actifs. Aucune sortie tant qu'aucune traversee n'est
;; vue — l'instrument est donc SILENCIEUX dans le build livre, et il y reste arme
;; parce qu'un defaut intermittent que l'owner voit chez lui doit pouvoir se
;; declarer chez lui.
;; ============================================================================

(defconstant GJCC-SLOTS 384)

(define *gjcc-thru-st*    (new 'global 'array 'int32 GJCC-SLOTS)) ;; etat par (niveau,acteur)
(define *gjcc-near-n*     0)    ;; caisses APPROCHEES  = le DENOMINATEUR
(define *gjcc-thru-n*     0)    ;; caisses TRAVERSEES  = le NUMERATEUR
(define *gjcc-thru2-n*    0)    ;; dont celles traversees sur DEUX images ou plus
(define *gjcc-near-lines* 0)    ;; plafond de lignes GJCC-NEAR
(define *gjcc-dist*       0.0)  ;; distance parcourue par le joueur : PREUVE que le pilote pilote
(define *gjcc-cctag*      0)    ;; tag du recensement periodique (bit 64)
(define *gjcc-vide*       0)    ;; images ou le collide-cache du joueur est ENTIEREMENT vide
(define *gjcc-thru-lines* 0)    ;; plafond de lignes, pour ne jamais inonder logcat
(define *gjcc-frames*     0)
(define *gjcc-warp*       0)    ;; images ecartees pour saut de position (teleportation)
(define *gjcc-prev-px*    0.0)
(define *gjcc-prev-py*    0.0)
(define *gjcc-prev-pz*    0.0)
(define *gjcc-applied*    0)    ;; les boutons de `*gjcc-mode*` ont-ils ete poses ?

(defun gjcc-mode-apply! ()
  "Pose les boutons UNE FOIS, et publie ce qui a ete pose. `*gjcc-mode*` vient du
   fichier de reglages (cle `gjcc`), donc l'ABLATION se fait sur le MEME BINAIRE :
   aucun de ces bits n'est arme dans le build livre (mode 0)."
  (set! *gjcc-applied* (+ *gjcc-mode* 1))
  ;; Chaque bouton est pose DANS LES DEUX SENS, jamais seulement arme : c'est ce qui
  ;; rend l'ablation reversible SUR LE MEME BINAIRE, sans reconstruire ni redemarrer.
  ;; bit 2 : audit du collide-cache (il publie GJCC-CC / GJCC-DROP)
  (cond ((nonzero? (logand *gjcc-mode* 2)) (gjcc-cc-reset 60))
        (else (set! *gjcc-cc-on* #f)))
  ;; bit 4 : ABLATION du correctif precedent — rayon de naissance a ZERO = regle
  ;;         d'origine de Naughty Dog, a l'octet pres
  (set! *actor-collision-birth-radius* (if (nonzero? (logand *gjcc-mode* 4)) 0.0 (meters 30)))
  ;; bit 16 : cache de collision AGRANDI. Le tampon de 5000 triangles est DEJA
  ;;          alloue (collide-cache-h.gc) ; seul le plafond vaut 460.
  (set! *collide-cache-max-tris* (if (nonzero? (logand *gjcc-mode* 16)) BIG_COLLIDE_CACHE_SIZE 460))
  ;; bit 32 : ABLATION du correctif de sphere NaN — on laisse la division par une
  ;;          matrice vierge produire son NaN, comme dans le build d'avant.
  (set! *gjcc-degen-guard* (if (nonzero? (logand *gjcc-mode* 32)) 0 1))
  ;; les compteurs repartent de zero a CHAQUE pose de bouton : sans ca, ce qui s'est
  ;; passe avant l'ablation serait compte du cote de l'ablation.
  (set! *gjcc-degen-n* 0) (set! *gjcc-near-n* 0) (set! *gjcc-thru-n* 0) (set! *gjcc-thru2-n* 0)
  (set! *gjcc-near-lines* 0) (set! *gjcc-dist* 0.0) (set! *gjcc-cctag* 0) (set! *gjcc-vide* 0)
  (set! *gjcc-waitn* 0) (set! *gjcc-waitfail* 0) (set! *gjcc-waitlines* 0)
  (set! *gjcc-thru-lines* 0) (set! *gjcc-warp* 0)
  (set! *gjcc-pb-tag* 0) (set! *gjcc-pb-lines* 0) (set! *gjcc-pb-n* 0) (set! *gjcc-pb-np* 0)
  (set! *gjcc-pb-fini* 0) (set! *gjcc-pb-ok* 0) (set! *gjcc-pb-pass* 0) (set! *gjcc-pb-bwz* 0)
  (dotimes (i GJCC-PB-SLOTS) (set! (-> *gjcc-pb-st* i) 0))
  (dotimes (i GJCC-SLOTS) (set! (-> *gjcc-thru-st* i) 0))
  (format 0 "GJCC-MODE mode=~D rayon=~f maxtris=~D~%"
          *gjcc-mode* *actor-collision-birth-radius* *collide-cache-max-tris*)
  (none))

(defun gjcc-thru-tick! ()
  "Appele UNE FOIS PAR IMAGE DESSINEE depuis engine/draw/drawable.gc, juste apres
   `actors-update`. Ne teleporte rien, ne modifie rien, ne prend aucune decision de
   jeu : il regarde et il compte."
  (if (!= *gjcc-applied* (+ *gjcc-mode* 1)) (gjcc-mode-apply!))
  (when (and *target* (nonzero? (the-as int (-> *target* control))))
    (+! *gjcc-frames* 1)
    (let* ((pt (-> *target* control trans))
           (px (-> pt x))
           (py (-> pt y))
           (pz (-> pt z))
           (step (+ (fabs (- px *gjcc-prev-px*)) (fabs (- py *gjcc-prev-py*)) (fabs (- pz *gjcc-prev-pz*)))))
      (set! *gjcc-prev-px* px)
      (set! *gjcc-prev-py* py)
      (set! *gjcc-prev-pz* pz)
      (if (< step 32768.0) (set! *gjcc-dist* (+ *gjcc-dist* step)))
      (if (and (zero? (-> *collide-cache* num-tris)) (zero? (-> *collide-cache* num-prims)))
        (+! *gjcc-vide* 1))
      ;; GARDE DE TELEPORTATION. Un saut de plus de 8 m en une image n'est pas une
      ;; course : c'est un warp, un chargement ou une cinematique. On ne compte
      ;; jamais une traversee sur ces images-la — sinon l'instrument fabriquerait
      ;; le defaut qu'il est cense trouver, comme le banc a teleportation.
      (cond
        ((>= step 32768.0) (+! *gjcc-warp* 1))
        (else
         (dotimes (li 3)
           (let ((lev (-> *level* level li)))
             (when (and (= (-> lev status) 'active) (nonzero? (the-as int (-> lev bsp))))
               (let ((acts (-> lev bsp actors)))
                 (when (nonzero? (the-as int acts))
                   (dotimes (ai (-> acts length))
                     (when (< ai 128)
                       (let ((ent (-> acts data ai actor)))
                         (when (and (nonzero? (the-as int ent))
                                    (nonzero? (the-as int (-> ent etype)))
                                    (type-type? (-> ent etype) crate)
                                    ;; rejection par boite AVANT tout calcul
                                    (< (fabs (- (-> ent trans x) px)) 24576.0)
                                    (< (fabs (- (-> ent trans z) pz)) 24576.0))
                           (let ((pr (-> ent extra process)))
                             (when (and (nonzero? (the-as int pr)) (type-type? (-> pr type) crate))
                               (let* ((c (the-as crate pr))
                                      (r (-> c root))
                                      (pm (the-as collide-shape-prim-mesh
                                                  (if (nonzero? (the-as int r))
                                                    (-> r root-prim)
                                                    (the-as collide-shape-prim 0)))))
                                 ;; une caisse CACHEE est une caisse cassee : elle n'a
                                 ;; pas a etre solide, et la traverser n'est pas un defaut
                                 (when (and (nonzero? (the-as int pm))
                                            (not (logtest? (-> c draw status) (draw-status hidden))))
                                   (let* ((wr (-> pm prim-core world-sphere w))
                                          (wx (-> pm prim-core world-sphere x))
                                          (wy (-> pm prim-core world-sphere y))
                                          (wz (-> pm prim-core world-sphere z))
                                          ;; L'ANCRAGE EST L'ENTITE, JAMAIS LA SPHERE DU MONDE.
                                          ;; La sphere est precisement la grandeur qui peut valoir
                                          ;; NaN, et toute comparaison avec un NaN rend FAUX : un
                                          ;; detecteur qui la lirait serait AVEUGLE au defaut qu'il
                                          ;; cherche, et publierait un zero. La pose de l'entite et
                                          ;; la sphere LOCALE sont posees a la construction et ne
                                          ;; peuvent pas etre NaN.
                                          (ex (-> ent trans x))
                                          (ey (-> ent trans y))   ;; base de la caisse
                                          (ez (-> ent trans z))
                                          (h (* (-> pm local-sphere w) 0.5773503))
                                          (dx (fabs (- px ex)))
                                          (dz (fabs (- pz ez)))
                                          (slot (+ (* li 128) ai))
                                          (st (-> *gjcc-thru-st* slot)))
                                     ;; APPROCHEE : le joueur est venu a portee de la toucher,
                                     ;; a SA hauteur. C'est le denominateur du verdict.
                                     (when (and (zero? (logand st 1))
                                                (< dx (+ h 8192.0)) (< dz (+ h 8192.0))
                                                (< (fabs (- py ey)) 12288.0))
                                       (set! st (logior st 1))
                                       (+! *gjcc-near-n* 1)
                                       ;; l'IDENTITE de chaque caisse approchee, pour que le
                                       ;; denominateur du verdict soit une UNION verifiable entre
                                       ;; courses et non un simple compte qu'on ne peut pas recouper.
                                       (when (< *gjcc-near-lines* 64)
                                         (+! *gjcc-near-lines* 1)
                                         (format 0 "GJCC-NEAR aid=~D look=~A f=~D dx=~f dz=~f~%"
                                                 (the-as int (-> ent aid)) (-> c look) *gjcc-frames* dx dz)))
                                     (cond
                                       ;; DEDANS : le joueur est a moins de son PROPRE rayon de corps
                                       ;; (2867,2) de l'axe de la caisse, et sa hauteur est dans la
                                       ;; moitie BASSE du volume. Debout DESSUS il est a +8368 (mesure
                                       ;; `gjcc-land`), donc hors bande ; contre le flanc il est a au
                                       ;; moins demi-arete + rayon de corps, donc hors bande aussi.
                                       ;; La marge est d'un facteur 2 des deux cotes.
                                       ;; UNE IMAGE A CACHE VIDE N'EST PAS UNE CAISSE FAUTIVE.
                                       ;; Quand `num-tris` ET `num-prims` valent zero, le joueur ne
                                       ;; collisionne avec RIEN — ni decor, ni premier plan : il
                                       ;; traverse le monde entier, pas cette caisse-la. C'est ce que
                                       ;; produisent les premieres images apres une teleportation du
                                       ;; banc, et c'est exactement ce que portaient les deux
                                       ;; traversees qui subsistaient apres correctif (`cctris=0
                                       ;; ccprims=0` sur leur propre ligne). On les compte a part.
                                       ((and (< dx 2867.2) (< dz 2867.2)
                                             (> py (- ey 2048.0)) (< py (+ ey 5000.0))
                                             (or (nonzero? (-> *collide-cache* num-tris))
                                                 (nonzero? (-> *collide-cache* num-prims))))
                                        (cond
                                          (#t
                                           ;; DES LA PREMIERE image a l'interieur. Exiger DEUX images
                                           ;; consecutives rendrait l'instrument aveugle au cas le plus
                                           ;; court, qui est justement celui de l'owner : UNE SEULE image
                                           ;; sans sphere de collision laisse traverser 0,72 m a
                                           ;; 13,9 images/s, soit la moitie d'une caisse. La PROFONDEUR
                                           ;; (deux images ou plus) est publiee a part, `profond=` :
                                           ;; c'est une information, plus une condition d'admission.
                                           (when (and (nonzero? (logand st 2)) (zero? (logand st 8)))
                                             (set! st (logior st 8))
                                             (+! *gjcc-thru2-n* 1))
                                           (set! st (logior st 2))
                                           (when (zero? (logand st 4))
                                             (set! st (logior st 4))
                                             (+! *gjcc-thru-n* 1)
                                             (when (< *gjcc-thru-lines* 200)
                                               (+! *gjcc-thru-lines* 1)
                                               (format 0 "GJCC-THRU n=~D aid=~D look=~A f=~D "
                                                       *gjcc-thru-n* (the-as int (-> ent aid)) (-> c look) *gjcc-frames*)
                                               (format 0 "onlist=~D mesh=~D incache=~D "
                                                       (if (nonzero? (the-as int r)) (gjcc-on-list? *collide-usually-hit-by-player-list* r) 0)
                                                       (if (-> pm mesh) 1 0)
                                                       (gjcc-in-cache? *collide-cache* (the-as collide-shape-prim pm)))
                                               (format 0 "as=#x~X with=#x~X "
                                                       (the-as int (-> pm prim-core collide-as))
                                                       (the-as int (-> pm collide-with)))
                                               (format 0 "px=~f py=~f pz=~f " px py pz)
                                               (format 0 "wx=~f wy=~f wz=~f wr=~f " wx wy wz wr)
                                               (format 0 "nan=~D degen=~D " (if (and (< wx 1000000000.0) (> wx -1000000000.0)) 0 1) *gjcc-degen-n*)
                                               (format 0 "dx=~f dz=~f ey=~f step=~f " dx dz ey step)
                                               (format 0 "fps=~f spf=~f tr=~f ft=~D "
                                                       (-> *display* frames-per-second)
                                                       (-> *display* seconds-per-frame)
                                                       (-> *display* time-ratio)
                                                       *fixed-tick-armed*)
                                               (format 0 "birthmax=~D sweep=~D uhbp=~D cctris=~D ccprims=~D~%"
                                                       (-> *ACTOR-bank* birth-max)
                                                       (if *actors-sweep-complete* 1 0)
                                                       (gjcc-list-count *collide-usually-hit-by-player-list*)
                                                       (-> *collide-cache* num-tris)
                                                       (-> *collide-cache* num-prims)))))
                                          ))
                                       (else (if (nonzero? (logand st 2)) (set! st (- st 2)))))
                                     (set! (-> *gjcc-thru-st* slot) st)))))))))))))))
         ;; RESUME PERIODIQUE — opt-in (bit 1). C'est lui qui porte le compte PAR
         ;; COURSE que l'owner exige : approchees / traversees, et la cadence
         ;; REELLEMENT MESUREE pendant la course.
         (when (and (nonzero? (logand *gjcc-mode* 1)) (zero? (mod *gjcc-frames* 300)))
           (format 0 "GJCC-RUN f=~D approchees=~D traversees=~D profond=~D warp=~D "
                   *gjcc-frames* *gjcc-near-n* *gjcc-thru-n* *gjcc-thru2-n* *gjcc-warp*)
           (format 0 "fps=~f spf=~f tr=~f ft=~D "
                   (-> *display* frames-per-second)
                   (-> *display* seconds-per-frame)
                   (-> *display* time-ratio)
                   *fixed-tick-armed*)
           (format 0 "birthmax=~D sweep=~D degen=~D mode=~D rayon=~f "
                   (-> *ACTOR-bank* birth-max)
                   (if *actors-sweep-complete* 1 0)
                   *gjcc-degen-n*
                   *gjcc-mode*
                   *actor-collision-birth-radius*)
           ;; L'ECHEC DE LA REPARATION A UN COUP, compte a l'endroit ou il se produit et
           ;; PORTANT SON DENOMINATEUR. `waitfail=0 waitn=0` ne dit rien ; `waitfail=0
           ;; waitn=31` dit que 31 caisses ont eu leur occasion et l'ont toutes reussie.
           (format 0 "waitfail=~D waitn=~D guard=~D~%"
                   *gjcc-waitfail* *gjcc-waitn* *gjcc-degen-guard*)
           ;; LE PILOTE PILOTE-T-IL ? Sans cette ligne, « 0 caisse approchee » ne distingue
           ;; pas « le joueur n'a rencontre aucune caisse » de « le joueur n'a pas bouge ».
           (format 0 "GJCC-POS f=~D dist_m=~f px=~f py=~f pz=~f vide=~D~%"
                   *gjcc-frames* (/ *gjcc-dist* 4096.0) px py pz *gjcc-vide*))
         ;; RECENSEMENT COMPLET PERIODIQUE (bit 64). Sur l'appareil il n'existe aucun
         ;; listener pour appeler `gjcc-scan` : sans ce declencheur, la couverture se
         ;; limite aux caisses que le joueur parvient a atteindre a pied — trois, mesure.
         ;; Ici les 31 caisses du niveau sont inspectees, que le joueur les approche ou non.
         (when (and (nonzero? (logand *gjcc-mode* 64)) (zero? (mod *gjcc-frames* 300)))
           (set! *gjcc-cctag* (+ *gjcc-cctag* 1))
           (gjcc-scan *gjcc-cctag*))
         ;; SONDE PROGRAMMATIQUE (bit 128) — correction de methode de l'owner du
         ;; 2026-09-01. Elle couvre TOUTES les caisses en une passe, sans pilotage et
         ;; sans image regardee. La premiere passe est retardee de 600 images : avant
         ;; ca le niveau finit de se peupler, et sonder une caisse a l'image de sa
         ;; naissance mesurerait le banc, pas le jeu.
         (when (and (nonzero? (logand *gjcc-mode* 128))
                    (> *gjcc-frames* 600)
                    (zero? (mod *gjcc-frames* 300)))
           (gjcc-probe-all 0))))))
  (none))
