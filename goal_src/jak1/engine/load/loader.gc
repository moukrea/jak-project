;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/load/loader-h.gc")
(require "engine/anim/joint.gc")
(require "engine/load/load-dgo.gc")
(require "engine/sound/gsound.gc")
(require "engine/game/task/hint-control-h.gc")
(require "engine/common-obs/process-drawable-h.gc")
(require "engine/game/game-info-h.gc")

;; note: changed for high fps

;; DECOMP BEGINS

(defmethod inspect ((this load-dir))
  "Print all the stuff in a load-dir"
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~Tlevel: ~A~%" (-> this lev))
  (format #t "~Tallocated-length: ~D~%" (-> this string-array allocated-length))
  (format #t "~Tlength: ~D~%" (-> this string-array length))
  (dotimes (i (-> this string-array length))
    (format #t
            "~T  [~D] ~S ~A  (~D bytes)~%"
            i
            (-> this string-array i)
            (-> this data-array i)
            (mem-size (-> this data-array i) #f 0)))
  this)

(defmethod mem-usage ((this load-dir) (usage memory-usage-block) (flags int))
  (set! (-> usage length) (max 82 (-> usage length)))
  (set! (-> usage data 81 name) "array")
  (+! (-> usage data 81 count) 1)
  (let ((v1-6 (asize-of this))) (+! (-> usage data 81 used) v1-6) (+! (-> usage data 81 total) (logand -16 (+ v1-6 15))))
  (set! (-> usage length) (max 82 (-> usage length)))
  (set! (-> usage data 81 name) "array")
  (set! (-> usage data 81 count) (-> usage data 81 count))
  (let ((v1-15 (asize-of (-> this string-array))))
    (+! (-> usage data 81 used) v1-15)
    (+! (-> usage data 81 total) (logand -16 (+ v1-15 15))))
  (set! (-> usage length) (max 82 (-> usage length)))
  (set! (-> usage data 81 name) "array")
  (set! (-> usage data 81 count) (-> usage data 81 count))
  (let ((v1-24 (asize-of (-> this data-array))))
    (+! (-> usage data 81 used) v1-24)
    (+! (-> usage data 81 total) (logand -16 (+ v1-24 15))))
  (dotimes (s3-0 (-> this data-array length))
    (mem-usage (-> this data-array s3-0) usage flags))
  (the-as load-dir #f))

(defmethod load-to-heap-by-name ((this load-dir-art-group) (art-name string) (do-reload symbol) (heap kheap) (version int))
  "Load the art with the given name to the heap and return the art.
  Won't load a thing if it's already loaded, unless you set do-reload.
  This is intended for debug only."
  ;; see if we already have it.
  (let ((s5-0 (-> this string-array)))
    (dotimes (s3-0 (-> s5-0 length))
      (when (string= art-name (-> s5-0 s3-0))
        (when do-reload
          ;; we have it, reload it if requested
          (let ((v1-4 (art-group-load-check art-name heap version))) (if v1-4 (set! (-> this art-group-array s3-0) v1-4))))
        (return (-> this art-group-array s3-0))))
    ;; nope, we don't have it,add it to the list.
    (let ((v0-2 (art-group-load-check art-name heap version)))
      (when v0-2
        (set! (-> s5-0 (-> s5-0 length)) art-name)
        (set! (-> this art-group-array (-> s5-0 length)) v0-2)
        (+! (-> s5-0 length) 1)
        (+! (-> this art-group-array length) 1))
      v0-2)))

(defmethod set-loaded-art ((this load-dir-art-group) (arg0 art-group))
  "Add some already loaded art to the load-dir."
  (let ((s4-0 (-> this string-array)))
    (dotimes (s3-0 (-> s4-0 length))
      (when (string= (-> arg0 name) (-> s4-0 s3-0))
        (set! (-> this art-group-array s3-0) arg0)
        (return (-> this art-group-array s3-0))))
    (set! (-> s4-0 (-> s4-0 length)) (-> arg0 name))
    (set! (-> this art-group-array (-> s4-0 length)) arg0)
    (set! (-> s4-0 length) (+ (-> s4-0 length) 1)))
  (set! (-> this art-group-array length) (+ (-> this art-group-array length) 1))
  arg0)

(defun drawable-load ((arg0 drawable) (arg1 kheap))
  "Load a drawable file. Unused."
  (cond
    ((type-type? (-> arg0 type) string)
     #|
(with-sp (protect sp
      (if (< sp *stack-top*)
        (set! sp (&+ *kernel-sp* -1024))
        )
     |#
     (let ((s5-1 (the-as drawable (loado (the-as string arg0) arg1))))
       (if (and s5-1 (type-type? (-> s5-1 type) drawable)) (login s5-1)))
     ;;))
     )
    ((type-type? (-> arg0 type) drawable) (login arg0))))

(defun art-load ((arg0 string) (arg1 kheap))
  "Load an art file. Unused."
  #|
(with-sp (protect sp
    (if (< sp *stack-top*)
      (set! sp (&+ *kernel-sp* -1024))
      )
  |#
  (let ((s5-0 (the-as art (loado arg0 arg1)))) (if (type-type? (-> s5-0 type) art) (login s5-0) (the-as art #f)))
  ;;))
  )

(defun art-group-load-check ((arg0 string) (arg1 kheap) (arg2 int))
  "Load and check an art-group file. this only runs if we're using debug memory."
  (when *debug-segment*
    #|
(with-sp (protect sp
      (if (< sp *stack-top*)
        (set! sp (&+ *kernel-sp* -1024))
        )
    |#
    (let ((s3-1 (the-as art-group (loado (make-file-name (file-kind art-group) arg0 arg2 #f) arg1))))
      (cond
        ((not s3-1) (format 0 "ERROR: art-group ~A is not a valid file.~%" arg0) (the-as art-group #f))
        ((not (type-type? (-> s3-1 type) art-group))
         (format 0 "ERROR: art-group ~A is not a art-group.~%" arg0)
         (the-as art-group #f))
        ((not (file-info-correct-version? (-> s3-1 info) (file-kind art-group) arg2))
         ;;     ^ prints a detailed error if it fails.
         ;;(format 0 "ERROR: art-group ~A is not the correct version.~%" arg0)
         (the-as art-group #f))
        (else (login s3-1))))
    ;;))
    ))

(defmethod set-pending-file ((this external-art-buffer) (arg0 string) (arg1 int) (arg2 handle) (arg3 float))
  "Request a new file to be loaded into this buffer."
  (set! (-> this pending-load-file) arg0)
  (set! (-> this pending-load-file-part) arg1)
  (set! (-> this pending-load-file-owner) arg2)
  (set! (-> this pending-load-file-priority) arg3)
  0)

(defmethod unlock! ((this external-art-buffer))
  "Unlock this buffer."
  (declare (inline))
  (set! (-> this locked?) #f)
  #f)

(defmethod inactive? ((this external-art-buffer))
  "Is this buffer inactive?"
  (declare (inline))
  (!= (-> this status) 'active))

(defmethod file-status ((this external-art-buffer) (name string) (part int))
  "Get the status of a file in the buffer. #f = file is not present."
  (when (and (name= (-> this pending-load-file) name) (= (-> this pending-load-file-part) part))
    ;; the file is at least wanting to load
    (if (and (name= (-> this load-file) name) (= (-> this load-file-part) part))
      (-> this status) ;; file is loaded or loading
      'pending ;; file has not started loading yet.
      )))

(defmethod link-art! ((this art-group))
  "Links the elements of this art-group.
   This will put a reference to this joint animation in the level art group.
   Level art groups have slots for temporarily loaded joint animations."
  (when this
    (countdown (s5-0 (-> this length))
      (let* ((art-elt (-> this data s5-0))
             (janim (if (and (nonzero? art-elt) (type-type? (-> art-elt type) art-joint-anim)) (the-as art-joint-anim art-elt)))
             (success #f))
        (when janim
          ;; a countdown with a label right at the start
          (let ((s3-1 3))
            (while (begin
                     (label cfg-22)
                     (nonzero? s3-1))
              ;; loop over levels, looking for the master art group for this joint animation.
              (+! s3-1 -1)
              (let ((janim-group (art-group-get-by-name (-> *level* level s3-1) (-> janim master-art-group-name))))
                (when janim-group
                  (cond
                    ((and (< (-> janim master-art-group-index) (-> janim-group length)) ;; index is valid
                          (not (-> janim-group data (-> janim master-art-group-index))) ;; doesn't already have it loaded
                          )
                     ;; link!
                     (set! (-> janim-group data (-> janim master-art-group-index)) janim)
                     (set! success #t))
                    (else
                     ;; if the specified index is no good, just try looking for somewhere else.
                     (countdown (a0-14 (-> janim-group length))
                       (when (not (-> janim-group data a0-14))
                         ;; found an empty one!
                         (set! (-> janim-group data a0-14) janim)
                         (set! success #t)
                         (goto cfg-22)))))))))
          (if (not success) (format 0 "ERROR: ~A could not find a master slot to link for ~A.~%" (-> this name) janim))))))
  this)

(defmethod unlink-art! ((this art-group))
  "Unlinks the elements of this art-group.  This will undo the link-art! function."
  (when this
    (countdown (s5-0 (-> this length))
      (let* ((art-elt (-> this data s5-0))
             (janim (if (and (nonzero? art-elt) (type-type? (-> art-elt type) art-joint-anim)) (the-as art-joint-anim art-elt)))
             (success #f))
        (when janim
          (let ((s2-0 3))
            (while (begin
                     (label cfg-16)
                     (nonzero? s2-0))
              (+! s2-0 -1)
              (let ((janim-group (art-group-get-by-name (-> *level* level s2-0) (-> janim master-art-group-name))))
                (when janim-group
                  (countdown (a0-5 (-> janim-group length))
                    (when (= janim (-> janim-group data a0-5))
                      (set! (-> janim-group data a0-5) #f)
                      (set! success #t)
                      (goto cfg-16)))))))
          (if (not success) (format 0 "ERROR: ~A could not find a master slot to unlink for ~A.~%" (-> this name) janim))))))
  0)

(defmethod link-file ((this external-art-buffer) (ag art-group))
  "Link the art-group and set it to this buffer's art group."
  (when ag
    (link-art! ag)
    (set! (-> this art-group) ag))
  ag)

(defmethod unlink-file ((this external-art-buffer) (ag art-group))
  "Unlink the art-group and remove this buffer's art group."
  (when ag
    (unlink-art! ag)
    (set! (-> this art-group) #f))
  0)

(defmethod update ((this external-art-buffer))
  "Update this buffer."
  (when (or (not (name= (-> this pending-load-file) (-> this load-file)))
            (!= (-> this pending-load-file-part) (-> this load-file-part)))
    ;; we're loading a different file, or a different part of a file
    (unless (handle->process (-> this pending-load-file-owner))
      ;; nobody owns the loading file so we can discard it
      (set! (-> this pending-load-file) #f)
      (set! (-> this pending-load-file-part) -1)
      (set! (-> this pending-load-file-owner) (the-as handle #f))
      (set! (-> this pending-load-file-priority) SPOOL_PRIORITY_LOWEST))
    (when (= (-> this status) 'initialize)
      ;; we need to initialize the heap
      (let ((v1-11 (-> this heap)))
        ;; Scary: this is a hard coded address that points to the kernel memory.
        ;; it turns out the kernel doesn't need this. So we can use it!
        (set! (-> v1-11 base) (the-as pointer (+ #x84000 (* SPOOL_HEAP_SIZE (-> this index)))))
        (set! (-> v1-11 current) (-> v1-11 base))
        (set! (-> v1-11 top-base) (&+ (-> v1-11 base) SPOOL_HEAP_SIZE))
        (set! (-> v1-11 top) (-> v1-11 top-base)))
      (set! (-> this status) 'inactive)
      ;; heap is now allocated, but there is no data to use
      )
    (cond
      ((-> this load-file)
       ;; the buffer is working on a file
       (if (= (-> this status) 'loading)
         ;; something else is already loading, cancel that because we want something else
         (str-load-cancel))
       ;; now nothing is loaded!
       (set! (-> this load-file) #f)
       (set! (-> this load-file-part) -1)
       (set! (-> this load-file-owner) (the-as handle #f))
       (set! (-> this load-file-priority) SPOOL_PRIORITY_LOWEST)
       ;; on the next time through, we will set the actual load file.
       )
      (else
       ;; we have officially chosen to load this file
       (set! (-> this load-file) (-> this pending-load-file))
       (set! (-> this load-file-part) (-> this pending-load-file-part))
       (set! (-> this load-file-owner) (-> this pending-load-file-owner))
       (set! (-> this load-file-priority) (-> this pending-load-file-priority)))))
  (label cfg-18)
  (cond
    ((-> this load-file)
     ;; something is being worked on
     (case (-> this status)
       (('active 'reserved)
        ;; file is loaded and usable (or reserved)
        )
       (('error)
        ;; oops an error happened. make this buffer unusable now.
        (set! (-> this status) 'inactive)
        (set! (-> this load-file) #f)
        (set! (-> this load-file-part) -1)
        (set! (-> this load-file-owner) (the-as handle #f))
        (set! (-> this load-file-priority) SPOOL_PRIORITY_LOWEST)
        (set! (-> this pending-load-file) #f)
        (set! (-> this pending-load-file-part) -1)
        (set! (-> this pending-load-file-owner) (the-as handle #f))
        (set! (-> this pending-load-file-priority) SPOOL_PRIORITY_LOWEST)
        (set! (-> this art-group) #f))
       (('inactive)
        ;; no usable data here, fill the buffer
        (kheap-reset (-> this heap))
        (cond
          ((string= (-> this load-file) "reserved") ;; we want to reserve this buffer for something (not loading an str file)
           (cond
             ((-> *art-control* reserve-buffer)
              (format 0 "ERROR: trying double reserve ~A when ~A is reserved~%" this (-> *art-control* reserve-buffer)))
             (else
              (set! (-> this status) 'reserved)
              (set! (-> *art-control* reserve-buffer) this) ;; this buffer is reserved
              )))
          ((and (!= (-> *level* loading-level) (-> *level* level-default)) (< (meters 20) (-> this load-file-priority)))
           ;; unused cond
           )
          ((str-load (-> this load-file) (-> this load-file-part) (the pointer (align64 (-> this heap current))) #x3fc00) ;; try to start load
           ;; load has started!!
           (set! (-> this status) 'loading))))
       (('loading)
        ;; loading...
        (case (str-load-status (&-> this len))
          (('error)
           ;; something went wrong. oh well.
           (set! (-> this status) 'error))
          (('busy)
           ;; loading. we have nothing to do.
           )
          (else
           ;; done!!
           ;; not sure it is a good idea to assume that this is a success...
           (set! (-> this buf) (the pointer (align64 (-> this heap current))))
           (set! (-> this status) 'loaded)
           (goto cfg-18) ;; go back and check status again!
           )))
       (('loaded)
        ;; file is loaded. link it and see if we're good
        (let ((a0-37 (-> this buf)))
          (set! (-> this art-group)
                (the-as art-group (link (the-as pointer a0-37) (-> this load-file data) (-> this len) (-> this heap) 0))))
        (let ((s4-0 (-> this art-group))
              (s3-0 (-> this load-file)))
          (cond
            ((not s4-0)
             (format 0 "ERROR: art-group ~A part ~D is not a valid file.~%" s3-0 (-> this load-file-part))
             (set! (-> this status) 'error))
            ((not (type-type? (-> s4-0 type) art-group))
             (format 0 "ERROR: art-group ~A part ~D is not a art-group.~%" s3-0 (-> this load-file-part))
             (set! (-> this status) 'error))
            ((not (file-info-correct-version? (-> s4-0 info) (file-kind art-group) 0))
             ;;(format 0 "ERROR: art-group ~A part ~D is the wrong version.~%" s3-0 (-> this load-file-part))
             (set! (-> this status) 'error))
            (else
             (login s4-0)
             (set! (-> this status) 'locked) ;; make file ready to be used
             ))))
       (('locked)
        ;; this buffer is locked and needs to be unlocked before it can be used.
        ;; only one buffer can be active at a time. The other buffer is locked to prevent it from activating.
        (when (and (not (-> this locked?)) (handle->process (-> this load-file-owner)))
          ;; we want to be used, unlock this buffer and lock the other just in case.
          (link-file this (-> this art-group))
          (set! (-> this other locked?) #t) ;; prevent it from becoming active
          (set! (-> this status) 'active)
          (goto cfg-18)))))
    (else
     ;; we want to get rid of the file!
     (case (-> this status)
       (('initialize)
        ;; this was done earlier
        )
       (('reserved)
        ;; this buffer is reserved
        (cond
          ((= (-> *art-control* reserve-buffer) this) ;; yep it's this one!
           (set! (-> *art-control* reserve-buffer) #f)
           (set! (-> this status) 'inactive))
          (else (format 0 "ERROR: trying tro free ~A when ~A is reserved~%" this (-> *art-control* reserve-buffer)))))
       (('active)
        ;; buffer is in use. not anymore!
        (unlink-file this (-> this art-group))
        (let ((v1-70 (-> this heap))) (set! (-> v1-70 current) (-> v1-70 base)))
        (set! (-> this art-group) #f)
        (set! (-> this status) 'inactive)
        ;; if the other is locked due to us, unlock it, then update it so it activates.
        (when (-> this other locked?)
          (unlock! (-> this other))
          (update (-> this other))))
       (else
        ;; some other scenario, just get rid of the whole thing.
        (let ((v1-79 (-> this heap))) (set! (-> v1-79 current) (-> v1-79 base)))
        (set! (-> this art-group) #f)
        (set! (-> this status) 'inactive)))))
  0)

;; start loading a spooled anim if we think one is about to be used, e.g. when approaching a fuel cell or npc
;; (some processes may want to wait for the stream to be preloaded, which won't happen with this disabled)
(define *preload-spool-anims* #t)

(defmethod file-status ((this external-art-control) (name string) (part int))
  "Get the status of a file in this art control. #f = file not found"
  (dotimes (i 2)
    (awhen (file-status (-> this buffer i) name part) (return it)))
  #f)

(defmethod update ((this external-art-control) (debug-print symbol))
  "Update this external-art-control. This validates the spool buffers, sorts the spools and queues the highest priority one, and does some other things.
   If debug-print, also prints some text to the display console"
  ;; if somebody wants a reserve buffer, they will set this to 1.
  (if (nonzero? (-> this reserve-buffer-count))
    (spool-push this "reserved" 0 *dproc* (if (-> this reserve-buffer) -110.0 -0.5)))
  ;; frame-lock will get set to #t if something is assigned to this buffer in this update.
  (dotimes (v1-5 2)
    (set! (-> this buffer v1-5 frame-lock) #f))
  ;; buffers assigned from this call to update
  (dotimes (v1-8 3)
    (set! (-> this rec v1-8 buf2) #f))
  ;; update existing buffers from their recs
  (dotimes (s4-0 2)
    (let ((s3-0 (-> this rec s4-0)))
      (when (-> s3-0 name)
        ;; iterate over the two buffers
        (dotimes (s2-0 2)
          (when (and (file-status (-> this buffer s2-0) (-> s3-0 name) (-> s3-0 parts)) ;; this buffer holds the file for the rec
                     (not (-> this buffer s2-0 frame-lock))) ;; and nothing has frame-locked this buffer
            ;; so we frame lock it to prevent it from being kicked out
            (set! (-> this buffer s2-0 frame-lock) #t)
            ;; remember what buffer
            (set! (-> s3-0 index) (the-as int (-> this buffer s2-0)))
            ;; update owner and priority.
            (set! (-> this buffer s2-0 pending-load-file-owner) (-> s3-0 owner))
            (set! (-> this buffer s2-0 load-file-owner) (-> s3-0 owner))
            (set! (-> this buffer s2-0 pending-load-file-priority) (-> s3-0 priority))
            (set! (-> this buffer s2-0 load-file-priority) (-> s3-0 priority))
            (goto cfg-24)))))
    (label cfg-24))
  ;; preload recs
  ;; iterate over recs
  (dotimes (s4-1 2)
    (let ((s3-1 (-> this rec s4-1)))
      ;; rec wants to load something, but doesn't have a buffer already
      (when (and (-> s3-1 name) (not (-> s3-1 buf2)))
        ;; skip if we aren't preloading, or have a positive priority.
        (if (and (not *preload-spool-anims*) (>= (-> s3-1 priority) 0.0))
          ;; not in use, move on
          (goto cfg-46))
        ;; search for a buffer for preloading
        (dotimes (s2-1 2)
          ;; can't steal one that's already assigned
          (when (not (-> this buffer s2-1 frame-lock))
            ;; do the assignment!
            (set! (-> this buffer s2-1 frame-lock) #t)
            (set-pending-file (-> this buffer s2-1) (-> s3-1 name) (-> s3-1 parts) (-> s3-1 owner) (-> s3-1 priority))
            (set! (-> s3-1 index) (the-as int (-> this buffer s2-1)))
            (goto cfg-46)))))
    (label cfg-46))
  ;; this part is a bit confusing, but I think it basically kicks out the lowest priority thing.
  (when (not (-> this reserve-buffer))
    (let ((s4-2 (-> this rec 0 buf2))) ;; top priority buffer
      (if (and s4-2
               (-> s4-2 locked?)
               (not (string= (-> s4-2 pending-load-file) "reserved"))
               (not (string= (-> s4-2 other pending-load-file) "reserved")))
        (set-pending-file (-> s4-2 other) (the-as string #f) -1 (the-as handle #f) SPOOL_PRIORITY_LOWEST))))
  ;; update the buffers
  (dotimes (s4-3 2)
    (update (-> this buffer s4-3)))
  ;; sort spool anims.
  (let ((s4-4 (the-as spool-anim #f)))
    (countdown (s3-2 3)
      (if (and (-> this rec s3-2 name) (not (name= (-> this rec s3-2 name) (-> this active-stream))))
        (set! s4-4 (the-as spool-anim (-> this rec)))))
    (if (and (-> this preload-stream name) (or (not s4-4) (< (-> this preload-stream priority) (-> s4-4 priority))))
      (set! s4-4 (-> this preload-stream)))
    (cond
      (s4-4 (mem-copy! (&-> this last-preload-stream type) (&-> s4-4 type) 44) (str-play-queue (-> s4-4 name)))
      (else (set! (-> this last-preload-stream name) #f) (set! (-> this last-preload-stream owner) (the-as handle #f)))))
  (when (and debug-print *display-art-control*)
    (dotimes (s5-1 3)
      (format *stdcon*
              "rec ~d ~S ~D ~f ~A~%"
              s5-1
              (-> this rec s5-1 name)
              (-> this rec s5-1 parts)
              (-> this rec s5-1 priority)
              (handle->name (-> this rec s5-1 owner))))
    (dotimes (s5-2 2)
      (format *stdcon*
              "buf ~d ~C ~S ~D ~A ~A~%"
              s5-2
              (if (-> this buffer s5-2 locked?) #\l #\\s)
              (-> this buffer s5-2 pending-load-file)
              (-> this buffer s5-2 pending-load-file-part)
              (-> this buffer s5-2 status)
              (handle->name (-> this buffer s5-2 pending-load-file-owner))))
    (format *stdcon* " a: ~S~%" (-> this active-stream))
    (format *stdcon* " p: ~S  ~A~%" (-> this preload-stream name) (handle->name (-> this preload-stream owner)))
    (format *stdcon* " q: ~S  ~A~%" (-> this last-preload-stream name) (handle->name (-> this last-preload-stream owner))))
  0)

(defmethod none-reserved? ((this external-art-control))
  "are there any reserved buffers?"
  (declare (inline))
  (zero? (-> this reserve-buffer-count)))

(defmethod reserve-alloc ((this external-art-control))
  "Reserve a buffer!"
  (set! (-> this reserve-buffer-count) 1)
  (if (-> this reserve-buffer) (-> this reserve-buffer heap)))

(defmethod reserve-free ((this external-art-control) (arg0 kheap))
  "Free the reserved buffer!"
  (cond
    ((none-reserved? this)
     (format 0 "ERROR: illegal attempt to free a buffer #x~X which had not been reserved (none reserved).~%" arg0))
    ((not (-> this reserve-buffer)) (set! (-> this reserve-buffer-count) 0))
    ((= (-> this reserve-buffer heap) arg0)
     (set-pending-file (-> this reserve-buffer) (the-as string #f) -1 (the-as handle #f) SPOOL_PRIORITY_LOWEST)
     (update (-> this reserve-buffer))
     (set! (-> this reserve-buffer-count) 0))
    (else (format 0 "ERROR: illegal attempt to free a buffer #x~X which had not been reserved (buffer unknown).~%" arg0)))
  0)

(defmethod clear-rec ((this external-art-control))
  "Clears the recent spool anims from the art control."
  (cond
    ((!= *master-mode* 'game)
     (dotimes (s5-0 3)
       (when (name= (-> this rec s5-0 name) "reserved")
         (case s5-0
           ((0)
            (mem-copy! (&-> this rec 0 type) (&-> this rec 1 type) (size-of spool-anim))
            (mem-copy! (&-> this rec 1 type) (&-> this rec 2 type) (size-of spool-anim)))
           ((1) (mem-copy! (&-> this rec 1 type) (&-> this rec 2 type) (size-of spool-anim))))
         (set! (-> this rec 2 type) spool-anim)
         (set! (-> this rec 2 name) #f)
         (set! (-> this rec 2 priority) SPOOL_PRIORITY_LOWEST)
         (set! (-> this rec 2 owner) (the-as handle #f)))))
    (else
     (dotimes (v1-19 3)
       (set! (-> this rec v1-19 type) spool-anim)
       (set! (-> this rec v1-19 name) #f)
       (set! (-> this rec v1-19 priority) SPOOL_PRIORITY_LOWEST)
       (set! (-> this rec v1-19 owner) (the-as handle #f)))
     (set! (-> this preload-stream type) spool-anim)
     (set! (-> this preload-stream name) #f)
     (set! (-> this preload-stream priority) SPOOL_PRIORITY_LOWEST)
     (set! (-> this preload-stream owner) (the-as handle #f))))
  0)

(defmacro spool-calc-priority (priority proc)
  "Check the priority of a spool anim and recalculate it if needed. It will be the same as distance between target and the requesting process.
   priority = var that stores priority
   proc = a process to recalc from"
  `(when (and (= ,priority SPOOL_PRIORITY_RECALC) ,proc)
    (let ((target-trans (target-pos 0)))
      (set! ,priority (vector-vector-distance target-trans (-> (the-as process-drawable ,proc) root trans))))))

(defmethod try-preload-stream ((this external-art-control) (arg0 string) (arg1 int) (arg2 process) (arg3 float))
  "Set a new stream to be preloaded, if appropriate."
  (spool-calc-priority arg3 arg2)
  (unless (and (-> this preload-stream name) (>= arg3 (-> this preload-stream priority)))
    (set! (-> this preload-stream name) arg0)
    (set! (-> this preload-stream parts) arg1)
    (set! (-> this preload-stream priority) arg3)
    (set! (-> this preload-stream owner) (process->handle arg2)))
  0)

(defmethod spool-push ((this external-art-control) (name string) (part int) (proc process) (priority float))
  "Push a spool-anim to the spool array. There are only space for three, and only the three highest priority spool anims will be kept. (lowest priority = top)"
  (spool-calc-priority priority proc)
  ;; if this spool-anim already exists, pop it from the rec list
  (cond
    ((and (= part (-> this rec 0 parts)) (name= name (-> this rec 0 name)))
     (if (>= priority (-> this rec 0 priority)) (return (the-as int #f)))
     ;; first spool. copy 1st <- 2nd and 2nd <- 3rd, 3rd will be wiped
     (mem-copy! (&-> this rec 0 type) (&-> this rec 1 type) (size-of spool-anim))
     (mem-copy! (&-> this rec 1 type) (&-> this rec 2 type) (size-of spool-anim))
     (set! (-> this rec 2 name) #f)
     (set! (-> this rec 2 owner) (the-as handle #f)))
    ((and (= part (-> this rec 1 parts)) (name= name (-> this rec 1 name)))
     (if (>= priority (-> this rec 1 priority)) (return (the-as int #f)))
     ;; second spool. copy 2nd <- 3rd, 3rd will be wiped
     (mem-copy! (&-> this rec 1 type) (&-> this rec 2 type) (size-of spool-anim))
     (set! (-> this rec 2 name) #f)
     (set! (-> this rec 2 owner) (the-as handle #f)))
    ((and (= part (-> this rec 2 parts)) (name= name (-> this rec 2 name)))
     (if (>= priority (-> this rec 2 priority)) (return (the-as int #f)))
     ;; third spool. 3rd will be wiped
     (set! (-> this rec 2 name) #f)
     (set! (-> this rec 2 owner) (the-as handle #f))))
  ;; if it's top 3 priority, push this spool-anim to the rec list
  (cond
    ((< priority (-> this rec 0 priority))
     ;; 1st place!
     (mem-copy! (&-> this rec 2 type) (&-> this rec 1 type) (size-of spool-anim))
     (mem-copy! (&-> this rec 1 type) (&-> this rec 0 type) (size-of spool-anim))
     (set! (-> this rec 0 name) name)
     (set! (-> this rec 0 parts) part)
     (set! (-> this rec 0 priority) priority)
     (set! (-> this rec 0 owner) (process->handle proc)))
    ((< priority (-> this rec 1 priority))
     ;; 2nd place.
     (mem-copy! (&-> this rec 2 type) (&-> this rec 1 type) (size-of spool-anim))
     (set! (-> this rec 1 name) name)
     (set! (-> this rec 1 parts) part)
     (set! (-> this rec 1 priority) priority)
     (set! (-> this rec 1 owner) (process->handle proc)))
    ((< priority (-> this rec 2 priority))
     ;; 3rd place...
     (set! (-> this rec 2 name) name)
     (set! (-> this rec 2 parts) part)
     (set! (-> this rec 2 priority) priority)
     (set! (-> this rec 2 owner) (process->handle proc))))
  0)

(defun-extern level-hint-surpress! none) ;; ? TODO

(define-extern ja-channel-push! (function int time-frame int :behavior process-drawable))

(define-extern ja-channel-set! (function int int :behavior process-drawable))

(define-extern joint-control-channel-group-eval!
  (function joint-control-channel art-joint-anim (function joint-control-channel float float float) int))

(define-extern joint-control-channel-group!
  (function joint-control-channel art-joint-anim (function joint-control-channel float float float) int))

(define-extern ja-aframe-num (function int float :behavior process-drawable))

(define-extern ja-abort-spooled-anim (function spool-anim art-joint-anim int int :behavior process-drawable))

;; --- Gplayability-input-and-loadgate (owner 2026-08-27) ----------------------
;; « Limite il devrait y avoir un mecanisme de chargement qui s'assure que tout le
;;   necessaire soit bien charge avant de lancer l'ecran titre, la on dirait que ca
;;   y va meme si rien n'est charge, c'est problematique quand ca charge pas assez
;;   vite ! »
;;
;; POURQUOI ICI, ET PAS AILLEURS. `str-play-async`, plus bas dans ce fichier, est
;; le point de non-retour d'une scene : a partir de cet appel le frame-num est
;; asservi a `current-str-pos` et la command-list s'execute par NUMERO DE FRAME.
;; Une fois le son parti, l'image ne rattrape pas — elle saute. La barriere se
;; pose donc AVANT le son, jamais pendant.
;;
;; NATURE de la grandeur : un ETAT DE RESIDENCE, pas une temporisation. Quand les
;; niveaux sont deja dessinables, `__pc-scene-ready?` rend 1 au PREMIER tour : la
;; boucle ne s'execute pas, `set-blackout-frames` n'est meme pas appele, et une
;; machine rapide est inchangee.
;; REPERE : la residence GPU cote renderer, PAS `level-status`. Mesure Shield du
;; 2026-08-27, retour de Geyser Rock : GOAL declarait `beach` charge (`NOTICE:
;; loaded beach-vis`) 38,5 s avant que le niveau ne soit dessinable
;; (`F1D-LOADSYNC lev=beach`). Une barriere posee sur `level-status` aurait donc
;; rendu un faux vert.
;;
;; SORTIE GARANTIE : `__pc-scene-ready?` rend 1 des que son propre delai est
;; ecoule, et rend 1 immediatement sur un runtime qui ne publie aucune residence.
;; La boucle ne peut donc pas retenir une scene indefiniment — une barriere qui
;; peut bloquer le jeu serait pire que le defaut qu'elle corrige.
;; Gloading-screen : plafond UNIQUE de la barriere de scene, volet GPU et volet GOAL confondus.
;; C'est un plafond, pas une cible : quand tout est deja pret la boucle ne tourne pas.
(defconstant SCENE_GATE_CEILING (seconds 20))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Gbeach-actors-gate -- LE SIGNAL « ACTEUR INSTANCIABLE » N'EST PAS CELUI DU DECOR (owner x2)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Le cycle precedent a capture la ligne qui tranche, et elle disculpe le plafond :
;;     LOADGATE  open  scene=sage-intro-sequence-e waited=9494ms reason=resident
;;     LOADGATE-GOAL   scene=sage-intro-sequence-e niveau=beach statut=loaded gpu=#t attendu=3510
;;     SCENECMD alive  nom=harvester-87 trouve=#f lev0=beach/loaded   (10 acteurs sur 10)
;; `reason=resident`, PAS `timeout` : le plafond de 20 s n'est pour rien dans ce defaut et n'est
;; PAS touche ici. Et la colonne qui separe les courses qui reussissent de celles qui echouent est
;; UNE SEULE : `lev0=beach/loaded` quand ca rate, `lev0=beach/active` quand ca passe.
;;
;; LE SIGNAL, ET L'ENDROIT OU IL EST PRODUIT. Un acteur d'un niveau est instanciable par son nom
;; quand `entity-by-name` le trouve (engine/entity/entity.gc:92-113). Cette fonction balaie
;; `(-> lev bsp actors)` -- une table STATIQUE, presente des la fin du login, donc des 'loaded --
;; mais elle ne regarde QUE les niveaux dont le statut vaut 'active (entity.gc:100). Le signal
;; n'est donc ni la residence GPU ni le login : c'est le STATUT 'active du niveau, pose en un seul
;; endroit, `level-status-set!` (engine/level/level.gc:310), atteint uniquement par
;; `level-get-for-use ... 'active`, dont le seul producteur en jeu normal est
;; `update! *load-state*` (engine/level/level.gc:1146) quand un `display-level` a pose son voeu.
;;
;; RESIDENCE GPU et STATUT 'active SONT DEUX PIPELINES DIFFERENTS. `mark_level_resident`
;; (game/graphics/opengl_renderer/loader/Loader.cpp:1462) dit que la GEOMETRIE tfrag3 et les
;; textures sont televersees. Rien dans ce signal ne parle des ACTEURS. On garde donc la residence
;; pour le decor, et on ajoute le statut pour les acteurs.
;;
;; POURQUOI IL FAUT AUSSI AVANCER LE `display-level`, ET POURQUOI CE N'EST PAS UNE INVENTION.
;; Attendre 'active sans rien faire d'autre serait le piege que ce fichier documente deja plus bas :
;; attendre un etat que PERSONNE ne produira, donc aller au plafond pour rien. C'est la scene
;; elle-meme qui produit cet etat, par son propre `display-level`, mais 937 frames d'artiste trop
;; tard. On ne fabrique aucune commande : on AVANCE celle que la command-list porte deja, avec son
;; mode d'affichage a elle (`movie` pour `sage-intro-sequence-e`). La scene la rejouera a la frame
;; 937 sans effet -- `update!` ne fait rien quand le voeu et l'etat coincident (level.gc:1141).
;;
;; CE QUE CA COUTE, DIT FRANCHEMENT : le niveau voisin est DESSINE des l'ouverture de la barriere
;; au lieu de la frame 937. Ce n'est pas un effet de bord qu'on pourrait eviter : 'active EST
;; l'etat dessine (`add-connection *background-draw-engine*`, level.gc:296-307), et c'est
;; EXACTEMENT l'etat que `entity-by-name` exige. Rendre les acteurs instanciables sans dessiner
;; leur niveau est impossible dans ce moteur. Le cout est donc une paire de niveaux dessines --
;; la configuration normale de la frontiere village1/beach.
;;
;; PORTEE : uniquement les scenes qui portent au moins une commande `alive`. Les autres scenes
;; retenues par la barriere gardent le predicat d'avant, au bit.
(defconstant SCENE_GATE_ALIVE_MAX 16)

;; Ecart maximal, en frames d'artiste, entre le `display-level` d'une scene et le premier `alive`
;; qui le suit, pour que les deux commandes puissent encore tomber dans le MEME appel a
;; `execute-commands-up-to` -- c'est-a-dire pour que le defaut soit possible. Voir la justification
;; chiffree a l'endroit ou il est lu.
(defconstant SCENE_GATE_ALIVE_GAP 16)

;; Les noms d'acteurs que la scene courante va REVEILLER, releves dans sa command-list. Servent de
;; SONDE (le verdict par acteur publie a l'ouverture), jamais de condition d'attente : voir le
;; commentaire de la boucle plus bas.
(define *scene-gate-alive* (new 'global 'boxed-array string SCENE_GATE_ALIVE_MAX))
(define *scene-gate-alive-n* 0)

;; CONTROLE POSITIF DE CE CYCLE, ET IL EST OBLIGATOIRE ICI. Vrai partout dans le jeu ; AUCUN code
;; ne l'ecrit, seule la console de developpement peut le mettre a #f. Il DESARME le mode strict
;; sans toucher a rien d'autre -- la sonde continue de publier son verdict acteur par acteur.
;; RAISON D'ETRE : le defaut d'origine est une COURSE (une course x86 sur trois le reproduisait au
;; cycle precedent), donc « dix sur dix » sur quelques courses ne prouverait rien a lui seul.
;; Desarme, la barriere s'ouvre sur `statut=loaded` et la sonde rend `trouves=0/10` -- et c'est
;; DETERMINISTE, parce que rien n'affiche le niveau voisin avant la frame d'artiste du
;; `display-level`. Arme, elle rend 10/10. Meme binaire, meme course, un bit d'ecart.
(define *scene-gate-strict* #t)

(defun scene-level-goal-ready? ((nm symbol) (strict symbol))
  "Le niveau est-il assez avance COTE GOAL pour que la scene puisse s'en servir ?
   L'echelle des statuts est inactive -> loading -> loading-bt -> loading-done -> login -> loaded
   -> alive -> active (engine/level/level.gc:248-258).
   `strict` = la scene va REVEILLER des acteurs : il faut alors 'active, le seul statut que
   `entity-by-name` regarde (engine/entity/entity.gc:100). Sinon 'loaded suffit -- c'est le seuil
   a partir duquel `update! *load-state*` (level.gc:1144-1147) peut activer le niveau dans la
   frame, et c'est le predicat d'avant ce cycle, inchange."
  (let ((st (level-status *level* nm)))
    (if strict
      (= st 'active)
      (or (= st 'loaded) (= st 'alive) (= st 'active)))))

(defun scene-gate-actors! ((nm string) (quand symbol) (lev symbol))
  "Publier, acteur par acteur, si la scene pourrait le faire naitre MAINTENANT, et rendre le
   compte de ceux qui le sont.
   NATURE : un VERDICT booleen par acteur, pas une duree ni une moyenne.
   REPERE : la table d'entites des niveaux 'active -- c'est-a-dire, au mot pres, ce que la commande
   `alive` lira 938 frames d'artiste plus tard. Ce n'est pas un substitut du signal, c'est le
   signal lui-meme, appele par la meme fonction.
   CE QU'ELLE LIT QUAND LE DEFAUT EST PRESENT : `trouve=#f` sur les dix, avec `statut=loaded` --
   exactement la ligne mesuree le 2026-08-29. QUAND IL EST ABSENT : `trouve=#t` sur les dix, avec
   `statut=active`. Les deux sont publiees dans la MEME course, a `quand=arme` puis `quand=ouvert`."
  (let ((n 0))
    (dotimes (i *scene-gate-alive-n*)
      (let* ((who (-> *scene-gate-alive* i))
             (e (entity-by-name who)))
        (if e (+! n 1))
        (format 0
                "SCENEACTOR scene=~S quand=~A nom=~S trouve=~A niveau=~A statut=~A~%"
                nm
                quand
                who
                (if e #t #f)
                lev
                (level-status *level* lev))))
    n))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Gbeach-actors-gate -- LE BALAYAGE DE LA COMMAND-LIST VIT HORS DE LA BEHAVIOR
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; MESURE, PAS PRECAUTION. Le premier jet de ce cycle gardait les onze grandeurs du balayage dans
;; les variables locales de `scene-load-gate!`. C'est un `defbehavior` qui SUSPEND : ses locales
;; vivent sur la pile du PROCESS, et celle du process `logo` fait 512 octets. Le jeu s'est arrete
;; net au demarrage, avant meme l'ecran titre :
;;     ERROR: suspend called without enough stack in proc: #<logo ... :stack 112/512 ...>
;;     Stack: 592/512
;; 80 octets de trop, soit EXACTEMENT les dix cases ajoutees. Le balayage ne suspend jamais : il
;; n'a rien a faire sur cette pile. Il passe donc par une fonction ordinaire, et ses resultats par
;; des globales -- la behavior ne garde plus que `gpu` et `t0`, cinq cases de moins qu'avant ce
;; cycle. Une seule scene est barrieree a la fois (`spool-lock`, plus haut dans ce fichier), donc
;; ces globales n'ont pas deux ecrivains.
(define *scene-gate-show0* (the-as symbol #f))
(define *scene-gate-show1* (the-as symbol #f))
(define *scene-gate-mode0* (the-as symbol #f))
(define *scene-gate-mode1* (the-as symbol #f))
;; frames d'ARTISTE, deja converties depuis leur `binteger` (le decalage de 3 bits que fait
;; `command-get-float`, engine/level/load-boundary.gc:991-996). Publier une frame huit fois trop
;; grande aurait rendu tout `ecart=` illisible, et aurait colle `gambler-introduction-1` (ecart 2)
;; pile sur le seuil. -1 = pas vue.
(define *scene-gate-dispf* -1)
(define *scene-gate-alivef* -1)

(defun scene-gate-wanted? ()
  "La scene courante est-elle de celles ou le defaut est POSSIBLE ?
   Il en faut DEUX a la fois : qu'elle reveille des acteurs, et que son `alive` soit assez PRES de
   son `display-level` pour que les deux tombent dans le meme appel a `execute-commands-up-to`.
   Balayage statique des 179 spool-anim de jak1 : la barriere en retient 18, neuf portent un
   `alive`, et leurs ecarts en frames d'artiste sont
       1, 1, 1, 2   |   37, 549, 719, 1280, 1360
   Les deux populations sont separees par un facteur 18 : le seuil n'a pas a etre precis, il doit
   tomber dans le trou. 16 frames d'artiste valent une frame de jeu de plus d'une demi-seconde
   (`sage-intro-sequence-e` avance de ~1 frame d'artiste par frame de jeu a 30 images/s : 938
   frames en 31,37 s de course x86), donc aucune cadence jouable ne fait tomber un ecart de 37
   dans un meme appel.
   CE QUE CA PROTEGE : les cinq autres scenes retenues gardent le predicat d'avant, au bit, et
   leur niveau voisin n'est pas dessine plus tot qu'aujourd'hui."
  (and (nonzero? *scene-gate-alive-n*)
       (>= *scene-gate-dispf* 0)
       (>= *scene-gate-alivef* *scene-gate-dispf*)
       (<= (- *scene-gate-alivef* *scene-gate-dispf*) SCENE_GATE_ALIVE_GAP)))

(defun scene-gate-strict? ()
  "`scene-gate-wanted?` est une propriete de la SCENE ; ceci est ce qu'on en fait. Les separer
   laisse la sonde publier son verdict meme quand le controle desarme la barriere : sans ca,
   l'ablation n'aurait rien a lire et ne serait pas un controle."
  (and (scene-gate-wanted?) *scene-gate-strict*))

(defun scene-gate-scan! ((sa spool-anim))
  "Relever dans la command-list de `sa` : le PREchargement de la frame 0, les niveaux AFFICHES avec
   leur mode, et les acteurs REVEILLES avec la frame du premier d'entre eux. Demander le
   prechargement au passage.
   Les casts `the-as pair` reprennent la facon dont `execute-commands-up-to` parcourt cette meme
   liste : car/cdr y sont types `object`."
  (let ((pre0 (the-as symbol #f))
        (pre1 (the-as symbol #f))
        (dispf1 -1)
        (alivef1 -1)
        (cmds (the-as pair (-> sa command-list))))
    (set! *scene-gate-show0* (the-as symbol #f))
    (set! *scene-gate-show1* (the-as symbol #f))
    (set! *scene-gate-mode0* (the-as symbol #f))
    (set! *scene-gate-mode1* (the-as symbol #f))
    (set! *scene-gate-dispf* -1)
    (set! *scene-gate-alivef* -1)
    ;; la sonde d'acteurs appartient a CETTE scene et a elle seule
    (set! *scene-gate-alive-n* 0)
    ;; ON NE BLOQUE PAS SUR `want-levels`, ON BLOQUE SUR `display-level`.
    ;; `want-levels` est un PREchargement : `ndi-intro` reclame `title village1` a la
    ;; frame 0 et n'affiche jamais village1 — le logo Naughty Dog n'a aucune raison
    ;; d'attendre la plage. `display-level` est la DEPENDANCE : c'est la commande qui
    ;; dit « ce niveau va etre a l'ecran ». `logo-intro` affiche village1 (frames 5 et
    ;; 115), `sage-intro-sequence-e` affiche beach (frame 937) : ce sont exactement les
    ;; deux scenes dont l'owner decrit le defaut. Une cible `#f` eteint l'affichage et
    ;; ne compte pas.
    (while (not (null? cmds))
      (let ((entry (the-as pair (car cmds))))
        (when (pair? entry)
          (let ((frame (the-as int (car entry)))
                (cmd (the-as pair (cdr entry))))
            (when (pair? cmd)
              (let ((verb (car cmd))
                    (args (the-as pair (cdr cmd))))
                (when (pair? args)
                  (let ((a0 (car args)))
                    (when (and (not (null? a0)) (not (pair? a0)))
                      ;; le PREchargement : le premier `want-levels` de la frame 0
                      (when (and (= verb 'want-levels) (zero? frame) (not pre0))
                        (set! pre0 (the-as symbol a0))
                        (let ((rest (the-as pair (cdr args))))
                          (when (pair? rest)
                            (let ((a1 (car rest)))
                              (if (and (not (null? a1)) (not (pair? a1)))
                                (set! pre1 (the-as symbol a1)))))))
                      ;; la DEPENDANCE : tout `display-level` dont la cible n'est pas #f
                      (when (= verb 'display-level)
                        (let ((rest (the-as pair (cdr args))))
                          (when (and (pair? rest) (car rest))
                            (cond
                              ((or (not *scene-gate-show0*) (= *scene-gate-show0* (the-as symbol a0)))
                               (when (not *scene-gate-show0*)
                                 (set! *scene-gate-mode0* (the-as symbol (car rest)))
                                 (set! *scene-gate-dispf* (/ frame 8)))
                               (set! *scene-gate-show0* (the-as symbol a0)))
                              ((or (not *scene-gate-show1*) (= *scene-gate-show1* (the-as symbol a0)))
                               (when (not *scene-gate-show1*)
                                 (set! *scene-gate-mode1* (the-as symbol (car rest)))
                                 (set! dispf1 (/ frame 8)))
                               (set! *scene-gate-show1* (the-as symbol a0)))
                              (else (empty))))))
                      ;; Gbeach-actors-gate : les acteurs que la scene va REVEILLER. Leur argument
                      ;; est une CHAINE, donc il passe la meme garde que les symboles ci-dessus.
                      ;; Au-dela de SCENE_GATE_ALIVE_MAX on cesse d'en relever : la sonde devient
                      ;; partielle et le DIT (`trouves=n/m`), elle ne ment pas.
                      (when (= verb 'alive)
                        (when (< *scene-gate-alive-n* SCENE_GATE_ALIVE_MAX)
                          (set! (-> *scene-gate-alive* *scene-gate-alive-n*) (the-as string a0))
                          (+! *scene-gate-alive-n* 1))
                        ;; premier `alive` POSTERIEUR au `display-level` de chaque emplacement
                        (if (and (>= *scene-gate-dispf* 0)
                                 (< *scene-gate-alivef* 0)
                                 (>= (/ frame 8) *scene-gate-dispf*))
                          (set! *scene-gate-alivef* (/ frame 8)))
                        (if (and (>= dispf1 0) (< alivef1 0) (>= (/ frame 8) dispf1))
                          (set! alivef1 (/ frame 8))))))))))))
      (set! cmds (the-as pair (cdr cmds))))
    ;; N'ATTENDRE QUE CE QUE LA SCENE RECLAME ELLE-MEME.
    ;; Un `display-level` portant sur un niveau que la command-list ne demande PAS a la
    ;; frame 0 (les scenes du maire, du sculpteur, `logo-intro-2`...) veut dire qu'un
    ;; autre chemin l'a deja charge. Si ce n'est pas le cas, PERSONNE ne le chargera
    ;; pendant notre attente et la barriere irait au bout de son plafond pour rien —
    ;; on aurait remplace un pop-in par un ecran noir de 20 s. Balayage statique sur les
    ;; 179 spool-anim de jak1 : la regle passe de 28 scenes retenues a 18, et les 10 qui
    ;; tombent sont exactement celles qui affichent un niveau qu'elles ne demandent pas.
    (when (and *scene-gate-show0*
               (not (or (= *scene-gate-show0* pre0) (= *scene-gate-show0* pre1))))
      (set! *scene-gate-show0* (the-as symbol #f))
      (set! *scene-gate-mode0* (the-as symbol #f))
      (set! *scene-gate-dispf* -1)
      (set! *scene-gate-alivef* -1))
    (when (and *scene-gate-show1*
               (not (or (= *scene-gate-show1* pre0) (= *scene-gate-show1* pre1))))
      (set! *scene-gate-show1* (the-as symbol #f))
      (set! *scene-gate-mode1* (the-as symbol #f))
      (set! dispf1 -1)
      (set! alivef1 -1))
    (when (and (not *scene-gate-show0*) *scene-gate-show1*)
      (set! *scene-gate-show0* *scene-gate-show1*)
      (set! *scene-gate-mode0* *scene-gate-mode1*)
      (set! *scene-gate-dispf* dispf1)
      (set! *scene-gate-alivef* alivef1)
      (set! *scene-gate-show1* (the-as symbol #f))
      (set! *scene-gate-mode1* (the-as symbol #f)))
    ;; Demander le prechargement MAINTENANT : la command-list ne le ferait qu'a la
    ;; frame 0, c'est-a-dire une fois le flux audio deja parti.
    (if pre0 (want-levels *load-state* pre0 pre1)))
  0)

(defun scene-gate-levels-ready? ()
  "Les niveaux que la scene va AFFICHER sont-ils utilisables cote GOAL ?
   Une seule fonction, appelee depuis la condition de la boucle : chaque sous-expression laissee
   dans la behavior coute des cases sur la pile de PROCESS, et il n'en restait que 144."
  (and (scene-level-goal-ready? *scene-gate-show0* (scene-gate-strict?))
       (or (not *scene-gate-show1*)
           (scene-level-goal-ready? *scene-gate-show1* (scene-gate-strict?)))))

(defun scene-gate-arm! ((nm string))
  "Ce qui se fait UNE FOIS, avant d'attendre : avancer le `display-level` que la scene porte deja,
   et prendre la LIGNE DE BASE de la sonde d'acteurs.
   Hors de la behavior pour la meme raison que `scene-gate-scan!` : la pile de process."
  (when (scene-gate-wanted?)
    (format 0
            "SCENEGATE-STRICT scene=~S voulu=~A arme=~A ecart=~D~%"
            nm
            (scene-gate-wanted?)
            *scene-gate-strict*
            (- *scene-gate-alivef* *scene-gate-dispf*)))
  (when (scene-gate-strict?)
    ;; AVANCER LA COMMANDE QUE LA SCENE PORTE DEJA. Sans ca, attendre 'active serait attendre un
    ;; etat que PERSONNE ne produit avant la frame du `display-level` -- exactement le piege que ce
    ;; fichier documente plus haut, et on irait au plafond pour rien. On n'invente aucune commande
    ;; et on ne choisit aucun mode : `*scene-gate-mode0*` sort de la command-list. La scene
    ;; rejouera son `display-level` a l'heure prevue et `update!` n'y verra rien a faire
    ;; (level.gc:1141, le voeu et l'etat coincident deja).
    (want-display-level *load-state* *scene-gate-show0* *scene-gate-mode0*)
    (if *scene-gate-show1* (want-display-level *load-state* *scene-gate-show1* *scene-gate-mode1*))
    (format 0
            "SCENEGATE-DISPLAY scene=~S niveau=~A mode=~A frame=~D alive=~D~%"
            nm
            *scene-gate-show0*
            *scene-gate-mode0*
            *scene-gate-dispf*
            *scene-gate-alivef*))
  ;; LIGNE DE BASE DE LA SONDE, prise AVANT toute attente. C'est le controle negatif : au meme
  ;; instant ou la barriere s'arme, aucun de ces acteurs n'est instanciable. Sans elle, `trouve=#t`
  ;; a l'ouverture n'aurait pas d'echelle. Publiee que la barriere soit armee ou non, sinon
  ;; l'ablation n'aurait rien a comparer.
  (when (scene-gate-wanted?)
    (format 0
            "SCENEGATE-ACTEURS scene=~S quand=arme niveau=~A statut=~A trouves=~D/~D~%"
            nm
            *scene-gate-show0*
            (level-status *level* *scene-gate-show0*)
            (scene-gate-actors! nm 'arme *scene-gate-show0*)
            *scene-gate-alive-n*))
  0)

(defun scene-gate-open! ((nm string) (gpu symbol) (waited time-frame))
  "Le verdict, a l'instant ou la barriere s'ouvre."
  ;; LA LIGNE QUI TRANCHE : elle publie le statut GOAL du niveau que la scene va AFFICHER. C'est ce
  ;; statut, et non la residence GPU, qui decide si `alive` trouvera les acteurs.
  (format 0
          "LOADGATE-GOAL scene=~S niveau=~A statut=~A gpu=~A attendu=~D strict=~A~%"
          nm
          *scene-gate-show0*
          (level-status *level* *scene-gate-show0*)
          gpu
          waited
          (scene-gate-strict?))
  ;; LE VERDICT, ACTEUR PAR ACTEUR, AVANT QUE LA SCENE NE LES REVEILLE.
  ;; Ce n'est pas une condition d'attente, et c'est delibere : quand les niveaux affiches sont
  ;; 'active, la barriere n'a plus RIEN a attendre -- une clause « et les acteurs sont trouvables »
  ;; serait alors soit vraie par construction (donc infalsifiable), soit un blocage de 20 s sur un
  ;; acteur qui vit dans un TROISIEME niveau, ce qui existe : trois des dix-huit scenes retenues
  ;; ont un `alive` hors de leur niveau affiche. Publier le verdict le rend au contraire
  ;; REFUTABLE : un `trouves=` inferieur au total dirait que le modele est faux.
  (when (scene-gate-wanted?)
    (format 0
            "SCENEGATE-ACTEURS scene=~S quand=ouvert niveau=~A statut=~A trouves=~D/~D~%"
            nm
            *scene-gate-show0*
            (level-status *level* *scene-gate-show0*)
            (scene-gate-actors! nm 'ouvert *scene-gate-show0*)
            *scene-gate-alive-n*))
  0)

(defbehavior scene-load-gate! process-drawable ((arg0 spool-anim))
  "Hold this scene until every level it will DISPLAY is drawable, and -- for the scenes that WAKE
   actors -- until those actors are instantiable. No-op otherwise."
  ;; Gbeach-actors-gate -- CETTE BEHAVIOR NE GARDE QUE `gpu` ET `t0`, ET C'EST UNE CONTRAINTE
  ;; MESUREE, PAS UN GOUT. Elle SUSPEND, donc ses locales vivent sur la pile du PROCESS. Le process
  ;; `sage` en occupe deja 368 sur 512 quand il l'appelle : il reste 144 octets. Les deux premiers
  ;; jets de ce cycle les ont depasses et le jeu s'est arrete net --
  ;;     ERROR: suspend called without enough stack in proc: #<logo ...>  Stack: 592/512
  ;;     ERROR: suspend called without enough stack in proc: #<sage ...>  Stack: 528/512
  ;; Tout ce qui ne suspend pas (balayage, armement, verdict) vit donc dans des fonctions
  ;; ordinaires : `scene-gate-scan!`, `scene-gate-arm!`, `scene-gate-open!`.
  ;;
  ;; POURQUOI LA BARRIERE ATTEND DEUX CHOSES. `__pc-scene-ready?` lit
  ;; `load_gate::level_is_resident`, publie par `Loader.cpp:1462` : la GEOMETRIE tfrag3 et les
  ;; textures sont televersees. C'est un pipeline INDEPENDANT du chargement DGO cote GOAL, et rien
  ;; dedans ne parle des ACTEURS. Or la command-list de `sage-intro-sequence-e` fait
  ;; `display-level beach movie` a la frame 937 puis `alive "harvester-87..91"` a la 938, et
  ;; `alive` passe par `entity-by-name` (engine/entity/entity.gc:92-113), qui ne parcourt QUE les
  ;; niveaux au statut 'active. La course du 2026-08-29 tranche : la barriere s'ouvrait sur
  ;; `statut=loaded` et les dix acteurs sortaient `trouve=#f` ; les courses qui passaient avaient
  ;; `beach/active`. Une seule colonne separe les deux populations.
  ;;
  ;; CE QUE CA LIT QUAND LE DEFAUT EST ABSENT : `attendu=0` et `statut=active` des le premier tour,
  ;; la boucle ne s'execute pas, et le rendu est inchange au bit.
  (scene-gate-scan! arg0)
  (when *scene-gate-show0*
    (let ((gpu #f)
          (t0 (current-time)))
      (scene-gate-arm! (-> arg0 name))
      (until (or (and gpu (scene-gate-levels-ready?))
                 (>= (- (current-time) t0) SCENE_GATE_CEILING))
        ;; Le volet GPU se LATCHE : `scene_ready` efface son armement quand il rend 1, donc le
        ;; rappeler republierait une paire arm/open a chaque frame et remettrait son propre
        ;; plafond a zero. Une fois vrai, il le reste.
        (when (not gpu)
          (set! gpu (nonzero? (__pc-scene-ready?
                               (-> arg0 name)
                               (symbol->string *scene-gate-show0*)
                               (if *scene-gate-show1* (symbol->string *scene-gate-show1*) "none")
                               ;; Plafond 20 s. Le loader passe sur son chemin BLOQUANT tant
                               ;; que la barriere est fermee (cout mesure d'un niveau : ~5 s,
                               ;; village1 4,6 s), donc c'est un plafond, pas une cible.
                               20000))))
        ;; Garder la partie streamee vivante pendant l'attente. Toutes les autres
        ;; boucles d'attente de ce fichier repoussent a chaque tour pour cette raison :
        ;; sans push, l'art control peut lacher le spool qu'on s'apprete a jouer.
        (spool-push *art-control* (-> arg0 name) 0 self -20.0)
        (set-blackout-frames (seconds 0.05))
        ;; Gloading-screen : armer l'ecran de chargement AU NOM de la barriere de scene. Les
        ;; coupes de camera (pov-camera.gc:103), les boutons (basebutton.gc:348) et la mort
        ;; poussent `blackout-time` juste au-dessus et ne posent JAMAIS ce bit : ils sont exclus
        ;; par construction, pas par un reglage qu'on pourrait rater.
        (loading-screen-hold-by! LS_HOLD_SCENE)
        (suspend))
      (scene-gate-open! (-> arg0 name) gpu (- (current-time) t0)))
    ;; Gloading-screen : la barriere vient de s'ouvrir -- relacher l'ecran TOUT DE SUITE. La
    ;; fermeture normale d'un episode est donc un APPEL, pas l'expiration d'un delai, et le
    ;; sursis de `LOADING_SCREEN_HOLD` n'est plus qu'un chien de garde pour le cas ou ce
    ;; processus serait tue en pleine attente.
    (loading-screen-release-by! LS_HOLD_SCENE))
  0)

;; Gloading-screen — RETOUR OWNER 2026-08-29 : « L'ecran de chargement est bien la, mais pas quand
;; on charge une partie. »
;;
;; IL A RAISON, ET LA CAUSE EST STRUCTURELLE, PAS UN OUBLI DE REGLAGE. `scene-load-gate!`
;; ci-dessus est armee depuis `ja-play-spooled-anim` : elle ne couvre QUE la lecture d'une SCENE
;; (cinematique streamee). Charger une sauvegarde ne joue aucune scene — il passe par
;; `initialize! *game-info* 'play` (engine/game/game-info.gc), qui tue la cible, applique la
;; sauvegarde puis `(start ...)` a un POINT DE REPRISE. Ce chemin ne touchait aucune barriere,
;; donc l'ecran ne pouvait pas s'allumer. C'est le chemin que le joueur emprunte le plus souvent.
;;
;; MEME MECANISME, PAS UNE COPIE. On reutilise exactement les memes primitives que la barriere de
;; scene : `__pc-scene-ready?` pour la residence GPU, `__pc-scene-release` pour rendre la
;; consigne, `loading-screen-hold!` / `loading-screen-release!` pour l'ecran. Un seul changement :
;; le niveau a attendre ne se lit plus dans une command-list de scene mais dans le POINT DE
;; REPRISE.
;;
;; ON ATTEND `(-> cp level)`, PAS `lev0`/`disp0`, ET C'EST MESURE. `disp0`/`disp1` decrivent bien
;; l'affichage, mais un balayage du depot le dit : AUCUN code de jak1 ne LIT ces deux champs
;; (`grep -rn disp0 goal_src/jak1 --include=*.gc` ne rend que leur declaration et leurs ecritures).
;; Ce sont des donnees mortes ici, donc rien ne garantit que quelqu'un chargera ce qu'elles
;; nomment — et attendre un niveau que PERSONNE ne charge est exactement le piege que la barriere
;; de scene ci-dessus documente et desamorce. `(-> cp level)` est au contraire lu par huit sites
;; vivants (engine/level/level.gc:909 et :1218, engine/target/target-death.gc:42, ...) : c'est le
;; niveau ou la reprise POSE Jak, donc le systeme de frontieres de chargement le reclame des que
;; la cible existe. C'est le seul des trois champs dont le chargement est garanti.
;;
;; NATURE de la grandeur : un ETAT DE RESIDENCE GPU, pas une temporisation. REPERE : le renderer,
;; via load_gate (game/system/load_gate.h) — jamais `level-status`, qui a declare `beach` charge
;; 38,5 s avant qu'il soit dessinable.
;; CE QU'ELLE LIT QUAND LE DEFAUT EST ABSENT : sur une reprise DANS le niveau courant (mort et
;; renaissance, avertissement de checkpoint), les niveaux sont deja residents, `__pc-scene-ready?`
;; rend 1 au PREMIER tour, le corps de la boucle ne s'execute jamais, et rien ne s'allume. C'est la
;; meme propriete d'auto-extinction que la barriere de scene, et c'est ce qui empeche l'ecran
;; d'apparaitre a chaque mort.
;;
;; SORTIE GARANTIE, comme au-dessus : `__pc-scene-ready?` est fail-open et porte son propre
;; plafond. Une barriere qui peut bloquer le jeu serait pire que le defaut qu'elle corrige.
(defun continue-load-gate! ((cp continue-point))
  "Retenir l'ecran de chargement jusqu'a ce que le niveau ou `cp` pose Jak soit dessinable.
   Sans effet s'il l'est deja."
  (when (and cp (-> cp level))
    (let ((lev (symbol->string (-> cp level)))
          ;; compteur LOCAL : `*loading-screen-frames*` vit dans engine/game/main.gc, compile
          ;; APRES ce fichier (game.gp:1998 contre :1924), donc invisible ici.
          (tours 0))
      (format 0 "LOADSCREEN-CONT arm continue=~S niveau=~S~%" (-> cp name) lev)
      (until (nonzero? (__pc-scene-ready?
                        (-> cp name)
                        lev
                        "none"
                        ;; Meme plafond que la barriere de scene. C'est un PLAFOND, pas une
                        ;; cible : le renderer passe sur son chemin de chargement BLOQUANT tant
                        ;; qu'une barriere est fermee, donc le chargement va PLUS VITE pendant
                        ;; qu'on le montre.
                        20000))
        (+! tours 1)
        (loading-screen-hold-by! LS_HOLD_CONTINUE)
        (suspend))
      ;; rendre la consigne : sans ca, la deadline armee sous ce nom resterait, et la reprise
      ;; SUIVANTE au meme point trouverait une barriere deja expiree.
      (__pc-scene-release (-> cp name))
      ;; `tours=0` est le cas NORMAL quand le niveau est deja resident (mort et renaissance sur
      ;; place) : la barriere n'a rien retenu et l'ecran ne s'est pas allume. C'est la ligne de
      ;; base de cette mesure, et elle se distingue d'un cablage absent, qui n'imprimerait RIEN.
      (format 0 "LOADSCREEN-CONT open continue=~S tours-retenus=~D~%" (-> cp name) tours)
      ;; Gloading-screen : ne relacher QUE ce bit. `target-continue` tient le sien en parallele et
      ;; attend, lui, le statut GOAL 'active -- eteindre l'episode ici ferait repartir son seuil.
      (loading-screen-release-by! LS_HOLD_CONTINUE)))
  0)

(defbehavior ja-play-spooled-anim process-drawable ((arg0 spool-anim) (arg1 art-joint-anim) (arg2 art-joint-anim) (arg3 (function process-drawable symbol)))
  (local-vars (v0-39 int))
  (let ((spool-part 0))
    (let ((sv-24 -17.0))
      (let ((old-skel-status (-> self skel status))))
      (let ((sv-32 -2)
            (sv-40 0)
            (sv-48 0)
            (sv-56 0)
            (spool-sound (new-sound-id)))
        (backup-load-state-and-set-cmds *load-state* (-> arg0 command-list))
        (set-setting! 'spooling (process->ppointer self) 0.0 0)
        (logior! (-> self skel status) (janim-status inited drawn done))
        (kill-current-level-hint '() '() 'die)
        (level-hint-surpress!)
        (apply-settings *setting-control*)
        (when (or (handle->process (-> *art-control* spool-lock)) (!= *master-mode* 'game))
          (cond
            (arg1 (when (!= (ja-group) arg1) (ja-channel-push! 1 (seconds 0.05)) (ja :group! arg1 :num! min)))
            (else (ja-channel-set! 0)))
          (while (or (handle->process (-> *art-control* spool-lock)) (!= *master-mode* 'game))
            (format #t "WARNING: ---------------------> loader stall on lock~%")
            ;; Gcutscene-skip-all : le verrou du geste « maintenir CERCLE deux secondes » est lu
            ;; A COTE du predicat d'origine, jamais a sa place -- `arg3` garde exactement le
            ;; comportement qu'il avait. `cutscene-skip-abort!` rend #t et compte l'abandon, donc
            ;; le compteur ne monte que quand on saute vraiment.
            (if (or (cutscene-native-pred? (arg3 self))
                    (and (!= self *target*)
                         (cutscene-skip-spool-eligible? (-> arg0 name))
                         (cutscene-skip-fired?)
                         (cutscene-skip-abort! 'spool-stall-lock)))
              (goto cfg-88))
            (spool-push *art-control* (-> arg0 name) spool-part self -9.0)
            ;; Gloading-screen-window — LE RACCORD. Cette attente-ci et celle de l'art juste en
            ;; dessous precedent `scene-load-gate!` et n'etaient couvertes par AUCUN bit : mesure
            ;; x86 du 2026-08-30, transition teleporteur -> Hutte du Sage Vert, `LS_HOLD_TARGET`
            ;; relache a t=91,40 s et `LOADGATE arm scene=sage-intro-sequence-e` a t=91,59 s, soit
            ;; ~190 ms -- une douzaine d'images -- entre deux barrieres. Une fenetre qui s'ouvre
            ;; deux fois avec un trou au milieu n'encadre rien : c'est le trou que l'owner decrit.
            ;; Ce sont litteralement des attentes de CHARGEMENT avant qu'une scene puisse
            ;; commencer, c'est-a-dire la meme famille que la barriere qui suit.
            (when *ls-window-fix* (loading-screen-hold-by! LS_HOLD_SCENE))
            (suspend)
            (if arg1 (ja :num! (loop!)))))
        (set! (-> *art-control* spool-lock) (process->handle self))
        (set! sv-48 (the-as int (current-time)))
        (while (< spool-part (-> arg0 parts))
          (spool-push *art-control* (-> arg0 name) spool-part self -20.0)
          (update *art-control* #f)
          (spool-push *art-control* (-> arg0 name) spool-part self -20.0)
          (when (!= (file-status *art-control* (-> arg0 name) spool-part) 'active)
            (cond
              (arg1 (when (!= (ja-group) arg1) (ja-channel-set! 1) (ja :group! arg1 :num! min)))
              (else (ja-channel-set! 0)))
            (while (!= (file-status *art-control* (-> arg0 name) spool-part) 'active)
              ;; Gcutscene-skip-all : idem, cf. le commentaire de l'attente sur verrou ci-dessus.
              (if (or (cutscene-native-pred? (arg3 self))
                      (and (!= self *target*)
                           (cutscene-skip-spool-eligible? (-> arg0 name))
                           (cutscene-skip-fired?)
                           (cutscene-skip-abort! 'spool-stall-art)))
                (goto cfg-88))
              (spool-push *art-control* (-> arg0 name) spool-part self -20.0)
              (format #t "WARNING: ---------------------> loader stall on art ~S ~D~%" (-> arg0 name) spool-part)
              ;; UNIQUEMENT SUR LA PARTIE 0, et ce n'est pas une precaution : les parties
              ;; suivantes sont attendues PENDANT que la cinematique joue deja. Y poser l'ecran de
              ;; chargement le ferait apparaitre AU MILIEU d'une scene -- on remplacerait un defaut
              ;; par un pire.
              (when (and *ls-window-fix* (zero? spool-part))
                (loading-screen-hold-by! LS_HOLD_SCENE))
              (suspend)
              (if arg1 (ja :num! (loop!)))))
          (spool-push *art-control* (-> arg0 name) spool-part self -20.0)
          (let ((s2-4 (the-as art-joint-anim (lookup-art (-> self draw art-group) (-> arg0 name) art-joint-anim))))
            (cond
              (s2-4
               (ja-channel-set! 1)
               (ja-no-eval :group! s2-4 :num! (seek!) :frame-num 0.0)
               (when (zero? spool-part)
                 ;; Gplayability-input-and-loadgate: the barrier goes HERE, on the
                 ;; last line before the audio clock starts. See scene-load-gate!.
                 (scene-load-gate! arg0)
                 ;; Le raccord se termine ICI, a la ligne meme ou la scene demarre : tout ce qui
                 ;; precede etait de l'attente de chargement, tout ce qui suit est la scene.
                 ;; `scene-load-gate!` relache deja ce bit quand elle a arme sa barriere ; cet
                 ;; appel couvre le cas ou elle n'a rien a garder (aucun niveau a afficher), ou
                 ;; l'attente d'art ci-dessus aurait sinon laisse le bit pose jusqu'au chien de
                 ;; garde.
                 (loading-screen-release-by! LS_HOLD_SCENE)
                 (str-play-async (-> arg0 name) spool-sound)
                 (set! (-> *art-control* active-stream) (-> arg0 name)))
               (let* ((f30-0 (* 0.05859375 (-> s2-4 speed)))
                      (f28-0 (+ sv-24 (/ (the float (+ (-> s2-4 data 0 length) -1)) f30-0))))
                 (let ((sv-72 (current-str-pos spool-sound)))
                   (set! sv-40 (the-as int (current-time)))
                   (until (>= (the float v0-39) f28-0)
                     (if (= (-> self skel root-channel 0) (-> self skel channel)) (logior! (-> self skel status) (janim-status spool)))
                     ;; Gcutscene-skip-all — LE POINT UNIQUE DES SCENES STREAMEES.
                     ;; `ja-play-spooled-anim` est le SEUL lecteur de spool du jeu (`str-play-async`
                     ;; n'est appele que 20 lignes plus bas, dans cette meme fonction) : ce que l'on
                     ;; pose ici couvre d'un coup les 21 chemins de scene streamee, quel que soit le
                     ;; predicat que l'appelant a fourni -- y compris les 19 qui passent `false-func`
                     ;; et n'ont donc JAMAIS ete abandonnables.
                     ;;
                     ;; L'EXCLUSION DU JOUEUR N'EST PAS UNE PRECAUTION, C'EST UNE MESURE.
                     ;; `target-stance-ambient` (engine/target/target2.gc:93) joue une anim
                     ;; STREAMEE d'oisiveté pendant que le joueur a le controle total ; sans ce
                     ;; test, l'indice « Skip » apparaitrait pendant que Jak fait le poirier.
                     ;; C'est aussi le seul des 24 appels dont le predicat d'origine lit le stick.
                     ;; Gcutscene-skip-polish-2 : la boucle de fond de l'ecran de titre
                     ;; (`logo-loop`) traverse ce meme appel et posait donc la marque pendant
                     ;; TOUT le menu principal -- 1958 images d'un faux « episode ». Elle est
                     ;; exclue par son nom, les introductions du titre restant sautables.
                     (when (and (!= self *target*) (cutscene-skip-spool-eligible? (-> arg0 name)))
                       (cutscene-skip-mark!)
                       (if (and (cutscene-skip-fired?) (cutscene-skip-abort! 'spool)) (goto cfg-88)))
                     (if (or (cutscene-native-pred? (arg3 self))
                             (and (<= sv-72 0) (time-elapsed? (the-as time-frame sv-40) (seconds 4)))
                             (and (< 300 sv-56) (<= sv-72 0)))
                       (goto cfg-88))
                     (spool-push *art-control* (-> arg0 name) spool-part self -20.0)
                     (if (< (+ spool-part 1) (-> arg0 parts))
                       (spool-push *art-control* (-> arg0 name) (+ spool-part 1) self -10.0)
                       (logclear! (-> self skel status) (janim-status done)))
                     ;; og:autoport Gcine-cut — recover the cutscene spool-command frame
                     ;; from the raw stream clock when the arm64 anim state is corrupt.
                     ;;
                     ;; The command frame had been `(ja-aframe-num 0)` = the live channel's
                     ;; frame-num * frame-group.artist-step + .artist-base. During the misty-
                     ;; level load stall in this cutscene the spool coroutine's FLOAT state
                     ;; gets stomped on arm64 (a callee clobbers the v8-15 callee-saved bank
                     ;; across the deep loader calls): f30-0 AND the channel's frame-num/
                     ;; artist-step/artist-base all collapse to ~1.0 scaling, so ja-aframe-num
                     ;; (and strpos*f30-0) SPIKE to ~the raw stream position — tens of
                     ;; thousands of artist-frames. Feeding that to execute-commands-up-to
                     ;; fires EVERY remaining cutscene command at once -> the camera jumps to
                     ;; the final camera joint and glides, collapsing the discrete CUTs.
                     ;;
                     ;; The ONLY value that survives the stomp is the raw C++ stream position
                     ;; (current-str-pos). The cutscene's artist frame == strpos * f30 to <1
                     ;; frame across the whole anim (authored contiguously, so artist-base
                     ;; cancels sv-24); every part here has speed 0.5, i.e. the immutable
                     ;; constant f30 = 0.05859375 * 0.5. When ja-aframe-num is implausibly
                     ;; large (the anim tops out ~2570) AND has collapsed toward the strpos
                     ;; magnitude (af/strpos jumps from the normal ~0.03 to ~1.0), recover the
                     ;; command frame from strpos with that constant so the joint commands
                     ;; fire one-by-one as the cutscene genuinely crosses them = discrete
                     ;; CUTs. On x86 ja-aframe-num is always the true (small) frame and never
                     ;; collapses, so the branch is dead there => host / console identical.
                     (let* ((af-anim (ja-aframe-num 0))
                            (strpos-f (the float (current-str-pos spool-sound)))
                            (spike? (and (< 3000.0 af-anim) (< (* 0.3 strpos-f) af-anim)))
                            (cmd-af (if spike? (* strpos-f (* 0.05859375 0.5)) af-anim)))
                       (execute-commands-up-to *load-state* cmd-af))
                     (cond
                       ((and (< sv-32 sv-72) (= (current-str-id) spool-sound))
                        (+! sv-56 (- (current-time) (-> *display* old-base-frame-counter)))
                        (set! sv-40 (the-as int (current-time))))
                       (else 0))
                     (set! sv-32 sv-72)
                     (set! sv-48 (the-as int (current-time)))
                     (suspend)
                     (let ((f0-14 (* (- (the float (current-str-pos spool-sound)) sv-24) f30-0)))
                       (ja-no-eval :num! (seek!) :frame-num f0-14))
                     (set! v0-39 (current-str-pos spool-sound))
                     (set! sv-72 v0-39)))
                 (set! sv-24 f28-0))
               (logclear! (-> self skel status) (janim-status spool)))
              (else
               ;; og:preserve-this fixed broken format string
               (format 0 "ERROR: <asg> ~A in spool anim loop for ~A ~D, but not loaded.~%" self (-> arg0 name) spool-part)
               (goto cfg-88))))
          (+! spool-part 1))))
    (+! spool-part -1)
    (label cfg-88)
    (ja-abort-spooled-anim arg0 arg2 spool-part))
  0)

(defbehavior ja-abort-spooled-anim process-drawable ((arg0 spool-anim) (arg1 art-joint-anim) (arg2 int))
  "Abort a spooled animation."
  ;; Gplayability-input-and-loadgate: drop this scene's barrier if it still has
  ;; one. The C++ side expires abandoned arms on its own deadline anyway, but a
  ;; scene that ends cleanly should not leave the loader on its blocking path
  ;; for even one extra frame.
  (__pc-scene-release (-> arg0 name))
  ;; Gloading-screen-window : et rendre l'ecran. C'est le seul point de sortie commun de
  ;; `ja-play-spooled-anim` (label cfg-88), donc une scene avortee ne peut pas laisser le bit pose
  ;; -- le chien de garde le rattraperait, mais une seconde d'ecran de chargement de trop se voit.
  (loading-screen-release-by! LS_HOLD_SCENE)
  (restore-load-state-and-cleanup *load-state*)
  (str-play-stop (-> arg0 name))
  (set! (-> *art-control* active-stream) #f)
  (logclear! (-> self skel status) (janim-status drawn done))
  (if (not (logtest? (-> self skel status) (janim-status inited))) (logclear! (-> self skel status) (janim-status inited)))
  (remove-setting! 'spooling)
  (cond
    ((and arg1 (>= arg2 0))
     (ja-channel-push! 1 (seconds 0.1))
     (set! (-> self skel root-channel 0 frame-group) arg1)
     (while (!= (-> self skel root-channel 0) (-> self skel channel))
       (spool-push *art-control* (-> arg0 name) arg2 self -20.0)
       (suspend)
       (ja :num! (seek!))))
    (else (ja-channel-set! 0)))
  (set! (-> *art-control* spool-lock) (the-as handle #f))
  0)

(if (zero? *art-control*) (set! *art-control* (new 'global 'external-art-control)))
