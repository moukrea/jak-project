;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel-defs.gc")

;; PC port adds new menus and option types
(#cond
  ((not PC_PORT)
   (defenum progress-screen
     :type int64
     (invalid -1)
     (fuel-cell 0)
     (money 1)
     (buzzer 2)
     (settings 3)
     (game-settings 4)
     (graphic-settings 5)
     (sound-settings 6)
     (memcard-no-space 7)
     (memcard-not-inserted 8)
     (memcard-not-formatted 9)
     (memcard-format 10)
     (memcard-data-exists 11)
     (memcard-loading 12)
     (memcard-saving 13)
     (memcard-formatting 14)
     (memcard-creating 15)
     (load-game 16)
     (save-game 17)
     (save-game-title 18)
     (memcard-insert 19)
     (memcard-error-loading 20)
     (memcard-error-saving 21)
     (memcard-removed 22)
     (memcard-no-data 23)
     (memcard-error-formatting 24)
     (memcard-error-creating 25)
     (memcard-auto-save-error 26)
     (title 27)
     (settings-title 28)
     (auto-save 29)
     (pal-change-to-60hz 30)
     (pal-now-60hz 31)
     (no-disc 32)
     (bad-disc 33)
     (quit 34)
     (max 35))
   (defenum game-option-type
     :type uint64
     (slider 0)
     (language 1)
     (on-off 2)
     (center-screen 3)
     (aspect-ratio 4)
     (video-mode 5)
     (menu 6)
     (yes-no 7)
     (button 8)))
  (#t
   (defenum progress-screen
     :type int64
     (invalid -1)
     (fuel-cell 0)
     (money 1)
     (buzzer 2)
     (settings 3)
     (game-settings 4)
     (graphic-settings 5)
     (sound-settings 6)
     (memcard-no-space 7)
     (memcard-not-inserted 8)
     (memcard-not-formatted 9)
     (memcard-format 10)
     (memcard-data-exists 11)
     (memcard-loading 12)
     (memcard-saving 13)
     (memcard-formatting 14)
     (memcard-creating 15)
     (load-game 16)
     (save-game 17)
     (save-game-title 18)
     (memcard-insert 19)
     (memcard-error-loading 20)
     (memcard-error-saving 21)
     (memcard-removed 22)
     (memcard-no-data 23)
     (memcard-error-formatting 24)
     (memcard-error-creating 25)
     (memcard-auto-save-error 26)
     (title 27)
     (settings-title 28)
     (auto-save 29)
     (pal-change-to-60hz 30)
     (pal-now-60hz 31)
     (no-disc 32)
     (bad-disc 33)
     (quit 34)
     ;; extra screens for pc port
     ;; input options
     (input-options)
     (select-controller)
     (controller-binds) ;; 0x25
     (keyboard-binds)
     (mouse-binds)
     (controller-options)
     (mouse-options)
     (reassign-binds-options)
     (camera-options)
     (accessibility-options)
     (game-ps2-options)
     (misc-options)
     (resolution)
     (aspect-msg)
     (aspect-ratio)
     (gfx-ps2-options)
     (secrets)
     (hint-log)
     (cheats)
     (scrapbook)
     (music-player)
     (scene-player)
     (credits)
     (quit-title)
     (flava-player)
     (memcard-disable-auto-save)
     (memcard-auto-save-disabled)
     (monitor)
     (checkpoint-select)
     (speedrun-options)
     (speedrun-il-options)
     (speedrun-cat-ext-options)
     ;; Grecharged-hud-jak1: submenu holding the "Recharged" fork's optional HUD toggle.
     ;; Appended (auto-numbered) before `max` so no existing progress-screen value shifts.
     (recharged-settings)
     ;; Grecharged-grass-poc POLISH#6: dedicated NESTED "Grass Settings" page (sub-submenu of
     ;; Recharged Settings) holding all grass settings. Auto-numbered before `max`; *options-remap*
     ;; is allocated at 68 so this fits. Copied into game-option-menu via :copy-entries.
     (grass-settings)
     ;; Grecharged-menu-overhaul: the unified OPTIONS hub's DEBUG category page. Auto-numbered before
     ;; `max` (=> 70; *options-remap* allocated at 72, still fits). Reached from the hub only when
     ;; *debug-menus-visible?* (seeded from FLAG_DEBUG_MENUS / build.sh --debug).
     (debug-options)
     ;; recharged-gating-real (owner 2026-09-10) : le sous-menu « Recharged Lighting », frere de
     ;; `grass-settings`. Il porte l'interrupteur global de la refonte lumiere et TOUT ce qui en
     ;; depend — Realtime Lighting, HDR Output, l'Occlusion Ambiante et ses sous-reglages, les
     ;; matieres PBR. Ajoute AVANT `max` (auto-numerote => 70), donc aucune valeur existante ne
     ;; bouge ; `*options-remap*` est alloue a 72 (progress-static.gc), il reste de la place.
     ;; La page n'est PAS ecrite a la main : elle est construite a l'execution a partir de la
     ;; table des portes (`__pc-gating-page`), pour qu'une option ajoutee sous l'eclairage
     ;; y atterrisse sans que personne n'y pense.
     (lighting-settings)
     ;; recharged-gating-real essai 2 (owner 2026-09-10) : la page de choix GENERIQUE d'une option
     ;; Recharged. L'owner veut un VRAI sous-menu — les valeurs d'une option (« AMBIENT OCCLUSION »
     ;; -> Off / SSAO / HBAO / GTAO) vivent dans une page a elles, pas en petits choix serres sous
     ;; la rangee parente. UNE seule page sert toutes les options a valeurs : son contenu est
     ;; reconstruit dans `*temp-options*` a chaque ouverture, depuis le carrousel de la rangee d'ou
     ;; l'on vient. Ajoutee AVANT `max` (auto-numerotee => 71), donc aucune valeur existante ne bouge.
     (option-choice)
     ;; res-scale-submenu (owner 2026-09-17) : le sous-menu de l'ECHELLE DE RENDU. L'owner :
     ;; « le slider c'est chiant, je prefererais un sous menu avec 10, 20 ... 100, mais avec a
     ;; cote la resolution de rendu calculee live ». Dix entrees bâties a l'execution dans
     ;; `*temp-options*`, comme le sous-menu Resolution dont il est le voisin. Ajoute AVANT
     ;; `max` (auto-numerote => 72) : aucune valeur existante ne bouge, et `*options-remap*`
     ;; est alloue a 80 (progress-static.gc), la boucle d'effacement de `init-game-options`
     ;; ecrit donc 0..72, toujours dans le tableau.
     (render-scale)
     ;; the last one!
     (max))
   (defenum game-option-type
     :type uint64
     (slider 0)
     (language 1)
     (on-off 2)
     (center-screen 3)
     (aspect-ratio 4)
     (video-mode 5)
     (menu 6)
     (yes-no 7)
     (button 8)
     ;; extra types for pc port
     (normal-inverted)
     (display-mode)
     (msaa)
     (frame-rate)
     (lod-bg)
     (lod-fg)
     (resolution)
     (aspect-new)
     (language-subtitles)
     (language-text)
     (speaker)
     (aspect-native)
     (button-music)
     (button-flava)
     (cheat-toggle)
     (monitor)
     (controller)
     (binding-assignment)
     (confirmation)
     ;; Grecharged-ambient-occlusion: three multi-value carousell rows in the Recharged Settings menu.
     ;; ambient-occlusion = Off/SSAO/HBAO/GTAO; ao-quality = Low/Medium/High (disabled while AO Off);
     ;; ao-strength = Weaker/Default/Stronger (closing round; disabled while AO Off).
     (ambient-occlusion)
     (ao-quality)
     (ao-strength)
     ;; lighting-shadows: two multi-value carousell rows added right after AO STRENGTH, same screen.
     ;; actor-shadows = Vraies/Aplat PS2/Aucune; actor-shadow-dist = 20/40/80/150 m (disabled while
     ;; actor-shadows is Aucune). Mirrors the ambient-occlusion/ao-quality relationship.
     (actor-shadows)
     (actor-shadow-dist)
     ;; lighting-legacy-purge (2026-09-11) : SHADOW QUALITY, AMBIENT MODEL, DISPLACEMENT, PBR TEST
     ;; PRESET, PBR ISOLATE et MESH SUBDIVISION sont RETIRES — reglages d'eclairage de l'ancien
     ;; monde. Aucune valeur numerique de cet enum n'est ecrite en dur nulle part (verifie par
     ;; recensement : zero `the-as game-option-type`, zero litteral), la renumerotation est donc
     ;; sans consequence, comme pour `follow-probe` le 2026-09-10.
     ;; Grecharged-hd-models5: per-character HD LOOK carousells, each mirroring the carousell pattern.
     ;; hd-look-jak = Original/HD/Jak II/Jak 3; hd-look-daxter = Original/HD/Pants;
     ;; hd-look-keira = Original/HD/Jak 3; hd-look-samos = Original/HD/Young.
     (hd-look-jak)
     (hd-look-daxter)
     (hd-look-keira)
     (hd-look-samos)
     ;; Grecharged-secondary-motion: PHYSICS DETAIL carousell (Light/Full/Maximum), mirroring
     ;; le meme motif de carrousel. The PHYSICS on/off row itself needs no new type — it reuses the generic
     ;; on-off type, exactly like the ENHANCED MODELS toggle it sits next to.
     (physics-quality)
     ;; Grecharged-menu-overhaul: a NON-SELECTABLE group-header row. Focus (up/down + initial entry)
     ;; skips it; it draws in a distinct header color with no value and no selection cursor. Used to
     ;; visually separate the internal groups of the unified OPTIONS category pages (Ecran / Performance /
     ;; HUD in AFFICHAGE; General / Materiaux / Eclairage / Vegetation in RENDU; etc.).
     (group-header)
     ;; Ggrass-density-presets (owner 2026-08-30): GRASS DENSITY carousell (Very Low / Low / Medium /
     ;; High / Very High = 0..4 pre-baked density presets), mirroring shadow-quality (same five labels).
     ;; APPENDED AT THE VERY END of the enumeration so not one existing value is renumbered.
     (grass-density)
     ;; recharged-gating-real essai 2 : UNE rangee de la page de choix generique ci-dessus
     ;; (`progress-screen option-choice`). Elle ne porte aucun reglage : `param1` porte l'INDICE de
     ;; la valeur dans le carrousel de l'option parente, `name-override` le libelle de cette valeur.
     ;; La confirmation d'une telle rangee ecrit l'indice via `rch-choice-apply!`, l'ecrivain UNIQUE.
     ;; APPENDUE TOUT A LA FIN de l'enumeration : pas une valeur existante n'est renumerotee.
     (choice-value)
     ;; res-scale-submenu : UNE entree du sous-menu d'echelle de rendu ci-dessus. `param1` porte
     ;; le POURCENTAGE (10..100) ; `name-override` porte le libelle complet, pourcentage et
     ;; taille rendue calculee par `render-scale-size` (pckernel-common.gc), seul ecrivain de la
     ;; regle que le moteur applique au FBO 3D. APPENDUE TOUT A LA FIN : pas une valeur
     ;; existante n'est renumerotee.
     (render-scale-pct))) ;; end of PC_PORT = #t branch for enum initialization
  ) ;; end of PC_PORT cond

(defenum game-option-menu
  :type int32
  :copy-entries progress-screen)

(defun-extern activate-progress process progress-screen none)

(defun-extern hide-progress-screen none)

(defun-extern hide-progress-icons none)

(defun-extern progress-allowed? symbol)

(defun-extern pause-allowed? symbol)

;; DECOMP BEGINS

(deftype count-info (structure)
  ((money-count  int32)
   (buzzer-count int32))
  :pack-me)

(deftype game-count-info (basic)
  ((length int32)
   (data   count-info :inline :dynamic)))

(deftype task-info-data (basic)
  ((task-id                  game-task)
   (task-name                text-id 4)
   (text-index-when-resolved int32)))

(deftype level-tasks-info (basic)
  ((level-name-id     text-id)
   (text-group-index  int32)
   (nb-of-tasks       int32)
   (buzzer-task-index int32)
   (task-info         task-info-data 8)))

(deftype game-option (basic)
  ((option-type          game-option-type)
   (name                 text-id)
   (scale                symbol)
   (param1               float)
   (param2               float)
   (param3               game-option-menu)
   (value-to-modify      pointer)
   ;; fields below added in pc port
   (option-disabled-func (function symbol))
   (name-override        string)
   (on-change            (function object none))
   (on-confirm           (function none))
   (slider-step-size     float)
   (slider-show-decimal? symbol)
   (bind-info            bind-assignment-info :inline)
   ;; Grecharged-menu-overhaul: per-row help text shown on the single hint line at the bottom of the
   ;; menu when this row is focused (0 = no hint). A group-header row may also carry a hint describing
   ;; its group. text-id so it follows the selected text language (all 6 game languages).
   (hint                 text-id)
   ;; recharged-gating-real : l'identifiant de l'option Recharged que cette rangee pilote, tel que
   ;; la table de `game/system/recharged_gating.cpp` le nomme ("pbr", "ao-mode", "hdr-output"...).
   ;; 0 pour toute rangee qui n'est pas une option Recharged.
   ;;
   ;; POURQUOI CE CHAMP EXISTE. La dependance entre options etait ecrite DEUX FOIS : ici sous forme
   ;; de lambdas `option-disabled-func`, et en C++ sous forme d'appels aux composeurs de gfx.h. Deux
   ;; ecritures d'une meme regle divergent, et elles avaient diverge — l'owner (2026-09-10) voyait
   ;; des rangees grisees dont la feature continuait de tourner. Avec ce champ, le grisage DEMANDE
   ;; au C++ (`__pc-gating-disabled?`) : le gris que le joueur voit et la porte que le moteur
   ;; applique sont la meme relation, par construction.
   ;;
   ;; Il est pose a l'execution dans `init-game-options`, a cote de `value-to-modify` et
   ;; `name-override`, et JAMAIS dans le tableau statique : c'est le seul endroit ou l'on sait
   ;; quel index porte quelle option apres les gates de build et le collapse HD. Une rangee dont
   ;; le cablage derive perd donc son identifiant en meme temps que sa valeur, au lieu de garder
   ;; un identifiant juste sur une valeur fausse.
   (gating-id            string)))

(deftype progress (process)
  ((current-debug-string         int32)
   (current-debug-language       int32)
   (current-debug-group          int32)
   (in-out-position              int32)
   (display-state                progress-screen)
   (next-display-state           progress-screen)
   (option-index                 int32)
   (selected-option              basic)
   (completion-percentage        float)
   (ready-to-run                 basic)
   (display-level-index          int32)
   (next-level-index             int32)
   (task-index                   int32)
   (in-transition                basic)
   (last-in-transition           basic)
   (force-transition             basic)
   (stat-transition              basic)
   (level-transition             int32)
   (language-selection           language-enum)
   (language-direction           symbol)
   (language-transition          basic)
   (language-x-offset            int32)
   (sides-x-scale                float)
   (sides-y-scale                float)
   (left-x-offset                int32)
   (right-x-offset               int32)
   (button-scale                 float)
   (slot-scale                   float)
   (left-side-x-scale            float)
   (left-side-y-scale            float)
   (right-side-x-scale           float)
   (right-side-y-scale           float)
   (small-orb-y-offset           int32)
   (big-orb-y-offset             int32)
   (transition-offset            int32)
   (transition-offset-invert     int32)
   (transition-percentage        float)
   (transition-percentage-invert float)
   (transition-speed             float)
   (total-nb-of-power-cells      int32)
   (total-nb-of-orbs             int32)
   (total-nb-of-buzzers          int32)
   (card-info                    mc-slot-info)
   (last-option-index-change     time-frame)
   (video-mode-timeout           time-frame)
   (display-state-stack          progress-screen 5)
   (option-index-stack           int32 5)
   (display-state-pos            int32)
   (nb-of-icons                  int32)
   (icons                        hud-icon 6)
   (max-nb-of-particles          int32)
   (nb-of-particles              int32)
   (particles                    hud-particle 40)
   (particle-state               int32 40))
  (:methods
   (progress-method-14 (_type_) none)
   (progress-method-15 (_type_) none)
   (progress-method-16 (_type_) none)
   (draw-progress (_type_) none)
   (progress-method-18 () none)
   (visible? (_type_) symbol)
   (hidden? (_type_) symbol)
   (adjust-sprites (_type_) none)
   (adjust-icons (_type_) none)
   (adjust-ratios (_type_ symbol symbol) none)
   (draw-fuel-cell-screen (_type_ int) none)
   (draw-money-screen (_type_ int) none)
   (draw-buzzer-screen (_type_ int) none)
   (draw-notice-screen (_type_) none)
   (draw-options (_type_ int int float) none)
   (respond-common (_type_) none)
   (respond-progress (_type_) none)
   (respond-memcard (_type_) none)
   (can-go-back? (_type_) symbol)
   (initialize-icons (_type_) none)
   (initialize-particles (_type_) none)
   (draw-memcard-storage-error (_type_ font-context) none)
   (draw-memcard-data-exists (_type_ font-context) none)
   (draw-memcard-no-data (_type_ font-context) none)
   (draw-memcard-accessing (_type_ font-context) none)
   (draw-memcard-insert (_type_ font-context) none)
   (draw-memcard-file-select (_type_ font-context) none)
   (draw-memcard-auto-save-error (_type_ font-context) none)
   (draw-memcard-removed (_type_ font-context) none)
   (draw-memcard-error (_type_ font-context) none)
   (progress-method-44 (_type_) none)
   (push! (_type_) none)
   (pop! (_type_) none)
   (progress-method-47 (_type_) none)
   (enter! (_type_ progress-screen int) none)
   (draw-memcard-format (_type_ font-context) none)
   (draw-auto-save (_type_ font-context) none)
   (set-transition-progress! (_type_ int) none)
   (set-transition-speed! (_type_) none)
   (set-memcard-screen (_type_ progress-screen) progress-screen)
   (draw-pal-change-to-60hz (_type_ font-context) none)
   (draw-pal-now-60hz (_type_ font-context) none)
   (draw-no-disc (_type_ font-context) none)
   (draw-bad-disc (_type_ font-context) none)
   (draw-quit (_type_ font-context) none))
  (:states
   progress-coming-in
   progress-debug
   progress-going-out
   progress-gone
   progress-normal
   progress-waiting))

(define *progress-process* (the-as (pointer progress) #f))

(define *progress-last-task-index* 0)

(defun-extern get-game-count int count-info)

(define-extern *level-task-data* (array level-tasks-info))

(define-extern *level-task-data-remap* (array int32))

(defun-extern deactivate-progress none)

(defun-extern calculate-completion progress float)

(defun-extern make-current-level-available-to-progress none)
