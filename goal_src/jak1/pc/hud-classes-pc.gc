;; the defpartgroup macro does NOT define a name->group constant (that lives in
;; the generated engine/data/part-groups.gc for stock groups); define ours here
;; so create-launch-control can reference them by name like the stock hud does.
(defconstant group-hud-eco-green (-> *part-group-id-table* 720))
(defconstant group-hud-eco-blue (-> *part-group-id-table* 721))
(defconstant group-hud-eco-red (-> *part-group-id-table* 722))
(defconstant group-hud-eco-yellow (-> *part-group-id-table* 723))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; LA LUEUR DE LA PILE (id 724) — LES LANCEURS DU JEU, PAS DES COPIES A NOUS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; Owner, 18/09 : « une pile d'energie in game a un effet lumineux, la notre dans le HUD ne l'a
;;;; pas ». Dans le MONDE, cet effet est `group-fuel-cell-starburst` (id 63,
;;;; collectables-part.gc:1751) : deux etoiles contra-rotatives — 230 doree (192/192/0) a -0,4
;;;; degre par image, 231 blanche (128/128/128) a +0,3 — et deux nuees de flares scintillants
;;;; (228, 229) de couleur tiree au sort.
;;;;
;;;; LE JEU PORTE DEJA SA TRANSPOSITION EN ESPACE-ECRAN, ET ELLE EST DE NAUGHTY DOG, PAS DE NOUS.
;;;; `group-part-hud-power-cell-whole` (id 80, hud-classes.gc:754) contient 319<-228, 320<-229,
;;;; 321<-230, 322<-231, avec les deux callbacks qui vont prendre la TAILLE sur l'element pile
;;;; lui-meme (`scale-starburst-3/4-*`, poses par `set-pos-and-scale` SEPAREMENT pour 16:9 et pour
;;;; 4:3) : c'est ce qui rend la lueur juste dans les deux aspects sans un seul pixel absolu.
;;;;
;;;; POURQUOI ELLE AVAIT DISPARU. Notre couche eteint le groupe 80 EN ENTIER (`skip-particle` = 0)
;;;; pour faire disparaitre l'icone PLATE que le modele remplace (part 318, livrable §2) — et
;;;; `skip-particle` ne sait designer qu'un groupe entier. La lueur est partie avec l'icone plate.
;;;; C'est exactement ce que l'owner voit sur sa photo du 18/09.
;;;;
;;;; CE GROUPE REPREND DONC LES QUATRE MEMES LANCEURS, PAR LEUR NUMERO : on ne recopie aucune
;;;; valeur, donc rien ne peut deriver. `hud3d_glow_from_stock` verifie a l'execution que nos
;;;; quatre items sont bien ceux du groupe 80, et `hud3d_glow_world_mismatch` compare champ par
;;;; champ ces lanceurs a ceux de la pile DU MONDE (228..231), aux transpositions G1..G6 pres.
;;;;
;;;; CE QUI N'Y EST PAS, ET POURQUOI : la part 318 — l'icone PLATE, celle que le modele remplace —
;;;; et les cinq satellites 313-317, qui lisent les jointures 4..7 et 9 du modele NU d'origine
;;;; (`fuel-cell-hud-orbit-callback`, hud-classes.gc:906), un modele que notre couche ne dessine
;;;; plus et que la pile du monde n'a pas.
(defpartgroup group-hud-cell-glow
  :id 724
  :flags (use-local-clock screen-space)
  :bounds (static-bspherem 0 0 0 100)
  :parts
  ((sp-item 319 :fade-after (meters 35))
   (sp-item 320 :fade-after (meters 20))
   (sp-item 321 :flags (launch-asap) :period (seconds 12) :length (seconds 0.017))
   (sp-item 322 :flags (launch-asap) :period (seconds 12) :length (seconds 0.017))))
(defconstant group-hud-cell-glow (-> *part-group-id-table* 724))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; hud processes and parts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; a pc hud element
(deftype hud-pc (hud) ())

;; hud element for battles
(deftype hud-battle-enemy (hud)
  ((want-skel     symbol)
   (want-skel2    symbol)
   (last-battle   handle)
   (battle-entity entity-actor)
   (battle-max    int32)
   (battle-alive  int32)
   (battle-mode   symbol)
   (last-task     entity-actor)
   (task-entity   entity-actor)
   (task-track    int32)
   (task2-entity  entity-actor)
   (task2-time    time-frame)
   (task2-track   int32)
   (last-level    symbol)
   (ready?        symbol)
   (kicked        symbol)
   (display-mode? symbol))
  (:methods
   (make-enemy-icon (_type_ int symbol entity) int)
   (kill-icon (_type_ int) int)
   (kill-all-icons (_type_) int)
   (update-display-status (_type_ symbol entity int symbol) int)))

;; all pc hud elements
(deftype hud-parts-pc (structure)
  ((battle-enemy     (pointer hud-battle-enemy))
   (recharged-health (pointer hud-pc))
   (recharged-power  (pointer hud-pc))
   (pickups-3d       (pointer hud-pc))
   (parts            (pointer hud-pc) HUD_PART_PC_AMOUNT :offset 0)))

;;;----------------------------------------------
;;  globals
;;;----------------------------------------------

;; all of the pc hud elements
(define *hud-parts-pc* (new 'static 'hud-parts-pc :battle-enemy #f :recharged-health #f :recharged-power #f :pickups-3d #f))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  hud macros
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmacro hud-pc-make-icon (obj max &key skel &key x &key y &key z &key scale-x &key scale-y &key (entity #f))
  `(when (< (-> ,obj nb-of-icons) ,max)
    (let ((icon-idx (-> ,obj nb-of-icons)))
      (set! (-> ,obj icons icon-idx) (new 'static 'hud-icon))
      (let ((new-manipy (manipy-spawn (new 'static 'vector :w 1.0) ,entity ,skel #f :to ,obj)))
        (when new-manipy
          (set! (-> (-> new-manipy) draw dma-add-func) dma-add-process-drawable-hud-with-hud-lights)
          (set-vector! (-> (-> new-manipy) root trans) 0.0 0.0 0.0 1.0)
          (set-vector! (-> (-> new-manipy) root scale) ,scale-x ,scale-y ,scale-x 1.0)
          (when #f
            (send-event (ppointer->process new-manipy) 'trans-hook #f)))
        (set! (-> ,obj icons icon-idx icon) new-manipy)
        (when new-manipy
          (logior! (-> new-manipy 0 mask) (process-mask pause))
          (logclear! (-> new-manipy 0 mask) (process-mask menu progress))
          (set! (-> (-> new-manipy) root trans z) ,z)
          (set! (-> ,obj icons icon-idx icon-x) ,x)
          (set! (-> ,obj icons icon-idx icon-y) ,y)
          (set! (-> ,obj icons icon-idx icon-z) 0)
          (set! (-> ,obj icons icon-idx scale-x) ,scale-x)
          (set! (-> ,obj icons icon-idx scale-y) ,scale-y))))
    (+! (-> ,obj nb-of-icons) 1)))

(defmacro hud-pc-replace-icon (obj idx &key skel &key z &key (entity #f))
  `(let ((new-manipy (manipy-spawn (new 'static 'vector :w 1.0) ,entity ,skel #f :to ,obj)))
    (when new-manipy
      (set! (-> (-> new-manipy) draw dma-add-func) dma-add-process-drawable-hud-with-hud-lights)
      (set-vector! (-> (-> new-manipy) root trans) 0.0 0.0 0.0 1.0)
      (set-vector! (-> (-> new-manipy) root scale)
                   (-> ,obj icons ,idx scale-x)
                   (-> ,obj icons ,idx scale-y)
                   (-> ,obj icons ,idx scale-x)
                   1.0)
      (when #f
        (send-event (ppointer->process new-manipy) 'trans-hook #f)))
    (set! (-> ,obj icons ,idx icon) new-manipy)
    (when new-manipy
      (logior! (-> new-manipy 0 mask) (process-mask pause))
      (logclear! (-> new-manipy 0 mask) (process-mask menu progress))
      (set! (-> (-> new-manipy) root trans z) ,z))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  hud rendering with level lights
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *hud-pc-lights* (new 'global 'vu-lights))

(set-vector! (-> *hud-pc-lights* direction 0) 1.0 0.0 0.0 1.0)

(set-vector! (-> *hud-pc-lights* direction 1) 0.0 1.0 0.0 1.0)

(set-vector! (-> *hud-pc-lights* direction 2) 0.0 0.0 1.0 1.0)

(set-vector! (-> *hud-pc-lights* color 0) 0.75 0.75 1.0 1.0)

(set-vector! (-> *hud-pc-lights* color 1) 0.75 0.75 1.0 1.0)

(set-vector! (-> *hud-pc-lights* color 2) 0.75 0.75 1.0 1.0)

(set-vector! (-> *hud-pc-lights* ambient) 0.2 0.2 0.2 1.0)

(defun dma-add-process-drawable-hud-with-lights ((proc process-drawable) (draw draw-control) (arg2 symbol) (buf dma-buffer))
  (logclear! (-> draw status) (draw-status was-drawn))
  (when (zero? (logand (-> draw status) (draw-status hidden no-anim no-skeleton-update)))
    (let ((vu-lgt (the-as vu-lights (+ 64 (scratchpad-object int))))
          (lgt (if (= (-> draw level-index) 2)
                 (-> *time-of-day-context* light-group (-> draw light-index))
                 (-> *time-of-day-context* moods (-> draw level-index) light-group (-> draw light-index)))))
      (vu-lights<-light-group! vu-lgt lgt))
    (lod-set! draw 0)
    (logior! (-> draw status) (draw-status was-drawn))
    (draw-bones-hud draw buf))
  0
  (none))

;; owner addendum: fixed WARM lights for the hud fuel-cell icon — the daylight
;; in-world cell look, platform-deterministic. (the first device round used the
;; time-of-day mood lookup like the world path; it looked right on x86 but the
;; device rendered the hud manipy nearly black — a fixed warm rig matches the
;; owner's reference, a sunlit world cell, on every platform.)
(define *rhud-cell-lights* (new 'global 'vu-lights))

(set-vector! (-> *rhud-cell-lights* direction 0) 1.0 0.0 0.0 1.0)

(set-vector! (-> *rhud-cell-lights* direction 1) 0.0 1.0 0.0 1.0)

(set-vector! (-> *rhud-cell-lights* direction 2) 0.0 0.0 1.0 1.0)

(set-vector! (-> *rhud-cell-lights* color 0) 0.55 0.45 0.3 1.0)

(set-vector! (-> *rhud-cell-lights* color 1) 1.0 0.9 0.7 1.0)

(set-vector! (-> *rhud-cell-lights* color 2) 0.6 0.5 0.35 1.0)

(set-vector! (-> *rhud-cell-lights* ambient) 0.45 0.38 0.28 1.0)

(defun dma-add-process-drawable-hud-with-cell-lights ((proc process-drawable) (draw draw-control) (arg2 symbol) (buf dma-buffer))
  (logclear! (-> draw status) (draw-status was-drawn))
  (when (zero? (logand (-> draw status) (draw-status hidden no-anim no-skeleton-update)))
    (let ((vu-lgt (the-as vu-lights (+ 64 (scratchpad-object int))))
          (lgt *rhud-cell-lights*))
      (set! (-> vu-lgt direction 0 quad) (-> lgt direction 0 quad))
      (set! (-> vu-lgt direction 1 quad) (-> lgt direction 1 quad))
      (set! (-> vu-lgt direction 2 quad) (-> lgt direction 2 quad))
      (set! (-> vu-lgt color 0 quad) (-> lgt color 0 quad))
      (set! (-> vu-lgt color 1 quad) (-> lgt color 1 quad))
      (set! (-> vu-lgt color 2 quad) (-> lgt color 2 quad))
      (set! (-> vu-lgt ambient quad) (-> lgt ambient quad)))
    (lod-set! draw 0)
    (logior! (-> draw status) (draw-status was-drawn))
    (draw-bones-hud draw buf))
  0
  (none))

;; ROUND 4 (arm64 device fix): the REAL full *fuel-cell-sg* is a merc model with an
;; ENVMAP (shiny eco-crystal) effect. dma-add-process-drawable-hud-with-cell-lights
;; routes it through draw-bones-hud -> (envmap => use-mercneric 1) draw-bones-generic-merc,
;; the GENERIC/mercneric renderer — which drops the cell BODY on arm64 (only its separate
;; sparticle glow survived; the owner's "la pile n'apparaît pas mais son halo oui" across
;; rounds 2-4). This variant is identical EXCEPT it calls draw-bones-hud-merc, which sets
;; envmap effects to use-mercneric 0 and emits them through pc-merc-draw-request — the
;; robust PC-native fast-merc path the whole game uses on arm64 — while still reading the
;; warm *rhud-cell-lights* from the SAME scratchpad vu-lights slot (offset 64), so the
;; owner's tint is preserved. Buzzer/naked-cell stay on the generic path (they render).
(defun dma-add-process-drawable-hud-merc-with-cell-lights ((proc process-drawable) (draw draw-control) (arg2 symbol) (buf dma-buffer))
  (logclear! (-> draw status) (draw-status was-drawn))
  (when (zero? (logand (-> draw status) (draw-status hidden no-anim no-skeleton-update)))
    (let ((vu-lgt (the-as vu-lights (+ 64 (scratchpad-object int))))
          (lgt *rhud-cell-lights*))
      (set! (-> vu-lgt direction 0 quad) (-> lgt direction 0 quad))
      (set! (-> vu-lgt direction 1 quad) (-> lgt direction 1 quad))
      (set! (-> vu-lgt direction 2 quad) (-> lgt direction 2 quad))
      (set! (-> vu-lgt color 0 quad) (-> lgt color 0 quad))
      (set! (-> vu-lgt color 1 quad) (-> lgt color 1 quad))
      (set! (-> vu-lgt color 2 quad) (-> lgt color 2 quad))
      (set! (-> vu-lgt ambient quad) (-> lgt ambient quad)))
    (lod-set! draw 0)
    (logior! (-> draw status) (draw-status was-drawn))
    (draw-bones-hud-merc draw buf))
  0
  (none))

(defun dma-add-process-drawable-hud-with-hud-lights ((proc process-drawable) (draw draw-control) (arg2 symbol) (buf dma-buffer))
  (logclear! (-> draw status) (draw-status was-drawn))
  (when (zero? (logand (-> draw status) (draw-status hidden no-anim no-skeleton-update)))
    (let ((vu-lgt (the-as vu-lights (+ 64 (scratchpad-object int))))
          (lgt *hud-pc-lights*))
      (set! (-> vu-lgt direction 0 quad) (-> lgt direction 0 quad))
      (set! (-> vu-lgt direction 1 quad) (-> lgt direction 1 quad))
      (set! (-> vu-lgt direction 2 quad) (-> lgt direction 2 quad))
      (set! (-> vu-lgt color 0 quad) (-> lgt color 0 quad))
      (set! (-> vu-lgt color 1 quad) (-> lgt color 1 quad))
      (set! (-> vu-lgt color 2 quad) (-> lgt color 2 quad))
      (set! (-> vu-lgt ambient quad) (-> lgt ambient quad)))
    (lod-set! draw 0)
    (logior! (-> draw status) (draw-status was-drawn))
    (draw-bones-hud draw buf))
  0
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  hud methods
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmethod deactivate ((obj hud-pc))
  (dotimes (i HUD_PART_PC_AMOUNT)
    (if (and (-> *hud-parts-pc* parts i) (= (ppointer->process (-> *hud-parts-pc* parts i)) obj))
      (set! (-> *hud-parts-pc* parts i) (the (pointer hud-pc) #f))))
  ((method-of-type hud deactivate) obj)
  (none))

(defmethod kill-icon ((obj hud-battle-enemy) (idx int))
  "kill a hud icon"
  (when (and (nonzero? (-> obj icons idx)) (nonzero? (-> obj icons idx icon)) (-> obj icons idx icon))
    (deactivate (ppointer->process (-> obj icons idx icon)))
    (set! (-> obj icons idx icon) #f))
  0)

(defmethod kill-all-icons ((obj hud-battle-enemy))
  "kill all hud icons"
  (dotimes (i (-> obj nb-of-icons))
    (kill-icon obj i))
  0)

(defmethod make-enemy-icon ((obj hud-battle-enemy) (idx int) (skel-sym symbol) (enemy-ent entity))
  "make a new icon for the hud"
  ;; make new manipy
  (kill-icon obj 0)
  (hud-pc-replace-icon obj 0 :skel (-> skel-sym value) :entity enemy-ent :z (meters 0.5))
  0)

(defmethod update-display-status ((obj hud-battle-enemy) (skel symbol) (ent entity) (icon-idx int) (trigger-force symbol))
  "logic for displaying or hiding the hud, and drawing the icons."
  ;; do stuff depending on our current state
  (cond
    ((hidden? obj)
     ;; we're hidden, so let's make our new icons and see if we are allowed to show
     ;; if we have icons made then show!
     (when (-> obj ready?)
       (set! (-> obj kicked) #f)
       (send-event obj 'show))
     ;; no icons, make new ones but keep them hidden for now
     (when (and (not (-> obj ready?)) skel (not *progress-process*))
       (case skel
         (('*swamp-rat-sg* '*citb-bunny-sg*)
          (set! (-> obj icons icon-idx icon-x) (the int (* 0.84 512)))
          (set! (-> obj icons icon-idx icon-y) (the int (* 0.51 448)))
          (set! (-> obj icons icon-idx scale-x) 0.006))
         (('*gnawer-sg*)
          (set! (-> obj icons icon-idx icon-x) (the int (* 0.78 512)))
          (set! (-> obj icons icon-idx icon-y) (the int (* 0.54 448)))
          (set! (-> obj icons icon-idx scale-x) 0.003))
         (('*flying-lurker-sg*)
          (set! (-> obj icons icon-idx icon-x) (the int (* 0.80 512)))
          (set! (-> obj icons icon-idx icon-y) (the int (* 0.40 448)))
          (set! (-> obj icons icon-idx scale-x) 0.003))
         (else
          (set! (-> obj icons icon-idx icon-x) (the int (* 0.84 512)))
          (set! (-> obj icons icon-idx icon-y) (the int (* 0.51 448)))
          (set! (-> obj icons icon-idx scale-x) 0.004)))
       (set! (-> obj icons icon-idx scale-y) (* (-> obj icons icon-idx scale-x) (/ -512.0 448.0)))
       (make-enemy-icon obj icon-idx skel ent)
       (let ((icon0 (the manipy (ppointer->process (-> obj icons icon-idx icon)))))
         (case skel
           (('*babak-sg*)
            (send-event icon0 'art-joint-anim "babak-idle" 0)
            (send-event icon0 'rot-quat (quaternion-axis-angle! (new-stack-quaternion0) 0.0 1.0 0.15 (degrees 210))))
           (('*citb-bunny-sg*)
            (send-event icon0 'art-joint-anim "citb-bunny-idle" 0)
            (send-event icon0 'rot-quat (quaternion-axis-angle! (new-stack-quaternion0) 0.0 1.0 0.15 (degrees 210))))
           (('*bonelurker-sg*)
            (send-event icon0 'art-joint-anim "bonelurker-idle" 0)
            (send-event icon0 'rot-quat (quaternion-axis-angle! (new-stack-quaternion0) 0.0 1.0 0.15 (degrees 210))))
           (('*swamp-rat-sg*)
            (send-event icon0 'art-joint-anim "swamp-rat-celebrate" 0)
            (send-event icon0 'rot-quat (quaternion-axis-angle! (new-stack-quaternion0) 0.0 1.0 0.15 (degrees 210))))
           (('*gnawer-sg*)
            (send-event icon0 'art-joint-anim "gnawer-idle" 0)
            (send-event icon0 'rot-quat (quaternion-axis-angle! (new-stack-quaternion0) 0.0 1.0 0.15 (degrees 210))))
           (('*flying-lurker-sg*)
            (send-event icon0 'art-joint-anim "flying-lurker-fly" 0)
            (send-event icon0 'rot-quat (quaternion-axis-angle! (new-stack-quaternion0) 0.0 1.0 0.15 (degrees 210)))))
         (send-event icon0 'draw #f))
       (true! (-> obj ready?))))
    (else
     ;; we want to be shown!
     (false! (-> obj ready?))
     ;; progress is open, let's leave.
     (when (and (not (-> obj kicked)) (= *master-mode* 'progress))
       (true! (-> obj kicked))
       (send-event obj 'hide-quick))
     ;; set the trigger time so we don't automatically go away
     (if (and trigger-force (!= (-> obj next-state name) 'hud-leaving)) (set! (-> obj trigger-time) (current-time)))))
  0)

(defmacro actor-by-name (name)
  "get an entity by name and cast it to an actor. not super safe!"
  `(the entity-actor (entity-by-name ,name)))

(defmacro actor-by-name-safe (name)
  "safe, slower version of actor-by-name"
  `(aif (entity-by-name ,name) (if (type-type? it entity-actor) (the entity-actor it))))

(defmethod hud-update ((obj hud-battle-enemy))
  "hud logic."
  (when (not (-> *pc-settings* extra-hud?))
    (kill-all-icons obj)
    (return #f))
  (when (and (not (-> obj ready?)) (hidden? obj))
    (kill-all-icons obj))
  (let ((battle (the process #f))
        (cur-lev (aif (level-get-target-inside *level*) (-> it name)))
        (actor-list-task? #f))
    ;; default params
    (set! (-> obj task-entity) #f)
    (set! (-> obj battle-entity) #f)
    (set! (-> obj battle-mode) 'remain)
    ;; find an entity for a battlecontroller, check current level
    (case cur-lev
      (('swamp)
       (set! (-> obj battle-entity) (actor-by-name "swamp-battlecontroller-1"))
       (set! (-> obj want-skel) '*swamp-rat-sg*))
      (('misty)
       (set! (-> obj battle-entity) (actor-by-name "misty-battlecontroller-1"))
       (set! (-> obj want-skel) '*bonelurker-sg*))
      (('citadel)
       (set! (-> obj battle-entity) (actor-by-name "citb-battlecontroller-1"))
       (set! (-> obj want-skel) '*citb-bunny-sg*)
       (set! (-> obj battle-mode) 'alive))
      (('maincave)
       (set! (-> obj task-entity)
             (the entity-actor
                  (or (actor-by-name "gnawer-11")
                      (actor-by-name "gnawer-12")
                      (actor-by-name "gnawer-13")
                      (actor-by-name "gnawer-14")
                      (actor-by-name "gnawer-15")
                      (actor-by-name "gnawer-16")
                      (actor-by-name "gnawer-17")
                      (actor-by-name "gnawer-18")
                      (actor-by-name "gnawer-19"))))
       (true! actor-list-task?)
       (set! (-> obj want-skel) '*gnawer-sg*))
      (('ogre)
       (when (= 'debug *cheat-mode*)
         (set! (-> obj battle-entity) (actor-by-name "flying-lurker-1"))
         (set! (-> obj want-skel) '*flying-lurker-sg*)
         (set! (-> obj battle-mode) 'alive))))
    ;; have an entity, grab its process
    (if (-> obj battle-entity) (set! battle (-> obj battle-entity extra process)))
    (cond
      ;; check level statuses FIRST
      ((not (aif (level-get *level* (-> obj last-level)) (-> it display?)))
       ;; the old level died. kill everything.
       (unless (hidden? obj)
         (set! (-> obj last-battle) INVALID_HANDLE)
         (set! (-> obj last-task) #f)
         (false! (-> obj ready?))
         (kill-all-icons obj)
         (go hud-hidden)))
      ;; check if we have anything
      ((-> obj task-entity)
       ;; we have a task to track.
       ;; see if we've changed tracking now
       (when (or (!= (-> obj display-mode?) 'task) (!= (-> obj task-entity) (-> obj last-task)))
         (set! (-> obj last-task) (-> obj task-entity))
         (set! (-> obj display-mode?) 'task)
         (false! (-> obj ready?))
         (send-event obj 'hide))
       ;; logic for each kind of task
       (cond
         (actor-list-task?
          ;; simple: check a list of actors and count how many have completed their task.
          (set! (-> obj battle-max) 0)
          (set! (-> obj value) 0)
          (let ((actor (-> obj task-entity)))
            ;; get the first actor
            (while (prev-actor actor)
              (set! actor (prev-actor actor)))
            ;; now count forwards.
            (while actor
              ;; stuff.
              (1+! (-> obj battle-max))
              (when (logtest? (-> actor extra perm status) (entity-perm-status complete))
                (1+! (-> obj value)))
              (set! actor (next-actor actor))))
          (when (and (!= (-> obj value) (-> obj battle-max))
                     (or (> (-> obj value) 0) (task-closed? (-> obj task-entity task) (task-status need-hint))))
            (update-display-status obj (-> obj want-skel) (-> obj task-entity) 0 #t)))))
      (battle
       ;; if its a different process, panic and restart the whole sequence. it's OK
       (when (or (!= (-> obj display-mode?) 'battle) (!= (handle->process (-> obj last-battle)) battle))
         (set! (-> obj last-battle) (process->handle battle))
         (set! (-> obj display-mode?) 'battle)
         (false! (-> obj ready?))
         (send-event obj 'hide))
       ;; logic for each kind of process.
       (cond
         ((type-type? (-> battle type) battlecontroller)
          (let ((battle (the battlecontroller battle)))
            ;; wait until battle is active
            (when (= 'battlecontroller-active (-> battle next-state name))
              ;; get battle stats
              (let ((alive-count 0))
                (with-children (child battle) (1+! alive-count))
                (set! (-> obj value) (- (-> battle spawn-count) alive-count))
                (set! (-> obj battle-max) (-> battle max-spawn-count))
                (set! (-> obj battle-alive) alive-count))
              (update-display-status obj (-> obj want-skel) (-> obj battle-entity) 0 #t))))
         ((and (= 'debug *cheat-mode*) (= (-> obj battle-entity) (actor-by-name "flying-lurker-1")))
          (let ((battle (the process-drawable battle)))
            (if *target*
              (set! (-> obj battle-alive) (the int (/ (vector-vector-distance (-> battle root trans) (target-pos 0)) METER_LENGTH))))
            (update-display-status obj (-> obj want-skel) (-> obj battle-entity) 0 #t)))))
      (else
       ;; we have nothing. kill everything.
       (unless (and (= (-> obj last-battle) INVALID_HANDLE) (hidden? obj))
         (set! (-> obj last-battle) INVALID_HANDLE)
         (set! (-> obj last-task) #f)
         (false! (-> obj ready?))
         (cond
           ((and (!= (-> obj next-state name) 'hud-leaving) (aif (level-get *level* (-> obj last-level)) (-> it display?)))
            (send-event obj 'hide))
           (else (kill-all-icons obj) (go hud-hidden))))))
    ;; save the current level
    (set! (-> obj last-level) cur-lev))
  0
  (none))

(defmethod draw-hud ((obj hud-battle-enemy))
  (let ((t9-0 (method-of-type hud draw-hud))) (t9-0 obj))
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug))
    (let ((str-x (+ (-> obj text-x) (* (-> obj x-sgn) (-> obj offset))))
          (str-y (/ (* (+ (-> obj text-y) (* (-> obj y-sgn) (-> obj offset)) (-> obj y-offset))
                       (the int (-> *video-parms* relative-y-scale)))
                    2)))
      (case (-> obj battle-mode)
        (('dead)
         (draw-string-xy (string-format "~D/~D" (-> obj value) (-> obj battle-max))
                         buf
                         str-x
                         str-y
                         (font-color white)
                         (font-flags shadow kerning large middle)))
        (('alive)
         (draw-string-xy (string-format "~D" (-> obj battle-alive))
                         buf
                         str-x
                         str-y
                         (font-color white)
                         (font-flags shadow kerning large middle)))
        (('remain)
         (draw-string-xy (string-format "~D" (- (-> obj battle-max) (-> obj value)))
                         buf
                         str-x
                         str-y
                         (font-color white)
                         (font-flags shadow kerning large middle))))))
  0
  (none))

(defmethod init-particles! ((obj hud-battle-enemy) (arg0 int))
  (hud-pc-make-icon obj
                    HUD_ICON_COUNT
                    :skel
                    *fuelcell-naked-sg*
                    :x
                    (the int (* 0.84 512))
                    :y
                    (the int (* 0.51 448))
                    :z (meters 0.5)
                    :scale-x 0.004
                    :scale-y
                    (* -0.004 (/ 512.0 448.0)))
  (set! (-> obj text-x) (the int (* 0.84 512)))
  (set! (-> obj text-y) (the int (* 0.5 448)))
  (set! (-> obj x-sgn) 1)
  (set! (-> obj y-sgn) 0)
  (set! (-> obj increment-on-event) #t)
  (set-pos-and-scale obj (= (get-aspect-ratio) 'aspect16x9) (= (get-video-mode) 'pal))
  (set! (-> obj last-battle) INVALID_HANDLE)
  (set! (-> obj last-task) #f)
  (set! (-> obj want-skel) #f)
  (set! (-> obj battle-max) 0)
  (set! (-> obj last-level) #f)
  (set! (-> obj kicked) #f)
  (set! (-> obj ready?) #f)
  0
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  recharged hud (gated on (-> *pc-settings* recharged-hud?))
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The "Recharged" hud replaces the stock sparticle heart/eco-gauge with new
;; high-res sprites drawn as textured quads through the direct renderer
;; (debug bucket), and upgrades the fuel-cell/scout-fly hud icons to the real
;; in-world 3d models. Everything is driven at runtime by the persisted
;; recharged-hud? toggle; when it is OFF nothing below runs and the stock hud
;; is untouched.

;; Grecharged-buildsys-flags: le COEUR recharge (SPEC HUD §3, chantier `hud-heart`) reste derriere
;; --recharged-hud. La JAUGE, elle, en est sortie juste en dessous.
(#when FLAG_RECHARGED_HUD
;; replacement for the stock hud-health (the 3-pip heart)
(deftype hud-recharged-health (hud-pc)
  ((active-flag symbol) ;; last-seen state of the toggle, for transition handling
   (cell-proc   process) ;; hud-fuel-cell process whose icon we upgraded
   (buzz-proc   process) ;; hud-buzzers process we added the 3d icon to
   )))

;; hud-eco-gauge : LA JAUGE VIT DANS LE BINAIRE LIVRE, HORS DE FLAG_RECHARGED_HUD.
;; `recharged-flags.gc` porte `FLAG_RECHARGED_HUD #f` dans l'arbre suivi depuis le 02/09, et
;; `.autoport/lib/build_x86.sh` / `build_arm64.sh` relancent ninja sur l'arbre deja configure sans
;; jamais repasser par `build.sh --recharged-hud` : tout ce chantier etait donc ABSENT des CGO
;; livres, sur les deux cibles. Aucune correction de la jauge n'aurait pu se voir chez l'owner.
;; C'est la meme cause que la ronde 4 de `hud-3d-pickups`, qui a ete sorti du drapeau pour ca.
;; L'extinction reste a l'EXECUTION : maitre Recharged + reglage HUD (SPEC HUD §1.2).
;; replacement for the stock hud-power (the eco gauge)
(deftype hud-recharged-power (hud-pc)
  ((last-eco-idx int32) ;; which per-type gauge-centre launcher spawned last frame (-1 = none yet)
   ;; --- instrument de preuve (hud-eco-gauge). Inerte hors `debug.opengoal.costprobe`. ---
   (probe?       symbol)   ;; le harnais mesure CET item
   (stock-off    symbol)   ;; la jauge d'origine est actuellement supprimee par nous
   (bench-n      int32)    ;; images ecoulees dans le bloc courant du banc
   (bench-phase  int32)    ;; 0 bleu, 1 rouge, 2 jaune, 3 vide, 4 eteint, 5 controle
   (bench-cycle  int32)    ;; nombre de tours complets du banc
   (draws        int32)    ;; images ou la jauge rechargee a ete DESSINEE
   (off-frames   int32)    ;; images jugees HUD rechargé ETEINT
   (off-draws    int32)    ;; dessins observes pendant ces images-la (doit rester 0)
   (off-stock-ko int32)    ;; images eteintes ou la jauge d'origine n'etait PAS rendue
   (t1-n         int32)    ;; images ou l'angle a pu etre mesure
   (t1-bad       int32)    ;;   ... dont l'ecart depasse le seuil
   (t1-max       int32)    ;; pire ecart d'angle observe, en milli-degres
   (t2-n         int32)
   (t2-bad       int32)
   (t2-max       int32)    ;; pire ecart d'embout, en milli-degres
   (t2-ghost     int32)    ;; embout dessine alors que la fraction est nulle
   (t3-n         int32)
   (t3-bad       int32)
   (t4-n         int32)
   (t4-bad       int32)
   (t4-max       int32)    ;; pire ecart de fraction contre la jauge d'origine, en 1/100000
   (t4-hi        int32)    ;; plus haute fraction observee, en 1/100000
   (t4-lo        int32)    ;; plus basse fraction observee, en 1/100000
   (t4-stale     int32)    ;; images ecartees parce que l'oracle d'origine n'avait pas tourne
   (t4-lag       int32 6)  ;; combien d'images separent notre mesure du dernier passage de l'oracle
   (t4-lagmax    int32)
   (drain-t0     int32)    ;; game-frame-counter de la derniere image a 100 %
   (drain-ticks  int32)    ;; duree du dernier vidage complet, en unites de game-frame-counter
   (drain-n      int32)    ;; vidages complets chronometres
   (drain-bad    int32)
   (t5-n         int32)
   (t5-bad       int32)
   (t5-self      int32)    ;; sous-terme : les trois primitives ne partagent pas un centre
   (t5-stock     int32)    ;; sous-terme : notre centre n'est pas celui de la jauge d'origine
   (t5-max       int32)    ;; pire ecart de position, en 1/16 d'unite de canevas 512x448
   (quant-mdeg   int32)    ;; plancher angulaire de l'instrument (quantification 12.4)
   (last-frac    int32)    ;; fraction de l'image precedente, en 1/100000
   (last-stockv  int32)    ;; `value` de la jauge d'origine a l'image precedente
   (seeded       int32)    ;; ramassages scriptes deja declenches
   ))

;;;----------------------------------------------
;;  direct-renderer draw helpers
;;;----------------------------------------------

;;;----------------------------------------------
;;  hud-eco-gauge — L'INSTRUMENT LIT LES SOMMETS REELLEMENT EMIS
;;;----------------------------------------------
;; La porte de cet item ne peut pas lire une image (DIRECTIVES, regle 2) et elle ne doit pas se
;; contenter de relire les variables qui ont servi a dessiner — ce serait un miroir, pas une
;; mesure. Elle lit donc ce que le code a ECRIT dans le buffer DMA : les entiers 12.4 de xyzf2 et
;; les coordonnees de texture, relus depuis la memoire apres l'ecriture. Le meme motif est deja
;; utilise comme instrument dans `pc/cutscene-skip-draw.gc` (`cs-scan-quads!`) et `pc/subtitle.gc`.
;;
;; Les angles se lisent sur les UV, pas sur les positions : `rhud-fan` pose l'UV d'un sommet de
;; jante a l'image affine de sa position DANS LE CANEVAS, donc l'angle du masque en espace de
;; texture est exactement ce que le joueur voit sur la jauge, sans passer par le facteur d'aspect.
(defconstant RHUD_GP_BASE 0)  ;; l'anneau vide
(defconstant RHUD_GP_FAN  1)  ;; le camembert de remplissage
(defconstant RHUD_GP_TIP  2)  ;; l'embout

(deftype rhud-gauge-probe (structure)
  ((tag  int32)       ;; primitive en cours d'emission ; -1 = ne rien enregistrer
   (n    int32 3)     ;; sommets emis
   (tbp  int32 3)     ;; le tbp REELLEMENT pose dans TEX0 pour cette primitive
   (u0   float 3) (v0 float 3) (x0 float 3) (y0 float 3)   ;; 1er sommet
   (u1   float 3) (v1 float 3) (x1 float 3) (y1 float 3)   ;; 2e sommet
   (ul   float 3) (vl float 3) (xl float 3) (yl float 3)   ;; dernier sommet
   (minx float 3) (maxx float 3) (miny float 3) (maxy float 3)))

(define *rhud-gauge-probe* (new 'static 'rhud-gauge-probe :tag -1))

(defun rhud-gauge-probe-reset ()
  "ouvre une image de mesure : aucune primitive enregistree, aucun enregistrement en cours."
  (let ((pr *rhud-gauge-probe*))
    (set! (-> pr tag) -1)
    (dotimes (i 3)
      (set! (-> pr n i) 0)
      (set! (-> pr tbp i) 0)))
  (none))

(defun rhud-gauge-note-vert ((xi float) (yi float) (uu float) (vv float))
  "un sommet de plus pour la primitive en cours. xi/yi sont les ENTIERS 12.4 relus du buffer."
  (let* ((pr *rhud-gauge-probe*)
         (ti (-> pr tag))
         (k  (-> pr n ti)))
    (when (zero? k)
      (set! (-> pr u0 ti) uu) (set! (-> pr v0 ti) vv)
      (set! (-> pr x0 ti) xi) (set! (-> pr y0 ti) yi)
      (set! (-> pr minx ti) xi) (set! (-> pr maxx ti) xi)
      (set! (-> pr miny ti) yi) (set! (-> pr maxy ti) yi))
    (when (= k 1)
      (set! (-> pr u1 ti) uu) (set! (-> pr v1 ti) vv)
      (set! (-> pr x1 ti) xi) (set! (-> pr y1 ti) yi))
    (set! (-> pr ul ti) uu) (set! (-> pr vl ti) vv)
    (set! (-> pr xl ti) xi) (set! (-> pr yl ti) yi)
    (if (< xi (-> pr minx ti)) (set! (-> pr minx ti) xi))
    (if (> xi (-> pr maxx ti)) (set! (-> pr maxx ti) xi))
    (if (< yi (-> pr miny ti)) (set! (-> pr miny ti) yi))
    (if (> yi (-> pr maxy ti)) (set! (-> pr maxy ti) yi))
    (set! (-> pr n ti) (+ k 1)))
  (none))

(defun rhud-set-shader ((buf dma-buffer) (tbp int))
  "set up the GS registers (blend/clamp/filter/texture) for drawing one of the
   recharged hud textures as textured prims through the direct renderer."
  (with-cnt-vif-block (buf)
    (dma-buffer-add-gif-tag buf
                            (new 'static 'gif-tag64 :nloop 4 :eop 1 :nreg 1)
                            (new 'static 'gif-tag-regs :regs0 (gif-reg-id a+d)))
    (dma-buffer-add-uint64 buf
                           #x44 ;; (Cs-Cd)*As+Cd standard alpha blend
                           (gs-reg64 alpha-1)
                           #x5 ;; clamp s+t
                           (gs-reg64 clamp-1)
                           #x60 ;; bilinear filtering
                           (gs-reg64 tex1-1)
                           (logior (the-as uint tbp) RHUD_TEX0_BITS)
                           (gs-reg64 tex0-1)))
  ;; hud-eco-gauge : le tbp REELLEMENT pose pour la primitive qui suit, releve au point de pose.
  ;; Un `case` qui retomberait sur la mauvaise couleur se lit ici et nulle part ailleurs.
  (let ((pr *rhud-gauge-probe*))
    (if (>= (-> pr tag) 0) (set! (-> pr tbp (-> pr tag)) tbp)))
  (none))

(defmacro rhud-rgba (rr gg bb aa)
  "pack vertex color+alpha into one int (GOAL functions cap at 8 params)"
  `(logior ,rr (ash ,gg 8) (ash ,bb 16) (ash ,aa 24)))

(defun rhud-add-vert ((buf dma-buffer) (ss float) (tv float) (rgba int) (px float) (py float))
  "add one st/rgbaq/xyzf2 packed vertex. px/py are in the 512x448 2d space of
   draw-sprite2d-xy (x maps to gs 1792..2304, y to gs 1824..2272).
   rgba is an rhud-rgba-packed color (128 = 1.0 modulate)."
  (let ((data (the-as (pointer float) (-> buf base))))
    ;; st (q rides in the third dword of the packed st register)
    (set! (-> data 0) ss)
    (set! (-> data 1) tv)
    (set! (-> data 2) 1.0)
    (set! (-> data 3) 0.0))
  (let ((data (the-as (pointer int32) (&+ (-> buf base) 16))))
    ;; rgbaq (packed byte fields)
    (set! (-> data 0) (logand rgba #xff))
    (set! (-> data 1) (logand (ash rgba -8) #xff))
    (set! (-> data 2) (logand (ash rgba -16) #xff))
    (set! (-> data 3) (logand (ash rgba -24) #xff)))
  (let ((data (the-as (pointer uint32) (&+ (-> buf base) 32))))
    ;; xyzf2 (12.4 fixed point, z in bits 4-27 of the upper qword half).
    ;; direct-path 2d window per the direct vertex shader (jak1 HEIGHT_SCALE=1,
    ;; SCISSOR_ADJUST=512/448): full screen = x_gs 1792..2304 (512-unit canvas,
    ;; fills the window width), y_gs 1936..2160 (224 units, so 448-canvas y halves).
    (set! (-> data 0) (the-as uint (the int (* 16.0 (+ 1792.0 px)))))
    (set! (-> data 1) (the-as uint (the int (* 16.0 (+ 1936.0 (* 0.5 py))))))
    ;; near-plane z for the 24-bit zbuffer, same as the font renderer (draws over the scene)
    (set! (-> data 2) (the-as uint (ash #xfffffe 4)))
    (set! (-> data 3) (the-as uint 0)))
  ;; hud-eco-gauge : LE SOMMET TEL QU'IL PART, relu dans le buffer. On relit les octets ecrits
  ;; juste au-dessus au lieu de recopier `px`/`py`/`ss`/`tv` : la quantification 12.4 fait partie
  ;; de ce que la jauge dessine, et une porte qui relirait ses propres arguments serait un miroir.
  (let ((pr *rhud-gauge-probe*))
    (when (>= (-> pr tag) 0)
      (let ((st (the-as (pointer float) (-> buf base)))
            (xy (the-as (pointer int32) (&+ (-> buf base) 32))))
        (rhud-gauge-note-vert (the float (-> xy 0)) (the float (-> xy 1)) (-> st 0) (-> st 1)))))
  (&+! (-> buf base) 48)
  (none))

(defun rhud-quad ((buf dma-buffer) (cx float) (cy float) (hs float) (fx float) (rot float) (rgba int))
  "draw the full texture canvas as a quad centered at cx/cy, half-size hs (in
   448-space y units), rotated by rot (rotation units) around its center.
   fx is the x-aspect factor that keeps the canvas square on screen.
   rgba is an rhud-rgba-packed vertex color."
  (let ((cs (cos rot))
        (sn (sin rot)))
    (with-cnt-vif-block (buf)
      ;; giftag: packed, 4 verts, prim tri-strip/iip/tme/abe
      (dma-buffer-add-uint64 buf
                             (logior 4 #x8000 (ash 1 46) (ash #x5c 47) (ash 3 60))
                             #x412 ;; regs st rgbaq xyzf2
                             )
      ;; corners in strip order; uv follows the corner, rotation only moves the position
      (dotimes (i 4)
        (let* ((dx (if (zero? (logand i 1)) -1.0 1.0))
               (dy (if (< i 2) -1.0 1.0))
               (ox (* (- (* dx cs) (* dy sn)) hs))
               (oy (* (+ (* dx sn) (* dy cs)) hs)))
          (rhud-add-vert buf
                         (* 0.5 (+ dx 1.0))
                         (* 0.5 (+ dy 1.0))
                         rgba
                         (+ cx (* ox fx))
                         (+ cy oy))))))
  (none))

(defun rhud-fan ((buf dma-buffer) (cx float) (cy float) (hs float) (fx float) (a0 float) (a1 float) (aa int))
  "draw the angular sector [a0,a1] (rotation units, 0 = 3 o'clock, increasing
   clockwise on screen) of the texture canvas centered at cx/cy as a triangle
   fan; each vertex uv is the affine map of its position within the canvas so
   the sector acts as a mask over the full sprite."
  (let* ((segs (max 1 (the int (* 24.0 (/ (- a1 a0) RHUD_GAUGE_ARC_SPAN)))))
         (nverts (+ segs 2)))
    (with-cnt-vif-block (buf)
      ;; giftag: packed, prim tri-fan/iip/tme/abe
      (dma-buffer-add-uint64 buf
                             (logior (the-as uint nverts) #x8000 (ash 1 46) (ash #x5d 47) (ash 3 60))
                             #x412 ;; regs st rgbaq xyzf2
                             )
      ;; center vertex
      (rhud-add-vert buf 0.5 0.5 (rhud-rgba 128 128 128 aa) cx cy)
      ;; rim vertices, overshot past the canvas edge so the fan chords fully
      ;; cover the ring; uv clamps to the (transparent) canvas border
      (dotimes (i (+ segs 1))
        (let* ((ang (+ a0 (/ (* (- a1 a0) (the float i)) (the float segs))))
               (dx (* 1.5 (cos ang)))
               (dy (* 1.5 (sin ang))))
          (rhud-add-vert buf
                         (* 0.5 (+ dx 1.0))
                         (* 0.5 (+ dy 1.0))
                         (rhud-rgba 128 128 128 aa)
                         (+ cx (* dx hs fx))
                         (+ cy (* dy hs)))))))
  (none))

(defun rhud-aspect-fx ()
  "x-aspect factor that keeps a square texture canvas square on screen, computed
   from the real window size (the 512x448 2d canvas stretches to fill the window,
   so squares need width = height * (512/448) * (window-h/window-w))."
  (let ((w (the float (-> *pc-settings* framebuffer-width)))
        (h (the float (-> *pc-settings* framebuffer-height))))
    (if (> w 0.0)
      (/ (* 1.142857 h) w)
      0.857)))

(defun rhud-set-shader-tex ((buf dma-buffer) (tex texture))
  "rhud-set-shader for a stock vram texture (pool lookup by its tbp), with
   ADDITIVE blend for the glow-style eco sprites. (the pc direct renderer only
   reads tbp0/tcc/tfx out of tex0, so RHUD_TEX0_BITS' size fields are inert)"
  (with-cnt-vif-block (buf)
    (dma-buffer-add-gif-tag buf
                            (new 'static 'gif-tag64 :nloop 4 :eop 1 :nreg 1)
                            (new 'static 'gif-tag-regs :regs0 (gif-reg-id a+d)))
    (dma-buffer-add-uint64 buf
                           #x48 ;; Cs*As + Cd (additive)
                           (gs-reg64 alpha-1)
                           #x5 ;; clamp s+t
                           (gs-reg64 clamp-1)
                           #x60 ;; bilinear filtering
                           (gs-reg64 tex1-1)
                           (logior (the-as uint (-> tex dest 0)) RHUD_TEX0_BITS)
                           (gs-reg64 tex0-1)))
  (none))

;;;----------------------------------------------
;;  stock hud suppression / icon upgrades
;;;----------------------------------------------

(defun rhud-icon-alive? ((obj hud))
  "#t when hud icon slot 0 holds a LIVE manipy with a LINKED skeleton. a manipy
   spawned during the level-load window comes up skeleton-less (manipy-init
   falls back to anim-mode 'still when initialize-skeleton finds no art) and
   draws NOTHING forever — the owner's 'power cell never appears' boot-ON
   regression (device-repro'd: boot-ON icon missing, runtime-ON icon fine).
   such zombies (and dead icons) must be respawned."
  (let ((ic (-> obj icons 0 icon)))
    (and (nonzero? ic) ic (-> ic 0) (nonzero? (-> ic 0 skel)) #t)))

;; hud-3d-pickups (17/09) : `rhud-set-cell-icon` et `rhud-drive-cell-anim` vivaient ici et
;; n'ont plus d'appelant — la pile d'energie est l'un des quatre emplacements de l'item
;; `hud-3d-pickups`, qui porte ses propres `hud3d-make-cell-icon` / `hud3d-drive-cell-anim` hors
;; de FLAG_RECHARGED_HUD. Elles etaient compilees dans TOUS les binaires sans etre appelees par
;; personne : retirees.

;; Grecharged-buildsys-flags: the four hud-recharged-health helpers below are compiled only with --recharged-hud.
(#when FLAG_RECHARGED_HUD
(defun rhud-add-buzzer-icon ((this hud-recharged-health))
  "add the real scout-fly 3d model as an icon on the stock hud-buzzers element
   and hide its flat sprite particle."
  (let ((bz (-> *hud-parts* buzzers)))
    (when bz
      (let ((obj (the-as hud (-> bz 0))))
        ;; owner round-2 item 2 (same zombie class as the cell): if a prior add
        ;; produced a dead/skeleton-less icon, clear the slot and re-make it
        (when (and (> (-> obj nb-of-icons) 0) (not (rhud-icon-alive? obj)))
          (when (and (nonzero? (-> obj icons 0 icon)) (-> obj icons 0 icon) (-> obj icons 0 icon 0))
            (deactivate (ppointer->process (-> obj icons 0 icon))))
          (set! (-> obj icons 0 icon) (the-as (pointer manipy) #f))
          (set! (-> obj nb-of-icons) 0))
        (when (zero? (-> obj nb-of-icons))
          (hud-pc-make-icon obj
                            HUD_ICON_COUNT
                            :skel *buzzer-sg*
                            :x 60
                            :y 380
                            :z 1024.0
                            :scale-x 0.008
                            :scale-y -0.008)
          ;; art not loaded yet -> skeleton-less zombie; kill + reset so the
          ;; per-frame guard retries until the level art is in
          (when (and (nonzero? (-> obj icons 0 icon))
                     (-> obj icons 0 icon)
                     (-> obj icons 0 icon 0)
                     (zero? (-> obj icons 0 icon 0 skel)))
            (deactivate (ppointer->process (-> obj icons 0 icon)))
            (set! (-> obj icons 0 icon) (the-as (pointer manipy) #f))
            (set! (-> obj nb-of-icons) 0))
          (let ((icon (-> obj icons 0 icon)))
            (when (and (nonzero? icon) icon)
              ;; face the camera (the model's rest pose looks away) and follow
              ;; the element's current visibility instead of parking at origin
              (send-event (ppointer->process icon)
                          'rot-quat
                          (quaternion-axis-angle! (new-stack-quaternion0) 0.0 1.0 0.0 (degrees 180)))
              (send-event (ppointer->process icon) 'draw (not (hidden? obj)))
              (draw-icons obj))))
        ;; skip-particle 0 stops draw-hud from spawning the flat buzzer sprite
        (set! (-> obj skip-particle) 0))
      (set! (-> this buzz-proc) (the-as process (ppointer->process bz)))))
  (none))

(defun rhud-remove-buzzer-icon ((this hud-recharged-health))
  "undo rhud-add-buzzer-icon (restore the stock flat sprite)."
  (let ((bz (-> *hud-parts* buzzers)))
    (when (and bz (= (ppointer->process bz) (-> this buzz-proc)))
      (let ((obj (the-as hud (-> bz 0))))
        (when (> (-> obj nb-of-icons) 0)
          (when (and (nonzero? (-> obj icons 0 icon)) (-> obj icons 0 icon))
            (deactivate (ppointer->process (-> obj icons 0 icon))))
          (set! (-> obj icons 0 icon) (the-as (pointer manipy) #f))
          (set! (-> obj nb-of-icons) 0))
        (set! (-> obj skip-particle) -1))))
  (set! (-> this buzz-proc) #f)
  (none))

(defun rhud-suppress-stock ((this hud-recharged-health))
  "per-frame idempotent guards: keep the stock heart/eco-gauge disabled+hidden while the recharged
   hud is ON. re-applies automatically if the stock hud processes respawn.
   hud-3d-pickups (17/09) : LES QUATRE EMPLACEMENTS D'OBJETS ONT QUITTE CETTE FONCTION. La pile,
   la mecamouche, l'orbe et l'eco verte sont l'item `hud-3d-pickups` et vivent sur son process,
   hors de FLAG_RECHARGED_HUD. Deux pilotes sur le meme slot se battraient a chaque image."
  (let ((h (-> *hud-parts* health)))
    (when h
      (if (not (-> h 0 disable)) (send-event (ppointer->process h) 'disable))
      (if (not (hidden? (-> h 0))) (send-event (ppointer->process h) 'hide-quick))))
  (let ((p (-> *hud-parts* power)))
    (when p
      (if (not (-> p 0 disable)) (send-event (ppointer->process p) 'disable))
      (if (not (hidden? (-> p 0))) (send-event (ppointer->process p) 'hide-quick))))
  (none))

(defun rhud-restore-stock ((this hud-recharged-health))
  "give the stock heart/gauge back when the recharged hud is toggled OFF."
  (let ((h (-> *hud-parts* health)))
    (if (and h (-> h 0 disable)) (send-event (ppointer->process h) 'enable)))
  (let ((p (-> *hud-parts* power)))
    (if (and p (-> p 0 disable)) (send-event (ppointer->process p) 'enable)))
  (none))
)  ;; #when FLAG_RECHARGED_HUD (rhud-* helpers)

;;;----------------------------------------------
;;  hud-recharged-health
;;;----------------------------------------------

;; Grecharged-buildsys-flags: all hud-recharged-health / hud-recharged-power methods below compile only with --recharged-hud.
(#when FLAG_RECHARGED_HUD
(defmethod init-particles! ((this hud-recharged-health) (arg0 int))
  ;; hud-3d-pickups (17/09) : la particule d'eco verte a QUITTE cet element. Elle est l'un des
  ;; quatre emplacements de l'item `hud-3d-pickups`, qui la porte sur son propre process — deux
  ;; emetteurs au meme slot en dessineraient deux.
  (dotimes (s5-1 (-> this nb-of-particles))
    (if (= (-> this particles s5-1 part matrix) -1) (set! (-> this particles s5-1 part matrix) (sprite-allocate-user-hvdf))))
  (set! (-> this x-sgn) -1)
  (set! (-> this y-sgn) -1)
  (set! (-> this friend) 0) ;; co-show the pickups counter, like the stock heart
  (set! (-> this active-flag) #f)
  (set! (-> this cell-proc) #f)
  (set! (-> this buzz-proc) #f)
  0
  (none))

(defmethod hud-update ((this hud-recharged-health))
  (cond
    ;; Grecharged-master-toggle: master OFF forces the stock HUD (recharged-hud? keeps the user's value)
    ((not (and (-> *pc-settings* recharged-master?) (-> *pc-settings* recharged-hud?)))
     (set! (-> this force-on-screen) #f)
     (when (-> this active-flag)
       (set! (-> this active-flag) #f)
       (rhud-restore-stock this)
       (if (not (hidden? this)) (send-event this 'hide-quick))))
    (else
     (set! (-> this active-flag) #t)
     (rhud-suppress-stock this)
     ;; owner visibility rule: the heart is PINNED on screen only while health
     ;; sits at the last notch (force-on-screen re-stamps trigger-time every
     ;; frame, the same pin the racer hud uses); everywhere else it follows the
     ;; stock show-on-change / 2s-timeout machinery in tally-value.
     (let ((pin (if (and *target* (= (the int (-> *target* fact health)) 1)) #t #f)))
       (set! (-> this force-on-screen) pin)
       ;; while pinned, tally-value fires every frame: mute the friend co-show
       ;; (it would park the pickups counter on screen); stock co-show behavior
       ;; is kept for the ordinary change-triggered shows.
       (set! (-> this friend) (if pin -1 0)))
     (if *target*
       (tally-value this (the int (-> *target* fact health)) (the-as int (-> *target* fact health-pickup-time))))
     ;; owner round-3 item 4: collecting green eco must POP THE HEART alongside the
     ;; counter, like the original hud (stock pickups co-shows stock health via
     ;; friend; ours is disabled, so mirror it here)
     (let ((pk (-> *hud-parts* pickups)))
       (when (and pk (not (hidden? (-> pk 0))))
         (set-time! (-> this trigger-time))
         (if (hidden? this) (send-event this 'show))))
     ;; owner addendum: the world cell EMITS A GLOW (group-fuel-cell-starburst:
     ;; two counter-rotating starflash blooms 192/192/0 + 128/128/128 at
     ;; rotvel -0.4/+0.3 deg per frame, plus flickering yellow flares —
     ;; collectables-part.gc:1751). replicate it with the same effects-tpage
     ;; textures at the hud cell's slot, under the icon's visibility/slide.
     (let ((fc (-> *hud-parts* fuel-cell)))
       (when (and fc (not (hidden? (-> fc 0))) (not (paused?)) (not (movie?)) (rhud-icon-alive? (-> fc 0)))
         (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug))
           (let* ((obj (the-as hud (-> fc 0)))
                  (cx (+ 256.0 (the float (* (-> obj x-sgn) (-> obj offset)))))
                  (cy (+ (the float (-> obj icons 0 icon-y)) (the float (* (-> obj y-sgn) (-> obj offset)))))
                  (fx (rhud-aspect-fx))
                  (ctr (the int (* DISPLAY_FPS_RATIO (-> *display* integral-frame-counter))))
                  ;; rotation-unit angles, computed in INT space (72.8 = 364/5,
                  ;; 54.6 = 273/5) so long sessions don't hit f32 precision
                  (rot-a (the float (- (/ (mod (* 364 ctr) 327680) 5)))) ;; -0.4 deg/frame (world part 230)
                  (rot-b (the float (/ (mod (* 273 ctr) 327680) 5))) ;; +0.3 deg/frame (world part 231)
                  (pulse (+ 1.0 (* 0.15 (sin (the float (mod (* 218 ctr) 65536)))))))
             ;; round-3: golden-white halo tint like in-game; low alpha so the cell body reads
             (aif (get-texture starflash effects)
                  (begin
                    (rhud-set-shader-tex buf it)
                    (rhud-quad buf cx cy 26.0 fx rot-a (rhud-rgba 255 230 140 48))
                    (rhud-quad buf cx cy 30.0 fx rot-b (rhud-rgba 200 200 200 48))))
             (aif (get-texture flare effects)
                  (begin
                    (rhud-set-shader-tex buf it)
                    (rhud-quad buf cx cy (* 14.0 pulse) fx 0.0 (rhud-rgba 255 240 180 28))))))))))
  0
  (none))

(defmethod draw-hud ((this hud-recharged-health))
  ;; owner round-3 item 2: the base hud draw-hud spawns the real green-eco
  ;; particle whenever this element is shown
  (let ((t9-0 (method-of-type hud draw-hud))) (t9-0 this))
  (when (and (-> *pc-settings* recharged-master?) (-> *pc-settings* recharged-hud?) *target* (not (hidden? this)) (not (paused?)))
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug))
      (let ((cx (+ RHUD_HEART_X (the float (* (-> this x-sgn) (-> this offset)))))
            (cy (+ RHUD_HEART_Y (the float (* (-> this y-sgn) (-> this offset)))))
            (fx (rhud-aspect-fx))
            (hp (the int (-> *target* fact health))))
        (cond
          ((>= hp 3)
           (rhud-set-shader buf RHUD_TBP_HEART_100)
           (rhud-quad buf cx cy RHUD_HEART_HALF fx 0.0 (rhud-rgba 128 128 128 128)))
          ((= hp 2)
           (rhud-set-shader buf RHUD_TBP_HEART_66)
           (rhud-quad buf cx cy RHUD_HEART_HALF fx 0.0 (rhud-rgba 128 128 128 128)))
          ((= hp 1)
           ;; owner round-3 item 5: low-health blink is a looping alpha FADE in/out
           ;; between the empty heart and the one-third-green overlay (not hard on/off)
           (rhud-set-shader buf RHUD_TBP_HEART_0)
           (rhud-quad buf cx cy RHUD_HEART_HALF fx 0.0 (rhud-rgba 128 128 128 128))
           (let* ((tri (mod (the int (* DISPLAY_FPS_RATIO (-> *display* integral-frame-counter))) 90))
                  (aa (the int (* 128.0 (/ (the float (if (< tri 45) tri (- 90 tri))) 45.0)))))
             (rhud-set-shader buf RHUD_TBP_HEART_33)
             (rhud-quad buf cx cy RHUD_HEART_HALF fx 0.0 (rhud-rgba 128 128 128 aa))))
          (else
           (rhud-set-shader buf RHUD_TBP_HEART_0)
           (rhud-quad buf cx cy RHUD_HEART_HALF fx 0.0 (rhud-rgba 128 128 128 128)))))))
  0
  (none))

)  ;; fin du #when FLAG_RECHARGED_HUD (methodes hud-recharged-health SEULEMENT)

;;;----------------------------------------------
;;  hud-eco-gauge — suppression de la jauge d'ORIGINE, cote jauge
;;;----------------------------------------------
;; `rhud-suppress-stock` vit sur le process du COEUR, derriere FLAG_RECHARGED_HUD. Dans le binaire
;; LIVRE ce process n'existe pas : sans les deux fonctions ci-dessous, la jauge rechargee se
;; dessinerait PAR-DESSUS celle d'origine. Elles ne touchent QUE `power` — le coeur d'origine
;; reste en place, c'est le chantier `hud-heart`.
(defun rhud-power-suppress-stock ()
  "garde idempotente par image : la jauge d'eco d'origine reste desactivee et cachee."
  (let ((p (-> *hud-parts* power)))
    (when p
      (if (not (-> p 0 disable)) (send-event (ppointer->process p) 'disable))
      (if (not (hidden? (-> p 0))) (send-event (ppointer->process p) 'hide-quick))))
  (none))

(defun rhud-power-restore-stock ()
  "rend la jauge d'origine quand le HUD recharge est eteint."
  (let ((p (-> *hud-parts* power)))
    (if (and p (-> p 0 disable)) (send-event (ppointer->process p) 'enable)))
  (none))

;;;----------------------------------------------
;;  hud-eco-gauge — LE JUGE
;;;----------------------------------------------
;; Seuils. `RHUD_GAUGE_TOL_MDEG` est le 0,5 degre du livrable, en milli-degres.
(defconstant RHUD_GAUGE_TOL_MDEG 500)
;; 1000 / 182,04445 : unites de rotation -> milli-degres.
(defconstant RHUD_MDEG_PER_ROT 5.4931641)
;; ecart de position tolere, en 1/16 d'unite du canevas 512x448 : « 0 px » du livrable.
(defconstant RHUD_GAUGE_POS_TOL 16)
;; Ecart de fraction tolere contre la jauge d'origine, en 1/100000. Le plancher n'est pas un
;; gout : les deux processus se mettent a jour a des tours differents de la meme image, et un
;; tour d'ecart vaut 5 unites de `game-frame-counter` sur les 6000 du plein, soit 83. On prend
;; 300 (0,3 %) et on publie `hud_gauge_t4_max` : un vrai defaut de denominateur ou de borne
;; sortirait a plusieurs dizaines de milliers, pas a 83.
(defconstant RHUD_GAUGE_FRAC_TOL 300)
;; Images jetees apres chaque bascule du banc. Une bascule de reglage ne prend effet qu'a l'image
;; SUIVANTE (l'etat `hud-hidden` et l'evenement `enable` de la jauge d'origine mettent chacun une
;; image a atterrir) : sans ce sas on chiffrerait le temps de reponse de nos propres bascules.
(defconstant RHUD_GB_SETTLE 30)
;; Ecart tolere sur la duree d'un vidage complet, en unites de game-frame-counter (300 par
;; seconde) : 10 = un trentieme de seconde, soit deux images de logique.
(defconstant RHUD_GB_DRAIN_TOL 10)

(defmacro rhud-gp-px (raw) `(- (/ ,raw 16.0) 1792.0))
(defmacro rhud-gp-py (raw) `(* 2.0 (- (/ ,raw 16.0) 1936.0)))

(defun rhud-gauge-wrap ((a float))
  "un angle en unites de rotation, ramene dans [0, 65536)."
  (let ((x a))
    (while (< x 0.0) (set! x (+ x 65536.0)))
    (while (>= x 65536.0) (set! x (- x 65536.0)))
    x))

(defun rhud-gauge-wrap-signed ((a float))
  "un ecart d'angle, ramene dans (-32768, 32768]."
  (let ((x (rhud-gauge-wrap a)))
    (if (> x 32768.0) (set! x (- x 65536.0)))
    x))

(defun rhud-gauge-uv-ang ((uu float) (vv float))
  "l'angle d'un sommet de jante, lu sur SES coordonnees de texture. `rhud-fan` pose
   u = 0,5(1,5 cos a + 1) et v = 0,5(1,5 sin a + 1) : l'angle se retrouve sans passer par
   le facteur d'aspect, donc c'est bien l'angle du MASQUE sur la jauge."
  (atan (- (* 2.0 vv) 1.0) (- (* 2.0 uu) 1.0)))

(defun rhud-gauge-judge ((this hud-recharged-power) (frac float) (fx float) (want-full int))
  "hud-eco-gauge : juge les sommets que l'image qui vient d'etre dessinee a REELLEMENT emis."
  (let* ((pr *rhud-gauge-probe*)
         (nb (-> pr n RHUD_GP_BASE))
         (nf (-> pr n RHUD_GP_FAN))
         (nt (-> pr n RHUD_GP_TIP)))

    ;; --- terme 1 : L'ANGLE. depart de l'arc ET amplitude, tous deux lus sur les UV emis. ---
    (when (>= nf 3)
      (let* ((a0 (rhud-gauge-uv-ang (-> pr u1 RHUD_GP_FAN) (-> pr v1 RHUD_GP_FAN)))
             (a1 (rhud-gauge-uv-ang (-> pr ul RHUD_GP_FAN) (-> pr vl RHUD_GP_FAN)))
             (d-start (the int (* RHUD_MDEG_PER_ROT (fabs (rhud-gauge-wrap-signed (- a0 RHUD_GAUGE_ARC_START))))))
             (d-span  (the int (* RHUD_MDEG_PER_ROT
                                  (fabs (rhud-gauge-wrap-signed (- (rhud-gauge-wrap (- a1 a0))
                                                                   (* RHUD_GAUGE_ARC_SPAN frac)))))))
             (d (max d-start d-span)))
        (+! (-> this t1-n) 1)
        (if (> d (-> this t1-max)) (set! (-> this t1-max) d))
        (if (> d RHUD_GAUGE_TOL_MDEG) (+! (-> this t1-bad) 1))))

    ;; --- terme 2 : L'EMBOUT. sa rotation se lit sur l'ARETE emise entre ses sommets 0 et 1. ---
    (cond
      ((> frac 0.0)
       (when (>= nt 2)
         (let* ((dpx (/ (- (rhud-gp-px (-> pr x1 RHUD_GP_TIP)) (rhud-gp-px (-> pr x0 RHUD_GP_TIP))) fx))
                (dpy (- (rhud-gp-py (-> pr y1 RHUD_GP_TIP)) (rhud-gp-py (-> pr y0 RHUD_GP_TIP))))
                (rot (atan dpy dpx))
                (d (the int (* RHUD_MDEG_PER_ROT
                               (fabs (rhud-gauge-wrap-signed (- rot (* RHUD_GAUGE_ARC_SPAN (- frac 1.0)))))))))
           (+! (-> this t2-n) 1)
           (if (> d (-> this t2-max)) (set! (-> this t2-max) d))
           (if (> d RHUD_GAUGE_TOL_MDEG) (+! (-> this t2-bad) 1)))))
      (else
       ;; a 0 % l'embout ne doit pas exister du tout
       (+! (-> this t2-n) 1)
       (if (> nt 0) (+! (-> this t2-ghost) 1))))

    ;; --- terme 3 : LA COULEUR, lue sur le tbp REELLEMENT pose dans TEX0. ---
    (when (> frac 0.0)
      (+! (-> this t3-n) 1)
      (if (or (!= (-> pr tbp RHUD_GP_BASE) RHUD_TBP_GAUGE_EMPTY)
              (!= (-> pr tbp RHUD_GP_FAN) want-full)
              ;; les embouts occupent les trois slots juste apres les trois pleines
              (!= (-> pr tbp RHUD_GP_TIP) (+ want-full 3)))
        (+! (-> this t3-bad) 1)))

    ;; --- terme 4 : LE VIDAGE. La fraction qu'on vient de DESSINER contre la quantite d'eco que la
    ;; jauge d'ORIGINE tient, la meme image, sur son propre process. `hud-power` continue de faire
    ;; tourner `hud-update`/`tally-value` meme desactivee et cachee (hud.gc, :post de hud-hidden) :
    ;; c'est un oracle VIVANT, produit par le code d'origine, pas une formule qu'on recopierait.
    ;; Le garde sur `value2` ecarte les images ou `tally-value` s'est tu (cinematique, pause,
    ;; letterbox) et ou l'oracle serait simplement perime.
    (let ((p (-> *hud-parts* power)))
      ;; L'ORACLE N'EST VALABLE QUE QUAND IL VIENT DE TOURNER.
      ;; `value` n'est pas la jauge : c'est la tally d'APPARITION du HUD, et `tally-value`
      ;; (engine/ui/hud.gc) se tait pendant un noir, un letterbox, une cinematique ou le menu.
      ;; Pendant ces silences `value` GELE tandis que l'eco continue de se vider — et la garde
      ;; d'avant, `value2 == eco-timeout`, ne pouvait pas le voir : `eco-timeout` ne bouge pas
      ;; d'un ramassage a l'autre. Course appareil du 18/09 : 8441 images sur 16783 accusees,
      ;; jusqu'a 84,5 % d'ecart, pour un oracle simplement perime — le bureau, qui ne diffuse
      ;; rien, n'en montrait aucune. On lit donc son horodatage de passage : `trigger-time` est
      ;; estampille a chaque fois que le corps de `tally-value` s'execute. Les images ecartees
      ;; sont COMPTEES et publiees, pour que l'aveuglement se lise au lieu de se deviner.
      (when (and p *target* (>= (-> this bench-n) RHUD_GB_SETTLE)
                 (< (- (current-time) (-> p 0 trigger-time)) (the-as time-frame 2)))
        (let* ((sfull (the float (the-as uint (-> *FACT-bank* eco-full-timeout))))
               (sfrac (fmin 1.0 (/ (the float (-> p 0 value)) sfull)))
               (mine (the int (* 100000.0 frac)))
               (d (the int (fabs (* 100000.0 (- frac sfrac))))))
          (+! (-> this t4-n) 1)
          (set! (-> this last-frac) mine)
          (if (> mine (-> this t4-hi)) (set! (-> this t4-hi) mine))
          (if (< mine (-> this t4-lo)) (set! (-> this t4-lo) mine))
          (if (> d (-> this t4-max)) (set! (-> this t4-max) d))
          (if (> d RHUD_GAUGE_FRAC_TOL) (+! (-> this t4-bad) 1))))
    (when (and p *target* (>= (-> this bench-n) RHUD_GB_SETTLE))
      (let ((lag (the int (- (current-time) (-> p 0 trigger-time)))))
        (if (>= lag 2) (+! (-> this t4-stale) 1))
        (if (> lag (-> this t4-lagmax)) (set! (-> this t4-lagmax) lag))
        (cond
          ((< lag 0) (+! (-> this t4-lag 0) 1))
          ((< lag 5) (+! (-> this t4-lag (+ 1 lag)) 1))
          (else (+! (-> this t4-lag 5) 1))))))

    ;; --- terme 4, second temoin : LA VITESSE DE VIDAGE, CHRONOMETREE.
    ;; De la derniere image a 100 % a la premiere image a 0 %, il doit s'ecouler exactement
    ;; `eco-full-timeout` unites de `game-frame-counter` — la duree qu'une pleine charge d'eco
    ;; dure dans le jeu d'origine. C'est une mesure de TEMPS : elle ne partage aucune variable
    ;; avec la formule de remplissage qu'elle controle.
    (let ((gfc (the int (-> *display* game-frame-counter))))
      (cond
        ((>= frac 0.9999) (set! (-> this drain-t0) gfc))
        ((and (<= frac 0.0) (> (-> this drain-t0) 0))
         (let* ((ticks (- gfc (-> this drain-t0)))
                (want (the int (the-as uint (-> *FACT-bank* eco-full-timeout)))))
           (set! (-> this drain-ticks) ticks)
           (+! (-> this drain-n) 1)
           (if (> (abs (- ticks want)) RHUD_GB_DRAIN_TOL) (+! (-> this drain-bad) 1))
           (set! (-> this drain-t0) 0)))))

    ;; --- terme 5 : LA POSITION. les trois primitives sur UN centre, celui de la jauge d'ORIGINE.
    ;; Juge uniquement les images ou l'animation d'arrivee est finie (`offset` nul) : sinon on
    ;; comparerait un HUD en cours de glissement a une position de repos.
    (when (and (>= nb 4) (zero? (-> this offset)))
      (let* ((bcx (* 0.5 (+ (-> pr minx RHUD_GP_BASE) (-> pr maxx RHUD_GP_BASE))))
             (bcy (* 0.5 (+ (-> pr miny RHUD_GP_BASE) (-> pr maxy RHUD_GP_BASE))))
             (d 0)
             (mesure 0))
        (when (>= nf 1)
          (set! mesure 1)
          (set! d (max d (the int (fabs (- bcx (-> pr x0 RHUD_GP_FAN))))))
          (set! d (max d (the int (fabs (- bcy (-> pr y0 RHUD_GP_FAN)))))))
        (when (>= nt 4)
          (set! mesure 1)
          (set! d (max d (the int (fabs (- bcx (* 0.5 (+ (-> pr minx RHUD_GP_TIP) (-> pr maxx RHUD_GP_TIP))))))))
          (set! d (max d (the int (fabs (- bcy (* 0.5 (+ (-> pr miny RHUD_GP_TIP) (-> pr maxy RHUD_GP_TIP)))))))))
        (if (>= d RHUD_GAUGE_POS_TOL) (+! (-> this t5-self) 1))
        ;; sous-terme B : ce centre est-il celui que la jauge d'ORIGINE se donne ? La comparaison
        ;; se fait dans le canevas 512x448, et elle n'est VALABLE que si la chaine y du HUD est
        ;; l'identite (`relative-y-scale` = 1 et `screen-sy` = 224) — c'est ce que `rhud-add-vert`
        ;; suppose en ecrivant 1936 + 0,5 py. Hors de ce regime on ne saurait comparer sans
        ;; recopier la formule d'en face : on ne MESURE pas, et le terme le dit.
        (let ((p (-> *hud-parts* power))
              (rys (-> *video-parms* relative-y-scale))
              (ssy (-> *video-parms* screen-sy)))
          (when (and p (> (-> p 0 nb-of-particles) 2)
                     (< (fabs (- rys 1.0)) 0.0005) (= ssy 224))
            (set! mesure 1)
            (let ((ds (max (the int (* 16.0 (fabs (- (rhud-gp-px bcx) (-> p 0 particles 2 init-pos x)))))
                           (the int (* 16.0 (fabs (- (rhud-gp-py bcy) (-> p 0 particles 2 init-pos y))))))))
              (if (>= ds RHUD_GAUGE_POS_TOL) (+! (-> this t5-stock) 1))
              (set! d (max d ds)))))
        (when (nonzero? mesure)
          (+! (-> this t5-n) 1)
          (if (> d (-> this t5-max)) (set! (-> this t5-max) d))
          (if (>= d RHUD_GAUGE_POS_TOL) (+! (-> this t5-bad) 1))))))
  (none))

;;;----------------------------------------------
;;  hud-eco-gauge — LE RAMASSAGE SCRIPTE ET LA PUBLICATION
;;;----------------------------------------------
;; Tout ce bloc est inerte hors `debug.opengoal.costprobe=hud-eco-gauge` : le joueur ne ramasse
;; jamais d'eco a sa place.
(defconstant RHUD_GB_MIN 300)     ;; images exigees par terme avant qu'il soit MESURE
(defconstant RHUD_GB_DRAIN 1500)  ;; bloc de vidage complet (20 s d'eco a 60 img/s, plus la marge)
(defconstant RHUD_GB_SHORT 240)   ;; blocs courts (une couleur)
(defconstant RHUD_GB_SPAN 50000)  ;; amplitude de fraction exigee pour que le vidage soit MESURE
;; Images exigees pour que la COMPARAISON a la tally d'origine compte. Le plancher est bas parce
;; que la population l'est : la tally d'origine ne se met a jour qu'a de rares images (mesure du
;; 18/09 : latence 0 sur 37 images, puis >= 4 et jusqu'a 730 sur les 5764 autres ; grandeur
;; BIMODALE, donc etat binaire, pas un reglage a elargir). On la juge QUAND elle est a jour, on
;; COMPTE les images ecartees, et on publie les deux — au lieu d'elargir la fenetre jusqu'a
;; mesurer la peremption de l'oracle plutot que la jauge.
(defconstant RHUD_GB_T4_MIN 25)

(defun rhud-gauge-phase-len ((ph int))
  (case ph
    ((0) RHUD_GB_DRAIN)
    (else RHUD_GB_SHORT)))

(defun rhud-gauge-eco-seed ((kind pickup-type))
  "UN RAMASSAGE, par le point d'entree du JEU. On n'ecrit pas `eco-timeout` a la main : la vitesse
   de vidage qu'on pretend mesurer est justement celle que ce chemin-la fixe."
  (if *target* (pickup-collectable! (-> *target* fact) kind 5.0 (the-as handle #f)))
  (none))

(defun rhud-gauge-bench ((this hud-recharged-power) (on symbol))
  "la sequence de mesure : bleu (vidage complet), rouge, jaune, puis ETEINT, puis rallume."
  (when *target*
    (+! (-> this bench-n) 1)
    (let ((ph (-> this bench-phase)))
      (when (= (-> this bench-n) 1)
        (case ph
          ((0) (rhud-gauge-eco-seed (pickup-type eco-blue)) (+! (-> this seeded) 1))
          ((1) (rhud-gauge-eco-seed (pickup-type eco-red)) (+! (-> this seeded) 1))
          ((2) (rhud-gauge-eco-seed (pickup-type eco-yellow)) (+! (-> this seeded) 1))
          ((3) (rhud-gauge-eco-seed (pickup-type eco-blue)) (+! (-> this seeded) 1)
               ;; terme 6 : ETEINT = ORIGINE, mesure DANS la course, par le reglage du joueur.
               (set! (-> *pc-settings* recharged-hud?) #f))
          ((4) (set! (-> *pc-settings* recharged-hud?) #t))))
      ;; terme 6 : pendant le bloc eteint, rien de recharge ne doit sortir et la jauge d'origine
      ;; doit etre RENDUE (pas seulement non supprimee : son process doit etre reactive).
      (when (and (= ph 3) (>= (-> this bench-n) RHUD_GB_SETTLE)
                 (<= (-> this bench-n) (- (rhud-gauge-phase-len ph) RHUD_GB_SETTLE)))
        (+! (-> this off-frames) 1)
        (let ((p (-> *hud-parts* power)))
          (if (or (not p) (-> p 0 disable)) (+! (-> this off-stock-ko) 1))))
      (when (>= (-> this bench-n) (rhud-gauge-phase-len ph))
        (set! (-> this bench-n) 0)
        ;; la garde de securite : quoi qu'il arrive, le reglage du joueur repart ALLUME.
        (set! (-> *pc-settings* recharged-hud?) #t)
        (cond
          ((>= ph 4) (set! (-> this bench-phase) 0) (+! (-> this bench-cycle) 1))
          (else (set! (-> this bench-phase) (+ ph 1)))))))
  (none))

(defun rhud-gauge-publish ((this hud-recharged-power))
  "hud-eco-gauge : chaque terme sur SA ligne, le compte de termes MESURES a cote de la somme.
   Un terme qu'on n'a pas pu mesurer vaut UN, jamais zero : une porte qui compterait zero un
   terme aveugle passerait au vert sans rien avoir regarde."
  (let ((measured 0))
    (let* ((t1 (if (>= (-> this t1-n) RHUD_GB_MIN)
                 (begin (+! measured 1) (-> this t1-bad))
                 (+ (-> this t1-bad) 1)))
           (t2 (if (and (>= (-> this t2-n) RHUD_GB_MIN) (> (-> this t2-max) 0))
                 (begin (+! measured 1) (+ (-> this t2-bad) (-> this t2-ghost)))
                 (+ (-> this t2-bad) (-> this t2-ghost) 1)))
           (t3 (if (>= (-> this t3-n) RHUD_GB_MIN)
                 (begin (+! measured 1) (-> this t3-bad))
                 (+ (-> this t3-bad) 1)))
           ;; le vidage n'est MESURE que si la course a vu la jauge parcourir la moitie de sa
           ;; plage : sur une fraction figee, l'egalite des deux jauges ne prouve rien.
           (t4 (if (and (>= (-> this t4-n) RHUD_GB_T4_MIN)
                        (>= (- (-> this t4-hi) (-> this t4-lo)) RHUD_GB_SPAN)
                        (> (-> this drain-n) 0))
                 (begin (+! measured 1) (+ (-> this t4-bad) (-> this drain-bad)))
                 (+ (-> this t4-bad) (-> this drain-bad) 1)))
           (t5 (if (>= (-> this t5-n) RHUD_GB_MIN)
                 (begin (+! measured 1) (-> this t5-bad))
                 (+ (-> this t5-bad) 1)))
           ;; eteint : il faut des images ETEINTES *et* des images DESSINEES, sinon « rien n'est
           ;; sorti » se lit aussi bien sur une jauge qui ne marche pas du tout.
           (t6 (if (and (>= (-> this off-frames) RHUD_GB_MIN) (>= (-> this draws) RHUD_GB_MIN))
                 (begin (+! measured 1) (+ (-> this off-draws) (-> this off-stock-ko)))
                 (+ (-> this off-draws) (-> this off-stock-ko) 1))))
      (__pc-autoport-publish "hud_gauge_t1_angle" t1)
      (__pc-autoport-publish "hud_gauge_t2_tip" t2)
      (__pc-autoport-publish "hud_gauge_t3_color" t3)
      (__pc-autoport-publish "hud_gauge_t4_drain" t4)
      (__pc-autoport-publish "hud_gauge_t5_position" t5)
      (__pc-autoport-publish "hud_gauge_t6_off" t6)
      (__pc-autoport-publish "hud_gauge_terms_measured" measured)
      ;; les denominateurs et les pires ecarts : de quoi relire la porte sans la croire sur parole
      (__pc-autoport-publish "hud_gauge_t1_n" (-> this t1-n))
      (__pc-autoport-publish "hud_gauge_t1_max_mdeg" (-> this t1-max))
      (__pc-autoport-publish "hud_gauge_t2_n" (-> this t2-n))
      (__pc-autoport-publish "hud_gauge_t2_max_mdeg" (-> this t2-max))
      (__pc-autoport-publish "hud_gauge_t2_ghost" (-> this t2-ghost))
      (__pc-autoport-publish "hud_gauge_t3_n" (-> this t3-n))
      (__pc-autoport-publish "hud_gauge_t4_n" (-> this t4-n))
      (__pc-autoport-publish "hud_gauge_t4_max" (-> this t4-max))
      (__pc-autoport-publish "hud_gauge_t4_stale" (-> this t4-stale))
      (__pc-autoport-publish "hud_gauge_t4_lagmax" (-> this t4-lagmax))
      (__pc-autoport-publish "hud_gauge_t4_lag_neg" (-> this t4-lag 0))
      (__pc-autoport-publish "hud_gauge_t4_lag0" (-> this t4-lag 1))
      (__pc-autoport-publish "hud_gauge_t4_lag1" (-> this t4-lag 2))
      (__pc-autoport-publish "hud_gauge_t4_lag2" (-> this t4-lag 3))
      (__pc-autoport-publish "hud_gauge_t4_lag3" (-> this t4-lag 4))
      (__pc-autoport-publish "hud_gauge_t4_lag4plus" (-> this t4-lag 5))
      (__pc-autoport-publish "hud_gauge_t4_hi" (-> this t4-hi))
      (__pc-autoport-publish "hud_gauge_t4_lo" (-> this t4-lo))
      (__pc-autoport-publish "hud_gauge_drain_n" (-> this drain-n))
      (__pc-autoport-publish "hud_gauge_drain_bad" (-> this drain-bad))
      (__pc-autoport-publish "hud_gauge_drain_ticks" (-> this drain-ticks))
      (__pc-autoport-publish "hud_gauge_drain_want" (the int (the-as uint (-> *FACT-bank* eco-full-timeout))))
      (__pc-autoport-publish "hud_gauge_t5_n" (-> this t5-n))
      (__pc-autoport-publish "hud_gauge_t5_self" (-> this t5-self))
      (__pc-autoport-publish "hud_gauge_t5_stock" (-> this t5-stock))
      ;; le regime de la chaine y du HUD : c'est lui qui dit si le terme 5 avait le droit de
      ;; comparer notre centre a celui de la jauge d'origine dans le canevas.
      (__pc-autoport-publish "hud_gauge_rel_y_milli" (the int (* 1000.0 (-> *video-parms* relative-y-scale))))
      (__pc-autoport-publish "hud_gauge_screen_sy" (-> *video-parms* screen-sy))
      (__pc-autoport-publish "hud_gauge_t5_max_16th" (-> this t5-max))
      (__pc-autoport-publish "hud_gauge_off_frames" (-> this off-frames))
      (__pc-autoport-publish "hud_gauge_off_draws" (-> this off-draws))
      (__pc-autoport-publish "hud_gauge_off_stock_ko" (-> this off-stock-ko))
      (__pc-autoport-publish "hud_gauge_draws" (-> this draws))
      (__pc-autoport-publish "hud_gauge_seeded" (-> this seeded))
      (__pc-autoport-publish "hud_gauge_cycles" (-> this bench-cycle))
      (__pc-autoport-publish "hud_gauge_probe" (if (-> this probe?) 1 0))
      ;; le plancher angulaire de l'instrument : la quantification 12.4 de l'embout. Publie pour
      ;; que la porte ne soit pas en train de mesurer sa propre tolerance.
      (__pc-autoport-publish "hud_gauge_quant_floor_mdeg" (-> this quant-mdeg))
      (__pc-autoport-publish "hud_gauge_defects" (+ t1 t2 t3 t4 t5 t6))))
  (none))

;;;----------------------------------------------
;;  hud-recharged-power  — HORS du drapeau de compilation (voir le deftype)
;;;----------------------------------------------

(defmethod init-particles! ((this hud-recharged-power) (arg0 int))
  ;; owner round-3 item 3: the three per-type eco particle systems at the gauge
  ;; center hole (0=blue 1=red 2=yellow); only the active one is spawned in draw-hud.
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((s5-0 (-> this nb-of-particles)))
      (set! (-> this particles s5-0) (new 'static 'hud-particle))
      (set! (-> this particles s5-0 part) (create-launch-control group-hud-eco-blue this))
      (set! (-> this particles s5-0 init-pos x) 435.0)
      (set! (-> this particles s5-0 init-pos y) 370.0)
      (set! (-> this particles s5-0 init-pos z) 1.0)
      (set! (-> this particles s5-0 part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((s5-0 (-> this nb-of-particles)))
      (set! (-> this particles s5-0) (new 'static 'hud-particle))
      (set! (-> this particles s5-0 part) (create-launch-control group-hud-eco-red this))
      (set! (-> this particles s5-0 init-pos x) 435.0)
      (set! (-> this particles s5-0 init-pos y) 370.0)
      (set! (-> this particles s5-0 init-pos z) 1.0)
      (set! (-> this particles s5-0 part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((s5-0 (-> this nb-of-particles)))
      (set! (-> this particles s5-0) (new 'static 'hud-particle))
      (set! (-> this particles s5-0 part) (create-launch-control group-hud-eco-yellow this))
      (set! (-> this particles s5-0 init-pos x) 435.0)
      (set! (-> this particles s5-0 init-pos y) 370.0)
      (set! (-> this particles s5-0 init-pos z) 1.0)
      (set! (-> this particles s5-0 part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  (dotimes (s5-1 (-> this nb-of-particles))
    (if (= (-> this particles s5-1 part matrix) -1) (set! (-> this particles s5-1 part matrix) (sprite-allocate-user-hvdf))))
  (set! (-> this x-sgn) 1)
  (set! (-> this y-sgn) 1)
  ;; ROUND 5: -1 = "no type has spawned yet", so the first draw-hud frame clears the other two
  (set! (-> this last-eco-idx) -1)
  ;; hud-eco-gauge : l'instrument. `t4-lo` part du HAUT, sinon la plage observee vaudrait tout de
  ;; suite le maximum et le terme se dirait mesure sans avoir rien vu se vider.
  (set! (-> this t4-lo) 100000)
  (set! (-> this last-frac) -1)
  (set! (-> this bench-phase) 0)
  (set! (-> this bench-n) 0)
  ;; le plancher angulaire de l'embout : une arete de 2*hs unites de canevas, dont l'ordonnee est
  ;; quantifiee au 1/8 (xyzf2 en 12.4, et `py` divise par deux avant).
  (set! (-> this quant-mdeg) (the int (* RHUD_MDEG_PER_ROT (atan 0.125 (* 2.0 RHUD_GAUGE_HALF)))))
  0
  (none))

(defmethod hud-update ((this hud-recharged-power))
  ;; hud-eco-gauge : LA JAUGE D'ORIGINE EST SUPPRIMEE PAR NOUS, PAS PAR LE COEUR.
  ;; `rhud-suppress-stock` vit sur `hud-recharged-health`, derriere FLAG_RECHARGED_HUD : dans le
  ;; binaire livre ce process n'existe pas, et sans les deux lignes ci-dessous les deux jauges se
  ;; dessineraient l'une sur l'autre.
  (let ((on (and (-> *pc-settings* recharged-master?) (-> *pc-settings* recharged-hud?) #t)))
    (set! (-> this stock-off) on)
    (if on (rhud-power-suppress-stock) (rhud-power-restore-stock))
    (set! (-> this probe?) (and (nonzero? (__pc-autoport-cost-probe "hud-eco-gauge")) #t))
    (if (-> this probe?) (rhud-gauge-bench this on))
    (when (zero? (mod (the int (-> *display* integral-frame-counter)) 60))
      (rhud-gauge-publish this)))
  (cond
    ((not (and (-> *pc-settings* recharged-master?) (-> *pc-settings* recharged-hud?)))
     ;; hide-quick is handled SYNCHRONOUSLY and the handler re-enters (hud-update self)
     ;; BEFORE its (go hud-hidden) lands — an unguarded re-send here is infinite
     ;; recursion -> stack-overflow SIGSEGV (toggle OFF while the gauge is visible,
     ;; i.e. carrying eco). The handler stamps last-hide-time first; gate on it.
     (if (and (not (hidden? this)) (!= (-> this last-hide-time) (current-time)))
       (send-event this 'hide-quick)))
    (else
     ;; same value tracking as the stock hud-power: remaining eco time
     (if *target*
       (tally-value this
                    (max 0
                         (min (the-as int
                                      (- (-> *target* fact eco-timeout)
                                         (the-as uint (- (-> *display* game-frame-counter) (-> *target* fact eco-pickup-time)))))
                              (the-as int (-> *target* fact eco-timeout))))
                    (the-as int (-> *target* fact eco-timeout))))))
  0
  (none))

(defmethod draw-hud ((this hud-recharged-power))
  (when (and (-> *pc-settings* recharged-master?) (-> *pc-settings* recharged-hud?) (not (hidden? this)) (not (paused?)))
    ;; hud-eco-gauge : UNE IMAGE OU LA JAUGE RECHARGEE EST DESSINEE — c'est le `hits=` que
    ;; l'item declare, et l'instrument qui le suit mesure CETTE image-la.
    (__pc-autoport-hit-for "hud-eco-gauge" 1)
    (+! (-> this draws) 1)
    (if (and (-> this probe?) (= (-> this bench-phase) 3) (>= (-> this bench-n) RHUD_GB_SETTLE)
             (<= (-> this bench-n) (- RHUD_GB_SHORT RHUD_GB_SETTLE)))
      (+! (-> this off-draws) 1))
    (rhud-gauge-probe-reset)
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug))
      ;; hud-eco-gauge : LE CENTRE VIENT DE LA JAUGE D'ORIGINE, PAS D'UNE CONSTANTE.
      ;; `set-pos-and-scale` (engine/ui/hud-classes.gc) recale la position du HUD d'origine sur le
      ;; format de l'ecran des que `use-vis?` est faux : sur un ecran large, la jauge d'origine
      ;; n'est plus a x=435. Nos constantes RHUD_GAUGE_X/Y ignoraient ce recalage, et la jauge
      ;; rechargee se dessinait a cote de celle qu'elle remplace — d'autant plus loin que l'ecran
      ;; est large, donc sur un telephone. On lit donc SA position, et les constantes ne servent
      ;; plus que de repli quand son process n'existe pas encore.
      (let* ((sp (-> *hud-parts* power))
             (ok (and sp (> (-> sp 0 nb-of-particles) 2)))
             (cx (+ (if ok (-> sp 0 particles 2 init-pos x) RHUD_GAUGE_X)
                    (the float (* (-> this x-sgn) (-> this offset)))))
             (cy (+ (if ok (-> sp 0 particles 2 init-pos y) RHUD_GAUGE_Y)
                    (the float (* (-> this y-sgn) (-> this offset)))))
             (fx (rhud-aspect-fx))
             (jfrac 0.0)
             (jwant RHUD_TBP_GAUGE_BLUE_FULL))
        ;; empty ring base
        (if (-> this probe?) (set! (-> *rhud-gauge-probe* tag) RHUD_GP_BASE))
        (rhud-set-shader buf RHUD_TBP_GAUGE_EMPTY)
        (rhud-quad buf cx cy RHUD_GAUGE_HALF fx 0.0 (rhud-rgba 128 128 128 128))
        (set! (-> *rhud-gauge-probe* tag) -1)
        (when *target*
          (let* ((remaining (max 0
                                 (min (the-as int
                                              (- (-> *target* fact eco-timeout)
                                                 (the-as uint
                                                         (- (-> *display* game-frame-counter) (-> *target* fact eco-pickup-time)))))
                                      (the-as int (-> *target* fact eco-timeout)))))
                 (frac (fmin 1.0
                             (/ (the float remaining) (the float (the-as uint (-> *FACT-bank* eco-full-timeout))))))
                 (tbp-full RHUD_TBP_GAUGE_BLUE_FULL)
                 (tbp-end RHUD_TBP_GAUGE_BLUE_END))
            (when (> frac 0.0)
              ;; pick the sprite set for the active eco (green falls back to blue)
              (case (-> *target* fact eco-type)
                (((pickup-type eco-yellow))
                 (set! tbp-full RHUD_TBP_GAUGE_YELLOW_FULL)
                 (set! tbp-end RHUD_TBP_GAUGE_YELLOW_END))
                (((pickup-type eco-red))
                 (set! tbp-full RHUD_TBP_GAUGE_RED_FULL)
                 (set! tbp-end RHUD_TBP_GAUGE_RED_END)))
              ;; low-eco blink, same cadence as the stock gauge
              (let ((aa (if (and (< frac 0.2)
                                 (zero? (logand (the int (* DISPLAY_FPS_RATIO (-> *display* integral-frame-counter))) 4)))
                          64
                          128)))
                (set! jfrac frac)
                (set! jwant tbp-full)
                ;; fill: angular mask over the full-gauge sprite
                (if (-> this probe?) (set! (-> *rhud-gauge-probe* tag) RHUD_GP_FAN))
                (rhud-set-shader buf tbp-full)
                (rhud-fan buf cx cy RHUD_GAUGE_HALF fx RHUD_GAUGE_ARC_START (+ RHUD_GAUGE_ARC_START (* RHUD_GAUGE_ARC_SPAN frac)) aa)
                ;; tip: authored at the full position, rotated back to the fill edge
                (if (-> this probe?) (set! (-> *rhud-gauge-probe* tag) RHUD_GP_TIP))
                (rhud-set-shader buf tbp-end)
                (rhud-quad buf cx cy RHUD_GAUGE_HALF fx (* RHUD_GAUGE_ARC_SPAN (- frac 1.0)) (rhud-rgba 128 128 128 aa))
                (set! (-> *rhud-gauge-probe* tag) -1)
                ;; owner round-3 item 3: the ACTIVE eco's real particle system in the center
                ;; hole (the same launcher clone per type; spawn only the active one)
                (let ((idx (case (-> *target* fact eco-type)
                             (((pickup-type eco-yellow)) 2)
                             (((pickup-type eco-red)) 1)
                             (else 0))))
                  ;; ROUND 5 — owner round-4 addendum #2 item 6 ("on dirait les particules de
                  ;; l'éco verte rendue par dessus l'éco bleu"): the three per-type launchers
                  ;; share one screen slot and their layers are :timer (seconds -0.005), i.e.
                  ;; they live until the launch-state is torn down. Nothing killed the PREVIOUS
                  ;; type's cloud on a type switch (the only teardown is hud-hidden :enter, which
                  ;; kills all three), so picking up a second eco left the old colour rendering
                  ;; on top of the new one. Kill the inactive launchers on the switching frame —
                  ;; kill-particles, not kill-and-free-particles, so the user-hvdf index survives.
                  (when (!= idx (-> this last-eco-idx))
                    (dotimes (i (-> this nb-of-particles))
                      (if (!= i idx) (kill-particles (-> this particles i part))))
                    (set! (-> this last-eco-idx) idx))
                  (if (< idx (-> this nb-of-particles)) (spawn (-> this particles idx part) *null-vector*)))))))
        (set! (-> *rhud-gauge-probe* tag) -1)
        ;; hud-eco-gauge : le jugement se fait ICI, sur les sommets qui viennent de partir.
        (if (-> this probe?) (rhud-gauge-judge this jfrac fx jwant)))))
  0
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  hud helper funcs
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  hud-3d-pickups — LES QUATRE EMPLACEMENTS DU HUD EN OBJETS DU JEU
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; L'owner, 17/09 : « pour la mecamouche du HUD, on utilise la vraie mecamouche du jeux et plus un
;; sprite dégueu, pour l'orbe, on utilise une vraie orbe et plus un sprite dégue, pour la particule
;; d'éco verte qui flotte à côté du coeur une vraie particule d'eco verte comme celles qu'on ramasse
;; in game (et pas un truc hacky comme c'est dans le jeu original) et pour la pile d'énergie, idem ! »
;;
;; CE QUE LE JEU D'ORIGINE DESSINE, MESURE DANS LE CODE, EMPLACEMENT PAR EMPLACEMENT :
;;   orbe      `hud-money` porte DEJA le vrai modele du ramassable (`*money-sg*`, manipy,
;;             hud-classes.gc:597) — mais aussi, PAR-DESSUS, un halo plat (`group-part-hud-orb`).
;;             Le « sprite dégueu », c'est ce halo. Le modele reste, le halo part.
;;   pile      `hud-fuel-cell` porte le modele NU (`*fuelcell-naked-sg*`, hud-classes.gc:971), qui
;;             n'est pas celui du ramassable (`*fuel-cell-sg*`), plus un groupe de sprites plats.
;;   mecamouche `hud-buzzers` n'a AUCUNE icone : uniquement le sprite `group-part-hud-buzzer`
;;             (id 81). Le vrai modele existe pourtant : `*buzzer-sg*` (collectables.gc:1211).
;;   eco verte `hud-pickups` lance `group-part-hud-pickup` (id 75). Il n'existe AUCUN modele 3D
;;             d'eco verte dans jak1 : le ramassable est le type `health` (collectables.gc:592),
;;             qui ne pose qu'une collide-shape et dont TOUT le rendu est `group-eco-green` (58).
;;             L'identite du ramassable EST son emetteur : voir l'en-tete du groupe 720 plus haut.
;;
;; CE PROCESS. Il ne touche ni au coeur ni a la jauge (hors perimetre). Il vit hors de
;; `FLAG_RECHARGED_HUD` : le chantier de juillet etait entierement compile derriere ce drapeau, et
;; la cause racine de sa ronde 4 fut exactement cela — « the only thing that was missing on the
;; owner's device was the compile flag ». Ici la couche est dans le binaire livre et suit le
;; maitre Recharged (`recharged-master?`, defaut ALLUME) ; le bras d'ablation du harnais
;; (`__pc-autoport-disarmed-for`) rend le HUD d'origine.
;;
;; LES DEUX ICONES VIVANTES. Sur la pile, le modele d'origine (icone 0) ET le vrai modele
;; (icone 1) restent spawnes tous les deux ; une seule est dessinee. C'est ce qui rend le banc de
;; cout alternable DANS UNE SEULE COURSE sans respawn — un respawn de manipy coute plus cher que
;; ce que le banc mesure, et deux courses separees mesureraient la scene qui derive.

;; ── §9 LA MESURE DE POSITION QUI N'EST PAS UN MIROIR ─────────────────────────────────────────
;;
;; CE QUE L'ESSAI 2 A PUBLIE, ET POURQUOI IL RENDAIT 0 SUR UNE PILE VISIBLEMENT FAUSSE.
;; Son terme §3 pour la pile comparait `(-> fc 0 icons 1 icon-x)` a `(-> fc 0 icons 0 icon-x)`.
;; Or `hud3d-set-regime` POSE, a chaque image, `icons 1 icon-x = icons 0 icon-x + cell-dx` — et
;; `cell-dx` valait 0. La porte relisait donc la valeur qu'elle venait d'ecrire. Le terme de
;; taille faisait pire : `cell-our-ext = sc * r1` etait compare a `cell-stock-ext = scale0 * r0`
;; avec `sc = scale0 * r0 / r1`, c'est-a-dire `scale0*r0` des deux cotes — une egalite vraie par
;; ALGEBRE, quelle que soit l'image. Aucune des deux grandeurs ne pouvait rougir : c'etaient des
;; miroirs de notre propre placement, pas des mesures. Et toutes deux vivaient en UNITES DE
;; CANEVAS, jamais en pixels : meme justes, elles ne voyaient ni l'echelle du modele a l'ecran,
;; ni son rapport largeur/hauteur, ni le renderer qui l'emet.
;;
;; CE QUE CELLE-CI MESURE. `hud_box_probe` (game/graphics/opengl_renderer/hud_box_probe.cpp) lit
;; deux fois la FBO de rendu — une image ou l'element est cache, une image ou il est dessine — et
;; retient les pixels qui ont change. La sequence ci-dessous est ce qui fabrique ces paires. Elle
;; ne tourne QUE sous `debug.opengoal.costprobe=hud-3d-pickups` : le joueur ne voit jamais son
;; HUD clignoter.
;;
;; POURQUOI QUATRE IMAGES PAR PHASE. Le fil GOAL construit la chaine DMA que le rendu consomme
;; ensuite : la capture demandee a l'image F peut porter sur une image anterieure. Tenir chaque
;; phase QUATRE images et ne demander la capture qu'a la derniere rend la mesure juste tant que
;; le retard n'excede pas trois images — au lieu d'apparier deux etats differents en silence.
(defconstant HUD3D_PX_HOLD 4)     ;; images par phase ; la capture tombe sur la derniere
(defconstant HUD3D_PX_PHASES 10)  ;; reference, pile d'origine, reference, notre pile, ... controle
(defconstant HUD3D_PX_MIN 8)      ;; paires exigees avant de juger un emplacement
;; Le plafond de paires, le MEME que `kMaxPairs` de hud_box_probe.cpp. Au-dela, le C++ refuse
;; d'accumuler ; la sequence s'arrete ici pour que le banc de cout (§4) mesure ensuite des images
;; que l'instrument ne touche plus. Un desaccord entre les deux valeurs ne fausse rien : il
;; allonge ou raccourcit la sequence, il ne change aucune boite.
(defconstant HUD3D_PX_PAIRS 48)

(defun hud3d-px-hold-for ((cycle int))
  "LA DUREE D'UNE PHASE, QUI N'EST PAS CONSTANTE. Le bruit d'une scene de jeu n'est pas blanc :
   les animations du monde sont PERIODIQUES. Une paire prise toujours au meme intervalle retombe
   sur la meme phase de ces animations, donc sur les memes pixels, et le filtre d'accord de
   `hud_box_probe` la prend pour un element (mesure du 17/09 : 57 pixels survivaient au slot de
   CONTROLE, ou il n'y a par construction rien a voir). Faire varier l'intervalle decorrele la
   phase d'une paire a l'autre ; le plancher minimal de 4 images reste, lui, impose par le retard
   entre le fil GOAL et le rendu."
  (+ HUD3D_PX_HOLD (mod cycle 5)))

(defun hud3d-px-shown ((ph int))
  "l'emplacement que cette phase montre. -1 = tout cache (image de reference)."
  (cond ((= ph 1) 1) ((= ph 3) 2) ((= ph 5) 3) ((= ph 7) 4) (else -1)))

(defun hud3d-px-capture ((ph int))
  "le slot a capturer a la fin de cette phase. 0 = image de reference ; 5 = CONTROLE, deux images
   du meme etat : ce qui y survit est le plancher de l'instrument, et il doit etre vide."
  (cond ((= ph 1) 1) ((= ph 3) 2) ((= ph 5) 3) ((= ph 7) 4) ((= ph 9) 5) (else 0)))

(defconstant HUD3D_BENCH_BLOCK 40)   ;; images par regime dans le banc de cout
(defconstant HUD3D_BENCH_SETTLE 6)   ;; images jetees apres chaque bascule
(defconstant HUD3D_BENCH_MIN 300)    ;; images exigees par regime (livrable §4)

;; Les indices du tableau `parts` de `*hud-parts*` (hud-h.gc:114, superpose a `pickups`). On passe
;; par lui et non par les champs nommes : il est type `(pointer hud)`, donc aucune conversion.
(defconstant HUD3D_SLOT_PICKUPS 0)
(defconstant HUD3D_SLOT_MONEY 1)
(defconstant HUD3D_SLOT_CELL 2)
(defconstant HUD3D_SLOT_BUZZERS 4)
(defconstant HUD3D_SLOT_MONEY_ALL 8)

;; LES DEUX EMETTEURS DE CE PROCESS : l'eco verte au slot des ramassages, la lueur de la pile.
(defconstant HUD3D_PART_ECO 0)
(defconstant HUD3D_PART_GLOW 1)
;; le terme §10 n'est declare mesure qu'au-dela de ce nombre d'images ou la pile est dessinee
(defconstant HUD3D_GLOW_MIN 300)

;; L'ORBE NE DESSINE AUCUN MODELE, ET CE N'EST PAS CETTE COUCHE (mesure du 17/09, bureau).
;; `hud-money` porte deja le vrai modele du ramassable (`*money-sg*`, hud-classes.gc:597), mais son
;; icone revient SANS SQUELETTE : `hud3d_orb_state=3`. Le bras d'ablation, ou rien de ce fichier ne
;; tourne, publie le MEME 3 — le defaut preexiste a l'item. Ce qui est etabli :
;;   * le groupe d'art EST charge : `hud3d_artgrp_money=1` (et `_any=1`) ;
;;   * un respawn echoue exactement pareil, 200 fois sur 200 : `hud3d_orb_spawn_noskel=200`,
;;     `hud3d_orb_spawn_null=0` — ce n'est ni le pool de process ni une fenetre de chargement ;
;;   * ramener la liste des detours de detail a un seul maillage (money-lod0-mg) ne change RIEN :
;;     `setup-lods!` n'est donc pas le chemin d'echec.
;; Restent, dans `initialize-skeleton` (process-drawable.gc:390-398), la garde `joint-geo` — un
;; indice d'element d'art fige a la COMPILATION qui ne designerait plus un `art-joint-geo` dans le
;; `money-ag` reellement charge. La chaine HD (`HD-MODELS merc-load model=money-lod0/1/2`) touche
;; ces memes groupes d'art sur le bureau et PAS sur l'appareil livre : c'est la piste, et c'est la
;; course appareil qui tranchera. Consigne dans reports/hud-3d-pickups/FINDINGS.txt.
;; La reparation ci-dessous reste en place et plafonnee : elle repare le jour ou l'art se resout.

(deftype hud-3d-pickups (hud-pc)
  ((on?             symbol)
   (probe?          symbol)
   (regime          int32)   ;; 0 = notre couche, 1 = l'origine
   (block-n         int32)
   (cell-proc       process)
   (buzz-proc       process)
   (pick-proc       process)
   (cell-scale      float)
   (cell-stock-ext  float)
   (cell-our-ext    float)
   (orb-ext         float)
   (buzz-ext        float)
   (buzz-ref-sx     float)
   (buzz-ref-sy     float)
   (eco-compared    int32)
   (eco-excluded    int32)
   (eco-mismatch    int32)
   (bench-last      int64)
   (bench-sum-a     int64)
   (bench-sum-b     int64)
   (bench-n-a       int32)
   (bench-n-b       int32)
   (judged          int32)
   (stock-spawns    int32)
   (off-checks      int32)
   (off-bad         int32)
   (id-bad          int32)
   (rect-bad        int32)
   (slots-drawn     int32)
   (live-slots      int32)
   (orb-tries       int32)
   (orb-null        int32)
   (orb-noskel      int32)
   ;; §6 la visibilite : une population par emplacement, lue sur le draw-control
   (vis-frames      int32)
   (was-hid         uint32)
   (vis-bad-buzz    int32)
   (vis-bad-cell    int32)
   (vis-bad-orb     int32)
   (vis-bad-eco     int32)
   (vis-ok-buzz     int32)
   (vis-ok-cell     int32)
   (vis-ok-orb      int32)
   (vis-ok-eco      int32)
   (vis-hid-buzz    int32)
   (vis-hid-cell    int32)
   (vis-hid-orb     int32)
   (vis-hid-eco     int32)
   ;; le decalage constant entre l'icone d'origine de la pile et la notre
   (cell-dx         int32)
   (cell-dy         int32)
   ;; §7 le placement de la mecamouche, et le temoin que le jeu en donne
   (buzz-icon-x     int32)
   (buzz-icon-y     int32)
   (buzz-nd-x       int32)
   (buzz-nd-y       int32)
   ;; §10 l'effet lumineux de la pile (owner, 18/09)
   (glow-compared   int32)
   (glow-excluded   int32)
   (glow-mismatch   int32)
   (glow-from-stock int32)
   (glow-frames     int32)
   (glow-spawns     int32)
   (glow-missing    int32)
   (glow-bad        int32)
   (glow-alloc      int32)
   (glow-alloc-max  int32)
   ;; §9 la sequence qui fait lire la BOITE ENGLOBANTE sur l'image rendue
   (px-phase        int32)
   (px-hold         int32)
   (px-cycles       int32)
   (px-bad          int32)
   (px-on           symbol)
   (px-paused       symbol)))

;;;----------------------------------------------
;;  petites mesures
;;;----------------------------------------------

(defun hud3d-elt ((idx int))
  "L'element de HUD de ce slot, SEULEMENT s'il est encore vivant — sinon #f.
   POURQUOI CE CONTROLE EXISTE. `*hud-parts*` garde des ppointeurs que `deactivate` ne remet pas
   tous a zero (gkernel.gc:1903 ne touche pas `self`), et `activate-hud` ECRASE ses six slots sans
   tuer les process precedents (hud-classes.gc:1417). Un slot peut donc designer un emplacement du
   pool repris par un AUTRE process : `(-> p 0 icons 0 icon)` y lit alors un pointeur quelconque,
   et le deref suivant tombe en SIGSEGV. Mesure du 17/09 sur le bureau : le jeu mourait a l'image
   675, au changement de niveau, exactement la ou le HUD est re-active — le bras d'ablation, lui,
   tenait 11 292 images.
   Le controle porte sur le TYPE RELU A L'ADRESSE et sur la presence d'un etat, pas sur le
   pointeur : c'est la seule chose qui distingue un slot vivant d'un slot recycle."
  (let ((p (-> *hud-parts* parts idx)))
    (if (and p
             (nonzero? (-> p 0))
             (type-type? (-> p 0 type) hud)
             (nonzero? (-> p 0 next-state))
             (-> p 0 next-state))
      p
      (the-as (pointer hud) #f))))

(defun hud3d-icon-live? ((ic (pointer manipy)))
  "vrai quand le slot porte un PROCESS vivant — le type relu a l'adresse et un etat present."
  (and (nonzero? ic)
       ic
       (nonzero? (-> ic 0))
       (type-type? (-> ic 0 type) manipy)
       (nonzero? (-> ic 0 next-state))
       (-> ic 0 next-state)
       #t))

(defun hud3d-drop-dead-icons ((p (pointer hud)))
  "UN SLOT D'ICONE MORT DOIT CESSER D'EXISTER POUR L'ELEMENT A L'IMAGE MEME.
   `hud::draw-icons` (hud.gc:72-88) parcourt `nb-of-icons` et dereference `icons i icon 0 root`
   SANS verifier quoi que ce soit : un manipy dont le process est mort — l'art de son niveau
   dechargee, par exemple — y devient un pointeur quelconque, et le jeu tombe.
   MESURE DU 17/09 (bureau) : avec ce controle espace de 15 images, SIGSEGV a l'image 675, au
   changement de niveau, TROIS courses de suite au MEME endroit ; avec le controle a chaque image,
   13 490 images sans incident (bras d'ablation : 11 292). Ce n'est pas une precaution, c'est la
   difference entre un jeu qui tourne et un jeu qui meurt.
   On tronque a la plus longue suite d'icones vivantes : `draw-icons` s'arrete avant le trou."
  (when p
    (let ((n 0)
          (stop #f))
      (dotimes (i (-> p 0 nb-of-icons))
        (when (not stop)
          (cond
            ((and (nonzero? (-> p 0 icons i)) (-> p 0 icons i) (hud3d-icon-live? (-> p 0 icons i icon)))
             (+! n 1))
            (else (set! stop #t)))))
      (when (< n (-> p 0 nb-of-icons))
        (dotimes (i (-> p 0 nb-of-icons))
          (when (and (>= i n) (nonzero? (-> p 0 icons i)) (-> p 0 icons i))
            (set! (-> p 0 icons i icon) (the-as (pointer manipy) #f))))
        (set! (-> p 0 nb-of-icons) n))))
  (none))

(defun hud3d-alive? ((ic (pointer manipy)))
  "vrai quand ce slot dessine VRAIMENT un modele.
   LE PIEGE, MESURE LE 17/09. Le test evident — « le manipy a-t-il un squelette ? » — est FAUX, et
   c'est lui qui a fait declarer l'orbe mort pendant tout cet essai. `initialize-skeleton`
   (process-drawable.gc:434-447) ne cree un `joint-control` que si la geometrie de squelette declare
   `joint-channel > 0` ; un modele RIGIDE comme l'orbe (`money`) en declare zero, son `skel` reste
   legitimement nul, et il dessine parfaitement. Les mesures qui ont mene ici : groupe d'art charge
   (`hud3d_artgrp_money=1`), garde `joint-geo` passee (`hud3d_money_jgeo_ok=1`), 5 elements dans
   `money-ag` — tout etait sain, sauf la question qu'on posait.
   Le controle de juillet (`rhud-icon-alive?`, plus haut dans ce fichier) porte la meme erreur.
   Ce qui dit qu'un modele sera dessine, c'est son `draw-control` et le groupe d'art qui y pend."
  (and (hud3d-icon-live? ic)
       (nonzero? (-> ic 0 draw))
       (nonzero? (-> ic 0 draw art-group))
       #t))

(defun hud3d-art-name ((ic (pointer manipy)))
  "le NOM DU GROUPE D'ART reellement attache au modele dessine. C'est la meme chaine que
   `(-> skeleton-group art-group-name)` : `defskelgroup` la fabrique par `symbol->string` du nom
   d'art (art-h.gc:292) et `load-to-heap-by-name` rend l'objet qui la porte. Precedent :
   title-obs.gc:148 compare `(-> self draw art-group name)` a un litteral."
  (if (and (hud3d-alive? ic) (nonzero? (-> ic 0 draw)) (nonzero? (-> ic 0 draw art-group)))
    (-> ic 0 draw art-group name)
    (the-as string #f)))

(defun hud3d-ext ((ic (pointer manipy)) (scale float))
  "l'ETENDUE d'une icone de HUD, dans l'unite ou elle se compare a une AUTRE icone du meme slot :
   echelle de l'icone x rayon du modele. Le facteur de projection du HUD est le meme pour les deux,
   il se simplifie — on ne publie donc jamais un pixel qu'on n'a pas su calculer."
  (if (and (hud3d-alive? ic) (nonzero? (-> ic 0 draw))) (* scale (-> ic 0 draw bounds w)) 0.0))

;;;----------------------------------------------
;;  LA LOI DE PLACEMENT — ou va le modele qui remplace un sprite
;;;----------------------------------------------
;;
;; LES DEUX REPERES NE SONT PAS LE MEME (hud.gc:72-116, mesure du 17/09). Un sprite de HUD et une
;; icone de HUD ne se posent pas par la meme formule :
;;   sprite : pos.y = 1/2 (rel_y (init_y + ...) - screen_sy)      (`draw-particles`)
;;   icone  : trans.y = icon_y + ... - screen_sy                  (`draw-icons`)
;; L'essai 1 recopiait `init_y` dans `icon_y`. En unites d'icone le sprite est a `rel_y init_y`,
;; l'icone a `icon_y` : recopier revient a poser le modele TROP HAUT de tout le decalage du
;; modele — « un poil trop haute » (owner, 17/09), 32 unites sur 448, soit ~77 px sur l'appareil.
;;
;; ET UN MODELE NE SE POSE PAS PAR SON CENTRE. `draw-icons` pose son ORIGINE ; le sprite, lui, est
;; centre sur sa position. Le decalage entre les deux est la donnee que le jeu porte deja :
;; `(-> skeleton-group bounds)`, la sphere que `initialize-skeleton` recopie dans le draw-control
;; (process-drawable.gc:416). Pour la mecamouche elle vaut (0, 1 metre, 0) : le corps est a 4096
;; unites au-dessus de l'origine du modele.
;;
;;   icon_x = init_x - bounds_x * scale_x * rel_x
;;   icon_y = rel_y * (init_y - bounds_y * scale_y)
;;
;; LE TEMOIN, ET IL N'EST PAS DE NOUS. Le jeu declare lui-meme ou va l'icone de la mecamouche :
;; `get-icon-pos-y` sur `hud-buzzers` (hud-classes.gc:1146) rend `text-y + 50` = 412 — la methode
;; que `hud-collecting` (hud.gc:316) utilise pour faire voler la mouche ramassee vers le HUD, dans
;; le repere des ICONES. La loi ci-dessus rend 412,77 a partir du sprite (380) et des bornes du
;; modele (4096) : deux sources independantes du jeu, 0,77 unite d'ecart. C'est le terme §7.
;; (`get-icon-pos-x` rend `text-x` = 85, la position du TEXTE et non de l'icone : l'owner a valide
;; l'abscisse actuelle, on garde celle du sprite. Consigne dans FINDINGS.txt.)

(defun hud3d-icon-x-for-sprite ((init-x float) (cx float) (sx float))
  "l'abscisse d'icone qui pose le CENTRE du modele la ou le sprite d'origine etait."
  (the int (- init-x (* cx sx (-> *video-parms* relative-x-scale)))))

(defun hud3d-icon-y-for-sprite ((init-y float) (cy float) (sy float))
  "l'ordonnee d'icone qui pose le CENTRE du modele la ou le sprite d'origine etait."
  (the int (* (-> *video-parms* relative-y-scale) (- init-y (* cy sy)))))

(defun hud3d-icon-drawn? ((ic (pointer manipy)))
  "vrai quand ce modele est EFFECTIVEMENT soumis au rendu. La grandeur est le bit `hidden` de son
   draw-control — celui que le moteur lit — et non un drapeau a nous : c'est ce qui rend le terme
   §6 mesurable au lieu d'etre un miroir de notre propre decision."
  (and (hud3d-alive? ic) (not (logtest? (-> ic 0 draw status) (draw-status hidden))) #t))

(defun hud3d-vis-verdict ((this hud-3d-pickups) (hid object) (drawn object) (bit int))
  "0 rien a compter · 1 DESSINE alors que l'element d'origine est cache (le defaut du 17/09) ·
   2 dessine quand l'element d'origine est la · 3 efface quand il faut.
   L'etat cache doit tenir DEUX images avant de compter : notre process et les elements de HUD ne
   tournent pas dans un ordre garanti dans l'image, et l'image de la bascule se lirait des deux
   cotes. Le defaut que l'owner a vu durait, lui, toute la sequence d'amorcage."
  (let ((was (logtest? (-> this was-hid) (ash 1 bit))))
    (if hid
      (logior! (-> this was-hid) (ash 1 bit))
      (logclear! (-> this was-hid) (ash 1 bit)))
    (cond
      ((and hid was) (if drawn 1 3))
      (hid 0)
      (else (if drawn 2 0)))))

(defun hud3d-spawned-this-frame? ((lc sparticle-launch-control))
  "vrai quand CE lanceur a lance a l'image courante ou a la precedente. La grandeur vient du
   lanceur, pas de notre drapeau : `spawn` ecrit `last-spawn-frame` a chaque appel
   (sparticle-launcher.gc:710).
   DEUX PIEGES, MESURES SUR LE BUREAU LE 17/09 :
   1. le compteur ecrit est `real-actual-frame-counter`, PAS `integral-frame-counter`. La premiere
      version comparait au second : elle rendait FAUX pour toujours, et la porte « plus de sprite
      d'origine » aurait ete verte sans jamais rien mesurer.
   2. l'ordre d'execution des process dans l'image n'est pas garanti — notre process vit dans le
      `*display-pool*`, les elements d'origine sous `*target*`. Une fenetre d'UNE image evite de
      lire un lanceur qui n'a pas encore tourne. Elle penche du cote qui COMPTE le lancement :
      pour une porte qui exige zero, c'est le sens prudent."
  (and (nonzero? lc) (>= (-> lc last-spawn-frame) (+ -1 (the int (-> *display* real-actual-frame-counter))))))

(defun hud3d-stock-spawned ((p (pointer hud)) (idx int))
  (if (and p (> (-> p 0 nb-of-particles) idx) (hud3d-spawned-this-frame? (-> p 0 particles idx part))) 1 0))

;;;----------------------------------------------
;;  §10 L'EFFET LUMINEUX DE LA PILE
;;;----------------------------------------------

(defun hud3d-glow-place! ((this hud-3d-pickups) (ic (pointer manipy)))
  "POSE LA LUEUR SUR LE CENTRE DU MODELE, DANS LE REPERE OU LE JEU POSE SES SPRITES DE HUD.
   `draw-icons` (hud.gc:72-88) ecrit a chaque image l'ORIGINE du modele dans `root trans`, repli du
   HUD compris : c'est la meme donnee qui fait glisser la pile quand le HUD s'ouvre, et elle vient
   de l'element D'ORIGINE, pas de nous. Le centre du corps est cette origine plus le centre de la
   sphere du modele, a l'echelle que `draw-icons` vient de poser (elle porte deja
   `relative-x/y-scale`, donc l'aspect).
   Le passage du repere des ICONES a celui des SPRITES est celui du jeu lui-meme, releve sur
   `hud-fuel-cell::hud-update` (hud-classes.gc:948-952) : x tel quel, y divise par deux, z = 2,0.
   Aucun pixel d'appareil, aucune constante de resolution."
  (let ((p (-> this particles HUD3D_PART_GLOW)))
    (set! (-> p pos x) (+ (-> ic 0 root trans x) (* (-> ic 0 draw bounds x) (-> ic 0 root scale x))))
    (set! (-> p pos y) (* 0.5 (+ (-> ic 0 root trans y) (* (-> ic 0 draw bounds y) (-> ic 0 root scale y)))))
    (set! (-> p pos z) 2.0)
    (when (> (-> p part matrix) 0)
      (set-vector! (sprite-get-user-hvdf (-> p part matrix))
                   (the float (+ (the int (-> p pos x)) 2048))
                   (the float (+ (the int (-> p pos y)) 2048))
                   (- (-> *math-camera* hvdf-off z) (* 1024.0 (-> p pos z)))
                   (-> *math-camera* hvdf-off w))))
  (none))

(defun hud3d-glow-drive ((this hud-3d-pickups) (fc (pointer hud)) (want symbol))
  "LA LUEUR VIT ET MEURT AVEC LE MODELE QU'ELLE ENTOURE, PAS AVEC NOTRE PROCESS.
   Notre process suit l'element RAMASSAGES (c'est lui qui porte l'eco verte) : il se replie alors
   que la pile, elle, est encore dessinee — 6 387 images de pile affichee contre 6 001 pour les
   ramassages a la course du 17/09. Une lueur lancee depuis `draw-hud`, que le jeu n'appelle pas
   quand le process est replie, aurait donc clignote. Tout se fait donc ici, depuis `hud-update`,
   que TOUS les etats appellent (hud.gc:180, 224, 252), et la condition est le bit `hidden` du
   draw-control de la pile : la lueur parait et disparait EXACTEMENT avec le modele.
   LE TEMOIN SE LIT AVANT LE LANCEMENT DE CETTE IMAGE. Il porte donc sur l'image PRECEDENTE et non
   sur la ligne qu'on vient d'ecrire : ce n'est pas un miroir de notre propre decision.
   Rend 1 si la pile est dessinee a cette image."
  (let ((drawn #f))
    ;; EN PAUSE, ON NE TOUCHE A RIEN — ni recensement, ni lancement, ni liberation. C'est ce que
    ;; fait le jeu pour ses propres sprites de HUD (`hud::draw-hud`, hud.gc:24) : les particules
    ;; deja vivantes restent figees a l'ecran et rien de neuf ne part. La sequence de mesure de
    ;; boite (§9) met justement le jeu en pause : elle passe par ici aussi.
    (when (and (> (-> this nb-of-particles) HUD3D_PART_GLOW) (not (paused?)))
      (let* ((pa (-> this particles HUD3D_PART_GLOW))
             (lc (-> pa part))
             (ic (if (and fc (> (-> fc 0 nb-of-icons) 1))
                   (-> fc 0 icons 1 icon)
                   (the-as (pointer manipy) #f)))
             (spawned-prev (hud3d-spawned-this-frame? lc))
             (prev (logtest? (-> this was-hid) (ash 1 5)))
             (prev2 (logtest? (-> this was-hid) (ash 1 6))))
        (set! drawn (if (and want (hud3d-icon-drawn? ic)) #t #f))
        ;; LE RECENSEMENT NE JUGE QUE LES IMAGES OU L'ETAT N'A PAS CHANGE, et il ne compte pas le
        ;; meme nombre d'images des deux cotes. C'est la lecon que l'eco verte a deja payee, juste
        ;; en-dessous : le temoin de lancement regarde UNE image DESSINEE en arriere, et sur cet
        ;; appareil le fil de logique tourne a 60 pendant que l'image, elle, sort a ~22 —
        ;; `real-actual-frame-counter` ne bouge donc pas a chaque appel d'ici. Un lancement
        ;; legitime reste visible au temoin pendant DEUX images de logique.
        ;;   - « la pile dessinee sans sa lueur » : deux images suffisent, le temoin ne peut que
        ;;     PERDRE un lancement, jamais en inventer un.
        ;;   - « la lueur sans la pile » : il en faut TROIS, sinon on impute au repli le lancement
        ;;     de l'image d'avant. Mesure du 18/09, meme course : 46 accusations a deux images,
        ;;     toutes a une bascule, contre 0 a trois.
        (cond
          ((and drawn prev)
           (+! (-> this glow-frames) 1)
           (if spawned-prev (+! (-> this glow-spawns) 1) (+! (-> this glow-missing) 1)))
          ((and (not drawn) (not prev) (not prev2))
           (if spawned-prev (+! (-> this glow-bad) 1))))
        (if prev (logior! (-> this was-hid) (ash 1 6)) (logclear! (-> this was-hid) (ash 1 6)))
        (if drawn (logior! (-> this was-hid) (ash 1 5)) (logclear! (-> this was-hid) (ash 1 5)))
        ;; puis l'emission elle-meme
        (cond
          (drawn
           ;; notre process rend son emplacement d'ecran en entrant dans `hud-hidden`
           ;; (hud.gc:167-169) ; on le reprend, une fois, quand il manque.
           (if (= (-> pa part matrix) -1) (set! (-> pa part matrix) (sprite-allocate-user-hvdf)))
           (hud3d-glow-place! this ic)
           ;; COMBIEN DE FOIS PAR IMAGE : la grandeur est le nombre de particules que le SYSTEME
           ;; alloue de part et d'autre de notre lancement (sparticle.gc:141/165), pas un compteur
           ;; a nous. Les deux etoiles sont permanentes et ne sont relancees qu'une image toutes
           ;; les 12 s ; les flares, eux, tombent a chaque image (`:num` 0,5 et 0,06).
           (let ((n0 (+ (-> *sp-particle-system-2d* num-alloc 0) (-> *sp-particle-system-2d* num-alloc 1))))
             (spawn lc *null-vector*)
             (let ((d (- (+ (-> *sp-particle-system-2d* num-alloc 0) (-> *sp-particle-system-2d* num-alloc 1)) n0)))
               (when (> d 0)
                 (+! (-> this glow-alloc) d)
                 (if (> d (-> this glow-alloc-max)) (set! (-> this glow-alloc-max) d))))))
          ;; LES DEUX ETOILES SONT PERMANENTES (`:timer (seconds -0.005)`) : sans ce geste, elles
          ;; resteraient a l'ecran apres le repli de la pile. Une seule fois, a la bascule.
          (else (if (and prev (nonzero? lc)) (kill-particles lc))))))
    (if drawn 1 0)))

;;;----------------------------------------------
;;  l'identite de l'emetteur d'eco verte
;;;----------------------------------------------

;; Les champs que S1..S7 transposent. Tout le reste doit etre EGAL a la donnee du ramassable.
(defun hud3d-eco-field-excluded? ((f int))
  (or (= f (sp-field-id spt-flags))          ;; S2 bit14 -> bit9
      (= f (sp-field-id spt-func))           ;; S3 callbacks lies a l'emetteur
      (= f (sp-field-id spt-next-time))      ;; S4 relances de fondu
      (= f (sp-field-id spt-next-launcher))
      (= f (sp-field-id spt-x))              ;; S5 decalage monde de l'ancre
      (= f (sp-field-id spt-y))
      (= f (sp-field-id spt-z))              ;; S6 ordre de superposition du HUD
      (= f (sp-field-id spt-scale-x))        ;; S7 gabarit du slot
      (= f (sp-field-id spt-scale-y))
      (= f (sp-field-id spt-scalevel-x))
      (= f (sp-field-id spt-scalevel-y))
      (= f (sp-field-id spt-vel-x))
      (= f (sp-field-id spt-vel-y))
      (= f (sp-field-id spt-vel-z))
      (= f (sp-field-id spt-accel-x))
      (= f (sp-field-id spt-accel-y))
      (= f (sp-field-id spt-accel-z))))

(defun hud3d-glow-field-excluded? ((f int))
  "LES SIX CHAMPS QUE NAUGHTY DOG TRANSPOSE en passant la lueur de la pile DU MONDE (228..231) a
   celle de l'ICONE DE HUD (319..322). Tout le reste doit etre EGAL, et c'est ce que
   `hud3d_glow_world_mismatch` compte.
   G1 `flags` : bit14 (sprite du monde) -> bit9 (sprite d'espace-ecran).
   G2 `z` : la profondeur devient l'ordre de superposition du HUD ((meters 22.5)).
   G3/G4 `scale-x`/`scale-y` : le gabarit passe de celui de l'objet pose au sol a celui du slot —
        et pour les deux etoiles il est REPOSE a chaque image par les callbacks d'aspect de
        l'element pile (`fuel-cell-hud-starburst-3/4-callback`, hud-classes.gc:816-848). C'est la
        que le 4:3 et le 16:9 se decident, et c'est de la donnee du jeu.
   G5 `func` : dans le monde la particule SUIT le prim de collision de la pile
        (`sparticle-track-root-prim`) ; a l'ecran elle prend la taille de l'element.
   G6 `timer` : les deux nuees de flares vivent 1 s dans le monde, ou l'emetteur se deplace avec
        l'objet ramassable ; a l'ecran ND les laisse sur la chaine de fondu 232, qui les eteint."
  (or (= f (sp-field-id spt-flags))
      (= f (sp-field-id spt-z))
      (= f (sp-field-id spt-scale-x))
      (= f (sp-field-id spt-scale-y))
      (= f (sp-field-id spt-func))
      (= f (sp-field-id spt-timer))))

(defun hud3d-field-excluded? ((f int) (dst int))
  "0 = l'eco verte (S1..S7), 1 = la lueur de la pile (G1..G6)."
  (if (zero? dst) (hud3d-eco-field-excluded? f) (hud3d-glow-field-excluded? f)))

(defun hud3d-cmp-bump! ((this hud-3d-pickups) (dst int) (which int))
  "0 compare · 1 exclu · 2 ecart, sur les compteurs de l'emetteur `dst`."
  (cond
    ((zero? dst)
     (cond ((zero? which) (+! (-> this eco-compared) 1))
           ((= which 1) (+! (-> this eco-excluded) 1))
           (else (+! (-> this eco-mismatch) 1))))
    (else
     (cond ((zero? which) (+! (-> this glow-compared) 1))
           ((= which 1) (+! (-> this glow-excluded) 1))
           (else (+! (-> this glow-mismatch) 1)))))
  0)

(defun hud3d-cmp-part ((this hud-3d-pickups) (ours int) (world int) (dst int))
  "compare champ par champ le lanceur `ours` a celui du RAMASSABLE `world`, dans
   `*part-id-table*`. Compte ce qui est compare, ce qui est exclu par S1..S7, et ce qui DIFFERE
   en dehors de ces exclusions. Un champ present d'un cote et absent de l'autre compte comme un
   ecart : c'est ce qui empeche la porte d'etre verte parce qu'on a oublie une ligne."
  (let ((a (-> *part-id-table* ours))
        (b (-> *part-id-table* world)))
    (when (and (nonzero? a) (nonzero? b))
      ;; les champs de NOTRE lanceur, retrouves dans celui du monde
      (let ((i 0))
        (while (!= (-> a init-specs i field) (sp-field-id spt-end))
          (let ((f (the int (-> a init-specs i field))))
            (cond
              ((hud3d-field-excluded? f dst) (hud3d-cmp-bump! this dst 1))
              (else
               (hud3d-cmp-bump! this dst 0)
               (let ((found #f) (j 0))
                 (while (!= (-> b init-specs j field) (sp-field-id spt-end))
                   (when (= (the int (-> b init-specs j field)) f)
                     (set! found #t)
                     (if (or (!= (-> a init-specs i initial-value) (-> b init-specs j initial-value))
                             (!= (-> a init-specs i random-range) (-> b init-specs j random-range))
                             (!= (-> a init-specs i random-mult) (-> b init-specs j random-mult))
                             (!= (-> a init-specs i flags) (-> b init-specs j flags)))
                       (hud3d-cmp-bump! this dst 2)))
                   (+! j 1))
                 (if (not found) (hud3d-cmp-bump! this dst 2))))))
          (+! i 1)))
      ;; les champs du RAMASSABLE absents de chez nous
      (let ((j 0))
        (while (!= (-> b init-specs j field) (sp-field-id spt-end))
          (let ((f (the int (-> b init-specs j field))))
            (when (not (hud3d-field-excluded? f dst))
              (let ((found #f) (i 0))
                (while (!= (-> a init-specs i field) (sp-field-id spt-end))
                  (if (= (the int (-> a init-specs i field)) f) (set! found #t))
                  (+! i 1))
                (if (not found) (begin (hud3d-cmp-bump! this dst 0) (hud3d-cmp-bump! this dst 2))))))
          (+! j 1))))
    0))

(defun hud3d-eco-identity ((this hud-3d-pickups))
  "l'identite de l'emetteur d'eco verte, calculee UNE fois : 2980<-202, 2981<-203, 2982<-204,
   2983<-205, 2984<-208."
  (set! (-> this eco-compared) 0)
  (set! (-> this eco-excluded) 0)
  (set! (-> this eco-mismatch) 0)
  (hud3d-cmp-part this 2980 202 0)
  (hud3d-cmp-part this 2981 203 0)
  (hud3d-cmp-part this 2982 204 0)
  (hud3d-cmp-part this 2983 205 0)
  (hud3d-cmp-part this 2984 208 0)
  0)

(defun hud3d-glow-identity ((this hud-3d-pickups))
  "L'IDENTITE DE L'EFFET LUMINEUX, EN DEUX GRANDEURS ET AUCUNE AFFIRMATION.
   (a) `glow-from-stock` : chacun des quatre items de NOTRE groupe (724) est cherche, PAR SON
       NUMERO, dans le groupe que le jeu lance pour cette icone (80). Il doit valoir 4.
   (b) `glow-mismatch` : ces quatre lanceurs, champ par champ, contre ceux de la pile DU MONDE
       (228..231 du groupe 63), aux transpositions G1..G6 pres. Il doit valoir 0."
  (set! (-> this glow-from-stock) 0)
  (let ((g (-> *part-group-id-table* 724))
        (k (-> *part-group-id-table* 80)))
    (when (and (nonzero? g) (nonzero? k))
      (dotimes (i (the int (-> g length)))
        (let ((id (-> g launcher i launcher)))
          (dotimes (j (the int (-> k length)))
            (if (= id (-> k launcher j launcher)) (+! (-> this glow-from-stock) 1)))))))
  (set! (-> this glow-compared) 0)
  (set! (-> this glow-excluded) 0)
  (set! (-> this glow-mismatch) 0)
  (hud3d-cmp-part this 319 228 1)
  (hud3d-cmp-part this 320 229 1)
  (hud3d-cmp-part this 321 230 1)
  (hud3d-cmp-part this 322 231 1)
  0)

;;;----------------------------------------------
;;  les quatre emplacements
;;;----------------------------------------------

(defun hud3d-drive-cell-anim ((ic (pointer manipy)))
  "la pile du HUD joue comme celle du MONDE : `fuel-cell-idle-ja` a (loop! 0.5), soit la MOITIE de
   la cadence propre au manipy — « animation beaucoup trop vite » (owner). Et une pile du monde ne
   tourne pas sur elle-meme : son mouvement est dans l'anim, le lacet etait celui de l'element de
   HUD d'origine."
  (when (and (hud3d-alive? ic) (nonzero? (-> ic 0 skel)))
    (let ((jg (-> ic 0 skel root-channel 0 frame-group)))
      (when (and (nonzero? jg) jg)
        (let ((leni (+ (-> jg data 0 length) -1)))
          (when (> leni 0)
            (let ((hf (mod (the int (* DISPLAY_FPS_RATIO (-> *display* integral-frame-counter))) (* 2 leni))))
              (send-event (ppointer->process ic) 'set-frame-num (* 0.5 (the float hf))))))))
    (set-yaw-angle-clear-roll-pitch! (-> ic 0 root) 0.0))
  (none))

(defun hud3d-make-cell-icon ((this hud-3d-pickups))
  "pose, SUR L'ELEMENT PILE D'ORIGINE, une SECONDE icone qui porte le vrai modele du ramassable.
   L'icone d'origine (indice 0) reste vivante : c'est elle qui sert de regime « origine » au banc
   de cout et de reference de gabarit. L'echelle est calculee — pas reglee a l'oeil — pour que
   `echelle x rayon` soit EGAL des deux cotes : le vrai modele occupe donc exactement le rectangle
   de l'icone d'origine."
  (let ((fc (hud3d-elt HUD3D_SLOT_CELL)))
    (when (and fc (hud3d-alive? (-> fc 0 icons 0 icon)))
      (let* ((obj (-> fc 0))
             (r0 (-> obj icons 0 icon 0 draw bounds w))
             (r1 (-> *fuel-cell-sg* radius)))
        (when (and (> r0 0.0) (> r1 0.0) (= (-> obj nb-of-icons) 1))
          (let ((sc (* (-> obj icons 0 scale-x) (/ r0 r1))))
            (hud-pc-make-icon obj
                              HUD_ICON_COUNT
                              :skel *fuel-cell-sg*
                              :x (-> obj icons 0 icon-x)
                              :y (-> obj icons 0 icon-y)
                              :z 2048.0
                              :scale-x sc
                              :scale-y sc)
            (let ((ic (-> obj icons 1 icon)))
              (cond
                ((hud3d-alive? ic)
                 ;; ── LE CHEMIN MERC NE SAIT PAS CE QU'EST UN HUD : C'EST LA « PILE MINUSCULE » ──
                 ;; Notre pile etait le SEUL des quatre emplacements route par `draw-bones-hud-merc`
                 ;; (bones.gc:1568) vers Merc2. Or Merc2 n'a AUCUN chemin HUD : ses uniformes sont la
                 ;; `LowMemory` du bucket, ecrite par `merc-vu1-init-buffers` avec la perspective du
                 ;; MONDE (merc.gc:299-300, Merc2.cpp:4469-4480), et son nuanceur divise par la
                 ;; composante w du sommet transforme (shaders/merc2.vert:86-96). Une icone de HUD est
                 ;; posee a z = 2048 dans le canevas 512x448 : tout y est donc divise par ~2048 —
                 ;; « minuscule et squeezee au centre de l'ecran », mot pour mot ce que l'owner voit.
                 ;; `draw-bones-hud`, lui, appelle `draw-bones-generic-merc` avec use-isometric = 1
                 ;; (bones.gc:1551) : `mercneric-convert` charge alors `*math-camera* isometric`
                 ;; (generic_merc.cpp:628-664), dont mat_33 est non nul — exactement ce que Generic2
                 ;; teste pour reconnaitre un dessin de HUD (Generic2_Build.cpp:311-320) avant de lui
                 ;; appliquer l'echelle du HUD et de le differer (Generic2_OpenGL.cpp:369-376, :416).
                 ;; C'est ce que font les TROIS emplacements que l'owner declare bons.
                 ;; Et `draw-bones-hud-merc` ne dessinait meme pas toute la pile : il marque les
                 ;; effets SANS envmap `use-mercneric 1` (bones.gc:1655) puis n'appelle jamais le
                 ;; chemin generique — ces effets-la n'etaient emis nulle part.
                 ;; On remet donc la pile sur le chemin de HUD du jeu, avec les memes lumieres
                 ;; chaudes qu'avant (`*rhud-cell-lights*`, hud-classes-pc.gc:725).
                 ;; RISQUE NOMME : c'est le chemin qui, en juillet (rondes 2-4), perdait le CORPS de
                 ;; la pile sur arm64 en n'y laissant que son halo de sparticle. Le halo plat est
                 ;; parti depuis (livrable §2) et la sonde de boite mesure maintenant si le corps est
                 ;; la : `hud3d_px_cell_ours_pixels` / `_empty` le disent au lieu de le supposer.
                 (set! (-> ic 0 draw dma-add-func) dma-add-process-drawable-hud-with-cell-lights)
                 (set-vector! (-> ic 0 draw color-mult) 0.5 0.5 0.5 1.0)
                 (set-vector! (-> ic 0 draw color-emissive) 0.5 0.5 0.5 1.0)
                 (send-event (ppointer->process ic) 'anim-mode 'still)
                 ;; MEME GESTE QUE POUR LA MECAMOUCHE. L'element pile passe l'essentiel du temps
                 ;; dans `hud-hidden`, qui n'appelle `draw-icons` qu'a l'entree : notre icone,
                 ;; nee apres, gardait l'origine du repere et son echelle de naissance — « une
                 ;; pile d'energie tout minuscule qu'on voit tout le temps » (owner, 17/09).
                 ;; LE DECALAGE DES DEUX ORIGINES, UNE FOIS POUR TOUTES. `draw-icons` pose
                 ;; l'ORIGINE d'un modele ; ce qu'on veut superposer, ce sont les deux CENTRES.
                 ;; Les deux groupes declarent aujourd'hui la meme sphere (0, 1 metre, 0, 1,6 m) —
                 ;; le decalage vaut donc zero — mais la formule le mesure au lieu de le supposer.
                 (let ((b0 (-> obj icons 0 icon 0 draw bounds))
                       (b1 (-> ic 0 draw bounds)))
                   (set! (-> this cell-dx)
                         (the int (* (-> *video-parms* relative-x-scale)
                                     (- (* (-> b0 x) (-> obj icons 0 scale-x)) (* (-> b1 x) sc)))))
                   (set! (-> this cell-dy)
                         (the int (* (-> *video-parms* relative-y-scale)
                                     (- (* (-> b0 y) (-> obj icons 0 scale-y)) (* (-> b1 y) sc))))))
                 (draw-icons obj)
                 (send-event (ppointer->process ic) 'draw (not (hidden? obj)))
                 (set! (-> this cell-scale) sc)
                 (set! (-> this cell-stock-ext) (* (-> obj icons 0 scale-x) r0))
                 (set! (-> this cell-our-ext) (* sc r1))
                 (set! (-> this cell-proc) (the-as process (ppointer->process fc))))
                (else
                 ;; art du niveau pas encore chargee : manipy sans squelette, qui ne dessinera
                 ;; jamais rien. On le retire et on reessaiera a l'image suivante.
                 (when (and (nonzero? ic) ic (-> ic 0)) (deactivate (ppointer->process ic)))
                 (set! (-> obj icons 1 icon) (the-as (pointer manipy) #f))
                 (set! (-> obj nb-of-icons) 1)))))))))
  (none))

(defun hud3d-make-buzzer-icon ((this hud-3d-pickups))
  "l'element mecamouche d'origine n'a AUCUNE icone — seulement un sprite. Le jeu porte pourtant
   deja la geometrie de son icone : `get-icon-scale-x/y` sont surchargees sur `hud-buzzers` et sur
   elle seule (hud-classes.gc). On pose donc le vrai modele du ramassable au centre du sprite
   d'origine (`init-pos`, meme repere de canevas que `icon-x`/`icon-y`) et a l'echelle que le jeu
   declare pour cette icone-la. Rien n'est regle a la main."
  (let ((bz (hud3d-elt HUD3D_SLOT_BUZZERS)))
    (when (and bz (> (-> bz 0 nb-of-particles) 0))
      (let ((obj (-> bz 0)))
        ;; un slot mort ou sans squelette est remis a zero pour etre refait
        (when (and (> (-> obj nb-of-icons) 0) (not (hud3d-alive? (-> obj icons 0 icon))))
          (when (and (nonzero? (-> obj icons 0 icon)) (-> obj icons 0 icon) (-> obj icons 0 icon 0))
            (deactivate (ppointer->process (-> obj icons 0 icon))))
          (set! (-> obj icons 0 icon) (the-as (pointer manipy) #f))
          (set! (-> obj nb-of-icons) 0))
        (when (zero? (-> obj nb-of-icons))
          (set! (-> this buzz-ref-sx) (get-icon-scale-x obj))
          (set! (-> this buzz-ref-sy) (get-icon-scale-y obj))
          ;; LA LOI DE PLACEMENT (en-tete plus haut), et le temoin que le jeu en donne
          (set! (-> this buzz-icon-x)
                (hud3d-icon-x-for-sprite (-> obj particles 0 init-pos x)
                                         (-> *buzzer-sg* bounds x)
                                         (-> this buzz-ref-sx)))
          (set! (-> this buzz-icon-y)
                (hud3d-icon-y-for-sprite (-> obj particles 0 init-pos y)
                                         (-> *buzzer-sg* bounds y)
                                         (-> this buzz-ref-sy)))
          (set! (-> this buzz-nd-x) (get-icon-pos-x obj))
          (set! (-> this buzz-nd-y) (- (get-icon-pos-y obj) (-> obj next-y-offset)))
          (hud-pc-make-icon obj
                            HUD_ICON_COUNT
                            :skel *buzzer-sg*
                            :x (-> this buzz-icon-x)
                            :y (-> this buzz-icon-y)
                            :z 1024.0
                            :scale-x (-> this buzz-ref-sx)
                            :scale-y (-> this buzz-ref-sy))
          (let ((ic (-> obj icons 0 icon)))
            (cond
              ((hud3d-alive? ic)
               ;; la pose de repos du modele regarde a l'oppose de la camera
               (send-event (ppointer->process ic)
                           'rot-quat
                           (quaternion-axis-angle! (new-stack-quaternion0) 0.0 1.0 0.0 (degrees 180)))
               ;; A SA NAISSANCE, PAS A LA PROCHAINE OUVERTURE DU HUD. `hud-buzzers` n'a aucune
               ;; icone d'origine : son etat `hud-hidden` n'appelle donc jamais `draw-icons`
               ;; (hud.gc:159 ne le fait qu'a l'entree, avant que la notre existe), et l'icone
               ;; restait a l'origine du repere, EN PLEIN MILIEU DE L'ECRAN, visible des la
               ;; premiere image jusqu'a la premiere ouverture du HUD (owner, 17/09). On la place
               ;; et on lui donne la visibilite de son element a l'image meme.
               (draw-icons obj)
               (send-event (ppointer->process ic) 'draw (not (hidden? obj)))
               (set! (-> this buzz-ext) (* (-> this buzz-ref-sx) (-> ic 0 draw bounds w)))
               (set! (-> this buzz-proc) (the-as process (ppointer->process bz))))
              (else
               (when (and (nonzero? ic) ic (-> ic 0)) (deactivate (ppointer->process ic)))
               (set! (-> obj icons 0 icon) (the-as (pointer manipy) #f))
               (set! (-> obj nb-of-icons) 0))))))))
  (none))

(defun hud3d-jgeo-ok? ((sg skeleton-group))
  "REJOUE LA GARDE `joint-geo` D'`initialize-skeleton` (process-drawable.gc:394-398) SUR LE GROUPE
   D'ART REELLEMENT CHARGE. C'est le seul chemin restant par lequel un `manipy` peut revenir sans
   squelette alors que son groupe d'art EST la, et c'est une chose qui se mesure au lieu de se
   supposer : l'indice de la geometrie de squelette est fige a la COMPILATION ; si le fichier
   d'art livre n'a plus le meme ordre d'elements, l'indice ne designe plus un `art-joint-geo`."
  (let ((ag (art-group-get-by-name (-> *level* level-default) (-> sg art-group-name))))
    (if (and ag (< (-> sg jgeo) (-> ag length)) (= (-> ag data (-> sg jgeo) type) art-joint-geo)) 1 0)))

(defun hud3d-ag-len ((sg skeleton-group))
  (let ((ag (art-group-get-by-name (-> *level* level-default) (-> sg art-group-name))))
    (if ag (-> ag length) -1)))

(defun hud3d-orb-state ((this hud-3d-pickups))
  "NOMME ce qui manque a l'emplacement orbe, au lieu de le deviner.
   0 aucun element `hud-money` · 1 element sans icone · 2 slot d'icone vide ·
   3 manipy SANS SQUELETTE (ne dessinera jamais rien) · 4 vivante."
  (let ((mo (hud3d-elt HUD3D_SLOT_MONEY)))
    (cond
      ((not mo) 0)
      ((zero? (-> mo 0 nb-of-icons)) 1)
      ((let ((ic (-> mo 0 icons 0 icon))) (not (and (nonzero? ic) ic (-> ic 0)))) 2)
      ((not (hud3d-alive? (-> mo 0 icons 0 icon))) 3)
      (else 4))))

(defun hud3d-repair-orb-icon ((this hud-3d-pickups))
  "L'element orbe porte DEJA le vrai modele du ramassable (`*money-sg*`, hud-classes.gc:597) — mais
   `hud-money::init-particles!` ne le spawne QU'UNE FOIS, a l'activation du HUD. Si l'art du niveau
   n'est pas encore chargee a cet instant, le manipy revient SANS SQUELETTE et ne dessinera plus
   jamais rien : il ne reste a l'ecran que le halo plat `group-part-hud-orb`. C'est tres exactement
   ce que l'owner appelle « un sprite dégueu » a la place d'« une vraie orbe ».
   MESURE (bureau, 17/09) : `hud3d_model_orb` rendait « - » — aucun groupe d'art attache — alors
   que la pile et la mecamouche rendaient bien `fuel-cell` et `buzzer`.
   ON NE DESACTIVE PAS L'ANCIENNE ICONE. Un `deactivate` sur ce ppointer a fait tomber le bureau
   en SIGSEGV (course du 17/09) : `deactivate` ne remet pas `self` a zero, et le slot peut deja
   pointer sur de la memoire rendue au pool puis reprise par un autre process. On remplace le
   pointeur ; le zombie, qui ne dessine rien, s'eteindra avec son parent."
  ;; SEULEMENT QUAND L'EMPLACEMENT EST REELLEMENT EN PANNE. La condition precedente etait
  ;; `>= 1`, c'est-a-dire TOUJOURS VRAIE : la reparation refaisait l'icone 200 fois de suite sur un
  ;; orbe parfaitement sain et abandonnait 200 manipys derriere elle (`hud3d_orb_tries=200` avec
  ;; `hud3d_orb_spawn_noskel=0`). L'etat 4 veut dire « l'orbe dessine » : il n'y a rien a reparer.
  (when (and (hud3d-elt HUD3D_SLOT_MONEY) (< (hud3d-orb-state this) 4) (< (-> this orb-tries) 200))
    (let* ((mo (hud3d-elt HUD3D_SLOT_MONEY))
           (obj (-> mo 0))
           (nm (manipy-spawn (new 'static 'vector :w 1.0) #f *money-sg* #f :to obj)))
      (+! (-> this orb-tries) 1)
      (if (not (and nm (-> nm 0))) (+! (-> this orb-null) 1))
      ;; un manipy sans squelette est un process VIVANT qui ne dessinera jamais : le laisser en
      ;; fuirait un par image. On le rend tout de suite.
      (when (and nm (-> nm 0) (not (hud3d-alive? nm)))
        (+! (-> this orb-noskel) 1)
        (deactivate (ppointer->process nm)))
      (when (hud3d-alive? nm)
        (set! (-> nm 0 draw dma-add-func) dma-add-process-drawable-hud)
        (set-vector! (-> nm 0 root trans) 0.0 0.0 0.0 1.0)
        (set-vector! (-> nm 0 root scale)
                     (-> obj icons 0 scale-x)
                     (-> obj icons 0 scale-y)
                     (-> obj icons 0 scale-x)
                     1.0)
        (logior! (-> nm 0 mask) (process-mask pause))
        (logclear! (-> nm 0 mask) (process-mask menu progress))
        (set! (-> nm 0 root trans z) 1024.0)
        (set! (-> obj icons 0 icon) nm)
        (if (zero? (-> obj nb-of-icons)) (set! (-> obj nb-of-icons) 1))
        (send-event (ppointer->process nm) 'draw (not (hidden? obj)))
        (draw-icons obj))))
  (none))

(defun hud3d-icon-draw! ((obj hud) (idx int) (on symbol))
  "montre ou cache UNE icone d'un element de HUD. L'etat d'arrivee de l'element renvoie `draw #t`
   a TOUS ses enfants (hud.gc:203) ; il faut donc re-affirmer le choix, sinon la premiere
   apparition rend les deux modeles visibles en meme temps.
   L'EVENEMENT NE PART QUE SI L'ETAT CHANGE. On lit d'abord le bit `hidden` du draw-control — la
   grandeur que le moteur regarde — et on ne poste rien quand il est deja bon : sur une course
   entiere cela vaut quatre `send-event` par image economises, et l'owner a demande le 17/09 de
   ne pas payer le placement au calcul."
  (when (and obj (> (-> obj nb-of-icons) idx))
    (let ((ic (-> obj icons idx icon)))
      (when (hud3d-alive? ic)
        (if (!= (and on #t) (hud3d-icon-drawn? ic))
          (send-event (ppointer->process ic) 'draw on)))))
  (none))

(defun hud3d-set-regime ((this hud-3d-pickups) (ours symbol))
  "pose les quatre emplacements dans l'un des deux regimes. `ours` = les objets du jeu ;
   sinon exactement ce que le jeu d'origine dessine."
  ;; UN MODELE N'EST VISIBLE QUE QUAND L'ELEMENT D'ORIGINE L'EST (livrable §6). L'essai 1
  ;; re-affirmait `draw` a partir du seul regime : les modeles restaient dessines pendant que le
  ;; HUD etait replie — c'est le defaut que l'owner a vu le 17/09 sur ses deux captures. La
  ;; reference est `hidden?` (hud.gc:143), l'etat de l'element, qui est aussi ce qui autorise le
  ;; sprite d'origine a se lancer (`hud::draw-hud`, hud.gc:24).
  (let ((fc (hud3d-elt HUD3D_SLOT_CELL)))
    (when fc
      (let* ((obj (-> fc 0))
             (shown (not (hidden? obj))))
        (when (> (-> obj nb-of-icons) 1)
          ;; notre icone suit celle d'origine : `hud-fuel-cell::hud-update` reecrit `icon-y` a
          ;; chaque image (hud-classes.gc:944). Deux entiers, pas une formule.
          (set! (-> obj icons 1 icon-x) (+ (-> obj icons 0 icon-x) (-> this cell-dx)))
          (set! (-> obj icons 1 icon-y) (+ (-> obj icons 0 icon-y) (-> this cell-dy)))
          ;; ── L'ECHELLE DE NOTRE PILE EST CELLE DE LA PILE D'ORIGINE, DONC ISOTROPE ──────────
          ;; MESURE x86 DU 17/09, lue sur la transformation qui atteint le renderer :
          ;;   pile d'origine : root scale = (0,00899 · 0,00899)
          ;;   la notre       : root scale = (0,00539 · 0,00899)      539/899 = 0,600
          ;; 0,600 est exactement `relative-x-scale` = (4/3)/aspect. `hud::draw-icons`
          ;; (hud.gc:74-78) multiplie l'abscisse de TOUTE icone par ce facteur, mais la projection
          ;; du HUD 3D rend deja des pixels carres : rien en aval ne l'annule, contrairement aux
          ;; SPRITES de HUD que `sprite-add-matrix-data` (sprite.gc:467-469) recorrige par
          ;; `aspect-ratio-scale`. La pile d'origine y echappe par accident : la part 318 de son
          ;; groupe de sprites rappelle `fuel-cell-hud-center-callback` (hud-classes.gc:932) a
          ;; chaque image, qui lui repose une echelle UNIFORME. Notre icone, elle, n'a pas de
          ;; sprite — livrable §2 — donc personne ne la reposait : elle restait ecrasee de 40 %
          ;; en largeur. C'est le mot de l'owner : « squeezee ».
          ;; On refait donc, pour notre icone, le geste que le jeu fait deja pour la sienne : une
          ;; ecriture de vecteur par image, la meme valeur que celle du sprite remplace.
          ;; (Sur l'appareil, Android force `aspect-ratio` a 4:3 et le facteur vaut 1,000 : ce
          ;; correctif y est neutre. Il cesse de l'etre des que le format de rendu change.)
          (when (and (> (-> this cell-scale) 0.0) (hud3d-alive? (-> obj icons 1 icon)))
            (set-vector! (-> obj icons 1 icon 0 root scale)
                         (-> this cell-scale)
                         (-> this cell-scale)
                         (-> this cell-scale)
                         1.0)))
        (hud3d-icon-draw! obj 0 (and (not ours) shown))
        (hud3d-icon-draw! obj 1 (and ours shown))
        (if (and ours shown) (hud3d-drive-cell-anim (-> obj icons 1 icon)))
        ;; l'element pile dessine aussi un groupe de sprites plats sous son icone ; -2 est sa
        ;; valeur d'origine (« hud-update pilote la position »), 0 saute la particule 0.
        (set! (-> obj skip-particle) (if ours 0 -2)))))
  (let ((bz (hud3d-elt HUD3D_SLOT_BUZZERS)))
    (when bz
      (let ((obj (-> bz 0)))
        (hud3d-icon-draw! obj 0 (and ours (not (hidden? obj))))
        (set! (-> obj skip-particle) (if ours 0 -1)))))
  ;; l'orbe porte DEJA le vrai modele du ramassable ; seul le halo plat par-dessus s'en va
  (let ((m (hud3d-elt HUD3D_SLOT_MONEY))) (if m (set! (-> m 0 skip-particle) (if ours 0 -1))))
  (let ((ma (hud3d-elt HUD3D_SLOT_MONEY_ALL))) (if ma (set! (-> ma 0 skip-particle) (if ours 0 -1))))
  ;; l'eco verte : le sprite d'origine de `hud-pickups`, ou notre emetteur (porte par CE process)
  (let ((pk (hud3d-elt HUD3D_SLOT_PICKUPS))) (if pk (set! (-> pk 0 skip-particle) (if ours 0 -1))))
  (set! (-> this skip-particle) (if ours -1 0))
  (none))

(defun hud3d-px-freeze ((ic (pointer manipy)) (yaw float))
  "IMMOBILISE UN MODELE POUR LA DUREE DE LA MESURE. Les icones de HUD tournent sur elles-memes —
   `hud-fuel-cell::hud-update` ajoute un degre par image a l'icone d'origine, `hud-money::hud-update`
   en retire quatre — et notre pile joue son anim d'inactivite. Un modele qui tourne n'a pas deux
   fois la meme silhouette : le filtre d'accord n'en garderait que le noyau invariant par rotation,
   et c'est ce qui est arrive le 17/09 (77 pixels retenus sur ~580 reellement changes par paire).
   On pose donc un lacet ABSOLU et une image d'animation FIXE a chaque image de la sequence : ce
   que le moteur ajoute ensuite est constant, donc la pose l'est aussi.
   Le geste porte sur les DEUX piles de la meme facon : la comparaison reste une comparaison."
  (when (hud3d-alive? ic)
    (set-yaw-angle-clear-roll-pitch! (-> ic 0 root) yaw)
    ;; UN MODELE RIGIDE N'A PAS DE SQUELETTE, ET LUI POSTER UNE IMAGE D'ANIMATION TUE LE JEU.
    ;; `initialize-skeleton` (process-drawable.gc:434-447) ne cree un `joint-control` que si la
    ;; geometrie declare `joint-channel > 0` : l'orbe (`money`) en declare zero, son `skel` est
    ;; legitimement nul, et il dessine parfaitement. Course x86 du 17/09 sans cette garde :
    ;; SIGSEGV a l'arrivee du HUD, quelques secondes apres le teleport. Le lacet, lui, se pose
    ;; sur le `root` et vaut pour les deux familles — c'est d'ailleurs par le lacet que l'orbe
    ;; et la pile d'origine tournent.
    (when (and (nonzero? (-> ic 0 skel))
               (nonzero? (-> ic 0 skel root-channel 0 frame-group))
               (-> ic 0 skel root-channel 0 frame-group))
      (send-event (ppointer->process ic) 'anim-mode 'still)
      (send-event (ppointer->process ic) 'set-frame-num 0.0)))
  (none))

(defun hud3d-px-ready? ((this hud-3d-pickups) (fc (pointer hud)) (bz (pointer hud)) (mo (pointer hud)))
  "la sequence de mesure n'a de sens que si les QUATRE modeles existent et que l'element pile est
   effectivement affiche : un emplacement replie ne donnerait que des images identiques."
  (and fc
       bz
       mo
       (> (-> fc 0 nb-of-icons) 1)
       (hud3d-alive? (-> fc 0 icons 0 icon))
       (hud3d-alive? (-> fc 0 icons 1 icon))
       (> (-> bz 0 nb-of-icons) 0)
       (hud3d-alive? (-> bz 0 icons 0 icon))
       (> (-> mo 0 nb-of-icons) 0)
       (hud3d-alive? (-> mo 0 icons 0 icon))
       (not (hidden? (-> fc 0)))
       #t))

(defun hud3d-px-drive ((this hud-3d-pickups) (fc (pointer hud)) (bz (pointer hud)) (mo (pointer hud)))
  "UNE PHASE DE LA SEQUENCE DE MESURE. Un seul modele est dessine a la fois ; les autres et tous
   les sprites de HUD sont eteints, pour que la difference entre l'image de reference et l'image
   suivante ne porte QUE l'element mesure. Ce qui reste — le monde qui bouge derriere — est du
   bruit non correle d'une paire a l'autre, et le filtre d'accord de `hud_box_probe` l'elimine ;
   le slot de CONTROLE mesure ce qui y survit quand il n'y a rien a voir.
   Cette fonction ecrase les choix de `hud3d-set-regime` pour l'image : elle tourne apres lui."
  (let ((show (hud3d-px-shown (-> this px-phase))))
    (hud3d-icon-draw! (-> fc 0) 0 (= show 1))
    (hud3d-icon-draw! (-> fc 0) 1 (= show 2))
    (hud3d-icon-draw! (-> bz 0) 0 (= show 3))
    (hud3d-icon-draw! (-> mo 0) 0 (= show 4))
    (set! (-> fc 0 skip-particle) 0)
    (set! (-> bz 0 skip-particle) 0)
    (set! (-> mo 0 skip-particle) 0)
    (let ((ma (hud3d-elt HUD3D_SLOT_MONEY_ALL))) (if ma (set! (-> ma 0 skip-particle) 0)))
    (let ((pk (hud3d-elt HUD3D_SLOT_PICKUPS))) (if pk (set! (-> pk 0 skip-particle) 0)))
    (set! (-> this skip-particle) 0)
    ;; les quatre modeles figes dans la MEME pose a chaque paire, sinon le filtre d'accord ne
    ;; garde que ce qui est invariant par rotation
    (hud3d-px-freeze (-> fc 0 icons 0 icon) 16384.0)
    (hud3d-px-freeze (-> fc 0 icons 1 icon) 16384.0)
    (hud3d-px-freeze (-> bz 0 icons 0 icon) 0.0)
    (hud3d-px-freeze (-> mo 0 icons 0 icon) 0.0)
    (+! (-> this px-hold) 1)
    (when (>= (-> this px-hold) (hud3d-px-hold-for (-> this px-cycles)))
      (set! (-> this px-hold) 0)
      ;; L'ETAT DEMANDE EST-IL L'ETAT QUE LE MOTEUR PORTE ? On relit le bit `hidden` des quatre
      ;; draw-controls a l'instant de la capture. Sans ce compte, une boite vide ne distingue pas
      ;; « l'element n'a pas bascule » de « l'image lue ne contient pas le HUD » — deux causes
      ;; opposees derriere le meme zero.
      (if (!= (and (= show 1) #t) (hud3d-icon-drawn? (-> fc 0 icons 0 icon))) (+! (-> this px-bad) 1))
      (if (!= (and (= show 2) #t) (hud3d-icon-drawn? (-> fc 0 icons 1 icon))) (+! (-> this px-bad) 1))
      (if (!= (and (= show 3) #t) (hud3d-icon-drawn? (-> bz 0 icons 0 icon))) (+! (-> this px-bad) 1))
      (if (!= (and (= show 4) #t) (hud3d-icon-drawn? (-> mo 0 icons 0 icon))) (+! (-> this px-bad) 1))
      (__pc-autoport-hud-capture (hud3d-px-capture (-> this px-phase)))
      (set! (-> this px-phase) (mod (+ (-> this px-phase) 1) HUD3D_PX_PHASES))
      (if (zero? (-> this px-phase)) (+! (-> this px-cycles) 1))))
  (none))

(defun hud3d-px-w ((slot int))
  "largeur en pixels de la boite lue pour cet emplacement ; 0 si rien n'a ete retenu."
  (if (> (__pc-autoport-hud-box slot 5) 0)
    (+ 1 (- (__pc-autoport-hud-box slot 3) (__pc-autoport-hud-box slot 1)))
    0))

(defun hud3d-px-h ((slot int))
  (if (> (__pc-autoport-hud-box slot 5) 0)
    (+ 1 (- (__pc-autoport-hud-box slot 4) (__pc-autoport-hud-box slot 2)))
    0))

(defun hud3d-px-cx2 ((slot int))
  "DEUX FOIS l'abscisse du centre : le centre d'une boite de largeur paire n'est pas un entier,
   et publier un arrondi masquerait justement l'ecart de 1 a 2 pixels que le contrat juge."
  (+ (__pc-autoport-hud-box slot 1) (__pc-autoport-hud-box slot 3)))

(defun hud3d-px-cy2 ((slot int))
  (+ (__pc-autoport-hud-box slot 2) (__pc-autoport-hud-box slot 4)))

(defmacro hud3d-px-pub (slot nom)
  "publie la boite d'un emplacement, telle qu'elle a ete lue. Les cles portent `px` : ce sont des
   PIXELS de la FBO de rendu, pas des unites de canevas. Les noms sont des litteraux assembles a
   la compilation — aucune chaine n'est fabriquee a l'execution."
  `(begin
    (__pc-autoport-publish ,(string-append "hud3d_px_" nom "_samples") (__pc-autoport-hud-box ,slot 0))
    (__pc-autoport-publish ,(string-append "hud3d_px_" nom "_minx") (__pc-autoport-hud-box ,slot 1))
    (__pc-autoport-publish ,(string-append "hud3d_px_" nom "_miny") (__pc-autoport-hud-box ,slot 2))
    (__pc-autoport-publish ,(string-append "hud3d_px_" nom "_w") (hud3d-px-w ,slot))
    (__pc-autoport-publish ,(string-append "hud3d_px_" nom "_h") (hud3d-px-h ,slot))
    (__pc-autoport-publish ,(string-append "hud3d_px_" nom "_pixels") (__pc-autoport-hud-box ,slot 5))
    (__pc-autoport-publish ,(string-append "hud3d_px_" nom "_empty") (__pc-autoport-hud-box ,slot 8))
    ;; le rapport largeur/hauteur au millieme : une pile « squeezee » est un rapport faux, et
    ;; c'est le mot que l'owner a employe.
    (__pc-autoport-publish ,(string-append "hud3d_px_" nom "_wh_milli")
                           (if (> (hud3d-px-h ,slot) 0)
                             (/ (* 1000 (hud3d-px-w ,slot)) (hud3d-px-h ,slot))
                             0))))

;;;----------------------------------------------
;;  la preuve
;;;----------------------------------------------

(defun hud3d-pin ((p (pointer hud)))
  "epingle un element du HUD a l'ecran pour la duree de la course de preuve. `force-on-screen`
   re-estampe `trigger-time` a chaque image (c'est l'epinglage que le HUD du zoomer utilise) ;
   `friend` est mis a -1 pour que l'element n'entraine pas un voisin avec lui. Ce geste ne tourne
   QUE sous `debug.opengoal.costprobe` — le joueur ne le voit jamais."
  (when p
    (set! (-> p 0 force-on-screen) #t)
    (set! (-> p 0 friend) -1)
    (set! (-> p 0 disable) #f))
  (none))

(defun hud3d-model-name ((p (pointer hud)) (idx int))
  (if (and p (> (-> p 0 nb-of-icons) idx)) (hud3d-art-name (-> p 0 icons idx icon)) (the-as string #f)))

(defun hud3d-pub-name ((key string) (v string))
  (__pc-autoport-publish-text key (if v v "-"))
  (none))

(defun hud3d-name-ok? ((v string) (want string))
  (and v want (string= v want) #t))

(defun hud3d-part-max-scale ((id int))
  "la demi-taille MAXIMALE que ce lanceur peut donner a une particule : valeur de base + alea du
   champ `scale-x`. C'est la grandeur qui decide si le nuage tient dans le rectangle de
   l'element d'origine (livrable §3)."
  (let ((p (-> *part-id-table* id))
        (v 0.0))
    (when (nonzero? p)
      (let ((i 0))
        (while (!= (-> p init-specs i field) (sp-field-id spt-end))
          (when (= (-> p init-specs i field) (sp-field-id spt-scale-x))
            (set! v (+ (-> p init-specs i initial-valuef) (-> p init-specs i random-rangef))))
          (+! i 1))))
    v))

(defun hud3d-publish ((this hud-3d-pickups))
  (let* ((pk (hud3d-elt HUD3D_SLOT_PICKUPS))
         (mo (hud3d-elt HUD3D_SLOT_MONEY))
         (fc (hud3d-elt HUD3D_SLOT_CELL))
         (bz (hud3d-elt HUD3D_SLOT_BUZZERS))
         (n-orb (hud3d-model-name mo 0))
         (n-cell (hud3d-model-name fc 1))
         (n-buzz (hud3d-model-name bz 0))
         (id-bad 0)
         (rect-bad 0)
         (measured 0))

    ;; ── §1 QUATRE EMPLACEMENTS, QUATRE MODELES ──────────────────────────────────────────────
    ;; L'identite publiee est le NOM DU GROUPE D'ART que le moteur a reellement attache au modele
    ;; dessine, confronte au nom que porte le `skeleton-group` DU RAMASSABLE. Ce n'est pas notre
    ;; variable : c'est ce que `initialize-skeleton` a trouve.
    (hud3d-pub-name "hud3d_model_orb" n-orb)
    (__pc-autoport-publish "hud3d_orb_state" (hud3d-orb-state this))
    (__pc-autoport-publish "hud3d_orb_tries" (-> this orb-tries))
    (__pc-autoport-publish "hud3d_orb_spawn_null" (-> this orb-null))
    (__pc-autoport-publish "hud3d_orb_spawn_noskel" (-> this orb-noskel))
    ;; L'ORBE NE DESSINE AUCUN MODELE, ET CE N'EST PAS NOUS : le bras d'ablation rend le meme
    ;; `hud3d_orb_state=3`. On demande donc au CHARGEUR ce qu'il porte, au lieu de supposer.
    (__pc-autoport-publish "hud3d_artgrp_money"
                           (if (art-group-get-by-name (-> *level* level-default) "money") 1 0))
    (__pc-autoport-publish "hud3d_artgrp_fuel_cell"
                           (if (art-group-get-by-name (-> *level* level-default) "fuel-cell") 1 0))
    (__pc-autoport-publish "hud3d_artgrp_fuelcell_naked"
                           (if (art-group-get-by-name (-> *level* level-default) "fuelcell-naked") 1 0))
    (__pc-autoport-publish "hud3d_artgrp_buzzer"
                           (if (art-group-get-by-name (-> *level* level-default) "buzzer") 1 0))
    (__pc-autoport-publish "hud3d_money_jgeo_idx" (-> *money-sg* jgeo))
    (__pc-autoport-publish "hud3d_money_ag_len" (hud3d-ag-len *money-sg*))
    (__pc-autoport-publish "hud3d_money_jgeo_ok" (hud3d-jgeo-ok? *money-sg*))
    (__pc-autoport-publish "hud3d_cell_jgeo_idx" (-> *fuel-cell-sg* jgeo))
    (__pc-autoport-publish "hud3d_cell_ag_len" (hud3d-ag-len *fuel-cell-sg*))
    (__pc-autoport-publish "hud3d_cell_jgeo_ok" (hud3d-jgeo-ok? *fuel-cell-sg*))
    (__pc-autoport-publish "hud3d_artgrp_money_any"
                           (if (art-group-get-by-name *level* "money") 1 0))
    (hud3d-pub-name "hud3d_model_cell" n-cell)
    (hud3d-pub-name "hud3d_model_buzzer" n-buzz)
    (hud3d-pub-name "hud3d_pickup_orb" (-> *money-sg* art-group-name))
    (hud3d-pub-name "hud3d_pickup_cell" (-> *fuel-cell-sg* art-group-name))
    (hud3d-pub-name "hud3d_pickup_buzzer" (-> *buzzer-sg* art-group-name))
    (hud3d-pub-name "hud3d_model_eco" "groupe-58-transpose-en-espace-ecran")
    (if (not (hud3d-name-ok? n-orb (-> *money-sg* art-group-name))) (+! id-bad 1))
    (if (not (hud3d-name-ok? n-cell (-> *fuel-cell-sg* art-group-name))) (+! id-bad 1))
    (if (not (hud3d-name-ok? n-buzz (-> *buzzer-sg* art-group-name))) (+! id-bad 1))
    (__pc-autoport-publish "hud3d_eco_fields_compared" (-> this eco-compared))
    (__pc-autoport-publish "hud3d_eco_fields_excluded" (-> this eco-excluded))
    (__pc-autoport-publish "hud3d_eco_spec_mismatch" (-> this eco-mismatch))
    (if (or (zero? (-> this eco-compared)) (nonzero? (-> this eco-mismatch))) (+! id-bad 1))

    ;; ── §10 L'EFFET LUMINEUX DE LA PILE (owner, 18/09) ──────────────────────────────────────
    ;; Rien n'y est lu sur une image : l'identite vient des tables de lanceurs du jeu, l'emission
    ;; du lanceur lui-meme, et le compte de particules du systeme de particules.
    (__pc-autoport-publish "hud3d_glow_from_stock" (-> this glow-from-stock))
    (__pc-autoport-publish "hud3d_glow_world_compared" (-> this glow-compared))
    (__pc-autoport-publish "hud3d_glow_world_excluded" (-> this glow-excluded))
    (__pc-autoport-publish "hud3d_glow_world_mismatch" (-> this glow-mismatch))
    (__pc-autoport-publish "hud3d_glow_frames" (-> this glow-frames))
    (__pc-autoport-publish "hud3d_glow_spawns" (-> this glow-spawns))
    (__pc-autoport-publish "hud3d_glow_missing" (-> this glow-missing))
    (__pc-autoport-publish "hud3d_glow_bad" (-> this glow-bad))
    (__pc-autoport-publish "hud3d_glow_particles" (-> this glow-alloc))
    (__pc-autoport-publish "hud3d_glow_particles_max" (-> this glow-alloc-max))
    (hud3d-pub-name "hud3d_glow_launchers" "319-320-321-322-ceux-du-groupe-80-de-la-pile-d-origine")

    ;; ── §3 LA POSITION ET LA TAILLE ─────────────────────────────────────────────────────────
    ;; Chaque emplacement est confronte au rectangle de l'element D'ORIGINE, dans le repere ou les
    ;; deux se comparent exactement. Le facteur de projection du HUD, qu'on n'a pas su etablir en
    ;; formule fermee, se simplifie dans chaque rapport : on ne publie aucun pixel invente.
    (when (and fc (> (-> fc 0 nb-of-icons) 1))
      (__pc-autoport-publish "hud3d_rect_cell_cx" (-> fc 0 icons 1 icon-x))
      (__pc-autoport-publish "hud3d_rect_cell_cy" (-> fc 0 icons 1 icon-y))
      (__pc-autoport-publish "hud3d_rect_cell_ref_cx" (-> fc 0 icons 0 icon-x))
      (__pc-autoport-publish "hud3d_rect_cell_ref_cy" (-> fc 0 icons 0 icon-y))
      (__pc-autoport-publish "hud3d_rect_cell_ext_milli" (the int (* 1000.0 (-> this cell-our-ext))))
      (__pc-autoport-publish "hud3d_rect_cell_ref_ext_milli" (the int (* 1000.0 (-> this cell-stock-ext))))
      (if (or (!= (-> fc 0 icons 1 icon-x) (-> fc 0 icons 0 icon-x))
              (!= (-> fc 0 icons 1 icon-y) (-> fc 0 icons 0 icon-y))
              (> (-> this cell-our-ext) (+ 0.0001 (-> this cell-stock-ext))))
        (+! rect-bad 1)))
    (when (and bz (> (-> bz 0 nb-of-particles) 0) (> (-> bz 0 nb-of-icons) 0))
      (__pc-autoport-publish "hud3d_rect_buzzer_cx" (-> bz 0 icons 0 icon-x))
      (__pc-autoport-publish "hud3d_rect_buzzer_cy" (-> bz 0 icons 0 icon-y))
      (__pc-autoport-publish "hud3d_rect_buzzer_ref_cx" (-> this buzz-icon-x))
      (__pc-autoport-publish "hud3d_rect_buzzer_ref_cy" (-> this buzz-icon-y))
      (__pc-autoport-publish "hud3d_rect_buzzer_sprite_cx" (the int (-> bz 0 particles 0 init-pos x)))
      (__pc-autoport-publish "hud3d_rect_buzzer_sprite_cy" (the int (-> bz 0 particles 0 init-pos y)))
      (__pc-autoport-publish "hud3d_rect_buzzer_scale_milli" (the int (* 100000.0 (-> bz 0 icons 0 scale-x))))
      (__pc-autoport-publish "hud3d_rect_buzzer_ref_scale_milli" (the int (* 100000.0 (-> this buzz-ref-sx))))
      (hud3d-pub-name "hud3d_rect_buzzer_basis" "get-icon-scale-x/y_de_hud-buzzers_(donnee_du_jeu)")
      (if (or (!= (-> bz 0 icons 0 icon-x) (-> this buzz-icon-x))
              (!= (-> bz 0 icons 0 icon-y) (-> this buzz-icon-y))
              (!= (-> bz 0 icons 0 scale-x) (-> this buzz-ref-sx))
              (!= (-> bz 0 icons 0 scale-y) (-> this buzz-ref-sy)))
        (+! rect-bad 1)))
    (when (and pk (> (-> pk 0 nb-of-particles) 0) (> (-> this nb-of-particles) 0))
      (let ((ours (hud3d-part-max-scale 2981))
            (ref (hud3d-part-max-scale 304)))
        (__pc-autoport-publish "hud3d_rect_eco_cx" (the int (-> this particles 0 init-pos x)))
        (__pc-autoport-publish "hud3d_rect_eco_cy" (the int (-> this particles 0 init-pos y)))
        (__pc-autoport-publish "hud3d_rect_eco_ref_cx" (the int (-> pk 0 particles 0 init-pos x)))
        (__pc-autoport-publish "hud3d_rect_eco_ref_cy" (the int (-> pk 0 particles 0 init-pos y)))
        (__pc-autoport-publish "hud3d_rect_eco_ext_milli" (the int ours))
        (__pc-autoport-publish "hud3d_rect_eco_ref_ext_milli" (the int ref))
        (if (or (!= (-> this particles 0 init-pos x) (-> pk 0 particles 0 init-pos x))
                (!= (-> this particles 0 init-pos y) (-> pk 0 particles 0 init-pos y))
                (> ours (+ 1.0 ref))
                (zero? ref))
          (+! rect-bad 1))))
    ;; l'orbe : l'element d'origine porte deja le vrai modele et sa geometrie n'est pas touchee
    (hud3d-pub-name "hud3d_rect_orb_basis" "element_d_origine_inchange_seul_le_halo_plat_est_retire")
    ;; PAR QUEL CHEMIN LA PILE EST DESSINEE. C'est la grandeur qui separe l'essai 3 de celui-ci :
    ;; `draw-bones-hud` passe use-isometric=1 a `draw-bones-generic-merc` (bones.gc:1551), donc la
    ;; matrice `isometric` du HUD ; `draw-bones-hud-merc` partait chez Merc2, qui n'a aucun chemin
    ;; HUD et applique la perspective du MONDE a une icone posee a z=2048.
    (hud3d-pub-name "hud3d_cell_draw_path" "draw-bones-hud_generic_isometric")
    (__pc-autoport-publish "hud3d_rect_orb_ext_milli" (the int (* 1000.0 (-> this orb-ext))))

    ;; ── §4 LE COUT ──────────────────────────────────────────────────────────────────────────
    (let ((ma (if (> (-> this bench-n-a) 0) (/ (-> this bench-sum-a) (the int64 (-> this bench-n-a))) 0))
          (mb (if (> (-> this bench-n-b) 0) (/ (-> this bench-sum-b) (the int64 (-> this bench-n-b))) 0)))
      (__pc-autoport-publish "hud3d_cost_on_frames" (-> this bench-n-a))
      (__pc-autoport-publish "hud3d_cost_off_frames" (-> this bench-n-b))
      (__pc-autoport-publish "hud3d_cost_on_us" (the int ma))
      (__pc-autoport-publish "hud3d_cost_off_us" (the int mb))
      (__pc-autoport-publish "hud3d_cost_delta_us" (the int (if (> ma mb) (- ma mb) 0)))
      (let ((t4 (if (and (>= (-> this bench-n-a) HUD3D_BENCH_MIN)
                         (>= (-> this bench-n-b) HUD3D_BENCH_MIN))
                  (begin (+! measured 1) (if (>= (- ma mb) 300) 1 0))
                  1)))
        (__pc-autoport-publish "hud3d_t4_cost" t4)
        (if (and (>= (-> this bench-n-a) HUD3D_BENCH_MIN) (>= (-> this bench-n-b) HUD3D_BENCH_MIN))
          (hud3d-pub-name "hud3d_cost_state" "mesure_par_alternance_dans_une_seule_course")
          (hud3d-pub-name "hud3d_cost_state" "non-mesure"))

        ;; ── la somme ──────────────────────────────────────────────────────────────────────
        (__pc-autoport-publish "hud3d_judged_frames" (-> this judged))
        (__pc-autoport-publish "hud3d_slots_drawn" (-> this slots-drawn))
        (__pc-autoport-publish "hud3d_live_slots" (-> this live-slots))
        (__pc-autoport-publish "hud3d_master_on" (if (-> this on?) 1 0))
        (__pc-autoport-publish "hud3d_probe_on" (if (-> this probe?) 1 0))
        (__pc-autoport-publish "hud3d_off_checks" (-> this off-checks))
        (__pc-autoport-publish "hud3d_stock_sprite_spawns" (-> this stock-spawns))
        ;; ── §6 LA VISIBILITE EST CELLE DU HUD D'ORIGINE ───────────────────────────────────
        ;; `bad` = images ou le modele est soumis au rendu alors que son element de HUD est
        ;; replie. `ok` = images ou il l'est quand l'element est la. `hid` = taille de la
        ;; population « element replie » : sans elle, un zero ne dirait rien.
        (__pc-autoport-publish "hud3d_vis_frames" (-> this vis-frames))
        (__pc-autoport-publish "hud3d_vis_bad_buzzer" (-> this vis-bad-buzz))
        (__pc-autoport-publish "hud3d_vis_bad_cell" (-> this vis-bad-cell))
        (__pc-autoport-publish "hud3d_vis_bad_orb" (-> this vis-bad-orb))
        (__pc-autoport-publish "hud3d_vis_bad_eco" (-> this vis-bad-eco))
        (__pc-autoport-publish "hud3d_vis_shown_buzzer" (-> this vis-ok-buzz))
        (__pc-autoport-publish "hud3d_vis_shown_cell" (-> this vis-ok-cell))
        (__pc-autoport-publish "hud3d_vis_shown_orb" (-> this vis-ok-orb))
        (__pc-autoport-publish "hud3d_vis_shown_eco" (-> this vis-ok-eco))
        (__pc-autoport-publish "hud3d_vis_hidden_buzzer" (-> this vis-hid-buzz))
        (__pc-autoport-publish "hud3d_vis_hidden_cell" (-> this vis-hid-cell))
        (__pc-autoport-publish "hud3d_vis_hidden_orb" (-> this vis-hid-orb))
        (__pc-autoport-publish "hud3d_vis_hidden_eco" (-> this vis-hid-eco))

        ;; ── §7 LE PLACEMENT, CONFRONTE A CE QUE LE JEU DECLARE ────────────────────────────
        ;; `..._y` est l'ordonnee d'icone que NOTRE loi calcule a partir du sprite d'origine et
        ;; des bornes du modele ; `..._y_nd` est celle que le jeu declare pour cette icone-la
        ;; (`get-icon-pos-y` sur `hud-buzzers`), la methode que `hud-collecting` utilise pour y
        ;; faire voler la mouche ramassee. Les deux sources sont independantes : c'est le seul
        ;; terme de position de cet item qui ne soit pas un miroir de notre propre calcul.
        ;; AUCUNE VALEUR NEGATIVE ICI. `pc_autoport_publish` (kmachine.cpp:1566) ECRASE tout
        ;; negatif a zero : un ecart de -10 se publierait « 0 », c'est-a-dire « parfait ». On
        ;; publie donc la VALEUR ABSOLUE et le SENS a part. Consigne dans FINDINGS.txt.
        (__pc-autoport-publish "hud3d_place_buzzer_y" (-> this buzz-icon-y))
        (__pc-autoport-publish "hud3d_place_buzzer_y_nd" (-> this buzz-nd-y))
        (__pc-autoport-publish "hud3d_place_buzzer_dy_abs" (abs (- (-> this buzz-icon-y) (-> this buzz-nd-y))))
        (__pc-autoport-publish "hud3d_place_buzzer_above_nd" (if (< (-> this buzz-icon-y) (-> this buzz-nd-y)) 1 0))
        (__pc-autoport-publish "hud3d_place_buzzer_x" (-> this buzz-icon-x))
        (__pc-autoport-publish "hud3d_place_buzzer_x_nd_text" (-> this buzz-nd-x))
        (__pc-autoport-publish "hud3d_place_buzzer_bounds_y" (the int (-> *buzzer-sg* bounds y)))
        (__pc-autoport-publish "hud3d_place_buzzer_scale_y_milli_abs" (abs (the int (* 100000.0 (-> this buzz-ref-sy)))))
        (__pc-autoport-publish "hud3d_place_buzzer_scale_y_negatif" (if (< (-> this buzz-ref-sy) 0.0) 1 0))
        (__pc-autoport-publish "hud3d_place_rel_y_milli" (the int (* 1000.0 (-> *video-parms* relative-y-scale))))
        (__pc-autoport-publish "hud3d_place_screen_sy" (-> *video-parms* screen-sy))
        (__pc-autoport-publish "hud3d_place_cell_dx_abs" (abs (-> this cell-dx)))
        (__pc-autoport-publish "hud3d_place_cell_dy_abs" (abs (-> this cell-dy)))

        ;; ── §9 LA PILE EST A SA PLACE ET A SA TAILLE — MESURE SUR L'IMAGE RENDUE ─────────
        ;; Les quatre boites, telles que `hud_box_probe` les a lues. Rien ici ne vient d'une
        ;; variable de placement : ce sont les pixels qui ont change entre une image ou
        ;; l'element etait cache et l'image suivante ou il etait dessine.
        (hud3d-px-pub 1 "cell_stock")
        (hud3d-px-pub 2 "cell_ours")
        (hud3d-px-pub 3 "buzzer")
        (hud3d-px-pub 4 "orb")
        (hud3d-px-pub 5 "ctrl")
        (__pc-autoport-publish "hud3d_px_cycles" (-> this px-cycles))
        ;; les quatre diagnostics qui separent « rien n'a bascule » de « l'image lue est muette »
        (__pc-autoport-publish "hud3d_px_state_mismatch" (-> this px-bad))
        (__pc-autoport-publish "hud3d_px_base_lum" (__pc-autoport-hud-box 1 12))
        (__pc-autoport-publish "hud3d_px_raw_mean_cell_ours" (__pc-autoport-hud-box 2 9))
        (__pc-autoport-publish "hud3d_px_raw_max_cell_ours" (__pc-autoport-hud-box 2 10))
        (__pc-autoport-publish "hud3d_px_raw_mean_cell_stock" (__pc-autoport-hud-box 1 9))
        (__pc-autoport-publish "hud3d_px_raw_mean_ctrl" (__pc-autoport-hud-box 5 9))
        (__pc-autoport-publish "hud3d_px_excluded_cell_ours" (__pc-autoport-hud-box 2 11))
        (__pc-autoport-publish "hud3d_px_excluded_cell_stock" (__pc-autoport-hud-box 1 11))
        ;; L'HISTOGRAMME D'ACCORD, par palier, pour l'element ET pour le controle. C'est ce qui
        ;; permet de lire le seuil sur les chiffres au lieu de le deviner : le decor et l'element
        ;; ne se separent que si leurs deux distributions ne se recouvrent pas.
        (__pc-autoport-publish "hud3d_px_agreemax_cell_ours" (__pc-autoport-hud-box 2 13))
        (__pc-autoport-publish "hud3d_px_agreemax_cell_stock" (__pc-autoport-hud-box 1 13))
        (__pc-autoport-publish "hud3d_px_agreemax_ctrl" (__pc-autoport-hud-box 5 13))
        (__pc-autoport-publish "hud3d_px_p50_cell_ours" (__pc-autoport-hud-box 2 14))
        (__pc-autoport-publish "hud3d_px_p75_cell_ours" (__pc-autoport-hud-box 2 15))
        (__pc-autoport-publish "hud3d_px_p90_cell_ours" (__pc-autoport-hud-box 2 16))
        (__pc-autoport-publish "hud3d_px_p100_cell_ours" (__pc-autoport-hud-box 2 17))
        (__pc-autoport-publish "hud3d_px_p50_cell_stock" (__pc-autoport-hud-box 1 14))
        (__pc-autoport-publish "hud3d_px_p75_cell_stock" (__pc-autoport-hud-box 1 15))
        (__pc-autoport-publish "hud3d_px_p90_cell_stock" (__pc-autoport-hud-box 1 16))
        (__pc-autoport-publish "hud3d_px_p100_cell_stock" (__pc-autoport-hud-box 1 17))
        (__pc-autoport-publish "hud3d_px_p50_ctrl" (__pc-autoport-hud-box 5 14))
        (__pc-autoport-publish "hud3d_px_p75_ctrl" (__pc-autoport-hud-box 5 15))
        (__pc-autoport-publish "hud3d_px_p90_ctrl" (__pc-autoport-hud-box 5 16))
        (__pc-autoport-publish "hud3d_px_p100_ctrl" (__pc-autoport-hud-box 5 17))
        ;; ── DE QUOI CONVERTIR DES PIXELS EN UNITES DE CANEVAS SANS UNE COURSE DE PLUS ────────
        ;; Une boite en pixels ne dit pas, a elle seule, de combien il faut corriger l'echelle ou
        ;; la position : il manque le facteur de projection du HUD, qui depend de la profondeur de
        ;; l'icone et du champ de la camera. On publie donc, pour les DEUX piles, la transformation
        ;; qui a produit ces pixels. Le facteur se deduit alors d'une boite et de sa transformation,
        ;; au lieu d'etre suppose — c'est ce qui manquait a l'essai 2 pour passer de « 0 px » a une
        ;; correction chiffree. Valeurs absolues : `pc_autoport_publish` ecrase les negatifs a zero.
        (when (and fc (> (-> fc 0 nb-of-icons) 1))
          (__pc-autoport-publish "hud3d_tr_stock_x_abs" (abs (the int (-> fc 0 icons 0 icon 0 root trans x))))
          (__pc-autoport-publish "hud3d_tr_stock_y_abs" (abs (the int (-> fc 0 icons 0 icon 0 root trans y))))
          (__pc-autoport-publish "hud3d_tr_stock_y_negatif" (if (< (-> fc 0 icons 0 icon 0 root trans y) 0.0) 1 0))
          (__pc-autoport-publish "hud3d_tr_stock_z" (abs (the int (-> fc 0 icons 0 icon 0 root trans z))))
          (__pc-autoport-publish "hud3d_tr_stock_sx_e5" (abs (the int (* 100000.0 (-> fc 0 icons 0 icon 0 root scale x)))))
          (__pc-autoport-publish "hud3d_tr_stock_sy_e5" (abs (the int (* 100000.0 (-> fc 0 icons 0 icon 0 root scale y)))))
          (__pc-autoport-publish "hud3d_tr_ours_x_abs" (abs (the int (-> fc 0 icons 1 icon 0 root trans x))))
          (__pc-autoport-publish "hud3d_tr_ours_y_abs" (abs (the int (-> fc 0 icons 1 icon 0 root trans y))))
          (__pc-autoport-publish "hud3d_tr_ours_y_negatif" (if (< (-> fc 0 icons 1 icon 0 root trans y) 0.0) 1 0))
          (__pc-autoport-publish "hud3d_tr_ours_z" (abs (the int (-> fc 0 icons 1 icon 0 root trans z))))
          (__pc-autoport-publish "hud3d_tr_ours_sx_e5" (abs (the int (* 100000.0 (-> fc 0 icons 1 icon 0 root scale x)))))
          (__pc-autoport-publish "hud3d_tr_ours_sy_e5" (abs (the int (* 100000.0 (-> fc 0 icons 1 icon 0 root scale y)))))
          ;; le rayon que CHAQUE draw-control declare : c'est lui que l'essai 2 croyait comparer
          (__pc-autoport-publish "hud3d_tr_stock_bounds_w" (the int (-> fc 0 icons 0 icon 0 draw bounds w)))
          (__pc-autoport-publish "hud3d_tr_ours_bounds_w" (the int (-> fc 0 icons 1 icon 0 draw bounds w))))
        ;; LES SITES DE PLACEMENT, ET LEUR FORME (owner 17/09 : « du positionnement absolu ! »).
        ;; Trois sites, tous en unites du canevas de HUD (512x448) relues sur l'element d'origine :
        ;; la pile (icons 1 suit icons 0), la mecamouche (la loi appliquee a `init-pos` du sprite),
        ;; l'eco verte (init-pos recopie a chaque image). Aucun pixel d'appareil nulle part.
        (__pc-autoport-publish "hud3d_place_sites" 3)
        (__pc-autoport-publish "hud3d_place_sites_in_pixels" 0)
        (hud3d-pub-name "hud3d_place_sites_form" "unites_du_canevas_hud_512x448_relues_sur_l_element_d_origine")
        (__pc-autoport-publish "hud3d_place_rel_x_milli" (the int (* 1000.0 (-> *video-parms* relative-x-scale))))

        (let* ((vbad (+ (-> this vis-bad-buzz) (-> this vis-bad-cell) (-> this vis-bad-orb) (-> this vis-bad-eco)))
               (vok (+ (-> this vis-ok-buzz) (-> this vis-ok-cell) (-> this vis-ok-orb) (-> this vis-ok-eco)))
               (vhid (+ (-> this vis-hid-buzz) (-> this vis-hid-cell) (-> this vis-hid-orb) (-> this vis-hid-eco)))
               (t6 (if (and (> vhid 0) (> vok 0)) (begin (+! measured 1) vbad) (+ vbad 1)))
               (t7 (if (zero? (-> this buzz-icon-y))
                     1
                     (begin (+! measured 1)
                            (if (> (abs (- (-> this buzz-icon-y) (-> this buzz-nd-y))) 2) 1 0))))
               (t1 (if (>= (-> this judged) HUD3D_BENCH_MIN) (begin (+! measured 1) id-bad) (+ id-bad 1)))
               (t2 (if (>= (-> this judged) HUD3D_BENCH_MIN) (begin (+! measured 1) (-> this stock-spawns)) 1))
               (t3 (if (> (-> this judged) 0) (begin (+! measured 1) rect-bad) 1))
               (t5 (if (>= (-> this off-checks) HUD3D_BENCH_MIN) (begin (+! measured 1) (-> this off-bad)) 1))
               ;; §9 : notre pile contre la pile d'origine, EN PIXELS DE L'IMAGE.
               ;; Le terme n'est declare mesure que si les deux emplacements ont leur compte de
               ;; paires ET que le CONTROLE est vide : un controle non vide veut dire que le
               ;; filtre laisse passer du bruit, et une boite lue sous ce bruit ne prouve rien.
               (px-ns (__pc-autoport-hud-box 1 0))
               (px-no (__pc-autoport-hud-box 2 0))
               (px-ctrl (__pc-autoport-hud-box 5 5))
               (px-ws (hud3d-px-w 1))
               (px-hs (hud3d-px-h 1))
               (px-wo (hud3d-px-w 2))
               (px-ho (hud3d-px-h 2))
               (px-dcx2 (abs (- (hud3d-px-cx2 2) (hud3d-px-cx2 1))))
               (px-dcy2 (abs (- (hud3d-px-cy2 2) (hud3d-px-cy2 1))))
               ;; §10 — L'EFFET LUMINEUX DE LA PILE. CE TERME A REMPLACE CELUI DE LA BOITE EN PIXELS.
               ;; L'owner a tranche le 18/09 : « elle est bien a son emplacement attendu ! Mais […]
               ;; une pile d'energie in game a un effet lumineux, la notre dans le HUD ne l'a pas ».
               ;; La position et la taille (§9) sont donc VALIDEES par lui, et l'instrument qui les
               ;; mesurait est inexploitable sur cet appareil — essai 4 : 2,8 a 3,4 niveaux de
               ;; luminance d'ecart entre deux images IDENTIQUES pour un seuil de 6, controle
               ;; compris. Ses valeurs restent publiees juste dessous ; elles ne comptent plus.
               ;; Cinq grandeurs, toutes prises sur l'effet lui-meme :
               (t8 (if (and (>= (-> this glow-frames) HUD3D_GLOW_MIN) (> (-> this glow-compared) 0))
                     (begin
                       (+! measured 1)
                       (+ ;; nos quatre lanceurs sont ceux que le jeu lance pour cette icone
                          (if (= 4 (-> this glow-from-stock)) 0 1)
                          ;; et ce sont ceux de la pile du monde, champ par champ
                          (if (zero? (-> this glow-mismatch)) 0 1)
                          ;; la pile dessinee sans sa lueur : jamais
                          (if (zero? (-> this glow-missing)) 0 1)
                          ;; la lueur sans la pile : jamais
                          (if (zero? (-> this glow-bad)) 0 1)
                          ;; et le systeme a bien alloue des particules pour elle
                          (if (> (-> this glow-alloc) 0) 0 1)))
                     1)))
          (__pc-autoport-publish "hud3d_t1_identity" t1)
          (__pc-autoport-publish "hud3d_t2_sprites" t2)
          (__pc-autoport-publish "hud3d_t3_rect" t3)
          (__pc-autoport-publish "hud3d_t6_visibility" t6)
          (__pc-autoport-publish "hud3d_t7_place" t7)
          (__pc-autoport-publish "hud3d_t5_off" t5)
          (__pc-autoport-publish "hud3d_t8_glow" t8)
          (__pc-autoport-publish "hud3d_px_cell_term_retire_par_l_owner" 1)
          (__pc-autoport-publish "hud3d_px_dcx2_abs" px-dcx2)
          (__pc-autoport-publish "hud3d_px_dcy2_abs" px-dcy2)
          (__pc-autoport-publish "hud3d_px_ours_left_of_stock" (if (< (hud3d-px-cx2 2) (hud3d-px-cx2 1)) 1 0))
          (__pc-autoport-publish "hud3d_px_ours_below_stock" (if (< (hud3d-px-cy2 2) (hud3d-px-cy2 1)) 1 0))
          (__pc-autoport-publish "hud3d_px_w_ratio_milli" (if (> px-ws 0) (/ (* 1000 px-wo) px-ws) 0))
          (__pc-autoport-publish "hud3d_px_h_ratio_milli" (if (> px-hs 0) (/ (* 1000 px-ho) px-hs) 0))
          (__pc-autoport-publish "hud3d_terms_measured" measured)
          (__pc-autoport-publish "hud_model_defects" (+ t1 t2 t3 t4 t5 t6 t7 t8))))))
  0)


(defmethod hud-update ((this hud-3d-pickups))
  (let* ((master (and (-> *pc-settings* recharged-master?) #t))
         (armed (zero? (__pc-autoport-disarmed-for "hud-3d-pickups")))
         (on (and master armed))
         (fc (hud3d-elt HUD3D_SLOT_CELL))
         (bz (hud3d-elt HUD3D_SLOT_BUZZERS))
         (mo (hud3d-elt HUD3D_SLOT_MONEY))
         (pk (hud3d-elt HUD3D_SLOT_PICKUPS)))
    (set! (-> this on?) on)
    (set! (-> this probe?) (and (nonzero? (__pc-autoport-cost-probe "hud-3d-pickups")) #t))

    ;; ── l'alternance du banc de cout ────────────────────────────────────────────────────────
    ;; Deux courses separees mesureraient une scene et une cadence qui derivent. Les deux regimes
    ;; alternent donc DANS LA MEME course, par blocs, les premieres images de chaque bloc jetees.
    (cond
      ((and on (-> this probe?))
       (+! (-> this block-n) 1)
       (when (>= (-> this block-n) HUD3D_BENCH_BLOCK)
         (set! (-> this block-n) 0)
         (set! (-> this regime) (- 1 (-> this regime)))))
      (else (set! (-> this regime) 0) (set! (-> this block-n) HUD3D_BENCH_BLOCK)))

    (when on
      ;; une icone morte se refait
      ;; du niveau absente ferait naitre et mourir un process par image jusqu'a la fin de la course.
      ;; LE NETTOYAGE A CHAQUE IMAGE, LA RE-CREATION ESPACEE. Le premier est vital (voir
      ;; `hud3d-drop-dead-icons`) ; la seconde ne l'est pas, et la faire a chaque image ferait
      ;; naitre et mourir un process par image tant que l'art du niveau manque.
      (hud3d-drop-dead-icons fc)
      (hud3d-drop-dead-icons bz)
      (hud3d-drop-dead-icons mo)
      ;; A CHAQUE IMAGE, PAS PAR ECHANTILLONNAGE. Les trois fonctions ne font RIEN quand l'icone
      ;; est deja vivante (leur garde porte sur `nb-of-icons` et sur la vie du manipy) : les
      ;; espacer n'economise rien et laisse au contraire une fenetre ou l'element porte un slot
      ;; que `hud::draw-icons` dereference. Mesure du 17/09 : espacees de 15 images, SIGSEGV a
      ;; l'image 675 a chaque course ; a chaque image, plus de 13 000 images sans incident.
      (hud3d-make-cell-icon this)
      (hud3d-make-buzzer-icon this)
      (hud3d-repair-orb-icon this)
      (when (-> this probe?) (hud3d-pin pk) (hud3d-pin mo) (hud3d-pin fc) (hud3d-pin bz)))
    (hud3d-set-regime this (and on (zero? (-> this regime))))

    ;; ── §9 LA SEQUENCE QUI FAIT LIRE LA BOITE ENGLOBANTE SUR L'IMAGE ────────────────────────
    ;; Elle ECRASE les choix de regime pour cette image — c'est ce qui isole un seul modele a la
    ;; fois — et ne tourne que sous la sonde, tant qu'il reste des paires a prendre. Quand le
    ;; compte est fait, elle s'arrete et rend la main au banc de cout, qui mesure alors des
    ;; images que l'instrument ne touche plus.
    (set! (-> this px-on) #f)
    (when (and on (-> this probe?))
      (let ((fc2 (hud3d-elt HUD3D_SLOT_CELL))
            (bz2 (hud3d-elt HUD3D_SLOT_BUZZERS))
            (mo2 (hud3d-elt HUD3D_SLOT_MONEY)))
        (cond
          ((and (hud3d-px-ready? this fc2 bz2 mo2)
                (< (__pc-autoport-hud-box 5 0) HUD3D_PX_PAIRS))
           (set! (-> this px-on) #t)
           ;; ── ON ARRETE LE MONDE PENDANT LA MESURE ────────────────────────────────────────
           ;; Trois discriminants statistiques ont echoue avant celui-ci, tous pour la meme
           ;; raison : on cherchait la silhouette d'un modele dans la difference entre deux
           ;; images d'un jeu QUI TOURNE, ou 3 000 pixels changent d'eux-memes a chaque paire.
           ;; Le decor mobile et l'element n'y sont pas separables — mesure du 17/09 : palier
           ;; 50 % a 9 008 pixels pour notre pile contre 8 581 pour le CONTROLE, c'est-a-dire
           ;; aucune separation du tout.
           ;; `*master-mode*` a 'pause fige le monde entier : les acteurs, la camera et les
           ;; particules portent le bit `pause` de leur masque et cessent de tourner, et
           ;; `hud::draw-hud` (hud.gc:24) cesse de lancer les sprites de HUD. Les elements de
           ;; HUD, eux, ont ce bit EFFACE (`hud-init-by-other`, hud.gc:293) : leur `draw-icons`
           ;; continue de poser les icones. La difference entre l'image cachee et l'image
           ;; dessinee ne porte donc plus QUE le modele qu'on montre — la mesure cesse d'etre
           ;; une statistique pour devenir exacte.
           ;; Ce geste ne tourne que sous `debug.opengoal.costprobe` et il est RENDU des que la
           ;; sequence a son compte : le banc de cout (§4) mesure ensuite un jeu qui tourne.
           (when (not (-> this px-paused))
             (set! (-> this px-paused) #t)
             (set! *master-mode* 'pause))
           (hud3d-px-drive this fc2 bz2 mo2))
          (else
           (set! (-> this px-hold) 0)
           (when (-> this px-paused)
             (set! (-> this px-paused) #f)
             (set! *master-mode* 'game))))))
    ;; le monde est rendu meme si la sonde s'eteint en cours de route
    (when (and (-> this px-paused) (or (not on) (not (-> this probe?))))
      (set! (-> this px-paused) #f)
      (set! *master-mode* 'game))

    ;; ── notre emetteur d'eco verte suit l'element d'origine ─────────────────────────────────
    ;; Sa position N'EST PAS un litteral : elle est relue sur l'element d'origine a chaque image,
    ;; ce qui rend l'egalite des rectangles (livrable §3) mesuree et non affirmee.
    (when (and pk (> (-> pk 0 nb-of-particles) 0) (> (-> this nb-of-particles) 0))
      (set! (-> this particles 0 init-pos x) (-> pk 0 particles 0 init-pos x))
      (set! (-> this particles 0 init-pos y) (-> pk 0 particles 0 init-pos y))
      (set! (-> this particles 0 init-pos z) (-> pk 0 particles 0 init-pos z)))
    (when pk
      (set! (-> this offset) (-> pk 0 offset))
      (set! (-> this y-offset) (-> pk 0 y-offset))
      (when (!= (-> this last-hide-time) (current-time))
        (cond
          ((and on (not (hidden? (-> pk 0))) (hidden? this)) (send-event this 'show))
          ((and (or (not on) (hidden? (-> pk 0))) (not (hidden? this))) (send-event this 'hide-quick)))))

    ;; ── le temps par image, releve ici parce que ce point tourne a CHAQUE image, cache ou non ─
    (let ((now (__pc-autoport-now-us)))
      (when (and (nonzero? (-> this bench-last)) (-> this probe?) on)
        (let ((dt (- now (-> this bench-last))))
          ;; une image de plus de 200 ms n'est pas une image : c'est un chargement
          ;; UNE IMAGE DE LA SEQUENCE DE MESURE N'EST PAS UNE IMAGE DU JEU : elle porte deux
          ;; relectures de la FBO. La compter ferait mesurer au banc §4 notre propre instrument.
          (when (and (> dt 0) (< dt 200000) (not (-> this px-on))
                     (>= (-> this block-n) HUD3D_BENCH_SETTLE))
            (cond
              ((zero? (-> this regime)) (+! (-> this bench-sum-a) dt) (+! (-> this bench-n-a) 1))
              (else (+! (-> this bench-sum-b) dt) (+! (-> this bench-n-b) 1))))))
      (set! (-> this bench-last) now))

    ;; ── §10 L'EFFET LUMINEUX DE LA PILE ─────────────────────────────────────────────────────
    ;; Apres la sequence de boite (qui n'allume qu'un modele a la fois) et apres le regime : la
    ;; lueur suit le modele REELLEMENT soumis au rendu a cette image, quel que soit l'etat de
    ;; notre propre process.
    (hud3d-glow-drive this fc (and on (zero? (-> this regime)) (not (-> this px-on))))

    ;; ── ce qui est DESSINE a cette image ────────────────────────────────────────────────────
    (when on
      (let ((slots 0)
            (live 0))
        ;; orbe : l'element d'origine porte deja le vrai modele
        (when (and mo (hud3d-alive? (-> mo 0 icons 0 icon)))
          (+! live 1)
          (when (not (hidden? (-> mo 0))) (+! slots 1))
          (set! (-> this orb-ext) (hud3d-ext (-> mo 0 icons 0 icon) (-> mo 0 icons 0 scale-x))))
        (when (and fc (> (-> fc 0 nb-of-icons) 1) (hud3d-alive? (-> fc 0 icons 1 icon)))
          (+! live 1)
          (when (not (hidden? (-> fc 0))) (+! slots 1)))
        (when (and bz (> (-> bz 0 nb-of-icons) 0) (hud3d-alive? (-> bz 0 icons 0 icon)))
          (+! live 1)
          (when (not (hidden? (-> bz 0))) (+! slots 1)))
        (when (and (> (-> this nb-of-particles) 0) (hud3d-spawned-this-frame? (-> this particles 0 part)))
          (+! live 1)
          (+! slots 1))
        (set! (-> this slots-drawn) slots)
        (set! (-> this live-slots) live)
        (if (> slots 0) (__pc-autoport-hit-for "hud-3d-pickups" slots))

        ;; ── §6 LE RECENSEMENT DE VISIBILITE ───────────────────────────────────────────────
        ;; Par emplacement, et seulement dans NOTRE regime : « ce modele est-il soumis au rendu
        ;; alors que son element de HUD est replie ? ». Les deux grandeurs viennent du jeu — le
        ;; bit `hidden` du draw-control d'un cote, l'etat de l'element de l'autre — et aucune des
        ;; deux n'est une variable a nous. C'est ce terme qui aurait rougi sur les captures du
        ;; 17/09, ou la mecamouche et la pile etaient dessinees HUD replie.
        (when (zero? (-> this regime))
          (+! (-> this vis-frames) 1)
          (when bz
            (let ((v (hud3d-vis-verdict this
                                        (hidden? (-> bz 0))
                                        (and (> (-> bz 0 nb-of-icons) 0)
                                             (hud3d-icon-drawn? (-> bz 0 icons 0 icon)))
                                        0)))
              (if (= v 1) (+! (-> this vis-bad-buzz) 1))
              (if (= v 2) (+! (-> this vis-ok-buzz) 1))
              (if (or (= v 1) (= v 3)) (+! (-> this vis-hid-buzz) 1))))
          (when fc
            (let ((v (hud3d-vis-verdict this
                                        (hidden? (-> fc 0))
                                        (and (> (-> fc 0 nb-of-icons) 1)
                                             (hud3d-icon-drawn? (-> fc 0 icons 1 icon)))
                                        1)))
              (if (= v 1) (+! (-> this vis-bad-cell) 1))
              (if (= v 2) (+! (-> this vis-ok-cell) 1))
              (if (or (= v 1) (= v 3)) (+! (-> this vis-hid-cell) 1))))
          (when mo
            (let ((v (hud3d-vis-verdict this
                                        (hidden? (-> mo 0))
                                        (and (> (-> mo 0 nb-of-icons) 0)
                                             (hud3d-icon-drawn? (-> mo 0 icons 0 icon)))
                                        2)))
              (if (= v 1) (+! (-> this vis-bad-orb) 1))
              (if (= v 2) (+! (-> this vis-ok-orb) 1))
              (if (or (= v 1) (= v 3)) (+! (-> this vis-hid-orb) 1))))
          ;; L'ECO VERTE SE JUGE SUR TROIS IMAGES, PAS DEUX. Son temoin n'est pas un bit lu dans
          ;; l'image : `hud3d-spawned-this-frame?` regarde UNE image en arriere (l'ordre des
          ;; process dans l'image n'est pas garanti). Accuser sur deux images ferait donc porter
          ;; a l'image du repli un lancement qui, lui, etait legitime. Avec trois images
          ;; consecutives repliees, tout lancement vu dans la fenetre du temoin a bien eu lieu
          ;; alors que le sprite d'origine ne se lancait plus.
          (when (and pk (> (-> this nb-of-particles) 0))
            (let* ((h (and (hidden? (-> pk 0)) #t))
                   (h1 (logtest? (-> this was-hid) (ash 1 3)))
                   (h2 (logtest? (-> this was-hid) (ash 1 4)))
                   (spawned (hud3d-spawned-this-frame? (-> this particles 0 part))))
              (if h1 (logior! (-> this was-hid) (ash 1 4)) (logclear! (-> this was-hid) (ash 1 4)))
              (if h (logior! (-> this was-hid) (ash 1 3)) (logclear! (-> this was-hid) (ash 1 3)))
              (cond
                ((and h h1 h2)
                 (+! (-> this vis-hid-eco) 1)
                 (if spawned (+! (-> this vis-bad-eco) 1)))
                ((not h) (if spawned (+! (-> this vis-ok-eco) 1)))))))

        ;; LA POPULATION JUGEE : les quatre elements d'origine existent et au moins un
        ;; emplacement dessine. Elle N'EXIGE PAS que les quatre modeles soient vivants — une porte
        ;; qui attend « les quatre dans la MEME image » est morte des qu'UN emplacement l'est, et
        ;; ne dit alors plus rien des trois autres. L'emplacement manquant est compte par le terme
        ;; d'identite (§1), qui le NOMME ; les termes §2, §3 et §5 restent mesures.
        ;; ET APRES LE TEMPS D'ETABLISSEMENT DU BANC. `hud3d-spawned-this-frame?` regarde UNE
        ;; image en arriere (l'ordre des process dans l'image n'est pas garanti) : les premieres
        ;; images d'un bloc relisent donc le lanceur du regime PRECEDENT. Sans cette garde, la
        ;; mesure du 17/09 rendait `hud3d_t2_sprites=994` et `hud3d_t5_off=254` pour 125 bascules
        ;; — soit 2 images x 4 lanceurs par bascule : un plancher STRUCTUREL du banc, pas un
        ;; defaut du jeu. C'est la meme fenetre que celle qui protege le temps par image.
        (when (and (> slots 0) pk bz mo fc (>= (-> this block-n) HUD3D_BENCH_SETTLE))
          (+! (-> this judged) 1)
          (cond
            ((zero? (-> this regime))
             ;; §2 — PLUS DE SPRITE : aucun lancement du chemin d'origine pour ces quatre elements
             (+! (-> this stock-spawns)
                 (+ (hud3d-stock-spawned pk 0)
                    (hud3d-stock-spawned bz 0)
                    (hud3d-stock-spawned mo 0)
                    (hud3d-stock-spawned fc 0))))
            (else
             ;; §5 — ETEINT = ORIGINE : l'element d'origine redessine, le notre est retire
             (+! (-> this off-checks) 1)
             (if (hud3d-spawned-this-frame? (-> this particles HUD3D_PART_ECO part)) (+! (-> this off-bad) 1))
             (if (and (> (-> this nb-of-particles) HUD3D_PART_GLOW)
                      (hud3d-spawned-this-frame? (-> this particles HUD3D_PART_GLOW part)))
               (+! (-> this off-bad) 1))
             (if (and fc (> (-> fc 0 nb-of-icons) 1) (not (hud3d-alive? (-> fc 0 icons 0 icon))))
               (+! (-> this off-bad) 1)))))))

    ;; ── l'identite de l'emetteur d'eco verte, relevee des que la table des lanceurs est la ──
    ;; Elle ne depend d'AUCUN autre emplacement : la faire dependre de la population complete la
    ;; rendrait muette le jour ou un seul emplacement manque, et c'est exactement ce qui arrive.
    (when (and on (zero? (-> this eco-compared)) (nonzero? (-> *part-id-table* 202)) (nonzero? (-> *part-id-table* 2980)))
      (hud3d-eco-identity this))

    ;; ── l'identite de l'effet lumineux, relevee des que les deux familles de lanceurs sont la ──
    (when (and on (zero? (-> this glow-compared)) (nonzero? (-> *part-id-table* 228)) (nonzero? (-> *part-id-table* 319)))
      (hud3d-glow-identity this))

    (when (zero? (mod (the int (-> *display* integral-frame-counter)) 60)) (hud3d-publish this)))
  0
  (none))

(defmethod draw-particles ((this hud-3d-pickups))
  "La loi de placement du HUD pose les DEUX emetteurs a partir de leur `init-pos` et du repli de
   NOTRE process. Elle vaut pour l'eco verte, dont le slot est celui des ramassages. La lueur de
   la pile, elle, suit un autre element : on la repose ici, apres la loi generale, par les memes
   ecritures qu'elle (position puis emplacement d'ecran)."
  ((method-of-type hud draw-particles) this)
  (when (> (-> this nb-of-particles) HUD3D_PART_GLOW)
    (let ((fc (hud3d-elt HUD3D_SLOT_CELL)))
      (if (and fc (> (-> fc 0 nb-of-icons) 1) (hud3d-alive? (-> fc 0 icons 1 icon)))
        (hud3d-glow-place! this (-> fc 0 icons 1 icon)))))
  0
  (none))

(defmethod draw-hud ((this hud-3d-pickups))
  "L'EMETTEUR SUIT L'ELEMENT D'ORIGINE A L'IMAGE MEME, PAS PAR SON PROPRE ETAT.
   MESURE DU 17/09 (course appareil, 12 643 images jugees) : `hud3d_vis_bad_eco=51` — l'emetteur
   lancait encore une a deux images APRES que `hud-pickups` se soit replie, sur une vingtaine de
   replis. La cause est un aller-retour : notre process suit l'element par un evenement
   'show/'hide-quick, et cet evenement ne prend effet qu'a l'image SUIVANTE (et jamais dans une
   image ou `last-hide-time` vaut deja l'instant courant). Les trois autres emplacements n'ont pas
   ce defaut : leur visibilite est un bit qu'on pose sur le draw-control dans l'image meme.
   Ici la seule chose qui lance, c'est `hud::draw-hud`. On lui met donc la condition de l'element
   d'origine DEVANT : une lecture d'etat par image, et le lancement cesse a l'image exacte ou le
   sprite d'origine aurait cesse. L'evenement 'hide-quick reste — c'est lui qui libere les
   particules deja vivantes.

   §10 : L'EMETTEUR 1 (LA LUEUR DE LA PILE) N'EST PAS LANCE ICI, et c'est pour cela que cette
   methode ne delegue plus a `hud::draw-hud` : celle-ci lance TOUS les emetteurs du process. La
   lueur ne suit pas l'element ramassages mais le modele de la pile, et elle doit tirer meme quand
   notre process est replie. C'est `hud3d-glow-drive`, appele par `hud-update`, qui la lance.
   Le corps ci-dessous est celui de `hud::draw-hud` (hud.gc:23-28) restreint a l'emetteur 0 :
   memes gardes, meme condition de position, meme `skip-particle`."
  (let ((pk (hud3d-elt HUD3D_SLOT_PICKUPS)))
    (when (and (or (not pk) (not (hidden? (-> pk 0))))
               (not (hidden? this))
               (not (paused?))
               (!= HUD3D_PART_ECO (-> this skip-particle)))
      (if (or (!= (-> this particles HUD3D_PART_ECO pos x) 0.0)
              (!= (-> this particles HUD3D_PART_ECO pos y) 0.0))
        (spawn (-> this particles HUD3D_PART_ECO part) *null-vector*))))
  0
  (none))

(defmethod init-particles! ((this hud-3d-pickups) (arg0 int))
  "notre emetteur d'eco verte, au slot du sprite d'origine. Il vit sur CE process : le lanceur est
   alloue sur son tas, et il meurt avec lui — un lanceur pose sur le tas d'un autre element serait
   une reference pendante le jour ou cet element disparait."
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((s5-0 (-> this nb-of-particles)))
      (set! (-> this particles s5-0) (new 'static 'hud-particle))
      (set! (-> this particles s5-0 part) (create-launch-control group-hud-eco-green this))
      (set! (-> this particles s5-0 init-pos x) 110.0)
      (set! (-> this particles s5-0 init-pos y) 55.0)
      (set! (-> this particles s5-0 init-pos z) 1.0)
      (set! (-> this particles s5-0 part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  ;; §10 LA LUEUR DE LA PILE — second emetteur, sur CE process lui aussi. Il vit et meurt avec
  ;; nous ; sa position et son lancement, eux, suivent le modele de la pile (`hud3d-glow-drive`).
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((s5-1 (-> this nb-of-particles)))
      (set! (-> this particles s5-1) (new 'static 'hud-particle))
      (set! (-> this particles s5-1 part) (create-launch-control group-hud-cell-glow this))
      (set! (-> this particles s5-1 init-pos x) 256.0)
      (set! (-> this particles s5-1 init-pos y) 224.0)
      (set! (-> this particles s5-1 init-pos z) 1.0)
      (set! (-> this particles s5-1 part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  (dotimes (i (-> this nb-of-particles))
    (if (= (-> this particles i part matrix) -1) (set! (-> this particles i part matrix) (sprite-allocate-user-hvdf))))
  (set! (-> this x-sgn) -1)
  (set! (-> this y-sgn) -1)
  (set! (-> this friend) -1)
  (set! (-> this regime) 0)
  (set! (-> this block-n) HUD3D_BENCH_BLOCK)
  (set! (-> this bench-last) 0)
  0
  (none))

(defun deactivate-hud-pc ()
  "kill the pc hud"
  (dotimes (i HUD_PART_PC_AMOUNT)
    (if (-> *hud-parts-pc* parts i) (deactivate (ppointer->process (-> *hud-parts-pc* parts i)))))
  0)

(defun activate-hud-pc ((tree process-tree))
  "make the pc hud"
  (deactivate-hud-pc)
  (set! (-> *hud-parts-pc* battle-enemy)
        (process-spawn hud-battle-enemy :init hud-init-by-other 0 :from *pc-dead-pool* :to tree))
  ;; hud-3d-pickups : hors de FLAG_RECHARGED_HUD — la couche est dans le binaire livre et suit le
  ;; maitre Recharged. Le chantier de juillet etait entierement derriere le drapeau de compilation,
  ;; et c'est precisement ce qui manquait sur l'appareil de l'owner a sa ronde 4.
  (set! (-> *hud-parts-pc* pickups-3d)
        (the-as (pointer hud-pc) (process-spawn hud-3d-pickups :init hud-init-by-other 0 :from *pc-dead-pool* :to tree)))
  (#when FLAG_RECHARGED_HUD
  (set! (-> *hud-parts-pc* recharged-health)
        (the-as (pointer hud-pc) (process-spawn hud-recharged-health :init hud-init-by-other 0 :from *pc-dead-pool* :to tree))))
  ;; hud-eco-gauge : la jauge d'eco est lancee dans TOUS les binaires, comme pickups-3d ; elle
  ;; s'eteint a l'execution sur le maitre Recharged et le reglage HUD.
  (set! (-> *hud-parts-pc* recharged-power)
        (the-as (pointer hud-pc) (process-spawn hud-recharged-power :init hud-init-by-other 0 :from *pc-dead-pool* :to tree)))
  0)

(activate-hud-pc *display-pool*)

;; Grecharged-grass-poc ROUND#21d: frame countdown between ground-actor scans (the actors are
;; static; the C++ side keeps the last published set between scans). ROUND#22: 30 -> 15 frames so a
;; broken crate leaves the published set within ~0.25 s — with the 0.6 s TrampGhost ease-out the
;; grass is visibly back up inside the owner's 1 s budget (the scan is a cheap pool walk).
(define *grass-occ-scan-timer* 0)
;; ROUND#24: publish counter for the low-rate census logs ([R24CENSUS]/[R24DUMMY], one burst
;; every 40 publishes ~= 10 s in-game) — names any actor the old kind-0 catch-all would have
;; published (the moving-bald-circle offender class) without log spam.
(define *grass-occ-pub-count* 0)

;; Grecharged-grass-poc: per-frame push of the grass toggle + Jak's world position to
;; the renderer. Defined HERE (not pckernel-impl.gc) because this file compiles after
;; target-h, so *target* and (-> *target* control trans) resolve. Overrides the base
;; pc-settings update-to-os, which the display loop calls once per frame.

;; ── lighting-hdr essai 6 : LE RE-ANCRAGE DE LA PHASE DES PARTICULES ────────────────────────
;; Contrat et chiffres : game/graphics/refset.h, section « LES DEUX GESTES ».
;;
;; LE DEFAUT. Le jeu d'images de reference compare, pixel a pixel, une course qui CAPTURE et une
;; course qui REJOUE. Mesure du 2026-09-06 sur eae4df44, phase 1 (master OFF, ou notre chaine ne
;; dessine RIEN) : le seul objet qui differe est le FEU de la hutte de Samos — 12132 px sur 57600
;; a midi, ~25400 au crepuscule, ou sa lumiere repeint tout l'ecran. Sa phase est posee A LA
;; NAISSANCE de l'acteur (`sparticle-launcher.gc:590` lit `real-actual-frame-counter`, `:604` lit
;; `*particle-300hz-timer*`), donc a une frame de logique qui depend de la vitesse du chargement
;; asynchrone. Le re-teleport de l'ancre du plan ne la remet pas a zero.
;;
;; LE GESTE. A l'ancre — une frame de logique FIXE, la meme dans les deux courses —
;; `kill-and-free-particles` est appele sur chaque lanceur vivant : il remet `local-clock` a 0 et
;; efface `particles-active`, si bien que `spawn-time` se repose sur l'instant courant a la
;; prochaine image. La phase du feu cesse de dependre du chemin de chargement.
;;
;; POURQUOI PAS `reset-actors`. Il ferait le meme travail, mais il DESACTIVE tout l'arbre de
;; processus, et c'est exactement le geste qui tue la course en SIGILL sur arm64 au troisieme
;; `(start 'play)` (`GK-DIAG A36-TREE VIOLATION ... tree-self`). Ici on ne touche a aucun
;; processus : on ne fait que vider des lanceurs.
(defun refset-repin-particles ()
  "Re-ancre la phase de TOUS les lanceurs de particules sur la frame de logique courante."
  (let ((f (lambda ((arg0 process-drawable))
             (when (and (nonzero? arg0)
                        (type-type? (-> arg0 type) process-drawable)
                        (nonzero? (-> arg0 part)))
               (kill-and-free-particles (-> arg0 part)))
             (none))))
    (iterate-process-tree *entity-pool* (the-as (function object object) f) *null-kernel-context*)
    (iterate-process-tree *active-pool* (the-as (function object object) f) *null-kernel-context*))
  (format 0 "REFSET repin-particules fait~%")
  0
  (none))

(defmethod update-to-os ((obj pc-settings-jak1))
  ((method-of-type pc-settings update-to-os) obj)
  ;; Grecharged-master-toggle: push the GLOBAL master FIRST each frame (the C++ side composes
  ;; it with every individual flag via Gfx::recharged_active — the individual pushes below
  ;; stay the user's values, so re-enabling the master restores the config exactly).
  (pc-set-recharged-master! (if (-> obj recharged-master?) 1 0))
  ;; Glighting-hdr / SPEC-refonte-lumiere 6.2: puis le maitre de la REFONTE LUMIERE, juste apres
  ;; le master du projet. Les deux se composent cote C++ (Gfx::lighting_active = flag &&
  ;; recharged_lighting && recharged_master) ; on pousse donc les deux valeurs telles quelles.
  (pc-set-recharged-lighting! (if (-> obj recharged-lighting?) 1 0))
  ;; water-ocean-mesh : le maitre de la refonte EAU, pousse par image comme son jumeau lumiere.
  (pc-set-recharged-water! (if (-> obj recharged-water?) 1 0))
  ;; Grecharged-bundled-textures: push the bundled-textures toggle every frame (level texture
  ;; uploads consult it).
  ;; Grecharged-texture-hotreload : la bascule s'applique DESORMAIS SANS REDEMARRER ni recharger
  ;; de niveau. Le cote C++ compare le regime des portes a celui sous lequel chaque niveau
  ;; resident a ete televerse et re-resout ses textures (Loader::refresh_recharged_textures).
  ;; L'ancien contrat — « a flip applies on the next level load » — etait de surcroit faux pour
  ;; GAME.fr3, qui n'est jamais evince.
  (pc-set-recharged-textures! (if (-> obj recharged-textures?) 1 0))
  (pc-set-managed-assets! (if (-> obj managed-assets?) 1 0))
  (pc-set-recharged-grass! (if (-> obj recharged-grass?) 1 0))
  (#when FLAG_GRASS_OVERHANG (pc-set-grass-overhang! (if (-> obj recharged-grass-overhang?) 1 0)))
  ;; Grecharged-pbr-materials / lighting-legacy-purge : le rendu PBR est INCONDITIONNEL sous
  ;; RECHARGED LIGHTING — il n'y a plus d'interrupteur PBR ni de pile MODERN MATERIALS a pousser.
  ;; Ne restent que le soleil, les lumieres et le maitre de la refonte.
  (#when FLAG_PBR
    (pc-set-pbr-sun! (-> *time-of-day-context* current-shadow)
                     (-> *time-of-day-context* current-sun sun-color)
                     (-> *time-of-day-context* current-sun env-color))
    ;; Round-5 suspect (c): the VISIBLE sun's dome direction (what sparticle-track-sun
    ;; places the sun sprite with) — current-shadow is elevation-clamped and cannot align.
    (pc-set-pbr-sky-sun! (-> *sky-parms* upload-data sun 0 pos))
    ;; Grecharged-directional-ambient (owner playtest #3): the GREEN SUN = Jak's 2nd sun (sun
    ;; index 1). Push its REAL sky position so it is a real directional light day+night and
    ;; casts shadows at night (was a synthesised opposite-of-sun night-only vector).
    (pc-set-pbr-green-sun! (-> *sky-parms* upload-data sun 1 pos))
    ;; Round-4 multi-light: push light-group 0 (soleil + lune verte + fill) every frame.
    ;; Extern is (function pointer none) (light-group unresolvable in the early pc context);
    ;; pass the address of group 0 as a raw pointer — the renderer reads it as a float block.
    (pc-set-pbr-lights! (the-as pointer (-> *time-of-day-context* light-group 0)))
    ;; Glighting-hdr: recharged-lighting? is the sole lighting master, including the RT
    ;; composite. Push it and the baked sub-option every frame. The sun direction already
    ;; reaches the renderer via pc-set-pbr-sky-sun! above (the visible-sun dome vector).
    ;; lighting-legacy-purge : les poussees par image de l'ambiante, des ombres, du relief et
    ;; des carrousels de debug sont RETIREES avec leurs reglages. Ne reste que le maitre.
    (pc-set-rt-light! (if (-> obj recharged-lighting?) 1 0)))
  (pc-set-foliage-wind! (if (-> obj recharged-foliage-wind?) 1 0))
  ;; Grecharged-title-logo-fullres: draw the title-screen JAK AND DAXTER logo (and the ND boot logo)
  ;; at NATIVE resolution while the 3D world stays at RENDER SCALE. 0 = stock pipeline.
  (pc-set-crisp-title-logo! (if (-> obj crisp-title-logo?) 1 0))
  (#when FLAG_HD_MODELS (pc-set-recharged-enhanced-models! (if (-> obj recharged-enhanced-models?) 1 0)))
  ;; Grecharged-secondary-motion: push the chain-physics toggle + quality level (0/1 + level index).
  (#when FLAG_PHYSICS (pc-set-physics! (if (-> obj physics?) 1 0) (-> obj physics-quality)))
  ;; Gfixed-tick-interpolation : pousser l'interrupteur a CHAQUE image, comme la physique
  ;; et les modeles HD. Pousser au changement seulement laisserait l'etat du moteur
  ;; diverger de la case cochee apres un chargement de sauvegarde ou une remise a zero
  ;; des reglages. Sans drapeau de build (voir pckernel-impl.gc).
  (pc-set-fixed-tick! (if (-> obj fixed-tick?) 1 0))
  ;; Grecharged-ambient-occlusion: push the AO mode + quality + strength every frame (1:1, no translation).
  (pc-set-ambient-occlusion! (-> obj ambient-occlusion) (-> obj ao-quality) (-> obj ao-strength))
  (when *target*
    (pc-set-jak-pos! (-> *target* control trans)))
  ;; Grecharged-grass-poc POLISH#4/#5: push the two adjustable grass view-distances + density every frame.
  (set! (-> *grass-dist-scratch* x) (-> obj recharged-grass-near-dist))
  (set! (-> *grass-dist-scratch* y) (-> obj recharged-grass-card-dist))
  ;; Ggrass-density-presets (owner 2026-08-30): z no longer carries a density PERCENT — it carries the
  ;; PRESET INDEX (0=VERY LOW 1=LOW 2=MEDIUM 3=HIGH 4=VERY HIGH). Each index selects its own shipped
  ;; bake, so there is no intermediate value left that could ask for more density than the bake holds
  ;; and tip the renderer into the LIVE at-load placement path.
  (set! (-> *grass-dist-scratch* z) (the float (-> obj recharged-grass-density-preset)))
  ;; Grecharged-grass-precompute-mode: w channel carries the GRASS MODE toggle (1.0 = PRECOMPUTED
  ;; baked day-cycle tables / 0.0 = LIVE full at-load scan). Read into recharged_grass_precomputed C++-side.
  (set! (-> *grass-dist-scratch* w) (if (-> obj recharged-grass-precomputed?) 1.0 0.0))
  (pc-set-grass-dists! *grass-dist-scratch*)
  ;; Grecharged-grass-precompute-mode verification aid: freeze the time-of-day at a fixed hour
  ;; while debug.opengoal.tod.hour (hour*100) is set — pins hour/minute/second every frame so
  ;; A/B captures of the two grass modes see the SAME baked-light keyframe mix. Unset (-1) = normal cycle.
  ;; Guard: *time-of-day-proc* bare-symbol truthiness (the load-boundary.gc time-of-day command idiom).
  (let ((tod-h (pc-get-tod-hour)))
    (when (and (>= tod-h 0) *time-of-day-proc*)
      (set-time-of-day (* 0.01 (the float tod-h)))))
  ;; lighting-hdr essai 6 — le re-ancrage de la phase des particules, une seule fois, a l'ancre
  ;; du plan du jeu d'images. Hors de ce mode `pc-refset-repin-parts?` rend 0 a chaque image et
  ;; il ne se passe rien : le joueur ne rencontre jamais ce chemin. Voir `refset-repin-particles`.
  (if (nonzero? (pc-refset-repin-parts?)) (refset-repin-particles))
  ;; lighting-census — la liste des niveaux qui ONT un ciel, etablie par la DONNEE du jeu.
  ;; `refset_sky_missing` exige, pour chaque couple (niveau a ciel, heure fixe), que le ciel
  ;; occupe au moins 15 % de l'image. L'ensemble de depart de cette porte ne doit RIEN devoir
  ;; aux pixels qu'elle juge, sinon un point de vue qui regarde un mur sort de la liste et la
  ;; porte reste verte sans rien avoir vu. On recopie donc `info sky` — le meme champ que
  ;; `sky-draw` teste (sky-tng.gc:901) — pour les niveaux ACTIFS. Hors refset le pont C++ sort
  ;; a sa premiere ligne.
  ;; lighting-census — LA CAMERA EPINGLEE DU JEU DE REFERENCES. `cam-string` (l'etat ou
  ;; `target-continue` laisse la camera, target-death.gc:166) se replace derriere Jak a
  ;; l'horizontale : mesure du 2026-09-07, le ciel n'occupe alors au mieux que 119 pour mille de
  ;; l'image et huit vues sur 26 n'en montrent aucun, quand la porte en demande 150. On impose
  ;; donc la pose. `'locked` coupe la lecture de la manette ET tout le combineur
  ;; (cam-update.gc:334 -> move-camera-from-pad:169-190), et `*save-camera-inv-rot*` est recopie
  ;; tel quel dans `(-> *math-camera* inv-camera-rot)`. Hors du mode refset le pont C++ rend 0 a
  ;; sa premiere ligne et le joueur ne rencontre jamais ce chemin.
  (when (nonzero? (pc-refset-camera *refset-cam-trans* *refset-cam-fwd*))
    (set! *external-cam-mode* 'locked)
    (set! (-> *math-camera* trans quad) (-> *refset-cam-trans* quad))
    (forward-down->inv-matrix *save-camera-inv-rot* *refset-cam-fwd* *refset-cam-down*))
  (when (nonzero? (pc-refset-active?))
    (dotimes (li (-> *level* length))
      (let ((lv (-> *level* level li)))
        (when (and (= (-> lv status) 'active) (-> lv info))
          (pc-refset-note-level (symbol->string (-> lv info name))
                                (if (-> lv info sky) 1 0))))))
  ;; POLISH#4: while Jak hangs on a ledge, push the ledge grab point so the ledge-top grass parts
  ;; around his hands (else clear it by passing a null vector -> the renderer drops the effect).
  (if (and *target* (= (-> *target* next-state name) 'target-edge-grab))
      (pc-set-jak-ledge! (-> *edge-grab-info* center-hold))
      (pc-set-jak-ledge! (the-as vector 0)))
  ;; ROUND#21d: periodically push the ground actors' EXACT world positions to the grass renderer
  ;; over the pc-grass-occ channel (the pc-set-jak-pos! pattern — the Merc2 camera-space recovery is
  ;; dead). kind 0 = CULL (static unbreakable), kind 1 = TRAMPLE (breakable: crates, scarecrows — a
  ;; broken actor stops being pushed, so the renderer's ease-out springs the grass back at its spot).
  ;; ROUND#22 (owner 2026-07-12): (1) BREAKABLES publish ONLY while alive+DRAWN — a broken crate
  ;; does NOT die (crates.gc `die` sets (draw-status hidden) and the process PERSISTS in-pool), so
  ;; publishing by type alone kept flattening the grass under the ghost forever; skipping hidden/dead
  ;; breakables lets the C++ TrampGhost ease-out play the spring-back the moment the crate breaks
  ;; (statics are NOT hidden-gated — see the else arm). (2) GENERIC grass
  ;; collider: the radius is no longer a hand-guessed per-type constant but each actor's REAL draw
  ;; bounds (world bsphere radius, scaled 0.8 down to the ground-contact footprint, clamped
  ;; 0.5..2.5 m) — ANY drawn ground process-drawable near grass gets a correct footprint (future
  ;; levels' enemies for free); only the player pair, pickups, projectiles and manipy cutscene props
  ;; are excluded. Scarecrows are TRAINING-level types, matched by type-name symbol (no compile-time
  ;; level dependency).
  ;; Foliage shares this contact list even when grass is disabled. Refresh every three
  ;; frames while foliage wind is enabled so moving actors do not retain a 15-frame-old
  ;; footprint; grass alone keeps its existing cadence.
  (+! *grass-occ-scan-timer* 1)
  (when (and (or (-> obj recharged-grass?) (-> obj recharged-foliage-wind?))
             (>= *grass-occ-scan-timer* (if (-> obj recharged-foliage-wind?) 3 15)))
    (set! *grass-occ-scan-timer* 0)
    (+! *grass-occ-pub-count* 1)
    (pc-grass-occ-clear!)
    (iterate-process-tree
      *active-pool*
      (lambda ((proc process))
        (when (and (type-type? (-> proc type) process-drawable)
                   (!= (-> proc status) 'dead))
          (let* ((pd (the-as process-drawable proc))
                 (rt (-> pd root))
                 (dc (-> pd draw)))
            (when (and (nonzero? (the-as int rt)) (!= (the-as basic rt) #f))
              (if (and (nonzero? (the-as int dc)) (!= (the-as basic dc) #f))
                ;; DRAWN actor -> generic real-bounds footprint
                (let* ((hid (logtest? (-> dc status) (draw-status hidden)))
                      (trans (-> rt trans))
                      (tname (-> pd type symbol))
                      (r (the int (fmax (meters 0.5) (fmin (meters 2.5) (* 0.8 (-> dc bounds w))))))
                      ;; ROUND#23 (owner R22b: dummy trample circle should be his FEET, not the
                      ;; body): the TRAMPLE radius comes from the actor's collide-shape ROOT-PRIM
                      ;; radius (the physics ground footprint) instead of the full draw bsphere —
                      ;; a tall thin scarecrow's bsphere*0.8 pressed a 2.4 m circle; generic for
                      ;; any future breakable/enemy. Fallback bsphere*0.5, clamp 0.3..1.2 m.
                      ;; Crates: collide 1.70 m and bsphere*0.8 1.28 m both land at the 1.2 m
                      ;; clamp -> visually identical (owner: crates PERFECT, regression forbidden).
                      (r1 (the int
                               (fmax (meters 0.3)
                                     (fmin (meters 1.2)
                                           (if (and (type-type? (-> rt type) collide-shape)
                                                    (nonzero? (the-as int (-> (the-as collide-shape rt) root-prim))))
                                             (-> (the-as collide-shape rt) root-prim local-sphere w)
                                             (* 0.5 (-> dc bounds w)))))))
                      ;; ROUND#24 (owner R23: dummy grass never springs back): the training dummies
                      ;; REGENERATE — their break path (training-obs.gc hit-state) clears the
                      ;; collide-shape (clear-collide-with-as) at the FIRST break frame, seconds
                      ;; before the process hides/dies, and crates.gc `die` clears it at the same
                      ;; instant it hides. root-prim collide-with == 0 is therefore the earliest,
                      ;; census-able BROKEN flag for every breakable: gate the trample publish on
                      ;; it so the C++ TrampGhost ease-out springs the grass back the moment the
                      ;; actor breaks (and re-flattens if/when a dummy regenerates and collides
                      ;; again).
                      (cw-live (or (not (type-type? (-> rt type) collide-shape))
                                   (zero? (the-as int (-> (the-as collide-shape rt) root-prim)))
                                   (nonzero? (the-as int (-> (the-as collide-shape rt) root-prim collide-with)))))
                      (brk-ok (and (not hid) cw-live)))
                  (cond
                    ;; breakable -> TRAMPLE, gated alive+DRAWN+COLLIDABLE (a broken crate/dummy
                    ;; drops out of the set -> the C++ TrampGhost ease-out plays the spring-back)
                    ((type-type? (-> pd type) crate) (if brk-ok (pc-grass-occ-add! 1 trans r1)))
                    ((or (= tname 'scarecrow-a) (= tname 'scarecrow-b))
                     ;; ROUND#24 census of the dummy's real broken-state flags (owner mandate):
                     ;; one burst every ~10 s -> logcat evidence of which flag marks 'broken'.
                     (when (zero? (mod *grass-occ-pub-count* 40))
                       (format 0 "[R24DUMMY] ~A hid=~A cw-live=~A st=~A~%"
                               tname hid cw-live
                               (if (-> pd state) (-> pd state name) 'none)))
                     ;; R25 (owner theory CONFIRMED: grass stays flat while the DEBRIS despawn — the
                     ;; scarecrow process stays ALIVE waiting for its joint-exploder children
                     ;; `(while (-> self child) (suspend))` before cleanup-for-death, and a gate flag
                     ;; lies during that wait). Owner directive: IGNORE the debris logic entirely —
                     ;; publish the dummy trample ONLY while it stands in state `idle`. Broken -> never
                     ;; idle again -> the grass springs back at the FIRST break frame, debris despawn
                     ;; untouched; a regenerated dummy re-enters idle -> re-flattens.
                     ;; R30 (owner: a mere non-breaking HIT raised the grass — "un peu con"): the R25
                     ;; idle-only gate unpublished the dummy during its 2-3 s wobble anims. REMOVED —
                     ;; the R28 break hook (fires only at clear-collide = the REAL break) + the C++
                     ;; tombstone now own the break case, so: wobble -> stays flattened; break -> the
                     ;; tombstone bans the spot through the debris window and the ghost eases out
                     ;; smoothly like a crate.
                     (if brk-ok (pc-grass-occ-add! 1 trans r1)))
                    ;; ROUND#23 (owner R22b: break a dummy -> grass disappears, then lying, then
                    ;; upright): break/debris spawns are transient process-drawables that fell into
                    ;; the static CULL arm below -> a bald disc stomped the grass for the debris'
                    ;; lifetime, then the trample ghost replayed. joint-exploder = scarecrow/crate
                    ;; shard exploder; touch-tracker = dark-eco crate helper. Never publish them.
                    ((= tname 'joint-exploder) #f)
                    ((= tname 'touch-tracker) #f)
                    ;; not ground props: the player pair, pickups, projectiles, cutscene manipys
                    ((type-type? (-> pd type) target) #f)
                    ((type-type? (-> pd type) sidekick) #f)
                    ((type-type? (-> pd type) collectable) #f)
                    ((type-type? (-> pd type) projectile) #f)
                    ((type-type? (-> pd type) manipy) #f)
                    ;; ROUND#24 (owner R23: a bald circle GLIDES with the player after breaking a
                    ;; dummy): kind-0 CULL is now a STRICT ALLOWLIST of immobile ground MACHINES —
                    ;; never a catch-all. The old else-arm caught ANY drawn process-drawable, so
                    ;; the sage-hint VOICEBOX (a process-drawable using the 4 m `speaker` model
                    ;; whose voicebox-track behavior lerps its trans onto Jak every frame, spawned
                    ;; by the training-gimmie hint when a dummy breaks, NO entity to anchor it) was
                    ;; published as a 3 m cull disc riding the player. Collectibles, the sidekick,
                    ;; projectiles and anything animate are excluded BY CONSTRUCTION now.
                    ;; Statics stay NOT hidden-gated (eco vents draw eruption children only while
                    ;; ERUPTING -> a hidden gate made the vent-base cull flicker) and anchored at
                    ;; the ENTITY spawn trans when there is one (eruption actors bob ~+2.6 m, which
                    ;; exits the shader Y-band): the base sits where the designer placed it.
                    ((or (= tname 'warp-gate-switch) (= tname 'plat-eco) (= tname 'warpgate)
                         (= tname 'tra-iris-door) (= tname 'speaker) (= tname 'hutlamp))
                     ;; R26 (owner: Samos's flying DRONE — a dynamically-spawned speaker circling Jak —
                     ;; painted the gliding cull disc; "il ne touche pas le sol, faut l'ignorer"):
                     ;; statics publish ONLY when ENTITY-BACKED (designer-placed machines always have a
                     ;; level entity; dynamic spawns like the drone never do) and always at the entity's
                     ;; ground trans. No entity -> never published, BY CONSTRUCTION.
                     (let ((ent (-> proc entity)))
                       (when (and (nonzero? (the-as int ent)) (!= (the-as basic ent) #f))
                         (let ((etr (-> ent extra trans)))
                           (if etr (set! trans etr)))
                         (pc-grass-occ-add! 0 trans r))))
                    ;; Physical, visible, entity-backed actors (including nav enemies) bend
                    ;; vegetation at their live root position. Require a real collision primitive
                    ;; with active collision, not the permissive breakable fallback above.
                    ;; Keep this AFTER the exclusions and static allowlist: these contacts must
                    ;; never become CULL discs or change the established machine footprints.
                    ((and (not hid)
                          (nonzero? (the-as int (-> proc entity)))
                          (!= (the-as basic (-> proc entity)) #f)
                          (type-type? (-> rt type) collide-shape)
                          (nonzero? (the-as int (-> (the-as collide-shape rt) root-prim)))
                          (!= (the-as basic (-> (the-as collide-shape rt) root-prim)) #f)
                          (nonzero? (the-as int (-> (the-as collide-shape rt) root-prim collide-with))))
                     (pc-grass-occ-add-moving! (the int (-> proc pid)) trans r1))
                    ;; everything else: NEVER published. Low-rate census names what the old
                    ;; catch-all would have culled (the offender detector's GOAL half).
                    (else
                      (when (zero? (mod *grass-occ-pub-count* 40))
                        (format 0 "[R24CENSUS] excl ~A (~m ~m ~m)~%"
                                tname (-> trans x) (-> trans y) (-> trans z))))))
                ;; DRAWLESS actors (no draw-control at all): the vent family + ecovalve are pure
                ;; particle emitters with a REAL physical base in the level -> the bounds path can
                ;; never see them (ROUND#22b: the dc guard silently dropped ecovent, re-opening the
                ;; owner's "vent base clips"). Publish their entity-anchored base with a fixed
                ;; 1.8 m footprint. Every OTHER drawless process-drawable is an invisible logic
                ;; actor -> no publish (an invisible cull would punch mystery bald discs).
                (when (or (type-type? (-> pd type) vent) (type-type? (-> pd type) ecovalve))
                  (let ((trans (-> rt trans))
                        (ent (-> proc entity)))
                    (when (and (nonzero? (the-as int ent)) (!= (the-as basic ent) #f))
                      (let ((etr (-> ent extra trans)))
                        (if etr (set! trans etr))))
                    (pc-grass-occ-add! 0 trans (the int (meters 1.8)))))))))
        (none))
      *null-kernel-context*)
    (pc-grass-occ-publish!))
  (none))
