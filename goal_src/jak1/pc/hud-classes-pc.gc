;; 2983 <- 205 (« les petites particules qu'il est sensé émettre » — l'owner). Sa chaine vers 208
;; n'a pas de callback : elle est conservee (2984 <- 208). S2 S6 seulement.
(defpart 2983
  :init-specs
  ((:texture (hotdot effects))
   (:num 0.25)
   (:y (meters -0.041666667))
   (:scale-x (meters 0.25))
   (:scale-y :copy scale-x)
   (:r 255.0)
   (:g 255.0)
   (:b 0.0)
   (:a 48.0)
   (:scalevel-x (meters -0.00063131311))
   (:scalevel-y :copy scalevel-x)
   (:fade-r -2.8333333)
   (:accel-y (meters -0.000125))
