;;;; ROUND 5 — owner round-4 addendum #2 item 7 ("l'item [...] fait plutôt la taille entière de
;;;; la jauge avec la jauge par dessus"): the three GAUGE-CENTRE groups below are shrunk to fit
;;;; INSIDE the ring's centre hole. Not tuned by eye — measured:
;;;;   * hud sprite half-width (canvas x units) = scale-x / (2 * 60 * 1.9996) = scale-x / 239.95
;;;;     (sprite_3d.vert rendermode 2: basis_x.x = -P00, hud_matrix row3 w = 60*f0*pfog0,
;;;;      f0 = -1.9996*P00, corners +-0.5 — sprite.gc:283,294-297,465,478).
;;;;     The dominant layer (bigpuff, (meters 2.5)) therefore measured 42.7 units half-width.
;;;;   * the ring's transparent hole, measured off the alpha channel of recharged_assets/
;;;;     jak_gauge_empty.png, ends at r = 0.26 of the canvas half-size; the sprite is drawn at
;;;;     RHUD_GAUGE_HALF = 45, so the hole radius on screen is 0.26 * 45 = 11.7 units.
;;;; 42.7 units in an 11.7-unit hole = the owner's "full gauge size behind the gauge" exactly.
;;;; Factor 0.26 applied uniformly to every :scale-x / :scalevel-x / :vel-* / :accel-* below
;;;; (:z is depth ordering and :y the launch spread — both left alone, they are the stock hud
;;;; pickup's own values and already read compact). 2.5m -> 0.65m = 11.1 units half-width, i.e.
;;;; the cloud now sits inside the hole and the gauge no longer draws over it.
;;;; GREEN (720) is NOT scaled: it replaces the stock hud-pickups sprite at its own slot, where
;;;; the stock size is correct.
;;;; BLUE (id 721) — 75 structure, blue color subs.
(defpartgroup group-hud-eco-blue
  :id 721
  :flags (screen-space)
  :bounds (static-bspherem 0 0 0 2)
  :parts
  ((sp-item 2986 :flags (launch-asap) :binding 2987)
   (sp-item 2987 :flags (start-dead launch-asap) :binding 2988)
   (sp-item 2988 :flags (start-dead launch-asap) :binding 2989)
   (sp-item 2989 :flags (start-dead launch-asap) :binding 2990)
   (sp-item 2989 :flags (start-dead launch-asap) :binding 2990)
   (sp-item 2989 :flags (start-dead launch-asap) :binding 2990)
   (sp-item 2989 :flags (start-dead launch-asap) :binding 2990)
   (sp-item 2990 :fade-after (meters 40) :flags (start-dead))
   (sp-item 2990 :fade-after (meters 40) :flags (start-dead))
   (sp-item 2990 :fade-after (meters 40) :flags (start-dead))
   (sp-item 2990 :fade-after (meters 40) :flags (start-dead))))

