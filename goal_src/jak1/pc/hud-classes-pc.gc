;;-*-Lisp-*-
(in-package goal)
(require "engine/ui/hud.gc")
(require "levels/common/battlecontroller.gc")

#| Code for extra HUD elements in the PC port. |#

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; constants
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defconstant HUD_ICON_COUNT 6)

(defconstant HUD_PART_PC_AMOUNT 4)

;; VRAM slots where the PC runtime loads the recharged hud sprites (recharged_assets/*.png).
;; Must match kBaseSlot/kNames in game/graphics/opengl_renderer/RechargedHudTextures.cpp.
(defconstant RHUD_TBP_HEART_100 8300)
(defconstant RHUD_TBP_HEART_66 8301)
(defconstant RHUD_TBP_HEART_33 8302)
(defconstant RHUD_TBP_HEART_0 8303)
(defconstant RHUD_TBP_GAUGE_EMPTY 8304)
(defconstant RHUD_TBP_GAUGE_BLUE_FULL 8305)
(defconstant RHUD_TBP_GAUGE_RED_FULL 8306)
(defconstant RHUD_TBP_GAUGE_YELLOW_FULL 8307)
(defconstant RHUD_TBP_GAUGE_BLUE_END 8308)
(defconstant RHUD_TBP_GAUGE_RED_END 8309)
(defconstant RHUD_TBP_GAUGE_YELLOW_END 8310)

;; tex0 bits shared by all recharged hud textures: tbw=20, psm=ct32, tw=th=10, tcc=rgba, tfx=modulate.
;; (the pc direct renderer only reads tbp0/tcc/tfx and looks the texture up in the pool by tbp)
(defconstant RHUD_TEX0_BITS #x6a8050000)

;; screen placement (512x448 coordinate space of the 2d drawing helpers)
(defconstant RHUD_HEART_X 80.0)
(defconstant RHUD_HEART_Y 66.0)
(defconstant RHUD_HEART_HALF 30.0)
(defconstant RHUD_GAUGE_X 435.0)
(defconstant RHUD_GAUGE_Y 370.0)
(defconstant RHUD_GAUGE_HALF 45.0)
;; owner round-2: scaled up from 27.0 to match the stock gauge footprint
;; (x86-measured twice: 27 -> ring 155px vs stock 225px tall; at 40 the ring
;; width was still 361px vs stock 424px -> 45 lands on the stock footprint)

;; the fillable arc of the gauge ring: starts at 6 o'clock (16384 rotation units)
;; and spans 270 degrees (49152 units); the remaining quadrant is the decorated cap.
(defconstant RHUD_GAUGE_ARC_START 16384.0)
(defconstant RHUD_GAUGE_ARC_SPAN 49152.0)

;; scale for the real in-world fuel-cell model when shown as the hud icon
;; round-3: the full model reads smaller than the naked one; bump so the BODY is unmistakable on device
(defconstant RHUD_CELL_SCALE 0.013)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; screen-space eco partgroup clones (owner round-3 items 3+4)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; LES TROIS groupes du CENTRE DE LA JAUGE (bleu 721, rouge 722, jaune 723) sont des copies
;; structurelles du sprite de HUD d'origine `group-part-hud-pickup` (id 75, defparts 303-308),
;; avec substitution de couleur par type. Ils appartiennent au chantier de la jauge d'eco.
;; Part-id map : blue 721: 2986..2991 · red 722: 2992..2997 · yellow 723: 2998..3003.
;;
;; LE GROUPE VERT (720) N'EN FAIT PLUS PARTIE (hud-3d-pickups, 17/09). Il n'est plus une copie
;; du sprite de HUD : c'est le portage champ pour champ de l'emetteur du RAMASSABLE du monde
;; (`group-eco-green`, id 58), parts 2980..2984. Voir son en-tete juste dessous.

;;;; GREEN (id 720) — LE MEME EMETTEUR QUE LE RAMASSABLE, AUX SIX TRANSPOSITIONS QUE
;;;; L'ESPACE-ECRAN IMPOSE (hud-3d-pickups, 2026-09-17).
;;;;
;;;; L'owner, 17/09 : « pour la particule d'éco verte qui flotte à côté du coeur une vraie
;;;; particule d'eco verte comme celles qu'on ramasse in game (et pas un truc hacky comme c'est
;;;; dans le jeu original) ». Le ramassable, c'est `group-eco-green` (id 58,
;;;; engine/common-obs/collectables-part.gc:1249), parts 202/203/204/205 + les relances 206/207/208.
;;;; Il n'existe AUCUN modele 3D d'eco verte dans jak1 : le type `health` (collectables.gc:592)
;;;; ne pose qu'une `collide-shape-moving` et son rendu entier est ce groupe de particules.
;;;; L'identite du ramassable EST donc celle de son emetteur.
;;;;
;;;; Ce groupe est la copie champ pour champ de 58. Les transpositions sont MECANIQUES et
;;;; NOMMEES ; `hud3d-eco-spec-mismatch` compte, a l'execution, tout champ qui differe EN DEHORS
;;;; de cette liste — ce n'est donc pas une ressemblance affirmee, c'est une grandeur.
;;;;   S1  le groupe prend `:flags (screen-space)` : le slot du HUD dessine par la machinerie
;;;;       ecran (user-hvdf), pas dans le monde.
;;;;   S2  `bit14` (sprite 3D du monde) -> `bit9` (sprite d'espace-ecran) sur chaque part. La
;;;;       ronde 3 de juillet avait mesure qu'un clone garde en bit14 « spawns but renders
;;;;       NOTHING » : c'est cette transposition-la qui manquait.
;;;;   S3  les `:func` tombent : `sparticle-track-root-prim` (202) dereference la `collide-shape`
;;;;       de l'emetteur et `eco-fadeout` (203/204) son `state-flags` de process — un process
;;;;       `hud` ne porte ni l'une ni l'autre.
;;;;   S4  les relances 206/207 tombent AVEC leur callback. Dans le monde, `eco-fadeout` repousse
;;;;       `next-time` tant que l'emetteur ne s'efface pas : la chaine ne tire jamais et les
;;;;       couches vivent sur leur timer (seconds -0.005). Portee SANS le callback, elle basculait
;;;;       sur le lanceur de fondu apres 0,035 s et tuait les etincelles (mesure de la ronde 5).
;;;;       La chaine 205 -> 208, elle, n'a PAS de callback : elle est conservee telle quelle.
;;;;   S5  `:x (meters 4)` de l'ancre (202) tombe : un decalage de 4 metres vaut 16384 unites
;;;;       d'ecran, soit le nuage entier hors champ.
;;;;   S6  l'echelle de profondeur `:z` est celle du slot de HUD (0.03 / 0.065 / 0.12) et non
;;;;       celle du monde (0.3) : en espace-ecran `:z` est l'ordre de superposition du HUD.
;;;;   S7  toutes les grandeurs de TAILLE et de VITESSE sont multipliees par 0,8333 = 2,5 / 3,0 —
;;;;       le rapport entre le gabarit du slot d'origine (`:scale-x (meters 2.5)` de la part 304
;;;;       du groupe 75) et la taille MAXIMALE du nuage du monde (2 m + 1 m d'alea). C'est ce qui
;;;;       met le nuage DANS le rectangle de l'element d'origine (livrable §3) sans toucher a sa
;;;;       forme : densite, couleurs, rotations, durees de vie et fondus restent ceux du monde.
;;;;
;;;; La porte compare a l'execution, champ par champ, les parts 2980..2984 aux parts 202..205/208
;;;; de `*part-id-table*`. Les champs que S1..S7 transposent sont EXCLUS et comptes a part
;;;; (`hud3d_eco_fields_excluded`) ; tous les autres — texture, `:num`, couleurs, `:omega`,
;;;; `:rot-z`, `:rotvel-z`, `:timer`, `:fade-*` — doivent etre EGAUX, et c'est ce que
;;;; `hud3d_eco_spec_mismatch` compte. Ce sont exactement les quatre choses que l'owner a nommees :
;;;; densite, vacillement, petites particules, brillance.
(defpartgroup group-hud-eco-green
  :id 720
  :flags (screen-space)
  :bounds (static-bspherem 0 0 0 1)
  :parts
  ((sp-item 2980 :flags (launch-asap) :binding 2981)
   (sp-item 2981 :flags (start-dead launch-asap) :binding 2982)
   (sp-item 2981 :flags (start-dead launch-asap) :binding 2982)
   (sp-item 2981 :flags (start-dead launch-asap) :binding 2982)
   (sp-item 2981 :flags (start-dead launch-asap) :binding 2982)
   (sp-item 2981 :flags (start-dead launch-asap) :binding 2982)
   (sp-item 2981 :flags (start-dead launch-asap) :binding 2982)
   (sp-item 2981 :flags (start-dead launch-asap) :binding 2982)
   (sp-item 2982 :fade-after (meters 90) :flags (start-dead launch-asap) :binding 2983)
   (sp-item 2982 :fade-after (meters 90) :flags (start-dead launch-asap) :binding 2983)
   (sp-item 2982 :fade-after (meters 90) :flags (start-dead launch-asap) :binding 2983)
   (sp-item 2982 :fade-after (meters 90) :flags (start-dead launch-asap) :binding 2983)
   (sp-item 2982 :fade-after (meters 90) :flags (start-dead launch-asap) :binding 2983)
   (sp-item 2983 :fade-after (meters 40) :falloff-to (meters 60) :flags (start-dead))
   (sp-item 2983 :fade-after (meters 40) :falloff-to (meters 60) :flags (start-dead))
   (sp-item 2983 :fade-after (meters 40) :falloff-to (meters 60) :flags (start-dead))
   (sp-item 2983 :fade-after (meters 40) :falloff-to (meters 60) :flags (start-dead))
   (sp-item 2983 :fade-after (meters 40) :falloff-to (meters 60) :flags (start-dead))))

;; 2980 <- 202 (l'ancre invisible qui porte les liaisons). S2 S3 S5 S6.
(defpart 2980
  :init-specs
  ((:texture (starflash effects))
   (:num 1.0)
   (:z (meters 0.03))
   (:scale-x (meters 0.0083333333))
   (:scale-y :copy scale-x)
   (:r 0.0)
   (:g 0.0)
   (:a 1.0)
   (:timer (seconds -0.005))
