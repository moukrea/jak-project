   (sp-item 2988 :flags (start-dead launch-asap) :binding 2989)
   (sp-item 2988 :flags (start-dead launch-asap) :binding 2990)
   (sp-item 2988 :flags (start-dead launch-asap) :binding 2991)
   (sp-item 2988 :flags (start-dead launch-asap) :binding 2989)
   (sp-item 2988 :flags (start-dead launch-asap) :binding 2990)
   (sp-item 2988 :flags (start-dead launch-asap) :binding 2991)
   (sp-item 2989 :fade-after (meters 60) :flags (start-dead) :binding 2992)
   (sp-item 2990 :fade-after (meters 70) :flags (start-dead) :binding 2992)
