;;-*-Lisp-*-
(in-package goal)
(require "engine/game/settings-h.gc")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Gcutscene-skip-all — L'ETAT DU GESTE. Le dessin vit dans pc/cutscene-skip-draw.gc.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Demande owner du 2026-08-30 (soir) : « qu'a la place de ca, on puisse skip TOUTES les
;; cinematiques en maintenant appuye circle », y compris les CONTEXTUELLES (« celles qu'on a a
;; Geyser Rock »), que le mecanisme actuel ne couvre pas.
;;
;; POURQUOI CE FICHIER EST SI TOT DANS L'ORDRE DE COMPILATION (avant loader.gc, pov-camera.gc,
;; process-taskable.gc) : ce sont EUX qui lisent le predicat. Le fichier ne contient donc que
;; l'etat et le predicat ; tout ce qui a besoin de la police, du texte localise ou de `movie?`
;; (engine/game/main.gc) vit dans le fichier de dessin, compile a la fin.
;;
;; CE QUE LE MECANISME D'ORIGINE COUVRAIT (recensement du 2026-08-31) : UN SEUL chemin sur 75,
;; `process-taskable.gc`, et seulement quand `skip-movies?` est vrai. Le bouton etait TRIANGLE,
;; via `(= (get-response (-> arg0 query)) 'no)`.
;; LES 48 SITES `pov-camera` ETAIENT DU CODE MORT COTE ABANDON : aucun ne passe le drapeau
;; `notify-of-abort` (47 passent 0, un passe `inherit-orientation`), donc `check-for-abort`
;; consommait TRIANGLE et retournait toujours `#f`, et l'etat `pov-camera-abort` n'etait jamais
;; atteint. C'est exactement le trou que l'owner decrivait.
;;
;; 2026-09-01 — LE SAUT NATIF EST RETIRE, sur demande de l'owner (« ça collide un peu [...] c'est
;; un peu wacky »). Six sites sont tombes : le predicat de `process-taskable`, la lecture de
;; TRIANGLE de `check-for-abort`, et QUATRE rattrapages d'etat en `:exit` que le cycle 1 avait
;; manques parce qu'ils RESONDENT le pad (sage, sidekick-human x2, sequence-a-village1,
;; citadel-sages). Le maintien de CERCLE est desormais le seul geste de saut du jeu.
;;
;; DEUX GRANDEURS, A NE PAS CONFONDRE :
;;   - « une cinematique joue » : lue dans le fichier de dessin comme
;;     `(or (movie?) <marque de flux fraiche>)`. C'est la porte de l'INDICE.
;;   - « le geste a abouti » : `*cutscene-skip-fired*`, arme uniquement APRES deux secondes de
;;     maintien PENDANT une cinematique. C'est ce que lisent les chemins de lecture de scene.
;; La seconde ne peut pas s'armer sans la premiere : hors cinematique, maintenir CERCLE ne fait
;; rien, et la remise a zero se fait a la fin de chaque cinematique.
;;
;; L'HORLOGE. `(current-time)` = `base-frame-counter`, 300 unites par seconde de TEMPS REEL
;; (types-h.gc:54), pas par image : le maintien dure deux secondes quelle que soit la cadence.
;; RESERVE DECLAREE : sur l'appareil, `time-ratio` est plafonne a 4 images par image REELLEMENT
;; peinte (android/gk_android_main.cpp:787-799), donc sous 15 images/s l'horloge prend du retard
;; et le remplissage s'etire. C'est l'horloge de tout le moteur, pas une horloge a nous.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Duree de maintien exigee. UN QUART DE MOINS QUE LES 2 s DU CYCLE 1, demande owner du
;; 2026-08-31 : « faudrait que la cartouche pour skip (et donc l'action de skip) prenne un quart
;; moins de temps que ce que ça prend ». 2000 ms - 500 ms = 1500 ms = 450 unites de 1/300 s.
;; Ecrit en unites et non `(seconds 1.5)` : ce macro rend un FLOTTANT pour un argument flottant
;; (types-h.gc:62), et l'horloge se compare en entiers.
(defconstant CS_HOLD_TIME 450)
;; Combien de temps l'indice reste visible apres qu'on a touche un bouton.
(defconstant CS_HINT_TIME (seconds 4))
;; Fraicheur de la marque des chemins cables : 60 unites = 0,2 s. Au-dela, plus aucun chemin cable
;; ne tourne. Une chaine de scene enchaine plusieurs animations avec une image ou deux de battement
;; entre elles -- cette tolerance evite que l'indice clignote a chaque raccord.
(defconstant CS_MARK_GRACE 60)

;; Derniere image ou un chemin de scene REELLEMENT CABLE a tourne. C'est la grandeur qui decide
;; si l'indice a le droit d'apparaitre : on ne promet « Skip » que la ou le saut aboutit.
(define *cutscene-skip-mark* (the-as time-frame 0))
;; LE VERROU. #t = le geste a abouti, la cinematique en cours doit s'arreter. Remis a #f des que
;; plus aucune cinematique ne tourne.
(define *cutscene-skip-fired* #f)
;; Debut du maintien courant de CERCLE ; `*cutscene-skip-holding*` dit s'il est valide.
(define *cutscene-skip-holding* #f)
(define *cutscene-skip-hold-t0* (the-as time-frame 0))
;; Avancement du remplissage, 0.0 -> 1.0. Lu par le dessin.
(define *cutscene-skip-progress* 0.0)
;; Derniere fois qu'on a touche un bouton pendant la cinematique. 0 = jamais.
(define *cutscene-hint-stamp* (the-as time-frame 0))
;; Publie chaque image par la mise a jour ; lu par le dessin et par les traces.
(define *cutscene-in-cutscene* #f)

;; --- diagnostics, jamais lus par une decision ---
(define *cutscene-skip-count* 0)         ;; nombre de gestes aboutis depuis le lancement
(define *cutscene-skip-ticks* 0)         ;; unites d'horloge REELLEMENT consommees par le dernier
(define *cutscene-frames-no-hint* 0)     ;; images de cinematique passees AVANT le 1er indice
(define *cutscene-hint-frames* 0)        ;; images ou l'indice a ete REELLEMENT dessine
(define *cutscene-skip-trace* #f)        ;; #t = publier une ligne par abandon (opt-in)
;; INSTRUMENT DE HARNAIS, JAMAIS ECRIT PAR LE JEU. #t force le BIT CERCLE dans le mot de boutons
;; du pad, a la premiere ligne de la mise a jour -- donc EN AMONT du `cpad-hold?` que le code
;; livre execute. Ce n'est pas un contournement du geste : la lecture du pad, la mesure des deux
;; secondes, le remplissage, l'armement du verrou et l'abandon dans la boucle de scene sont tous
;; exerces tels quels. Le seul maillon qu'il ne couvre pas est SDL -> `cpad-info`, qui est celui
;; de tous les autres boutons du jeu.
(define *cutscene-skip-inject-circle* #f)
;; MEME NATURE, POUR L'AUTRE MOITIE DU GESTE : un MASQUE de boutons pose dans le mot des FRONTS
;; (`button0-rel`), c'est-a-dire « on vient de toucher ces boutons-la » -- la condition qui fait
;; APPARAITRE l'indice. Un masque et non un booleen parce que le harnais a besoin de deux boutons
;; differents : HAUT pour simuler la navigation (inerte a « Press Start », deplace seulement le
;; curseur dans le menu) et START pour faire ouvrir le menu principal PAR LE JEU LUI-MEME
;; (`target-title-wait :trans`, levels/title/title-obs.gc:834-840) -- l'appeler depuis la REPL
;; tue gk en SIGSEGV, mesure du 2026-09-02 04:01. 0 = rien d'injecte.
(define *cutscene-skip-inject-press* 0)
(define *cutscene-skip-aborts* 0)        ;; nombre de boucles de scene qui ont vu le verrou
;; Instant du PREMIER abandon de l'episode courant, releve DANS la boucle de scene (0 = aucun).
;; C'est l'une des deux jambes de la mesure de synchronisme remplissage/saut ; l'autre est
;; `*cutscene-skip-fill-t*`, relevee dans le chemin de DESSIN.
(define *cutscene-skip-abort-t* (the-as time-frame 0))

;; --- Gcutscene-skip-polish : LE COMPTEUR DU SAUT NATIF, POSE SUR LA LIGNE QUI DECIDE ---
;; L'owner (2026-09-01) demande le RETRAIT du saut instantane d'OpenGOAL (TRIANGLE). Le predicat
;; qui le portait etait `arg3`, l'argument que l'appelant passe a `ja-play-spooled-anim` ; il vaut
;; desormais `false-func` sur les 22 sites qui jouent une cinematique.
;; POURQUOI CE COMPTEUR EST HONNETE : il est lu SUR LA MEME LIGNE que le verrou du geste, dans le
;; meme `or`, a la meme image. Si l'instrument etait mort, `*cutscene-skip-aborts*` resterait a 0
;; lui aussi -- or il monte des qu'on saute. Les deux jambes sont dans la meme expression, donc un
;; zero ici n'est PAS un zero de silence.
;; --- Gcutscene-skip-polish-2 : LA BOUCLE DU TITRE N'EST PAS UNE CINEMATIQUE ---
;; Owner 2026-09-01 : « la cartouche apparaît dans le menu principal sans raison, a corriger ».
;;
;; LA CAUSE, ET ELLE EST UNE SEULE LIGNE. L'ecran de titre rejoue le spool `logo-loop` EN BOUCLE
;; (`levels/title/title-obs.gc`, `defstate idle (logo)` : `(loop ... (ja-play-spooled-anim ...))`),
;; pendant tout le temps ou l'ecran « Press Start » puis le MENU sont affiches. Or c'est
;; `ja-play-spooled-anim` qui pose la marque des chemins cables. La course precedente le montre
;; noir sur blanc :
;;     CUTSKIP scene=logo-loop type=film saut=echec cablable=#t abandons=0 images=1958
;; 1958 images d'un « episode de cinematique » : c'est le menu, pas une scene. Et comme l'indice
;; apparait des qu'on touche UN bouton -- ce qu'on fait sans arret dans un menu -- la cartouche
;; s'affichait par-dessus.
;;
;; DEUX SPOOLS SONT EXCLUS, PAS UN, ET LA FRONTIERE EST CELLE DU TITRE AFFICHE. Le process `logo`
;; joue quatre spools (`levels/title/title-obs.gc`) :
;;     ndi-intro      :500/:505   logo Naughty Dog          }  DEMARRAGE : ca defile, ca se termine,
;;     logo-intro     :232        survol d'approche         }  et le titre n'est pas encore la
;;     ------------- :243 « BOOTLINE etape=titre-affiche », :244 send-event 'wait -------------
;;     logo-intro-2   :276        survol DE FOND, titre affiche  }  L'ECRAN DE TITRE
;;     logo-loop      :327        boucle de fond, sans fin       }
;; La coupure est la ligne :244 : c'est la que le titre est a l'ecran et que « Press Start » se met
;; a clignoter. Tout ce qui joue APRES est un fond d'ecran de titre, pas une cinematique -- y
;; compris `logo-intro-2`, qui defile derriere le logo. Aucun etat global ne separe ces deux-la du
;; menu (l'etat de Jak est `target-title-wait` pour les deux ET pour le menu) : c'est le NOM du
;; spool qui porte la distinction, parce que c'est la seule chose qui differe.
;;
;; ET LES DEUX INTRODUCTIONS DU DEMARRAGE RESTENT SAUTABLES : elles se terminent, donc « Skip » y
;; promet quelque chose de reel.
(define *cutscene-skip-loop-mark* #f)   ;; instrument d'ablation, cf. plus bas

(defun cutscene-skip-spool-eligible? ((nm string))
  "Ce spool-la est-il une CINEMATIQUE, c'est-a-dire quelque chose qu'un saut peut abreger ?

   Rend #f pour les deux fonds de l'ecran de titre. `*cutscene-skip-loop-mark*` retablit le
   comportement du cycle precedent SANS rebatir : c'est le bras d'ablation de la mesure `CUTHORS`,
   et il vit sur LE MEME binaire que le bras corrige, sinon la comparaison ne vaudrait rien."
  (or *cutscene-skip-loop-mark*
      (not (and nm (or (string= nm "logo-loop") (string= nm "logo-intro-2"))))))

(define *cutscene-native-true* 0)
(defun cutscene-native-pred? ((v symbol))
  "Compter, puis rendre tel quel, le predicat d'abandon FOURNI PAR L'APPELANT. Ne decide rien."
  (when v (+! *cutscene-native-true* 1))
  v)

(defun cutscene-skip-fired? ()
  "Le geste « maintenir CERCLE deux secondes » a-t-il abouti pour la cinematique en cours ?

   C'est le SEUL predicat que les chemins de lecture de scene consultent. Il ne lit pas le pad :
   il lit un verrou que `cutscene-skip-update` arme, ce qui garantit qu'un chemin ne peut pas
   s'abandonner sur un appui court ou hors cinematique."
  *cutscene-skip-fired*)

(defun cutscene-skip-abort! ((who symbol))
  "A appeler par un chemin de scene juste avant d'abandonner. Compte l'abandon et, si la trace est
   armee, publie QUI a vu le verrou -- c'est la preuve d'execution du cablage, chemin par chemin.

   ELLE HORODATE AUSSI LE SAUT, ET C'EST LA MOITIE DE LA MESURE DE SYNCHRONISME. L'owner demande
   que la cartouche pleine SOIT le saut. Les deux instants sont donc releves par DEUX chemins
   differents : celui-ci, dans la boucle de scene qui abandonne vraiment, et
   `*cutscene-skip-fill-t*`, dans la fonction de DESSIN a l'image ou le remplissage atteint la
   largeur entiere de la cartouche. Publier deux fois la meme variable ne prouverait rien."
  (when (zero? *cutscene-skip-abort-t*) (set! *cutscene-skip-abort-t* (current-time)))
  (+! *cutscene-skip-aborts* 1)
  (if *cutscene-skip-trace*
    (format 0 "CUTABORT chemin=~A n=~D t=~D~%" who *cutscene-skip-aborts* (current-time)))
  #t)

(defun cutscene-skip-mark! ()
  "Marquer, a cette image, qu'un chemin de scene CABLE tourne.

   POURQUOI CETTE MARQUE EXISTE, ET C'EST UNE DECISION DE CONCEPTION. Le bit `movie` de
   `prevent-from-run` est vrai sur des sequences qu'on ne peut PAS abandonner sans changer le jeu
   -- la traversee en barque du pecheur (village1/fishermans-boat.gc:706 et :821) et la sequence
   du pelican (beach/pelican.gc:175) : leur camera est tenue par un evenement de JEU
   (`(while (!= ... 'release) (suspend))`), pas par une horloge d'auteur. Afficher « Skip » la
   promettrait un saut qui n'arriverait jamais. L'indice se cale donc sur cette marque, que
   SEULS les chemins cables posent : la promesse et le cablage sont la MEME grandeur.

   Elle sert AUSSI de detection de cinematique pour les cinq scenes du TITRE, dont l'othercam est
   cree avec `spooling? = 'logo` et n'arme donc pas le bit `movie` (process-taskable.gc:745).

   `ja-play-spooled-anim` ne l'appelle PAS pour le joueur : `target-stance-ambient`
   (engine/target/target2.gc:93) joue une anim STREAMEE d'oisiveté pendant que le joueur a le
   controle total -- ce n'est pas une cinematique et l'indice n'a rien a y faire."
  (set! *cutscene-skip-mark* (current-time))
  (none))

(defmacro cutscene-skip-anim! (who)
  "Si le geste a abouti, pousser l'animation du canal 0 a sa derniere image : la boucle
   `(until (ja-done? 0) ...)` qui l'entoure sort a son tour suivant.

   MEME OPERATEUR QUE LE SAUT DE DEBUG D'ORIGINE (process-taskable.gc:313) : on ne sort pas du
   flot de controle, on avance l'animation. Les `:exit`, les `go-virtual` et les envois de
   notification qui suivent la boucle s'executent donc tous normalement -- c'est ce qui rend ce
   saut sur-mesure pour les etats derives de `pov-camera`, qui n'ont pas d'etat d'abandon."
  `(begin
     (cutscene-skip-mark!)
     (when (cutscene-skip-fired?)
       (cutscene-skip-abort! ,who)
       (ja :num-func num-func-identity :frame-num max))))

(defmacro cutscene-skip-suspend-for (who dur)
  "`suspend-for` qui rend la main des que le geste a abouti. Pas de sortie de flot : la boucle
   se termine, le code qui suit s'execute normalement."
  `(begin
     (let ((cs-t0 (current-time)))
       (until (or (cutscene-skip-fired?) (time-elapsed? cs-t0 ,dur))
         (cutscene-skip-mark!)
         (suspend)))
     (if (cutscene-skip-fired?) (cutscene-skip-abort! ,who))))
