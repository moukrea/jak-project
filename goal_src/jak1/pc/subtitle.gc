;;-*-Lisp-*-
(in-package goal)
(require "engine/entity/ambient.gc")
(require "pc/pckernel.gc")

#|
  Code for subtitles for the PC port. A PC actor pool is provided, and the subtitle process lives there.
  It automatically detects the currently playing cutscene and plays the subtitles for it on channel 0.
  The other two channels are for hints, first checked automatically by name, then by text ID.
  There is a hack in ambient.gc to store the name of the last ambient hint vag played to aid in this.

  Similarly to the generic text file, only one subtitles text file is loaded at once, stored in a specific
  heap.

  In Jak 2, the subtitles are stored directly within the .STR files. We don't have that luxury here, unfortunately.
|#

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; constants
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defconstant PC_SUBTITLE_FILE_SIZE (* 256 1024)) ;; 256K heap for subtitles. adjust later if necessary.

(defconstant PC_SUBTITLE_FILE_NAME "subtit")

(defconstant PC_SUB_DBG_Y 32)

(defconstant PC_SUB_DBG_CHECK_GROUP_SIZE 22)

(defglobalconstant PC_SUBTITLE_DEBUG #f)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; types and enums
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;------------------------
;;  data
;;;------------------------

;; enum for the subtitle channels, no more than 2 bytes!
(defenum pc-subtitle-channel
  :type int16
  (invalid -1)
  (movie 0)
  (hint 1)
  (hint-named 2))

(defconstant SUBTITLE_CHANNEL_COUNT 3)

(defenum pc-subtitle-flags
  :bitfield #t
  :type uint32
  (offscreen) ;; speaker is offscreen.
  )

;; information about a single line of subtitles
(deftype subtitle-keyframe (structure)
  ((frame   int32) ;; the frame to play the subtitle line on
   (string  string) ;; the text for the subtitle line
   (speaker string) ;; name of the speaker. leave blank for no speaker.
   (flags   pc-subtitle-flags) ;; flags
   )
  :pack-me)

;; an individual entry to a subtitle text making up a scene, comprised of a series of keyframes (frame+line of text)
(deftype subtitle-text (structure)
  (;; the channel to play the text on, useful for lookup since it can also be used to tell subtitle types apart
   (kind      pc-subtitle-channel)
   ;; the amount of keyframes/lines
   (length    int16)
   ;; data
   (keyframes (inline-array subtitle-keyframe))
   ;; now we store a way to identify and lookup the subtitles.
   ;; the name of the spool-anim
   (name      string :offset 8)
   ;; the text-id if this is for a hint
   (id        text-id :offset 12)
   ;; the 8-character name for an ambient or hint
   (hash      uint64 :offset 8))
  :size-assert #x10
  ;; compact!
  )

;; the global subtitle text info bank
(deftype subtitle-text-info (basic)
  ((length int32)
   (lang   pc-language)
   (dummy  int32)
   (data   subtitle-text :inline :dynamic))
  (:methods
   (get-scene-by-name (_type_ pc-subtitle-channel string) subtitle-text)
   (get-scene-by-text-id (_type_ pc-subtitle-channel text-id) subtitle-text)))

(defmacro subtitle-flags? (sub &rest flags)
  `(logtest? (-> ,sub flags) (pc-subtitle-flags ,@flags)))

;;;----------------------------------
;;  process type
;;;----------------------------------

;; graphic parameters for subtitles
(deftype subtitle-bank (structure)
  ((scale         float)
   (width         float)
   (height        float)
   (lines         float)
   (notice-height float)
   (hint-height   float)))

(define *SUBTITLE-bank*
  (new 'static 'subtitle-bank :scale 0.5 :width 0.87 :height 0.75 :lines 2.0 :notice-height 0.2 :hint-height 0.8))

;; the subtitle process! it lives on the PC actor pool and awaits for incoming subtitle messages, or a movie
(deftype subtitle (process)
  ((font                font-context) ;; the font to use for the subtitles.
   (bank-backup         subtitle-bank :inline) ;; debug backup.
   (state-time          time-frame) ;; a timestamp, used for notices
   (notice-id           text-id) ;; what notice text to display at the top of the screen
   (spool-name          string)
   (old-spool-name      string)
   (text-id             text-id)
   (cur-channel         pc-subtitle-channel)
   ;; debug things
   (debug-lines?        symbol)
   (checking-lines?     symbol)
   (current-debug-scene int16)
   (current-debug-line  int16)
   (want-subtitle       subtitle-keyframe) ;; the subtitle we want to display
   (hint-subtitle?      symbol))
  (:methods
   (subtitle-format (_type_ subtitle-keyframe) string))
  (:states
   subtitle-debug
   subtitle-debug-checking-lines))

;;;----------------------------------------------
;;  globals
;;;----------------------------------------------

;; the subtitle process.
(define *subtitle* (the (pointer subtitle) #f))

;; subtitle text data
(define *subtitle-text* (the subtitle-text-info #f))

(kheap-alloc (define *subtitle-text-heap* (new 'global 'kheap)) PC_SUBTITLE_FILE_SIZE)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  loading files
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmethod get-scene-by-name ((obj subtitle-text-info) (kind pc-subtitle-channel) (name string))
  "get a subtitle scene info with the corresponding name. #f = none found"
  ;; invalid name so return invalid scene.
  (if (not name) (return (the subtitle-text #f)))
  (dotimes (i (-> obj length))
    ;; name and kind matches, return that!
    (when (and (or (= kind (pc-subtitle-channel invalid)) (= kind (-> obj data i kind))) (string= (-> obj data i name) name))
      (return (-> obj data i))))
  (the subtitle-text #f))

(defmethod get-scene-by-text-id ((obj subtitle-text-info) (kind pc-subtitle-channel) (id text-id))
  "get a subtitle scene info with the corresponding name. #f = none found"
  (dotimes (i (-> obj length))
    ;; name and kind matches, return that!
    (when (and (or (= kind (pc-subtitle-channel invalid)) (= kind (-> obj data i kind))) (= (-> obj data i id) id))
      (return (-> obj data i))))
  (the subtitle-text #f))

(defun load-subtitle-text-info ((txt-name string) (curr-text symbol) (heap kheap))
  "load a subtitles text file onto a heap.
   txt-name = language-agnostic file name
   curr-text = a symbol to a subtitle-text-info to link the file to
   heap = the text heap to load the file onto"
  (let ((heap-sym-heap (the-as subtitle-text-info (-> curr-text value)))
        (lang (-> *pc-settings* subtitle-language))
        (load-status 0)
        (heap-free (&- (-> heap top) (the-as uint (-> heap base)))))
    ;; current text has nothing loaded, or language doesn't match.
    (when (or (= heap-sym-heap #f) (!= (-> heap-sym-heap lang) lang))
      ;; so reload.
      ;; reset the text heap.
      (kheap-reset heap)
      ;; try to load load...
      (while (not (str-load (string-format "~D~S.TXT" lang txt-name)
                            -1
                            (logand -64 (&+ (-> heap current) 63))
                            (&- (-> heap top) (-> heap current))))
        (return 0))
      ;; load succeeded. check status.
      (label retry)
      (let ((status (str-load-status (the-as (pointer int32) (& load-status)))))
        (when (= status 'error)
          (format 0 "Error loading subtitle~%")
          (return 0)
          (goto loaded))
        (cond
          ((>= load-status (+ heap-free -300)) (format 0 "Game subtitle heap overrun!~%") (return 0))
          ((= status 'busy)
           ;; still loading.
           (goto retry))))
      (label loaded)
      ;; link the text file!
      (let ((new-mem (logand -64 (&+ (-> heap current) 63))))
        (flush-cache 0)
        (set! (-> curr-text value) (link new-mem (-> (string-format "~D~S.TXT" lang txt-name) data) load-status heap 0)))
      ;; if linking failed just make the text invalid.
      (if (<= (the-as int (-> curr-text value)) 0) (set! (-> curr-text value) (the-as object #f)))))
  0)

(defun load-level-subtitle-files ((idx int))
  "Load the subtitle files needed for level idx.
   This function made more sense back when text files were split up, but in the end they put everything
   in a single text group and file."
  ;; just load common.
  (if (or *level-text-file-load-flag* (>= idx 0))
    (load-subtitle-text-info PC_SUBTITLE_FILE_NAME '*subtitle-text* *subtitle-text-heap*))
  (none))

(defmacro reload-subtitles ()
  "rebuild and reload subtitles."
  `(begin
    (asm-text-file subtitle :files ("game/assets/game_subtitle.gp"))
    (if *subtitle-text* (+! (-> *subtitle-text* lang) 1))
    (load-level-subtitle-files 0)))

(defmacro reload-text ()
  "rebuild and reload text."
  `(begin
    (mng)
    (if *common-text* (+! (-> *common-text* language-id) 1))
    (load-level-text-files 0)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  subtitle process and drawing!
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  Gsubtitle-style (owner 2026-08-30) : corps de ligne en BLANC PLEIN, et vraie
;;;;  OMBRE PORTEE FLOUE a la place du texte duplique en noir.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; CE QUE LE MOTEUR FAIT AUJOURD'HUI -- lu dans le code, pas suppose.
;;
;; 1. `draw-string` (engine/gfx/font.gc:643) dessine CHAQUE chaine DEUX fois : une passe
;;    « ombre » (font.gc:1043-1243) a `hvdf-off + (2*relative-x-scale, 1)` avec la couleur
;;    PLATE `(-> *font-work* color-shadow)` = noir opaque (font-h.gc:367), puis une passe
;;    « texte » (font.gc:1249-1516) a `hvdf-off` avec les quatre couleurs de sommet de
;;    `color-table[index]`. C'est mot pour mot « le texte duplique legerement decale en
;;    plain black » que l'owner decrit.
;;
;; 2. LE DRAPEAU `(font-flags shadow)` N'EST JAMAIS RELU dans jak1. Le bit 0 est calcule une
;;    seule fois, dans un delay slot, et le registre est ecrase sans avoir servi :
;;      font.gc:1141                (b! (nonzero? t6-16) cfg-125 :delay (logand a0-3 1))
;;      mips2c draw_string.cpp:818  c->andi(t6, a0, 1);   puis :900  c->lq(t6, 48, v1);
;;    (jak2 porte le `beq` qui manque ici : game/mips2c/jak2_functions/font.cpp:1586-1594.)
;;    On ne peut donc PAS eteindre l'ombre dure en retirant le drapeau. Le seul levier est
;;    l'alpha de `color-shadow`, deja ecrit par `set-font-color-alpha` (engine/ui/text.gc:249).
;;
;; 3. La passe ombre CONSOMME ET IGNORE les echappements de couleur `~NL` (font.gc:1075-1076) :
;;    elle est uniformement noire quelle que soit la couleur du texte.
;;
;; PERIMETRE -- « faut pas que ca change le reste des textes ». Tout ce qui suit vit dans CE
;; fichier. `print-game-subtitle` est un clone sous-titres de `print-game-text`
;; (engine/ui/text.gc) et n'a que cinq appelants, tous ici ; le bucket DMA est le 69
;; (`(bucket-id subtitle)`, engine/dma/dma-h.gc:242). Les 215 autres sites de texte du jeu
;; passent par `print-game-text` / `draw-string-xy` et ne voient rien de ce qui suit.
;; AUCUN fichier partage n'est modifie : ni `font.gc`, ni `font-h.gc`, ni `text.gc`.
;;
;; LES DEUX COULEURS. `(-> *font-work* color-table)` porte 64 emplacements pour un enum qui
;; s'arrete a 34 ; le 35 appartient deja a l'ecran de chargement (pc/loading-screen-pc.gc:348).
;; On prend 36 et 37, a l'execution, depuis ce fichier : UN SEUL ECRIVAIN. Livres a zero, ces
;; emplacements dessineraient du texte a alpha 0 -- donc invisible : c'est la preuve que
;; personne ne s'en sert.
;;   36 = BLANC PLEIN pour le corps de la ligne. Il en fallait un NEUF : ni `default` (00,
;;        #x70/#x78/#x70 en haut -> #x30/#x38/#x30 en bas, gris-vert -- c'est ce que le corps
;;        portait), ni `white` (01, #x80 -> #x60, degrade lui aussi) ne sont plats, et `white`
;;        est partage avec le debug, les reglages de camera et les reperes d'acteurs.
;;   37 = NOIR PLAT pour les prises de l'ombre ; son alpha est repose a chaque prise.
;; Le NOM du locuteur ne bouge pas : il reste sur `~3L` (03 = `red`, #x80/#x60/#x20 en haut ->
;; #x60/#x00/#x00 en bas), c'est-a-dire sa couleur ET son leger degrade, comme demande.
(defconstant SUB_FONT_SLOT_WHITE  36)
(defconstant SUB_FONT_SLOT_SHADOW 37)
(defconstant SUB_FONT_WHITE #x80808080) ;; rgba r=g=b=#x80 (pleine echelle GS = FF a l'ecran), a=#x80
(defconstant SUB_FONT_BLACK #x80000000) ;; rgba r=g=b=#x00, a=#x80 (repose par prise)

;; Echappements de couleur inseres dans la chaine LIVREE. La passe d'ombre les recoit VIDES :
;; les caracteres visibles sont alors identiques a ceux du texte, par construction.
(defconstant SUB_ESC_NAME "~3L")
(defconstant SUB_ESC_BODY "~36L")
(defconstant SUB_ESC_NONE "")

;; Alpha GS depose dans `(-> *font-work* color-shadow w)` juste avant `draw-string`, pour les
;; sous-titres UNIQUEMENT. 0 = la duplication noire dure n'ecrit plus rien de visible ; c'est
;; la seule facon de l'eteindre, le drapeau etant mort (point 2). Reste une VARIABLE pour que
;; l'ablation -- le remettre a 128, c'est-a-dire l'ombre d'avant -- soit faisable sans rebuild.
(define *subtitle-dup-shadow-alpha* 0)
;; Ce que la ligne de dessin a REELLEMENT depose, relu APRES l'ecriture. C'est cette valeur
;; que le rapport publie, jamais la constante ci-dessus.
(define *subtitle-dup-shadow-seen* -1)
(define *subtitle-style-traced?* #f)
;; La chaine d'OMBRE ne peut pas partager `*temp-string*` avec le texte : `string-format`
;; ecrit toujours dans ce meme tampon (kernel/gstring.gc:558-563).
(define *subtitle-shadow-string* (new 'global 'string 256 (the string #f)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  Gsubtitle-style-2 (owner 2026-08-31) -- NON VALIDE. Mot pour mot :
;;;;  « on voit encore le texte en dur duppliqué dessous avec une opacité réduite. L'ombre
;;;;   portée est décalée du texte au lieu d'être pile en dessous avec le flou (elle a quand
;;;;   même du flou tel quel, mais elle est vraiment décalé un poil vers le bas et vers la
;;;;   droite comme était l'ombre originale au lieu d'être pile sous le texte. »
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; SES DEUX PHRASES DECRIVENT LE MEME OBJET, ET CE N'EST PAS LA DUPLICATION DU MOTEUR.
;; La passe d'ombre integree de `draw-string` est bien eteinte : `color-shadow` est lu UNE
;; fois (`draw_string.cpp:925`, `lqc2 vf9, 1968(v1)`, seul acces a cet offset du fichier,
;; aucun store) et depose tel quel en RGBAQ des 4 sommets ; le bucket 69 est un
;; `DirectRenderer` (`OpenGLRenderer.cpp:883`) qui melange en (A,B,C,D)=(0,1,0,1) --
;; `(Cs-Cd).As + Cd`, C = SOURCE et non FIX (`DirectRenderer.h:142-147`, aucun `alpha-1` n'est
;; emis sur ce chemin), avec `tcc=1 tfx=MODULATE` donc `color = fragment_color * T0`
;; (`direct_basic_textured.frag:79`) et le test alpha desarme. A = 0 donne `As = 0` a chaque
;; etage : la duplication du moteur ne pose AUCUN pixel. Ce n'est donc pas elle.
;;
;; CE QU'IL VOIT, C'EST NOTRE PROPRE OMBRE, ET POUR DEUX RAISONS QUI SE CUMULENT :
;;
;;  1. LE BARYCENTRE DES PRISES ETAIT A (+1,20 ; +1,60). Le rapport du cycle 1 l'a PUBLIE
;;     (`SUBSHADOW-GEO decalage_x=1.1999 decalage_y=1.6000`) et ne l'a compare a rien. Le
;;     corps du sous-titre fait 8 unites d'ecran virtuel de haut (grande police 16 x scale
;;     0,5, `*SUBTITLE-bank*` :111) : 1,60 vaut 20 % de la hauteur d'un glyphe. Une ombre
;;     dont le barycentre n'est pas nul EST un double decale -- « comme etait l'ombre
;;     originale », mot pour mot.
;;
;;  2. ET CE QUI ETAIT DESSINE N'ETAIT MEME PAS CE DISQUE. `print-game-subtitle` fabrique son
;;     contexte de pile avec `(the int (-> font-ctxt origin x))` : l'origine est TRONQUEE A
;;     L'ENTIER. Or le cycle 1 passait le decalage d'une prise PAR cette origine. Origine du
;;     sous-titre : x = (1 - 0,87) x 256 = 33,28 -> 33 ; y = 0,80 x 224 = 179,2 -> 179. Les
;;     sept prises a 1,2 / 2,3 / 1,75 / 0,65 / 0,1 et 1,6 / 2,55 / 0,65 tombaient donc sur
;;     SEPT POSITIONS ENTIERES de la grille {0,1,2}x{0,1,2}. Pas un flou : un tampon de
;;     3x3 unites (7,5 x 9,6 px a 1080p), decale en bas a droite. « Le texte duplique avec
;;     une opacite reduite » decrit exactement cela.
;;
;; DEUX CORRECTIFS, ET IL FAUT LES DEUX :
;;   - les prises deviennent CENTRE + HEXAGONE DE RAYON 1 autour de zero. Les six prises du
;;     bord se compensent deux a deux, donc le barycentre est nul PAR CONSTRUCTION, quelles
;;     que soient les ponderations : l'ombre n'a plus de direction, elle ne tient que par son
;;     flou -- « pile sous le texte », et il ecrit que le flou, lui, etait bon ;
;;   - le decalage d'une prise ne passe plus par `(-> ctx origin)` mais par
;;     `*subtitle-draw-dx/dy*`, ajoutes EN FLOTTANT apres la construction du contexte, donc
;;     apres la troncature. Le chemin du TEXTE garde dx=dy=0 : il est inchange.
;;
;; ET L'INSTRUMENT CHANGE DE NATURE, parce que c'est lui qui a laisse passer le defaut.
;;   - le barycentre n'est plus calcule sur la TABLE SOURCE mais sur les origines
;;     REELLEMENT DEPOSEES dans le contexte que `draw-string` recoit. Si la troncature
;;     revenait, ou si la table redevenait dissymetrique, le chiffre publie redeviendrait non
;;     nul : la mesure se refute elle-meme ;
;;   - le nombre de passes de texte n'est plus une constante mais un COMPTE DES OCTETS DMA
;;     que `draw-string` vient d'ecrire (`sub-dma-census` ci-dessous).

(defconstant SUB_SHADOW_TAPS 7)

;; Decalage applique au contexte de dessin APRES sa construction -- donc en flottant, apres
;; la troncature a l'entier. Vaut 0 pour la passe de TEXTE : son chemin est inchange.
(define *subtitle-draw-dx* 0.0)
(define *subtitle-draw-dy* 0.0)
;; Biais de CONTROLE POSITIF : deplace toutes les prises d'un coup. Le barycentre publie doit
;; le suivre, sinon la mesure d'offset ne mesure rien. Nul dans l'etat livre.
(define *subtitle-shadow-bias-x* 0.0)
(define *subtitle-shadow-bias-y* 0.0)

;; Journal de CE QUI EST DEPOSE, une entree par passe : 0..SUB_SHADOW_TAPS-1 = les prises,
;; SUB_SHADOW_TAPS = le texte. x,y = origine reellement remise a `draw-string` ; z = alpha
;; relu dans la table de police apres ecriture ; w = 1 des que la passe a dessine.
(define *subtitle-pass-idx* -1)
(define *subtitle-pass-log*
  (new 'static 'inline-array vector 8
       (new 'static 'vector) (new 'static 'vector) (new 'static 'vector) (new 'static 'vector)
       (new 'static 'vector) (new 'static 'vector) (new 'static 'vector) (new 'static 'vector)))

;; Recensement des octets DMA ecrits par `draw-string` (voir `sub-dma-census`).
(define *sub-blocs* 0)
(define *sub-blocs-encres* 0)
(define *sub-alpha-dup* -1)
(define *sub-alpha-texte* -1)
(define *sub-ombre-blocs* 0)
(define *sub-ombre-encres* 0)

(defun sub-qw-same? ((p pointer) (q pointer))
  "Deux quadwords identiques, compares en deux moities de 64 bits."
  (and (= (-> (the-as (pointer uint64) p) 0) (-> (the-as (pointer uint64) q) 0))
       (= (-> (the-as (pointer uint64) p) 1) (-> (the-as (pointer uint64) q) 1))))

(defun sub-bloc-alpha ((p pointer))
  "Alpha REELLEMENT ecrit dans le premier RGBAQ d'un bloc de glyphe : quadword 4, quatrieme
   mot de 32 bits. Les deux sous-passes de `draw-string` posent la meme disposition
   (font.gc:1206 pour l'ombre integree, :1362 pour le texte)."
  (the-as int (-> (the-as (pointer uint32) (&+ p 76)) 0)))

(defun sub-dma-reset! ()
  (set! *sub-blocs* 0)
  (set! *sub-blocs-encres* 0)
  (set! *sub-alpha-dup* -1)
  (set! *sub-alpha-texte* -1)
  (none))

(defun sub-dma-census ((start pointer) (end pointer))
  "Compter les blocs de glyphe DANS LES OCTETS QUE `draw-string` VIENT D'ECRIRE, et y lire
   l'alpha de chacun. Un bloc fait 15 quadwords (font.gc:1243 et :1516) et commence par le
   quadword `char-tmpl dma-vif` du font-work : c'est CE motif qu'on reconnait, donc le compte
   ne depend d'aucune constante de ce fichier.
   `draw-string` emet DEUX sous-passes par glyphe, l'ombre integree d'abord (font.gc:1043-1243)
   puis le texte (:1249-1516) : les blocs [0,n/2) sont la duplication, [n/2,n) le texte."
  (let ((tmpl (the-as pointer (&-> *font-work* char-tmpl quad 0)))
        (p start)
        (n 0)
        (enc 0))
    (while (>= (- (the-as int end) (the-as int p)) 240)
      (cond
        ((sub-qw-same? p tmpl)
         (set! n (+ n 1))
         (if (nonzero? (sub-bloc-alpha p)) (set! enc (+ enc 1)))
         (set! p (&+ p 240)))
        (else (set! p (&+ p 16)))))
    ;; alphas des deux sous-passes, relus DANS LE DMA, sur le premier appel suivant un reset
    (when (and (zero? *sub-blocs*) (> n 1))
      (let ((q start)
            (k 0)
            (half (/ n 2)))
        (while (>= (- (the-as int end) (the-as int q)) 240)
          (cond
            ((sub-qw-same? q tmpl)
             (if (zero? k) (set! *sub-alpha-dup* (sub-bloc-alpha q)))
             (if (= k half) (set! *sub-alpha-texte* (sub-bloc-alpha q)))
             (set! k (+ k 1))
             (set! q (&+ q 240)))
            (else (set! q (&+ q 16)))))))
    (set! *sub-blocs* (+ *sub-blocs* n))
    (set! *sub-blocs-encres* (+ *sub-blocs-encres* enc))
    n))

(defun subtitle-font-colors! ()
  "Poser les deux entrees de police des sous-titres dans les emplacements libres 36 et 37."
  (dotimes (i 4)
    (set! (-> *font-work* color-table SUB_FONT_SLOT_WHITE color i) (the-as rgba SUB_FONT_WHITE))
    (set! (-> *font-work* color-table SUB_FONT_SLOT_SHADOW color i) (the-as rgba SUB_FONT_BLACK)))
  (none))

(defun-recursive print-game-subtitle float ((str string) (font-ctxt font-context) (no-draw symbol) (alpha int) (line-height int))
  "Print text. Not worth commenting until we get stack variables in lets, I think"
  (local-vars
    (sv-112 float)
    (sv-116 float)
    (sv-120 float)
    (sv-124 float)
    (sv-128 float)
    (sv-132 float)
    (sv-136 float)
    (sv-140 (pointer uint8))
    (sv-144 float)
    (sv-148 float)
    (sv-152 float)
    (sv-156 float)
    (sv-160 float)
    (sv-164 float)
    (sv-168 int)
    (sv-176 int)
    (sv-184 int)
    (sv-192 int)
    (sv-200 int)
    (sv-208 symbol)
    (sv-212 symbol))
  (let ((gp-0 (new 'stack
                   'font-context
                   *font-default-matrix*
                   (the int (-> font-ctxt origin x))
                   (the int (-> font-ctxt origin y))
                   0.0
                   (font-color default)
                   (font-flags shadow kerning))))
    (when (< 0.1 (-> font-ctxt scale))
      (set! sv-112 (-> font-ctxt mat vector 0 x))
      (set! sv-116 (-> font-ctxt mat vector 1 y))
      (set! sv-120 (-> *video-parms* relative-x-scale))
      (set! sv-124 (-> *video-parms* relative-y-scale))
      (set! sv-128 (-> *video-parms* relative-x-scale-reciprical))
      (set! sv-132 (-> *video-parms* relative-y-scale-reciprical))
      (set! sv-136 (-> font-ctxt scale))
      (set! (-> gp-0 origin z) (-> font-ctxt origin z))
      (set! (-> gp-0 flags) (-> font-ctxt flags))
      (set! (-> gp-0 color) (-> font-ctxt color))
      (set! (-> gp-0 scale) sv-136)
      ;; Gsubtitle-style-2 : le decalage d'une prise d'ombre est ajoute ICI, en FLOTTANT,
      ;; apres la construction du contexte -- qui tronque l'origine a l'entier (voir plus
      ;; haut). Le passer par `(-> ctx origin)`, comme au cycle 1, faisait tomber les sept
      ;; prises sur une grille entiere. Pour le TEXTE, dx = dy = 0 : chemin inchange.
      (when (not no-draw)
        (+! (-> gp-0 origin x) *subtitle-draw-dx*)
        (+! (-> gp-0 origin y) *subtitle-draw-dy*))
      (when (logtest? (-> gp-0 flags) (font-flags middle-vert))
        (logclear! (-> gp-0 flags) (font-flags middle-vert))
        (let ((f30-0 (-> gp-0 width))
              (f28-0 (-> gp-0 height)))
          (set! (-> gp-0 width) (-> font-ctxt width))
          (set! (-> gp-0 height) (-> font-ctxt height))
          (+! (-> gp-0 origin y) (the float (the int (* 0.5 (- (-> gp-0 height) (print-game-subtitle str gp-0 #t 128 22))))))
          (set! (-> gp-0 width) f30-0)
          (set! (-> gp-0 height) f28-0)))
      (set! (-> gp-0 mat vector 0 x) (* (-> gp-0 mat vector 0 x) sv-136))
      (set! (-> gp-0 mat vector 1 y) (* (-> gp-0 mat vector 1 y) sv-136))
      (set! (-> *video-parms* relative-x-scale) (* (-> *video-parms* relative-x-scale) sv-136))
      (set! (-> *video-parms* relative-y-scale) (* (-> *video-parms* relative-y-scale) sv-136))
      (set! (-> *video-parms* relative-x-scale-reciprical) (/ 1.0 (-> *video-parms* relative-x-scale)))
      (set! (-> *video-parms* relative-y-scale-reciprical) (/ 1.0 sv-136))
      (set! sv-140 (-> str data))
      (set! sv-144 (-> gp-0 origin x))
      (set! sv-148 (-> gp-0 origin x))
      (set! sv-152 (+ (-> gp-0 origin x) (-> font-ctxt width)))
      (set! sv-156 (+ (-> gp-0 origin y) (-> font-ctxt height)))
      (set! sv-160 (* (get-string-length " " gp-0) (-> *video-parms* relative-x-scale)))
      (set! sv-164 (* (if (logtest? (-> gp-0 flags) (font-flags large)) (the float line-height) 14.0) sv-136))
      (set! sv-168 0)
      (if (logtest? (-> gp-0 flags) (font-flags middle)) (+! (-> gp-0 origin x) (* 0.5 (-> font-ctxt width))))
      (set! sv-176 (the-as int (-> sv-140 0)))
      (set! sv-184 0)
      (set! sv-192 0)
      (set! sv-200 0)
      (set! sv-208 (the-as symbol #f))
      (set! sv-212 (the-as symbol #f))
      (set! (-> *game-text-line* data 0) (the-as uint 0))
      (while (or (not (and (zero? sv-176) (zero? sv-184) (zero? sv-192))) (>= sv-156 (-> gp-0 origin y)))
        (cond
          ((= sv-176 32)
           (set! (-> *game-text-word* data sv-184) (the-as uint sv-176))
           (set! sv-184 (+ sv-184 1))
           (set! sv-208 #t))
          ((zero? sv-176) (if (zero? sv-184) (set! sv-212 #t) (set! sv-208 #t)))
          (else
           (if (= sv-176 95) (set! sv-176 32))
           (set! (-> *game-text-word* data sv-184) (the-as uint sv-176))
           (set! sv-184 (+ sv-184 1))))
        (when (= sv-208 #t)
          (set! (-> *game-text-word* data sv-184) (the-as uint 0))
          (let* ((f30-1 sv-144)
                 (f0-49 (* (get-string-length *game-text-word* gp-0) (-> *video-parms* relative-x-scale)))
                 (f1-14 (+ f30-1 f0-49)))
            (if (= (-> *game-text-word* data (+ sv-184 -1)) 32) (set! f1-14 (- f1-14 sv-160)))
            (cond
              ((< sv-152 f1-14) (set! sv-144 (+ sv-148 f0-49)) (set! sv-212 #t))
              (else (set! sv-144 (+ sv-144 f0-49))))))
        (when (= sv-212 #t)
          (when (>= sv-200 (the-as int (-> gp-0 start-line)))
            (let ((f30-2 (+ (-> gp-0 origin y) sv-164)))
              (when (>= sv-156 f30-2)
                (when (= (-> *game-text-line* data (+ sv-192 -1)) 32)
                  (set! (-> *game-text-line* data (+ sv-192 -1)) (the-as uint 0))
                  (when (and (= (-> *game-text-line* data (+ sv-192 -5)) 126) (= (-> *game-text-line* data (+ sv-192 -2)) 72))
                    (set! (-> *game-text-line* data (+ sv-192 -5)) (the-as uint 0))
                    0)))
              (when (and (= (-> *game-text-line* data (+ sv-192 -4)) 126) (= (-> *game-text-line* data (+ sv-192 -1)) 72))
                (set! (-> *game-text-line* data (+ sv-192 -4)) (the-as uint 0))
                0)
              (if (nonzero? (-> *game-text-line* data 0)) (set! sv-168 (+ sv-168 1)))
              (when (not no-draw)
                (let* ((s1-1 (-> *display* frames (-> *display* on-screen) frame global-buf))
                       (s2-1 (-> s1-1 base)))
                  (set-font-color-alpha (-> font-ctxt color) alpha)
                  ;; Gsubtitle-style : la passe « ombre » de draw-string est INCONDITIONNELLE
                  ;; (le bit `shadow` n'est jamais relu, font.gc:1141). Son seul levier est
                  ;; l'alpha de `color-shadow`, que `set-font-color-alpha` vient justement de
                  ;; poser a `alpha` : on l'ecrase ICI, apres, puis on RELIT ce qui a ete
                  ;; depose -- c'est cette relecture que le rapport publie.
                  (set! (-> *font-work* color-shadow w) *subtitle-dup-shadow-alpha*)
                  (set! *subtitle-dup-shadow-seen* (-> *font-work* color-shadow w))
                  ;; Journal de la passe : l'origine REELLEMENT remise a `draw-string` et
                  ;; l'alpha REELLEMENT depose dans la table, une seule fois par passe (une
                  ;; passe dessine une ligne par tour de boucle, on retient la premiere).
                  (let ((pi *subtitle-pass-idx*))
                    (when (and (>= pi 0) (= 0.0 (-> *subtitle-pass-log* pi w)))
                      (let ((lg (-> *subtitle-pass-log* pi)))
                        (set! (-> lg x) (-> gp-0 origin x))
                        (set! (-> lg y) (-> gp-0 origin y))
                        (set! (-> lg z)
                              (the float (the-as int (-> *font-work* color-table (-> font-ctxt color) color 0 a))))
                        (set! (-> lg w) 1.0))))
                  (draw-string *game-text-line* s1-1 gp-0)
                  ;; Recensement des octets que `draw-string` vient d'ecrire. Borne a la
                  ;; premiere ligne tracee : cout nul une fois la mesure prise.
                  (if (not *subtitle-style-traced?*) (sub-dma-census s2-1 (-> s1-1 base)))
                  ;; remet `color-shadow w` a 128 : rien ne fuit hors du chemin sous-titres.
                  (set-font-color-alpha (-> font-ctxt color) 128)
                  (set! (-> gp-0 color) (-> *font-work* last-color))
                  (let ((a3-3 (-> s1-1 base)))
                    (let ((v1-127 (the-as object (-> s1-1 base))))
                      (set! (-> (the-as dma-packet v1-127) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
                      (set! (-> (the-as dma-packet v1-127) vif0) (new 'static 'vif-tag))
                      (set! (-> (the-as dma-packet v1-127) vif1) (new 'static 'vif-tag))
                      (set! (-> s1-1 base) (&+ (the-as pointer v1-127) 16)))
                    (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                                           (bucket-id subtitle)
                                           s2-1
                                           (the-as (pointer dma-tag) a3-3)))))
              (set! (-> gp-0 origin y) f30-2)))
          (set! sv-200 (+ sv-200 1))
          (set! (-> *game-text-line* data 0) (the-as uint 0))
          (set! sv-192 0)
          (set! sv-212 (the-as symbol #f)))
        (when (= sv-208 #t)
          (copy-charp<-charp (&-> *game-text-line* data sv-192) (-> *game-text-word* data))
          (set! sv-192 (+ sv-192 sv-184))
          (set! sv-184 0)
          (set! sv-208 (the-as symbol #f)))
        (when (nonzero? sv-176)
          (set! sv-140 (&-> sv-140 1))
          (set! sv-176 (the-as int (-> sv-140 0)))))
      (set! (-> gp-0 mat vector 0 x) sv-112)
      (set! (-> gp-0 mat vector 1 y) sv-116)
      (set! (-> *video-parms* relative-x-scale) sv-120)
      (set! (-> *video-parms* relative-y-scale) sv-124)
      (set! (-> *video-parms* relative-x-scale-reciprical) sv-128)
      (set! (-> *video-parms* relative-y-scale-reciprical) sv-132)
      (if (> sv-168 0) (* sv-164 (the float sv-168)) 0.0))))


;; Les prises de l'ombre douce, en unites d'ECRAN VIRTUEL (512x224), +y vers le BAS.
;; CENTRE + HEXAGONE DE RAYON 1, autour de ZERO. Les six prises du bord se compensent DEUX A
;; DEUX (+1/-1, +0,5/-0,5, +0,866/-0,866) : le barycentre vaut zero EXACTEMENT, quelles que
;; soient les ponderations. L'ombre n'a donc plus de direction -- elle ne tient que par son
;; flou, et c'est ce que l'owner demande (« pile sous le texte », le flou lui convenant).
;; Le rayon 1 vaut 12,5 % de la hauteur d'un glyphe (8 unites) : le meme etalement que ce qui
;; etait REELLEMENT dessine au cycle 1 (grille entiere de rayon 1 autour de (+1;+1)), mais
;; centre et sans quantification. Ponderations et compte de prises inchanges : l'opacite
;; cumulee reste 1 - (1-34/128)(1-22/128)^6 = 0,763, et le cout DMA est celui d'aujourd'hui.
;;   x, y = decalage de la prise ; z = alpha GS de la prise (128 = opaque)
(define *subtitle-shadow-taps*
  (new 'static 'inline-array vector 7
       (new 'static 'vector :x  0.0 :y  0.0   :z 34.0)
       (new 'static 'vector :x  1.0 :y  0.0   :z 22.0)
       (new 'static 'vector :x -1.0 :y  0.0   :z 22.0)
       (new 'static 'vector :x  0.5 :y  0.866 :z 22.0)
       (new 'static 'vector :x -0.5 :y -0.866 :z 22.0)
       (new 'static 'vector :x -0.5 :y  0.866 :z 22.0)
       (new 'static 'vector :x  0.5 :y -0.866 :z 22.0)))

(defun sub-rgb24 ((slot int) (corner int))
  "RGB 24 bits d'un coin de la table de police. Les octets y sont en echelle GS
   (#x80 = modulation 1,0 = FF a l'ecran), d'ou le 255/128."
  (let* ((c (the-as int (-> *font-work* color-table slot color corner)))
         (r (logand c 255))
         (g (logand (ash c -8) 255))
         (b (logand (ash c -16) 255)))
    (logior (ash (/ (* 255 r) 128) 16) (logior (ash (/ (* 255 g) 128) 8) (/ (* 255 b) 128)))))

(defun sub-degrade ((slot int))
  "1 si les quatre couleurs de sommet different (degrade), 0 si l'entree est PLATE."
  (let ((c0 (the-as int (-> *font-work* color-table slot color 0)))
        (c1 (the-as int (-> *font-work* color-table slot color 1)))
        (c2 (the-as int (-> *font-work* color-table slot color 2)))
        (c3 (the-as int (-> *font-work* color-table slot color 3))))
    (if (and (= c0 c1) (= c1 c2) (= c2 c3)) 0 1)))

(defun subtitle-table-sig ()
  "Somme de controle des emplacements 0 a 35 de la table de police -- c'est-a-dire TOUT ce que
   le reste du jeu peut lire. Les sous-titres n'ecrivent que 36 et 37 ; si cette signature
   bouge, c'est qu'un autre texte a ete touche, et le rapport doit le dire.
   Somme bornee a 31 bits (#x3fffffff) et JAMAIS a 32 : sur 32 bits, 0x89078cac est relue
   avec son signe etendu depuis le symbole et la comparaison rendait un FAUX ROUGE
   (`sig_avant=ffffffff89078cac` contre `sig_apres=89078cac`, memes 32 bits utiles).
   L'octet d'ALPHA est masque a dessein : `set-font-color-alpha` (engine/ui/text.gc:245-248)
   ecrit l'alpha d'un emplacement quelconque a chaque dessin de texte du jeu, et le remet a
   128 -- c'est du bruit qui n'appartient pas a cette phase. Le canal RGB, lui, n'est ecrit
   que par les credits (slot 32, engine/ui/credits.gc:13-19) et par ce fichier (36 et 37)."
  (let ((h 0))
    (dotimes (i 36)
      ;; L'emplacement 32 est celui des CREDITS, que `set-credits-font-color`
      ;; (engine/ui/credits.gc:8-19) reecrit a chaque image de l'ecran-titre. L'inclure
      ;; mesurerait le jeu, pas notre changement : il est publie a part, en temoin.
      (when (!= i 32)
        (dotimes (j 4)
          (set! h (logand (+ (* h 33) (logand (the-as int (-> *font-work* color-table i color j)) #xffffff))
                          #x3fffffff)))))
    h))

;; Prise AVANT toute ecriture : ce fichier ne touche la table que depuis `subtitle-font-colors!`,
;; appelee par `setup-subtitle-font`, donc apres l'apparition du process -- bien apres cette ligne.
(define *subtitle-table-sig0* (subtitle-table-sig))


(defun subtitle-style-trace ()
  "Publier CE QUI EST DEPOSE dans le chemin de dessin : les couleurs RELUES dans la table de
   police, l'emplacement que `draw-string` a REELLEMENT selectionne (`last-color`, mis a jour
   par les echappements `~NL`, font.gc:865 et :1309-1340), et l'alpha d'ombre dure relu apres
   ecriture. Aucune constante de ce fichier n'est republiee telle quelle.
   Gsubtitle-style-2 : la GEOMETRIE de l'ombre n'est plus lue dans la table source mais dans
   `*subtitle-pass-log*` -- les origines REELLEMENT remises a `draw-string`, prise par prise,
   moins celle de la passe de texte. La troncature a l'entier du contexte (cf. en-tete) est
   donc DANS la mesure : si elle revenait, le barycentre publie redeviendrait non nul.
   Le barycentre de la TABLE est publie a cote, en temoin : les deux doivent coincider."
  (let ((slot-corps (the-as int (-> *font-work* last-color)))
        (tx (-> *subtitle-pass-log* SUB_SHADOW_TAPS x))
        (ty (-> *subtitle-pass-log* SUB_SHADOW_TAPS y))
        (cx 0.0)
        (cy 0.0)
        (wsum 0.0)
        (transp 1.0)
        (r2 0.0)
        (rmax 0.0)
        (posees 0)
        (sx 0.0)
        (sy 0.0)
        (swsum 0.0))
    ;; temoin : barycentre de la TABLE SOURCE (c'est ce que le cycle 1 publiait)
    (dotimes (i SUB_SHADOW_TAPS)
      (let* ((tp (-> *subtitle-shadow-taps* i))
             (w (-> tp z)))
        (+! sx (* w (-> tp x)))
        (+! sy (* w (-> tp y)))
        (+! swsum w)))
    (when (> swsum 0.0) (set! sx (/ sx swsum)) (set! sy (/ sy swsum)))
    ;; VERDICT : barycentre des origines REELLEMENT DEPOSEES, pondere par l'alpha relu
    (dotimes (i SUB_SHADOW_TAPS)
      (let* ((lg (-> *subtitle-pass-log* i))
             (w (-> lg z)))
        (when (> (-> lg w) 0.0)
          (set! posees (+ posees 1))
          (+! cx (* w (- (-> lg x) tx)))
          (+! cy (* w (- (-> lg y) ty)))
          (+! wsum w)
          (set! transp (* transp (- 1.0 (/ w 128.0)))))))
    (when (> wsum 0.0) (set! cx (/ cx wsum)) (set! cy (/ cy wsum)))
    (dotimes (i SUB_SHADOW_TAPS)
      (let ((lg (-> *subtitle-pass-log* i)))
        (when (> (-> lg w) 0.0)
          (let* ((dx (- (- (-> lg x) tx) cx))
                 (dy (- (- (-> lg y) ty) cy))
                 (d2 (+ (* dx dx) (* dy dy))))
            (+! r2 (* (-> lg z) d2))
            (if (> d2 (* rmax rmax)) (set! rmax (sqrtf d2)))))))
    (if (> wsum 0.0) (set! r2 (sqrtf (/ r2 wsum))))
    (format 0
            "SUBCOLOR nom_slot=3 nom_rgb=~X nom_degrade=~D ligne_slot=~D ligne_rgb=~X ligne_degrade=~D~%"
            (sub-rgb24 3 0)
            (sub-degrade 3)
            slot-corps
            (sub-rgb24 slot-corps 0)
            (sub-degrade slot-corps))
    (format 0
            "SUBCOLOR-BRUT nom=~X,~X,~X,~X~%"
            (-> *font-work* color-table 3 color 0)
            (-> *font-work* color-table 3 color 1)
            (-> *font-work* color-table 3 color 2)
            (-> *font-work* color-table 3 color 3))
    (format 0
            "SUBCOLOR-BRUT ligne_slot=~D ligne=~X,~X,~X,~X~%"
            slot-corps
            (-> *font-work* color-table slot-corps color 0)
            (-> *font-work* color-table slot-corps color 1)
            (-> *font-work* color-table slot-corps color 2)
            (-> *font-work* color-table slot-corps color 3))
    (format 0
            "SUBCOLOR-TEMOIN defaut00=~X,~X white01=~X,~X~%"
            (-> *font-work* color-table 0 color 0)
            (-> *font-work* color-table 0 color 2)
            (-> *font-work* color-table 1 color 0)
            (-> *font-work* color-table 1 color 2))
    ;; SUBDUP : combien de fois la CHAINE est-elle rasterisee en encre visible, par passe ?
    ;; Compte pris dans les octets DMA de la passe de TEXTE (`sub-dma-census`). `draw-string`
    ;; emet toujours DEUX sous-passes par glyphe : la duplication d'abord, le texte ensuite.
    ;; `blocs` vaut donc 2 x glyphes ; `blocs_encres` compte ceux dont l'alpha DEPOSE est non
    ;; nul. Un rapport de 1 veut dire : le texte est dessine, sa copie ne l'est pas.
    (let* ((glyphes (/ *sub-blocs* 2))
           (pdt (if (> glyphes 0) (/ *sub-blocs-encres* glyphes) 9))
           (reste (if (> glyphes 0) (- *sub-blocs-encres* (* pdt glyphes)) -1))
           (pombre (if (> glyphes 0) (/ *sub-ombre-encres* glyphes) -1)))
      ;; une seule LIGNE, en deux ecritures : `format` n'accepte pas plus de 8 parametres.
      (format 0 "SUBDUP passes_de_texte=~D reste=~D glyphes=~D " pdt reste glyphes)
      (format 0
              "blocs=~D blocs_encres=~D alpha_dup_dma=~D alpha_texte_dma=~D passes_ombre=~D~%"
              *sub-blocs*
              *sub-blocs-encres*
              *sub-alpha-dup*
              *sub-alpha-texte*
              pombre)
      (format 0
              "SUBDUP-OMBRE blocs=~D blocs_encres=~D prises_posees=~D~%"
              *sub-ombre-blocs*
              *sub-ombre-encres*
              posees))
    (format 0
            "SUBSHADOW type=~S prises=~D dup_alpha=~D "
            (if (and (> SUB_SHADOW_TAPS 1) (zero? *subtitle-dup-shadow-seen*)) "ombre-floue" "duplique")
            SUB_SHADOW_TAPS
            *subtitle-dup-shadow-seen*)
    (format 0 "rayon_flou=~f opacite=~f offset_x=~f offset_y=~f~%" r2 (- 1.0 transp) cx cy)
    (format 0
            "SUBSHADOW-GEO rayon_max=~f prises_posees=~D texte_ox=~f texte_oy=~f table_x=~f table_y=~f~%"
            rmax
            posees
            tx
            ty
            sx
            sy)
    (dotimes (i SUB_SHADOW_TAPS)
      (let ((lg (-> *subtitle-pass-log* i)))
        (format 0
                "SUBSHADOW-PRISE i=~D dessinee=~D dx=~f dy=~f alpha=~f~%"
                i
                (the int (-> lg w))
                (- (-> lg x) tx)
                (- (-> lg y) ty)
                (-> lg z)))))
  ;; Perimetre vu de l'EXECUTION : les emplacements 0 a 35 de la table -- tout ce que les 215
  ;; autres sites de texte peuvent lire -- doivent rendre la MEME signature RGB qu'avant que ce
  ;; fichier n'ait rien ecrit ; et `color-shadow`, qui est global, doit etre revenu a sa valeur
  ;; de repos (#x80 = 128) apres le dessin. Ligne nommee `SUBSCOPE-TABLE` et pas `SUBSCOPE` :
  ;; le verdict de perimetre du rapport est la CENSUS des objets compiles, pas cette mesure-ci,
  ;; qui peut legitimement bouger sur l'emplacement 32 (les credits l'animent a chaque image,
  ;; engine/ui/credits.gc:13-19) sans que rien de ce fichier y soit pour quoi que ce soit.
  (let ((sig (subtitle-table-sig))
        (csw (-> *font-work* color-shadow w)))
    (format 0
            "SUBSCOPE-TABLE sig_rgb_0_35_hors32_intacte=~D sig_avant=~X sig_apres=~X color_shadow_w_repos=~D~%"
            (if (and (= sig *subtitle-table-sig0*) (= csw 128)) 1 0)
            *subtitle-table-sig0*
            sig
            csw)
    (format 0 "SUBSCOPE-TABLE temoin_slot32_credits=~X~%" (-> *font-work* color-table 32 color 0)))
  (none))

(defun subtitle-print-soft ((str-main string) (str-shadow string) (ctx font-context))
  "Dessiner une ligne de sous-titre : d'abord l'OMBRE (SUB_SHADOW_TAPS dessins noirs a alpha
   faible, CENTRES sur le texte, dont le recouvrement fait le flou), puis le TEXTE par-dessus.
   `str-shadow` porte exactement les memes caracteres VISIBLES que `str-main` : les deux
   sortent du MEME formateur, seuls les echappements de couleur changent, et un echappement ne
   compte pas dans la largeur (font.gc:1603, `~L` saute la mesure). L'ombre ne peut donc pas se
   desaligner du texte -- c'est structurel, pas verifie apres coup.
   Gsubtitle-style-2 : le decalage d'une prise passe par `*subtitle-draw-dx/dy*`, ajoutes en
   FLOTTANT dans `print-game-subtitle` apres la construction du contexte. Il ne passe plus par
   `(-> ctx origin)`, que cette construction TRONQUE A L'ENTIER -- c'est cette troncature qui
   ecrasait les sept prises sur une grille entiere et fabriquait le double net que l'owner
   voit. L'origine du contexte de l'appelant n'est plus touchee du tout."
  (let ((oc (-> ctx color))
        (res 0.0))
    ;; ---- OMBRE ----------------------------------------------------------------------
    (set! (-> ctx color) (the-as font-color SUB_FONT_SLOT_SHADOW))
    (sub-dma-reset!)
    (dotimes (i SUB_SHADOW_TAPS)
      (let ((tp (-> *subtitle-shadow-taps* i)))
        (set! (-> *subtitle-pass-log* i w) 0.0)
        (set! *subtitle-draw-dx* (+ (-> tp x) *subtitle-shadow-bias-x*))
        (set! *subtitle-draw-dy* (+ (-> tp y) *subtitle-shadow-bias-y*))
        (set! *subtitle-pass-idx* i)
        (print-game-subtitle str-shadow ctx #f (the int (-> tp z)) 22)))
    (set! *sub-ombre-blocs* *sub-blocs*)
    (set! *sub-ombre-encres* *sub-blocs-encres*)
    ;; ---- TEXTE ----------------------------------------------------------------------
    (set! *subtitle-draw-dx* 0.0)
    (set! *subtitle-draw-dy* 0.0)
    (set! (-> ctx color) oc)
    (set! (-> *subtitle-pass-log* SUB_SHADOW_TAPS w) 0.0)
    (set! *subtitle-pass-idx* SUB_SHADOW_TAPS)
    (sub-dma-reset!)
    (set! res (print-game-subtitle str-main ctx #f 128 22))
    (set! *subtitle-pass-idx* -1)
    (when (not *subtitle-style-traced?*)
      (set! *subtitle-style-traced?* #t)
      (subtitle-style-trace))
    res))

(defun subtitle-format-into ((dst string) (keyframe subtitle-keyframe) (esc-name string) (esc-body string))
  "Formater une ligne de sous-titre dans `dst`. Les DEUX echappements de couleur sont des
   PARAMETRES : la passe d'ombre les recoit vides, ce qui rend une chaine aux caracteres
   VISIBLES identiques. Un seul chemin de formatage, donc aucune derive possible entre le
   texte et son ombre."
  (cond
    ((= 0 (length (-> keyframe speaker)))
     ;; there's no speaker so who cares.
     (format (clear dst) "~S" (-> keyframe string)))
    ((or (= #t (-> *pc-settings* subtitle-speaker?))
         (and (= 'auto (-> *pc-settings* subtitle-speaker?)) (subtitle-flags? keyframe offscreen)))
     ;; there is a speaker and we do want it.
     (format (clear dst) "~S~S:~S ~S" esc-name (-> keyframe speaker) esc-body (-> keyframe string)))
    (else (format (clear dst) "~S" (-> keyframe string))))
  dst)

(defmethod subtitle-format ((obj subtitle) (keyframe subtitle-keyframe))
  "check settings and format subtitle accordingly."
  ;; Gsubtitle-style : le corps de la ligne part sur l'emplacement BLANC PLEIN ; le nom du
  ;; locuteur garde `~3L`, donc sa couleur et son leger degrade.
  (subtitle-format-into *temp-string* keyframe SUB_ESC_NAME SUB_ESC_BODY))

(defun subtitle? ((hinttitles? symbol))
  "can a subtitle be displayed right now?"
  (and (or (and (not hinttitles?) (-> *pc-settings* subtitles?)) ;; subtitles enabled
           (and hinttitles? (-> *pc-settings* hinttitles?)))
       (or *debug-segment* (= *master-mode* 'game)) ;; current mode is game, OR we are just debugging
       (not *progress-process*) ;; no progress open
       ))

(defun subtitle-str-adjust ((pos int))
  (if (< pos 0) -1 (the int (/ pos (/ 1024.0 60)))))

(defbehavior setup-subtitle-font subtitle ()
  "setup the subtitle font."
  ;; Gsubtitle-style : les emplacements 36 (blanc plein) et 37 (noir de l'ombre) sont reposes
  ;; ici, avant tout dessin. `set-font-color-alpha` remet l'alpha a 128 apres chaque ligne,
  ;; ce qui est deja leur valeur au repos -- l'ecriture est donc idempotente.
  (subtitle-font-colors!)
  ;; set font settings.
  (set! (-> self font origin x) (* (- 1.0 (-> *SUBTITLE-bank* width)) 256))
  ;; Gcutscene-reframe (owner 2026-08-28): the subtitle used to be RAISED (bank `height`,
  ;; 0.75 * 224 = 168.0) during a cutscene below 16:9, purely to clear the bottom black bar.
  ;; Native mode no longer draws any bar at any aspect ratio (see `letterbox` in
  ;; engine/game/main.gc), so the subtitle goes back to its usual place -- bank `hint-height`,
  ;; 0.80 * 224 = 179.2, the same y it has outside cutscenes. "idem pour les sous-titres".
  ;; The raise survives ONLY under use-vis?, the opt-in PS2 renderer that still draws the bars;
  ;; there `aspect-ratio` is the game setting itself (ASPECT_4X3 or ASPECT_16X9, see
  ;; update-from-os), so this is bit-identical to the old condition in that mode.
  (set! (-> self font origin y)
        (* (if (and (-> *pc-settings* use-vis?)
                    (movie?)
                    (< (-> *pc-settings* aspect-ratio) ASPECT_16X9))
             (-> *SUBTITLE-bank* height)
             (-> *SUBTITLE-bank* hint-height))
           224))
  (set-width! (-> self font) (the int (* (-> *SUBTITLE-bank* width) 512)))
  (set-height! (-> self font) (the int (* (-> *SUBTITLE-bank* lines) 11)))
  (set-scale! (-> self font) (-> *SUBTITLE-bank* scale)))

(defbehavior draw-subtitle subtitle ()
  "draw the current subtitle using the current font."
  (when (and (-> self want-subtitle) (subtitle? (-> self hint-subtitle?)))
    ;; we got a valid subtitle! render it.
    (hide-bottom-hud)
    ;; Gsubtitle-style : la chaine d'OMBRE est formatee EN PREMIER, dans son propre tampon --
    ;; `subtitle-format` ecrit dans `*temp-string*`, qui serait sinon ecrase.
    (subtitle-format-into *subtitle-shadow-string* (-> self want-subtitle) SUB_ESC_NONE SUB_ESC_NONE)
    (subtitle-print-soft (subtitle-format self (-> self want-subtitle))
                         *subtitle-shadow-string*
                         (-> self font))
    (#when PC_SUBTITLE_DEBUG
      (draw-debug-text-box (-> self font)))))

(defstate subtitle-process (subtitle)
  :event
    (behavior ((from process) (argc int) (msg symbol) (block event-message-block))
      (case msg
        (('subtitle-start) 0)
        (('debug) (go subtitle-debug))))
  :code
    (behavior ()
      (loop
        (suspend)))
  :trans
    (behavior ()
      (load-level-subtitle-files 0)
      ;; reset params
      (set! (-> self want-subtitle) (the subtitle-keyframe #f))
      (set! (-> self hint-subtitle?) #f)
      (set! (-> self spool-name) #f)
      (set! (-> self cur-channel) (pc-subtitle-channel invalid))
      ;; check what kind of subtitles are running
      (cond
        ((and (movie?) (-> *art-control* spool-lock) (-> *art-control* active-stream))
         ;; there's a cutscene happening and an active spool with a valid owner.
         (set! (-> self spool-name) (-> *art-control* active-stream))
         (set! (-> self cur-channel) (pc-subtitle-channel movie))
         (with-proc ((handle->process (-> *art-control* spool-lock)))
                    (if *debug-segment*
                      (format *stdcon*
                              "movie spool detected:~%~3L~A~0L~%current spool frame is ~3L~D~0L~%"
                              (-> *art-control* active-stream)
                              (the int (ja-aframe-num 0))))))
        (*hint-semaphore*
         ;; there's a hint playing
         (set! (-> self spool-name) (-> *hint-semaphore* 0 sound-to-play))
         (unless (-> self spool-name)
           (set! (-> self spool-name) *level-hint-spool-name*))
         (set! (-> self text-id) (-> *hint-semaphore* 0 text-id-to-display))
         (set! (-> self cur-channel) (if (-> self spool-name) (pc-subtitle-channel hint-named) (pc-subtitle-channel hint)))
         (if *debug-segment*
           (format *stdcon*
                   "hint detected!~%~3L~A~0L/~3L#x~X~0L~%current str pos is ~D (~3L~D~0L)~%"
                   (-> self spool-name)
                   (-> self text-id)
                   (current-str-pos (-> *hint-semaphore* 0 sound-id))
                   (subtitle-str-adjust (current-str-pos (-> *hint-semaphore* 0 sound-id)))))))
      ;; do subtitles
      ;; intro first time notice (if subtitles are disabled)
      (when (and (= (pc-subtitle-channel movie) (-> self cur-channel))
                 (!= (-> self old-spool-name) (-> self spool-name))
                 (string= (-> self spool-name) "sage-intro-sequence-a"))
        (set-state-time)
        (set! (-> self notice-id) (text-id subtitle-hint)))
      ;; get a subtitle info that matches our current status
      (let ((keyframe (the subtitle-keyframe #f)))
        (when *subtitle-text*
          (case (-> self cur-channel)
            (((pc-subtitle-channel movie))
             ;; cutscenes. get our cutscene.
             (set! (-> self hint-subtitle?) #f)
             (awhen (get-scene-by-name *subtitle-text* (-> self cur-channel) (-> self spool-name))
                    ;; during a cutscene, check if user toggled subtitles
                    (when (and (= 'game *master-mode*) (cpad-pressed? 0 square))
                      (not! (-> *pc-settings* subtitles?))
                      (set-state-time)
                      (if (-> *pc-settings* subtitles?)
                        (set! (-> self notice-id) (text-id subtitle-enabled))
                        (set! (-> self notice-id) (text-id subtitle-disabled))))
                    ;; find out position in the scene.
                    (let ((pos 0))
                      ;; get frame num
                      (with-proc ((handle->process (-> *art-control* spool-lock))) (set! pos (the int (ja-aframe-num 0))))
                      ;; find closest keyframe
                      (dotimes (i (-> it length))
                        (when (>= pos (-> it keyframes i frame))
                          (set! keyframe (-> it keyframes i)))))))
            (((pc-subtitle-channel hint) (pc-subtitle-channel hint-named))
             ;; hint! find it. or else.
             (set! (-> self hint-subtitle?) #t)
             (let ((scene (get-scene-by-text-id *subtitle-text* (pc-subtitle-channel hint) (-> self text-id))))
               (if (not scene) (set! scene (get-scene-by-name *subtitle-text* (pc-subtitle-channel hint-named) (-> self spool-name))))
               (when scene
                 (let ((pos (subtitle-str-adjust (current-str-pos (-> *hint-semaphore* 0 sound-id)))))
                   ;; find closest keyframe
                   (dotimes (i (-> scene length))
                     (when (>= pos (-> scene keyframes i frame))
                       (set! keyframe (-> scene keyframes i))))))))))
        ;; save whatever subtitle we got.
        (set! (-> self want-subtitle) keyframe))
      ;; keep this for later
      (set! (-> self old-spool-name) (-> self spool-name))
      (when *debug-segment*
        (when (and (cpad-hold? 0 l3) (cpad-pressed? 0 start))
          (cpad-clear! 0 start)
          (send-event self 'debug)))
      (none))
  :post
    (behavior ()
      (setup-subtitle-font)
      (draw-subtitle)
      (cond
        ((!= *master-mode* 'game))
        ((and (< (time-passed) (seconds 5)) (= (-> self notice-id) (text-id subtitle-hint)))
         (when (not (-> *pc-settings* subtitles?))
           (set-scale! (-> self font) (* (-> *SUBTITLE-bank* scale) 1.5))
           ;; Gsubtitle-style : meme traitement que la ligne de sous-titre. Cette chaine ne
           ;; porte aucun echappement de couleur, texte et ombre sont donc la MEME chaine.
           (let ((s (lookup-text! *common-text* (-> self notice-id) #f)))
             (subtitle-print-soft s s (-> self font)))))
        ((and (= (-> self cur-channel) (pc-subtitle-channel movie))
              (< (time-passed) (seconds 2))
              (< (mod (time-passed) (seconds 1)) (seconds 0.8)))
         (set! (-> self font origin y) (* (-> *SUBTITLE-bank* notice-height) 224))
         (let ((s (lookup-text! *common-text* (-> self notice-id) #f)))
           (subtitle-print-soft s s (-> self font)))))
      0))

(defstate subtitle-debug (subtitle)
  :event
    (behavior ((from process) (argc int) (msg symbol) (block event-message-block))
      (case msg
        (('debug) (go subtitle-process))))
  :enter
    (behavior ()
      (mem-copy! (the pointer (-> self bank-backup)) (the pointer *SUBTITLE-bank*) (size-of subtitle-bank))
      (set-master-mode 'pause))
  :trans
    (behavior ()
      (with-dma-buffer-add-bucket ((buf (-> (current-frame) debug-buf)) (bucket-id debug))
        (draw-string-xy "~3LSUBTITLE DEBUG!~0L"
                        buf
                        14
                        (+ PC_SUB_DBG_Y (* 0 8))
                        (font-color default)
                        (font-flags shadow kerning))
        (draw-string-xy "L3+Start: exit" buf 14 (+ PC_SUB_DBG_Y (* 1 8)) (font-color default) (font-flags shadow kerning))
        (if (!= 'pause *master-mode*)
          (draw-string-xy "Pause the game to continue"
                          buf
                          14
                          (+ PC_SUB_DBG_Y (* 2 8))
                          (font-color default)
                          (font-flags shadow kerning)))
        (when (= 'pause *master-mode*)
          (cond
            ((and (cpad-hold? 0 l3) (cpad-pressed? 0 x)) (set! (-> self debug-lines?) #t))
            ((and (cpad-hold? 0 l3) (cpad-pressed? 0 triangle)) (set! (-> self debug-lines?) #f)))
          (draw-string-xy "L3+X: debug lines" buf 14 (+ PC_SUB_DBG_Y (* 2 8)) (font-color default) (font-flags shadow kerning))
          (draw-string-xy "L3+Triangle: debug box"
                          buf
                          14
                          (+ PC_SUB_DBG_Y (* 3 8))
                          (font-color default)
                          (font-flags shadow kerning))
          (cond
            ((or (not *subtitle-text*) (zero? (-> *subtitle-text* length)))
             (draw-string-xy "NO SUBTITLES LOADED!!!" buf 14 (+ PC_SUB_DBG_Y (* 10 8)) (font-color red) (font-flags shadow kerning))
             (load-level-subtitle-files 0)
             (set! (-> self current-debug-scene) 0)
             (set! (-> self current-debug-line) 0))
            ((-> self debug-lines?)
             (cond
               ((cpad-pressed? 0 square) (true! (-> self checking-lines?)))
               ((cpad-pressed? 0 left) (if (> (-> self current-debug-line) 0) (1-! (-> self current-debug-line))))
               ((cpad-pressed? 0 right)
                (if (< (-> self current-debug-line) (1- (-> *subtitle-text* data (-> self current-debug-scene) length)))
                  (1+! (-> self current-debug-line))))
               ((or (cpad-pressed? 0 up) (and (cpad-hold? 0 l2) (cpad-hold? 0 up)))
                (when (> (-> self current-debug-scene) 0)
                  (1-! (-> self current-debug-scene))
                  (set! (-> self current-debug-line) 0)))
               ((or (cpad-pressed? 0 down) (and (cpad-hold? 0 l2) (cpad-hold? 0 down)))
                (when (< (-> self current-debug-scene) (1- (-> *subtitle-text* length)))
                  (1+! (-> self current-debug-scene))
                  (set! (-> self current-debug-line) 0))))
             (let ((cur-scene (-> *subtitle-text* data (-> self current-debug-scene))))
               (if (nonzero? (-> cur-scene length))
                 (set! (-> self want-subtitle)
                       (-> *subtitle-text* data (-> self current-debug-scene) keyframes (-> self current-debug-line)))
                 (set! (-> self want-subtitle) #f))
               (draw-string-xy "Up/down: Pick scene" buf 14 (+ PC_SUB_DBG_Y (* 4 8)) (font-color default) (font-flags shadow kerning))
               (draw-string-xy "L2+Up/down: Pick scene (fast)"
                               buf
                               14
                               (+ PC_SUB_DBG_Y (* 5 8))
                               (font-color default)
                               (font-flags shadow kerning))
               (draw-string-xy "Left/right: Pick line"
                               buf
                               14
                               (+ PC_SUB_DBG_Y (* 6 8))
                               (font-color default)
                               (font-flags shadow kerning))
               (draw-string-xy "Square: Check all line heights"
                               buf
                               14
                               (+ PC_SUB_DBG_Y (* 7 8))
                               (font-color default)
                               (font-flags shadow kerning))
               (draw-string-xy (string-format "Scene: ~D/~D" (1+ (-> self current-debug-scene)) (-> *subtitle-text* length))
                               buf
                               14
                               (+ PC_SUB_DBG_Y (* 8 8))
                               (font-color default)
                               (font-flags shadow kerning))
               (draw-string-xy (string-format "Line: ~D/~D" (1+ (-> self current-debug-line)) (-> cur-scene length))
                               buf
                               14
                               (+ PC_SUB_DBG_Y (* 9 8))
                               (font-color default)
                               (font-flags shadow kerning))
               (case (-> cur-scene kind)
                 (((pc-subtitle-channel movie))
                  (draw-string-xy (string-format "Current scene: ~3L~A~0L" (-> cur-scene name))
                                  buf
                                  14
                                  (+ PC_SUB_DBG_Y (* 10 8))
                                  (font-color default)
                                  (font-flags shadow kerning)))
                 (((pc-subtitle-channel hint-named))
                  (draw-string-xy (string-format "Current scene: ~3L~A~0L (~3L#x~X~0L)" (-> cur-scene name) (-> cur-scene id))
                                  buf
                                  14
                                  (+ PC_SUB_DBG_Y (* 10 8))
                                  (font-color default)
                                  (font-flags shadow kerning)))
                 (((pc-subtitle-channel hint))
                  (draw-string-xy (string-format "Current scene: ~3L#x~X~0L" (-> cur-scene id))
                                  buf
                                  14
                                  (+ PC_SUB_DBG_Y (* 10 8))
                                  (font-color default)
                                  (font-flags shadow kerning)))
                 (else
                  (draw-string-xy (string-format "Unknown scene kind ~D" (-> cur-scene kind))
                                  buf
                                  14
                                  (+ PC_SUB_DBG_Y (* 10 8))
                                  (font-color red)
                                  (font-flags shadow kerning))))))
            (else
             (draw-string-xy "Square: reset" buf 14 (+ PC_SUB_DBG_Y (* 4 8)) (font-color default) (font-flags shadow kerning))
             (draw-string-xy "Up/down: Move vertically"
                             buf
                             14
                             (+ PC_SUB_DBG_Y (* 5 8))
                             (font-color default)
                             (font-flags shadow kerning))
             (draw-string-xy "Triangle+R1/L1: width"
                             buf
                             14
                             (+ PC_SUB_DBG_Y (* 6 8))
                             (font-color default)
                             (font-flags shadow kerning))
             (draw-string-xy "Triangle+R2/L2: height"
                             buf
                             14
                             (+ PC_SUB_DBG_Y (* 7 8))
                             (font-color default)
                             (font-flags shadow kerning))
             (draw-string-xy "Circle+R1/L1: scale" buf 14 (+ PC_SUB_DBG_Y (* 8 8)) (font-color default) (font-flags shadow kerning))
             (when (cpad-pressed? 0 square)
               (mem-copy! (the pointer *SUBTITLE-bank*) (the pointer (-> self bank-backup)) (size-of subtitle-bank)))
             (when (cpad-hold? 0 up)
               (+! (-> *SUBTITLE-bank* height) -0.01))
             (when (cpad-hold? 0 down)
               (+! (-> *SUBTITLE-bank* height) 0.01))
             (cond
               ((cpad-hold? 0 triangle)
                (when (cpad-hold? 0 r1)
                  (-! (-> *SUBTITLE-bank* width) 0.01))
                (when (cpad-hold? 0 l1)
                  (+! (-> *SUBTITLE-bank* width) 0.01))
                (when (cpad-hold? 0 r2)
                  (-! (-> *SUBTITLE-bank* lines) 0.05))
                (when (cpad-hold? 0 l2)
                  (+! (-> *SUBTITLE-bank* lines) 0.05)))
               ((cpad-hold? 0 circle)
                (when (cpad-hold? 0 r1)
                  (+! (-> *SUBTITLE-bank* scale) 0.01))
                (when (cpad-hold? 0 l1)
                  (-! (-> *SUBTITLE-bank* scale) 0.01))))))))
      (when (-> self checking-lines?)
        (false! (-> self checking-lines?))
        (go subtitle-debug-checking-lines))
      (when (and (cpad-hold? 0 l3) (cpad-pressed? 0 start))
        (cpad-clear! 0 start)
        (send-event self 'debug))
      (none))
  :code
    (-> subtitle-process
        code)
  :post
    (behavior ()
      (setup-subtitle-font)
      (draw-subtitle)
      (draw-debug-text-box (-> self font))
      0))

(defstate subtitle-debug-checking-lines (subtitle)
  :trans
    (behavior ()
      (setup-subtitle-font)
      (none))
  :code
    (behavior ()
      (protect ((-> *pc-settings* subtitle-speaker?))
        (set! (-> *pc-settings* subtitle-speaker?) #t)
        (let ((lines-so-far 0)
              (lines-this-time 0)
              (bad-lines 0))
          (dotimes (i (length *subtitle-text*))
            (dotimes (ii (length (-> *subtitle-text* data i)))
              (when (= lines-this-time PC_SUB_DBG_CHECK_GROUP_SIZE)
                (set! lines-this-time 0)
                (suspend))
              (set! (-> self want-subtitle) (-> *subtitle-text* data i keyframes ii))
              (1+! lines-this-time)
              (when (< (* (-> *SUBTITLE-bank* lines) 11)
                       (print-game-subtitle (subtitle-format self (-> self want-subtitle)) (-> self font) #f 128 22))
                (format 0 "LINE ~D IN SCENE ~D IS TOO LARGE!~%" (1+ ii) (1+ i))
                (format #t "LINE ~D IN SCENE ~D IS TOO LARGE!~%" (1+ ii) (1+ i))
                (1+! bad-lines))))
          (suspend)
          (if (> bad-lines 0) (format 0 "~D bad lines detected.~%" bad-lines) (format 0 "no bad lines detected!~%" bad-lines))))
      (go subtitle-debug))
  :post
    (behavior ()
      (with-dma-buffer-add-bucket ((buf (-> (current-frame) debug-buf)) (bucket-id debug))
        (draw-string-xy "Checking for bad lines... See console for info"
                        buf
                        14
                        PC_SUB_DBG_Y
                        (font-color red)
                        (font-flags shadow kerning)))
      (draw-debug-text-box (-> self font))
      0))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; helper functions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmethod length ((obj subtitle-text-info))
  "Get the length (number of subtitle scenes) in a subtitle-text-info."
  (-> obj length))

(defmethod length ((obj subtitle-text))
  "Get the length (number of subtitle lines) in a subtitle-text."
  (-> obj length))

(defbehavior subtitle-init-by-other subtitle ()
  "external initializer for subtitle process"
  ;; Gsubtitle-style : la couleur de base du contexte est le BLANC PLEIN (emplacement 36), pas
  ;; `default` (00), qui est le gris-vert degrade que l'owner voit sur le corps des lignes.
  ;; `(font-flags shadow)` est laisse tel quel : il n'est jamais relu par draw-string
  ;; (font.gc:1141), le retirer ne changerait rien et masquerait ce fait.
  (set! (-> self font)
        (new 'process
             'font-context
             *font-default-matrix*
             0
             0
             0.0
             (the-as font-color SUB_FONT_SLOT_WHITE)
             (font-flags shadow kerning middle large)))
  (set! (-> self debug-lines?) #t)
  (set! (-> self checking-lines?) #f)
  (go subtitle-process))

(defun subtitle-stop ()
  "kill the subtitle process"
  (kill-by-type subtitle *display-pool*)
  (set! *subtitle* (the (pointer subtitle) #f)))

(defun subtitle-start ()
  "start the subtitle process"
  (when *subtitle*
    (subtitle-stop))
  (set! *subtitle* (process-spawn subtitle :from *pc-dead-pool* :to *display-pool*)))

;; start the subtitle process when this file loads.
(subtitle-start)
