;;-*-Lisp-*-
(in-package goal)

;; phys-room.gc — LA SALLE DE TEST DE KEIRA, SANS JOUEUR (SPEC-keira-physique.md section 6).
;;
;; C'est l'ETAPE 1 du contrat, avant toute physique : sans elle il n'y a pas de mesure, et sans
;; mesure il n'y a rien a dire. Ce que l'owner a demande, mot pour mot :
;;
;;   « il serait bon d'avoir une test room dans laquelle ON NE SPAWN PAS LE PLAYER mais le
;;     personnage a tester, qu'on deplace in game de haut en bas, de gauche a droite, avec
;;     diverses accelerations, a coups, animations (toutes celles concernant ledit PNJ) »
;;
;; La tentative precedente mesurait dans une partie normale a village1-hut avec Jak jouable a
;; l'ecran ; l'owner l'a vu. Ici :
;;
;;   * `phys-room-start` appelle `(stop 'debug)` (logic-target.gc:1268) qui TUE le target et remet
;;     *target* a #f, puis coupe la naissance d'entites (*spawn-actors*). A CHAQUE FRAME de mesure
;;     la salle recompte les target vivants ; le compteur `viol` est publie tel quel. Le tableau ne
;;     peut declarer « joueur absent » que si ce compteur vaut zero — REGLE 0 : la ligne du tableau
;;     est ecrite par le script depuis la trace, pas par une promesse dans ce commentaire.
;;   * le sujet est spawne PAR NOM : l'art-group `assistant` (la Keira stock de jak1) est charge a
;;     la main (loado -> login -> set-loaded-art), exactement comme jak-hd.gc:691-701 charge le
;;     sien. AUCUN NIVEAU N'EST CHARGE : le squelette vit sur level-default. La zone contient le
;;     sujet, sa peau HD, et la camera.
;;   * le compagnon HD `keira-hd` se greffe tout seul (maybe-spawn-jak-hd!, jak-hd.gc:794) parce
;;     que le mgeo du sujet s'appelle `assistant-lod0` — le seul nom que hd-char-for-mgeo mappe
;;     sur Keira (jak-hd.gc:294-297). C'est LUI qui porte les chaines : le rig HD a des os
;;     (Rbanga, Lmidhaira, mask...) que le rig stock n'a pas.
;;   * le sujet est DEPLACE par integration d'une acceleration imposee : haut/bas, gauche/droite,
;;     accelerations croissantes, et a-coups (vitesse posee d'un coup, arrets brutaux).
;;   * TOUTES LES ANIMATIONS DE KEIRA sont jouees — pas seulement celles de l'art-group du sujet.
;;     Keira existe dans le jeu sous six art-groups (`assistant` au village 1, plus les variantes
;;     village2/village3/firecanyon/lavatube-start/lavatube-end) : « toutes celles concernant ledit
;;     PNJ » les prend toutes. Chacune est jouee sur le squelette du sujet apres verification que
;;     son nombre de joints correspond ; celles qui ne correspondent pas sont publiees comme
;;     REFUSEES avec leur compte, jamais ecartees en silence.
;;
;; Ce fichier ne calcule AUCUNE physique et n'invente AUCUN instrument : il fenetre, il lit les
;; accumulateurs de jak-hd-physics.gc (qui sont remplis la ou la position ecrite est connue), et
;; il imprime. Les lignes brutes commencent toutes par PHYS* et sont converties en tableau par
;; .autoport/physics_room_table.py.

(#when FLAG_PHYSICS

;; ------------------------------------------------------------------------------------------------
;; le sujet. `assistant` = le nom jak1 de Keira ; `assistant-lod0` est le mgeo que le compagnon HD
;; reconnait. :texture-level 2 fait passer initialize-skeleton par *level* level-default
;; (process-drawable.gc:343) : pas d'entite, pas de niveau.
;; ------------------------------------------------------------------------------------------------
(defskelgroup *phys-subject-sg* assistant
  assistant-lod0-jg
  assistant-idle-leaning-right-ja
  ((assistant-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 2)
  :texture-level 2)

;; les six art-groups de Keira dans jak1. `assistant` est celui du sujet (il porte le jgeo et le
;; mgeo) ; les cinq autres n'apportent que leurs animations.
(define *physroom-ag-names* (new 'static 'boxed-array :type string
  "assistant"
  "assistant-village2"
  "assistant-village3"
  "assistant-firecanyon"
  "assistant-lavatube-start"
  "assistant-lavatube-end"))

;; les mgeo (noms de merc) que ces six art-groups portent. Ce n'est pas de la decoration : c'est le
;; nom sur lequel le jeu decide si un compagnon HD se greffe (hd-desired-entry-for-mgeo), donc si la
;; physique peut exister. La salle appelle cette fonction pour les six et publie sa reponse.
(define *physroom-mgeo-names* (new 'static 'boxed-array :type string
  "assistant-lod0"
  "assistant-village2-lod0"
  "assistant-village3-lod0"
  "assistant-firecanyon-lod0"
  "assistant-lavatube-start-lod0"
  "assistant-lavatube-end-lod0"))

(defconstant PHYSROOM-MAXANIM 48)   ;; capacite de la table d'animations
;; updown / leftright / accel / jerk / TILT. Le cinquieme est arrive avec la 6e passe de l'owner :
;; « les seins n'ont pas l'air d'etre soumis a la gravite, aucun mouvement quand elle se penche en
;; avant pour souder ». Les quatre premiers TRANSLATENT le sujet, donc ils ne changent jamais
;; l'orientation de l'ancre, donc ils ne peuvent PAS voir une gravite exprimee dans le repere de
;; l'ancre. Il fallait un pilotage qui l'INCLINE.
(defconstant PHYSROOM-DRIVES  5)
;; SOUS-FENETRES par animation : les cinq pilotages, PLUS une fenetre SANS AUCUN PILOTAGE. Cette
;; derniere est la LIGNE DE BASE que reclame le superviseur (2026-08-11 16:15) : « publier la valeur
;; sous animation seule comme ligne de base a soustraire ; un pilotage dont la reponse ne depasse pas
;; la ligne de base n'a rien excite ». Sans elle, une amplitude par pilotage melange ce que le
;; pilotage a provoque et ce que l'animation faisait de toute facon, et on ne peut pas les separer.
(defconstant PHYSROOM-SUBW    6)
(defconstant PHYSROOM-WIN     90)   ;; frames par fenetre de mesure (6 segments de pilotage)
;; L'INCLINAISON EST UNE POSE TENUE, PAS UNE SECOUSSE DE PLUS. Elle monte a 60 degres sur les 24
;; premieres frames (rampe en demi-cosinus : depart et arrivee a vitesse nulle, donc aucun a-coup
;; parasite), puis NE BOUGE PLUS.
(defconstant PHYSROOM-TILTRAMP 24)
;; PERIODE des trois pilotages continus, et le carre de sa pulsation. Une trajectoire A sin(w f) a
;; une acceleration de module EXACTEMENT A w^2 : c'est ce qui permet de commander une acceleration
;; au lieu de l'esperer. 36 frames = un cycle complet dans les 36 frames effectivement mesurees.
;; w = 2 pi / 36 = 0.174533 rad/frame, w^2 = 0.0304617.
(defconstant PHYSROOM-PERIOD  36)
(defconstant PHYSROOM-W2      0.0304617)
;; UNE FENETRE DE MESURE NE COMMENCE JAMAIS SUR UNE DISCONTINUITE — et c'est la seconde moitie de
;; la cause racine de l'echec « DISCRIMINANT ».
;;
;; Ce que la salle faisait, mesure par le compteur `acc` (pire acceleration de la pose d'auteur
;; REELLEMENT recue par la pointe, en u/frame^2) sur la course du 2026-08-11 :
;;
;;     pilotage        updown  leftright  accel   jerk   tilt   AUCUN (ligne de base)
;;     acc recu         38964      2555    2570   2569   2543          32991
;;     acc COMMANDE        18        52      96    434  11.16              0
;;
;; Une ligne de base SANS AUCUN PILOTAGE recevait 32991 u/frame^2, soit 76 fois le plus violent des
;; pilotages. Le chiffre ne venait pas de la physique : il venait de la salle. Chaque sous-fenetre
;; s'ouvrait sur une TELEPORTATION du squelette entier, et le compteur repartait de zero juste a
;; temps pour la compter :
;;   * changement d'animation (avant `updown`) : `frame-num` et l'art-group changent d'un coup ;
;;   * retour a la verticale (avant la ligne de base) : `physroom-hold` repose le quaternion a
;;     l'identite, donc 60 degres rendus en UNE frame apres le pilotage `tilt` ;
;;   * retour au point de depart (avant `tilt`) : jusqu'a 3 m rendus en une frame apres `jerk`.
;; La chaine repondait a ce coup-la, pas au pilotage, et elle y repondait PAREIL sous les cinq :
;; c'est exactement « la mesure ne mesure pas le stimulus ».
;;
;; La mesure demarre donc a la frame 54 de chaque sous-fenetre, identique pour les six, et les 36
;; dernieres frames sont les seules comptees. 54 frames de decroissance avec l'amortissement le plus
;; faible du fichier (0.24) laissent 0.76^54 = 6e-8 du transitoire. Ce n'est pas un filtre : rien
;; n'est retire au signal, on a seulement cesse de mesurer pendant que l'instrument frappait le
;; sujet. Les fenetres restent egales entre elles, donc les amplitudes restent comparables.
(defconstant PHYSROOM-MEASAT  54)
(defconstant PHYSROOM-SETTLE  120)  ;; frames d'amorcage avant la premiere mesure
(defconstant PHYSROOM-IDLES   150)  ;; frames de calme AVANT de mesurer le repos
(defconstant PHYSROOM-IDLEM   120)  ;; frames de mesure du repos
(defconstant PHYSROOM-PCW     90)   ;; frames par branche du controle positif
(defconstant PHYSROOM-LIMIT   12288.0) ;; +/- 3 m autour du point de depart
;; COURBE DE REPONSE (6e passe : « les grosses meches sont trop statiques sur les mouvements
;; faibles, trop hysteriques sur les mouvements brusques »). Une reponse non lineaire, c'est un
;; seuil ; on mesure donc l'amplitude de pointe en fonction de l'amplitude d'EXCITATION, sur une
;; echelle geometrique. Une marche dans la courbe designe le seuil coupable.
(defconstant PHYSROOM-RESPL   6)    ;; niveaux d'excitation
(defconstant PHYSROOM-RESPW   72)   ;; frames par niveau
;; INCLINAISON STATIQUE : elle se penche, et on tient la pose. L'excitation d'acceleration retombe
;; a zero, donc ce qui reste dans l'ecart a la pose du modele n'est plus que la gravite.
(defconstant PHYSROOM-TILTDEG 60.0)

;; phases
(defconstant PHYSROOM-PH-SETTLE 0)
(defconstant PHYSROOM-PH-MEAS   1)
(defconstant PHYSROOM-PH-RESP   2)
(defconstant PHYSROOM-PH-IDLE   3)
(defconstant PHYSROOM-PH-TILT   4)
(defconstant PHYSROOM-PH-PCOFF  5)
(defconstant PHYSROOM-PH-PCON   6)
(defconstant PHYSROOM-PH-AUTHPC 7)
(defconstant PHYSROOM-PH-INVPC  8)
(defconstant PHYSROOM-PH-SELFOFF 9)
(defconstant PHYSROOM-PH-SELFON 10)
;; CONTROLE POSITIF DE LA CONTRAINTE DE COTE — DEUX BRANCHES QUI BALAYENT LES ANIMATIONS.
;;
;; Ce que faisait la version precedente, et pourquoi elle a rendu `armed=0 disarmed=0` : la branche
;; armee tenait 90 frames sur UNE SEULE animation (index 0, `assistant-idle-leaning-right`) et un
;; seul pilotage, pendant que le phenomene qu'elle pretend exercer — les lunettes qui traversent le
;; buste, le pan qui passe dans le mollet — se produit sur des animations PRECISES que cette
;; fenetre-la ne joue jamais. Un controle qui n'expose pas le defaut ne prouve pas qu'il a disparu :
;; il prouve qu'on ne l'a pas regarde. Mesure de la course du 2026-08-12 15:46 : side=0.0 sur les
;; SIX fenetres de diagnostic, y compris armee.
;;
;; Les deux branches balayent donc les MEMES `nanim` animations, `PHYSROOM-PCW` frames chacune, meme
;; pilotage : exposition identique de part et d'autre, ce qui est la seule facon de comparer deux
;; comptes. C'est aussi la correction que le cycle precedent avait ecrite sans la poser : comparer
;; 43 evenements sur 90 frames a 11446 sur 16740 rapprochait deux expositions differentes.
(defconstant PHYSROOM-PH-SIDEOFF 11)   ;; contrainte EN PLACE   — la reference
(defconstant PHYSROOM-PH-SIDEON  12)   ;; contrainte LEVEE      — le compteur DOIT monter
;; CONTROLE POSITIF DU FOURREAU (defaut ouvert `pant-calf`). La contrainte de concentricite
;; remplace l'ejection laterale du pan de pantacourt hors du mollet ; son residu doit tomber a zero,
;; et un zero que rien ne peut faire monter ne prouve rien. ARMEE, `phys-shell-off-set!` rend au pan
;; sa sphere de poussee d'avant : l'ecart radial DOIT remonter.
(defconstant PHYSROOM-PH-SHELLOFF 13)
(defconstant PHYSROOM-PH-SHELLON  14)
(defconstant PHYSROOM-PH-REPORT 15)
(defconstant PHYSROOM-PH-DONE   16)

(deftype phys-subject (process-drawable)
  ((phase   int32)
   (pframe  int32)
   (ai      int32)     ;; index dans *physroom-anim-*
   (drive   int32)
   (nanim   int32)     ;; animations RETENUES (jouables sur ce rig)
   (nenum   int32)     ;; animations ENUMEREES dans les six art-groups de Keira
   (slot    int32)     ;; slot de simulation du compagnon
   (nchain  int32)
   (hdpid   int32)
   (nag     int32)     ;; art-groups de Keira effectivement charges
   (fnum    float)     ;; frame courante de l'animation
   (nframe  float)     ;; nombre de frames de l'animation courante
   (adir    float)     ;; sens de lecture (+1 aller, -1 retour) — jamais de saut de frame-num
   (aspeed  float)     ;; vitesse de lecture de l'animation courante, celle du jeu
   (wraps   int32)     ;; demi-tours de lecture, publies : personne n'a a deviner combien
   (viol    int32)     ;; frames de mesure ou un target existait (doit rester 0)
   (nactor  int32)     ;; pire nombre d'acteurs etrangers vus dans la zone
   (killed  int32)     ;; acteurs etrangers deactives
   (dis     float)     ;; controle positif : penetration max, defaut DESARME
   (arm     float)     ;; controle positif : penetration max, defaut ARME
   (injn    int32)     ;; poussees reellement injectees
   (lvl     int32)     ;; niveau d'excitation courant de la courbe de reponse
   (vel     vector :inline)
   (home    vector :inline))
  (:states phys-subject-run))

(define *physroom-anim-ag* (new 'static 'array art-group PHYSROOM-MAXANIM))
(define *physroom-anim-ix* (new 'global 'array 'int32 PHYSROOM-MAXANIM))
(define *physroom-proc*    (the-as (pointer phys-subject) #f))

;; --- balayage de la zone (deux phases : on collecte, PUIS on tue — jamais muter l'arbre pendant
;; --- qu'on le parcourt, meme piege que hd-scan-visit).
(define *physroom-self*    (the-as process #f))
(define *physroom-hd*      (the-as process #f))
(define *physroom-nactor*  0)
(define *physroom-ntarget* 0)
(define *physroom-kill*    (new 'static 'array process-drawable 32))
(define *physroom-nkill*   0)

(defun physroom-visit ((proc process))
  (when (= (-> proc type) target) (+! *physroom-ntarget* 1))
  (when (and (type-type? (-> proc type) process-drawable)
             (!= proc *physroom-self*)
             (!= proc *physroom-hd*))
    (+! *physroom-nactor* 1)
    (when (< *physroom-nkill* 32)
      (set! (-> *physroom-kill* *physroom-nkill*) (the-as process-drawable proc))
      (+! *physroom-nkill* 1)))
  #t)

;; ------------------------------------------------------------------------------------------------
;; VIDER LA ZONE, et le prouver. Retourne le nombre d'acteurs ETRANGERS trouves cette frame (0 =
;; la zone ne contient plus que le sujet et sa peau HD). Les target trouves sont tues sur place et
;; comptes : la salle ne peut pas se contenter de les endormir (SPEC : « ni endormi, ni hors
;; champ : absent »).
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-sweep phys-subject ((kill? symbol))
  (set! *physroom-self* (the-as process self))
  (set! *physroom-hd* (if (-> self child) (the-as process (-> self child 0)) (the-as process #f)))
  (set! *physroom-nactor* 0)
  (set! *physroom-ntarget* 0)
  (set! *physroom-nkill* 0)
  (iterate-process-tree *active-pool* physroom-visit *null-kernel-context*)
  (when (> *physroom-ntarget* 0)
    ;; un target est reapparu (cycle d'attract) : on le tue immediatement et on le compte. Cette
    ;; frame de mesure est contaminee, et le compteur le dira.
    (kill-by-name 'target *active-pool*)
    (set! *target* #f))
  (when kill?
    (dotimes (i *physroom-nkill*)
      (deactivate (-> *physroom-kill* i))
      (+! (-> self killed) 1)))
  *physroom-nactor*)

;; ------------------------------------------------------------------------------------------------
;; LE PILOTAGE. Tout passe par une acceleration imposee puis integree : c'est la seule chose que la
;; chaine ressent (la pseudo-force de repere accelere de jak-hd-physics.gc).
;;
;; POURQUOI LES MAGNITUDES ONT CHANGE LE 2026-08-11 (et c'est la cause racine de l'echec DISCRIMINANT,
;; pas un reglage) : les quatre pilotages de translation tapaient tous entre 10 et 300 u/frame^2,
;; c'est-a-dire tous DERRIERE le coude de saturation des chaines. La courbe de reponse mesuree par
;; la salle elle-meme (PHYSRESP, six niveaux d'excitation) le dit sans ambiguite — gain amp/exc :
;;
;;     exc      1.5    3.5    8.0   18.0   42.0   96.0
;;     lBoob   25.2   21.0   19.3   19.6   15.8    7.5
;;     LtoeStrap 29.7 28.7   28.3   26.8   12.4    5.5
;;
;; le gain est CONSTANT jusqu'a 18, puis s'effondre d'un facteur 3 a 5. Au-dela du coude la chaine
;; est collee a son plafond geometrique et rend la meme amplitude quoi qu'on lui fasse : 16 chaines
;; sur 22 rendaient donc le meme chiffre sous une secousse, une translation et une inclinaison
;; (backhair : 3 % d'ecart). Ce n'etait pas la physique qui etait plate, c'etait le stimulus qui
;; etait partout le meme — sature. « Diverses accelerations » veut dire un EVENTAIL, et updown et
;; leftright, qui portaient les magnitudes IDENTIQUES sur deux axes, n'etaient pas deux stimuli
;; differents : c'etait le meme, tourne.
;;
;;   0 updown     vertical, 18 u/frame^2 — DANS LA BANDE LINEAIRE, la reponse y est proportionnelle
;;   1 leftright  horizontal, 52 u/frame^2 — la secousse franche
;;   2 accel      trajectoire plane, magnitude qui balaie 2 -> 96, donc qui TRAVERSE le coude
;;   3 jerk       vitesse POSEE d'un coup et arrets brutaux — « a-coups »
;;   4 tilt       elle SE PENCHE ET TIENT LA POSE : le seul pilotage qui n'est pas une secousse
;;   5 (aucun)    la ligne de base, traitee par l'appelant (physroom-hold)
;; Les unites sont des unites de jeu par frame^2 (4096 u = 1 m, 60 Hz).
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-drive phys-subject ((mode int) (f int))
  (let ((ax 0.0) (ay 0.0) (az 0.0)
        (seg (/ f 15)))
    (cond
      ;; --- LES TROIS PILOTAGES CONTINUS SONT IMPOSES EN POSITION, PAS EN ACCELERATION ----------
      ;; Mesure du 2026-08-11 : `updown` commandait 18 u/frame^2 et la chaine en recevait 173.
      ;; L'ecart venait du garde-fou : la vitesse etait INTEGREE, la position derivait jusqu'aux
      ;; +/- 3 m, et la butee remettait la vitesse a zero D'UN COUP — un a-coup de plusieurs
      ;; centaines d'unites au milieu de la fenetre de mesure. Les trois pilotages « doux » etaient
      ;; donc, en pratique, le meme choc que `jerk`, et c'est une deuxieme facon dont la salle
      ;; rendait cinq colonnes identiques.
      ;; Une trajectoire sinusoidale POSEE a une acceleration exactement connue (A w^2) et ne
      ;; s'approche jamais du garde-fou : le stimulus publie par PHYSSTIM est alors celui que la
      ;; chaine recoit vraiment, et le gain de ROOM-RESPONSE a enfin un denominateur honnete.
      ;; Periode 36 frames (w = 0.1745 rad/frame, w^2 = 0.03046) : exactement un cycle complet
      ;; dans les 36 frames effectivement mesurees.
      ((< mode 3)
       (let* ((mag (cond
                     ((zero? mode) 18.0)
                     ((= mode 1)   52.0)
                     ;; « diverses accelerations » : la meme trajectoire subie de 2 a 96
                     ;; u/frame^2, donc de part et d'autre du coude de saturation (18 a 42).
                     (else (+ 2.0 (* 94.0 (/ (the float f) (the float PHYSROOM-WIN)))))))
              (amp (/ mag PHYSROOM-W2))
              (ph  (* 65536.0 (/ (the float f) (the float PHYSROOM-PERIOD))))
              (s   (sin ph)))
         (vector-copy! (-> self root trans) (-> self home))
         (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
         (cond
           ((zero? mode) (set! (-> self root trans y) (+ (-> self home y) (* amp s))))
           ((= mode 1)   (set! (-> self root trans x) (+ (-> self home x) (* amp s))))
           (else
            (set! (-> self root trans x) (+ (-> self home x) (* amp s)))
            (set! (-> self root trans z) (+ (-> self home z) (* 0.5 amp (cos ph))))))))
      ((= mode 3)
       ;; a-coups : toutes les 10 frames la vitesse est ECRASEE, pas accumulee. Un segment sur
       ;; trois est un arret net (vitesse exactement nulle) : c'est le pire cas pour une chaine.
       (when (zero? (mod f 10))
         (let ((s (mod (/ f 10) 6)))
           (case s
             ((0) (set-vector! (-> self vel) 0.0 0.0 0.0 1.0))
             ((1) (set-vector! (-> self vel) 210.0 0.0 0.0 1.0))
             ((2) (set-vector! (-> self vel) 0.0 -260.0 0.0 1.0))
             ((3) (set-vector! (-> self vel) 0.0 0.0 0.0 1.0))
             ((4) (set-vector! (-> self vel) -240.0 0.0 190.0 1.0))
             (else (set-vector! (-> self vel) 0.0 300.0 0.0 1.0))))))
      (else
       ;; TILT : ELLE SE PENCHE EN AVANT ET ELLE TIENT LA POSE.
       ;;
       ;; Ce que ce mode faisait AVANT, et pourquoi il ne pouvait rien mesurer : il balayait
       ;; +/- 60 degres en sinus sur 45 frames, tangage puis roulis. A hauteur de tete (~7000 u de
       ;; l'axe) ca fait 1.047 rad x (2 pi / 45)^2 x 7000 = 143 u/frame^2 — la PLUS VIOLENTE des
       ;; cinq secousses, alors qu'elle porte le nom de l'inclinaison. Le pilotage cense mesurer la
       ;; gravite mesurait donc la meme chose que les quatre autres, et rendait le meme chiffre :
       ;; c'est exactement le « chestL tilt 0.3889 contre accel 0.3490 » que le superviseur a
       ;; reproche a ce tableau.
       ;;
       ;; Maintenant : rampe en demi-cosinus jusqu'a 60 degres sur PHYSROOM-TILTRAMP frames, puis
       ;; POSE TENUE. Pendant la tenue l'acceleration de translation est nulle et l'orientation ne
       ;; change plus : la seule chose qui agisse encore sur la chaine est la gravite exprimee dans
       ;; le repere de l'ancre. C'est le stimulus que l'owner decrit — « quand elle se penche en
       ;; avant pour souder » — et c'est le seul des cinq qui ne soit pas une agitation.
       (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
       (vector-copy! (-> self root trans) (-> self home))
       (let* ((u (if (< f PHYSROOM-TILTRAMP)
                   (/ (the float f) (the float PHYSROOM-TILTRAMP))
                   1.0))
              (a (* PHYSROOM-TILTDEG 0.5 (- 1.0 (cos (* 32768.0 u))))))
         (quaternion-axis-angle! (-> self root quat) 1.0 0.0 0.0 (degrees a)))))
    ;; `ax/ay/az` ne servent plus qu'a `jerk`, qui pose sa vitesse lui-meme : les trois pilotages
    ;; continus imposent desormais leur POSITION et n'integrent rien.
    (when (and (= mode 3) (or (!= ax 0.0) (!= ay 0.0) (!= az 0.0)))
      (set! (-> self vel x) (+ (-> self vel x) ax))
      (set! (-> self vel y) (+ (-> self vel y) ay))
      (set! (-> self vel z) (+ (-> self vel z) az))))
  ;; INTEGRATION + GARDE-FOU, ET SEULEMENT POUR `jerk`. La butee des +/- 3 m remet la vitesse a zero
  ;; d'un coup : c'est un a-coup de plus, ce qui est exactement le propos de `jerk` et exactement le
  ;; contraire du propos des trois autres. C'est pour ca qu'ils n'integrent plus.
  (when (= mode 3)
    (set! (-> self root trans x) (+ (-> self root trans x) (-> self vel x)))
    (set! (-> self root trans y) (+ (-> self root trans y) (-> self vel y)))
    (set! (-> self root trans z) (+ (-> self root trans z) (-> self vel z)))
    (when (> (fabs (- (-> self root trans x) (-> self home x))) PHYSROOM-LIMIT)
      (set! (-> self root trans x) (+ (-> self home x) (* PHYSROOM-LIMIT (if (> (-> self vel x) 0.0) 1.0 -1.0))))
      (set! (-> self vel x) 0.0))
    (when (> (fabs (- (-> self root trans y) (-> self home y))) PHYSROOM-LIMIT)
      (set! (-> self root trans y) (+ (-> self home y) (* PHYSROOM-LIMIT (if (> (-> self vel y) 0.0) 1.0 -1.0))))
      (set! (-> self vel y) 0.0))
    (when (> (fabs (- (-> self root trans z) (-> self home z))) PHYSROOM-LIMIT)
      (set! (-> self root trans z) (+ (-> self home z) (* PHYSROOM-LIMIT (if (> (-> self vel z) 0.0) 1.0 -1.0))))
      (set! (-> self vel z) 0.0)))
  ;; les quatre pilotages de translation laissent le sujet DROIT : sans ca l'inclinaison de la
  ;; fenetre precedente resterait en place et contaminerait la suivante.
  (when (< mode 4) (quaternion-identity! (-> self root quat)))
  (none))

(defbehavior physroom-hold phys-subject ()
  "immobile, pile sur le point de depart ET DROITE : c'est l'etat de repos de SPEC section 4."
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-identity! (-> self root quat))
  (none))

(defbehavior physroom-lean phys-subject ((deg float))
  "immobile mais PENCHEE de `deg` degres vers l'avant. L'excitation d'acceleration retombe a zero,
   donc ce qui reste dans l'ecart a la pose du modele n'est plus que la gravite. C'est la mesure
   que reclame la 6e passe de l'owner : « aucun mouvement quand elle se penche en avant pour
   souder, pas coherent du tout »."
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-axis-angle! (-> self root quat) 1.0 0.0 0.0 (degrees deg))
  (none))

;; EXCITATION CALIBREE : une acceleration d'amplitude CONNUE, alternee, sur un seul axe. C'est
;; l'entree de la courbe de reponse — l'amplitude de pointe en sortie se lit dans la meme fenetre.
(defbehavior physroom-drive-exc phys-subject ((f int) (mag float))
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-identity! (-> self root quat))
  ;; deplacement sinusoidal pur : |acceleration| = mag, sans discontinuite qui melangerait la
  ;; reponse au seuil qu'on cherche.
  (let* ((w  (/ 65536.0 24.0))
         (ph (* w (the float f)))
         (amp (/ mag (* (/ 6.2831853 24.0) (/ 6.2831853 24.0)))))
    (set! (-> self root trans x) (+ (-> self home x) (* amp (sin ph))))
    (set! (-> self root trans y) (+ (-> self home y) (* 0.4 amp (sin (* 2.0 ph))))))
  (none))

;; les six niveaux d'excitation, en unites de jeu par frame^2 (4096 u = 1 m, 60 Hz). Echelle
;; geometrique : chaque niveau vaut ~2.3x le precedent, du frisson au coup sec.
(defun physroom-exc-level ((i int))
  (case i
    ((0) 1.5)
    ((1) 3.5)
    ((2) 8.0)
    ((3) 18.0)
    ((4) 42.0)
    (else 96.0)))

;; ------------------------------------------------------------------------------------------------
;; ANIMATION. On pose le groupe de frames du channel 0 a la main et on avance frame-num nous-memes
;; (num-func-identity) : c'est exactement ce que fait initialize-skeleton (process-drawable.gc:405)
;; et ca nous laisse maitre du temps, donc de la reproductibilite des fenetres. Le `draw art-group`
;; est bascule sur celui de l'animation, comme le fait anim-tester.gc:515 pour jouer les animations
;; d'un art-group sur un squelette deja en place.
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-set-anim phys-subject ((ai int))
  (let* ((ag (-> *physroom-anim-ag* ai))
         (an (the-as art-joint-anim (-> ag data (-> *physroom-anim-ix* ai)))))
    (set! (-> self draw art-group) ag)
    (ja-channel-set! 1)
    (let ((ch (-> self skel root-channel 0)))
      (joint-control-channel-group-eval! ch an num-func-identity)
      (set! (-> ch frame-num) 0.0))
    (set! (-> self fnum) 0.0)
    (set! (-> self adir) 1.0)
    ;; LE NOMBRE DE FRAMES DE L'ANIMATION, tel que le lit le jeu lui-meme. La salle utilisait
    ;; `(-> an data 0 length)` — la taille du premier bloc de donnees compressees, PAS une duree.
    ;; Le moteur d'animation, lui, borne `frame-num` a `(-> frame-group frames num-frames)`
    ;; (joint.gc:948). Les deux ne coincident pas, et la salle rejouait donc une fraction arbitraire
    ;; de chaque animation en croyant les jouer entieres.
    (set! (-> self nframe) (the float (-> an frames num-frames)))
    ;; LA VITESSE DE LECTURE DU JEU, et c'est LA cause racine de « la salle mesure l'agitation ».
    ;;
    ;; La salle avancait `frame-num` de 1.0 par frame de jeu. Le jeu, lui, l'avance de
    ;; `inc * (-> frame-group speed) * time-adjust-ratio` (process-drawable-h.gc:46,
    ;; `num-func-loop!`) : la vitesse propre de l'animation est un FACTEUR, et les animations de
    ;; jak1 ont des keyframes espacees justement parce qu'elles sont interpolees entre deux.
    ;; Avancer d'une keyframe ENTIERE par frame joue l'animation plusieurs fois trop vite, et
    ;; l'acceleration croit comme le CARRE du facteur de vitesse.
    ;;
    ;; Ce que ca donnait, mesure (`acc` = pire acceleration de la pose d'auteur REELLEMENT recue par
    ;; la pointe, en u/frame^2) : backHair1 recevait 2447 u/frame^2 SANS AUCUN PILOTAGE — 2150 m/s^2,
    ;; 219 g, sur une animation d'attente. Les cinq pilotages commandaient 18, 52, 96, 434 et 11
    ;; u/frame^2 : ils etaient noyes d'un facteur 25 a 130, et les cinq colonnes rendaient donc le
    ;; meme chiffre. La salle ne mesurait pas la physique de Keira, elle mesurait la Keira qu'elle
    ;; secouait — celle que l'owner ne voit jamais, puisque le jeu ne joue pas ses animations comme
    ;; ca.
    (set! (-> self aspeed) (fmax 0.01 (-> an speed)))
    ;; LA LONGUEUR ET LA VITESSE REELLES, publiees : personne n'a a les deviner, et c'est le
    ;; chiffre qui prouve a quelle vitesse la salle joue reellement l'animation.
    (format 0 "PHYSANIMLEN a=~D n=~f speed=~f~%" ai (-> self nframe) (-> self aspeed)))
  (none))

;; LECTURE CONTINUE : ALLER-RETOUR, JAMAIS DE RETOUR BRUTAL A LA FRAME 0.
;;
;; C'EST LA CAUSE RACINE DE L'ECHEC « DISCRIMINANT », ET C'ETAIT UN DEFAUT DE L'INSTRUMENT, PAS DE
;; LA PHYSIQUE. L'ancienne version faisait `(when (>= fnum (- nframe 1.0)) (set! fnum 0.0))` : en UNE
;; frame, le squelette entier sautait de la derniere pose de l'animation a la premiere. Sur une
;; animation qui BOUCLE (les idle) les deux poses se ressemblent et le saut est petit ; sur une
;; TRANSITION (`assistant-idle-transition-right-to-left`, `assistant-idle-transition-to-welding`,
;; `assistant-village2-idle-hut-stop-welding`) elles n'ont rien a voir, et le personnage se
;; TELEPORTAIT d'une pose a l'autre. La difference seconde de cette teleportation est une
;; acceleration de plusieurs centaines d'unites par frame^2 — bien au-dela des 18 a 96 u/frame^2 que
;; la salle commande, et bien au-dela du coude de saturation mesure par PHYSRESP (18 a 42).
;;
;; Consequence exacte de ce que la gate reproche : la gate prend le MAXIMUM sur les animations, donc
;; pour chaque pilotage elle tombait sur une animation de transition, et y lisait la reponse au coup
;; de teleportation — la meme sous les cinq pilotages, puisqu'elle ne doit rien au pilotage. Les
;; chaines les plus courtes y etaient collees a leur plafond geometrique (lKneeFlap : os de 8 cm,
;; excursion de pointe 14,4 cm SOUS ANIMATION SEULE). On ne mesurait pas la physique de Keira, on
;; mesurait le rebond de la salle qui la secouait 20 fois par seconde.
;;
;; La lecture aller-retour visite EXACTEMENT les memes poses (SPEC 6 : « toutes ses animations »),
;; dans les deux sens, sans aucune discontinuite de position. Ce n'est pas un filtre et ca ne retire
;; aucun mouvement : ca retire une teleportation que le jeu ne fait pas non plus (en jeu, les
;; animations sont enchainees par un fondu, jamais par un saut de frame-num).
(defbehavior physroom-advance-anim phys-subject ((step float))
  (when (nonzero? (-> self skel))
    (let ((last (fmax 1.0 (- (-> self nframe) 1.0))))
      (set! (-> self fnum) (+ (-> self fnum) (* (-> self adir) (* step (-> self aspeed)))))
      (when (>= (-> self fnum) last)
        (set! (-> self fnum) last)
        (set! (-> self adir) -1.0)
        (+! (-> self wraps) 1))
      (when (<= (-> self fnum) 0.0)
        (set! (-> self fnum) 0.0)
        (set! (-> self adir) 1.0)
        (+! (-> self wraps) 1)))
    (set! (-> self skel root-channel 0 frame-num) (-> self fnum)))
  (none))

;; ------------------------------------------------------------------------------------------------
;; PUBLICATION D'UNE FENETRE. Une ligne par chaine. La cle `k` encode (chaine, animation,
;; pilotage) : format est cape a 8 parametres (destination + format + 6), et on veut les quatre
;; colonnes sur la meme ligne pour qu'elles ne puissent pas etre reassemblees de travers.
;;   amp  = AMPLITUDE de l'ecart de pointe du a la physique seule (diagonale de sa boite)
;;   root = pire residu d'ancrage de la racine
;;   pen  = pire penetration residuelle au-dela du plancher de pose modele
;;   jump = pire saut de l'ecart de pointe sur UNE frame
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-emit-window phys-subject ()
  (dotimes (c (-> self nchain))
   ;; une chaine que le moteur a ecartee (pose de modele hors de portee de son porteur) n'a pas de
   ;; mesure a publier : publier des zeros pour elle serait un chiffre invente.
   (when (> (phys-chain-links (-> self slot) c) 0)
    (cond
      ;; LIGNE DE BASE : meme animation, meme duree de fenetre, AUCUN pilotage. Publiee sur sa
      ;; propre ligne et jamais comme une mesure de pilotage : elle sert a soustraire, pas a
      ;; compter. La confondre avec un `row` donnerait a chaque chaine un pilotage artificiellement
      ;; faible, et ferait passer la gate DISCRIMINANT sans rien mesurer de plus.
      ((>= (-> self drive) PHYSROOM-DRIVES)
       (format 0 "PHYSBASE c=~D a=~D amp=~f jump=~f ns=~f~%"
               c (-> self ai)
               (phys-tip-amp (-> self slot) c)
               (phys-stat (-> self slot) c 2)
               (phys-stat (-> self slot) c 0)))
      (else
       (format 0 "PHYSROW k=~D amp=~f root=~f pen=~f jump=~f ns=~f~%"
               (+ (* (+ (* c PHYSROOM-MAXANIM) (-> self ai)) PHYSROOM-DRIVES) (-> self drive))
               (phys-tip-amp (-> self slot) c)
               (phys-stat (-> self slot) c 3)
               (phys-pen-col (-> self slot) c)
               (phys-stat (-> self slot) c 2)
               (phys-stat (-> self slot) c 0))))
    ;; LE STIMULUS REELLEMENT RECU, pour CHAQUE fenetre y compris la ligne de base. Compare a
    ;; l'amplitude commandee (PHYSSTIM), il dit si le pilotage a domine ou s'il a ete noye.
    (format 0 "PHYSACC c=~D a=~D d=~D acc=~f wraps=~D~%"
            c (-> self ai) (-> self drive)
            (phys-tip-stim (-> self slot) c)
            (-> self wraps))
    ;; LE GRADIENT, MAILLON PAR MAILLON (7e passe : « entre la racine et les pointes c'est zone de
    ;; guerre et les pointes bougent quasi pas »). Une ligne par maillon : c'est la seule forme qui
    ;; puisse porter un degrade, la ou un scalaire par chaine n'en montre rien.
    ;; DEUX GRANDEURS PAR MAILLON, ET LEUR ECART EST LE SUJET. 10e passe : « le milieu bouge
    ;; beaucoup plus que les pointes » alors que `amp` publiait une suite croissante.
    ;;   amp = ecart a la pose d'auteur — il CUMULE le long de la chaine, donc une pointe soudee a
    ;;         son parent herite du chiffre de son parent et parait mobile ;
    ;;   ang = deviation ANGULAIRE par rapport a l'attache, en degres — le mouvement PROPRE du
    ;;         maillon, nul pour un maillon qui suit rigidement son parent.
    ;; C'est `ang` que SPEC 2 exige croissante ; `amp` reste publiee pour que l'ecart entre les deux
    ;; soit lisible au lieu d'etre affirme.
    (dotimes (l (phys-chain-links (-> self slot) c))
      ;; `a0`/`a1` : le MEME angle releve aux etages du solveur (apres integration seule, puis
      ;; apres contraintes + attenuation). `ang` reste la valeur ECRITE. C'est la comparaison des
      ;; trois qui designe l'etage qui aplatit la pointe -- defaut `hair-gradient`, PRIORITE 1 :
      ;; un seul chiffre en sortie ne pouvait pas le dire, et trois passes ont bute dessus.
      (format 0 "PHYSGRAD c=~D a=~D d=~D l=~D amp=~f ang=~f~%"
              c (-> self ai) (-> self drive) l
              (phys-link-amp (-> self slot) c l)
              (phys-link-ang (-> self slot) c l))
      ;; LIGNE SEPAREE, et ce n'est pas un choix de style : `format` de GOAL n'accepte pas plus de
      ;; huit parametres, destination et chaine comprises.
      (format 0 "PHYSGRADS c=~D a=~D d=~D l=~D a0=~f a1=~f~%"
              c (-> self ai) (-> self drive) l
              (phys-link-ang-stage (-> self slot) c l 0)
              (phys-link-ang-stage (-> self slot) c l 1)))
    ;; L'ALLONGEMENT ET LE STIMULUS GRAVITAIRE DE CETTE FENETRE. Par fenetre, donc attribuables a un
    ;; PILOTAGE : « ils s'allongent sur les mouvements brusques » ne se verifie pas sur un total de
    ;; course. `gn` = |g_effective|/|g| vu par l'ancre, `tf` = la part TANGENTIELLE de cette gravite,
    ;; seule capable de faire tourner le lien — le reste est annule par la contrainte de longueur.
    (format 0 "PHYSSTR c=~D a=~D d=~D el=~f gn=~f tf=~f~%"
            c (-> self ai) (-> self drive)
            (phys-stat (-> self slot) c 17)
            (phys-stat (-> self slot) c 18)
            (phys-stat (-> self slot) c 19))))
  (none))

;; POSITION MOYENNE de la pointe dans le repere de l'ancre, axe par axe. Une ligne a part parce que
;; `format` est cape a six parametres et que ces trois-la doivent rester solidaires du tag.
(defbehavior physroom-emit-mean phys-subject ((tag string))
  (dotimes (c (-> self nchain))
    (when (> (phys-chain-links (-> self slot) c) 0)
      (format 0 "PHYSMEAN tag=~S c=~D x=~f y=~f z=~f~%"
              tag c
              (phys-tip-mean (-> self slot) c 0)
              (phys-tip-mean (-> self slot) c 1)
              (phys-tip-mean (-> self slot) c 2))
      ;; LE STIMULUS GRAVITAIRE DE LA MEME FENETRE, a cote de la reponse. Un affaissement nul avec
      ;; gn=0 dit « la gravite n'est pas arrivee » ; avec gn=1.0 et tf~0 il dit « elle est arrivee et
      ;; la geometrie de l'os l'annule » ; avec gn=1.0 et tf~1 il dit « la chaine n'y repond pas ».
      ;; Trois diagnostics differents que le seul `sag` confondait.
      (format 0 "PHYSGRAV tag=~S c=~D gn=~f tf=~f~%"
              tag c
              (phys-stat (-> self slot) c 18)
              (phys-stat (-> self slot) c 19))))
  (none))

(defbehavior physroom-emit-diag phys-subject ((tag string))
  "LES QUATRE DEFAUTS DE LA 6e PASSE, CHAINE PAR CHAINE. Un total global ne dit pas si ce sont les
   meches fines qui jittent ou les sangles de cheville : ces compteurs-la sont par chaine.
     selfcol  corrections venues d'un volume porte par les PROPRES joints de la chaine — ZERO
     retreat  reculs vers la pose du modele (le limiteur qui saute)
     flip     paires (lien, volume) ayant change d'etat de contrainte d'une frame a l'autre : la
              mesure du jitter lui-meme
     inv      inversions corrigees / invres inversions RESIDUELLES — ZERO
     elong    pire allongement RELATIF d'un lien (|l/l0 - 1|) — « les seins s'allongent »"
  (dotimes (c (-> self nchain))
    (when (> (phys-chain-links (-> self slot) c) 0)
      (format 0 "PHYSDIAG tag=~S c=~D selfcol=~f retreat=~f flip=~f~%"
              tag c
              (phys-diag (-> self slot) c 0)
              (phys-diag (-> self slot) c 1)
              (phys-diag (-> self slot) c 2))
      (format 0 "PHYSDIAG2 tag=~S c=~D inv=~f invres=~f elong=~f rad=~f~%"
              tag c
              (phys-diag (-> self slot) c 3)
              (phys-diag (-> self slot) c 4)
              (phys-diag (-> self slot) c 5)
              (phys-diag (-> self slot) c 6))
      ;; LES TROIS DEFAUTS DE LA 11e PASSE, chaine par chaine, chacun avec sa NATURE ecrite a cote
      ;; de lui parce qu'un chiffre sans nature est ce qui a produit les faux verts de la veille :
      ;;   bendcut  DEGRES retires par l'attenuation d'angle des CHEVEUX (un suppresseur, donc il
      ;;            se chiffre). Repere : l'attache du maillon. Zero quand la meche ne se replie
      ;;            jamais au-dela de la limite que le rig lui donne.
      ;;   shape    |p - T| / longueur de l'os, SANS DIMENSION : l'echelle de la deformation que le
      ;;            skinning lineaire impose a la chair. C'est « ca change de taille, plus petit,
      ;;            plus gros, ecrase ». Zero quand le maillon est a sa pose de modele.
      ;;   buried   paires (lien, volume) ou le lien est ENTIEREMENT dans un volume A SA POSE DE
      ;;            MODELE, comptees une fois par frame : un pan dont la pose est DANS la jambe n'a
      ;;            aucune surface a traverser, donc meshpen reste a zero pendant que l'owner le
      ;;            voit disparaitre (« comme si son pantacourt s'arretait aux genoux »). Zero
      ;;            quand la piece est dehors, la ou elle se voit.
      (format 0 "PHYSDIAG3 tag=~S c=~D bendcut=~f shape=~f buried=~f tiprot=~f~%"
              tag c
              (phys-diag (-> self slot) c 7)
              (phys-diag (-> self slot) c 8)
              (phys-diag (-> self slot) c 9)
              (phys-diag (-> self slot) c 10))
      ;;   side     paires (lien, volume) ou le lien est passe du COTE OPPOSE de l'axe du volume
      ;;            dans lequel sa pose de modele se trouvait. C'est ROOM-SIDE, reclame par les
      ;;            DIRECTIVES depuis la 11e passe et jamais ecrit jusqu'ici. Aucune autre colonne
      ;;            ne peut voir ce defaut : la profondeur de penetration est MAXIMALE sur l'axe et
      ;;            REDESCEND quand le lien ressort de l'autre cote, donc un lien qui a traverse de
      ;;            part en part rend une profondeur faible, indistinguable d'un lien sagement
      ;;            dehors. NATURE : un compte de paires (un changement de COTE est discret, une
      ;;            distance ne peut pas le decrire). REPERE : celui du VOLUME — direction du point
      ;;            le plus proche de son axe vers le lien, comparee entre la pose du modele et
      ;;            maintenant. LECTURE QUAND LE DEFAUT EST ABSENT : 0.
      (format 0 "PHYSDIAG4 tag=~S c=~D side=~f~%"
              tag c
              (phys-diag (-> self slot) c 11))
      ;;   volprio  paires (lien, volume) que la DECISION 1 a ECARTEES parce qu'un autre volume
      ;;            decidait deja pour ce lien cette frame. C'est le seul chiffre qui dise OU les
      ;;            volumes se contredisent, et il manquait : `ROOM-INVERSIONS residual=379`
      ;;            n'etait attribuable a aucune chaine. Une chaine dont ce compte est GRAND est
      ;;            une chaine que des volumes se disputaient, donc que le recul epinglait
      ;;            (kneeflapR : retreat 15913 frames sur 17893).
      ;;            NATURE : un compte de paires sur la fenetre. REPERE : sans objet.
      ;;            LECTURE QUAND LE DEFAUT EST ABSENT : 0 — aucun conflit, personne n'est ecarte.
      (format 0 "PHYSDIAG5 tag=~S c=~D volprio=~f shellrad=~f~%"
              tag c
              (phys-diag (-> self slot) c 12)
              (phys-diag (-> self slot) c 13))))
  (none))

(defbehavior physroom-max-pen phys-subject ()
  (let ((m -1000000000.0))
    (dotimes (c (-> self nchain))
      (when (> (phys-chain-links (-> self slot) c) 0)
        (let ((p (phys-pen-col (-> self slot) c)))
          (when (> p m) (set! m p)))))
    m))

;; ------------------------------------------------------------------------------------------------
;; LE RAPPORT BRUT. Aucune conclusion ici : des nombres, et le script en fait un tableau. S'il
;; manque une preuve (un target apparu pendant la mesure), le nombre le dit et le script refuse
;; d'ecrire « joueur absent ».
;; ------------------------------------------------------------------------------------------------
;; L'AMPLITUDE DU STIMULUS de chaque pilotage, en unites de jeu par frame^2. C'est ce que la salle
;; COMMANDE, pas ce qu'elle observe : c'est le denominateur du gain de ROOM-RESPONSE. Sans lui,
;; comparer deux amplitudes de pointe obtenues sous deux stimuli differents ne veut rien dire — et
;; c'est precisement ce que faisait le tableau precedent.
;;   jerk    la vitesse est POSEE, pas accumulee : le stimulus est le pire saut de vitesse d'une
;;           frame a l'autre, (-240,0,190) -> (0,300,0), soit 434 u/frame^2.
;;   tilt    pose TENUE : plus aucune acceleration de repere. Le stimulus est la gravite elle-meme
;;           vue depuis l'ancre, 2 |g| sin(30 deg) = 11.16 u/frame^2 a 60 degres.
(defun physroom-stim-mag ((mode int))
  (case mode
    ((0) 18.0)
    ((1) 52.0)
    ((2) 96.0)
    ((3) 434.0)
    (else 11.16)))

(defbehavior physroom-report phys-subject ()
  (dotimes (d PHYSROOM-DRIVES)
    (format 0 "PHYSSTIM dr=~D mag=~f~%" d (physroom-stim-mag d)))
  (format 0 "PHYSNOPLAY viol=~D actors=~D killed=~D~%"
          (-> self viol) (-> self nactor) (-> self killed))
  (format 0 "PHYSCOUNTS anims=~D enum=~D chains=~D drives=~D ags=~D~%"
          (-> self nanim) (-> self nenum) (-> self nchain) PHYSROOM-DRIVES (-> self nag))
  (format 0 "PHYSKEY maxanim=~D drives=~D slot=~D hdpid=~D win=~D~%"
          PHYSROOM-MAXANIM PHYSROOM-DRIVES (-> self slot) (-> self hdpid) PHYSROOM-WIN)
  (format 0 "PHYSPC injections=~D armed=~f disarmed=~f~%"
          (-> self injn) (-> self arm) (-> self dis))
  ;; L'UNITE DE `atan`, MESUREE A L'EXECUTION ET PAS DEDUITE D'UNE LECTURE DE SOURCE (regle 0).
  ;; L'ecriture d'orientation du moteur passait `(* 57.2957795 (atan sin cos))` a
  ;; `matrix-axis-angle!` — une conversion radians->degres. Si `atan` rend des UNITES DE ROTATION,
  ;; cette multiplication fait tourner l'os 57 fois trop et `sin` replie ensuite modulo un tour :
  ;; toute chaine qui flechit ecrit alors une orientation fausse, sans qu'aucun chiffre de POSITION
  ;; puisse le voir. Les trois nombres tranchent, et ils se lisent sans rien savoir du moteur :
  ;;   atan45   = (atan 1 1). 8192 => 65536 unites par tour ; 0.7854 => des radians.
  ;;   sinq     = (sin 8192). 0.7071 => 8192 vaut bien 45 degres dans l'unite qu'accepte `sin`,
  ;;              donc dans celle qu'accepte `matrix-axis-angle!`, qui l'appelle.
  ;;   bad      = ce que l'ancienne ligne aurait passe pour ce meme angle de 45 degres.
  (format 0 "PHYSUNITS atan45=~f sinq=~f bad=~f~%"
          (atan 1.0 1.0) (sin 8192.0) (* 57.2957795 (atan 1.0 1.0)))
  (format 0 "PHYSEND~%")
  (none))

;; ------------------------------------------------------------------------------------------------
;; LA MACHINE A ETATS. Une frame = un pas.
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-tick phys-subject ()
  ;; la zone reste vide a chaque frame, et on compte ce qu'on y trouve.
  (let ((n (physroom-sweep (< (-> self phase) PHYSROOM-PH-REPORT))))
    (when (> n (-> self nactor)) (set! (-> self nactor) n))
    ;; une frame de MESURE contaminee par un target vivant est une violation. Les phases
    ;; d'amorcage ne comptent pas : c'est la qu'on nettoie.
    (when (and (> *physroom-ntarget* 0) (> (-> self phase) PHYSROOM-PH-SETTLE))
      (+! (-> self viol) 1)))

  (+! (-> self pframe) 1)

  (cond
    ;; ---- 0. AMORCAGE : attendre le compagnon HD et ses chaines -------------------------------
    ((= (-> self phase) PHYSROOM-PH-SETTLE)
     (physroom-hold)
     (physroom-advance-anim 1.0)
     (when (< (-> self slot) 0)
       (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
         (when (and hd (= (-> hd type) jak-hd))
           (set! (-> self hdpid) (the int (-> hd pid)))
           (set! (-> self slot) (phys-slot-of (the int (-> hd pid))))
           (when (>= (-> self slot) 0)
             (set! (-> self nchain) (phys-slot-chains (-> self slot)))))))
     (when (and (>= (-> self pframe) PHYSROOM-SETTLE) (> (-> self nchain) 0))
       ;; la topologie REELLEMENT resolue par le moteur, pas celle que le fichier promet, et la
       ;; longueur que le MODELE donne a chaque os : c'est le plafond geometrique de l'amplitude de
       ;; ce lien, publie pour que personne n'ait a la deviner. Publie EN FIN d'amorcage : les os du
       ;; compagnon ne portent une pose que quand son propre do-joint-math! a tourne, et le publier
       ;; a la frame de sa naissance ne donnait que des zeros (mesure du 2026-08-11).
       (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
         (when (and hd (= (-> hd type) jak-hd))
           (dotimes (c (-> self nchain))
             (let ((j0 (phys-chain-joint (-> self slot) c 0)))
               (format 0 "PHYSCHAIN c=~D links=~D fam=~D hang=~f j0=~S~%"
                       c
                       (phys-chain-links (-> self slot) c)
                       (phys-chain-family (-> self slot) c)
                       (phys-chain-hang (-> self slot) c)
                       (if (and (>= j0 0) (nonzero? (-> hd draw)) (nonzero? (-> hd draw jgeo)))
                         (-> hd draw jgeo data j0 name)
                         "?")))
             (dotimes (l (phys-chain-links (-> self slot) c))
               (format 0 "PHYSBONE c=~D l=~D len=~f~%"
                       c l (phys-chain-bone hd (-> self slot) c l))
               ;; QUELS JOINTS CETTE CHAINE ECRIT REELLEMENT. Verdict owner du 2026-08-11 : « un
               ;; polygone de la semelle de la chaussure gauche se fait la malle » et « les
               ;; languettes des bandes de genoux ne bougent pas du tout » — les deux se decident
               ;; sur la liste des joints ECRITS, pas sur une intention dans les donnees.
               (let ((j (phys-chain-joint (-> self slot) c l)))
                 (format 0 "PHYSJOINT c=~D l=~D idx=~D name=~S~%"
                         c l j
                         (if (and (>= j 0) (nonzero? (-> hd draw)) (nonzero? (-> hd draw jgeo)))
                           (-> hd draw jgeo data j name)
                           "?"))))
             ;; LES VOLUMES QUE LE MOTEUR A RESOLUS, par nom de joint : sans eux un zero de
             ;; penetration ne prouve rien (le tableau annoncait zero alors qu'aucun collider de
             ;; buste n'existait et que l'owner voyait les bretelles traverser le torse).
             (when (zero? c)
               (dotimes (ci (phys-slot-colliders (-> self slot)))
                 (let ((j  (phys-collider-field (-> self slot) ci 0))
                       (j2 (phys-collider-field (-> self slot) ci 1)))
                   (format 0 "PHYSCOL ci=~D j=~S j2=~S~%"
                           ci
                           (if (and (>= j 0) (nonzero? (-> hd draw jgeo)))
                             (-> hd draw jgeo data j name) "?")
                           (if (and (>= j2 0) (nonzero? (-> hd draw jgeo)))
                             (-> hd draw jgeo data j2 name) "-"))))))))
       ;; LE SQUELETTE EST-IL SEULEMENT POSE ? Une course device du 2026-08-11 a publie 1584
       ;; lignes a ZERO partout avec 13 millions de paires « lien entierement dans le volume » :
       ;; les os du compagnon etaient restes a l'ORIGINE (il n'avait jamais ete rendu, donc son
       ;; do-joint-math! n'avait jamais tourne). Des zeros pris sur un squelette non pose ne
       ;; mesurent rien, et un tableau qui les publie est un faux vert. On refuse de mesurer.
       (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
         (when (and hd (= (-> hd type) jak-hd) (nonzero? (-> hd draw))
                    (nonzero? (-> hd draw skeleton)))
           (let* ((skel (-> hd draw skeleton))
                  (a (phys-chain-joint (-> self slot) 0 0))
                  (d (if (and (>= a 0) (< (+ a 1) (-> skel length)))
                       (vector-length (the-as vector (-> skel bones (+ a 1) transform vector 3)))
                       0.0)))
             (format 0 "PHYSPOSED joint0=~D dist-from-origin=~f~%" a d)
             (when (< d 1.0)
               (format 0 "PHYSFAIL reason=skeleton-not-posed-bones-at-origin~%")
               (set! (-> self phase) PHYSROOM-PH-DONE)))))
       (phys-auth-reset!)
       (phys-limiter-reset!)
       (phys-inversions-reset!)
       (phys-diag-reset!)
       (set! (-> self phase) PHYSROOM-PH-MEAS)
       (set! (-> self pframe) 0)
       (set! (-> self ai) 0)
       (set! (-> self drive) 0)
       (physroom-set-anim 0)
       (phys-stats-reset!)))

    ;; ---- 1. MESURE : toutes les animations x les quatre pilotages -----------------------------
    ((= (-> self phase) PHYSROOM-PH-MEAS)
     (if (>= (-> self drive) PHYSROOM-DRIVES)
       (physroom-hold)                                  ;; sous-fenetre de LIGNE DE BASE
       (physroom-drive (-> self drive) (-> self pframe)))
     (physroom-advance-anim 1.0)
     ;; AUCUNE FENETRE NE COMMENCE SUR UNE DISCONTINUITE (voir PHYSROOM-MEASAT). Les 54 premieres
     ;; frames absorbent le saut d'entree — changement d'animation, retour a la verticale, retour au
     ;; point de depart — et pour `tilt` elles contiennent en plus la rampe qui l'amene a 60 degres.
     ;; Meme regle pour les six sous-fenetres : les amplitudes restent comparables entre elles.
     (when (= (-> self pframe) PHYSROOM-MEASAT) (phys-stats-reset!))
     (when (>= (-> self pframe) PHYSROOM-WIN)
       (physroom-emit-window)
       (set! (-> self pframe) 0)
       (+! (-> self drive) 1)
       (when (>= (-> self drive) PHYSROOM-SUBW)
         (set! (-> self drive) 0)
         (+! (-> self ai) 1)
         (when (< (-> self ai) (-> self nanim)) (physroom-set-anim (-> self ai))))
       (cond
         ((>= (-> self ai) (-> self nanim))
          ;; le bilan par chaine de TOUTE la course de mesure, avant que les phases de controle
          ;; ne viennent s'y ajouter.
          (physroom-emit-diag "run")
          (phys-diag-reset!)
          (set! (-> self phase) PHYSROOM-PH-RESP)
          (set! (-> self lvl) 0)
          (physroom-set-anim 0)
          (phys-stats-reset!))
         (else
          (phys-stats-reset!)))))

    ;; ---- 2. LA COURBE DE REPONSE (6e passe : « trop statiques sur les mouvements faibles, trop
    ;; ---- hysteriques sur les brusques »). Meme animation figee, meme chaine, meme fenetre : la
    ;; ---- SEULE chose qui change d'un niveau au suivant est l'amplitude de l'excitation. Une
    ;; ---- marche dans la courbe designe un seuil ; une droite dit qu'il n'y en a pas.
    ((= (-> self phase) PHYSROOM-PH-RESP)
     (physroom-drive-exc (-> self pframe) (physroom-exc-level (-> self lvl)))
     ;; la premiere moitie du niveau est un ETABLISSEMENT, pas une mesure : sans elle le niveau 0
     ;; lisait la fin d'oscillation de la phase precedente (amplitude 0.62 m pour une excitation de
     ;; 1.5 u/frame^2, soit un gain de reference faux, donc une courbe fausse).
     (when (= (-> self pframe) (/ PHYSROOM-RESPW 2)) (phys-stats-reset!))
     (when (>= (-> self pframe) PHYSROOM-RESPW)
       (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
           (format 0 "PHYSRESP c=~D lvl=~D exc=~f amp=~f jump=~f~%"
                   c (-> self lvl) (physroom-exc-level (-> self lvl))
                   (phys-tip-amp (-> self slot) c)
                   (phys-stat (-> self slot) c 2))))
       (set! (-> self pframe) 0)
       (+! (-> self lvl) 1)
       (phys-stats-reset!)
       (when (>= (-> self lvl) PHYSROOM-RESPL)
         (set! (-> self phase) PHYSROOM-PH-IDLE))))

    ;; ---- 3. LE REPOS : immobile, animation figee. La cible de l'ecart ne bouge plus, donc au
    ;; ---- repos l'ecart a la pose du modele doit tendre vers zero (SPEC section 4), sauf pour ce
    ;; ---- qui doit pendre (hang > 0), compte a part.
    ((= (-> self phase) PHYSROOM-PH-IDLE)
     (physroom-hold)
     ;; frame-num CONSTANTE : la pose d'auteur est immobile, c'est ca « la pose du modele ».
     (when (= (-> self pframe) PHYSROOM-IDLES) (phys-stats-reset!))
     (when (>= (-> self pframe) (+ PHYSROOM-IDLES PHYSROOM-IDLEM))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSIDLE c=~D dev=~f hang=~f amp=~f fam=~D~%"
                 c
                 (phys-stat (-> self slot) c 5)
                 (phys-chain-hang (-> self slot) c)
                 (phys-tip-amp (-> self slot) c)
                 (phys-chain-family (-> self slot) c))))
       ;; la POSITION MOYENNE debout : c'est le terme `at0` de ROOM-GRAVSAG.
       (physroom-emit-mean "idle")
       (set! (-> self phase) PHYSROOM-PH-TILT)
       (set! (-> self pframe) 0)
       (phys-stats-reset!)))

    ;; ---- 4. ELLE SE PENCHE, ET ON TIENT LA POSE. Meme animation figee, meme chaine, meme duree
    ;; ---- que le repos : la SEULE difference est l'inclinaison du tronc. Une gravite exprimee dans
    ;; ---- le repere de l'ancre ne deplace rien quand elle est droite et agit des qu'elle penche,
    ;; ---- donc l'ecart a la pose du modele doit MONTER ici et nulle part ailleurs. C'est la mesure
    ;; ---- que reclame la 6e passe : « aucun mouvement quand elle se penche en avant pour souder ».
    ((= (-> self phase) PHYSROOM-PH-TILT)
     (physroom-lean PHYSROOM-TILTDEG)
     (when (= (-> self pframe) PHYSROOM-IDLES) (phys-stats-reset!))
     (when (>= (-> self pframe) (+ PHYSROOM-IDLES PHYSROOM-IDLEM))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSTILT c=~D deg=~f dev=~f amp=~f fam=~D~%"
                 c PHYSROOM-TILTDEG
                 (phys-stat (-> self slot) c 5)
                 (phys-tip-amp (-> self slot) c)
                 (phys-chain-family (-> self slot) c))))
       ;; la POSITION MOYENNE penchee a 60 degres : c'est le terme `at60` de ROOM-GRAVSAG, et
       ;; l'ecart avec `at0` EST la reponse a la gravite. Rien d'autre n'a change entre les deux
       ;; phases : meme animation figee, meme position, meme duree, meme amortissement — seule
       ;; l'orientation de l'ancre differe.
       (physroom-emit-mean "tilt")
       (set! (-> self phase) PHYSROOM-PH-PCOFF)
       (set! (-> self pframe) 0)
       (phys-inject-set! 0.0)
       (phys-inject-count-reset!)
       (phys-stats-reset!)))

    ;; ---- 5. CONTROLE POSITIF, branche DESARMEE : la penetration telle qu'elle est ------------
    ((= (-> self phase) PHYSROOM-PH-PCOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self dis) (physroom-max-pen))
       (set! (-> self phase) PHYSROOM-PH-PCON)
       (set! (-> self pframe) 0)
       (phys-inject-count-reset!)
       (phys-stats-reset!)
       ;; on POSE le defaut : chaque lien libre est pousse de 400 unites (~10 cm) vers l'interieur
       ;; du corps APRES resolution. Si le compteur de penetration ne monte pas, il ne mesure rien.
       (phys-inject-set! 400.0)))

    ;; ---- 6. CONTROLE POSITIF, branche ARMEE --------------------------------------------------
    ((= (-> self phase) PHYSROOM-PH-PCON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self arm) (physroom-max-pen))
       (set! (-> self injn) (phys-inject-count))
       (phys-inject-set! 0.0)
       (set! (-> self phase) PHYSROOM-PH-AUTHPC)
       (set! (-> self pframe) 0)))

    ;; ---- 7. L'ANIMATION D'AUTEUR (SPEC 5) : d'abord le bilan de la course, ensuite un CONTROLE
    ;; ---- POSITIF. Le controle retarde l'animation d'une frame dans la position ecrite — le defaut
    ;; ---- exact que la SPEC interdit — et le compteur d'identite doit s'effondrer. Un compteur qui
    ;; ---- ne bouge pas sous le defaut ne mesure rien, et le zero qu'il annonce ne vaut rien.
    ((= (-> self phase) PHYSROOM-PH-AUTHPC)
     (when (= (-> self pframe) 1)
       (format 0 "PHYSLIM retreat_n=~f retreat_sum=~f raddrop_n=~f raddrop_sum=~f buried=~f~%"
               (phys-limiter 0) (phys-limiter 1) (phys-limiter 2) (phys-limiter 3)
               (phys-limiter 4))
       ;; REPLIS DU RECUL : chacun laisse un residu d'allongement sur son lien. Publie a part parce
       ;; que c'est le seul chemin qui reste vers un allongement non nul.
       (format 0 "PHYSLIM2 retreat_fallback=~f~%" (phys-limiter 5))
       ;; CETTE LIGNE PUBLIAIT UN CHIFFRE QUI N'EXISTE PAS DANS LE MOTEUR. Elle lisait
       ;; `(phys-limiter 6)` et `(phys-limiter 7)` sous les noms `radial_n` / `radial_sum` ; il n'y a
       ;; AUCUN compteur radial dans jak-hd-physics.gc, ces deux index tombent donc dans la branche
       ;; `else` et rendaient tous les deux `*phys-buried-n*`. La course du 2026-08-12 le dit au
       ;; chiffre pres :
       ;;     PHYSLIM  buried=987636       PHYSLIM3  radial_n=987636  radial_sum=987636
       ;; et le tableau en tirait « part radiale de la force, ecartee : 987623 fois, 987623.0000
       ;; u/frame^2 au total soit 1.0000 par declenchement ». Un ratio de 1.0000 etait la signature :
       ;; c'etait le meme compteur divise par lui-meme. Trois etiquettes pour une seule grandeur,
       ;; dont deux fausses.
       ;;
       ;; A SA PLACE, LE BALAYAGE DE SPHERE DU RECUL — un vrai compteur, et le pendant exact de
       ;; `retreat_fallback` : meme evenement declencheur (le point de depart du modele penetre),
       ;; l'un compte les sauvetages, l'autre les renoncements. NATURE : un compte d'evenements sur
       ;; la course. REPERE : sans objet (ce n'est pas une grandeur geometrique). LECTURE QUAND LE
       ;; DEFAUT EST ABSENT : zero des deux cotes — la pose du modele est admissible et l'arc suffit.
       (format 0 "PHYSLIM3 sphere_n=~f~%" (phys-limiter 8))
       ;; QUEL VOLUME CONTRAINT QUELLE CHAINE, sur toute la course. Une ligne par paire non nulle :
       ;; c'est la question que trois cycles ont posee sans instrument (« lbang est en contact
       ;; 17893 frames sur 17893 avec un AUTRE volume, non identifie »). Le nom du volume est deja
       ;; publie par `PHYSCOL ci= j= j2=`, on n'imprime donc que l'index et le compte.
       (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
           (dotimes (ci (phys-slot-colliders (-> self slot)))
             (let ((n (phys-chain-vol (-> self slot) c ci)))
               (when (> n 0)
                 (format 0 "PHYSCVOL c=~D ci=~D n=~D~%" c ci n))))))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSAUTH c=~D hit=~f ok=~f dot=~f nrm=~f dsum=~f~%"
                 c
                 (phys-auth (-> self slot) c 0)
                 (phys-auth (-> self slot) c 1)
                 (phys-auth (-> self slot) c 2)
                 (phys-auth (-> self slot) c 3)
                 (phys-auth (-> self slot) c 4))
         (format 0 "PHYSAUTH2 c=~D usum=~f tmov=~f contact=~f fam=~D~%"
                 c (phys-auth (-> self slot) c 5) (phys-auth (-> self slot) c 6)
                 (phys-auth (-> self slot) c 7)
                 (phys-chain-family (-> self slot) c))))
       (phys-auth-reset!)
       (phys-auth-lag-set! 1))
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (phys-auth-lag-set! 0)
       (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
           (format 0 "PHYSAUTHPC c=~D hit=~f ok=~f~%"
                   c (phys-auth (-> self slot) c 0) (phys-auth (-> self slot) c 1))))
       (set! (-> self phase) PHYSROOM-PH-INVPC)
       (set! (-> self pframe) 0)))

    ;; ---- 8. LES INVERSIONS (verdict owner : « un de ses seins retourne vers l'interieur »).
    ;; ---- D'abord le compte de la course, puis un CONTROLE POSITIF qui miroite chaque lien libre a
    ;; ---- travers son attache : le compteur doit monter. Un compteur d'inversions a zero qui ne
    ;; ---- bouge pas sous le defaut ne prouve rien.
    ((= (-> self phase) PHYSROOM-PH-INVPC)
     (when (= (-> self pframe) 1)
       ;; `reseatfb` = re-assises retombees sur l'ancienne heuristique (rayon le long de l'os du
       ;; porteur) au lieu de la place que le rig donne. Doit valoir ZERO : c'est cette heuristique
       ;; qui posait le pan du pantacourt a 429 u du genou la ou le rig le met a 1349.
       (format 0 "PHYSRESEAT n=~f fallback=~f~%" (phys-inversions 2) (phys-inversions 4))
       (format 0 "PHYSINV phase=run flips=~f degen=~f reseat=~f residual=~f~%"
               (phys-inversions 0) (phys-inversions 1) (phys-inversions 2) (phys-inversions 3))
       (phys-inversions-reset!)
       (phys-inv-inject-set! 1))
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (phys-inv-inject-set! 0)
       (format 0 "PHYSINV phase=control flips=~f degen=~f reseat=~f residual=~f~%"
               (phys-inversions 0) (phys-inversions 1) (phys-inversions 2) (phys-inversions 3))
       (set! (-> self phase) PHYSROOM-PH-SELFOFF)
       (set! (-> self pframe) 0)
       (phys-diag-reset!)))

    ;; ---- 8/9. L'AUTO-COLLISION (6e passe, defaut 1 : « les meches fines jittent like crazy des
    ;; ---- que la tete bouge »). Les colliders `Lbanga`, `Lmidhaira`, `lBoob` sont les JOINTS-RACINES
    ;; ---- des chaines elles-memes et les capsules `Lbangb->Lbanga` sont leurs MAILLONS : sans
    ;; ---- exclusion, une meche est poussee hors de son propre volume en permanence. L'exclusion est
    ;; ---- structurelle, donc le compteur est structurellement nul — et un zero que rien ne peut
    ;; ---- faire monter ne prouve rien. La branche ARMEE leve l'exclusion : il DOIT monter.
    ((= (-> self phase) PHYSROOM-PH-SELFOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (physroom-emit-diag "self-disarmed")
       (phys-diag-reset!)
       (phys-self-inject-set! 1)
       (set! (-> self phase) PHYSROOM-PH-SELFON)
       (set! (-> self pframe) 0)))

    ((= (-> self phase) PHYSROOM-PH-SELFON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (physroom-emit-diag "self-armed")
       (phys-self-inject-set! 0)
       (phys-diag-reset!)
       (set! (-> self ai) 0)
       (physroom-set-anim 0)
       (set! (-> self phase) PHYSROOM-PH-SIDEOFF)
       (set! (-> self pframe) 0)))

    ;; ---- 9bis. CONTROLE POSITIF DE LA CONTRAINTE DE COTE, DEUX BRANCHES A EXPOSITION EGALE.
    ;; ---- `side` est tombe de 11446 a 0 quand la contrainte est arrivee ; un compteur qui
    ;; ---- s'effondre est soit une correction, soit un predicat devenu inevaluable. La branche
    ;; ---- DESARMEE (contrainte en place) et la branche ARMEE (contrainte levee, rien d'autre)
    ;; ---- jouent TOUTES LES ANIMATIONS, PHYSROOM-PCW frames chacune, meme pilotage : c'est la
    ;; ---- seule facon de comparer deux comptes, et c'est ce qui manquait quand les deux
    ;; ---- rendaient zero (la fenetre de 90 frames sur l'animation 0 ne joue simplement pas les
    ;; ---- animations ou les lunettes traversent le buste).
    ((= (-> self phase) PHYSROOM-PH-SIDEOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (physroom-emit-diag "side-disarmed")
          (phys-diag-reset!)
          (phys-side-off-set! 1)
          (set! (-> self ai) 0)
          (physroom-set-anim 0)
          (set! (-> self phase) PHYSROOM-PH-SIDEON)))))

    ((= (-> self phase) PHYSROOM-PH-SIDEON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (physroom-emit-diag "side-armed")
          (phys-side-off-set! 0)
          (phys-diag-reset!)
          (phys-shell-reset!)
          (set! (-> self phase) PHYSROOM-PH-SHELLOFF)))))

    ;; ---- 9ter. CONTROLE POSITIF DU FOURREAU (`pant-calf`). Le pan de pantacourt est une COQUE
    ;; ---- autour du mollet : le pousser « dehors » l'ejecte lateralement de ~700 u et enfonce la
    ;; ---- moitie du tissu dans la jambe. La contrainte est desormais la CONCENTRICITE, et son
    ;; ---- residu doit valoir zero. DESARMEE d'abord (contrainte en place), ARMEE ensuite
    ;; ---- (`phys-shell-off-set! 1` rend au pan sa sphere de poussee) : le compteur DOIT monter.
    ((= (-> self phase) PHYSROOM-PH-SHELLOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (format 0 "PHYSSHELL tag=shell-disarmed corrections=~f~%" (phys-shell-count))
       ;; l'ecart radial par chaine sort dans PHYSDIAG5 ci-dessous : c'est LUI qui doit monter
       ;; quand le controle est arme. `corrections` ne le peut pas -- armee, la contrainte ne
       ;; tourne plus, donc son compteur tombe a zero. Les deux sont publies, jamais confondus.
       (physroom-emit-diag "shell-disarmed")
       (phys-diag-reset!)
       (phys-shell-reset!)
       (phys-shell-off-set! 1)
       (set! (-> self phase) PHYSROOM-PH-SHELLON)
       (set! (-> self pframe) 0)))

    ((= (-> self phase) PHYSROOM-PH-SHELLON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (format 0 "PHYSSHELL tag=shell-armed corrections=~f~%" (phys-shell-count))
       (physroom-emit-diag "shell-armed")
       (phys-shell-off-set! 0)
       (set! (-> self phase) PHYSROOM-PH-REPORT)
       (set! (-> self pframe) 0)))

    ;; ---- 10. RAPPORT --------------------------------------------------------------------------
    ((= (-> self phase) PHYSROOM-PH-REPORT)
     (physroom-report)
     (set! (-> self phase) PHYSROOM-PH-DONE)
     (set! (-> self pframe) 0))

    (else
     (physroom-hold)))
  (none))

(defstate phys-subject-run (phys-subject)
  :code (behavior () (loop (suspend)))
  :trans (behavior () (physroom-tick))
  :post (behavior () (ja-post)))

;; ------------------------------------------------------------------------------------------------
;; UN ART-GROUP DE KEIRA, PAR NOM. Deux sources, dans cet ordre, et la source utilisee est publiee :
;;
;;   1. DEJA RESIDENT dans le repertoire d'art d'un niveau charge. C'est le cas sur le DEVICE, ou la
;;      salle s'ouvre depuis une partie vivante : `assistant` est deja dans le repertoire de
;;      village1. Il faut alors le re-declarer dans celui de level-default, parce que c'est la que
;;      initialize-skeleton va le chercher pour un sujet sans entite (process-drawable.gc:343).
;;   2. CHARGE depuis un .go isole (`loado`), le cas x86 ou la salle part de l'ecran titre et ou
;;      aucun niveau n'est charge.
;;
;; Mesure du 2026-08-11 qui a impose ce chemin : sur le device, `files/out/jak1/obj/assistant-ag.go`
;; n'existe pas (seul le jeu de CGO/DGO y est extrait), `loado` a echoue — et le test de nullite
;; etait FAUX : `loado` rend le SYMBOLE #f, dont l'offset n'est pas zero, donc
;; `(nonzero? (the-as int ag))` etait VRAI et la salle continuait sur un art-group inexistant au lieu
;; d'echouer bruyamment. C'est le piege s7 : la nullite d'un basic se teste contre #f, pas contre 0
;; (et 0 est truthy, donc il faut LES DEUX tests).
;; ------------------------------------------------------------------------------------------------
(defun physroom-load-ag ((name string))
  ;; `art-group-get-by-name` est la methode du jeu lui-meme (level.gc:892) : elle balaie les trois
  ;; emplacements de niveau (level0, level1, level-default) et compare le nom que l'art-group porte.
  ;; On ne reimplemente pas la recherche, on appelle celle qui fait foi.
  (let ((res (art-group-get-by-name *level* name)))
    (cond
      ((and res (nonzero? (the-as int res)))
       ;; deja en memoire : on le re-declare dans level-default et on ne recharge rien
       (set-loaded-art (-> *level* level-default art-group) res)
       (format 0 "PHYSAG name=~S source=resident~%" name)
       res)
      (else
       (let ((ag (the-as art-group (loado (make-file-name (file-kind art-group) name 6 #f) global))))
         (cond
           ((and ag (nonzero? (the-as int ag)) (type-type? (-> ag type) art-group))
            (login ag)
            (set-loaded-art (-> *level* level-default art-group) ag)
            (format 0 "PHYSAG name=~S source=loado~%" name)
            ag)
           (else
            (format 0 "PHYSAGFAIL name=~S~%" name)
            (the-as art-group #f))))))))

;; ------------------------------------------------------------------------------------------------
;; NAISSANCE DU SUJET
;; ------------------------------------------------------------------------------------------------
(defbehavior init-phys-subject phys-subject ()
  (set! (-> self phase) PHYSROOM-PH-SETTLE)
  (set! (-> self pframe) 0)
  (set! (-> self ai) 0)
  (set! (-> self drive) 0)
  (set! (-> self slot) -1)
  (set! (-> self nchain) 0)
  (set! (-> self viol) 0)
  (set! (-> self nactor) 0)
  (set! (-> self killed) 0)
  (set! (-> self nanim) 0)
  (set! (-> self nenum) 0)
  (set! (-> self nag) 0)
  (set! (-> self dis) 0.0)
  (set! (-> self arm) 0.0)
  (set! (-> self injn) 0)
  (set! (-> self lvl) 0)
  (set! (-> self fnum) 0.0)
  (set! (-> self adir) 1.0)
  (set! (-> self aspeed) 1.0)
  (set! (-> self wraps) 0)
  (set! (-> self nframe) 1.0)
  (set! (-> self root) (new 'process 'trsqv))
  (vector-identity! (-> self root scale))
  (quaternion-identity! (-> self root quat))
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (position-in-front-of-camera! (-> self root trans) 40960.0 4096.0)
  (vector-copy! (-> self home) (-> self root trans))
  ;; l'art-group du sujet, charge PAR NOM et sans niveau, puis le squelette dessus.
  (let ((ag0 (physroom-load-ag (-> *physroom-ag-names* 0))))
    (cond
      ((and ag0 (nonzero? (the-as int ag0)))
       (+! (-> self nag) 1)
       (initialize-skeleton self *phys-subject-sg* '())
       (logclear! (-> self draw status) (draw-status no-skeleton-update))
       (let ((njoint (if (nonzero? (-> self draw jgeo)) (-> self draw jgeo length) -1)))
         (format 0 "PHYSSUBJECT ag=~S elems=~D bones=~D joints=~D mgeo=~S~%"
                 (-> ag0 name)
                 (-> ag0 length)
                 (if (nonzero? (-> self draw skeleton)) (-> self draw skeleton length) -1)
                 njoint
                 (if (nonzero? (-> self draw mgeo)) (-> self draw mgeo name) "?"))
         ;; LA TABLE DES ANIMATIONS : les SIX art-groups de Keira. Une animation n'est retenue que
         ;; si son nombre de joints est celui du rig du sujet ; sinon elle est publiee REFUSEE.
         (dotimes (g (-> *physroom-ag-names* length))
           (let ((ag (if (zero? g) ag0 (physroom-load-ag (-> *physroom-ag-names* g)))))
             (when (and ag (nonzero? (the-as int ag)))
               (when (nonzero? g) (+! (-> self nag) 1))
               (dotimes (i (-> ag length))
                 (let ((e (-> ag data i)))
                   (when (and (nonzero? (the-as int e)) (= (-> e type) art-joint-anim))
                     (+! (-> self nenum) 1)
                     ;; TOUTES LES ANIMATIONS, Y COMPRIS CELLES DES VARIANTES (owner 2026-08-11
                     ;; 16:15 : « faut tester vraiment toutes les animations qu'utilise le perso
                     ;; tout au long du jeu, pas quelques unes ! »).
                     ;;
                     ;; Les 13 ecartees vivent sur les art-groups de Fire Canyon et des Lava Tubes,
                     ;; dont le rig porte 94 joints la ou celui du village 1 en porte 96. L'ancienne
                     ;; regle `(= nj njoint)` les refusait — un de-scope avec une raison ecrite
                     ;; a cote, ce qui n'est pas une couverture.
                     ;;
                     ;; Pourquoi les jouer sur CE rig est correct, et non un contournement : le
                     ;; nombre de joints ecrits est porte par le bloc compresse de l'ANIMATION
                     ;; (`frame-group frames`, joint.gc:940-955), pas par le squelette. Une
                     ;; animation a 94 joints en pilote 94 ; les joints 94 et 95, qui n'existent que
                     ;; sur le rig du village 1, gardent leur pose precedente. La salle publie donc
                     ;; le compte de chaque animation (`joints=`) ET la liste des joints propres au
                     ;; rig porteur, pour que personne n'ait a supposer lesquels ne sont pas pilotes.
                     ;; Si un de ces joints portait une chaine, la mesure le dirait : le compteur
                     ;; d'ancrage `rootdev` de cette chaine partirait, et la gate ROOT le refuserait.
                     (let ((nj (-> e length)))
                       (cond
                         ((< (-> self nanim) PHYSROOM-MAXANIM)
                          (set! (-> *physroom-anim-ag* (-> self nanim)) ag)
                          (set! (-> *physroom-anim-ix* (-> self nanim)) i)
                          (format 0 "PHYSANIM a=~D ag=~S name=~S joints=~D~%"
                                  (-> self nanim) (-> ag name) (-> e name) nj)
                          (when (!= nj njoint)
                            (format 0 "PHYSANIMRIG ag=~S name=~S joints=~D porteur=~D~%"
                                    (-> ag name) (-> e name) nj njoint))
                          (+! (-> self nanim) 1))
                         (else
                          (format 0 "PHYSANIMSKIP ag=~S name=~S joints=~D want=~D~%"
                                  (-> ag name) (-> e name) nj njoint))))))))))
         (format 0 "PHYSANIMS accepted=~D enumerated=~D ags=~D~%"
                 (-> self nanim) (-> self nenum) (-> self nag))
         ;; QUI PEUT PORTER LA PHYSIQUE : la physique de Keira vit sur son compagnon HD, et le
         ;; compagnon ne se greffe que sur un acteur dont le nom de merc est mappe. On ne le
         ;; suppose pas en lisant le source : on appelle la fonction que le jeu appelle, pour les
         ;; six mgeo de Keira, et on publie sa reponse. entry=-1 = aucun compagnon, donc aucune
         ;; chaine, donc rien a mesurer sur ce rig-la.
         (#when FLAG_HD_MODELS
           (dotimes (g (-> *physroom-mgeo-names* length))
             (format 0 "PHYSMGEO ag=~S mgeo=~S entry=~D~%"
                     (-> *physroom-ag-names* g)
                     (-> *physroom-mgeo-names* g)
                     (hd-desired-entry-for-mgeo (-> *physroom-mgeo-names* g))))))
       (cond
         ((> (-> self nanim) 0)
          (physroom-set-anim 0)
          (go phys-subject-run))
         (else
          (format 0 "PHYSFAIL reason=no-playable-animation~%")
          (deactivate self))))
      (else
       (format 0 "PHYSFAIL reason=art-group-assistant-not-loadable~%")
       (deactivate self))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; L'ENTREE. Appelee depuis C++ (kmachine.cpp, env OG_PHYS_ROOM) via *listener-function*, donc avec
;; un `pp` valide. Trois gestes, dans cet ordre : tuer le joueur, couper la naissance d'entites,
;; spawner le sujet.
;; ------------------------------------------------------------------------------------------------
(defun phys-room-start ()
  (format 0 "PHYSROOM-START target-before=~A~%" *target*)
  (stop 'debug)                     ;; logic-target.gc:1268 — kill-by-name 'target + *target* = #f
  (set! *spawn-actors* #f)          ;; entity.gc:1029 — plus aucune entite ne nait
  (set! (-> *pc-settings* recharged-enhanced-models?) #t)
  (set! (-> *pc-settings* hd-look-keira) 1)   ;; 1 = keira-hd (entry 2)
  (set! (-> *pc-settings* physics?) #t)
  (#when FLAG_HD_MODELS (pc-set-recharged-enhanced-models! 1))
  (pc-set-physics! 1 (-> *pc-settings* physics-quality))
  (set! *physroom-proc*
        (the-as (pointer phys-subject)
                (process-spawn phys-subject :init init-phys-subject :from *pc-dead-pool* :to *default-pool*)))
  (format 0 "PHYSROOM-START target-after=~A spawned=~D~%" *target* (if (nonzero? (the-as int *physroom-proc*)) 1 0))
  (none))

)
