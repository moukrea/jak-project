;;-*-Lisp-*-
(in-package goal)

;; phys-room.gc — LA SALLE DE TEST DE KEIRA, SANS JOUEUR (SPEC-keira-physique.md section 6).
;;
;; C'est l'ETAPE 1 du contrat, avant toute physique : sans elle il n'y a pas de mesure, et sans
;; mesure il n'y a rien a dire. Ce que l'owner a demande, mot pour mot :
;;
;;   « il serait bon d'avoir une test room dans laquelle ON NE SPAWN PAS LE PLAYER mais le
;;     personnage a tester, qu'on deplace in game de haut en bas, de gauche a droite, avec
;;     diverses accelerations, a coups, animations (toutes celles concernant ledit PNJ) »
;;
;; La tentative precedente mesurait dans une partie normale a village1-hut avec Jak jouable a
;; l'ecran ; l'owner l'a vu. Ici :
;;
;;   * `phys-room-start` appelle `(stop 'debug)` (logic-target.gc:1268) qui TUE le target et remet
;;     *target* a #f, puis coupe la naissance d'entites (*spawn-actors*). A CHAQUE FRAME de mesure
;;     la salle recompte les target vivants ; le compteur `viol` est publie tel quel. Le tableau ne
;;     peut declarer « joueur absent » que si ce compteur vaut zero — REGLE 0 : la ligne du tableau
;;     est ecrite par le script depuis la trace, pas par une promesse dans ce commentaire.
;;   * le sujet est spawne PAR NOM : l'art-group `assistant` (la Keira stock de jak1) est charge a
;;     la main (loado -> login -> set-loaded-art), exactement comme jak-hd.gc:691-701 charge le
;;     sien. AUCUN NIVEAU N'EST CHARGE : le squelette vit sur level-default. La zone contient le
;;     sujet, sa peau HD, et la camera.
;;   * le compagnon HD `keira-hd` se greffe tout seul (maybe-spawn-jak-hd!, jak-hd.gc:794) parce
;;     que le mgeo du sujet s'appelle `assistant-lod0` — le seul nom que hd-char-for-mgeo mappe
;;     sur Keira (jak-hd.gc:294-297). C'est LUI qui porte les chaines : le rig HD a des os
;;     (Rbanga, Lmidhaira, mask...) que le rig stock n'a pas.
;;   * le sujet est DEPLACE par integration d'une acceleration imposee : haut/bas, gauche/droite,
;;     accelerations croissantes, et a-coups (vitesse posee d'un coup, arrets brutaux).
;;   * TOUTES LES ANIMATIONS DE KEIRA sont jouees — pas seulement celles de l'art-group du sujet.
;;     Keira existe dans le jeu sous six art-groups (`assistant` au village 1, plus les variantes
;;     village2/village3/firecanyon/lavatube-start/lavatube-end) : « toutes celles concernant ledit
;;     PNJ » les prend toutes. Chacune est jouee sur le squelette du sujet apres verification que
;;     son nombre de joints correspond ; celles qui ne correspondent pas sont publiees comme
;;     REFUSEES avec leur compte, jamais ecartees en silence.
;;
;; Ce fichier ne calcule AUCUNE physique et n'invente AUCUN instrument : il fenetre, il lit les
;; accumulateurs de jak-hd-physics.gc (qui sont remplis la ou la position ecrite est connue), et
;; il imprime. Les lignes brutes commencent toutes par PHYS* et sont converties en tableau par
;; .autoport/physics_room_table.py.

(#when FLAG_PHYSICS

;; ------------------------------------------------------------------------------------------------
;; le sujet. `assistant` = le nom jak1 de Keira ; `assistant-lod0` est le mgeo que le compagnon HD
;; reconnait. :texture-level 2 fait passer initialize-skeleton par *level* level-default
;; (process-drawable.gc:343) : pas d'entite, pas de niveau.
;; ------------------------------------------------------------------------------------------------
(defskelgroup *phys-subject-sg* assistant
  assistant-lod0-jg
  assistant-idle-leaning-right-ja
  ((assistant-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 2)
  :texture-level 2)

;; les six art-groups de Keira dans jak1. `assistant` est celui du sujet (il porte le jgeo et le
;; mgeo) ; les cinq autres n'apportent que leurs animations.
(define *physroom-ag-names* (new 'static 'boxed-array :type string
  "assistant"
  "assistant-village2"
  "assistant-village3"
  "assistant-firecanyon"
  "assistant-lavatube-start"
  "assistant-lavatube-end"))

;; les mgeo (noms de merc) que ces six art-groups portent. Ce n'est pas de la decoration : c'est le
;; nom sur lequel le jeu decide si un compagnon HD se greffe (hd-desired-entry-for-mgeo), donc si la
;; physique peut exister. La salle appelle cette fonction pour les six et publie sa reponse.
(define *physroom-mgeo-names* (new 'static 'boxed-array :type string
  "assistant-lod0"
  "assistant-village2-lod0"
  "assistant-village3-lod0"
  "assistant-firecanyon-lod0"
  "assistant-lavatube-start-lod0"
  "assistant-lavatube-end-lod0"))

(defconstant PHYSROOM-MAXANIM 48)   ;; capacite de la table d'animations
;; updown / leftright / accel / jerk / TILT. Le cinquieme est arrive avec la 6e passe de l'owner :
;; « les seins n'ont pas l'air d'etre soumis a la gravite, aucun mouvement quand elle se penche en
;; avant pour souder ». Les quatre premiers TRANSLATENT le sujet, donc ils ne changent jamais
;; l'orientation de l'ancre, donc ils ne peuvent PAS voir une gravite exprimee dans le repere de
;; l'ancre. Il fallait un pilotage qui l'INCLINE.
(defconstant PHYSROOM-DRIVES  5)
;; SOUS-FENETRES par animation : les cinq pilotages, PLUS une fenetre SANS AUCUN PILOTAGE. Cette
;; derniere est la LIGNE DE BASE que reclame le superviseur (2026-08-11 16:15) : « publier la valeur
;; sous animation seule comme ligne de base a soustraire ; un pilotage dont la reponse ne depasse pas
;; la ligne de base n'a rien excite ». Sans elle, une amplitude par pilotage melange ce que le
;; pilotage a provoque et ce que l'animation faisait de toute facon, et on ne peut pas les separer.
(defconstant PHYSROOM-SUBW    6)
(defconstant PHYSROOM-WIN     90)   ;; frames par fenetre de mesure (6 segments de pilotage)
;; L'INCLINAISON EST UNE POSE TENUE, PAS UNE SECOUSSE DE PLUS. Elle monte a 60 degres sur les 24
;; premieres frames (rampe en demi-cosinus : depart et arrivee a vitesse nulle, donc aucun a-coup
;; parasite), puis NE BOUGE PLUS.
(defconstant PHYSROOM-TILTRAMP 24)
;; PERIODE des trois pilotages continus, et le carre de sa pulsation. Une trajectoire A sin(w f) a
;; une acceleration de module EXACTEMENT A w^2 : c'est ce qui permet de commander une acceleration
;; au lieu de l'esperer. 36 frames = un cycle complet dans les 36 frames effectivement mesurees.
;; w = 2 pi / 36 = 0.174533 rad/frame, w^2 = 0.0304617.
(defconstant PHYSROOM-PERIOD  36)
(defconstant PHYSROOM-W2      0.0304617)
;; UNE FENETRE DE MESURE NE COMMENCE JAMAIS SUR UNE DISCONTINUITE — et c'est la seconde moitie de
;; la cause racine de l'echec « DISCRIMINANT ».
;;
;; Ce que la salle faisait, mesure par le compteur `acc` (pire acceleration de la pose d'auteur
;; REELLEMENT recue par la pointe, en u/frame^2) sur la course du 2026-08-11 :
;;
;;     pilotage        updown  leftright  accel   jerk   tilt   AUCUN (ligne de base)
;;     acc recu         38964      2555    2570   2569   2543          32991
;;     acc COMMANDE        18        52      96    434  11.16              0
;;
;; Une ligne de base SANS AUCUN PILOTAGE recevait 32991 u/frame^2, soit 76 fois le plus violent des
;; pilotages. Le chiffre ne venait pas de la physique : il venait de la salle. Chaque sous-fenetre
;; s'ouvrait sur une TELEPORTATION du squelette entier, et le compteur repartait de zero juste a
;; temps pour la compter :
;;   * changement d'animation (avant `updown`) : `frame-num` et l'art-group changent d'un coup ;
;;   * retour a la verticale (avant la ligne de base) : `physroom-hold` repose le quaternion a
;;     l'identite, donc 60 degres rendus en UNE frame apres le pilotage `tilt` ;
;;   * retour au point de depart (avant `tilt`) : jusqu'a 3 m rendus en une frame apres `jerk`.
;; La chaine repondait a ce coup-la, pas au pilotage, et elle y repondait PAREIL sous les cinq :
;; c'est exactement « la mesure ne mesure pas le stimulus ».
;;
;; La mesure demarre donc a la frame 54 de chaque sous-fenetre, identique pour les six, et les 36
;; dernieres frames sont les seules comptees. 54 frames de decroissance avec l'amortissement le plus
;; faible du fichier (0.24) laissent 0.76^54 = 6e-8 du transitoire. Ce n'est pas un filtre : rien
;; n'est retire au signal, on a seulement cesse de mesurer pendant que l'instrument frappait le
;; sujet. Les fenetres restent egales entre elles, donc les amplitudes restent comparables.
(defconstant PHYSROOM-MEASAT  54)
(defconstant PHYSROOM-SETTLE  120)  ;; frames d'amorcage avant la premiere mesure
(defconstant PHYSROOM-IDLES   150)  ;; frames de calme AVANT de mesurer le repos
(defconstant PHYSROOM-IDLEM   120)  ;; frames de mesure du repos
(defconstant PHYSROOM-PCW     90)   ;; frames par branche du controle positif
(defconstant PHYSROOM-LIMIT   12288.0) ;; +/- 3 m autour du point de depart
;; COURBE DE REPONSE (6e passe : « les grosses meches sont trop statiques sur les mouvements
;; faibles, trop hysteriques sur les mouvements brusques »). Une reponse non lineaire, c'est un
;; seuil ; on mesure donc l'amplitude de pointe en fonction de l'amplitude d'EXCITATION, sur une
;; echelle geometrique. Une marche dans la courbe designe le seuil coupable.
(defconstant PHYSROOM-RESPL   6)    ;; niveaux d'excitation
(defconstant PHYSROOM-RESPW   72)   ;; frames par niveau
;; INCLINAISON STATIQUE : elle se penche, et on tient la pose. L'excitation d'acceleration retombe
;; a zero, donc ce qui reste dans l'ecart a la pose du modele n'est plus que la gravite.
(defconstant PHYSROOM-TILTDEG 60.0)

;; phases
(defconstant PHYSROOM-PH-SETTLE 0)
(defconstant PHYSROOM-PH-MEAS   1)
(defconstant PHYSROOM-PH-RESP   2)
(defconstant PHYSROOM-PH-IDLE   3)
(defconstant PHYSROOM-PH-TILT   4)
;; LE RETOUR — la seconde moitie de l'aller-retour (defaut `hair-hysteresis`, owner 2026-08-13
;; 21:30 : « beaucoup d'hysteresis pour tous les cheveux […] j'ai envie de la desactiver parce que
;; c'est horrible ! »).
;;
;; NATURE : un DEPLACEMENT SOUTENU RESIDUEL apres un cycle FERME. Ce n'est ni une amplitude ni une
;;   forme : l'hysteresis est le fait que la meme entree ne rende pas la meme sortie selon le chemin
;;   parcouru pour y arriver. La seule facon de la lire est donc de revenir EXACTEMENT au point de
;;   depart et de comparer les deux poses etablies. Une variance, une amplitude de pointe ou une
;;   duree de ballottement ne peuvent structurellement pas la voir — elles ne regardent qu'une
;;   extremite du chemin.
;; REPERE : celui de l'ANCRE, herite de `phys-tip-mean` (jak-hd-physics.gc:4455). Jamais le monde :
;;   le sujet est ramene a `home` a chaque frame, mais une pointe qui suit son parent afficherait le
;;   chiffre de son parent — c'est la faute de la 10e passe, deja payee.
;; LECTURE QUAND LE DEFAUT EST ABSENT : ZERO. Un systeme purement dissipatif (ressort + amortisseur
;;   + gravite, sans terme a memoire) revient au MEME equilibre des lors que l'inclinaison qui le
;;   definit est revenue a la meme valeur et qu'on lui a laisse le meme temps pour s'etablir.
;;   Un ecart non nul EST l'hysteresis, et il n'a pas d'autre explication.
;;
;; POURQUOI CETTE PHASE EST LA COPIE CONFORME DE PHYSROOM-PH-IDLE, ET PAS UNE PHASE NEUVE : la
;; comparaison n'a de sens que si les deux poses sont etablies dans des conditions IDENTIQUES. Meme
;; appel (`physroom-hold`), meme etablissement (PHYSROOM-IDLES), meme fenetre de mesure
;; (PHYSROOM-IDLEM), meme emetteur (`physroom-emit-mean`). La SEULE difference entre `idle` et
;; `back` est le chemin parcouru entre les deux : 0 deg -> 60 deg -> 0 deg. Tout le reste est egal,
;; donc tout ecart s'impute au chemin. C'est aussi pourquoi l'aller et le retour sont deux sauts
;; d'une frame de meme amplitude et de signe oppose : le cycle est ferme.
;;
;; AUCUN OPERATEUR N'EST AJOUTE AU SOLVEUR (DIRECTIVES 21:30 : « on arrete d'ajouter »). Cette phase
;; est de l'INSTRUMENT : elle rejoue une phase existante et reutilise un emetteur existant.
(defconstant PHYSROOM-PH-BACK   5)
;; LE CYCLE FERME DANS LE REGIME OU LE DEFAUT VIT, ET SON CONTROLE POSITIF.
;;
;; POURQUOI CES QUATRE PHASES EXISTENT. Le cycle `tilt` (PHYSROOM-PH-BACK) est QUASI-STATIQUE : elle
;; se penche lentement et tient la pose. Il a rendu un ecart de retour <= 1,75 % de l'excursion —
;; et ce zero-la ne prouve RIEN, pour deux raisons ecrites dans le contrat : aucun controle positif
;; n'avait tire, et le stimulus n'exerce pas les termes a memoire du solveur (recul, reflexion de
;; cote, attenuation), qui ne se declenchent que sur du mouvement RAPIDE. Les compteurs le disent :
;; `lmidhair` encaisse 10 421 reculs sur la phase d'animations et quasiment aucun pendant la tenue.
;; L'owner, lui, regarde des animations de jeu. Mesurer l'hysteresis dans un regime ou ses causes
;; ne tirent pas, c'est la classe `stimulus-must-be-representative`.
;;
;; LE CYCLE : on SECOUE (`jerk`, la meme commande que le controle positif de penetration), puis on
;; relache et on tient la pose. L'etat COMMANDE au depart et a l'arrivee est le meme — `home`,
;; quaternion identite, animation figee sur la meme frame — exactement comme `back`. Un systeme sans
;; memoire revient donc a la meme pose ; l'ecart EST l'hysteresis, cette fois dans le bon regime.
;; REFERENCE : `back`, pas `idle` — c'est la pose etablie qui precede immediatement, mesuree de la
;; meme facon, ce qui retire du calcul tout ce que le cycle `tilt` aurait pu laisser.
;;
;; LE CONTROLE POSITIF, ET IL N'AJOUTE AUCUN OPERATEUR : on rejoue le MEME cycle avec la contrainte
;; de cote LEVEE (`phys-side-off-set!`, le bouton qui existe deja et que la salle arme deja plus
;; bas). Contrainte levee, un maillon qui passe du mauvais cote de l'axe d'un volume y RESTE — un
;; equilibre stable mais faux, qui est precisement un non-retour. Si `gap` ne monte pas quand on
;; leve ce verrou, c'est que la mesure ne mesure rien, et je le dirai.
(defconstant PHYSROOM-PH-SHAKE    6)   ;; secousse `jerk`,       cycle NORMAL
(defconstant PHYSROOM-PH-SHAKEN   7)   ;; relache + tenue,       emet `shaken`
(defconstant PHYSROOM-PH-SHAKEPC  8)   ;; secousse `jerk`,       contrainte de cote LEVEE
(defconstant PHYSROOM-PH-SHAKENPC 9)   ;; relache + tenue,       emet `shakenpc`
(defconstant PHYSROOM-PH-PCOFF 10)
(defconstant PHYSROOM-PH-PCON 11)
(defconstant PHYSROOM-PH-AUTHPC 12)
(defconstant PHYSROOM-PH-INVPC 13)
(defconstant PHYSROOM-PH-SELFOFF 14)
(defconstant PHYSROOM-PH-SELFON 15)
;; CONTROLE POSITIF DE LA CONTRAINTE DE COTE — DEUX BRANCHES QUI BALAYENT LES ANIMATIONS.
;;
;; Ce que faisait la version precedente, et pourquoi elle a rendu `armed=0 disarmed=0` : la branche
;; armee tenait 90 frames sur UNE SEULE animation (index 0, `assistant-idle-leaning-right`) et un
;; seul pilotage, pendant que le phenomene qu'elle pretend exercer — les lunettes qui traversent le
;; buste, le pan qui passe dans le mollet — se produit sur des animations PRECISES que cette
;; fenetre-la ne joue jamais. Un controle qui n'expose pas le defaut ne prouve pas qu'il a disparu :
;; il prouve qu'on ne l'a pas regarde. Mesure de la course du 2026-08-12 15:46 : side=0.0 sur les
;; SIX fenetres de diagnostic, y compris armee.
;;
;; Les deux branches balayent donc les MEMES `nanim` animations, `PHYSROOM-PCW` frames chacune, meme
;; pilotage : exposition identique de part et d'autre, ce qui est la seule facon de comparer deux
;; comptes. C'est aussi la correction que le cycle precedent avait ecrite sans la poser : comparer
;; 43 evenements sur 90 frames a 11446 sur 16740 rapprochait deux expositions differentes.
(defconstant PHYSROOM-PH-SIDEOFF 16)   ;; contrainte EN PLACE   — la reference
(defconstant PHYSROOM-PH-SIDEON 17)   ;; contrainte LEVEE      — le compteur DOIT monter
;; 18 et 19 sont LIBRES : ils portaient le controle positif du mecanisme retire le 2026-08-14.
;; CONTROLE POSITIF DU PREDICAT CONIQUE. Les 24 capsules livrees sont TOUTES coniques, et le moteur
;; testait jusqu'ici le rayon interpole au parametre de PROJECTION au lieu du solide que la donnee
;; designe — un ensemble strictement plus PETIT, donc un solveur qui cesse de pousser trop tot.
;; ARMEE (`phys-cone-off-set! 1`), la penetration residuelle DOIT remonter : la mesure, elle, garde
;; le solide exact des deux cotes (`phys-pen-chain` force l'exactitude), sinon le compteur
;; tomberait sous le defaut au lieu de monter. Les deux branches balayent les MEMES animations —
;; c'est la lecon du controle de cote qui rendait 0 contre 0 sur une fenetre trop etroite.
(defconstant PHYSROOM-PH-CONEOFF 20)
(defconstant PHYSROOM-PH-CONEON 21)
;; SPEC 24/25/26/27 — les trois impulsions ISOLEES, une par axe, chacune suivie de son ring-down
;; libre. Numeros pris dans les trous laisses libres sous PHYSROOM-PH-REPORT (18, 19, 22) : toute
;; phase de TRAVAIL doit rester INFERIEURE a 30, cf. la note de PHYSROOM-PH-REPORT.
(defconstant PHYSROOM-PH-AXV 18)     ;; impulsion VERTICALE   puis ring-down
(defconstant PHYSROOM-PH-AXB 19)     ;; impulsion AVANT-ARRIERE puis ring-down
(defconstant PHYSROOM-PH-AXL 22)     ;; impulsion LATERALE    puis ring-down
;; LES MEMES TROIS, CONTRAINTE DE LONGUEUR DESARMEE — le controle positif de l'hypothese du
;; cycle 8. `ROOM-AXSEL` mesure qu'un seul axe sur trois est isolable ; l'explication proposee est
;; qu'un point contraint sur une sphere n'a que deux degres de liberte de translation. Si c'est
;; vrai, desarmer la contrainte doit faire MONTER la selectivite. Si elle ne bouge pas, l'hypothese
;; est fausse — et c'est un resultat aussi, publie tel quel.
(defconstant PHYSROOM-PH-AXZV 23)    ;; idem AXV, contrainte de longueur LEVEE
(defconstant PHYSROOM-PH-AXZB 27)    ;; idem AXB, contrainte de longueur LEVEE
(defconstant PHYSROOM-PH-AXZL 28)    ;; idem AXL, contrainte de longueur LEVEE
(defconstant PHYSROOM-PH-ORI 24)     ;; SPEC 10-13 : le balayage d'orientation
(defconstant PHYSROOM-PH-RESTA 25)   ;; SPEC 33/34 : secousse, restitution AUX VALEURS DE LA SPEC
(defconstant PHYSROOM-PH-RESTB 26)   ;; SPEC 33/34 : MEME secousse, coefficient x15 (controle +)
(defconstant PHYSROOM-ORIS 60)       ;; frames d'etablissement par orientation
(defconstant PHYSROOM-ORIM 30)       ;; frames de mesure par orientation
;; REPORT et DONE passent de 22/23 a 30/31 : `physroom-tick` teste `(< phase PHYSROOM-PH-REPORT)`
;; pour savoir si la course est encore en cours (le balayage d'acteurs etrangers en depend), donc
;; toute phase de TRAVAIL doit avoir un numero INFERIEUR. Les ajouter au-dessus de 22 sans deplacer
;; REPORT les aurait rendues silencieusement inertes de ce point de vue.
(defconstant PHYSROOM-PH-REPORT 30)
(defconstant PHYSROOM-PH-DONE 31)

(deftype phys-subject (process-drawable)
  ((phase   int32)
   (pframe  int32)
   (ai      int32)     ;; index dans *physroom-anim-*
   (drive   int32)
   (nanim   int32)     ;; animations RETENUES (jouables sur ce rig)
   (nenum   int32)     ;; animations ENUMEREES dans les six art-groups de Keira
   (slot    int32)     ;; slot de simulation du compagnon
   (nchain  int32)
   (hdpid   int32)
   (nag     int32)     ;; art-groups de Keira effectivement charges
   (fnum    float)     ;; frame courante de l'animation
   (nframe  float)     ;; nombre de frames de l'animation courante
   (adir    float)     ;; sens de lecture (+1 aller, -1 retour) — jamais de saut de frame-num
   (aspeed  float)     ;; vitesse de lecture de l'animation courante, celle du jeu
   (wraps   int32)     ;; demi-tours de lecture, publies : personne n'a a deviner combien
   (viol    int32)     ;; frames de mesure ou un target existait (doit rester 0)
   (nactor  int32)     ;; pire nombre d'acteurs etrangers vus dans la zone
   (killed  int32)     ;; acteurs etrangers deactives
   (dis     float)     ;; controle positif : penetration max, defaut DESARME
   (arm     float)     ;; controle positif : penetration max, defaut ARME
   (condis  float)     ;; predicat conique CORRIGE   : penetration max residuelle
   (conarm  float)     ;; predicat conique D'AVANT   : la meme, elle doit MONTER
   (injn    int32)     ;; poussees reellement injectees
   (lvl     int32)     ;; niveau d'excitation courant de la courbe de reponse
   (ori     int32)     ;; index dans la table d'orientations de SPEC 10-13
   (nchan   int32)     ;; canaux d'animation du PORTEUR (= (-> draw mgeo num-joints))
   (nperm   int32)     ;; positions de canal deplacees par la permutation de l'animation courante
   (vel     vector :inline)
   (home    vector :inline))
  (:states phys-subject-run))

(define *physroom-anim-ag* (new 'static 'array art-group PHYSROOM-MAXANIM))
(define *physroom-anim-ix* (new 'global 'array 'int32 PHYSROOM-MAXANIM))
(define *physroom-proc*    (the-as (pointer phys-subject) #f))

;; ------------------------------------------------------------------------------------------------
;; LE REMAPPAGE PAR NOM — les tables. Voir le pave devant `physroom-build-perm!` pour le defaut
;; qu'elles corrigent.
;;
;; Capacite : le rig du village 1 porte 96 joints, donc 94 canaux d'animation (canal t -> joint
;; d'indice t+2 du art-joint-geo -> node-list t+3, cf. make-nodes-from-jg process-drawable.gc:151-161
;; et la boucle de lecture process-drawable.gc:265-271). 96 laisse la marge des deux entrees que le
;; decompresseur touche au-dela (joint.gc:216 « TODO - not sure if this is too many »).
;; ------------------------------------------------------------------------------------------------
(defconstant PHYSROOM-MAXCH 96)

;; permutation COURANTE : position de canal du PORTEUR -> position de canal de l'ANIMATION.
;; -1 = aucune source (le nom du joint porteur n'existe pas dans le rig de l'animation).
(define *physroom-perm*   (new 'global 'array 'int32 PHYSROOM-MAXCH))

;; INSTANTANE des canaux tels que l'animation vient de les ecrire, lu par la permutation.
;; ALLOUE UNE SEULE FOIS, au chargement du fichier, et JAMAIS sur la pile GOAL.
;; DEVIATION ASSUMEE ET CHIFFREE par rapport au « tas du processus » demande : le sujet nait de
;; *pc-dead-pool* (pckernel.gc:666), soit 16384 octets de tas TOTAL par processus, et
;; `initialize-skeleton` y a deja pose le cspace-array (97 x 32 = 3104 o) et le skeleton
;; (97 x 96 = 9312 o) du rig a 96 joints, plus draw-control / joint-control / trsqv : ~12,9 Ko sur
;; 16 Ko. 4608 octets de plus ne rentrent pas. Le tas global les porte, avec la meme garantie
;; (une allocation, au chargement, jamais par frame).
(define *physroom-tqbuf*  (new 'global 'inline-array 'transformq PHYSROOM-MAXCH))

;; POSE DE REPOS DU PORTEUR, canal par canal, derivee de la bind-pose de SON rig — c'est ce que
;; recoivent les canaux sans source (point 3). Calculee UNE SEULE FOIS a la naissance du sujet.
(define *physroom-tqrest* (new 'global 'inline-array 'transformq PHYSROOM-MAXCH))
;; combien de canaux de cette table ont ete VRAIMENT derives de la bind-pose (les autres sont
;; retombes sur la transformation identite) — publie, jamais suppose.
(define *physroom-restok* 0)

;; --- balayage de la zone (deux phases : on collecte, PUIS on tue — jamais muter l'arbre pendant
;; --- qu'on le parcourt, meme piege que hd-scan-visit).
(define *physroom-self*    (the-as process #f))
(define *physroom-hd*      (the-as process #f))
(define *physroom-nactor*  0)
(define *physroom-ntarget* 0)
(define *physroom-kill*    (new 'static 'array process-drawable 32))
(define *physroom-nkill*   0)

(defun physroom-visit ((proc process))
  (when (= (-> proc type) target) (+! *physroom-ntarget* 1))
  (when (and (type-type? (-> proc type) process-drawable)
             (!= proc *physroom-self*)
             (!= proc *physroom-hd*))
    (+! *physroom-nactor* 1)
    (when (< *physroom-nkill* 32)
      (set! (-> *physroom-kill* *physroom-nkill*) (the-as process-drawable proc))
      (+! *physroom-nkill* 1)))
  #t)

;; ------------------------------------------------------------------------------------------------
;; VIDER LA ZONE, et le prouver. Retourne le nombre d'acteurs ETRANGERS trouves cette frame (0 =
;; la zone ne contient plus que le sujet et sa peau HD). Les target trouves sont tues sur place et
;; comptes : la salle ne peut pas se contenter de les endormir (SPEC : « ni endormi, ni hors
;; champ : absent »).
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-sweep phys-subject ((kill? symbol))
  (set! *physroom-self* (the-as process self))
  (set! *physroom-hd* (if (-> self child) (the-as process (-> self child 0)) (the-as process #f)))
  (set! *physroom-nactor* 0)
  (set! *physroom-ntarget* 0)
  (set! *physroom-nkill* 0)
  (iterate-process-tree *active-pool* physroom-visit *null-kernel-context*)
  (when (> *physroom-ntarget* 0)
    ;; un target est reapparu (cycle d'attract) : on le tue immediatement et on le compte. Cette
    ;; frame de mesure est contaminee, et le compteur le dira.
    (kill-by-name 'target *active-pool*)
    (set! *target* #f))
  (when kill?
    (dotimes (i *physroom-nkill*)
      (deactivate (-> *physroom-kill* i))
      (+! (-> self killed) 1)))
  *physroom-nactor*)

;; ------------------------------------------------------------------------------------------------
;; LE PILOTAGE. Tout passe par une acceleration imposee puis integree : c'est la seule chose que la
;; chaine ressent (la pseudo-force de repere accelere de jak-hd-physics.gc).
;;
;; POURQUOI LES MAGNITUDES ONT CHANGE LE 2026-08-11 (et c'est la cause racine de l'echec DISCRIMINANT,
;; pas un reglage) : les quatre pilotages de translation tapaient tous entre 10 et 300 u/frame^2,
;; c'est-a-dire tous DERRIERE le coude de saturation des chaines. La courbe de reponse mesuree par
;; la salle elle-meme (PHYSRESP, six niveaux d'excitation) le dit sans ambiguite — gain amp/exc :
;;
;;     exc      1.5    3.5    8.0   18.0   42.0   96.0
;;     lBoob   25.2   21.0   19.3   19.6   15.8    7.5
;;     LtoeStrap 29.7 28.7   28.3   26.8   12.4    5.5
;;
;; le gain est CONSTANT jusqu'a 18, puis s'effondre d'un facteur 3 a 5. Au-dela du coude la chaine
;; est collee a son plafond geometrique et rend la meme amplitude quoi qu'on lui fasse : 16 chaines
;; sur 22 rendaient donc le meme chiffre sous une secousse, une translation et une inclinaison
;; (backhair : 3 % d'ecart). Ce n'etait pas la physique qui etait plate, c'etait le stimulus qui
;; etait partout le meme — sature. « Diverses accelerations » veut dire un EVENTAIL, et updown et
;; leftright, qui portaient les magnitudes IDENTIQUES sur deux axes, n'etaient pas deux stimuli
;; differents : c'etait le meme, tourne.
;;
;;   0 updown     vertical, 18 u/frame^2 — DANS LA BANDE LINEAIRE, la reponse y est proportionnelle
;;   1 leftright  horizontal, 52 u/frame^2 — la secousse franche
;;   2 accel      trajectoire plane, magnitude qui balaie 2 -> 96, donc qui TRAVERSE le coude
;;   3 jerk       vitesse POSEE d'un coup et arrets brutaux — « a-coups »
;;   4 tilt       elle SE PENCHE ET TIENT LA POSE : le seul pilotage qui n'est pas une secousse
;;   5 (aucun)    la ligne de base, traitee par l'appelant (physroom-hold)
;; Les unites sont des unites de jeu par frame^2 (4096 u = 1 m, 60 Hz).
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-drive phys-subject ((mode int) (f int))
  (let ((ax 0.0) (ay 0.0) (az 0.0)
        (seg (/ f 15)))
    (cond
      ;; --- LES TROIS PILOTAGES CONTINUS SONT IMPOSES EN POSITION, PAS EN ACCELERATION ----------
      ;; Mesure du 2026-08-11 : `updown` commandait 18 u/frame^2 et la chaine en recevait 173.
      ;; L'ecart venait du garde-fou : la vitesse etait INTEGREE, la position derivait jusqu'aux
      ;; +/- 3 m, et la butee remettait la vitesse a zero D'UN COUP — un a-coup de plusieurs
      ;; centaines d'unites au milieu de la fenetre de mesure. Les trois pilotages « doux » etaient
      ;; donc, en pratique, le meme choc que `jerk`, et c'est une deuxieme facon dont la salle
      ;; rendait cinq colonnes identiques.
      ;; Une trajectoire sinusoidale POSEE a une acceleration exactement connue (A w^2) et ne
      ;; s'approche jamais du garde-fou : le stimulus publie par PHYSSTIM est alors celui que la
      ;; chaine recoit vraiment, et le gain de ROOM-RESPONSE a enfin un denominateur honnete.
      ;; Periode 36 frames (w = 0.1745 rad/frame, w^2 = 0.03046) : exactement un cycle complet
      ;; dans les 36 frames effectivement mesurees.
      ((< mode 3)
       (let* ((mag (cond
                     ((zero? mode) 18.0)
                     ((= mode 1)   52.0)
                     ;; « diverses accelerations » : la meme trajectoire subie de 2 a 96
                     ;; u/frame^2, donc de part et d'autre du coude de saturation (18 a 42).
                     (else (+ 2.0 (* 94.0 (/ (the float f) (the float PHYSROOM-WIN)))))))
              (amp (/ mag PHYSROOM-W2))
              (ph  (* 65536.0 (/ (the float f) (the float PHYSROOM-PERIOD))))
              (s   (sin ph)))
         (vector-copy! (-> self root trans) (-> self home))
         (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
         (cond
           ((zero? mode) (set! (-> self root trans y) (+ (-> self home y) (* amp s))))
           ((= mode 1)   (set! (-> self root trans x) (+ (-> self home x) (* amp s))))
           (else
            (set! (-> self root trans x) (+ (-> self home x) (* amp s)))
            (set! (-> self root trans z) (+ (-> self home z) (* 0.5 amp (cos ph))))))))
      ((= mode 3)
       ;; a-coups : toutes les 10 frames la vitesse est ECRASEE, pas accumulee. Un segment sur
       ;; trois est un arret net (vitesse exactement nulle) : c'est le pire cas pour une chaine.
       (when (zero? (mod f 10))
         (let ((s (mod (/ f 10) 6)))
           (case s
             ((0) (set-vector! (-> self vel) 0.0 0.0 0.0 1.0))
             ((1) (set-vector! (-> self vel) 210.0 0.0 0.0 1.0))
             ((2) (set-vector! (-> self vel) 0.0 -260.0 0.0 1.0))
             ((3) (set-vector! (-> self vel) 0.0 0.0 0.0 1.0))
             ((4) (set-vector! (-> self vel) -240.0 0.0 190.0 1.0))
             (else (set-vector! (-> self vel) 0.0 300.0 0.0 1.0))))))
      (else
       ;; TILT : ELLE SE PENCHE EN AVANT ET ELLE TIENT LA POSE.
       ;;
       ;; Ce que ce mode faisait AVANT, et pourquoi il ne pouvait rien mesurer : il balayait
       ;; +/- 60 degres en sinus sur 45 frames, tangage puis roulis. A hauteur de tete (~7000 u de
       ;; l'axe) ca fait 1.047 rad x (2 pi / 45)^2 x 7000 = 143 u/frame^2 — la PLUS VIOLENTE des
       ;; cinq secousses, alors qu'elle porte le nom de l'inclinaison. Le pilotage cense mesurer la
       ;; gravite mesurait donc la meme chose que les quatre autres, et rendait le meme chiffre :
       ;; c'est exactement le « chestL tilt 0.3889 contre accel 0.3490 » que le superviseur a
       ;; reproche a ce tableau.
       ;;
       ;; Maintenant : rampe en demi-cosinus jusqu'a 60 degres sur PHYSROOM-TILTRAMP frames, puis
       ;; POSE TENUE. Pendant la tenue l'acceleration de translation est nulle et l'orientation ne
       ;; change plus : la seule chose qui agisse encore sur la chaine est la gravite exprimee dans
       ;; le repere de l'ancre. C'est le stimulus que l'owner decrit — « quand elle se penche en
       ;; avant pour souder » — et c'est le seul des cinq qui ne soit pas une agitation.
       (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
       (vector-copy! (-> self root trans) (-> self home))
       (let* ((u (if (< f PHYSROOM-TILTRAMP)
                   (/ (the float f) (the float PHYSROOM-TILTRAMP))
                   1.0))
              (a (* PHYSROOM-TILTDEG 0.5 (- 1.0 (cos (* 32768.0 u))))))
         (quaternion-axis-angle! (-> self root quat) 1.0 0.0 0.0 (degrees a)))))
    ;; `ax/ay/az` ne servent plus qu'a `jerk`, qui pose sa vitesse lui-meme : les trois pilotages
    ;; continus imposent desormais leur POSITION et n'integrent rien.
    (when (and (= mode 3) (or (!= ax 0.0) (!= ay 0.0) (!= az 0.0)))
      (set! (-> self vel x) (+ (-> self vel x) ax))
      (set! (-> self vel y) (+ (-> self vel y) ay))
      (set! (-> self vel z) (+ (-> self vel z) az))))
  ;; INTEGRATION + GARDE-FOU, ET SEULEMENT POUR `jerk`. La butee des +/- 3 m remet la vitesse a zero
  ;; d'un coup : c'est un a-coup de plus, ce qui est exactement le propos de `jerk` et exactement le
  ;; contraire du propos des trois autres. C'est pour ca qu'ils n'integrent plus.
  (when (= mode 3)
    (set! (-> self root trans x) (+ (-> self root trans x) (-> self vel x)))
    (set! (-> self root trans y) (+ (-> self root trans y) (-> self vel y)))
    (set! (-> self root trans z) (+ (-> self root trans z) (-> self vel z)))
    (when (> (fabs (- (-> self root trans x) (-> self home x))) PHYSROOM-LIMIT)
      (set! (-> self root trans x) (+ (-> self home x) (* PHYSROOM-LIMIT (if (> (-> self vel x) 0.0) 1.0 -1.0))))
      (set! (-> self vel x) 0.0))
    (when (> (fabs (- (-> self root trans y) (-> self home y))) PHYSROOM-LIMIT)
      (set! (-> self root trans y) (+ (-> self home y) (* PHYSROOM-LIMIT (if (> (-> self vel y) 0.0) 1.0 -1.0))))
      (set! (-> self vel y) 0.0))
    (when (> (fabs (- (-> self root trans z) (-> self home z))) PHYSROOM-LIMIT)
      (set! (-> self root trans z) (+ (-> self home z) (* PHYSROOM-LIMIT (if (> (-> self vel z) 0.0) 1.0 -1.0))))
      (set! (-> self vel z) 0.0)))
  ;; les quatre pilotages de translation laissent le sujet DROIT : sans ca l'inclinaison de la
  ;; fenetre precedente resterait en place et contaminerait la suivante.
  (when (< mode 4) (quaternion-identity! (-> self root quat)))
  (none))

(defbehavior physroom-hold phys-subject ()
  "immobile, pile sur le point de depart ET DROITE : c'est l'etat de repos de SPEC section 4."
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-identity! (-> self root quat))
  (none))

;; ------------------------------------------------------------------------------------------------
;; SPEC 10-13 — L'ORIENTATION, SUR DEUX AXES ET SUR TOUTE LA PLAGE.
;; Sa §13 : « supine, prone, upright and lateral states SHALL NOT exist as unrelated hard-coded
;; morph targets ; the equilibrium state shall vary CONTINUOUSLY with the local gravity direction ».
;; Une salle qui ne penche qu'a 60 degres vers l'avant ne peut ni verifier §10 (sur le dos), ni §12
;; (sur le cote), ni la CONTINUITE entre les deux — c'est le trou d'instrument que ce cycle ferme.
;; `axis` 0 = tangage (avant/arriere, atteint prone et supine), 1 = roulis (lateral).
(defbehavior physroom-orient phys-subject ((axis int) (deg float))
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (if (zero? axis)
    (quaternion-axis-angle! (-> self root quat) 1.0 0.0 0.0 (degrees deg))
    (quaternion-axis-angle! (-> self root quat) 0.0 0.0 1.0 (degrees deg)))
  (none))

;; LA TABLE DES ORIENTATIONS BALAYEES. Les quatre POLES de sa spec y sont (±90 sur chaque axe), et
;; les intermediaires a 45 sont la pour §13 : entre deux poles la forme doit varier CONTINUMENT,
;; ce qui ne se lit que si on echantillonne entre les poles. 0 degre est inclus comme ligne de
;; base : cette orientation-la doit rendre 1.000 / 1.000 / 1.000, sinon tout le reste est decale.
(defconstant PHYSROOM-ORIN 9)
(define *physroom-ori-ax* (new 'static 'array int32 9 0 0 0 0 0 1 1 1 1))
(define *physroom-ori-dg* (new 'static 'array float 9
                               0.0 45.0 90.0 -45.0 -90.0 45.0 90.0 -45.0 -90.0))

(defbehavior physroom-lean phys-subject ((deg float))
  "immobile mais PENCHEE de `deg` degres vers l'avant. L'excitation d'acceleration retombe a zero,
   donc ce qui reste dans l'ecart a la pose du modele n'est plus que la gravite. C'est la mesure
   que reclame la 6e passe de l'owner : « aucun mouvement quand elle se penche en avant pour
   souder, pas coherent du tout »."
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-axis-angle! (-> self root quat) 1.0 0.0 0.0 (degrees deg))
  (none))

;; EXCITATION CALIBREE : une acceleration d'amplitude CONNUE, alternee, sur un seul axe. C'est
;; l'entree de la courbe de reponse — l'amplitude de pointe en sortie se lit dans la meme fenetre.
(defbehavior physroom-drive-exc phys-subject ((f int) (mag float))
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-identity! (-> self root quat))
  ;; deplacement sinusoidal pur : |acceleration| = mag, sans discontinuite qui melangerait la
  ;; reponse au seuil qu'on cherche.
  (let* ((w  (/ 65536.0 24.0))
         (ph (* w (the float f)))
         (amp (/ mag (* (/ 6.2831853 24.0) (/ 6.2831853 24.0)))))
    (set! (-> self root trans x) (+ (-> self home x) (* amp (sin ph))))
    (set! (-> self root trans y) (+ (-> self home y) (* 0.4 amp (sin (* 2.0 ph))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; SPEC 24/25/26/27 — UNE IMPULSION ISOLEE, SUR UN SEUL AXE, PUIS ON LACHE.
;;
;; POURQUOI CETTE PHASE EXISTE, ET C'EST UNE MESURE QUI LA MOTIVE, PAS UNE IDEE.
;; La fenetre de repos (`PHYSROOM-PH-IDLE`) suit CINQ pilotages et une courbe de reponse : ce qui y
;; sonne est un MELANGE de modes, pas un mode propre. La table de la course precedente le dit
;; elle-meme : `ROOM-RINGFIT-SEP: chain=chestL v/ap confondus`, et les deux projections rendent
;; 2.420 et 2.435 Hz — 0.6 % d'ecart la ou la raideur livree (`slat=1.2195`, `sap=1.1111`) impose
;; 5.4 %. Une serie projetee sur trois axes ne rend trois frequences que si les trois modes ont ete
;; excites SEPAREMENT ; sinon les trois projections rendent le meme mode dominant.
;; Et l'axe lateral n'y est pratiquement pas excite : residu ABSOLU identique aux trois axes
;; (1.0e-4 a 1.9e-4) pour une valeur efficace 8 a 13 fois plus petite — le residu relatif de 0.095
;; et 0.194 mesure donc l'ABSENCE D'EXCITATION, pas un mauvais ajustement.
;;
;; C'est le protocole que sa §27 ecrit mot pour mot — « After ONE STRONG ISOLATED IMPULSE » — et
;; que la salle n'a jamais execute.
;;
;; LA FORME DE L'IMPULSION. Demi-cosinus sur `PHYSROOM-IMPF` frames : deplacement 0 -> A, vitesse
;; NULLE aux deux bouts, acceleration maximale au milieu. Aucune discontinuite de position ni de
;; vitesse — donc rien qui puisse declencher le rebasement de discontinuite de sa §37 (« artificial
;; transforms must not generate physical breast impulses ») et faire avaler l'impulsion.
;; Apres `PHYSROOM-IMPF` le sujet est TENU immobile a `home + A` : le mode sonne librement autour
;; d'un equilibre identique a celui de `home`, puisque l'orientation n'a pas bouge.
;;
;; L'AMPLITUDE EST CHOISIE DANS LA BANDE LINEAIRE, ET C'EST UN CHOIX METHODOLOGIQUE.
;; `a_max = A/2 * (pi/T)^2` = 365 * 0.5 * (3.1416/10)^2 = 18.0 u/frame^2 — exactement le niveau que
;; la salle documente comme « DANS LA BANDE LINEAIRE, la reponse y est proportionnelle » (voir la
;; table des pilotages). Une frequence propre et un rapport d'amortissement sont des proprietes du
;; systeme LINEARISE : les mesurer sous saturation `tanh` (§21) rendrait la signature du limiteur,
;; pas celle du ressort. Ce que ces fenetres ne mesurent donc PAS, et il faut le dire : le regime
;; fort de sa §27. Celui-la reste mesure par la fenetre de repos, qui suit les cinq pilotages.
;;
;; `ax` : 0 = VERTICAL (Y monde), 1 = AVANT-ARRIERE (Z monde), 2 = LATERAL (X monde). Le sujet est
;; a quaternion identite pendant toute la phase, donc les axes monde coincident avec le triedre de
;; sa §7 (+X lateral, +Y haut, +Z avant) — c'est ce qui rend l'axe d'EXCITATION comparable a l'axe
;; de MESURE, qui lui est pris dans le triedre de l'ancre.
(defconstant PHYSROOM-IMPF 10)      ;; duree de l'impulsion, en frames (comparaisons entieres)
(defconstant PHYSROOM-IMPFF 10.0)   ;; la MEME duree en flottant. Deux constantes et pas un `the` :
                                    ;; `(the float <litteral entier>)` se replie en REINTERPRETATION
                                    ;; de bits, pas en conversion — 10 y deviendrait 1.4e-44.
(defconstant PHYSROOM-IMPA 365.0)   ;; amplitude du pas, en unites de jeu -> 18.0 u/frame^2 de pic
(defconstant PHYSROOM-AXW 160)      ;; fenetre totale : 10 d'impulsion + 150 de ring-down libre

(defbehavior physroom-drive-imp phys-subject ((f int) (ax int))
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-identity! (-> self root quat))
  ;; `f` est BORNE par l'appelant a PHYSROOM-IMPF : au-dela, `s` vaut 1.0 et le sujet est tenu
  ;; immobile au bout de son pas. Un seul chemin de code pour l'impulsion et pour la tenue.
  ;; ON POUSSE DANS LE TRIEDRE DE L'ANCRE, PAS EN AXES MONDE — ET C'EST UNE MESURE QUI L'IMPOSE.
  ;; Premiere version : impulsions le long de MONDE-Y / MONDE-Z / MONDE-X. Part de la reponse
  ;; tombant sur la projection VERTICALE du solveur, relevee sur la course :
  ;;     chestL  MONDE-Y -> v 21.5 %  ap 38.9 %  lat 39.5 %   (dominee par LAT)
  ;;     chestR  MONDE-Y -> v 25.7 %  ap 56.7 %  lat 17.5 %   (dominee par AP)
  ;; Cinq fenetres sur six dominees par le MEME axe : le repere du sujet et le triedre de l'ancre
  ;; ne sont pas alignes, donc aucune de ces trois impulsions n'isolait un mode propre — et les
  ;; trois frequences qu'elles rendaient etaient trois melanges, pas trois frequences propres.
  ;; Conclure §24 la-dessus aurait ete exactement la mesure non discriminante que le contrat
  ;; interdit. On demande donc au solveur la direction MONDE de SON axe, et on pousse dessus.
  (let* ((tt (if (>= f PHYSROOM-IMPF) 1.0 (/ (the float f) PHYSROOM-IMPFF)))
         (s  (* 0.5 (- 1.0 (cos (* 32768.0 tt)))))
         (d  (* PHYSROOM-IMPA s))
         ;; les deux seins partagent la MEME ancre (le buste), donc le meme triedre : la chaine 0
         ;; suffit a le porter. Si elle n'est pas encore classee, les trois composantes valent 0 —
         ;; c'est le cas que `PHYSAXW` publie, pour qu'une impulsion nulle ne se lise jamais comme
         ;; une absence de reponse.
         (ux (phys-axis-world (-> self slot) 0 ax 0))
         (uy (phys-axis-world (-> self slot) 0 ax 1))
         (uz (phys-axis-world (-> self slot) 0 ax 2)))
    (set! (-> self root trans x) (+ (-> self home x) (* d ux)))
    (set! (-> self root trans y) (+ (-> self home y) (* d uy)))
    (set! (-> self root trans z) (+ (-> self home z) (* d uz))))
  (none))

;; les six niveaux d'excitation, en unites de jeu par frame^2 (4096 u = 1 m, 60 Hz). Echelle
;; geometrique : chaque niveau vaut ~2.3x le precedent, du frisson au coup sec.
(defun physroom-exc-level ((i int))
  (case i
    ((0) 1.5)
    ((1) 3.5)
    ((2) 8.0)
    ((3) 18.0)
    ((4) 42.0)
    (else 96.0)))

;; ------------------------------------------------------------------------------------------------
;; REMAPPAGE PAR NOM DES CANAUX D'ANIMATION — CORRECTION D'UN DEFAUT DE L'INSTRUMENT.
;;
;; LE DEFAUT, MESURE. `do-joint-math!` (process-drawable.gc:238-278) applique les canaux d'animation
;; PAR POSITION : le canal `t` va au node-list `t+3` du squelette PORTEUR (boucle :265-271), et le
;; NOMBRE de canaux vient du porteur (`(-> obj draw mgeo num-joints)`, :247) — jamais de l'animation.
;; La salle joue les 31 animations de Keira sur le seul porteur du village 1 : `physroom-set-anim` ne
;; change que `(-> self draw art-group)` puis re-evalue le channel.
;;
;; Or les six rigs de Keira sont identiques sur les node-list 1 a 28 et DIVERGENT ensuite :
;;
;;     art-group                  joints   positions fausses / 96
;;     assistant                    96      0
;;     assistant-village3           96      0     (table strictement identique au village 1)
;;     assistant-village2           96     60
;;     assistant-firecanyon         94     68
;;     assistant-lavatube-start     94     68
;;     assistant-lavatube-end       94     68
;;
;; 8 animations sur 31 pilotent donc le bon os, 23 pilotent le mauvais ; 17 des 46 maillons de
;; chaines (15 chaines sur 22) ont leur joint pilote dans la zone divergente. Le JEU n'est pas
;; touche (seul `assistant-lod0` porte un compagnon HD) : c'est l'INSTRUMENT qui est corrompu sur
;; 74 % de son domaine.
;;
;; LE POINT D'ACCROCHE. `prebind-function` (joint-h.gc:60) est appelee depuis
;; process-drawable.gc:254-255, ENTRE la decompression et la lecture joint par joint : c'est
;; exactement la ou le tableau de transformq peut encore etre remis dans l'ordre du porteur.
;; Disposition du scratchpad, confirmee par lurkerworm.gc:192-199 (`(&+ arg0 432)` = tq[6].quat) :
;; 128 octets de matrices, puis 48 octets par transformq. Le canal `t` est donc le transformq
;; d'indice `t` a `arg0 + 128`, et il correspond au joint d'indice `t+2` du art-joint-geo.
;;
;; CE QUI N'EST PAS FAIT ICI, ET POURQUOI : ni spawn d'un second art-group (5 entrees HD, 20 tables
;; statiques regenerees, refonte de hd-char-for-mgeo), ni retrait des 23 animations (SPEC 6 exige la
;; couverture complete et `ROOM-ANIMS 31/31 skipped=0` doit rester vrai).
;; ------------------------------------------------------------------------------------------------

(defun physroom-build-rest! ((jg art-joint-geo) (nch int))
  "Pose de repos LOCALE du PORTEUR, canal par canal, dans *physroom-tqrest*. C'est ce que recoivent
   les canaux sans source (point 3 : `torch` et `torchTIP` n'existent pas sur les trois rigs a 94
   joints). La bind-pose stockee par un joint EST son inverse-bind (jak-hd.gc:471), donc la
   transformation LOCALE de repos du joint k vaut inv(bind-pose[k]) . bind-pose[parent(k)] — le
   L'_k de jak-hd.gc:510-512. Elle est decomposee en (translation, quaternion, echelle) parce que
   c'est la forme que consomme la lecture (cspace<-parented-transformq-joint!,
   process-drawable.gc:271). Retourne le nombre de canaux effectivement derives ; tout canal dont la
   decomposition ne tient pas reste a l'identite et manque a ce compte, qui est publie."
  (set! *physroom-restok* 0)
  (let ((ib (new 'stack-no-clear 'matrix))
        (lk (new 'stack-no-clear 'matrix)))
    (dotimes (p PHYSROOM-MAXCH)
      (let ((tq (-> *physroom-tqrest* p)))
        ;; valeur par defaut, ecrite AVANT toute tentative : identite locale.
        (set-vector! (-> tq trans) 0.0 0.0 0.0 1.0)
        (quaternion-identity! (-> tq quat))
        (set-vector! (-> tq scale) 1.0 1.0 1.0 1.0)
        (when (and (< p nch) (< (+ p 2) (-> jg length)))
          (let ((j (-> jg data (+ p 2))))
            (when (and j (nonzero? (the-as int j)) (-> j parent))
              (matrix-4x4-inverse! ib (-> j bind-pose))
              (matrix*! lk ib (-> j parent bind-pose))
              ;; decomposition : longueur de ligne = echelle, ligne normalisee = rotation. Une
              ;; longueur nulle ou non finie fait echouer le test et laisse l'identite en place —
              ;; c'est le garde-fou anti-NaN, une matrice singuliere ne peut pas polluer le squelette.
              (let ((ok #t))
                (dotimes (r 3)
                  (let ((len (vector-length (-> lk vector r))))
                    (cond
                      ((> len 0.000001)
                       (set! (-> tq scale data r) len)
                       (vector-float*! (-> lk vector r) (-> lk vector r) (/ 1.0 len)))
                      (else (set! ok #f)))))
                (when ok
                  (matrix->quaternion (-> tq quat) lk)
                  (let ((qn (vector-length (the-as vector (-> tq quat)))))
                    (cond
                      ((and (> qn 0.5) (< qn 2.0))
                       (quaternion-normalize! (-> tq quat))
                       (set! (-> tq trans quad) (-> lk vector 3 quad))
                       (set! (-> tq trans w) 1.0)
                       (+! *physroom-restok* 1))
                      (else
                       ;; quaternion inexploitable : on remet TOUT a l'identite, echelle comprise.
                       (set-vector! (-> tq trans) 0.0 0.0 0.0 1.0)
                       (quaternion-identity! (-> tq quat))
                       (set-vector! (-> tq scale) 1.0 1.0 1.0 1.0))))))))))))
  *physroom-restok*)

(defun physroom-chan-of ((ajg art-joint-geo) (nm string))
  "Position de CANAL, dans le rig `ajg`, du joint qui porte le nom `nm`. -1 s'il n'y est pas.
   Le type passe a lookup-idx-of-art (joint.gc:733-739) est #f EXPRES : la branche typee compare
   `(-> data i type)` a un type, ce qu'un `joint` ne satisfait jamais, et la variante art-group de la
   meme methode (joint.gc:659) applique en plus la ruse « sauter le nom de l'art-group », qui n'a
   aucun sens pour un nom de joint.
   Les indices 0 et 1 du art-joint-geo sont les node-list 1 et 2 (align / prejoint) : ils sont
   pilotes par les DEUX MATRICES du scratchpad (process-drawable.gc:260-264), pas par un canal, donc
   ils ne sont la source de rien."
  (let ((s (lookup-idx-of-art ajg nm (the-as type #f))))
    (if s
      (let ((i (the-as int s))) (if (>= i 2) (- i 2) -1))
      -1)))

(defun physroom-prebind ((arg0 pointer) (arg1 int) (arg2 process-drawable))
  "Permute le tableau de transformq du scratchpad AVANT la lecture joint par joint. Posee sur le
   squelette du sujet par `physroom-build-perm!`, et RETIREE des que la permutation est l'identite :
   sur `assistant` et `assistant-village3` cette fonction n'est jamais appelee.
   `arg1` est `num-joints + 2` (process-drawable.gc:248), donc le nombre de canaux vaut arg1 - 2."
  (let* ((subj (the-as phys-subject arg2))
         (n    (min (- arg1 2) (min (-> subj nchan) PHYSROOM-MAXCH)))
         (dst  (the-as (inline-array transformq) (&+ arg0 128))))
    (when (> (-> subj nperm) 0)
      ;; instantane des canaux tels que l'animation vient de les ecrire. Sans lui, une permutation
      ;; qui n'est pas une suite de transpositions disjointes ecraserait ses propres sources.
      (dotimes (i n)
        (set! (-> *physroom-tqbuf* i trans quad) (-> dst i trans quad))
        (set! (-> *physroom-tqbuf* i quat quad) (-> dst i quat quad))
        (set! (-> *physroom-tqbuf* i scale quad) (-> dst i scale quad)))
      (dotimes (p n)
        (let ((s (-> *physroom-perm* p)))
          (cond
            ((= s p))   ;; la source est deja a la bonne place
            ((and (>= s 0) (< s n))
             (set! (-> dst p trans quad) (-> *physroom-tqbuf* s trans quad))
             (set! (-> dst p quat quad) (-> *physroom-tqbuf* s quat quad))
             (set! (-> dst p scale quad) (-> *physroom-tqbuf* s scale quad)))
            (else
             ;; AUCUNE SOURCE : pose de repos du porteur. Le choix est publie par animation
             ;; (PHYSREMAPORPHAN), jamais silencieux.
             (set! (-> dst p trans quad) (-> *physroom-tqrest* p trans quad))
             (set! (-> dst p quat quad) (-> *physroom-tqrest* p quat quad))
             (set! (-> dst p scale quad) (-> *physroom-tqrest* p scale quad))))))))
  0
  (none))

(defbehavior physroom-build-perm! phys-subject ((ai int) (ag art-group))
  "Construit la permutation POSITION DE CANAL DE L'ANIMATION -> POSITION DE CANAL DU PORTEUR, une
   fois par changement d'animation, et arme (ou desarme) la prebind-function.
   Le rig de l'animation est `(-> ag data 0)` : chaque art-group porte son art-joint-geo a l'indice
   0 (art-elts.gc:20,30,47,52) et `initialize-skeleton` (process-drawable.gc:352-354) valide ce
   contrat. Le type est verifie ici quand meme, et un manquement est publie."
  (set! (-> self nperm) 0)
  (let* ((jg  (-> self draw jgeo))
         ;; n = 0 si le porteur n'a pas de rig : la boucle de noms ne s'ouvre pas, et aucune branche
         ;; de ce corps ne lit `jg` quand n vaut 0.
         (n   (if (nonzero? jg) (min (-> self nchan) (min PHYSROOM-MAXCH (- (-> jg length) 2))) 0))
         (e   (-> ag data 0))
         (ajg (the-as art-joint-geo e))
         (njo (if (and e (nonzero? (the-as int e)) (= (-> e type) art-joint-geo)) (-> ajg length) -1)))
    (cond
      ((< njo 0)
       (format 0 "PHYSREMAPFAIL a=~D ag=~S reason=no-joint-geo-at-index-0~%" ai (-> ag name)))
      ((= ajg jg)
       ;; le rig du PORTEUR lui-meme : identite, aucun tampon, aucun appel, aucune recherche de nom.
       (dotimes (p n) (set! (-> *physroom-perm* p) p)))
      (else
       (dotimes (p n)
         (let ((s (physroom-chan-of ajg (-> jg data (+ p 2) name))))
           (set! (-> *physroom-perm* p) s)
           (when (!= s p) (+! (-> self nperm) 1))))
       (when (> (-> self nperm) 0)
         (dotimes (p n)
           (when (< (-> *physroom-perm* p) 0)
             (format 0 "PHYSREMAPORPHAN a=~D chan=~D joint=~S fallback=carrier-rest-pose restok=~D~%"
                     ai p (-> jg data (+ p 2) name) *physroom-restok*))))))
    (format 0 "PHYSREMAP a=~D ag=~S joints=~D permuted=~D identity=~D~%"
            ai (-> ag name) njo (-> self nperm) (if (> (-> self nperm) 0) 0 1)))
  (when (nonzero? (-> self skel))
    (if (> (-> self nperm) 0)
      (set! (-> self skel prebind-function) physroom-prebind)
      (set! (-> self skel prebind-function) (the-as (function pointer int process-drawable none) #f))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; ANIMATION. On pose le groupe de frames du channel 0 a la main et on avance frame-num nous-memes
;; (num-func-identity) : c'est exactement ce que fait initialize-skeleton (process-drawable.gc:405)
;; et ca nous laisse maitre du temps, donc de la reproductibilite des fenetres. Le `draw art-group`
;; est bascule sur celui de l'animation, comme le fait anim-tester.gc:515 pour jouer les animations
;; d'un art-group sur un squelette deja en place.
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-set-anim phys-subject ((ai int))
  (let* ((ag (-> *physroom-anim-ag* ai))
         (an (the-as art-joint-anim (-> ag data (-> *physroom-anim-ix* ai)))))
    (set! (-> self draw art-group) ag)
    ;; LES CANAUX DE CETTE ANIMATION SONT CEUX DE SON RIG, PAS CEUX DU PORTEUR : on construit la
    ;; permutation par NOM avant que la premiere frame ne soit lue.
    (physroom-build-perm! ai ag)
    (ja-channel-set! 1)
    (let ((ch (-> self skel root-channel 0)))
      (joint-control-channel-group-eval! ch an num-func-identity)
      (set! (-> ch frame-num) 0.0))
    (set! (-> self fnum) 0.0)
    (set! (-> self adir) 1.0)
    ;; LE NOMBRE DE FRAMES DE L'ANIMATION, tel que le lit le jeu lui-meme. La salle utilisait
    ;; `(-> an data 0 length)` — la taille du premier bloc de donnees compressees, PAS une duree.
    ;; Le moteur d'animation, lui, borne `frame-num` a `(-> frame-group frames num-frames)`
    ;; (joint.gc:948). Les deux ne coincident pas, et la salle rejouait donc une fraction arbitraire
    ;; de chaque animation en croyant les jouer entieres.
    (set! (-> self nframe) (the float (-> an frames num-frames)))
    ;; LA VITESSE DE LECTURE DU JEU, et c'est LA cause racine de « la salle mesure l'agitation ».
    ;;
    ;; La salle avancait `frame-num` de 1.0 par frame de jeu. Le jeu, lui, l'avance de
    ;; `inc * (-> frame-group speed) * time-adjust-ratio` (process-drawable-h.gc:46,
    ;; `num-func-loop!`) : la vitesse propre de l'animation est un FACTEUR, et les animations de
    ;; jak1 ont des keyframes espacees justement parce qu'elles sont interpolees entre deux.
    ;; Avancer d'une keyframe ENTIERE par frame joue l'animation plusieurs fois trop vite, et
    ;; l'acceleration croit comme le CARRE du facteur de vitesse.
    ;;
    ;; Ce que ca donnait, mesure (`acc` = pire acceleration de la pose d'auteur REELLEMENT recue par
    ;; la pointe, en u/frame^2) : backHair1 recevait 2447 u/frame^2 SANS AUCUN PILOTAGE — 2150 m/s^2,
    ;; 219 g, sur une animation d'attente. Les cinq pilotages commandaient 18, 52, 96, 434 et 11
    ;; u/frame^2 : ils etaient noyes d'un facteur 25 a 130, et les cinq colonnes rendaient donc le
    ;; meme chiffre. La salle ne mesurait pas la physique de Keira, elle mesurait la Keira qu'elle
    ;; secouait — celle que l'owner ne voit jamais, puisque le jeu ne joue pas ses animations comme
    ;; ca.
    (set! (-> self aspeed) (fmax 0.01 (-> an speed)))
    ;; LA LONGUEUR ET LA VITESSE REELLES, publiees : personne n'a a les deviner, et c'est le
    ;; chiffre qui prouve a quelle vitesse la salle joue reellement l'animation.
    (format 0 "PHYSANIMLEN a=~D n=~f speed=~f~%" ai (-> self nframe) (-> self aspeed)))
  (none))

;; LECTURE CONTINUE : ALLER-RETOUR, JAMAIS DE RETOUR BRUTAL A LA FRAME 0.
;;
;; C'EST LA CAUSE RACINE DE L'ECHEC « DISCRIMINANT », ET C'ETAIT UN DEFAUT DE L'INSTRUMENT, PAS DE
;; LA PHYSIQUE. L'ancienne version faisait `(when (>= fnum (- nframe 1.0)) (set! fnum 0.0))` : en UNE
;; frame, le squelette entier sautait de la derniere pose de l'animation a la premiere. Sur une
;; animation qui BOUCLE (les idle) les deux poses se ressemblent et le saut est petit ; sur une
;; TRANSITION (`assistant-idle-transition-right-to-left`, `assistant-idle-transition-to-welding`,
;; `assistant-village2-idle-hut-stop-welding`) elles n'ont rien a voir, et le personnage se
;; TELEPORTAIT d'une pose a l'autre. La difference seconde de cette teleportation est une
;; acceleration de plusieurs centaines d'unites par frame^2 — bien au-dela des 18 a 96 u/frame^2 que
;; la salle commande, et bien au-dela du coude de saturation mesure par PHYSRESP (18 a 42).
;;
;; Consequence exacte de ce que la gate reproche : la gate prend le MAXIMUM sur les animations, donc
;; pour chaque pilotage elle tombait sur une animation de transition, et y lisait la reponse au coup
;; de teleportation — la meme sous les cinq pilotages, puisqu'elle ne doit rien au pilotage. Les
;; chaines les plus courtes y etaient collees a leur plafond geometrique (lKneeFlap : os de 8 cm,
;; excursion de pointe 14,4 cm SOUS ANIMATION SEULE). On ne mesurait pas la physique de Keira, on
;; mesurait le rebond de la salle qui la secouait 20 fois par seconde.
;;
;; La lecture aller-retour visite EXACTEMENT les memes poses (SPEC 6 : « toutes ses animations »),
;; dans les deux sens, sans aucune discontinuite de position. Ce n'est pas un filtre et ca ne retire
;; aucun mouvement : ca retire une teleportation que le jeu ne fait pas non plus (en jeu, les
;; animations sont enchainees par un fondu, jamais par un saut de frame-num).
(defbehavior physroom-advance-anim phys-subject ((step float))
  (when (nonzero? (-> self skel))
    (let ((last (fmax 1.0 (- (-> self nframe) 1.0))))
      (set! (-> self fnum) (+ (-> self fnum) (* (-> self adir) (* step (-> self aspeed)))))
      (when (>= (-> self fnum) last)
        (set! (-> self fnum) last)
        (set! (-> self adir) -1.0)
        (+! (-> self wraps) 1))
      (when (<= (-> self fnum) 0.0)
        (set! (-> self fnum) 0.0)
        (set! (-> self adir) 1.0)
        (+! (-> self wraps) 1)))
    (set! (-> self skel root-channel 0 frame-num) (-> self fnum)))
  (none))

;; ------------------------------------------------------------------------------------------------
;; PUBLICATION D'UNE FENETRE. Une ligne par chaine. La cle `k` encode (chaine, animation,
;; pilotage) : format est cape a 8 parametres (destination + format + 6), et on veut les quatre
;; colonnes sur la meme ligne pour qu'elles ne puissent pas etre reassemblees de travers.
;;   amp  = AMPLITUDE de l'ecart de pointe du a la physique seule (diagonale de sa boite)
;;   root = pire residu d'ancrage de la racine
;;   pen  = pire penetration residuelle au-dela du plancher de pose modele
;;   jump = pire saut de l'ecart de pointe sur UNE frame
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-emit-window phys-subject ()
  (dotimes (c (-> self nchain))
   ;; une chaine que le moteur a ecartee (pose de modele hors de portee de son porteur) n'a pas de
   ;; mesure a publier : publier des zeros pour elle serait un chiffre invente.
   (when (> (phys-chain-links (-> self slot) c) 0)
    (cond
      ;; LIGNE DE BASE : meme animation, meme duree de fenetre, AUCUN pilotage. Publiee sur sa
      ;; propre ligne et jamais comme une mesure de pilotage : elle sert a soustraire, pas a
      ;; compter. La confondre avec un `row` donnerait a chaque chaine un pilotage artificiellement
      ;; faible, et ferait passer la gate DISCRIMINANT sans rien mesurer de plus.
      ((>= (-> self drive) PHYSROOM-DRIVES)
       (format 0 "PHYSBASE c=~D a=~D amp=~f jump=~f ns=~f~%"
               c (-> self ai)
               (phys-tip-amp (-> self slot) c)
               (phys-stat (-> self slot) c 2)
               (phys-stat (-> self slot) c 0)))
      (else
       (format 0 "PHYSROW k=~D amp=~f root=~f pen=~f jump=~f ns=~f~%"
               (+ (* (+ (* c PHYSROOM-MAXANIM) (-> self ai)) PHYSROOM-DRIVES) (-> self drive))
               (phys-tip-amp (-> self slot) c)
               (phys-stat (-> self slot) c 3)
               (phys-pen-col (-> self slot) c)
               (phys-stat (-> self slot) c 2)
               (phys-stat (-> self slot) c 0))))
    ;; LE STIMULUS REELLEMENT RECU, pour CHAQUE fenetre y compris la ligne de base. Compare a
    ;; l'amplitude commandee (PHYSSTIM), il dit si le pilotage a domine ou s'il a ete noye.
    (format 0 "PHYSACC c=~D a=~D d=~D acc=~f wraps=~D~%"
            c (-> self ai) (-> self drive)
            (phys-tip-stim (-> self slot) c)
            (-> self wraps))
    ;; LE GRADIENT, MAILLON PAR MAILLON (7e passe : « entre la racine et les pointes c'est zone de
    ;; guerre et les pointes bougent quasi pas »). Une ligne par maillon : c'est la seule forme qui
    ;; puisse porter un degrade, la ou un scalaire par chaine n'en montre rien.
    ;; DEUX GRANDEURS PAR MAILLON, ET LEUR ECART EST LE SUJET. 10e passe : « le milieu bouge
    ;; beaucoup plus que les pointes » alors que `amp` publiait une suite croissante.
    ;;   amp = ecart a la pose d'auteur — il CUMULE le long de la chaine, donc une pointe soudee a
    ;;         son parent herite du chiffre de son parent et parait mobile ;
    ;;   ang = deviation ANGULAIRE par rapport a l'attache, en degres — le mouvement PROPRE du
    ;;         maillon, nul pour un maillon qui suit rigidement son parent.
    ;; C'est `ang` que SPEC 2 exige croissante ; `amp` reste publiee pour que l'ecart entre les deux
    ;; soit lisible au lieu d'etre affirme.
    (dotimes (l (phys-chain-links (-> self slot) c))
      ;; `a0`/`a1` : le MEME angle releve aux etages du solveur (apres integration seule, puis
      ;; apres contraintes + attenuation). `ang` reste la valeur ECRITE. C'est la comparaison des
      ;; trois qui designe l'etage qui aplatit la pointe -- defaut `hair-gradient`, PRIORITE 1 :
      ;; un seul chiffre en sortie ne pouvait pas le dire, et trois passes ont bute dessus.
      (format 0 "PHYSGRAD c=~D a=~D d=~D l=~D amp=~f ang=~f~%"
              c (-> self ai) (-> self drive) l
              (phys-link-amp (-> self slot) c l)
              (phys-link-ang (-> self slot) c l))
      ;; LIGNE SEPAREE, et ce n'est pas un choix de style : `format` de GOAL n'accepte pas plus de
      ;; huit parametres, destination et chaine comprises.
      (format 0 "PHYSGRADS c=~D a=~D d=~D l=~D a0=~f a1=~f~%"
              c (-> self ai) (-> self drive) l
              (phys-link-ang-stage (-> self slot) c l 0)
              (phys-link-ang-stage (-> self slot) c l 1)))
    ;; L'ALLONGEMENT ET LE STIMULUS GRAVITAIRE DE CETTE FENETRE. Par fenetre, donc attribuables a un
    ;; PILOTAGE : « ils s'allongent sur les mouvements brusques » ne se verifie pas sur un total de
    ;; course. `gn` = |g_effective|/|g| vu par l'ancre, `tf` = la part TANGENTIELLE de cette gravite,
    ;; seule capable de faire tourner le lien — le reste est annule par la contrainte de longueur.
    (format 0 "PHYSSTR c=~D a=~D d=~D el=~f gn=~f tf=~f~%"
            c (-> self ai) (-> self drive)
            (phys-stat (-> self slot) c 17)
            (phys-stat (-> self slot) c 18)
            (phys-stat (-> self slot) c 19))
    ;; SPEC 8 / 36 / 29 — LA FORME, PAR FENETRE, DONC ATTRIBUABLE A UN PILOTAGE.
    ;; NATURE : trois echelles sans dimension (lateral, vertical, projection) et leur determinant,
    ;; puis le MAXIMUM sur la fenetre du mode secondaire de §36 (fraction d'epaisseur) et de la
    ;; torsion de §29 (radians). REPERE : le triedre de sa §7. LECTURE HORS DEFAUT : 1 / 1 / 1 / 1
    ;; et deux zeros — c'est ce que doit rendre une fenetre debout et immobile, et c'est ce qui
    ;; rend la ligne DISCRIMINANTE : sous `jerk` elle ne peut pas rendre la meme chose que sous
    ;; `updown` si le canal est vraiment alimente par le mouvement.
    ;; CE QUE CE N'EST PAS : la deformation vue sur le mesh. C'est ce que le solveur COMMANDE a la
    ;; racine ; la peau, graduee en r^1.63, n'en recoit qu'une part croissante vers la pointe.
    (format 0 "PHYSSHAPE c=~D a=~D d=~D sx=~f sy=~f sz=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 0)
            (phys-shape (-> self slot) c 1)
            (phys-shape (-> self slot) c 2))
    (format 0 "PHYSSHAPE2 c=~D a=~D d=~D det=~f secm=~f twm=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 3)
            (phys-shape (-> self slot) c 5)
            (phys-shape (-> self slot) c 7))
    ;; `secr` = le mode secondaire AVANT le plafond de §38, `dynm` = l'etirement dynamique de
    ;; §22/38. Le premier existe parce qu'un `secm` colle a 0.0700 sur toutes les fenetres ne dit
    ;; pas s'il frole le plafond ou s'il le defonce d'un facteur dix : c'est la signature du
    ;; limiteur sature, et sans cette ligne elle est invisible.
    (format 0 "PHYSSHAPE3 c=~D a=~D d=~D secr=~f dynm=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 12)
            (phys-shape (-> self slot) c 13))
    ;; §23, cinquieme terme de sa liste : la PRESSION DE CONTACT. `prsr` est publie a cote de `prsm`
    ;; pour la meme raison que `secr` a cote de `secm` : un plafond touche partout n'est pas une
    ;; amplitude, et sans la valeur brute on ne peut pas le savoir.
    (format 0 "PHYSSHAPE4 c=~D a=~D d=~D prsm=~f prsr=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 19)
            (phys-shape (-> self slot) c 20))
    ;; §23/§22 — L'ELONGATION DU TISSU PORTEE PAR LE DEGRE DE LIBERTE RADIAL, sur cette fenetre.
    ;; Elle se lit CONTRE SA PROPRE BANDE, qui n'est pas celle de l'apex : « local tissue
    ;; elongation: common 5-15 %, large 15-21 %, exceptional 21-25 %, absolute clamp 25 % ».
    ;; `rrm` est le maximum de |elongation|/B0 sur la fenetre, `rr` sa valeur a l'instant de la
    ;; publication — les deux, parce qu'un maximum seul ne dit pas si l'oscillateur est encore
    ;; vivant a la fin de la fenetre ou s'il s'est eteint.
    ;; NATURE : deformation sans unite. REPERE : axe de l'os, triedre de l'ancre.
    ;; LIGNE DE BASE : 0.0 exactement au repos debout (§9).
    ;; `rrr` EST LE MEME MAXIMUM AVANT LA BORNE §22, et `sat` le nombre de frames ou elle a mordu.
    ;; Sans ces deux champs, un canal COLLE a sa borne rend le meme `rrm` qu'un canal qui l'effleure
    ;; — et c'est precisement cette confusion qui a laisse le canal de deformation atteindre son
    ;; plafond absolu sur LES DIX fenetres sans qu'aucune ligne ne le dise. Un limiteur qui mord en
    ;; permanence ne borne plus une mesure, il la remplace.
    ;; DEUX LIGNES, et ce n'est pas un choix de style : `format` de GOAL est cape a huit parametres
    ;; (meme raison qu'a `PHYSREST` ci-dessous, et la premiere ecriture de ce bloc l'a appris en
    ;; refusant de compiler). `sat` part donc sur sa propre ligne, ce qui tombe bien : c'est un
    ;; compteur GLOBAL au solveur, pas une grandeur par chaine.
    (format 0 "PHYSRAD c=~D a=~D d=~D rr=~f rrm=~f rrr=~f~%"
            c (-> self ai) (-> self drive)
            (phys-chain-radial (-> self slot) c 1)
            (phys-chain-radial (-> self slot) c 2)
            (phys-chain-radial (-> self slot) c 3))
    (format 0 "PHYSRADSAT c=~D d=~D sat=~f~%"
            c (-> self drive)
            (phys-chain-radial (-> self slot) c 4))))
  ;; SPEC 33/34 — LA RESTITUTION SUR CETTE FENETRE. Une ligne par fenetre, pas par chaine : les
  ;; compteurs sont globaux au solveur. `n` est le DOMAINE (contacts ou elle a mordu) ; sans lui,
  ;; `vin`/`vout` a zero ne distinguent pas « rien ne touche » de « rien ne s'applique ».
  ;; `m` = sorties effectivement RELUES a la frame suivante ; `esum/n` = le melange 0.06 / 0.02.
  ;; DEUX LIGNES, et ce n'est pas un choix de style : `format` de GOAL est cape a huit parametres,
  ;; destination et chaine comprises.
  (format 0 "PHYSREST a=~D d=~D n=~f m=~f vin=~f~%"
          (-> self ai) (-> self drive)
          (phys-rest 0) (phys-rest 4) (phys-rest 1))
  ;; `twsat` = les frames ou la saturation douce de la torsion (SPEC 29, bornee par l'enveloppe
  ;; d'apex de SPEC 38) a mordu. Un limiteur sans compteur est precisement ce que le contrat
  ;; interdit ; celui-ci publie combien de fois il agit, a cote de l'amplitude qu'il borne.
  (format 0 "PHYSREST2 a=~D d=~D vout=~f esum=~f twsat=~f~%"
          (-> self ai) (-> self drive)
          (phys-rest 2) (phys-rest 3)
          (phys-shape (-> self slot) 0 18))
  (none))

;; POSITION MOYENNE de la pointe dans le repere de l'ancre, axe par axe. Une ligne a part parce que
;; `format` est cape a six parametres et que ces trois-la doivent rester solidaires du tag.
(defbehavior physroom-emit-mean phys-subject ((tag string))
  (dotimes (c (-> self nchain))
    (when (> (phys-chain-links (-> self slot) c) 0)
      (format 0 "PHYSMEAN tag=~S c=~D x=~f y=~f z=~f~%"
              tag c
              (phys-tip-mean (-> self slot) c 0)
              (phys-tip-mean (-> self slot) c 1)
              (phys-tip-mean (-> self slot) c 2))
      ;; LE STIMULUS GRAVITAIRE DE LA MEME FENETRE, a cote de la reponse. Un affaissement nul avec
      ;; gn=0 dit « la gravite n'est pas arrivee » ; avec gn=1.0 et tf~0 il dit « elle est arrivee et
      ;; la geometrie de l'os l'annule » ; avec gn=1.0 et tf~1 il dit « la chaine n'y repond pas ».
      ;; Trois diagnostics differents que le seul `sag` confondait.
      (format 0 "PHYSGRAV tag=~S c=~D gn=~f tf=~f~%"
              tag c
              (phys-stat (-> self slot) c 18)
              (phys-stat (-> self slot) c 19))))
  (none))

(defbehavior physroom-emit-diag phys-subject ((tag string))
  "LES QUATRE DEFAUTS DE LA 6e PASSE, CHAINE PAR CHAINE. Un total global ne dit pas si ce sont les
   meches fines qui jittent ou les sangles de cheville : ces compteurs-la sont par chaine.
     selfcol  corrections venues d'un volume porte par les PROPRES joints de la chaine — ZERO
     retreat  reculs vers la pose du modele (le limiteur qui saute)
     flip     paires (lien, volume) ayant change d'etat de contrainte d'une frame a l'autre : la
              mesure du jitter lui-meme
     inv      inversions corrigees / invres inversions RESIDUELLES — ZERO
     elong    pire allongement RELATIF d'un lien (|l/l0 - 1|) — « les seins s'allongent »"
  (dotimes (c (-> self nchain))
    (when (> (phys-chain-links (-> self slot) c) 0)
      (format 0 "PHYSDIAG tag=~S c=~D selfcol=~f retreat=~f flip=~f~%"
              tag c
              (phys-diag (-> self slot) c 0)
              (phys-diag (-> self slot) c 1)
              (phys-diag (-> self slot) c 2))
      (format 0 "PHYSDIAG2 tag=~S c=~D inv=~f invres=~f elong=~f rad=~f~%"
              tag c
              (phys-diag (-> self slot) c 3)
              (phys-diag (-> self slot) c 4)
              (phys-diag (-> self slot) c 5)
              (phys-diag (-> self slot) c 6))
      ;; LES TROIS DEFAUTS DE LA 11e PASSE, chaine par chaine, chacun avec sa NATURE ecrite a cote
      ;; de lui parce qu'un chiffre sans nature est ce qui a produit les faux verts de la veille :
      ;;   bendcut  DEGRES retires par l'attenuation d'angle des CHEVEUX (un suppresseur, donc il
      ;;            se chiffre). Repere : l'attache du maillon. Zero quand la meche ne se replie
      ;;            jamais au-dela de la limite que le rig lui donne.
      ;;   shape    |p - T| / longueur de l'os, SANS DIMENSION : l'echelle de la deformation que le
      ;;            skinning lineaire impose a la chair. C'est « ca change de taille, plus petit,
      ;;            plus gros, ecrase ». Zero quand le maillon est a sa pose de modele.
      ;;   buried   paires (lien, volume) ou le lien est ENTIEREMENT dans un volume A SA POSE DE
      ;;            MODELE, comptees une fois par frame : un pan dont la pose est DANS la jambe n'a
      ;;            aucune surface a traverser, donc meshpen reste a zero pendant que l'owner le
      ;;            voit disparaitre (« comme si son pantacourt s'arretait aux genoux »). Zero
      ;;            quand la piece est dehors, la ou elle se voit.
      (format 0 "PHYSDIAG3 tag=~S c=~D bendcut=~f shape=~f buried=~f tiprot=~f~%"
              tag c
              (phys-diag (-> self slot) c 7)
              (phys-diag (-> self slot) c 8)
              (phys-diag (-> self slot) c 9)
              (phys-diag (-> self slot) c 10))
      ;;   side     paires (lien, volume) ou le lien est passe du COTE OPPOSE de l'axe du volume
      ;;            dans lequel sa pose de modele se trouvait. C'est ROOM-SIDE, reclame par les
      ;;            DIRECTIVES depuis la 11e passe et jamais ecrit jusqu'ici. Aucune autre colonne
      ;;            ne peut voir ce defaut : la profondeur de penetration est MAXIMALE sur l'axe et
      ;;            REDESCEND quand le lien ressort de l'autre cote, donc un lien qui a traverse de
      ;;            part en part rend une profondeur faible, indistinguable d'un lien sagement
      ;;            dehors. NATURE : un compte de paires (un changement de COTE est discret, une
      ;;            distance ne peut pas le decrire). REPERE : celui du VOLUME — direction du point
      ;;            le plus proche de son axe vers le lien, comparee entre la pose du modele et
      ;;            maintenant. LECTURE QUAND LE DEFAUT EST ABSENT : 0.
      (format 0 "PHYSDIAG4 tag=~S c=~D side=~f~%"
              tag c
              (phys-diag (-> self slot) c 11))
      ;;   volprio  paires (lien, volume) que la DECISION 1 a ECARTEES parce qu'un autre volume
      ;;            decidait deja pour ce lien cette frame. C'est le seul chiffre qui dise OU les
      ;;            volumes se contredisent, et il manquait : `ROOM-INVERSIONS residual=379`
      ;;            n'etait attribuable a aucune chaine. Une chaine dont ce compte est GRAND est
      ;;            une chaine que des volumes se disputaient, donc que le recul epinglait
      ;;            (kneeflapR : retreat 15913 frames sur 17893).
      ;;            NATURE : un compte de paires sur la fenetre. REPERE : sans objet.
      ;;            LECTURE QUAND LE DEFAUT EST ABSENT : 0 — aucun conflit, personne n'est ecarte.
      (format 0 "PHYSDIAG5 tag=~S c=~D volprio=~f~%"
              tag c
              (phys-diag (-> self slot) c 12))
      ;;   skinpen  (SPEC 18) la pire entree du lien SOUS LA VRAIE PEAU, en unites de jeu. A lire
      ;;            A COTE de `pen` : `pen` mesure contre les VOLUMES, qui ne representent que
      ;;            29.7 % de la geometrie pilotee (mesure du 2026-08-13, probe_skin_in_volume.py),
      ;;            et 0 % pour backhair et les deux pantflap. Un zero de `pen` ne dit donc rien
      ;;            de ce que l'owner voit ; `skinpen` mesure la meme position contre le mesh qui
      ;;            est DESSINE. NATURE : profondeur signee, positive = sous la peau. REPERE : le
      ;;            monde, a la frame ecrite. LECTURE HORS DEFAUT : 0.
      ;;            `tests` = echantillons reellement compares. Un skinpen nul avec tests=0 veut
      ;;            dire « je n'ai pas regarde » et se lit comme tel, jamais comme « rien ne passe ».
      (format 0 "PHYSSKIN tag=~S c=~D skinpen=~f tests=~D~%"
              tag c (phys-skinpen-worst (-> self slot) c) (phys-skintest-count))
      ;;   rootrot  l'angle, EN DEGRES, reellement ecrit dans la 3x3 du maillon `rootlock` — le
      ;;            PREMIER SEGMENT de la meche, celui qui part du cuir chevelu. Il valait 0.0000
      ;;            structurellement jusqu'a ce cycle : la boucle d'ecriture du moteur sautait tout
      ;;            `l < rlk`, donc ~50 % de la geometrie des cheveux (earL 82/158, backhair
      ;;            167/320, lmidhair 212/383 ...) etait soudee au crane et une meche a 2 joints se
      ;;            reduisait a un segment rigide articule EN SON MILIEU. C'est le residu de
      ;;            `hair-gradient` que ROOM-GRADIENT ne pouvait pas voir : sur une chaine a 2
      ;;            maillons la suite publiee est [0, x], et une suite de deux termes dont le
      ;;            premier est nul ne peut JAMAIS echouer a un test de croissance — la gate y etait
      ;;            vide de sens, sur 5 des 7 chaines de cheveux.
      ;;            NATURE : un angle (une ORIENTATION ecrite, pas une amplitude ni une variance).
      ;;            REPERE : la direction d'os du joint, pose du modele -> position simulee de son
      ;;            enfant, prise depuis SON ANCRE — donc son mouvement PROPRE, pas celui herite du
      ;;            crane. LECTURE QUAND LE DEFAUT EST PRESENT : 0.0000 exactement.
      ;;   raddropm LE PRIX DU MUR DUR D'EXCURSION, en unites de jeu cumulees sur la fenetre :
      ;;            l'excursion que le plafond `rmax` a RETIREE a cette chaine. Le compte
      ;;            (`raddrop`, colonne voisine) disait combien de fois le mur mordait ; il ne
      ;;            disait pas ce qu'il coutait, et SPEC 7 l'exige de tout suppresseur (« on
      ;;            chiffre combien de mouvement il retire »). La somme existait deja dans le
      ;;            moteur mais GLOBALE, donc imputable a aucune chaine.
      ;;            NATURE : une longueur CUMULEE (une somme d'ecarts retires), surtout pas une
      ;;            amplitude — elle croit avec la duree de la fenetre et ne se compare qu'entre
      ;;            chaines d'une MEME course. REPERE : ecart a la pose ANIMEE du lien, le meme
      ;;            que celui que le mur plafonne. LECTURE QUAND LE DEFAUT EST ABSENT : 0, et le
      ;;            mur n'a alors jamais mordu.
      (format 0 "PHYSDIAG6 tag=~S c=~D rootrot=~f raddropm=~f~%"
              tag c
              (phys-diag (-> self slot) c 14)
              (phys-diag (-> self slot) c 15))
      ;;   retfblen OU S'ALLONGE L'OS, ET DE COMBIEN — l'ATTRIBUTION de `elong` a un chemin precis.
      ;;            `elong` (PHYSDIAG2) dit qu'une chaine s'allonge, jamais OU. Cette colonne compte
      ;;            l'erreur de longueur laissee par LE REPLI de `phys-retreat-chain` : quand la
      ;;            sphere du modele est entierement fermee (aucune des 63 directions balayees n'est
      ;;            admissible), le repli garde `want = |auteur(kk) - attache SIMULEE|` au lieu de la
      ;;            longueur du modele, et c'est lui qui ecrit EN DERNIER dans la frame — l'os
      ;;            s'allonge donc d'exactement ce rapport.
      ;;            CE QUE LA MESURE A ETABLI (2026-08-13) : `retfblen` vaut 1.3163 sur `lmidhair` et
      ;;            1.2856 sur `rmidhair`, soit exactement leur `elong` de la meme course au
      ;;            dix-millieme, et 0.0000 sur les vingt autres chaines. Ce repli n'est donc pas UNE
      ;;            source de l'allongement, c'est LA source.
      ;;            ELLE N'EST PAS LE CONTROLE D'UN CORRECTIF : deux correctifs ont ete essayes a cet
      ;;            endroit le 2026-08-13 et la mesure les a REFUSES tous les deux (ils ramenaient
      ;;            STRETCH a 0.0003 en faisant monter `meshpen` a 0.2238 puis 0.2726 m et `ROOM-SIDE`
      ;;            a 1056 puis 1089 — regle 6). Le detail est dans `jak-hd-physics.gc`, meme branche.
      ;;            NATURE : un rapport sans dimension, |want/ml - 1| — un MAXIMUM sur la fenetre,
      ;;            pas un cumul. REPERE : aucun, une longueur sur une longueur prises depuis la
      ;;            meme attache. LECTURE QUAND LE DEFAUT EST ABSENT : 0, et le repli n'a alors
      ;;            jamais tire sur cette chaine.
      (format 0 "PHYSDIAG7 tag=~S c=~D retfblen=~f~%"
              tag c
              (phys-diag (-> self slot) c 16))))
  (none))

(defbehavior physroom-max-pen phys-subject ()
  (let ((m -1000000000.0))
    (dotimes (c (-> self nchain))
      (when (> (phys-chain-links (-> self slot) c) 0)
        (let ((p (phys-pen-col (-> self slot) c)))
          (when (> p m) (set! m p)))))
    m))

;; ------------------------------------------------------------------------------------------------
;; LE RAPPORT BRUT. Aucune conclusion ici : des nombres, et le script en fait un tableau. S'il
;; manque une preuve (un target apparu pendant la mesure), le nombre le dit et le script refuse
;; d'ecrire « joueur absent ».
;; ------------------------------------------------------------------------------------------------
;; L'AMPLITUDE DU STIMULUS de chaque pilotage, en unites de jeu par frame^2. C'est ce que la salle
;; COMMANDE, pas ce qu'elle observe : c'est le denominateur du gain de ROOM-RESPONSE. Sans lui,
;; comparer deux amplitudes de pointe obtenues sous deux stimuli differents ne veut rien dire — et
;; c'est precisement ce que faisait le tableau precedent.
;;   jerk    la vitesse est POSEE, pas accumulee : le stimulus est le pire saut de vitesse d'une
;;           frame a l'autre, (-240,0,190) -> (0,300,0), soit 434 u/frame^2.
;;   tilt    pose TENUE : plus aucune acceleration de repere. Le stimulus est la gravite elle-meme
;;           vue depuis l'ancre, 2 |g| sin(30 deg) = 11.16 u/frame^2 a 60 degres.
(defun physroom-stim-mag ((mode int))
  (case mode
    ((0) 18.0)
    ((1) 52.0)
    ((2) 96.0)
    ((3) 434.0)
    (else 11.16)))

(defbehavior physroom-report phys-subject ()
  (dotimes (d PHYSROOM-DRIVES)
    (format 0 "PHYSSTIM dr=~D mag=~f~%" d (physroom-stim-mag d)))
  (format 0 "PHYSNOPLAY viol=~D actors=~D killed=~D~%"
          (-> self viol) (-> self nactor) (-> self killed))
  (format 0 "PHYSCOUNTS anims=~D enum=~D chains=~D drives=~D ags=~D~%"
          (-> self nanim) (-> self nenum) (-> self nchain) PHYSROOM-DRIVES (-> self nag))
  (format 0 "PHYSKEY maxanim=~D drives=~D slot=~D hdpid=~D win=~D~%"
          PHYSROOM-MAXANIM PHYSROOM-DRIVES (-> self slot) (-> self hdpid) PHYSROOM-WIN)
  (format 0 "PHYSPC injections=~D armed=~f disarmed=~f~%"
          (-> self injn) (-> self arm) (-> self dis))
  ;; L'UNITE DE `atan`, MESUREE A L'EXECUTION ET PAS DEDUITE D'UNE LECTURE DE SOURCE (regle 0).
  ;; L'ecriture d'orientation du moteur passait `(* 57.2957795 (atan sin cos))` a
  ;; `matrix-axis-angle!` — une conversion radians->degres. Si `atan` rend des UNITES DE ROTATION,
  ;; cette multiplication fait tourner l'os 57 fois trop et `sin` replie ensuite modulo un tour :
  ;; toute chaine qui flechit ecrit alors une orientation fausse, sans qu'aucun chiffre de POSITION
  ;; puisse le voir. Les trois nombres tranchent, et ils se lisent sans rien savoir du moteur :
  ;;   atan45   = (atan 1 1). 8192 => 65536 unites par tour ; 0.7854 => des radians.
  ;;   sinq     = (sin 8192). 0.7071 => 8192 vaut bien 45 degres dans l'unite qu'accepte `sin`,
  ;;              donc dans celle qu'accepte `matrix-axis-angle!`, qui l'appelle.
  ;;   bad      = ce que l'ancienne ligne aurait passe pour ce meme angle de 45 degres.
  (format 0 "PHYSUNITS atan45=~f sinq=~f bad=~f~%"
          (atan 1.0 1.0) (sin 8192.0) (* 57.2957795 (atan 1.0 1.0)))
  (format 0 "PHYSEND~%")
  (none))

;; ------------------------------------------------------------------------------------------------
;; LA MACHINE A ETATS. Une frame = un pas.
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-tick phys-subject ()
  ;; la zone reste vide a chaque frame, et on compte ce qu'on y trouve.
  (let ((n (physroom-sweep (< (-> self phase) PHYSROOM-PH-REPORT))))
    (when (> n (-> self nactor)) (set! (-> self nactor) n))
    ;; une frame de MESURE contaminee par un target vivant est une violation. Les phases
    ;; d'amorcage ne comptent pas : c'est la qu'on nettoie.
    (when (and (> *physroom-ntarget* 0) (> (-> self phase) PHYSROOM-PH-SETTLE))
      (+! (-> self viol) 1)))

  (+! (-> self pframe) 1)

  (cond
    ;; ---- 0. AMORCAGE : attendre le compagnon HD et ses chaines -------------------------------
    ((= (-> self phase) PHYSROOM-PH-SETTLE)
     (physroom-hold)
     (physroom-advance-anim 1.0)
     (when (< (-> self slot) 0)
       (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
         (when (and hd (= (-> hd type) jak-hd))
           (set! (-> self hdpid) (the int (-> hd pid)))
           (set! (-> self slot) (phys-slot-of (the int (-> hd pid))))
           (when (>= (-> self slot) 0)
             (set! (-> self nchain) (phys-slot-chains (-> self slot)))))))
     (when (and (>= (-> self pframe) PHYSROOM-SETTLE) (> (-> self nchain) 0))
       ;; la topologie REELLEMENT resolue par le moteur, pas celle que le fichier promet, et la
       ;; longueur que le MODELE donne a chaque os : c'est le plafond geometrique de l'amplitude de
       ;; ce lien, publie pour que personne n'ait a la deviner. Publie EN FIN d'amorcage : les os du
       ;; compagnon ne portent une pose que quand son propre do-joint-math! a tourne, et le publier
       ;; a la frame de sa naissance ne donnait que des zeros (mesure du 2026-08-11).
       (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
         (when (and hd (= (-> hd type) jak-hd))
           (dotimes (c (-> self nchain))
             (let ((j0 (phys-chain-joint (-> self slot) c 0)))
               (format 0 "PHYSCHAIN c=~D links=~D fam=~D hang=~f j0=~S~%"
                       c
                       (phys-chain-links (-> self slot) c)
                       (phys-chain-family (-> self slot) c)
                       (phys-chain-hang (-> self slot) c)
                       (if (and (>= j0 0) (nonzero? (-> hd draw)) (nonzero? (-> hd draw jgeo)))
                         (-> hd draw jgeo data j0 name)
                         "?")))
             ;; LE TRIEDRE DE SPEC 24/29, TEL QUE LE SOLVEUR L'A CLASSE — et les trois facteurs de
             ;; raideur qu'il a REELLEMENT appliques, pas ceux qu'une constante annonce.
             ;; NATURE : des index de ligne (sans unite) et des facteurs multiplicatifs (sans
             ;; unite). REPERE : les lignes de la matrice de l'ANCRE. LIGNE DE BASE : `ok=0` avec
             ;; les trois facteurs a 1.000 = chaine non classee, donc integration isotrope, donc
             ;; bit pour bit celle d'avant l'anisotropie.
             ;; `sv/sap/slat` sont `1/mobilite` de sa §29 : 1.000 / 1.111 / 1.220 attendus.
             ;; DEUX LIGNES, ET CE N'EST PAS UN CHOIX DE STYLE : `format` de GOAL n'accepte pas
             ;; plus de huit parametres, destination et chaine de format comprises (meme plafond
             ;; que `PHYSGRADS` et `PHYSRINGA`). Huit champs ne tiennent pas sur une ligne.
             ;; `ok` = CLASSEE (la mesure par axe tourne) ; `arm` = raideur par axe ARMEE. Les deux
             ;; sont publies separement parce qu'ils ne disent pas la meme chose : aujourd'hui
             ;; ok=1 arm=0 sur les deux seins, et c'est exactement l'etat que la directive du
             ;; 09:45 decrit — mesure oui, application non, tant que la structure est un point.
             (format 0 "PHYSAXIS c=~D ok=~D arm=~D rv=~D rap=~D rlat=~D~%"
                     c
                     (phys-chain-axis (-> self slot) c 0)
                     (phys-chain-axis (-> self slot) c 4)
                     (phys-chain-axis (-> self slot) c 1)
                     (phys-chain-axis (-> self slot) c 2)
                     (phys-chain-axis (-> self slot) c 3))
             (format 0 "PHYSAXISS c=~D sv=~f sap=~f slat=~f~%"
                     c
                     (phys-chain-axis-stiff (-> self slot) c 0)
                     (phys-chain-axis-stiff (-> self slot) c 1)
                     (phys-chain-axis-stiff (-> self slot) c 2))
             ;; CE QUI A NOMME LES AXES, ET AVEC QUELS CHIFFRES. Le cycle 9 a trouve que les roles
             ;; `ap` et `lat` etaient INTERVERTIS : §29 posait 0.90 sur le lateral et 0.82 sur
             ;; l'avant-arriere, §24 comparait 2.50/2.65 Hz aux mauvais axes, et RIEN ne pouvait le
             ;; signaler — une mesure par axe qui ne publie que des VALEURS ne peut pas attraper une
             ;; permutation de ses propres axes. Il faut une grandeur dont la reponse est connue
             ;; D'AVANCE par la geometrie : le segment qui va d'un sein a l'autre est lateral par
             ;; anatomie. Il doit donc tomber ENTIEREMENT sur la ligne nommee `lat`.
             ;; NATURE : deux longueurs signees et une norme, en unites de jeu. REPERE : le triedre
             ;; de l'ANCRE. LIGNE DE BASE : `src=0` et trois zeros = pas de chaine partenaire, le
             ;; nommage est retombe sur la protrusion propre de l'organe.
             ;; CE QUI DISCRIMINE : `slat` doit porter ~712 u (17.4 cm mesures sur le rig) et `sap`
             ;; ~0. Si les deux sont du meme ordre, la separation ne designe rien et le verdict de
             ;; nommage est sans valeur — a lire avant toute conclusion sur §24 ou §29.
             (format 0 "PHYSAXNAME c=~D src=~D rlat=~D sja=~f sjb=~f len=~f~%"
                     c
                     (phys-chain-axis (-> self slot) c 5)
                     (phys-chain-axis (-> self slot) c 3)
                     (phys-chain-axsep (-> self slot) c 0)
                     (phys-chain-axsep (-> self slot) c 1)
                     (phys-chain-axsep (-> self slot) c 2))
             ;; LE SENS DU TRIEDRE, PAS SEULEMENT SES INDICES. `PHYSAXIS` dit QUELLE ligne porte
             ;; l'avant-arriere ; il ne dit pas dans quel SENS elle pointe, et c'est ce sens seul
             ;; qui separe supine de prone — donc qui decide lequel des deux triplets de §10/§11
             ;; s'applique. Voir la note de `phys-tri-world` : la mesure qui a fixe ce signe date
             ;; d'une epoque ou `axa` valait 0, et la course publie aujourd'hui `rap=2`.
             ;; NATURE : cosinus directeurs, sans unite. REPERE : MONDE — les memes axes que
             ;; `PHYSAXW`, pour que `fz . ligne[rap]` se calcule sur la trace sans rien supposer.
             ;; LIGNE DE BASE : trois zeros = triedre non releve (`fok=0`), aucune conclusion.
             (format 0 "PHYSTRI c=~D a=2 x=~,,5f y=~,,5f z=~,,5f~%"
                     c
                     (phys-tri-world (-> self slot) c 2 0)
                     (phys-tri-world (-> self slot) c 2 1)
                     (phys-tri-world (-> self slot) c 2 2))
             (format 0 "PHYSTRI c=~D a=1 x=~,,5f y=~,,5f z=~,,5f~%"
                     c
                     (phys-tri-world (-> self slot) c 1 0)
                     (phys-tri-world (-> self slot) c 1 1)
                     (phys-tri-world (-> self slot) c 1 2))
             ;; LES LIGNES DE L'ANCRE AU MEME INSTANT, par ROLE (0=vertical, 1=AP, 2=lateral) —
             ;; `PHYSAXW` publie les memes vecteurs, mais dans une phase ULTERIEURE et sous une
             ;; autre pose. Comparer `fz` a une ligne relevee 3000 frames plus tard n'aurait aucun
             ;; sens ; ces deux lignes-ci sont lues sur LA MEME frame que `PHYSTRI`.
             (format 0 "PHYSAXR c=~D a=1 x=~,,5f y=~,,5f z=~,,5f~%"
                     c
                     (phys-axis-world (-> self slot) c 1 0)
                     (phys-axis-world (-> self slot) c 1 1)
                     (phys-axis-world (-> self slot) c 1 2))
             (format 0 "PHYSAXR c=~D a=0 x=~,,5f y=~,,5f z=~,,5f~%"
                     c
                     (phys-axis-world (-> self slot) c 0 0)
                     (phys-axis-world (-> self slot) c 0 1)
                     (phys-axis-world (-> self slot) c 0 2))
             (dotimes (l (phys-chain-links (-> self slot) c))
               (format 0 "PHYSBONE c=~D l=~D len=~f~%"
                       c l (phys-chain-bone hd (-> self slot) c l))
               ;; QUELS JOINTS CETTE CHAINE ECRIT REELLEMENT. Verdict owner du 2026-08-11 : « un
               ;; polygone de la semelle de la chaussure gauche se fait la malle » et « les
               ;; languettes des bandes de genoux ne bougent pas du tout » — les deux se decident
               ;; sur la liste des joints ECRITS, pas sur une intention dans les donnees.
               (let ((j (phys-chain-joint (-> self slot) c l)))
                 (format 0 "PHYSJOINT c=~D l=~D idx=~D name=~S~%"
                         c l j
                         (if (and (>= j 0) (nonzero? (-> hd draw)) (nonzero? (-> hd draw jgeo)))
                           (-> hd draw jgeo data j name)
                           "?"))))
             ;; LES VOLUMES QUE LE MOTEUR A RESOLUS, par nom de joint : sans eux un zero de
             ;; penetration ne prouve rien (le tableau annoncait zero alors qu'aucun collider de
             ;; buste n'existait et que l'owner voyait les bretelles traverser le torse).
             (when (zero? c)
               (dotimes (ci (phys-slot-colliders (-> self slot)))
                 (let ((j  (phys-collider-field (-> self slot) ci 0))
                       (j2 (phys-collider-field (-> self slot) ci 1)))
                   (format 0 "PHYSCOL ci=~D j=~S j2=~S~%"
                           ci
                           (if (and (>= j 0) (nonzero? (-> hd draw jgeo)))
                             (-> hd draw jgeo data j name) "?")
                           (if (and (>= j2 0) (nonzero? (-> hd draw jgeo)))
                             (-> hd draw jgeo data j2 name) "-"))))))))
       ;; LE SQUELETTE EST-IL SEULEMENT POSE ? Une course device du 2026-08-11 a publie 1584
       ;; lignes a ZERO partout avec 13 millions de paires « lien entierement dans le volume » :
       ;; les os du compagnon etaient restes a l'ORIGINE (il n'avait jamais ete rendu, donc son
       ;; do-joint-math! n'avait jamais tourne). Des zeros pris sur un squelette non pose ne
       ;; mesurent rien, et un tableau qui les publie est un faux vert. On refuse de mesurer.
       (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
         (when (and hd (= (-> hd type) jak-hd) (nonzero? (-> hd draw))
                    (nonzero? (-> hd draw skeleton)))
           (let* ((skel (-> hd draw skeleton))
                  (a (phys-chain-joint (-> self slot) 0 0))
                  (d (if (and (>= a 0) (< (+ a 1) (-> skel length)))
                       (vector-length (the-as vector (-> skel bones (+ a 1) transform vector 3)))
                       0.0)))
             (format 0 "PHYSPOSED joint0=~D dist-from-origin=~f~%" a d)
             (when (< d 1.0)
               (format 0 "PHYSFAIL reason=skeleton-not-posed-bones-at-origin~%")
               (set! (-> self phase) PHYSROOM-PH-DONE)))))
       (phys-auth-reset!)
       ;; MESURER LE CONFLIT ENTRE VOLUMES SANS L'ARBITRER. La priorite (DECISION 1) reste DESARMEE
       ;; — elle a ete retiree sur mesure, parce qu'ecarter un volume deplace le conflit au lieu de
       ;; le resoudre et fait TRAVERSER (DIRECTIVES regle 6). Mais ses compteurs vivaient DANS la
       ;; branche desarmee, donc `ROOM-VOLPRIO` publiait `pairs_ignored=0 chains=0` : un zero tire
       ;; d'un domaine vide, qui se lit comme « les volumes ne se contredisent plus ». La salle arme
       ;; donc la passe de SELECTION seule : elle compte, elle ne decide pas. Le jeu, lui, ne l'arme
       ;; jamais et ne paie pas la passe.
       (phys-prio-meas-set! 1)
       (phys-limiter-reset!)
       (phys-inversions-reset!)
       (phys-skin-meas-set! 1)
       (phys-skinpen-reset!)
       (phys-diag-reset!)
       (set! (-> self phase) PHYSROOM-PH-MEAS)
       (set! (-> self pframe) 0)
       (set! (-> self ai) 0)
       (set! (-> self drive) 0)
       (physroom-set-anim 0)
       (phys-stats-reset!)))

    ;; ---- 1. MESURE : toutes les animations x les quatre pilotages -----------------------------
    ((= (-> self phase) PHYSROOM-PH-MEAS)
     (if (>= (-> self drive) PHYSROOM-DRIVES)
       (physroom-hold)                                  ;; sous-fenetre de LIGNE DE BASE
       (physroom-drive (-> self drive) (-> self pframe)))
     (physroom-advance-anim 1.0)
     ;; AUCUNE FENETRE NE COMMENCE SUR UNE DISCONTINUITE (voir PHYSROOM-MEASAT). Les 54 premieres
     ;; frames absorbent le saut d'entree — changement d'animation, retour a la verticale, retour au
     ;; point de depart — et pour `tilt` elles contiennent en plus la rampe qui l'amene a 60 degres.
     ;; Meme regle pour les six sous-fenetres : les amplitudes restent comparables entre elles.
     (when (= (-> self pframe) PHYSROOM-MEASAT) (phys-stats-reset!))
     (when (>= (-> self pframe) PHYSROOM-WIN)
       (physroom-emit-window)
       (set! (-> self pframe) 0)
       (+! (-> self drive) 1)
       (when (>= (-> self drive) PHYSROOM-SUBW)
         (set! (-> self drive) 0)
         (+! (-> self ai) 1)
         (when (< (-> self ai) (-> self nanim)) (physroom-set-anim (-> self ai))))
       (cond
         ((>= (-> self ai) (-> self nanim))
          ;; le bilan par chaine de TOUTE la course de mesure, avant que les phases de controle
          ;; ne viennent s'y ajouter.
          (physroom-emit-diag "run")
          (phys-diag-reset!)
          (set! (-> self phase) PHYSROOM-PH-RESP)
          (set! (-> self lvl) 0)
          (physroom-set-anim 0)
          (phys-stats-reset!))
         (else
          (phys-stats-reset!)))))

    ;; ---- 2. LA COURBE DE REPONSE (6e passe : « trop statiques sur les mouvements faibles, trop
    ;; ---- hysteriques sur les brusques »). Meme animation figee, meme chaine, meme fenetre : la
    ;; ---- SEULE chose qui change d'un niveau au suivant est l'amplitude de l'excitation. Une
    ;; ---- marche dans la courbe designe un seuil ; une droite dit qu'il n'y en a pas.
    ((= (-> self phase) PHYSROOM-PH-RESP)
     (physroom-drive-exc (-> self pframe) (physroom-exc-level (-> self lvl)))
     ;; la premiere moitie du niveau est un ETABLISSEMENT, pas une mesure : sans elle le niveau 0
     ;; lisait la fin d'oscillation de la phase precedente (amplitude 0.62 m pour une excitation de
     ;; 1.5 u/frame^2, soit un gain de reference faux, donc une courbe fausse).
     (when (= (-> self pframe) (/ PHYSROOM-RESPW 2)) (phys-stats-reset!))
     (when (>= (-> self pframe) PHYSROOM-RESPW)
       (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
           (format 0 "PHYSRESP c=~D lvl=~D exc=~f amp=~f jump=~f~%"
                   c (-> self lvl) (physroom-exc-level (-> self lvl))
                   (phys-tip-amp (-> self slot) c)
                   (phys-stat (-> self slot) c 2))))
       (set! (-> self pframe) 0)
       (+! (-> self lvl) 1)
       (phys-stats-reset!)
       (when (>= (-> self lvl) PHYSROOM-RESPL)
         (set! (-> self phase) PHYSROOM-PH-IDLE))))

    ;; ---- 3. LE REPOS : immobile, animation figee. La cible de l'ecart ne bouge plus, donc au
    ;; ---- repos l'ecart a la pose du modele doit tendre vers zero (SPEC section 4), sauf pour ce
    ;; ---- qui doit pendre (hang > 0), compte a part.
    ((= (-> self phase) PHYSROOM-PH-IDLE)
     (physroom-hold)
     ;; ---- LE RING-DOWN, FRAME PAR FRAME (defaut `hair-pudding`, owner 2026-08-13) ------------
     ;; « la gelatine c'est plus du pudding, c'est pas trop lent et mou, c'est vraiment pas
     ;; coherent... On dirait les mouvements quand on tape sur un pudding, pas des mouvements
     ;; naturels de cheveux ! »
     ;;
     ;; NATURE : une forme de reponse DANS LE TEMPS — la decroissance libre apres l'arret du
     ;;   stimulus, et le retard de phase d'un maillon sur son parent. Ce n'est PAS une amplitude :
     ;;   un pudding et une chaine de cheveux peuvent bouger AUTANT, ce qui les separe est la forme.
     ;;   Un scalaire d'amplitude par chaine ne peut donc structurellement pas voir ce defaut.
     ;; REPERE : LOCAL — la deviation angulaire du maillon PAR RAPPORT A SON PARENT, en degres,
     ;;   telle que `phys-link-ang` la publie. Jamais le monde, ou une pointe soudee a son parent
     ;;   afficherait le grand chiffre de son parent (la faute de la 10e passe).
     ;; LIGNE DE BASE : `lbang`/`rbang`, mesurees dans la MEME course. C'est le controle apparie de
     ;;   l'owner — meme moteur, meme salle : il APPROUVE les meches fines et REJETTE les grosses,
     ;;   donc la cible est la valeur MESUREE sur les fines, jamais un nombre choisi.
     ;; RESERVE : `ang` est un MODULE (toujours positif), le signal est donc REDRESSE — la frequence
     ;;   apparente vaut le DOUBLE de la reelle, une oscillation libre laisse DEUX minima, et le
     ;;   retard n'est determine que MODULO une demi-periode.
     ;;
     ;; POURQUOI ON IMPRIME PUIS ON REMET A ZERO, DANS CET ORDRE — c'est ce qu'une relecture casse
     ;; en premier : `*phys-la*` est un MAXIMUM COURANT, pas un instantane. Ce qu'on lit ici est
     ;; donc le maximum accumule DEPUIS LE RESET DE LA FRAME PRECEDENTE, c'est-a-dire la valeur de
     ;; cette frame-la. Toutes les chaines doivent etre imprimees AVANT le reset, sinon les
     ;; dernieres liraient un compteur deja vide. D'ou : une seule remise a zero, apres la boucle.
     ;; Et c'est `phys-ang-reset!` (etroit) et surtout PAS `phys-stats-reset!` : ce dernier remet
     ;; aussi `stat 0` et `*phys-thas*` a zero, ce qui maintiendrait la garde de `phys-link-ang`
     ;; baissee en permanence et rendrait un mur de `ang=0.0`.
     ;; `pframe` est incremente EN TETE de `physroom-tick`, donc `f` va de 1 a PHYSROOM-IDLES-1 :
     ;; le tableau trie et travaille en offset relatif au premier `f`.
     (when (< (-> self pframe) PHYSROOM-IDLES)
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (dotimes (l (phys-chain-links (-> self slot) c))
           (format 0 "PHYSRING c=~D f=~D l=~D ang=~f~%"
                   c (-> self pframe) l (phys-link-ang (-> self slot) c l))
           ;; LA MEME DEVIATION, SIGNEE ET VECTORIELLE — voir la note de `*phys-lsv*`.
           ;; NATURE : un vecteur `u_courant - u_modele`, tous deux unitaires depuis la MEME
           ;;   attache ; sa norme vaut 2 sin(theta/2), sa direction porte la PHASE que `ang`
           ;;   detruit. REPERE : le MONDE, et il n'est immobile QUE dans cette fenetre-ci
           ;;   (`physroom-hold` fige position, orientation et animation) — c'est pourquoi elle
           ;;   n'est publiee nulle part ailleurs. LECTURE QUAND LE DEFAUT EST ABSENT : (0,0,0).
           ;; Sans elle, une periode plane et une precession rendent la MEME colonne de chiffres,
           ;; et trois cycles ont conclu trois choses differentes de la meme trace.
           (format 0 "PHYSRING3 c=~D f=~D l=~D x=~f y=~f z=~f~%"
                   c (-> self pframe) l
                   (phys-link-dev (-> self slot) c l 0)
                   (phys-link-dev (-> self slot) c l 1)
                   (phys-link-dev (-> self slot) c l 2))
           ;; LA MEME DEVIATION, MAIS PROJETEE PAR AXE DANS LE REPERE DE L'ANCRE — c'est ce que
           ;; SPEC 24 exige, et c'est la seule forme qui puisse le rendre : elle demande TROIS
           ;; frequences propres (vertical 2.30 Hz, avant-arriere 2.50 Hz, lateral 2.65 Hz), et une
           ;; serie projetee sur son axe principal ne peut en rendre qu'UNE, celle de l'axe
           ;; dominant. SPEC 7 fixe le repere : « all dynamic calculations shall occur relative to
           ;; the torso/root transform rather than directly in world space ».
           ;;
           ;; NATURE : deplacement instantane signe du maillon par rapport a sa pose d'auteur — une
           ;;   SERIE TEMPORELLE, pas une amplitude agregee.
           ;; REPERE : triedre orthonorme de l'ANCRE (torse), jamais le monde : un maillon herite du
           ;;   mouvement de son parent, et c'est en repere monde que son mouvement propre devient
           ;;   illisible.
           ;; LIGNE DE BASE : la serie vaut 0 sur toute sa longueur quand la chaine est exactement
           ;;   sur la pose d'auteur.
           ;;
           ;; `v` = axe 0 (vertical), `ap` = axe 1 (avant-arriere), `lat` = axe 2 (lateral).
           ;; LIGNE SEPAREE, et ce n'est pas un choix de style : `format` de GOAL n'accepte pas plus
           ;; de huit parametres, destination et chaine de format comprises (cf. la note de
           ;; `PHYSGRADS` plus haut). Celle-ci en fait exactement huit : c'est le plafond, aucun
           ;; champ ne peut y etre ajoute.
           ;; SEPT DECIMALES, ET C'EST UNE CORRECTION D'INSTRUMENT MESUREE. `~f` en imprime quatre,
           ;; soit un pas de quantification de 1e-4 ; la serie LATERALE vaut 1e-3 a 7.6e-3, donc
           ;; un a deux chiffres significatifs, et elle ne prend que 33 valeurs distinctes sur 149
           ;; echantillons. Le bruit de quantification qui en resulte (rms 2.9e-5) faisait 16 a
           ;; 28 % du residu d'ajustement qui a fait declarer l'axe lateral « non lisible ».
           ;; On ne peut pas conclure sur une bande de 4 % avec un instrument qui quantifie a 10 %.
           (format 0 "PHYSRINGA c=~D f=~D l=~D v=~,,7f ap=~,,7f lat=~,,7f~%"
                   c (-> self pframe) l
                   (phys-link-dev-anc (-> self slot) c l 0)
                   (phys-link-dev-anc (-> self slot) c l 1)
                   (phys-link-dev-anc (-> self slot) c l 2))
           ;; ET L'ATTRIBUTION PAR ETAGE, LA MEME FRAME : `a0` = l'angle que L'INTEGRATION SEULE
           ;; produit, `a1` = ce qu'il reste apres la boucle de contraintes et l'attenuation.
           ;; `a0 - a1` EST, en degres et par frame, ce que les contraintes retirent — la seule
           ;; facon de separer « le solveur n'oscille pas » de « quelque chose vide l'oscillation ».
           (format 0 "PHYSRINGS c=~D f=~D l=~D a0=~f a1=~f~%"
                   c (-> self pframe) l
                   (phys-link-ang-stage (-> self slot) c l 0)
                   (phys-link-ang-stage (-> self slot) c l 1)))))
       (phys-ang-reset!))
     ;; frame-num CONSTANTE : la pose d'auteur est immobile, c'est ca « la pose du modele ».
     (when (= (-> self pframe) PHYSROOM-IDLES) (phys-stats-reset!))
     (when (>= (-> self pframe) (+ PHYSROOM-IDLES PHYSROOM-IDLEM))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSIDLE c=~D dev=~f hang=~f amp=~f fam=~D~%"
                 c
                 (phys-stat (-> self slot) c 5)
                 (phys-chain-hang (-> self slot) c)
                 (phys-tip-amp (-> self slot) c)
                 (phys-chain-family (-> self slot) c))))
       ;; ---- SPEC 9 : POURQUOI L'ETAT DEBOUT N'EST PAS NEUTRE. `PHYSIDLE dev` dit QUE l'ecart
       ;; ---- existe (23.86 / 19.40 u la ou sa SPEC 9 exige 0.0000) ; il ne dit pas D'OU il vient,
       ;; ---- et deux mecanismes le produiraient a l'identique : un terme moteur non nul au repos,
       ;; ---- ou une cible elastique qui n'est pas la pose d'auteur. `PHYSRINGS a0=1.3975
       ;; ---- a1=1.3993` a deja tranche que ce n'est PAS la boucle de contraintes (elle n'ajoute
       ;; ---- que 0.0018 deg) : c'est donc une FORCE, et la seule qui subsiste au repos est
       ;; ---- `gsc * g_effective`.
       ;;
       ;; NATURE : un rapport sans dimension, |g_local - g_ref| / |g| — l'AMPLITUDE DU STIMULUS
       ;;   gravitaire, pas la reponse. C'est le meme `*phys-st*` 18 que ROOM-GRAVSAG publie pour
       ;;   l'inclinaison ; ici il est lu sur la fenetre de REPOS, ou personne ne l'avait lu.
       ;; REPERE : celui de l'ancre (SPEC 7), comme `gl` dont il est tire.
       ;; LIGNE DE BASE, ET C'EST TOUT L'INTERET : la SPEC 3 la donne elle-meme — « standing still
       ;;   gives g_local = g_ref [...] therefore a_drive = 0 ». Debout, ce nombre DOIT valoir 0 ;
       ;;   a 60 degres il vaut ~1.0 (mesure : 0.8326). Un `gn` non nul dans cette fenetre-ci EST
       ;;   la cause de SPEC 9, lue a l'execution, et non plus deduite du source.
       ;; `tf` est sa part TANGENTIELLE : la part radiale ne peut produire aucun deplacement
       ;;   angulaire, donc c'est `gn * tf` qui porte l'ecart, pas `gn` seul.
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSIDLEG c=~D gn=~f tf=~f~%"
                 c (phys-stat (-> self slot) c 18) (phys-stat (-> self slot) c 19))))
       ;; la POSITION MOYENNE debout : c'est le terme `at0` de ROOM-GRAVSAG.
       (physroom-emit-mean "idle")
       (set! (-> self phase) PHYSROOM-PH-TILT)
       (set! (-> self pframe) 0)
       (phys-stats-reset!)))

    ;; ---- 4. ELLE SE PENCHE, ET ON TIENT LA POSE. Meme animation figee, meme chaine, meme duree
    ;; ---- que le repos : la SEULE difference est l'inclinaison du tronc. Une gravite exprimee dans
    ;; ---- le repere de l'ancre ne deplace rien quand elle est droite et agit des qu'elle penche,
    ;; ---- donc l'ecart a la pose du modele doit MONTER ici et nulle part ailleurs. C'est la mesure
    ;; ---- que reclame la 6e passe : « aucun mouvement quand elle se penche en avant pour souder ».
    ((= (-> self phase) PHYSROOM-PH-TILT)
     (physroom-lean PHYSROOM-TILTDEG)
     ;; ---- SPEC 24 — LA MEME SERIE, MAIS SOUS UNE EXCITATION DE DIRECTION DIFFERENTE ----------
     ;; Le refit du ring-down de REPOS donne la MEME demi-periode sur `v` et `ap` (13 frames), et
     ;; les MEMES croisements de zero : dans cette fenetre-la la poitrine fait un balancement PLAN,
     ;; donc deux projections d'un seul vecteur oscillant selon une direction fixe. Une seule
     ;; frequence peut en sortir, quelles que soient les raideurs par axe — et §29 est pourtant bien
     ;; armee (`sap 1.1111`, `slat 1.2195` lus a l'execution). Ce n'est donc pas le solveur qui ne
     ;; separe pas les trois modes de sa §24, c'est L'EXCITATION.
     ;;
     ;; Cette phase en fournit une SECONDE, gratuitement et sans rien ajouter au solveur : les 60
     ;; degres sont rendus en UNE frame (voir la note de `physroom-hold`), donc le debut de la
     ;; fenetre est une IMPULSION, et son azimut dans le plan tangent de l'ancre n'a aucune raison
     ;; d'etre celui du residu de la fenetre de repos. Deux directions d'excitation, deux ring-downs
     ;; a comparer : si les demi-periodes DIFFERENT, l'anisotropie de §29 est demontree a
     ;; l'execution ; si elles sont egales, c'est que la raideur par axe n'atteint pas la reponse,
     ;; et il faudra une impulsion par axe.
     ;;
     ;; NATURE / REPERE / LIGNE DE BASE : identiques a `PHYSRINGA` de la fenetre de repos (voir sa
     ;; note) — deviation signee du maillon a sa pose d'auteur, projetee sur le triedre de l'ANCRE
     ;; (SPEC 7), nulle sur toute sa longueur quand la chaine est sur la pose d'auteur. Le seul
     ;; changement est le CHEMIN parcouru avant la fenetre, ce qui est precisement la variable.
     ;; Le suffixe `T` distingue les deux fenetres : les melanger rendrait le refit ininterpretable.
     (when (< (-> self pframe) PHYSROOM-IDLES)
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (dotimes (l (phys-chain-links (-> self slot) c))
           ;; meme correction de resolution que `PHYSRINGA` — voir sa note.
           (format 0 "PHYSRINGAT c=~D f=~D l=~D v=~,,7f ap=~,,7f lat=~,,7f~%"
                   c (-> self pframe) l
                   (phys-link-dev-anc (-> self slot) c l 0)
                   (phys-link-dev-anc (-> self slot) c l 1)
                   (phys-link-dev-anc (-> self slot) c l 2))))))
     (when (= (-> self pframe) PHYSROOM-IDLES) (phys-stats-reset!))
     (when (>= (-> self pframe) (+ PHYSROOM-IDLES PHYSROOM-IDLEM))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSTILT c=~D deg=~f dev=~f amp=~f fam=~D~%"
                 c PHYSROOM-TILTDEG
                 (phys-stat (-> self slot) c 5)
                 (phys-tip-amp (-> self slot) c)
                 (phys-chain-family (-> self slot) c))))
       ;; la POSITION MOYENNE penchee a 60 degres : c'est le terme `at60` de ROOM-GRAVSAG, et
       ;; l'ecart avec `at0` EST la reponse a la gravite. Rien d'autre n'a change entre les deux
       ;; phases : meme animation figee, meme position, meme duree, meme amortissement — seule
       ;; l'orientation de l'ancre differe.
       (physroom-emit-mean "tilt")
       (set! (-> self phase) PHYSROOM-PH-BACK)
       (set! (-> self pframe) 0)
       (phys-stats-reset!)))

    ;; ---- 4 bis. ELLE SE REDRESSE, ET ON TIENT LA POSE. Le cycle 0 -> 60 -> 0 est ferme ici, et
    ;; ---- c'est la seule phase qui puisse voir l'hysteresis que l'owner decrit (voir la note de
    ;; ---- PHYSROOM-PH-BACK). Copie conforme de PHYSROOM-PH-IDLE : meme appel, meme etablissement,
    ;; ---- meme fenetre, meme emetteur. Seul le CHEMIN parcouru avant differe.
    ((= (-> self phase) PHYSROOM-PH-BACK)
     (physroom-hold)
     (when (= (-> self pframe) PHYSROOM-IDLES) (phys-stats-reset!))
     (when (>= (-> self pframe) (+ PHYSROOM-IDLES PHYSROOM-IDLEM))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSBACK c=~D dev=~f hang=~f amp=~f fam=~D~%"
                 c
                 (phys-stat (-> self slot) c 5)
                 (phys-chain-hang (-> self slot) c)
                 (phys-tip-amp (-> self slot) c)
                 (phys-chain-family (-> self slot) c))))
       ;; la POSITION MOYENNE redressee, APRES l'aller-retour. Son ecart avec `idle` EST
       ;; l'hysteresis ; son ecart avec `tilt` est la part du sag qui a bien ete rendue.
       (physroom-emit-mean "back")
       (set! (-> self phase) PHYSROOM-PH-AXV)
       (set! (-> self ori) 0)
       (set! (-> self pframe) 0)
       (phys-stats-reset!)))

    ;; ---- 4 ter. SPEC 24/25/26/27 — UNE IMPULSION ISOLEE PAR AXE, PUIS ON LACHE.
    ;; Les trois phases sont IDENTIQUES a l'axe pres, et c'est voulu : trois series produites par
    ;; le meme chemin de code se comparent entre elles sans qu'aucun ecart puisse venir de
    ;; l'instrument. Voir la note de `physroom-drive-imp` pour la forme de l'impulsion et pour le
    ;; choix de l'amplitude (bande LINEAIRE — une frequence propre est une propriete du systeme
    ;; linearise ; sous saturation §21 on lirait le limiteur).
    ;;
    ;; NATURE : une SERIE TEMPORELLE de deplacement signe du maillon par rapport a sa pose
    ;;   d'auteur, projetee sur les trois axes. Ce n'est pas une amplitude agregee.
    ;; REPERE : le triedre orthonorme de l'ANCRE (torse) — le meme que `PHYSRINGA`, donc les
    ;;   valeurs des deux fenetres sont directement comparables. Jamais le monde.
    ;; LIGNE DE BASE : la serie vaut 0 partout quand la chaine est exactement sur la pose d'auteur.
    ;; CE QUI DISCRIMINE : l'axe EXCITE. Si les trois fenetres rendaient la meme frequence, c'est
    ;;   que l'anisotropie de §29 n'atteint pas le solveur — le contraire du resultat qu'on cherche
    ;;   a confirmer, et c'est bien ce qui rend la mesure decidable.
    ((or (= (-> self phase) PHYSROOM-PH-AXV)
         (= (-> self phase) PHYSROOM-PH-AXB)
         (= (-> self phase) PHYSROOM-PH-AXL)
         (= (-> self phase) PHYSROOM-PH-AXZV)
         (= (-> self phase) PHYSROOM-PH-AXZB)
         (= (-> self phase) PHYSROOM-PH-AXZL))
     (let ((ax (cond ((or (= (-> self phase) PHYSROOM-PH-AXV)
                          (= (-> self phase) PHYSROOM-PH-AXZV)) 0)
                     ((or (= (-> self phase) PHYSROOM-PH-AXB)
                          (= (-> self phase) PHYSROOM-PH-AXZB)) 1)
                     (else 2)))
           ;; les trois fenetres Z sont les MEMES que les trois premieres, contrainte de longueur
           ;; en moins : meme impulsion, meme amplitude, meme fenetre, meme emetteur. C'est ce qui
           ;; rend la comparaison des deux selectivites lisible — un seul terme change.
           (nolen (if (or (= (-> self phase) PHYSROOM-PH-AXZV)
                          (= (-> self phase) PHYSROOM-PH-AXZB)
                          (= (-> self phase) PHYSROOM-PH-AXZL)) 1 0)))
       (phys-len-off-set! nolen)
       (physroom-drive-imp (-> self pframe) ax)
       ;; LA DIRECTION REELLEMENT POUSSEE, publiee une fois par fenetre. Sans elle, une impulsion
       ;; nulle (chaine non classee) et une impulsion sans reponse rendraient la meme serie plate.
       (when (= (-> self pframe) 1)
         (format 0 "PHYSAXW ax=~D ux=~,,5f uy=~,,5f uz=~,,5f~%"
                 ax
                 (phys-axis-world (-> self slot) 0 ax 0)
                 (phys-axis-world (-> self slot) 0 ax 1)
                 (phys-axis-world (-> self slot) 0 ax 2)))
       ;; la serie ne commence QU'APRES l'impulsion : pendant les 10 frames du pas, le sujet bouge,
       ;; et ce qu'on veut est la decroissance LIBRE qui suit. Le `skip` de l'ajustement (12) reste
       ;; celui des autres fenetres — on ne change pas l'estimateur pour une fenetre seulement.
       (when (> (-> self pframe) PHYSROOM-IMPF)
         (dotimes (c (-> self nchain))
           (let ((nl (phys-chain-links (-> self slot) c)))
             (dotimes (l nl)
               ;; DEUX TAGS, pas un champ `len=` : la seconde ligne est deja a huit parametres,
               ;; le plafond de `format`. `PHYSRINGAZ` porte les fenetres a contrainte LEVEE, avec
               ;; exactement la meme disposition de champs, donc le meme parseur a un nom pres.
               (format 0 (if (zero? nolen)
                           "PHYSRINGAX c=~D f=~D l=~D ax=~D v=~,,7f~%"
                           "PHYSRINGAZ c=~D f=~D l=~D ax=~D v=~,,7f~%")
                       c (- (-> self pframe) PHYSROOM-IMPF) l ax
                       (phys-link-dev-anc (-> self slot) c l 0))
               ;; DEUX LIGNES, et ce n'est pas un choix de style : `format` de GOAL plafonne a huit
               ;; parametres, destination et chaine comprises. Avec `ax` en plus, les trois axes ne
               ;; tiennent plus sur une ligne — voir la note de `PHYSRINGA`.
               ;; `ax` EST REPETE SUR LA SECONDE LIGNE, et c'est necessaire : les trois fenetres
               ;; repartent chacune a la frame 0, donc `f` seule ne designe pas une fenetre. Sans
               ;; `ax` ici, l'appariement des deux lignes serait ambigu entre les trois axes.
               ;; Huit parametres exactement : c'est le plafond, aucun champ de plus.
               (format 0 (if (zero? nolen)
                           "PHYSRINGAX2 c=~D f=~D ax=~D l=~D ap=~,,7f lat=~,,7f~%"
                           "PHYSRINGAZ2 c=~D f=~D ax=~D l=~D ap=~,,7f lat=~,,7f~%")
                       c (- (-> self pframe) PHYSROOM-IMPF) ax l
                       (phys-link-dev-anc (-> self slot) c l 1)
                       (phys-link-dev-anc (-> self slot) c l 2))
               ;; ---- LA MEME FENETRE, LUE PAR L'INSTRUMENT NON AVEUGLE -------------------------
               ;; `PHYSRINGAX` porte une difference de vecteurs UNITAIRES : elle ne peut pas voir
               ;; le degre de liberte RADIAL, qui est a 92 % l'axe VERTICAL de SPEC 24 (PCA du
               ;; cycle 8 : serie plane a 1 %, meme direction nulle dans les 12 fenetres). Les
               ;; deux tags sortent du MEME instant de la MEME course, donc la frequence lue sur
               ;; l'une et sur l'autre ne differe que par la grandeur projetee.
               ;; NATURE : deplacement signe en unites de jeu. REPERE : triedre de l'ancre (SPEC 7).
               ;; LIGNE DE BASE : 0 partout a la pose d'auteur. Voir `*phys-ldb*`.
               ;; `PHYSRINGAX` N'EST PAS RETIREE : sans elle, la comparaison n'aurait pas d'avant.
               (format 0 (if (zero? nolen)
                           "PHYSRINGBX c=~D f=~D l=~D ax=~D v=~,,7f~%"
                           "PHYSRINGBZ c=~D f=~D l=~D ax=~D v=~,,7f~%")
                       c (- (-> self pframe) PHYSROOM-IMPF) l ax
                       (phys-link-dev-anc-abs (-> self slot) c l 0))
               (format 0 (if (zero? nolen)
                           "PHYSRINGBX2 c=~D f=~D ax=~D l=~D ap=~,,7f lat=~,,7f~%"
                           "PHYSRINGBZ2 c=~D f=~D ax=~D l=~D ap=~,,7f lat=~,,7f~%")
                       c (- (-> self pframe) PHYSROOM-IMPF) ax l
                       (phys-link-dev-anc-abs (-> self slot) c l 1)
                       (phys-link-dev-anc-abs (-> self slot) c l 2))
               ;; ---- SPEC 23 : LE TROISIEME DEGRE DE LIBERTE, DANS LA MEME FENETRE -------------
               ;; `PHYSRINGAX` et `PHYSRINGBX` lisent toutes deux la position du JOINT, et ce joint
               ;; vit sur une sphere : leur composante radiale est nulle par construction (la
               ;; premiere parce qu'elle differencie des vecteurs UNITAIRES, la seconde parce que
               ;; |u| = |m|). Aucune des deux ne peut donc porter le mode que sa §24 appelle
               ;; « intentionally the SLOWEST » — il est a 84.5 % radial. Cette ligne-ci porte
               ;; l'etat radial LUI-MEME, celui que §23 integre.
               ;; NATURE : une DEFORMATION signee rapportee a B0 (§6), serie temporelle.
               ;; REPERE : l'axe de l'os, dans le triedre de l'ancre. LIGNE DE BASE : 0.0 a la pose
               ;; d'auteur. CE QUI DISCRIMINE : c'est le SEUL des trois tags dont la valeur peut
               ;; etre non nulle quand le joint ne bouge pas — si elle reste plate quand les deux
               ;; autres oscillent, le degre de liberte n'est pas arrive.
               (format 0 (if (zero? nolen)
                           "PHYSRINGCX c=~D f=~D l=~D ax=~D v=~,,7f~%"
                           "PHYSRINGCZ c=~D f=~D l=~D ax=~D v=~,,7f~%")
                       c (- (-> self pframe) PHYSROOM-IMPF) l ax
                       (phys-chain-radial (-> self slot) c 1))))))
       (when (>= (-> self pframe) PHYSROOM-AXW)
         (set! (-> self pframe) 0)
         (phys-stats-reset!)
         ;; LE CONTROLE EST RENDU A 0 A CHAQUE SORTIE DE FENETRE. Un controle qui resterait arme
         ;; contaminerait toutes les mesures suivantes — c'est la faute que `phys-rest-k-set!`
         ;; evite deja de la meme facon.
         (phys-len-off-set! 0)
         (set! (-> self phase)
               (cond ((= (-> self phase) PHYSROOM-PH-AXV)  PHYSROOM-PH-AXB)
                     ((= (-> self phase) PHYSROOM-PH-AXB)  PHYSROOM-PH-AXL)
                     ((= (-> self phase) PHYSROOM-PH-AXL)  PHYSROOM-PH-AXZV)
                     ((= (-> self phase) PHYSROOM-PH-AXZV) PHYSROOM-PH-AXZB)
                     ((= (-> self phase) PHYSROOM-PH-AXZB) PHYSROOM-PH-AXZL)
                     (else PHYSROOM-PH-ORI))))))

    ;; ---- 4 quater. SPEC 10-13 — LES EQUILIBRES PAR ORIENTATION, ET LEUR CONTINUITE.
    ;; Chaque orientation est TENUE (aucun pilotage, aucune acceleration) le temps que la reponse
    ;; dynamique s'eteigne, puis mesuree. Ce qui est publie est l'ENTREE (la direction de la gravite
    ;; vue par le solveur dans le triedre de sa §7) A COTE de la SORTIE (les trois echelles et leur
    ;; determinant). Les deux ensemble, et sur neuf orientations, sont la seule forme qui puisse
    ;; repondre a sa §13 : une table de morphs figes rendrait des paliers, un equilibre continu
    ;; rend une courbe.
    ((= (-> self phase) PHYSROOM-PH-ORI)
     ;; ---- QUATRE PASSES SUR LE MEME BALAYAGE : LA MESURE, PUIS SES TROIS CONTROLES ----------
     ;; Le cycle 12 a mesure que la reponse de la chaine est REDRESSEE sur l'axe avant-arriere :
     ;; a stimulus tangentiel egal a 12-39 % pres, elle repond 8.7 a 30.3 fois plus quand la
     ;; gravite tire vers l'ARRIERE que vers l'AVANT, pendant que les paires LATERALES — meme
     ;; instrument, meme fenetre — restent entre 1.2 et 2.3. Aucune anisotropie ne produit ca.
     ;; Le cycle 12 a nomme le defaut et a ecrit qu'il ne devinait pas sa cause. Voici la mesure
     ;; qui la designe, au lieu d'une hypothese : on refait LE MEME balayage avec, tour a tour,
     ;; chacun des trois mecanismes suspects DESARME. Celui dont le desarmement rend le canal
     ;; symetrique est le coupable ; si aucun ne le fait, les trois sont innocentes et la liste
     ;; se reduit d'autant — ce qui est aussi un resultat.
     ;;   k=0  rien de desarme      -> la mesure de reference, IDENTIQUE au cycle 12
     ;;   k=1  contrainte de LONGUEUR levee   (`phys-len-off-set!`)
     ;;   k=2  contrainte de COTE levee       (`phys-side-off-set!`)
     ;;   k=3  rayon de capsule interpole     (`phys-cone-off-set!`) — sonde la FORME du volume
     ;;   k=4  MUR DE COLLISION desarme       (`phys-col-off-set!`)  — sonde son PLANCHER
     ;;
     ;; k=4 EST NEUVE (cycle 14) ET ELLE COMBLE LE TROU QUE LE CYCLE 13 A NOMME. k=2 et k=3 sont
     ;; exoneres a quatre decimales, k=1 symetrise mais c'est le MECANISME (rehaussement radial
     ;; pur, donc isotrope dans son propre corps), pas la CAUSE de l'asymetrie. Le seul suspect qui
     ;; ait la bonne taille ET le bon signe — le mur plafonne a la profondeur d'auteur, avec la
     ;; pose d'auteur EXACTEMENT sur sa frontiere — n'etait desarme par AUCUNE des trois passes.
     ;; Voir [NOTE-53] de `jak-hd-physics-NOTES.md`.
     ;;
     ;; LA PASSE k=0 EST BIT POUR BIT CELLE DU CYCLE 12 : tous les emetteurs existants
     ;; (`PHYSORI`, `PHYSORI2/3/4`, `PHYSORICOM`, `PHYSORICOM2`, `PHYSORITR`) restent gardes par
     ;; `(zero? ok)`, donc le tableau et ses gates ne voient aucun changement. Les trois passes de
     ;; controle n'ajoutent que `PHYSORICTL`, un tag neuf que rien d'existant ne lit.
     (let ((oi (mod (-> self ori) PHYSROOM-ORIN))
           (ok (/ (-> self ori) PHYSROOM-ORIN)))
      (physroom-orient (-> *physroom-ori-ax* oi) (-> *physroom-ori-dg* oi))
      ;; le controle de CETTE passe, arme a sa premiere frame et jamais ailleurs
      (when (= (-> self pframe) 1)
        (phys-len-off-set!  (if (= ok 1) 1 0))
        (phys-side-off-set! (if (= ok 2) 1 0))
        (phys-cone-off-set! (if (= ok 3) 1 0))
        (phys-col-off-set!  (if (= ok 4) 1 0)))
     ;; ---- LE PIC TRANSITOIRE D'ETABLISSEMENT, PUIS LA REMISE A ZERO DE LA FENETRE -------------
     ;; Deux choses en un seul point, et elles vont ensemble :
     ;;
     ;; 1. `PHYSORITR` publie le maximum du canal radial sur les 60 frames d'ETABLISSEMENT, juste
     ;;    avant qu'elles soient effacees. C'est la seule ligne de sa spec qui parle d'un
     ;;    TRANSITOIRE d'orientation : §11 `HangingTransientLengthMax = 1.30` contre
     ;;    `HangingLengthScale = 1.23` en tenu. Sans cet emetteur le transitoire est perdu, et un
     ;;    depassement d'etablissement serait indistinguable de l'equilibre.
     ;;
     ;; 2. `phys-stats-reset!` remet la fenetre a zero A LA FIN DE L'ETABLISSEMENT. Sans lui, la
     ;;    POSITION MOYENNE de la pointe (`phys-tip-mean`) couvrirait les 60 frames de transitoire
     ;;    EN PLUS des 30 de mesure, et rendrait une moyenne de trajectoire au lieu d'un
     ;;    equilibre. `PH-TILT` fait deja exactement ca a `PHYSROOM-IDLES` (voir sa note) ; c'est
     ;;    la meme correction, au meme endroit du meme motif.
     ;;
     ;; POURQUOI 60 FRAMES SUFFISENT, et ce n'est pas une supposition : le mode principal livre
     ;; `omega = 14.4515 rad/s` et `zeta = 0.35` (SPEC 24/25, verifies par identite arithmetique
     ;; sur la donnee livree), donc une constante de temps `1/(zeta.omega) = 0.198 s`, soit 11.9
     ;; frames a 60 Hz. 60 frames = 5.05 constantes de temps, residu `e^-5.05 = 0.6 %`. Ce que
     ;; `PHYSORICOM` mesure ensuite est donc bien un EQUILIBRE, a 0.6 % pres, et non un transitoire.
     ;; `PHYSORITR` est la pour le prouver au lieu de le supposer : si le pic d'etablissement
     ;; n'excede pas le tenu, il n'y avait rien a attendre ; s'il l'excede, sa §11 le chiffre.
     ;;
     ;; AUCUNE LIGNE EXISTANTE N'EST TOUCHEE PAR CE RESET : `PHYSORI`, `PHYSORI2`, `PHYSORI3` et
     ;; `PHYSORI4` lisent toutes `phys-shape`, dont aucun des index publies (0-3, 8-11, 15-17) ne
     ;; figure dans `phys-stats-reset!`. Verifiable par diff du tableau avant/apres.
      (when (= (-> self pframe) PHYSROOM-ORIS)
       (when (zero? ok)
        (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
          (format 0 "PHYSORITR c=~D i=~D rrt=~,,7f~%"
                  c oi (phys-chain-radial (-> self slot) c 2)))))
       (phys-stats-reset!)
       ;; les compteurs de diagnostic couvrent la FENETRE DE MESURE et rien d'autre : sans ce
       ;; reset ils cumuleraient l'etablissement, ou vit justement le pic de §37.
       (phys-diag-reset!))
      (when (>= (-> self pframe) (+ PHYSROOM-ORIS PHYSROOM-ORIM))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (when (zero? ok)
         (format 0 "PHYSORI c=~D i=~D gx=~f gy=~f gz=~f~%"
                 c oi
                 (phys-shape (-> self slot) c 9)
                 (phys-shape (-> self slot) c 10)
                 (phys-shape (-> self slot) c 11))
         (format 0 "PHYSORI2 c=~D i=~D sx=~f sy=~f sz=~f det=~f~%"
                 c oi
                 (phys-shape (-> self slot) c 0)
                 (phys-shape (-> self slot) c 1)
                 (phys-shape (-> self slot) c 2)
                 (phys-shape (-> self slot) c 3))
         (format 0 "PHYSORI4 c=~D i=~D r0=~f r1=~f r2=~f~%"
                 c oi
                 (phys-shape (-> self slot) c 15)
                 (phys-shape (-> self slot) c 16)
                 (phys-shape (-> self slot) c 17))
         (format 0 "PHYSORI3 c=~D i=~D ax=~D deg=~f arm=~f~%"
                 c oi
                 (-> *physroom-ori-ax* oi)
                 (-> *physroom-ori-dg* oi)
                 (phys-shape (-> self slot) c 8))
         ;; ---- LA REPONSE STATIQUE, A COTE DE L'ENTREE STATIQUE ---------------------------------
         ;; CE QUE §10-§13 NOMMENT ET QUE PERSONNE N'A JAMAIS LU. Ses trois sections d'orientation
         ;; donnent chacune un DEPLACEMENT, pas seulement des echelles de forme :
         ;;     §10 supine   `SupineCOMDepth        = 0.23 B0`
         ;;     §11 prone    `HangingCOMDisplacement = 0.24 B0`
         ;;     §12 lateral  `SideGravityCOM         = 0.19 B0`
         ;; `PHYSORI2` ne publie que les ECHELLES (la forme). Le deplacement n'etait emis nulle
         ;; part dans cette phase — c'est le trou que le cycle 11 a nomme pour §11 et qui vaut en
         ;; realite pour les trois.
         ;;
         ;; ET C'EST AUSSI L'INSTRUMENT DE §29, QUI N'EN AVAIT AUCUN. Son preset nomme ses quatre
         ;; valeurs `VerticalCompliance / APCompliance / LateralCompliance / TorsionalCompliance` :
         ;; ce sont des COMPLIANCES, c'est-a-dire des deplacements par unite de force. Les mesurer
         ;; par des FREQUENCES melange raideur et masse et rend §24 et §29 sur-determinees l'une
         ;; par l'autre ; les mesurer ICI ne demande que des equilibres tenus. Neuf orientations
         ;; donnent neuf couples (direction de gravite, deplacement) : de quoi ajuster un tenseur
         ;; de compliance 3x3 et en lire l'anisotropie, avec son residu.
         ;;
         ;; DEUX CANAUX, ET ILS SONT ORTHOGONAUX PAR CONSTRUCTION — donc publies SEPAREMENT et
         ;; jamais additionnes en un seul nombre dont la nature serait ambigue :
         ;;   `tx/ty/tz` = position MOYENNE de la pointe sur la fenetre de mesure, ecart a la pose
         ;;      d'auteur. La contrainte de longueur lui confisque la composante le long de l'os :
         ;;      ce canal est donc TANGENTIEL, et c'est un deplacement d'APEX (le point que le
         ;;      solveur integre), pas de COM — §22 lui donne ses propres bandes (0.42 / 0.50 B0).
         ;;   `rr` = le canal radial de §23, le long de l'os, que la contrainte confisquait. Sa
         ;;      nature declaree est le deplacement de COM rapporte a B0 (§22 : 0.35 / 0.40).
         ;; NATURE : deux DEPLACEMENTS SOUTENUS (moyennes de fenetre), pas des variances — un
         ;; equilibre ne bouge plus, donc toute grandeur de dispersion y lit zero par construction.
         ;; REPERE : le triedre de SPEC 7 (+X lateral, +Y haut, +Z avant), celui-la meme dans
         ;; lequel `PHYSORI` publie deja `gx/gy/gz`. Les deux se lisent donc composante a composante.
         ;; UNITES : `tx/ty/tz` en unites de jeu (B0 = 602 est dans la trace, ligne `[HD-PHYS] b0`) ;
         ;; `rr` et `rrm` deja rapportes a B0.
         ;; LIGNE DE BASE : l'orientation i=0 est la pose debout d'auteur, ou §9 exige 0.0000 —
         ;; c'est la ligne de base MESUREE de ce bloc, pas une supposition, et si elle n'est pas
         ;; nulle toutes les autres sont decalees d'autant.
         (format 0 "PHYSORICOM c=~D i=~D tx=~f ty=~f tz=~f~%"
                 c oi
                 (phys-tip-mean (-> self slot) c 0)
                 (phys-tip-mean (-> self slot) c 1)
                 (phys-tip-mean (-> self slot) c 2))
         (format 0 "PHYSORICOM2 c=~D i=~D rr=~,,7f rrm=~,,7f n=~f~%"
                 c oi
                 (phys-chain-radial (-> self slot) c 1)
                 (phys-chain-radial (-> self slot) c 2)
                 (phys-stat (-> self slot) c 15)))
         ;; ---- LA MEME REPONSE, PASSE PAR PASSE : c'est le corps de l'experience -------------
         ;; Emis sur les QUATRE passes, y compris k=0, pour que la comparaison se fasse entre
         ;; lignes de MEME nature et de MEME emetteur. Comparer une passe de controle a la ligne
         ;; `PHYSORICOM` de reference marcherait aussi, mais ferait dependre le verdict de deux
         ;; formats differents — et c'est le genre d'ecart qui se paie.
         ;; `inv`/`flip`/`retreat` sont les compteurs de la FENETRE DE MESURE (remis a zero a
         ;; `PHYSROOM-ORIS`) : ils disent si une COLLISION ou un LIMITEUR a mordu pendant
         ;; l'equilibre. Une reponse redressee accompagnee d'un compteur asymetrique designe le
         ;; mecanisme ; une reponse redressee avec des compteurs a zero des deux cotes l'exclut.
         (format 0 "PHYSORICTL c=~D k=~D i=~D tx=~f ty=~f tz=~f~%"
                 c ok oi
                 (phys-tip-mean (-> self slot) c 0)
                 (phys-tip-mean (-> self slot) c 1)
                 (phys-tip-mean (-> self slot) c 2))
         ;; `format` de GOAL est cape a SIX parametres apres la chaine — `retreat` part donc sur
         ;; sa propre ligne plutot que d'etre sacrifie. C'est la meme contrainte qui a deja
         ;; impose de scinder `PHYSRAD` / `PHYSRADSAT`.
         (format 0 "PHYSORICTL2 c=~D k=~D i=~D rr=~,,7f inv=~f flip=~f~%"
                 c ok oi
                 (phys-chain-radial (-> self slot) c 1)
                 (phys-diag (-> self slot) c 3)
                 (phys-diag (-> self slot) c 2))
         (format 0 "PHYSORICTL3 c=~D k=~D i=~D retreat=~f shape=~f~%"
                 c ok oi
                 (phys-diag (-> self slot) c 1)
                 (phys-diag (-> self slot) c 8))))
       (+! (-> self ori) 1)
       (set! (-> self pframe) 0)
       (phys-stats-reset!)
       (when (>= (-> self ori) (* 5 PHYSROOM-ORIN))
         ;; LES QUATRE CONTROLES SONT RENDUS AVANT DE SORTIR. Un controle laisse arme
         ;; contaminerait tout le reste de la course — c'est la faute que `phys-len-off-set!`
         ;; evite deja de la meme facon a la sortie des fenetres d'axe.
         (phys-len-off-set! 0)
         (phys-side-off-set! 0)
         (phys-cone-off-set! 0)
         (phys-col-off-set! 0)
         (set! (-> self phase) PHYSROOM-PH-SHAKE)))))

    ;; ---- 4 ter. ON SECOUE, PUIS ON RELACHE — le cycle ferme dans le regime ou le defaut vit.
    ;; ---- Voir la note de PHYSROOM-PH-SHAKE : le cycle `tilt` est quasi-statique et n'exerce pas
    ;; ---- les termes a memoire ; celui-ci les exerce.
    ((= (-> self phase) PHYSROOM-PH-SHAKE)
     (physroom-drive 3 (-> self pframe))            ;; `jerk` : vitesse posee d'un coup, arrets brutaux
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self phase) PHYSROOM-PH-SHAKEN)
       (set! (-> self pframe) 0)))

    ((= (-> self phase) PHYSROOM-PH-SHAKEN)
     (physroom-hold)
     ;; ---- §36 ET §29-TORSION — LA SERIE LIBRE DES DEUX MODES SCALAIRES ----------------------
     ;; LE FAUX VERT DU CYCLE 11 VENAIT D'ICI, ET IL FAUT LE DIRE : sa §36 etait rapportee
     ;; « zeta 0.65 » parce que la constante `PHYS-SEC-Z` vaut 0.65 — le piege
     ;; `declared-but-never-selected`. Le cycle 11 l'a corrige au niveau des COEFFICIENTS (les
     ;; deux nombres sont imprimes a l'init et le polynome caracteristique donne 0.6502 / 5.1995
     ;; Hz), et a ecrit lui-meme que ce n'est PAS la meme chose qu'observer 5.20 Hz dans une
     ;; serie. Voici la serie. C'est le seul endroit de la course ou les deux modes decroissent
     ;; LIBREMENT : `physroom-hold` fige la position ET l'orientation, et cette phase n'appelle
     ;; PAS `physroom-advance-anim` — l'animation ne les excite donc plus, contrairement aux
     ;; fenetres par animation ou §27 lit un plancher d'excitation au lieu d'un ring-down.
     ;; Ce qui precede est `PH-SHAKE` (`jerk`, vitesse posee d'un coup) : sa §36 demande
     ;; precisement « after a change in direction of the global breast mass ».
     ;;
     ;; NATURE : deux SERIES TEMPORELLES, une valeur signee par frame — pas des maximums. C'est
     ;; ce qui permet d'en ajuster frequence et amortissement ; `secm`/`twm`, qui sont des
     ;; maximums de fenetre, ne le permettent pas et c'est pour ca qu'ils ont laisse passer
     ;; le faux vert. `s` = modulation d'epaisseur de §36 (fraction, sans dimension) ;
     ;; `tw` = torsion relative de §29 (radians).
     ;; REPERE : la racine de la chaine. LIGNE DE BASE : 0.0 exactement au repos.
     ;;
     ;; CE QUE LA SERIE PEUT MONTRER ET QUE LES COEFFICIENTS NE PEUVENT PAS : `*phys-sec*` est
     ;; ECRETE A `PHYS-SEC-MAX` **DANS L'ETAT** (`(set! (-> *phys-sec* sc) smc)`), pas seulement
     ;; en sortie. Un ecretage a l'interieur de la boucle n'est pas une borne d'affichage : il
     ;; change la dynamique, et le mode livre cesse d'etre l'oscillateur dont le polynome donne
     ;; 0.6502. Le cycle 11 a mesure que ce plafond est atteint sur 6 fenetres sur 10. La serie
     ;; le rend lisible : tout echantillon a |s| = 0.0700000 est ECRETE, et l'ajustement ne doit
     ;; porter que sur les autres. Sa §37 demande d'ailleurs l'inverse de cet ecretage
     ;; (« soft displacement clamps should be preferred to abrupt positional clamps »).
     ;; 90 frames = 7.8 periodes amorties du mode a 5.2 Hz (T_d = 15.2 frames a zeta 0.65) :
     ;; assez pour le premier depassement, qui est ce qui porte zeta, et pour voir le plancher.
     (when (<= (-> self pframe) 90)
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSSEC c=~D f=~D s=~,,7f tw=~,,7f~%"
                 c (-> self pframe)
                 (phys-shape (-> self slot) c 4)
                 (phys-shape (-> self slot) c 6)))))
     ;; ---- §27 — LA FENETRE QUE LE CYCLE 11 A NOMMEE SANS LA CONSTRUIRE --------------------
     ;; Sa §27 commence par « AFTER ONE STRONG ISOLATED IMPULSE » et donne une echelle complete :
     ;; reponse dominante 0.3-0.6 s, mouvement secondaire 0.6-1.2 s, essentiellement stabilise
     ;; 1.0-1.5 s, immobile 1.3-1.7 s. Jusqu'ici §27 etait lue sur les fenetres PAR ANIMATION,
     ;; ou les 31 animations continuent d'exciter la chaine : le cycle 11 a montre que `t1` et
     ;; `t05` y sortaient CENSURES a `>2.48 s` alors que la theorie donne 1.05 s a zeta = 0.35 —
     ;; c'est-a-dire que la fenetre ne mesurait pas un ring-down mais le plancher d'excitation de
     ;; l'animation. Il a ecrit : « je n'ai pas construit la fenetre qui le mesurerait ». La voici,
     ;; et c'est la MEME que celle du mode secondaire ci-dessus, pour la meme raison : `PH-SHAKE`
     ;; est une impulsion isolee et forte (`jerk`), `PH-SHAKEN` fige position, orientation ET
     ;; animation. Rien ne re-excite la chaine pendant la decroissance.
     ;; 150 frames = 2.50 s, soit tout l'escalier de sa §27 avec de la marge au-dela du dernier
     ;; barreau (1.7 s) : sans cette marge, « immobile a 1.7 s » ne serait pas distinguable de
     ;; « fenetre trop courte », qui est exactement la censure qu'on corrige.
     ;; NATURE : une SERIE TEMPORELLE signee de la deviation du maillon a sa pose d'auteur, par
     ;; axe — pas une amplitude agregee : c'est la decroissance de l'ENVELOPPE qui porte §27.
     ;; REPERE : le triedre de l'ANCRE (SPEC 7), identique a `PHYSRINGA` (voir sa note) — les deux
     ;; series sont donc directement comparables, et leur ECART mesure ce que l'animation ajoutait.
     ;; LIGNE DE BASE : 0.0 sur toute la longueur quand la chaine est sur la pose d'auteur.
     (when (<= (-> self pframe) 150)
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (dotimes (l (phys-chain-links (-> self slot) c))
           (format 0 "PHYSRINGSH c=~D f=~D l=~D v=~,,7f ap=~,,7f lat=~,,7f~%"
                   c (-> self pframe) l
                   (phys-link-dev-anc (-> self slot) c l 0)
                   (phys-link-dev-anc (-> self slot) c l 1)
                   (phys-link-dev-anc (-> self slot) c l 2))))))
     (when (= (-> self pframe) PHYSROOM-IDLES) (phys-stats-reset!))
     (when (>= (-> self pframe) (+ PHYSROOM-IDLES PHYSROOM-IDLEM))
       ;; meme etablissement et meme fenetre que `idle` et `back` : les trois poses sont comparables.
       (physroom-emit-mean "shaken")
       (set! (-> self phase) PHYSROOM-PH-SHAKEPC)
       (set! (-> self pframe) 0)
       (phys-side-off-set! 1)                       ;; CONTROLE POSITIF : contrainte de cote LEVEE
       (phys-stats-reset!)))

    ((= (-> self phase) PHYSROOM-PH-SHAKEPC)
     (physroom-drive 3 (-> self pframe))            ;; MEME secousse, meme duree : seule la garde differe
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self phase) PHYSROOM-PH-SHAKENPC)
       (set! (-> self pframe) 0)))

    ((= (-> self phase) PHYSROOM-PH-SHAKENPC)
     (physroom-hold)
     (when (= (-> self pframe) PHYSROOM-IDLES) (phys-stats-reset!))
     (when (>= (-> self pframe) (+ PHYSROOM-IDLES PHYSROOM-IDLEM))
       (physroom-emit-mean "shakenpc")
       (phys-side-off-set! 0)                       ;; on DESARME : la suite de la course est normale
       (set! (-> self phase) PHYSROOM-PH-PCOFF)
       (set! (-> self pframe) 0)
       (phys-inject-set! 0.0)
       (phys-inject-count-reset!)
       (phys-stats-reset!)))

    ;; ---- 5. CONTROLE POSITIF, branche DESARMEE : la penetration telle qu'elle est ------------
    ((= (-> self phase) PHYSROOM-PH-PCOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self dis) (physroom-max-pen))
       (set! (-> self phase) PHYSROOM-PH-PCON)
       (set! (-> self pframe) 0)
       (phys-inject-count-reset!)
       (phys-stats-reset!)
       ;; on POSE le defaut : chaque lien libre est pousse de 400 unites (~10 cm) vers l'interieur
       ;; du corps APRES resolution. Si le compteur de penetration ne monte pas, il ne mesure rien.
       (phys-inject-set! 400.0)))

    ;; ---- 6. CONTROLE POSITIF, branche ARMEE --------------------------------------------------
    ((= (-> self phase) PHYSROOM-PH-PCON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self arm) (physroom-max-pen))
       (set! (-> self injn) (phys-inject-count))
       (phys-inject-set! 0.0)
       (set! (-> self phase) PHYSROOM-PH-AUTHPC)
       (set! (-> self pframe) 0)))

    ;; ---- 7. L'ANIMATION D'AUTEUR (SPEC 5) : d'abord le bilan de la course, ensuite un CONTROLE
    ;; ---- POSITIF. Le controle retarde l'animation d'une frame dans la position ecrite — le defaut
    ;; ---- exact que la SPEC interdit — et le compteur d'identite doit s'effondrer. Un compteur qui
    ;; ---- ne bouge pas sous le defaut ne mesure rien, et le zero qu'il annonce ne vaut rien.
    ((= (-> self phase) PHYSROOM-PH-AUTHPC)
     (when (= (-> self pframe) 1)
       (format 0 "PHYSLIM retreat_n=~f retreat_sum=~f raddrop_n=~f raddrop_sum=~f buried=~f~%"
               (phys-limiter 0) (phys-limiter 1) (phys-limiter 2) (phys-limiter 3)
               (phys-limiter 4))
       ;; REPLIS DU RECUL : chacun laisse un residu d'allongement sur son lien. Publie a part parce
       ;; que c'est le seul chemin qui reste vers un allongement non nul.
       (format 0 "PHYSLIM2 retreat_fallback=~f~%" (phys-limiter 5))
       ;; CETTE LIGNE PUBLIAIT UN CHIFFRE QUI N'EXISTE PAS DANS LE MOTEUR. Elle lisait
       ;; `(phys-limiter 6)` et `(phys-limiter 7)` sous les noms `radial_n` / `radial_sum` ; il n'y a
       ;; AUCUN compteur radial dans jak-hd-physics.gc, ces deux index tombent donc dans la branche
       ;; `else` et rendaient tous les deux `*phys-buried-n*`. La course du 2026-08-12 le dit au
       ;; chiffre pres :
       ;;     PHYSLIM  buried=987636       PHYSLIM3  radial_n=987636  radial_sum=987636
       ;; et le tableau en tirait « part radiale de la force, ecartee : 987623 fois, 987623.0000
       ;; u/frame^2 au total soit 1.0000 par declenchement ». Un ratio de 1.0000 etait la signature :
       ;; c'etait le meme compteur divise par lui-meme. Trois etiquettes pour une seule grandeur,
       ;; dont deux fausses.
       ;;
       ;; A SA PLACE, LE BALAYAGE DE SPHERE DU RECUL — un vrai compteur, et le pendant exact de
       ;; `retreat_fallback` : meme evenement declencheur (le point de depart du modele penetre),
       ;; l'un compte les sauvetages, l'autre les renoncements. NATURE : un compte d'evenements sur
       ;; la course. REPERE : sans objet (ce n'est pas une grandeur geometrique). LECTURE QUAND LE
       ;; DEFAUT EST ABSENT : zero des deux cotes — la pose du modele est admissible et l'arc suffit.
       (format 0 "PHYSLIM3 sphere_n=~f~%" (phys-limiter 8))
       ;; SPEC 21/22 — CE QUE LA SATURATION D'EXCURSION A RETIRE. NATURE : `sat_n` est un compte
       ;; d'evenements sur la course, `sat_sum` une LONGUEUR cumulee en unites de jeu. REPERE : une
       ;; magnitude de deplacement, invariante par rotation. LECTURE QUAND LE DEFAUT EST ABSENT :
       ;; `sat_n=0` — la poitrine est restee sous le `HardMaxApexDisplacement = 0.50 B0` de l'owner
       ;; et rien n'a ete borne. C'est le chiffrage que la SPEC 7 du contrat exige de tout
       ;; suppresseur : sans lui, « borne » et « brime » seraient indiscernables.
       ;; `stif_n` (SPEC 21 sous forme de FORCE) est d'une autre NATURE : un compte de SOUS-PAS
       ;; integres au-dela du genou 0.42 B0, sans `sum` parce qu'un ressort ne retire rien. Les deux
       ;; se lisent ENSEMBLE : `stif_n` grand avec `sat_n` effondre = la force fait le travail et le
       ;; filet ne sert plus. `sat_n` qui reste haut = le ressort est mal pose.
       (format 0 "PHYSLIM4 sat_n=~f sat_sum=~f stif_n=~f~%"
               (phys-limiter 9) (phys-limiter 10) (phys-limiter 6))
       ;; QUEL VOLUME CONTRAINT QUEL MAILLON, sur toute la course. Une ligne par triplet non nul :
       ;; c'est la question que trois cycles ont posee sans instrument (« lbang est en contact
       ;; 17893 frames sur 17893 avec un AUTRE volume, non identifie »), et depuis le 2026-08-14
       ;; l'index du MAILLON n'est plus jete a l'ecriture — deux cycles ont bute sur « lequel des
       ;; deux maillons du sein viole ? » sans pouvoir y repondre.
       ;;   NATURE  : un COMPTE de triplets (frame, MAILLON, volume) ou ce volume-la demandait une
       ;;             correction cette frame (`res > 0`). Ni une distance, ni une amplitude — et un
       ;;             contact a profondeur nulle n'en est pas un.
       ;;   REPERE  : celui du VOLUME TESTE (le solide `ci`, dans son repere anime), puisque c'est
       ;;             contre lui que la profondeur `res` est evaluee.
       ;;   ABSENT  : aucune ligne pour ce maillon — aucun volume ne l'a jamais contraint.
       ;; Le nom du volume est deja publie par `PHYSCOL ci= j= j2=`, on n'imprime donc que l'index.
       ;; La borne des maillons vient de `phys-chain-links`, JAMAIS de `PHYS-LINKS` : une chaine a
       ;; 2 maillons publierait sinon deux colonnes vides indistinguables d'un zero mesure.
       (dotimes (c (-> self nchain))
         (let ((nl (phys-chain-links (-> self slot) c)))
           (when (> nl 0)
             (dotimes (ci (phys-slot-colliders (-> self slot)))
               (dotimes (l nl)
                 (let ((n (phys-chain-vol (-> self slot) c l ci)))
                   (when (> n 0)
                     (format 0 "PHYSCVOL c=~D l=~D ci=~D n=~D~%" c l ci n))))))))
       ;; QUELS VOLUMES SE DISPUTENT QUEL LIEN — l'attribution que `PHYSCVOL` ne peut pas donner,
       ;; parce qu'il ne se remplit que pendant la fenetre de controle positif (mesure du
       ;; 2026-08-13 : `meshpen_max=0.0000` sur toutes les phases de mesure). Celui-ci vient de la
       ;; passe de SELECTION, donc de toute la course.
       ;;   NATURE  : un COMPTE de triplets (frame, lien, volume) ou ce volume etait l'un d'au moins
       ;;             DEUX a contraindre le meme lien. Ni une distance, ni une amplitude.
       ;;   REPERE  : sans objet (c'est un compte).
       ;;   ABSENT  : 0 — le lien n'a jamais eu plus d'un volume a la fois, donc rien a arbitrer.
       ;;   CONTROLE: le desarmement de `*phys-prio-meas*`, qui doit rendre TOUTE la colonne a zero.
       (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
           (dotimes (ci (phys-slot-colliders (-> self slot)))
             (let ((n (phys-chain-conf (-> self slot) c ci)))
               (when (> n 0)
                 (format 0 "PHYSCFVOL c=~D ci=~D n=~D~%" c ci n))))))
       ;; SPEC 33 — LE DOMAINE DE CHAQUE PAIRE, ET PAS SEULEMENT SES CONTACTS.
       ;; Le cycle 7 a publie « 0 contact sein<->sein sur 2978 » puis a ecrit lui-meme, dans ses
       ;; non-prouves, que la cause geometrique n'etait PAS etablie. Un zero dont on ignore le
       ;; domaine ne prouve rien : la paire a-t-elle failli se toucher, ou est-elle restee a
       ;; un demi-metre ? Cette ligne repond, a l'execution, pour TOUTE paire effectivement testee.
       ;;   NATURE  : `dm` et `fl` sont des LONGUEURS (unites de jeu, 4096 u = 1 m), pas des comptes.
       ;;             `dm` = profondeur d'approche MAXIMALE atteinte sur toute la course ;
       ;;             `fl` = le plancher que la paire tolere (sa profondeur A LA POSE D'AUTEUR).
       ;;   REPERE  : monde.
       ;;   ABSENT  : `dm` NEGATIF — les deux surfaces ne se sont jamais rejointes, et |dm| EST
       ;;             l'ecart minimal atteint entre elles. `dm > fl` est la condition de contact.
       ;;   DISCRIMINANT : `ok=0` veut dire que la paire n'a JAMAIS ete echantillonnee (exclusion
       ;;             structurelle, joint hors squelette) — a ne pas lire comme « 0 mesure ».
       (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
           (dotimes (ci (phys-slot-colliders (-> self slot)))
             (when (> (phys-chain-vol-dom (-> self slot) c ci 2) 0.0)
               (format 0 "PHYSPAIR c=~D ci=~D dm=~f fl=~f~%"
                       c ci
                       (phys-chain-vol-dom (-> self slot) c ci 0)
                       (phys-chain-vol-dom (-> self slot) c ci 1))))))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSAUTH c=~D hit=~f ok=~f dot=~f nrm=~f dsum=~f~%"
                 c
                 (phys-auth (-> self slot) c 0)
                 (phys-auth (-> self slot) c 1)
                 (phys-auth (-> self slot) c 2)
                 (phys-auth (-> self slot) c 3)
                 (phys-auth (-> self slot) c 4))
         (format 0 "PHYSAUTH2 c=~D usum=~f tmov=~f contact=~f fam=~D~%"
                 c (phys-auth (-> self slot) c 5) (phys-auth (-> self slot) c 6)
                 (phys-auth (-> self slot) c 7)
                 (phys-chain-family (-> self slot) c))))
       (phys-auth-reset!)
       (phys-auth-lag-set! 1))
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (phys-auth-lag-set! 0)
       (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
           (format 0 "PHYSAUTHPC c=~D hit=~f ok=~f~%"
                   c (phys-auth (-> self slot) c 0) (phys-auth (-> self slot) c 1))))
       (set! (-> self phase) PHYSROOM-PH-INVPC)
       (set! (-> self pframe) 0)))

    ;; ---- 8. LES INVERSIONS (verdict owner : « un de ses seins retourne vers l'interieur »).
    ;; ---- D'abord le compte de la course, puis un CONTROLE POSITIF qui miroite chaque lien libre a
    ;; ---- travers son attache : le compteur doit monter. Un compteur d'inversions a zero qui ne
    ;; ---- bouge pas sous le defaut ne prouve rien.
    ((= (-> self phase) PHYSROOM-PH-INVPC)
     (when (= (-> self pframe) 1)
       ;; `reseatfb` = re-assises retombees sur l'ancienne heuristique (rayon le long de l'os du
       ;; porteur) au lieu de la place que le rig donne. Doit valoir ZERO : c'est cette heuristique
       ;; qui posait le pan du pantacourt a 429 u du genou la ou le rig le met a 1349.
       (format 0 "PHYSRESEAT n=~f fallback=~f~%" (phys-inversions 2) (phys-inversions 4))
       (format 0 "PHYSINV phase=run flips=~f degen=~f reseat=~f residual=~f~%"
               (phys-inversions 0) (phys-inversions 1) (phys-inversions 2) (phys-inversions 3))
       (phys-inversions-reset!)
       (phys-inv-inject-set! 1))
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (phys-inv-inject-set! 0)
       (format 0 "PHYSINV phase=control flips=~f degen=~f reseat=~f residual=~f~%"
               (phys-inversions 0) (phys-inversions 1) (phys-inversions 2) (phys-inversions 3))
       (set! (-> self phase) PHYSROOM-PH-SELFOFF)
       (set! (-> self pframe) 0)
       (phys-diag-reset!)))

    ;; ---- 8/9. L'AUTO-COLLISION (6e passe, defaut 1 : « les meches fines jittent like crazy des
    ;; ---- que la tete bouge »). Les colliders `Lbanga`, `Lmidhaira`, `lBoob` sont les JOINTS-RACINES
    ;; ---- des chaines elles-memes et les capsules `Lbangb->Lbanga` sont leurs MAILLONS : sans
    ;; ---- exclusion, une meche est poussee hors de son propre volume en permanence. L'exclusion est
    ;; ---- structurelle, donc le compteur est structurellement nul — et un zero que rien ne peut
    ;; ---- faire monter ne prouve rien. La branche ARMEE leve l'exclusion : il DOIT monter.
    ((= (-> self phase) PHYSROOM-PH-SELFOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (physroom-emit-diag "self-disarmed")
       (phys-diag-reset!)
       (phys-self-inject-set! 1)
       (set! (-> self phase) PHYSROOM-PH-SELFON)
       (set! (-> self pframe) 0)))

    ((= (-> self phase) PHYSROOM-PH-SELFON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (physroom-emit-diag "self-armed")
       (phys-self-inject-set! 0)
       (phys-diag-reset!)
       (set! (-> self ai) 0)
       (physroom-set-anim 0)
       (set! (-> self phase) PHYSROOM-PH-SIDEOFF)
       (set! (-> self pframe) 0)))

    ;; ---- 9bis. CONTROLE POSITIF DE LA CONTRAINTE DE COTE, DEUX BRANCHES A EXPOSITION EGALE.
    ;; ---- `side` est tombe de 11446 a 0 quand la contrainte est arrivee ; un compteur qui
    ;; ---- s'effondre est soit une correction, soit un predicat devenu inevaluable. La branche
    ;; ---- DESARMEE (contrainte en place) et la branche ARMEE (contrainte levee, rien d'autre)
    ;; ---- jouent TOUTES LES ANIMATIONS, PHYSROOM-PCW frames chacune, meme pilotage : c'est la
    ;; ---- seule facon de comparer deux comptes, et c'est ce qui manquait quand les deux
    ;; ---- rendaient zero (la fenetre de 90 frames sur l'animation 0 ne joue simplement pas les
    ;; ---- animations ou les lunettes traversent le buste).
    ((= (-> self phase) PHYSROOM-PH-SIDEOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (physroom-emit-diag "side-disarmed")
          (phys-diag-reset!)
          (phys-side-off-set! 1)
          (set! (-> self ai) 0)
          (physroom-set-anim 0)
          (set! (-> self phase) PHYSROOM-PH-SIDEON)))))

    ((= (-> self phase) PHYSROOM-PH-SIDEON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (physroom-emit-diag "side-armed")
          (phys-side-off-set! 0)
          (phys-diag-reset!)
          (phys-stats-reset!)
          (set! (-> self ai) 0)
          (physroom-set-anim 0)
          (set! (-> self phase) PHYSROOM-PH-CONEOFF)))))

    ;; ---- 9quater. CONTROLE POSITIF DU PREDICAT CONIQUE, DEUX BRANCHES A EXPOSITION EGALE.
    ;; ---- DESARMEE = le predicat corrige (le solide que la donnee designe). ARMEE = le rayon
    ;; ---- interpole sur le parametre de projection, c'est-a-dire l'ensemble plus PETIT d'avant :
    ;; ---- le solveur y cesse de pousser plus tot, donc la penetration residuelle DOIT monter.
    ((= (-> self phase) PHYSROOM-PH-CONEOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (set! (-> self condis) (physroom-max-pen))
          (format 0 "PHYSCONE tag=cone-disarmed maxpen=~f~%" (-> self condis))
          (physroom-emit-diag "cone-disarmed")
          (phys-diag-reset!)
          (phys-stats-reset!)
          (phys-cone-off-set! 1)
          (set! (-> self ai) 0)
          (physroom-set-anim 0)
          (set! (-> self phase) PHYSROOM-PH-CONEON)))))

    ((= (-> self phase) PHYSROOM-PH-CONEON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (set! (-> self conarm) (physroom-max-pen))
          (format 0 "PHYSCONE tag=cone-armed maxpen=~f~%" (-> self conarm))
          (physroom-emit-diag "cone-armed")
          (phys-cone-off-set! 0)
          (phys-diag-reset!)
          (phys-stats-reset!)
          (set! (-> self phase) PHYSROOM-PH-RESTA)
          (phys-rest-k-set! 1.0)))))

    ;; ---- 9 bis. SPEC 33/34 — LA RESTITUTION, ET SON CONTROLE POSITIF.
    ;; Deux jambes IDENTIQUES : meme secousse `jerk`, meme duree, meme animation. La SEULE
    ;; difference est le coefficient. `A` porte ses valeurs (0.06 sein<->sein, 0.02 buste) ; `B`
    ;; les multiplie par 15, ce qui porte le sein<->sein a 0.90. Ce qui doit MONTER entre les deux
    ;; est la vitesse normale SORTANTE relue a la frame suivante — pas un compteur de passages,
    ;; qui ne dirait que « le code est atteint », et pas un rapport deduit de `e`, qui se
    ;; comparerait a lui-meme.
    ;; SI `n` EST ZERO SUR LES DEUX JAMBES, LE DOMAINE EST VIDE et rien n'est prouve ici : c'est
    ;; ecrit tel quel dans le rapport, jamais transforme en vert.
    ((= (-> self phase) PHYSROOM-PH-RESTA)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (format 0 "PHYSRESTLEG tag=spec n=~f m=~f vin=~f vout=~f esum=~f~%"
               (phys-rest 0) (phys-rest 4) (phys-rest 1) (phys-rest 2) (phys-rest 3))
       (phys-stats-reset!)
       (phys-rest-k-set! 15.0)
       (set! (-> self phase) PHYSROOM-PH-RESTB)
       (set! (-> self pframe) 0)))

    ((= (-> self phase) PHYSROOM-PH-RESTB)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (format 0 "PHYSRESTLEG tag=x15 n=~f m=~f vin=~f vout=~f esum=~f~%"
               (phys-rest 0) (phys-rest 4) (phys-rest 1) (phys-rest 2) (phys-rest 3))
       (phys-rest-k-set! 1.0)
       (phys-stats-reset!)
       (set! (-> self phase) PHYSROOM-PH-REPORT)
       (set! (-> self pframe) 0)))

    ;; ---- 10. RAPPORT --------------------------------------------------------------------------
    ((= (-> self phase) PHYSROOM-PH-REPORT)
     (physroom-report)
     (set! (-> self phase) PHYSROOM-PH-DONE)
     (set! (-> self pframe) 0))

    (else
     (physroom-hold)))
  (none))

(defstate phys-subject-run (phys-subject)
  :code (behavior () (loop (suspend)))
  :trans (behavior () (physroom-tick))
  :post (behavior () (ja-post)))

;; ------------------------------------------------------------------------------------------------
;; UN ART-GROUP DE KEIRA, PAR NOM. Deux sources, dans cet ordre, et la source utilisee est publiee :
;;
;;   1. DEJA RESIDENT dans le repertoire d'art d'un niveau charge. C'est le cas sur le DEVICE, ou la
;;      salle s'ouvre depuis une partie vivante : `assistant` est deja dans le repertoire de
;;      village1. Il faut alors le re-declarer dans celui de level-default, parce que c'est la que
;;      initialize-skeleton va le chercher pour un sujet sans entite (process-drawable.gc:343).
;;   2. CHARGE depuis un .go isole (`loado`), le cas x86 ou la salle part de l'ecran titre et ou
;;      aucun niveau n'est charge.
;;
;; Mesure du 2026-08-11 qui a impose ce chemin : sur le device, `files/out/jak1/obj/assistant-ag.go`
;; n'existe pas (seul le jeu de CGO/DGO y est extrait), `loado` a echoue — et le test de nullite
;; etait FAUX : `loado` rend le SYMBOLE #f, dont l'offset n'est pas zero, donc
;; `(nonzero? (the-as int ag))` etait VRAI et la salle continuait sur un art-group inexistant au lieu
;; d'echouer bruyamment. C'est le piege s7 : la nullite d'un basic se teste contre #f, pas contre 0
;; (et 0 est truthy, donc il faut LES DEUX tests).
;; ------------------------------------------------------------------------------------------------
(defun physroom-load-ag ((name string))
  ;; `art-group-get-by-name` est la methode du jeu lui-meme (level.gc:892) : elle balaie les trois
  ;; emplacements de niveau (level0, level1, level-default) et compare le nom que l'art-group porte.
  ;; On ne reimplemente pas la recherche, on appelle celle qui fait foi.
  (let ((res (art-group-get-by-name *level* name)))
    (cond
      ((and res (nonzero? (the-as int res)))
       ;; deja en memoire : on le re-declare dans level-default et on ne recharge rien
       (set-loaded-art (-> *level* level-default art-group) res)
       (format 0 "PHYSAG name=~S source=resident~%" name)
       res)
      (else
       (let ((ag (the-as art-group (loado (make-file-name (file-kind art-group) name 6 #f) global))))
         (cond
           ((and ag (nonzero? (the-as int ag)) (type-type? (-> ag type) art-group))
            (login ag)
            (set-loaded-art (-> *level* level-default art-group) ag)
            (format 0 "PHYSAG name=~S source=loado~%" name)
            ag)
           (else
            (format 0 "PHYSAGFAIL name=~S~%" name)
            (the-as art-group #f))))))))

;; ------------------------------------------------------------------------------------------------
;; NAISSANCE DU SUJET
;; ------------------------------------------------------------------------------------------------
(defbehavior init-phys-subject phys-subject ()
  (set! (-> self phase) PHYSROOM-PH-SETTLE)
  (set! (-> self pframe) 0)
  (set! (-> self ai) 0)
  (set! (-> self drive) 0)
  (set! (-> self slot) -1)
  (set! (-> self nchain) 0)
  (set! (-> self viol) 0)
  (set! (-> self nactor) 0)
  (set! (-> self killed) 0)
  (set! (-> self nanim) 0)
  (set! (-> self nenum) 0)
  (set! (-> self nag) 0)
  (set! (-> self dis) 0.0)
  (set! (-> self arm) 0.0)
  (set! (-> self injn) 0)
  (set! (-> self lvl) 0)
  (set! (-> self nchan) 0)
  (set! (-> self nperm) 0)
  (set! (-> self fnum) 0.0)
  (set! (-> self adir) 1.0)
  (set! (-> self aspeed) 1.0)
  (set! (-> self wraps) 0)
  (set! (-> self nframe) 1.0)
  (set! (-> self root) (new 'process 'trsqv))
  (vector-identity! (-> self root scale))
  (quaternion-identity! (-> self root quat))
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (position-in-front-of-camera! (-> self root trans) 40960.0 4096.0)
  (vector-copy! (-> self home) (-> self root trans))
  ;; l'art-group du sujet, charge PAR NOM et sans niveau, puis le squelette dessus.
  (let ((ag0 (physroom-load-ag (-> *physroom-ag-names* 0))))
    (cond
      ((and ag0 (nonzero? (the-as int ag0)))
       (+! (-> self nag) 1)
       (initialize-skeleton self *phys-subject-sg* '())
       (logclear! (-> self draw status) (draw-status no-skeleton-update))
       ;; LE NOMBRE DE CANAUX DU PORTEUR, tel que `do-joint-math!` le lit (process-drawable.gc:247),
       ;; et la pose de repos qui servira aux canaux sans source. Les deux sont etablis AVANT le
       ;; premier `physroom-set-anim`, donc avant la premiere permutation.
       (set! (-> self nchan)
             (if (nonzero? (-> self draw mgeo)) (the int (-> self draw mgeo num-joints)) 0))
       (when (and (nonzero? (-> self draw jgeo)) (> (-> self nchan) 0))
         (physroom-build-rest! (-> self draw jgeo) (-> self nchan)))
       (format 0 "PHYSREST chan=~D restok=~D~%" (-> self nchan) *physroom-restok*)
       (let ((njoint (if (nonzero? (-> self draw jgeo)) (-> self draw jgeo length) -1)))
         (format 0 "PHYSSUBJECT ag=~S elems=~D bones=~D joints=~D mgeo=~S~%"
                 (-> ag0 name)
                 (-> ag0 length)
                 (if (nonzero? (-> self draw skeleton)) (-> self draw skeleton length) -1)
                 njoint
                 (if (nonzero? (-> self draw mgeo)) (-> self draw mgeo name) "?"))
         ;; LA TABLE DES ANIMATIONS : les SIX art-groups de Keira. Une animation n'est retenue que
         ;; si son nombre de joints est celui du rig du sujet ; sinon elle est publiee REFUSEE.
         (dotimes (g (-> *physroom-ag-names* length))
           (let ((ag (if (zero? g) ag0 (physroom-load-ag (-> *physroom-ag-names* g)))))
             (when (and ag (nonzero? (the-as int ag)))
               (when (nonzero? g) (+! (-> self nag) 1))
               (dotimes (i (-> ag length))
                 (let ((e (-> ag data i)))
                   (when (and (nonzero? (the-as int e)) (= (-> e type) art-joint-anim))
                     (+! (-> self nenum) 1)
                     ;; TOUTES LES ANIMATIONS, Y COMPRIS CELLES DES VARIANTES (owner 2026-08-11
                     ;; 16:15 : « faut tester vraiment toutes les animations qu'utilise le perso
                     ;; tout au long du jeu, pas quelques unes ! »).
                     ;;
                     ;; Les 13 ecartees vivent sur les art-groups de Fire Canyon et des Lava Tubes,
                     ;; dont le rig porte 94 joints la ou celui du village 1 en porte 96. L'ancienne
                     ;; regle `(= nj njoint)` les refusait — un de-scope avec une raison ecrite
                     ;; a cote, ce qui n'est pas une couverture.
                     ;;
                     ;; Pourquoi les jouer sur CE rig est correct, et non un contournement : le
                     ;; nombre de joints ecrits est porte par le bloc compresse de l'ANIMATION
                     ;; (`frame-group frames`, joint.gc:940-955), pas par le squelette. Une
                     ;; animation a 94 joints en pilote 94 ; les joints 94 et 95, qui n'existent que
                     ;; sur le rig du village 1, gardent leur pose precedente. La salle publie donc
                     ;; le compte de chaque animation (`joints=`) ET la liste des joints propres au
                     ;; rig porteur, pour que personne n'ait a supposer lesquels ne sont pas pilotes.
                     ;; Si un de ces joints portait une chaine, la mesure le dirait : le compteur
                     ;; d'ancrage `rootdev` de cette chaine partirait, et la gate ROOT le refuserait.
                     (let ((nj (-> e length)))
                       (cond
                         ((< (-> self nanim) PHYSROOM-MAXANIM)
                          (set! (-> *physroom-anim-ag* (-> self nanim)) ag)
                          (set! (-> *physroom-anim-ix* (-> self nanim)) i)
                          (format 0 "PHYSANIM a=~D ag=~S name=~S joints=~D~%"
                                  (-> self nanim) (-> ag name) (-> e name) nj)
                          (when (!= nj njoint)
                            (format 0 "PHYSANIMRIG ag=~S name=~S joints=~D porteur=~D~%"
                                    (-> ag name) (-> e name) nj njoint))
                          (+! (-> self nanim) 1))
                         (else
                          (format 0 "PHYSANIMSKIP ag=~S name=~S joints=~D want=~D~%"
                                  (-> ag name) (-> e name) nj njoint))))))))))
         (format 0 "PHYSANIMS accepted=~D enumerated=~D ags=~D~%"
                 (-> self nanim) (-> self nenum) (-> self nag))
         ;; QUI PEUT PORTER LA PHYSIQUE : la physique de Keira vit sur son compagnon HD, et le
         ;; compagnon ne se greffe que sur un acteur dont le nom de merc est mappe. On ne le
         ;; suppose pas en lisant le source : on appelle la fonction que le jeu appelle, pour les
         ;; six mgeo de Keira, et on publie sa reponse. entry=-1 = aucun compagnon, donc aucune
         ;; chaine, donc rien a mesurer sur ce rig-la.
         (#when FLAG_HD_MODELS
           (dotimes (g (-> *physroom-mgeo-names* length))
             (format 0 "PHYSMGEO ag=~S mgeo=~S entry=~D~%"
                     (-> *physroom-ag-names* g)
                     (-> *physroom-mgeo-names* g)
                     (hd-desired-entry-for-mgeo (-> *physroom-mgeo-names* g))))))
       (cond
         ((> (-> self nanim) 0)
          (physroom-set-anim 0)
          (go phys-subject-run))
         (else
          (format 0 "PHYSFAIL reason=no-playable-animation~%")
          (deactivate self))))
      (else
       (format 0 "PHYSFAIL reason=art-group-assistant-not-loadable~%")
       (deactivate self))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; L'ENTREE. Appelee depuis C++ (kmachine.cpp, env OG_PHYS_ROOM) via *listener-function*, donc avec
;; un `pp` valide. Trois gestes, dans cet ordre : tuer le joueur, couper la naissance d'entites,
;; spawner le sujet.
;; ------------------------------------------------------------------------------------------------
(defun phys-room-start ()
  (format 0 "PHYSROOM-START target-before=~A~%" *target*)
  (stop 'debug)                     ;; logic-target.gc:1268 — kill-by-name 'target + *target* = #f
  (set! *spawn-actors* #f)          ;; entity.gc:1029 — plus aucune entite ne nait
  (set! (-> *pc-settings* recharged-enhanced-models?) #t)
  (set! (-> *pc-settings* hd-look-keira) 1)   ;; 1 = keira-hd (entry 2)
  (set! (-> *pc-settings* physics?) #t)
  (#when FLAG_HD_MODELS (pc-set-recharged-enhanced-models! 1))
  (pc-set-physics! 1 (-> *pc-settings* physics-quality))
  (set! *physroom-proc*
        (the-as (pointer phys-subject)
                (process-spawn phys-subject :init init-phys-subject :from *pc-dead-pool* :to *default-pool*)))
  (format 0 "PHYSROOM-START target-after=~A spawned=~D~%" *target* (if (nonzero? (the-as int *physroom-proc*)) 1 0))
  ;; PREUVE D'EXECUTION DES DEUX CONVERTISSEURS DE NOTE-50, et pas une relecture de leur source.
  ;; Un Pade transcrit de travers en GOAL rendrait un nombre plausible et fausserait TOUT
  ;; l'amortissement en silence ; ces deux lignes sont ce qui l'interdit. Les valeurs attendues
  ;; sont calculees hors du jeu et ecrites dans le rapport AVANT la course :
  ;;   phys-decay 0.1686  -> 0.844847   (mode principal, retention par frame)
  ;;   phys-decay 0.7079  -> 0.492673   (mode secondaire SPEC 36)
  ;;   phys-osc-k2 0.65 0.5445367 -> 0.207351  et sa retention 0.492672  (SPEC 36 exact)
  ;;   phys-osc-k2 0.35 0.2838553 -> 0.072584                            (torsion SPEC 29)
  ;; NATURE : facteurs sans dimension d'une recurrence. REPERE : aucun, ce sont des scalaires.
  ;; LECTURE HORS DEFAUT : les six nombres ci-dessus, au 1e-5.
  (format 0 "PHYSDECAY a=~f b=~f~%" (phys-decay 0.1686) (phys-decay 0.7079))
  (format 0 "PHYSOSCK2 sec=~f seckd=~f tor=~f~%"
          (phys-osc-k2 0.65 0.5445367)
          (phys-decay (* 2.0 (* 0.65 0.5445367)))
          (phys-osc-k2 0.35 0.2838553))
  (none))

)
