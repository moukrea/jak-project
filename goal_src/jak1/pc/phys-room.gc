;;-*-Lisp-*-
(in-package goal)

;; phys-room.gc — LA SALLE DE TEST DE KEIRA, SANS JOUEUR (SPEC-keira-physique.md section 6).
;;
;; C'est l'ETAPE 1 du contrat, avant toute physique : sans elle il n'y a pas de mesure, et sans
;; mesure il n'y a rien a dire. Ce que l'owner a demande, mot pour mot :
;;
;;   « il serait bon d'avoir une test room dans laquelle ON NE SPAWN PAS LE PLAYER mais le
;;     personnage a tester, qu'on deplace in game de haut en bas, de gauche a droite, avec
;;     diverses accelerations, a coups, animations (toutes celles concernant ledit PNJ) »
;;
;; La tentative precedente mesurait dans une partie normale a village1-hut avec Jak jouable a
;; l'ecran ; l'owner l'a vu. Ici :
;;
;;   * `phys-room-start` appelle `(stop 'debug)` (logic-target.gc:1268) qui TUE le target et remet
;;     *target* a #f, puis coupe la naissance d'entites (*spawn-actors*). A CHAQUE FRAME de mesure
;;     la salle recompte les target vivants ; le compteur `viol` est publie tel quel. Le tableau ne
;;     peut declarer « joueur absent » que si ce compteur vaut zero — REGLE 0 : la ligne du tableau
;;     est ecrite par le script depuis la trace, pas par une promesse dans ce commentaire.
;;   * le sujet est spawne PAR NOM : l'art-group `assistant` (la Keira stock de jak1) est charge a
;;     la main (loado -> login -> set-loaded-art), exactement comme jak-hd.gc:691-701 charge le
;;     sien. AUCUN NIVEAU N'EST CHARGE : le squelette vit sur level-default. La zone contient le
;;     sujet, sa peau HD, et la camera.
;;   * le compagnon HD `keira-hd` se greffe tout seul (maybe-spawn-jak-hd!, jak-hd.gc:794) parce
;;     que le mgeo du sujet s'appelle `assistant-lod0` — le seul nom que hd-char-for-mgeo mappe
;;     sur Keira (jak-hd.gc:294-297). C'est LUI qui porte les chaines : le rig HD a des os
;;     (Rbanga, Lmidhaira, mask...) que le rig stock n'a pas.
;;   * le sujet est DEPLACE par integration d'une acceleration imposee : haut/bas, gauche/droite,
;;     accelerations croissantes, et a-coups (vitesse posee d'un coup, arrets brutaux).
;;   * TOUTES LES ANIMATIONS DE KEIRA sont jouees — pas seulement celles de l'art-group du sujet.
;;     Keira existe dans le jeu sous six art-groups (`assistant` au village 1, plus les variantes
;;     village2/village3/firecanyon/lavatube-start/lavatube-end) : « toutes celles concernant ledit
;;     PNJ » les prend toutes. Chacune est jouee sur le squelette du sujet apres verification que
;;     son nombre de joints correspond ; celles qui ne correspondent pas sont publiees comme
;;     REFUSEES avec leur compte, jamais ecartees en silence.
;;
;; Ce fichier ne calcule AUCUNE physique et n'invente AUCUN instrument : il fenetre, il lit les
;; accumulateurs de jak-hd-physics.gc (qui sont remplis la ou la position ecrite est connue), et
;; il imprime. Les lignes brutes commencent toutes par PHYS* et sont converties en tableau par
;; .autoport/physics_room_table.py.

(#when FLAG_PHYSICS

;; ------------------------------------------------------------------------------------------------
;; le sujet. `assistant` = le nom jak1 de Keira ; `assistant-lod0` est le mgeo que le compagnon HD
;; reconnait. :texture-level 2 fait passer initialize-skeleton par *level* level-default
;; (process-drawable.gc:343) : pas d'entite, pas de niveau.
;; ------------------------------------------------------------------------------------------------
(defskelgroup *phys-subject-sg* assistant
  assistant-lod0-jg
  assistant-idle-leaning-right-ja
  ((assistant-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 2)
  :texture-level 2)

;; les six art-groups de Keira dans jak1. `assistant` est celui du sujet (il porte le jgeo et le
;; mgeo) ; les cinq autres n'apportent que leurs animations.
(define *physroom-ag-names* (new 'static 'boxed-array :type string
  "assistant"
  "assistant-village2"
  "assistant-village3"
  "assistant-firecanyon"
  "assistant-lavatube-start"
  "assistant-lavatube-end"))

;; les mgeo (noms de merc) que ces six art-groups portent. Ce n'est pas de la decoration : c'est le
;; nom sur lequel le jeu decide si un compagnon HD se greffe (hd-desired-entry-for-mgeo), donc si la
;; physique peut exister. La salle appelle cette fonction pour les six et publie sa reponse.
(define *physroom-mgeo-names* (new 'static 'boxed-array :type string
  "assistant-lod0"
  "assistant-village2-lod0"
  "assistant-village3-lod0"
  "assistant-firecanyon-lod0"
  "assistant-lavatube-start-lod0"
  "assistant-lavatube-end-lod0"))

(defconstant PHYSROOM-MAXANIM 48)   ;; capacite de la table d'animations
;; updown / leftright / accel / jerk / TILT. Le cinquieme est arrive avec la 6e passe de l'owner :
;; « les seins n'ont pas l'air d'etre soumis a la gravite, aucun mouvement quand elle se penche en
;; avant pour souder ». Les quatre premiers TRANSLATENT le sujet, donc ils ne changent jamais
;; l'orientation de l'ancre, donc ils ne peuvent PAS voir une gravite exprimee dans le repere de
;; l'ancre. Il fallait un pilotage qui l'INCLINE.
(defconstant PHYSROOM-DRIVES  5)
;; SOUS-FENETRES par animation : les cinq pilotages, PLUS une fenetre SANS AUCUN PILOTAGE. Cette
;; derniere est la LIGNE DE BASE que reclame le superviseur (2026-08-11 16:15) : « publier la valeur
;; sous animation seule comme ligne de base a soustraire ; un pilotage dont la reponse ne depasse pas
;; la ligne de base n'a rien excite ». Sans elle, une amplitude par pilotage melange ce que le
;; pilotage a provoque et ce que l'animation faisait de toute facon, et on ne peut pas les separer.
(defconstant PHYSROOM-SUBW    6)
(defconstant PHYSROOM-WIN     90)   ;; frames par fenetre de mesure (6 segments de pilotage)
;; L'INCLINAISON EST UNE POSE TENUE, PAS UNE SECOUSSE DE PLUS. Elle monte a 60 degres sur les 24
;; premieres frames (rampe en demi-cosinus : depart et arrivee a vitesse nulle, donc aucun a-coup
;; parasite), puis NE BOUGE PLUS.
(defconstant PHYSROOM-TILTRAMP 24)
;; PERIODE des trois pilotages continus, et le carre de sa pulsation. Une trajectoire A sin(w f) a
;; une acceleration de module EXACTEMENT A w^2 : c'est ce qui permet de commander une acceleration
;; au lieu de l'esperer. 36 frames = un cycle complet dans les 36 frames effectivement mesurees.
;; w = 2 pi / 36 = 0.174533 rad/frame, w^2 = 0.0304617.
(defconstant PHYSROOM-PERIOD  36)
(defconstant PHYSROOM-W2      0.0304617)
;; UNE FENETRE DE MESURE NE COMMENCE JAMAIS SUR UNE DISCONTINUITE — et c'est la seconde moitie de
;; la cause racine de l'echec « DISCRIMINANT ».
;;
;; Ce que la salle faisait, mesure par le compteur `acc` (pire acceleration de la pose d'auteur
;; REELLEMENT recue par la pointe, en u/frame^2) sur la course du 2026-08-11 :
;;
;;     pilotage        updown  leftright  accel   jerk   tilt   AUCUN (ligne de base)
;;     acc recu         38964      2555    2570   2569   2543          32991
;;     acc COMMANDE        18        52      96    434  11.16              0
;;
;; Une ligne de base SANS AUCUN PILOTAGE recevait 32991 u/frame^2, soit 76 fois le plus violent des
;; pilotages. Le chiffre ne venait pas de la physique : il venait de la salle. Chaque sous-fenetre
;; s'ouvrait sur une TELEPORTATION du squelette entier, et le compteur repartait de zero juste a
;; temps pour la compter :
;;   * changement d'animation (avant `updown`) : `frame-num` et l'art-group changent d'un coup ;
;;   * retour a la verticale (avant la ligne de base) : `physroom-hold` repose le quaternion a
;;     l'identite, donc 60 degres rendus en UNE frame apres le pilotage `tilt` ;
;;   * retour au point de depart (avant `tilt`) : jusqu'a 3 m rendus en une frame apres `jerk`.
;; La chaine repondait a ce coup-la, pas au pilotage, et elle y repondait PAREIL sous les cinq :
;; c'est exactement « la mesure ne mesure pas le stimulus ».
;;
;; La mesure demarre donc a la frame 54 de chaque sous-fenetre, identique pour les six, et les 36
;; dernieres frames sont les seules comptees. 54 frames de decroissance avec l'amortissement le plus
;; faible du fichier (0.24) laissent 0.76^54 = 6e-8 du transitoire. Ce n'est pas un filtre : rien
;; n'est retire au signal, on a seulement cesse de mesurer pendant que l'instrument frappait le
;; sujet. Les fenetres restent egales entre elles, donc les amplitudes restent comparables.
(defconstant PHYSROOM-MEASAT  54)
(defconstant PHYSROOM-SETTLE  120)  ;; frames d'amorcage avant la premiere mesure
(defconstant PHYSROOM-IDLES   150)  ;; frames de calme AVANT de mesurer le repos
(defconstant PHYSROOM-IDLEM   120)  ;; frames de mesure du repos
(defconstant PHYSROOM-PCW     90)   ;; frames par branche du controle positif
(defconstant PHYSROOM-LIMIT   12288.0) ;; +/- 3 m autour du point de depart
;; COURBE DE REPONSE (6e passe : « les grosses meches sont trop statiques sur les mouvements
;; faibles, trop hysteriques sur les mouvements brusques »). Une reponse non lineaire, c'est un
;; seuil ; on mesure donc l'amplitude de pointe en fonction de l'amplitude d'EXCITATION, sur une
;; echelle geometrique. Une marche dans la courbe designe le seuil coupable.
(defconstant PHYSROOM-RESPL   6)    ;; niveaux d'excitation
(defconstant PHYSROOM-RESPW   72)   ;; frames par niveau
;; INCLINAISON STATIQUE : elle se penche, et on tient la pose. L'excitation d'acceleration retombe
;; a zero, donc ce qui reste dans l'ecart a la pose du modele n'est plus que la gravite.
(defconstant PHYSROOM-TILTDEG 60.0)

;; phases
(defconstant PHYSROOM-PH-SETTLE 0)
(defconstant PHYSROOM-PH-MEAS   1)
(defconstant PHYSROOM-PH-RESP   2)
(defconstant PHYSROOM-PH-IDLE   3)
(defconstant PHYSROOM-PH-TILT   4)
;; LE RETOUR — la seconde moitie de l'aller-retour (defaut `hair-hysteresis`, owner 2026-08-13
;; 21:30 : « beaucoup d'hysteresis pour tous les cheveux […] j'ai envie de la desactiver parce que
;; c'est horrible ! »).
;;
;; NATURE : un DEPLACEMENT SOUTENU RESIDUEL apres un cycle FERME. Ce n'est ni une amplitude ni une
;;   forme : l'hysteresis est le fait que la meme entree ne rende pas la meme sortie selon le chemin
;;   parcouru pour y arriver. La seule facon de la lire est donc de revenir EXACTEMENT au point de
;;   depart et de comparer les deux poses etablies. Une variance, une amplitude de pointe ou une
;;   duree de ballottement ne peuvent structurellement pas la voir — elles ne regardent qu'une
;;   extremite du chemin.
;; REPERE : celui de l'ANCRE, herite de `phys-tip-mean` (jak-hd-physics.gc:4455). Jamais le monde :
;;   le sujet est ramene a `home` a chaque frame, mais une pointe qui suit son parent afficherait le
;;   chiffre de son parent — c'est la faute de la 10e passe, deja payee.
;; LECTURE QUAND LE DEFAUT EST ABSENT : ZERO. Un systeme purement dissipatif (ressort + amortisseur
;;   + gravite, sans terme a memoire) revient au MEME equilibre des lors que l'inclinaison qui le
;;   definit est revenue a la meme valeur et qu'on lui a laisse le meme temps pour s'etablir.
;;   Un ecart non nul EST l'hysteresis, et il n'a pas d'autre explication.
;;
;; POURQUOI CETTE PHASE EST LA COPIE CONFORME DE PHYSROOM-PH-IDLE, ET PAS UNE PHASE NEUVE : la
;; comparaison n'a de sens que si les deux poses sont etablies dans des conditions IDENTIQUES. Meme
;; appel (`physroom-hold`), meme etablissement (PHYSROOM-IDLES), meme fenetre de mesure
;; (PHYSROOM-IDLEM), meme emetteur (`physroom-emit-mean`). La SEULE difference entre `idle` et
;; `back` est le chemin parcouru entre les deux : 0 deg -> 60 deg -> 0 deg. Tout le reste est egal,
;; donc tout ecart s'impute au chemin. C'est aussi pourquoi l'aller et le retour sont deux sauts
;; d'une frame de meme amplitude et de signe oppose : le cycle est ferme.
;;
;; AUCUN OPERATEUR N'EST AJOUTE AU SOLVEUR (DIRECTIVES 21:30 : « on arrete d'ajouter »). Cette phase
;; est de l'INSTRUMENT : elle rejoue une phase existante et reutilise un emetteur existant.
(defconstant PHYSROOM-PH-BACK   5)
;; LE CYCLE FERME DANS LE REGIME OU LE DEFAUT VIT, ET SON CONTROLE POSITIF.
;;
;; POURQUOI CES QUATRE PHASES EXISTENT. Le cycle `tilt` (PHYSROOM-PH-BACK) est QUASI-STATIQUE : elle
;; se penche lentement et tient la pose. Il a rendu un ecart de retour <= 1,75 % de l'excursion —
;; et ce zero-la ne prouve RIEN, pour deux raisons ecrites dans le contrat : aucun controle positif
;; n'avait tire, et le stimulus n'exerce pas les termes a memoire du solveur (recul, reflexion de
;; cote, attenuation), qui ne se declenchent que sur du mouvement RAPIDE. Les compteurs le disent :
;; `lmidhair` encaisse 10 421 reculs sur la phase d'animations et quasiment aucun pendant la tenue.
;; L'owner, lui, regarde des animations de jeu. Mesurer l'hysteresis dans un regime ou ses causes
;; ne tirent pas, c'est la classe `stimulus-must-be-representative`.
;;
;; LE CYCLE : on SECOUE (`jerk`, la meme commande que le controle positif de penetration), puis on
;; relache et on tient la pose. L'etat COMMANDE au depart et a l'arrivee est le meme — `home`,
;; quaternion identite, animation figee sur la meme frame — exactement comme `back`. Un systeme sans
;; memoire revient donc a la meme pose ; l'ecart EST l'hysteresis, cette fois dans le bon regime.
;; REFERENCE : `back`, pas `idle` — c'est la pose etablie qui precede immediatement, mesuree de la
;; meme facon, ce qui retire du calcul tout ce que le cycle `tilt` aurait pu laisser.
;;
;; LE CONTROLE POSITIF, ET IL N'AJOUTE AUCUN OPERATEUR : on rejoue le MEME cycle avec la contrainte
;; de cote LEVEE (`phys-side-off-set!`, le bouton qui existe deja et que la salle arme deja plus
;; bas). Contrainte levee, un maillon qui passe du mauvais cote de l'axe d'un volume y RESTE — un
;; equilibre stable mais faux, qui est precisement un non-retour. Si `gap` ne monte pas quand on
;; leve ce verrou, c'est que la mesure ne mesure rien, et je le dirai.
(defconstant PHYSROOM-PH-SHAKE    6)   ;; secousse `jerk`,       cycle NORMAL
(defconstant PHYSROOM-PH-SHAKEN   7)   ;; relache + tenue,       emet `shaken`
(defconstant PHYSROOM-PH-SHAKEPC  8)   ;; secousse `jerk`,       contrainte de cote LEVEE
(defconstant PHYSROOM-PH-SHAKENPC 9)   ;; relache + tenue,       emet `shakenpc`
(defconstant PHYSROOM-PH-PCOFF 10)
(defconstant PHYSROOM-PH-PCON 11)
(defconstant PHYSROOM-PH-AUTHPC 12)
(defconstant PHYSROOM-PH-INVPC 13)
(defconstant PHYSROOM-PH-SELFOFF 14)
(defconstant PHYSROOM-PH-SELFON 15)
;; CONTROLE POSITIF DE LA CONTRAINTE DE COTE — DEUX BRANCHES QUI BALAYENT LES ANIMATIONS.
;;
;; Ce que faisait la version precedente, et pourquoi elle a rendu `armed=0 disarmed=0` : la branche
;; armee tenait 90 frames sur UNE SEULE animation (index 0, `assistant-idle-leaning-right`) et un
;; seul pilotage, pendant que le phenomene qu'elle pretend exercer — les lunettes qui traversent le
;; buste, le pan qui passe dans le mollet — se produit sur des animations PRECISES que cette
;; fenetre-la ne joue jamais. Un controle qui n'expose pas le defaut ne prouve pas qu'il a disparu :
;; il prouve qu'on ne l'a pas regarde. Mesure de la course du 2026-08-12 15:46 : side=0.0 sur les
;; SIX fenetres de diagnostic, y compris armee.
;;
;; Les deux branches balayent donc les MEMES `nanim` animations, `PHYSROOM-PCW` frames chacune, meme
;; pilotage : exposition identique de part et d'autre, ce qui est la seule facon de comparer deux
;; comptes. C'est aussi la correction que le cycle precedent avait ecrite sans la poser : comparer
;; 43 evenements sur 90 frames a 11446 sur 16740 rapprochait deux expositions differentes.
(defconstant PHYSROOM-PH-SIDEOFF 16)   ;; contrainte EN PLACE   — la reference
(defconstant PHYSROOM-PH-SIDEON 17)   ;; contrainte LEVEE      — le compteur DOIT monter
;; 18 et 19 sont LIBRES : ils portaient le controle positif du mecanisme retire le 2026-08-14.
;; CONTROLE POSITIF DU PREDICAT CONIQUE. Les 24 capsules livrees sont TOUTES coniques, et le moteur
;; testait jusqu'ici le rayon interpole au parametre de PROJECTION au lieu du solide que la donnee
;; designe — un ensemble strictement plus PETIT, donc un solveur qui cesse de pousser trop tot.
;; ARMEE (`phys-cone-off-set! 1`), la penetration residuelle DOIT remonter : la mesure, elle, garde
;; le solide exact des deux cotes (`phys-pen-chain` force l'exactitude), sinon le compteur
;; tomberait sous le defaut au lieu de monter. Les deux branches balayent les MEMES animations —
;; c'est la lecon du controle de cote qui rendait 0 contre 0 sur une fenetre trop etroite.
(defconstant PHYSROOM-PH-CONEOFF 20)
(defconstant PHYSROOM-PH-CONEON 21)
;; CYCLE 37 ETAPE 2 — L'ABLATION DES SPHERES PROXIMALES, deux jambes a exposition egale.
(defconstant PHYSROOM-PH-PROXOFF 29)   ;; spheres proximales EN PLACE  — la reference livree
(defconstant PHYSROOM-PH-PROXON 30)    ;; spheres proximales RETIREES  — le travail doit BAISSER
;; SPEC 24/25/26/27 — les trois impulsions ISOLEES, une par axe, chacune suivie de son ring-down
;; libre. Numeros pris dans les trous laisses libres sous PHYSROOM-PH-REPORT (18, 19, 22) : toute
;; phase de TRAVAIL doit rester INFERIEURE a 30, cf. la note de PHYSROOM-PH-REPORT.
(defconstant PHYSROOM-PH-AXV 18)     ;; impulsion VERTICALE   puis ring-down
(defconstant PHYSROOM-PH-AXB 19)     ;; impulsion AVANT-ARRIERE puis ring-down
(defconstant PHYSROOM-PH-AXL 22)     ;; impulsion LATERALE    puis ring-down
;; LES MEMES TROIS, CONTRAINTE DE LONGUEUR DESARMEE — le controle positif de l'hypothese du
;; cycle 8. `ROOM-AXSEL` mesure qu'un seul axe sur trois est isolable ; l'explication proposee est
;; qu'un point contraint sur une sphere n'a que deux degres de liberte de translation. Si c'est
;; vrai, desarmer la contrainte doit faire MONTER la selectivite. Si elle ne bouge pas, l'hypothese
;; est fausse — et c'est un resultat aussi, publie tel quel.
(defconstant PHYSROOM-PH-AXZV 23)    ;; idem AXV, contrainte de longueur LEVEE
(defconstant PHYSROOM-PH-AXZB 27)    ;; idem AXB, contrainte de longueur LEVEE
(defconstant PHYSROOM-PH-AXZL 28)    ;; idem AXL, contrainte de longueur LEVEE
(defconstant PHYSROOM-PH-ORI 24)     ;; SPEC 10-13 : le balayage d'orientation
(defconstant PHYSROOM-PH-RESTA 25)   ;; SPEC 33/34 : secousse, restitution AUX VALEURS DE LA SPEC
(defconstant PHYSROOM-PH-RESTB 26)   ;; SPEC 33/34 : MEME secousse, coefficient x15 (controle +)
(defconstant PHYSROOM-ORIS 60)       ;; frames d'etablissement par orientation
(defconstant PHYSROOM-ORIM 30)       ;; frames de mesure par orientation
;; REPORT et DONE passent de 22/23 a 30/31 : `physroom-tick` teste `(< phase PHYSROOM-PH-REPORT)`
;; pour savoir si la course est encore en cours (le balayage d'acteurs etrangers en depend), donc
;; toute phase de TRAVAIL doit avoir un numero INFERIEUR. Les ajouter au-dessus de 22 sans deplacer
;; REPORT les aurait rendues silencieusement inertes de ce point de vue.
;;
;; 2026-08-19, CYCLE 38 — CETTE REGLE A ETE ENFREINTE PAR LA LIGNE QUI LA SUIT DE 25 LIGNES, ET
;; PENDANT DEUX CYCLES. `PHYSROOM-PH-PROXON` a ete pose a 31, c'est-a-dire (a) AU-DESSUS de REPORT
;; et (b) sur le MEME numero que DONE. Trois consequences, toutes verifiees dans le code :
;;   1. `physroom-tick:1530` arme le balayage d'acteurs etrangers par `(< phase REPORT)`. A 31 il
;;      est DESARME. La jambe ARMEE de l'ablation du cycle 37 tournait donc SANS ce balayage
;;      pendant que la jambe DESARMEE (phase 29) l'avait : « deux jambes a exposition egale »
;;      etait FAUX EN DROIT. Sur la course C37E2 l'effet mesure est nul (`PHYSNOPLAY viol=0
;;      actors=0 killed=0`) — la mesure n'est pas corrompue, l'affirmation l'etait.
;;   2. Il n'existe AUCUNE branche pour DONE : le `cond` teste PROXON (:2935) AVANT REPORT (:2993)
;;      et se termine par `(else (physroom-hold))`. Une fois REPORT execute et `phase` mis a DONE,
;;      le tick suivant retombait donc DANS LA JAMBE ARMEE au lieu de tenir la pose.
;;   3. Le chemin d'ECHEC `PHYSFAIL reason=skeleton-not-posed-bones-at-origin` (:1703) met lui
;;      aussi `phase` a DONE : une course en echec ENTRAIT dans la jambe armee au lieu de s'arreter.
;; REPORT et DONE montent donc a 40/41 et PROXON redescend a 30. Le seul numero libre sous 30
;; n'existait pas — 0 a 29 sont tous pris — et c'est exactement ce qui avait pousse a prendre 31.
;; Deplacer REPORT est la reponse que ce commentaire prescrivait deja en 2026-08-12 ; elle n'a pas
;; ete appliquee la deuxieme fois.
;; ------------------------------------------------------------------------------------------------
;; SPEC 14 A 20 — LES SEPT REGIMES DYNAMIQUES, JOUES POUR LA PREMIERE FOIS (cycle 49).
;;
;; POURQUOI CETTE PHASE EXISTE. Le registre de couverture range §14 a §20 en `NON ETABLI` avec le
;; meme motif, et c'est le plus gros trou du dossier : « regime jamais joue dans la salle ». Les
;; cinq pilotages de PH-MEAS (`updown`, `leftright`, `accel`, `jerk`, `tilt`) sont des stimuli
;; D'INSTRUMENT — aucun n'est un saut, un atterrissage, un freinage ni une rotation de torse. Or
;; ces sept sections sont les SEULES de sa spec qui relient un GESTE NOMME a une bande chiffree de
;; COM, et le COM pondere par la masse — la grandeur qu'elles nomment — n'existe que depuis le
;; cycle 48. L'instrument etait pret, le STIMULUS manquait. C'est lui que cette phase apporte.
;;
;; LES STIMULI SONT DERIVES DE LA BIOMECANIQUE, JAMAIS CHOISIS POUR TOMBER DANS UNE BANDE.
;; Unites : 4096 u = 1 m, 60 Hz, donc 1 g = 9.81 * 4096 / 3600 = 11.162 u/frame^2 — le meme
;; nombre que le `gy = -11.16` du moteur, ce qui est le controle d'unites de ce bloc.
;; Chaque regime porte le geste humain dont il vient et l'acceleration de pointe qui en decoule.
;; Aucune n'a ete ajustee apres coup : `never-fit-a-parameter-to-the-instrument`, et un stimulus
;; regle pour rendre une bande ne mesurerait que lui-meme.
;;
;;   r  fenetre         geste humain                          pointe (u/frame^2)   = g
;;   0  base            AUCUN pilotage — LE TEMOIN                    0.00        0.00
;;   1  jumpA-push      detente ordinaire, h = 0.25 m                13.19        1.18
;;   2  jumpA-fly       vol balistique : l'ancre tombe a -g          11.16        1.00
;;   3  jumpA-land      reception souple, 0.23 s                     16.85        1.51
;;   4  jumpB-push      detente forte, h = 0.45 m                    21.24        1.90
;;   5  jumpB-fly       vol balistique fort                          11.16        1.00
;;   6  jumpB-land      reception DURE, 0.15 s                       34.74        3.11
;;   7  runA-accel      demarrage, 0 -> 4.5 m/s en 0.6 s              8.53        0.76
;;   8  runA-brake      arret net, 4.5 -> 0 en 0.3 s                 17.06        1.53
;;   9  yawA            demi-tour modere, 90 deg en 0.40 s      tan 7.38 / cen 5.79
;;  10  yawB            demi-tour rapide, 150 deg en 0.35 s     tan 16.06 / cen 21.01
;;  11  pitchA-bend     buste en avant, 70 deg en 0.40 s        tan 20.15 / cen 12.31
;;  12  pitchA-return   retour a la verticale, 0.40 s           tan 20.15 / cen 12.31
;;  13  rollA           inclinaison laterale, 35 deg en 0.35 s  tan 13.14 / cen  4.01
;;  14  rollB           bascule +35 -> -35 deg, 0.35 s          tan 26.27 / cen 16.05
;;
;; L'EVENTAIL VA DE 4 A 35 u/frame^2 ET IL TRAVERSE LE COUDE DE SATURATION QUE LA SALLE A ELLE-MEME
;; MESURE (18 a 42, voir la table de `physroom-drive`). Ce n'est pas un hasard : une reponse plate
;; sur sept regimes serait indistinguable d'une saturation si tous tapaient du meme cote du coude.
;;
;; UN SAUT EST UN SEUL MOUVEMENT, ET C'EST POURQUOI §14, §15 ET §16 SONT TROIS FENETRES CONSECUTIVES
;; D'UNE MEME TRAJECTOIRE, sans retour au repos entre elles. Sa §15 l'exige mot pour mot : « This
;; phase reversal should occur naturally through INTEGRATION rather than through a scripted bounce
;; animation ». Trois stimuli independants auraient scripte precisement ce qu'elle interdit.
;; CE QUE CA COUTE, ET JE LE DECLARE : la fenetre de vol herite du ring-down de la poussee, et
;; celle d'atterrissage du ring-down du vol. C'est la physique du geste, pas un defaut de montage —
;; mais ca veut dire qu'aucune des trois n'est un mode propre isole, et elles ne doivent pas etre
;; lues comme tel. Les modes propres se lisent dans PH-AXV/AXB/AXL, qui existent pour ca.
;;
;; LE VOL EST LE SEUL REGIME QUI TESTE LE MODELE PLUTOT QUE SES VALEURS. Pendant le vol l'ancre
;; accelere a -g ; la particule, elle, vit en position MONDE et la famille A ne recoit PAS la
;; gravite absolue (seulement `g_local - g_ref`, nul tant que l'orientation ne bouge pas). Elle
;; reste donc en arriere de son ancre qui tombe, ce qui EST l'apesanteur relative : sa §3 predit
;; `a_drive = -a_torso = +g` vers le HAUT. Un moteur pilote par la VITESSE du personnage — ce que
;; sa §15 interdit nommement (« shall not use character speed alone ») — rendrait au contraire
;; ZERO a l'apex, ou la vitesse est nulle. Les deux hypotheses predisent des choses opposees au
;; MEME endroit : c'est la seule fenetre de cette phase qui puisse REFUTER le modele.
;;
;; LE PIVOT DES ROTATIONS EST LA HANCHE, ET IL EST MESURE. Un torse ne pivote pas autour des pieds.
;; `PHYSROOM-HIPY` est la hauteur du joint `hips` relevee sur le mesh LIVRE
;; `out/jak1/fr3/skin/keira-hd-lod0.glb` (md5 5cb8a493c43211acf3a04c5b6433df81) : 6094.4 u, soit
;; 1.488 m — et la racine du sein y est a 7978.6 u, donc 1884.2 u = 46.0 cm au-dessus de la
;; hanche. Une personne a environ 45 cm entre l'articulation de la hanche et la hauteur du sein :
;; c'est le controle de vraisemblance de ce nombre, et il passe. Pivoter autour de la racine de
;; l'acteur (aux pieds) aurait donne un bras 3.2x trop grand — un stimulus invente.
;; LE BRAS N'EST PAS AFFIRME, IL EST VERIFIE A L'EXECUTION : `amax` (le deplacement d'ancre d'une
;; frame a la suivante, deja mesure par le moteur) divise par l'`omega` commandee rend le bras
;; REEL, que le tableau publie a cote du bras commande. Un ecart designerait le repere, pas la
;; physique.
;;
;; POURQUOI 31 : toute phase de TRAVAIL doit avoir un numero INFERIEUR a PHYSROOM-PH-REPORT, parce
;; que `physroom-tick` arme le balayage d'acteurs etrangers par `(< phase PHYSROOM-PH-REPORT)`.
;; La note de PHYSROOM-PH-REPORT dit « INFERIEURE a 30 » : c'etait vrai quand REPORT valait 22 et
;; ca ne l'est plus depuis qu'il vaut 40. 0 a 30 sont tous pris, 31 a 39 sont libres, et c'est
;; exactement le trou que le cycle 38 a rouvert en remontant REPORT. `PHYSROOM-PHASEGUARD` est mis
;; a jour pour surveiller CETTE phase : un garde-fou qui ne surveille pas la derniere phase ajoutee
;; ne garde rien.
(defconstant PHYSROOM-PH-REG 31)
(defconstant PHYSROOM-REGN 15)      ;; fenetres, temoin compris

;; ------------------------------------------------------------------------------------------------
;; LE BALAYAGE PAR SENS DE STIMULUS — LA GRANDEUR QUE LE CYCLE 51 A DESIGNEE SANS LA MESURER.
;;
;; CE QU'IL MESURE, ET POURQUOI IL EST DECIDABLE SANS SEUIL CHOISI. Pour un systeme LINEAIRE, et
;; plus generalement pour TOUTE non-linearite symetrique (la saturation `tanh` de sa SPEC 21, une
;; borne posee sur une NORME, une raideur cubique), la reponse a une impulsion `-u` est EXACTEMENT
;; l'opposee de la reponse a `+u`. Les deux ecarts publies ici,
;;     A_mag = | |r+| - |r-| | / max(|r+|,|r-|)      et      A_dir = 180 deg - angle(r+, r-)
;; valent donc ZERO par PROPRIETE du systeme, pas par convention. Ils ne peuvent devenir non nuls
;; que si un terme du solveur distingue un SENS de l'autre. C'est ce qui separe cet instrument du
;; quatrieme faux vert du dossier (SPEC 11, cycle 49), qui republiait la constante qu'il visait.
;;
;; CE QUI L'A RENDU NECESSAIRE. Le cycle 51 a mesure que la reponse d'apex depend du SENS du
;; stimulus (chestL : 65 % de mouvement vertical vers le BAS, 2 a 5 % vers le HAUT — facteur 13 a
;; 31) et de la CHAINE (x10 a x20 d'ecart gauche/droite sur la detente, quand sa SPEC 32 prescrit
;; 2-5 %). Il a refuse de nommer la cause faute de l'avoir mesuree. Les sept regimes de SPEC 14-20
;; ne pouvaient pas y repondre : leurs stimuli ne sont PAS apparies en signe a amplitude egale.
;;
;; LA FENETRE EST AUTONOME : elle part de `home` et y revient. 10 frames d'impulsion en
;; demi-cosinus (vitesse nulle aux deux bouts, donc rien qui declenche le rebasement de sa SPEC 37),
;; 50 de tenue MESUREE — le pic d'une reponse sous-amortie tombe apres la fin du stimulus —, 10 de
;; retour doux, puis 60 de calme. 60 frames valent 5.05 constantes de temps du mode principal
;; (`omega` = 14.4515 rad/s, `zeta` = 0.35), soit un residu de 0.6 % : c'est la MEME arithmetique
;; que PH-ORI, et le calme qui ferme chaque fenetre est PUBLIE (`PHYSSGN3`) au lieu d'etre suppose.
;;
;; L'ORDRE DES DEUX SENS EST EQUILIBRE SUR LA GRILLE. Le cycle 50 a mesure que les fenetres se
;; contaminent (257 lignes de `row` sur 310 bougent quand une fenetre amont change). Une cellule
;; qui jouerait toujours `+` en premier confondrait donc l'effet du SENS avec celui du RANG : la
;; parite de (k + a) decide lequel passe en premier, si bien que la moitie des cellules joue `+`
;; d'abord et l'autre `-`.
;;
;; LES SIX ABLATIONS SONT CELLES QUI EXISTENT DEJA, et la liste est celle de PH-ORI :
;;   k=0 reference · k=1 longueur levee · k=2 cote levee · k=3 rayon interpole
;;   k=4 MUR DE COLLISION desarme · k=5 borne SPEC 22 du canal radial levee
;; Deux suspects sont deja morts A LA LECTURE DU CODE, avant cette course : `rcap`
;; (jak-hd-physics.gc:2946-2950) applique `phys-softmin` a la valeur ABSOLUE et restitue le signe,
;; et `phys-length-chain` (:1162) est une projection d'EGALITE sur la sphere. Les deux mordent dans
;; les deux sens. Le mur de collision est le seul terme UNILATERAL PAR NATURE — une poussee de
;; contact ne tire jamais — et c'est lui que la prediction P4 mise.
;;
;; NATURE : un MAXIMUM DE FENETRE du deplacement d'apex, en % de `B0`, et son VECTEUR releve a
;;   l'argmax. Exactement les memes emplacements (53-56) que `PHYSREG4`, donc directement
;;   comparable aux sept regimes. Ce n'est ni une variance ni une moyenne.
;; REPERE : le triedre de l'ANCRE (SPEC 7), le meme que `PHYSREG4` et `PHYSRINGA`. Jamais le monde.
;; LIGNE DE BASE : `PHYSSGN3` publie l'apex des 60 frames de CALME qui ferment la fenetre — ce que
;;   l'instrument lit quand le stimulus est ABSENT. Sans lui, aucune asymetrie n'a d'echelle.
;; CE QUI DISCRIMINE : le SENS, a stimulus egal (`stim` est publie pour le prouver, pas pour le
;;   supposer) et a axe egal. Si les deux sens rendaient la meme reponse opposee, il n'y a pas de
;;   terme unilateral et la piste du cycle 51 tombe — ce qui est aussi un resultat, et il est
;;   ecrit comme tel dans la prediction P3.
(defconstant PHYSROOM-PH-SGN 32)
(defconstant PHYSROOM-SGNN  72)     ;; 6 ablations x 3 axes x 2 sens, LE TOUT JOUE DEUX FOIS avec
                                    ;; l'ordre des sens INVERSE a la seconde passe. Le cycle 52
                                    ;; equilibrait l'ordre sur la GRILLE (k+a) mais pas DANS la
                                    ;; cellule : `+` et `-` y restaient la 1re et la 2e fenetre, et
                                    ;; son test rang-contre-sens rendait 10 contre 7 — pas un pur
                                    ;; effet de rang, pas net non plus. Jouer les deux ordres rend
                                    ;; la question decidable au lieu de la laisser en suspens.
(defconstant PHYSROOM-SGNE 150)     ;; RAMPE D'ENTREE : frames de calme AVANT la premiere fenetre.
                                    ;; Le cycle 52 a mesure que la 1re fenetre recevait un stimulus
                                    ;; de 1255.82 u/frame^2 contre ~17.00 sur les 35 autres — x74.
                                    ;; Cause : `PH-SGN` succede a `PH-REG`, dont la derniere fenetre
                                    ;; ne finit pas a `home`, et le `physroom-hold` de sortie y
                                    ;; ramene le sujet D'UN COUP. `physroom-reg-drive` evite ca par
                                    ;; une rampe ENTRE ses fenetres ; il en faut une A L'ENTREE de
                                    ;; toute phase neuve. Sans elle l'axe VERTICAL etait perdu pour
                                    ;; la comparaison de sens, et c'est l'axe de la reception (§16).
(defconstant PHYSROOM-SGNI  10)     ;; fin de l'impulsion
(defconstant PHYSROOM-SGNIF 10.0)   ;; la MEME duree en flottant — `(the float <litteral>)` est une
                                    ;; REINTERPRETATION de bits en GOAL, jamais une conversion.
(defconstant PHYSROOM-SGNM  60)     ;; fin de la fenetre de mesure (impulsion comprise)
(defconstant PHYSROOM-SGNR  70)     ;; fin du retour doux vers `home`
(defconstant PHYSROOM-SGNW 130)     ;; fenetre totale : 10 + 50 + 10 + 60
(defconstant PHYSROOM-RETF 60)      ;; frames de retour DOUX vers `home` au debut d'un `pre`
(defconstant PHYSROOM-RETFF 60.0)   ;; la MEME duree en flottant, et DEUX constantes plutot qu'un
                                    ;; `the` : `(the float <litteral entier>)` se replie en
                                    ;; REINTERPRETATION de bits, pas en conversion — 60 y
                                    ;; deviendrait 8.4e-44. Meme piege que PHYSROOM-IMPF/IMPFF.
(defconstant PHYSROOM-HIPY 6094.4)  ;; joint `hips`, mesure sur le mesh livre (voir ci-dessus)
;; L'OFFSET ANATOMIQUE DE L'ANCRE A SON PIVOT, `chest` - `hips`, mesure sur le MEME mesh livre :
;; (0.0, 7020.8 - 6094.4, 239.8 - 0.0) = (0.0, 926.4, 239.8). C'est le bras de levier que doit
;; avoir l'ancre pendant une rotation de torse, et donc la cible du controle `r_eff = amax/omega`.
(defconstant PHYSROOM-CANY 926.4)
(defconstant PHYSROOM-CANZ 239.8)
(defconstant PHYSROOM-REGG 11.162)  ;; 1 g en u/frame^2 — le meme que le `gy` du moteur

;; pre = frames de repos AVANT (0 = la fenetre enchaine sans rupture sur la precedente)
;; drv = frames de pilotage · post = frames de tenue, MESUREES elles aussi (le pic peut tomber apres)
(define *physroom-reg-pre*  (new 'static 'array int32 15  90 90  0  0 90  0  0 90  0 90 90 90  0 90  0))
(define *physroom-reg-drv*  (new 'static 'array int32 15   0 18 27 14 15 36  9 36 18 24 21 24 24 21 21))
(define *physroom-reg-post* (new 'static 'array int32 15  60  0  0 45  0  0 45  0 45 45 45 12 45 12 45))

;; ------------------------------------------------------------------------------------------------
;; SPEC 12 ET SPEC 18 — LES MEMES STIMULI, JOUES DANS DEUX POSES, DANS LA MEME COURSE (cycle 56).
;;
;; POURQUOI CETTE PHASE EXISTE. Le superviseur a grave le 2026-08-20 05:20 que la pose que la salle
;; TIENT est a 43.4 deg du miroir parfait alors que le rig est symetrique a 0.005 deg, et il a nomme
;; quatre sections a remesurer : §32, §18, §12, et l'attribution du cycle 52. Le cycle 55 a traite la
;; derniere en epinglant la pose de PH-SGN, et l'ecart gauche/droite qu'il y mesurait est tombe de
;; x3.41 a x1.06. Restent §18 et §12, dont les ecarts gauche/droite publies (x2.5 sur l'apex du lacet
;; fort, x5.4 sur le lacet modere) ont ete releves dans la pose asymetrique et sont donc, aujourd'hui,
;; NON LISIBLES — ni tenus, ni refutes.
;;
;; CE QUI REND CETTE PHASE DIFFERENTE DE CE QUE LE CYCLE 55 PROPOSAIT. Son rapport proposait
;; d'epingler la pose de TOUTES les phases et de rejouer. Ce serait deplacer d'un coup les verdicts
;; des sept regimes de §14-§20 (dont §19, l'une des trois seules TENUES du registre) sans aucun
;; controle apparie : on ne saurait pas si un chiffre a bouge a cause de la pose ou a cause de
;; l'histoire de chaine qui la precede. Ici les deux poses sont jouees DANS LA MEME COURSE, a la
;; MEME place, sur le MEME stimulus, et l'ordre des deux jambes est EQUILIBRE (voir `p` ci-dessous) :
;; la seule variable entre elles est le nom de l'animation epinglee. En contrepartie, la trace
;; existante n'est pas touchee — PH-SYM est APPENDUE apres PH-SGN, et `physroom-report` ne publie
;; que des compteurs statiques, donc aucune ligne existante ne peut changer de valeur.
;;
;; LES QUATRE MESURES, ET POURQUOI CELLES-LA.
;;   m=0  lacet 90 deg  (r=9)   §18 « moderate »
;;   m=1  lacet 150 deg (r=10)  §18 « strong » — la seule bande d'APEX que §18 donne (20-30 % B0)
;;   m=2  gravite laterale +90  (ax=0)  §12, pole ou UN sein est du cote gravite
;;   m=3  gravite laterale -90  (ax=0)  §12, pole ou c'est L'AUTRE
;; Les deux poles lateraux sont `oi=2` et `oi=4` de la table de PH-ORI. L'ETIQUETTE D'AXE EST CELLE
;; DE LA MESURE, PAS CELLE DU COMMENTAIRE : le commentaire de `physroom-orient` ecrit « axis 0 =
;; tangage », et la trace dit le contraire (`ROOM-ORI: chestL 2 0 90.0 -0.9979 ...` — la gravite y est
;; quasi pure sur l'axe LATERAL du triedre de sa §7). C'est la trace qui fait foi, et `PHYSSYM5`
;; republie `gx/gy/gz` par cellule pour que personne n'ait a le croire sur parole.
;;
;; POURQUOI LES DEUX POLES LATERAUX SONT LE BON TEST DE §12, ET PAS UN SEUL. §12 dit « The breasts
;; shall not behave identically. The gravity-side breast experiences stronger thoracic compression,
;; while the opposite breast migrates across the chest. » Les deux poles ECHANGENT lequel des deux
;; seins est du cote gravite. Sur un rig symetrique et dans une pose symetrique, la reponse de
;; chestL au pole +90 doit donc egaler celle de chestR au pole -90 : c'est une INVARIANCE MIROIR,
;; verifiable sans choisir aucun seuil, et c'est exactement ce que la pose heritee detruisait.
;;
;; CE QUE CETTE PHASE NE FAIT PAS, ET JE LE DIS PLUTOT QUE DE LE TAIRE : elle ne rejoue PAS la
;; mesure de COUPLAGE de §32 (« bouger un sein deplace l'autre de 32 a 321 % »). Ce chiffre vient
;; d'un diff HORS-LIGNE de deux courses (reference et masse x4 sur une seule chaine, cycle 32) ;
;; aucun script du depot ne le calcule, et il demande deux courses, pas une pose. Il reste ouvert.
(defconstant PHYSROOM-PH-SYM 33)
(defconstant PHYSROOM-SYMN  8)      ;; 4 mesures x 2 poses
(defconstant PHYSROOM-SYME 90)      ;; RAMPE D'ENTREE, meme raison qu'a PHYSROOM-SGNE : la premiere
                                    ;; fenetre d'une phase neuve recoit sinon le retour a `home` de
                                    ;; la phase precedente comme un stimulus (x74 mesure au cycle 52).
(defconstant PHYSROOM-SYMS 60)      ;; etablissement APRES la pose, avant l'ouverture de la fenetre.
                                    ;; 60 frames = 5.05 constantes de temps du mode principal
                                    ;; (1/(zeta.omega) = 0.198 s), residu 0.6 % — meme calcul et meme
                                    ;; valeur que PHYSROOM-ORIS, pour que les deux soient comparables.
(defconstant PHYSROOM-SYMT 60)      ;; queue de CALME qui ferme la cellule : ce que l'instrument lit
                                    ;; stimulus ABSENT. Sans elle aucun ecart n'a d'echelle, et un
                                    ;; rapport gauche/droite ne peut pas etre declare NON RESOLU.
;; r = index de regime pour le lacet, -1 = orientation tenue · ax/dg = l'orientation quand r vaut -1
;; dw = frames de pilotage + tenue. Pour le lacet c'est EXACTEMENT `drv + post` de la table des
;; regimes (24+45 et 21+45), pour que la fenetre soit celle de §18 et pas une fenetre a moi.
(define *physroom-sym-r*  (new 'static 'array int32 4    9  10  -1  -1))
(define *physroom-sym-ax* (new 'static 'array int32 4    0   0   0   0))
(define *physroom-sym-dg* (new 'static 'array float 4  0.0 0.0 90.0 -90.0))
(define *physroom-sym-dw* (new 'static 'array int32 4   69  66  90   90))

(defconstant PHYSROOM-PH-SKINARM 34)   ;; contrainte de peau ARMEE   — l'etat LIVRE
(defconstant PHYSROOM-PH-SKINDIS 35)   ;; contrainte de peau DESARMEE — son controle positif
;; ---- PH-REGS (cycle 66) : LES QUINZE MEMES FENETRES, DANS LA POSE EPINGLEE ------------------
;;
;; POURQUOI UNE DEUXIEME PASSE PLUTOT QUE DE CHANGER LA POSE DE PH-REG. Le cycle 65 a mesure que
;; PH-REG joue §14 a §20 dans une pose HERITEE a 43.8 / 48.0 deg du miroir, et que le SENS de
;; l'asymetrie gauche/droite s'inverse avec la pose. Remplacer la pose de PH-REG aurait bouge les
;; quinze fenetres d'un coup, sans qu'aucun controle apparie ne dise ce qui a bouge a cause de la
;; POSE et ce qui a bouge a cause d'autre chose : c'est exactement le defaut que le cycle 56 a
;; corrige en jouant les DEUX poses DANS LA MEME COURSE. On applique sa lecon ici.
;;
;; DONC : PH-REG reste EXACTEMENT ce qu'il etait — sa trace doit rester identique au bit — et
;; PH-REGS rejoue les MEMES quinze fenetres, avec les MEMES tables `pre`/`drv`/`post`, le MEME
;; `physroom-reg-drive` et la MEME fenetre de mesure, la seule variable declaree etant le nom de
;; l'animation epinglee. La phase est APPENDUE en fin de course (apres PH-SKINDIS) : rien de ce
;; qui precede ne peut la voir.
;;
;; SON NUMERO EST INFERIEUR A PHYSROOM-PH-REPORT, et ce n'est pas cosmetique : `physroom-tick`
;; arme le balayage d'acteurs etrangers par `(< phase PHYSROOM-PH-REPORT)`. Une phase de TRAVAIL
;; au-dessus de 40 cesserait d'etre surveillee.
(defconstant PHYSROOM-PH-REGS 36)
(defconstant PHYSROOM-REGSE 90)     ;; RAMPE D'ENTREE + avance de pose. Meme raison qu'a
                                    ;; PHYSROOM-SGNE et PHYSROOM-SYME : la premiere fenetre d'une
                                    ;; phase neuve recoit sinon le retour de la phase precedente
                                    ;; comme un stimulus (x74 mesure au cycle 52). 90 > MEASAT+1,
                                    ;; donc l'avance de pose tient dedans avec de la marge.
;; ---- PH-REGT (cycle 67) : LES MEMES QUINZE FENETRES, DANS LA POSE LA PLUS SYMETRIQUE MESUREE ---
;;
;; POURQUOI UNE TROISIEME PASSE. Le cycle 66 a joue les quinze fenetres dans la pose epinglee par
;; son NOM (7.5 deg du miroir) et a montre que cinq ecarts gauche/droite sur onze changent de sens
;; entre 48.0 deg et 7.5 deg. Il reste une question que deux points ne peuvent pas trancher :
;; **7.5 deg suffit-il ?** Un rapport qui bouge encore entre 7.5 deg et une pose plus serree n'est
;; pas une propriete du personnage, c'est un reste de pose — et on aurait publie l'un pour l'autre.
;; C'est le TEST DE RAFFINEMENT du registre : on resserre l'instrument et on regarde si la mesure
;; bouge. Il ne demande aucune theorie et il tranche.
;;
;; LA POSE N'EST PLUS CHOISIE, ELLE EST L'ARGMAX MESURE. `*physroom-best-a*` / `*physroom-best-f*`
;; sortent du balayage resolu a la frame de `PHYSROOM-PH-MEAS` (voir la note de
;; `PHYSROOM-POSESTEP`), qui visite les 264 poses au lieu des 31 du cycle 54.
;;
;; ET ELLE EST REVALIDEE A L'EXECUTION, comme les deux autres : `PHYSREGTB` est emis au MEME point
;; de protocole que `PHYSREGB` et `PHYSREGSB` — fenetre temoin r=0, sujet droit, immobile, a
;; `home`. On ne fait jamais confiance a une epingle, on la mesure : c'est le geste du cycle 55.
;;
;; PH-REG ET PH-REGS RESTENT INTACTS AU BIT. La phase est APPENDUE apres PH-REGS ; rien de ce qui
;; precede ne peut la voir. C'est la lecon du cycle 66, appliquee et pas reapprise.
(defconstant PHYSROOM-PH-REGT 37)
(defconstant PHYSROOM-REGTE 90)     ;; meme rampe d'entree que PHYSROOM-REGSE, meme raison : la
                                    ;; premiere fenetre d'une phase neuve recoit sinon le retour de
                                    ;; la phase precedente comme un stimulus (x74 mesure au c52).
;; ---- PH-REGA (cycle 67) : LES SIX FENETRES DE ROTATION, AUTOUR DES AXES DU SUJET ---------------
;; Voir le pave de `physroom-reg-pose-axis` : les axes de §18 a §20 sont ceux du SUJET, la salle
;; tournait autour de ceux du MONDE, et les deux sont a ~90 deg l'un de l'autre — le « tangage » de
;; §19 est joue comme un roulis et le « roulis » de §20 comme un tangage. PH-REGA rejoue les six
;; fenetres de rotation autour des axes MESURES, dans la MEME course et dans la MEME pose que
;; PH-REGT, pour que les deux lectures se comparent sans qu'une deuxieme variable bouge.
;; APPENDUE : PH-REG, PH-REGS et PH-REGT gardent leur trace au bit.
(defconstant PHYSROOM-PH-REGA 38)
(defconstant PHYSROOM-REGAE 90)     ;; meme rampe d'entree, meme raison qu'a PHYSROOM-REGSE.
(defconstant PHYSROOM-REGA0 9)      ;; premiere fenetre de ROTATION de la table des regimes

;; ---- PH-REGB (cycle 70) : LES HUIT FENETRES DE TRANSLATION, SUR LES AXES DU SUJET -------------
;;
;; LE DEFAUT EST MESURE, ET JE L'AI NOMME DEUX FOIS SANS LE FAIRE. `physroom-run-z` accelere le
;; sujet le long du MONDE Z. L'axe avant/arriere du sujet, mesure a l'execution (`PHYSAXW ax=1`),
;; vaut (0.993, 0.096, 0.064) : le monde Z en est a 86.3 deg. La « course » de sa §17
;; (« Horizontal Acceleration and BRAKING ») est donc jouee comme une EMBARDEE LATERALE. Les sauts
;; de §14/§15/§16 partent le long du monde Y, a 11.9 deg de la verticale du sujet : 97.8 % du
;; stimulus tombe au bon endroit, l'ecart est petit mais il est DECLARE et non ignore.
;;
;; C'est le MEME defaut de classe que celui des rotations (§18-§20, cycles 67-68) et que celui du
;; nommage des orientations (§10-§13, cycle 69) : un geste COMMANDE dans le repere du MONDE, LU
;; comme s'il etait celui du SUJET. Les deux premiers ont ete corriges. Celui-ci a ete nomme au
;; cycle 68, renomme au cycle 69, et une troisieme mention aurait ete une note deguisee en verrou.
;;
;; PHASE APPENDUE, JAMAIS UNE POSE REMPLACEE. PH-REG / PH-REGS / PH-REGT / PH-REGA gardent leur
;; trace AU BIT. PH-REGB rejoue les MEMES fenetres — memes tables `pre`/`drv`/`post`, memes profils
;; analytiques, memes emplacements de lecture — avec UNE SEULE variable declaree : l'axe.
;;
;; LES DEUX SENS SONT MESURES, PAS CHOISIS. Le cycle 68 avait du jouer chaque rotation DANS LES
;; DEUX SENS parce qu'un axe mesure n'a pas de sens privilegie. Ici deux references PHYSIQUES
;; existent, que la rotation n'avait pas, et elles coutent une lecture chacune :
;;   LE HAUT : la GRAVITE. `phys-shape ... 16` est sa composante sur la ligne VERTICALE de l'ancre.
;;             Debout elle vaut +0.978, donc cette ligne pointe vers le BAS et le HAUT est son
;;             oppose. SENTINELLE : |gv| < 0.5 = le sujet n'est pas droit, on ne conclut pas.
;;   L'AVANT : la SAILLIE DU SEIN. `phys-link-rest-dir ... 2` vaut -0.148 sur les DEUX chaines ; un
;;             sein fait saillie vers l'avant, donc la ligne 2 pointe vers l'ARRIERE et l'AVANT est
;;             son oppose. SENTINELLE : |ap| < 0.03, ou les deux chaines en desaccord de signe.
;; Les deux sens sont PUBLIES avec leur source (`PHYSREGBS`), et le deplacement d'ancre REELLEMENT
;; obtenu est publie lui aussi (`PHYSREGBD`), decompose sur les trois axes du sujet : c'est la
;; MESURE qui nomme le geste, jamais l'etiquette. Regle du cycle 68 : un geste se nomme par la
;; composante qui MANQUE, pas par celle qui domine.
(defconstant PHYSROOM-PH-REGB 39)
(defconstant PHYSROOM-REGBE 90)     ;; meme rampe d'entree que PHYSROOM-REGAE, meme raison
(defconstant PHYSROOM-REGB0 0)      ;; premiere fenetre rejouee : le TEMOIN r=0, qui donne son
                                    ;; plancher a la passe — sans lui aucun chiffre n'a d'echelle
(defconstant PHYSROOM-REGBN 9)      ;; ... jusqu'a r=8 : les six sauts et les deux de course
(define *physroom-reg-trmode* 0)
(defconstant PHYSROOM-PH-REPORT 40)
(defconstant PHYSROOM-PH-DONE 41)

(deftype phys-subject (process-drawable)
  ((phase   int32)
   (pframe  int32)
   (ai      int32)     ;; index dans *physroom-anim-*
   (drive   int32)
   (nanim   int32)     ;; animations RETENUES (jouables sur ce rig)
   (nenum   int32)     ;; animations ENUMEREES dans les six art-groups de Keira
   (slot    int32)     ;; slot de simulation du compagnon
   (nchain  int32)
   (hdpid   int32)
   (nag     int32)     ;; art-groups de Keira effectivement charges
   (fnum    float)     ;; frame courante de l'animation
   (nframe  float)     ;; nombre de frames de l'animation courante
   (adir    float)     ;; sens de lecture (+1 aller, -1 retour) — jamais de saut de frame-num
   (aspeed  float)     ;; vitesse de lecture de l'animation courante, celle du jeu
   (regstep float)     ;; PH-REGT : le pas d'avance qui fait tomber la pose sur la frame retenue
   (wraps   int32)     ;; demi-tours de lecture, publies : personne n'a a deviner combien
   (viol    int32)     ;; frames de mesure ou un target existait (doit rester 0)
   (nactor  int32)     ;; pire nombre d'acteurs etrangers vus dans la zone
   (killed  int32)     ;; acteurs etrangers deactives
   (dis     float)     ;; controle positif : penetration max, defaut DESARME
   (arm     float)     ;; controle positif : penetration max, defaut ARME
   (armx    float)     ;; [NOTE-459] l'ANCIEN maximum independant, conserve a cote de la paire
   (disx    float)     ;; [NOTE-459] idem, branche desarmee
   (condis  float)     ;; predicat conique CORRIGE   : penetration max residuelle
   (conarm  float)     ;; predicat conique D'AVANT   : la meme, elle doit MONTER
   (proxdis float)     ;; spheres proximales EN PLACE : penetration max residuelle
   (proxarm float)     ;; spheres proximales RETIREES : la meme, elle NE DOIT PAS se degrader
   (injn    int32)     ;; poussees reellement injectees
   (lvl     int32)     ;; niveau d'excitation courant de la courbe de reponse
   (ori     int32)     ;; index dans la table d'orientations de SPEC 10-13
   (nchan   int32)     ;; canaux d'animation du PORTEUR (= (-> draw mgeo num-joints))
   (nperm   int32)     ;; positions de canal deplacees par la permutation de l'animation courante
   (reg     int32)     ;; index dans la table des regimes de SPEC 14-20
   (rety    float)     ;; etat de fin de la fenetre precedente, pour le retour DOUX vers `home` :
   (retz    float)     ;;   sans lui, revenir a `home` d'un coup serait une impulsion artificielle
   (retang  float)     ;;   que sa §37 devrait absorber — un stimulus qu'on n'a pas commande
   (retax   int32)
   (rax     float)     ;; PH-REGA : l'axe de rotation MESURE sur le sujet, tenu pour la fenetre
   (ray     float)
   (raz     float)
   (tus     float)     ;; PH-REGB : le SIGNE qui oriente la verticale de l'ancre vers le HAUT,
   (tfs     float)     ;;   et celui qui oriente sa ligne 2 vers l'AVANT. Les deux sont MESURES et
                       ;;   latches a l'entree de la phase, jamais ecrits en dur.
   (sgi     int32)     ;; index de fenetre du balayage PAR SENS (SPEC 21/33/34, cycle 52)
   (symi    int32)     ;; index de cellule du balayage A DEUX POSES (SPEC 12/18, cycle 56)
   (cex     float)     ;; offset MESURE de l'ancre a la racine de l'acteur, releve a l'execution :
   (cey     float)     ;;   la course C49E1 a mesure que la rotation de `root quat` ne pivote PAS
   (cez     float)     ;;   autour de `root trans`, et de combien. Voir `physroom-reg-pose`.
   (vel     vector :inline)
   (home    vector :inline))
  (:states phys-subject-run))

(define *physroom-anim-ag* (new 'static 'array art-group PHYSROOM-MAXANIM))
(define *physroom-anim-ix* (new 'global 'array 'int32 PHYSROOM-MAXANIM))
;; L'ANIMATION QUI TIENT UNE POSE BILATERALEMENT SYMETRIQUE, RETROUVEE PAR SON NOM (cycle 55).
;; Le cycle 54 a mesure les 31 poses de Keira au meme point de protocole : `assistant-village2-
;; idle-hut-breath` est la seule qui soit a moins de 10 deg du miroir parfait sur LES DEUX
;; maillons (4.0 / 5.4 deg), quand celle que la salle laissait en place est a 124.1 deg, rang 29
;; sur 31. PAR SON NOM et jamais par un index : une enumeration peut changer d'ordre, un nom non.
;; -1 = introuvable, et la phase le DIT au lieu d'epingler une pose au hasard.
(define *physroom-symai* -1)
(defconstant PHYSROOM-SYMNAME "assistant-village2-idle-hut-breath")
;; LA POSE ASYMETRIQUE, EPINGLEE ELLE AUSSI ET PAR SON NOM (cycle 56).
;;
;; POURQUOI UNE DEUXIEME EPINGLE, ET POURQUOI CE N'EST PAS UN LUXE. Le cycle 55 a compare une
;; pose epinglee symetrique a une pose HERITEE, mesuree dans une AUTRE course. Comparer deux
;; courses laisse toujours ouverte la question « qu'est-ce qui a bouge d'autre ». `PH-SYM` joue
;; donc les DEUX poses DANS LA MEME COURSE, sur le MEME stimulus, a la MEME place : la seule
;; variable qui reste entre les deux jambes est le nom de l'animation epinglee.
;;
;; CE QUE CETTE POSE EST, ET CE QU'ELLE N'EST PAS. `assistant-firecanyon-idle-down` est
;; l'animation que le cycle 53 a identifiee comme celle que la salle laisse en place. Au point de
;; protocole (PHYSROOM-MEASAT avances) le cycle 54 l'a mesuree a 124.1 deg du miroir parfait,
;; rang 29 sur 31. CE N'EST PAS la meme frame que celle que la salle fige ensuite, que le cycle 53
;; a mesuree a 43.4 deg : le cycle 54 a etabli que l'asymetrie est une propriete de la FRAME et
;; pas de l'animation. La jambe asymetrique de PH-SYM n'est donc PAS une reproduction de la pose
;; dans laquelle §18 et §12 ont ete publiees — c'est une pose asymetrique CONTROLEE, epinglee par
;; le meme protocole que la symetrique. Ses chiffres ne se comparent pas aux chiffres publies de
;; §18 ; ils se comparent a l'autre jambe, et c'est tout ce que la question demande.
(define *physroom-asymai* -1)
(defconstant PHYSROOM-ASYMNAME "assistant-firecanyon-idle-down")
(define *physroom-proc*    (the-as (pointer phys-subject) #f))

;; ------------------------------------------------------------------------------------------------
;; LE NUMERO DE PHASE LE PLUS HAUT REELLEMENT VISITE PAR LA COURSE (cycle 67).
;;
;; POURQUOI CE GLOBAL EXISTE, ET C'EST UN DEFAUT MESURE, PAS UNE PRECAUTION. `PHYSROOM-PHASEGUARD`
;; publiait `maxwork=33` — PH-SYM — alors que la derniere phase de TRAVAIL est PH-REGS (36) depuis
;; le cycle 66, et que PH-SKINARM (34) et PH-SKINDIS (35) sont arrivees au cycle 61. Le garde-fou
;; ne surveillait donc AUCUNE des trois dernieres phases ajoutees. Son propre commentaire raconte
;; deja TROIS rattrapages du meme genre (PROXON quand c'etait PH-REG, PH-REG quand c'etait PH-SGN,
;; PH-SGN quand c'etait PH-SYM) : c'est la QUATRIEME occurrence, et elle prouve que la conjonction
;; tenue a la main ne peut pas tenir. Une liste qu'il faut penser a rallonger n'est pas un
;; garde-fou, c'est une note.
;;
;; LE CORRECTIF SE POSE AU PRODUCTEUR : au lieu de NOMMER les phases, on MESURE celle qu'on a
;; visitee. `physroom-tick` retient le maximum a chaque frame ; le rapport le publie. Une phase de
;; travail ajoutee demain au-dessus de PHYSROOM-PH-REPORT se verra toute seule, sans que personne
;; ait eu a se souvenir de rallonger une conjonction. La conjonction nommee reste publiee a cote —
;; on n'en retire jamais une, on en ajoute — mais ce n'est plus elle qui porte le verdict.
;; NATURE : un ENTIER, le numero de phase. REPERE : aucun, c'est un identifiant.
;; LECTURE QUAND LE DEFAUT EST ABSENT : la derniere phase de TRAVAIL, donc < PHYSROOM-PH-REPORT.
(define *physroom-maxvisited* 0)

;; 0 = les axes du MONDE, pris litteralement — LE COMPORTEMENT LIVRE, et la trace de PH-REG,
;; PH-REGS et PH-REGT doit rester identique au bit tant qu'il vaut 0.
;; 1 = les axes MESURES sur le sujet. Arme UNIQUEMENT par PH-REGA. Voir le pave de
;; `physroom-reg-pose-axis` pour ce que ce drapeau controle et pourquoi il existe.
(define *physroom-reg-axmode* 0)

;; LE SENS DE LA ROTATION DE PH-REGA : +1.0 ou -1.0. Il existe parce que le SIGNE d'un axe mesure
;; est arbitraire — l'axe « vertical » que le solveur rend pointe vers le BAS, et l'axe
;; avant/arriere vers l'ARRIERE (mesure : la direction os chest->lBoob a une composante AVANT de
;; +0,154 sur le mesh livre, et le solveur la lit a -0,130 sur LES DEUX chaines). Plutot que
;; d'epingler un signe dans le source et d'esperer, PH-REGA joue CHAQUE fenetre dans LES DEUX sens
;; et publie, pour chacun, le deplacement REEL de l'ancre : c'est la mesure qui nomme le geste, pas
;; moi. Et la paire ainsi obtenue est en meme temps le controle a STIMULUS MIROIR que §12 et §20
;; reclament (« the gravity-side and opposite-side breasts must not be mechanically mirrored »).
(define *physroom-reg-sgn* 1.0)

;; ------------------------------------------------------------------------------------------------
;; LE BALAYAGE DE POSE, RESOLU A LA FRAME — ET POURQUOI CELUI DU CYCLE 54 NE POUVAIT PAS SUFFIRE.
;;
;; CE QUI EXISTE, ET SON TROU. Le cycle 54 a mesure « les 31 poses de Keira au meme point de
;; protocole » et en a tire `PHYSROOM-SYMNAME`. Mais `PHYSPOSEB` n'emet QU'UNE ligne par ANIMATION,
;; a `pframe = PHYSROOM-MEASAT` — donc a UNE frame par animation, choisie par personne : celle ou
;; 54 avances a la vitesse propre de l'animation tombent (6.75 sur a=12, qui en compte 16).
;; Le cycle 56 a pourtant ETABLI, et c'est ecrit a la ligne 609 de ce fichier, que « l'asymetrie est
;; une propriete de la FRAME et pas de l'animation ». Le balayage echantillonnait donc 31 points
;; d'une population de 264 (la somme des longueurs des 31 animations), soit 11.7 %, et il les
;; prenait sur l'axe qui ne porte PAS la variable.
;;
;; ET IL N'AVAIT AUCUN LECTEUR. `PHYSPOSEB` est produit a chaque course depuis le cycle 54 et
;; `grep -rl PHYSPOSEB` ne rend que ce fichier : le tableau ne le lit pas, aucun script ne le lit.
;; Le rang « 1 sur 31 » de la pose epinglee est donc une affirmation de COMMENTAIRE qui n'a plus
;; ete verifiee depuis treize cycles — et la regle 0 dit qu'un commentaire n'est pas une preuve.
;;
;; CE QUE FAIT LE CYCLE 67, ET SON COUT EN FRAMES EST NUL. La sous-fenetre de LIGNE DE BASE de
;; `PHYSROOM-PH-MEAS` (`drive >= PHYSROOM-DRIVES`) tient deja le sujet IMMOBILE pendant
;; `PHYSROOM-WIN` frames pendant que l'animation avance a sa vitesse propre : c'est la condition la
;; plus propre de toute la course pour lire une pose, et elle balaie deja tout l'aller-retour de
;; chaque animation. On y echantillonne, sans ajouter une seule frame de course.
;;
;; NATURE du score : le COSINUS de l'ecart au miroir, pris sur le PIRE maillon. 1.0 = miroir
;;   parfait. Sans dimension. REPERE : monde, direction d'os reflechie dans le plan de normale
;;   `lat` (l'axe lateral du solveur) — la MEME algebre que `ROOM-REGPOSE`, pour que les deux
;;   nombres soient comparables. LECTURE QUAND LE DEFAUT EST ABSENT : 1.0 ; le cycle 53 a mesure le
;;   rig a 0.005 deg du miroir en pose de bind, soit un cosinus de 0.9999999.
;;   -2.0 = NON CALCULABLE (triedre non classe, ou une des deux chaines absente) : une valeur
;;   impossible pour un cosinus, donc impossible a confondre avec une mesure.
(defconstant PHYSROOM-POSESTEP 4)   ;; une lecture toutes les 4 frames de salle. A la vitesse propre
                                    ;; des animations de Keira (0.125 a 0.167) ca fait 2 lectures
                                    ;; par frame d'animation : le balayage ne saute aucune pose.
(define *physroom-best-s* -2.0)     ;; le meilleur score rencontre, et -2.0 est « rien encore »
(define *physroom-best-a* -1)
(define *physroom-best-f* 0.0)
(define *physroom-scan-n* 0)

(defun physroom-mirror-score ((hd jak-hd) (slot int))
  "LE SCORE DE MIROIR DE LA POSE COURANTE. Voir la note de PHYSROOM-POSESTEP pour sa nature.
   On rend le PIRE maillon et pas la moyenne : une pose n'est symetrique que si elle l'est sur
   TOUTE la chaine — un maillon proximal miroir et un maillon distal de travers est exactement la
   situation qu'on cherche a exclure. LECTURE PURE : aucune de ces fonctions n'ecrit."
  (let ((worst 2.0)
        (nok 0))
    (let ((lx (phys-axis-world slot 0 2 0))
          (ly (phys-axis-world slot 0 2 1))
          (lz (phys-axis-world slot 0 2 2)))
      ;; le triedre doit etre CLASSE : sinon `phys-axis-world` rend trois zeros et le plan de
      ;; reflexion n'existe pas. On le teste au lieu de le supposer.
      (when (> (+ (* lx lx) (+ (* ly ly) (* lz lz))) 0.5)
        (let ((n (min (phys-chain-links slot 0) (phys-chain-links slot 1))))
          (dotimes (l n)
            (let* ((ux (phys-chain-bone hd slot 0 l 0))
                   (uy (phys-chain-bone hd slot 0 l 1))
                   (uz (phys-chain-bone hd slot 0 l 2))
                   (vx (phys-chain-bone hd slot 1 l 0))
                   (vy (phys-chain-bone hd slot 1 l 1))
                   (vz (phys-chain-bone hd slot 1 l 2))
                   (dd (+ (* ux lx) (+ (* uy ly) (* uz lz))))
                   (mx (- ux (* 2.0 (* dd lx))))
                   (my (- uy (* 2.0 (* dd ly))))
                   (mz (- uz (* 2.0 (* dd lz))))
                   (sc (+ (* mx vx) (+ (* my vy) (* mz vz)))))
              ;; une direction nulle (maillon degenere) rendrait 0.0 et passerait pour un mauvais
              ;; miroir alors qu'elle n'est pas une mesure : on l'ecarte.
              (when (> (+ (* ux ux) (+ (* uy uy) (* uz uz))) 0.5)
                (+! nok 1)
                (when (< sc worst) (set! worst sc))))))))
    (if (> nok 0) worst -2.0)))

;; ------------------------------------------------------------------------------------------------
;; LE REMAPPAGE PAR NOM — les tables. Voir le pave devant `physroom-build-perm!` pour le defaut
;; qu'elles corrigent.
;;
;; Capacite : le rig du village 1 porte 96 joints, donc 94 canaux d'animation (canal t -> joint
;; d'indice t+2 du art-joint-geo -> node-list t+3, cf. make-nodes-from-jg process-drawable.gc:151-161
;; et la boucle de lecture process-drawable.gc:265-271). 96 laisse la marge des deux entrees que le
;; decompresseur touche au-dela (joint.gc:216 « TODO - not sure if this is too many »).
;; ------------------------------------------------------------------------------------------------
(defconstant PHYSROOM-MAXCH 96)

;; permutation COURANTE : position de canal du PORTEUR -> position de canal de l'ANIMATION.
;; -1 = aucune source (le nom du joint porteur n'existe pas dans le rig de l'animation).
(define *physroom-perm*   (new 'global 'array 'int32 PHYSROOM-MAXCH))

;; INSTANTANE des canaux tels que l'animation vient de les ecrire, lu par la permutation.
;; ALLOUE UNE SEULE FOIS, au chargement du fichier, et JAMAIS sur la pile GOAL.
;; DEVIATION ASSUMEE ET CHIFFREE par rapport au « tas du processus » demande : le sujet nait de
;; *pc-dead-pool* (pckernel.gc:666), soit 16384 octets de tas TOTAL par processus, et
;; `initialize-skeleton` y a deja pose le cspace-array (97 x 32 = 3104 o) et le skeleton
;; (97 x 96 = 9312 o) du rig a 96 joints, plus draw-control / joint-control / trsqv : ~12,9 Ko sur
;; 16 Ko. 4608 octets de plus ne rentrent pas. Le tas global les porte, avec la meme garantie
;; (une allocation, au chargement, jamais par frame).
(define *physroom-tqbuf*  (new 'global 'inline-array 'transformq PHYSROOM-MAXCH))

;; POSE DE REPOS DU PORTEUR, canal par canal, derivee de la bind-pose de SON rig — c'est ce que
;; recoivent les canaux sans source (point 3). Calculee UNE SEULE FOIS a la naissance du sujet.
(define *physroom-tqrest* (new 'global 'inline-array 'transformq PHYSROOM-MAXCH))
;; combien de canaux de cette table ont ete VRAIMENT derives de la bind-pose (les autres sont
;; retombes sur la transformation identite) — publie, jamais suppose.
(define *physroom-restok* 0)

;; --- balayage de la zone (deux phases : on collecte, PUIS on tue — jamais muter l'arbre pendant
;; --- qu'on le parcourt, meme piege que hd-scan-visit).
(define *physroom-self*    (the-as process #f))
(define *physroom-hd*      (the-as process #f))
(define *physroom-nactor*  0)
(define *physroom-ntarget* 0)
(define *physroom-kill*    (new 'static 'array process-drawable 32))
(define *physroom-nkill*   0)

(defun physroom-visit ((proc process))
  (when (= (-> proc type) target) (+! *physroom-ntarget* 1))
  (when (and (type-type? (-> proc type) process-drawable)
             (!= proc *physroom-self*)
             (!= proc *physroom-hd*))
    (+! *physroom-nactor* 1)
    (when (< *physroom-nkill* 32)
      (set! (-> *physroom-kill* *physroom-nkill*) (the-as process-drawable proc))
      (+! *physroom-nkill* 1)))
  #t)

;; ------------------------------------------------------------------------------------------------
;; VIDER LA ZONE, et le prouver. Retourne le nombre d'acteurs ETRANGERS trouves cette frame (0 =
;; la zone ne contient plus que le sujet et sa peau HD). Les target trouves sont tues sur place et
;; comptes : la salle ne peut pas se contenter de les endormir (SPEC : « ni endormi, ni hors
;; champ : absent »).
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-sweep phys-subject ((kill? symbol))
  (set! *physroom-self* (the-as process self))
  (set! *physroom-hd* (if (-> self child) (the-as process (-> self child 0)) (the-as process #f)))
  (set! *physroom-nactor* 0)
  (set! *physroom-ntarget* 0)
  (set! *physroom-nkill* 0)
  (iterate-process-tree *active-pool* physroom-visit *null-kernel-context*)
  (when (> *physroom-ntarget* 0)
    ;; un target est reapparu (cycle d'attract) : on le tue immediatement et on le compte. Cette
    ;; frame de mesure est contaminee, et le compteur le dira.
    (kill-by-name 'target *active-pool*)
    (set! *target* #f))
  (when kill?
    (dotimes (i *physroom-nkill*)
      (deactivate (-> *physroom-kill* i))
      (+! (-> self killed) 1)))
  *physroom-nactor*)

;; ------------------------------------------------------------------------------------------------
;; LE PILOTAGE. Tout passe par une acceleration imposee puis integree : c'est la seule chose que la
;; chaine ressent (la pseudo-force de repere accelere de jak-hd-physics.gc).
;;
;; POURQUOI LES MAGNITUDES ONT CHANGE LE 2026-08-11 (et c'est la cause racine de l'echec DISCRIMINANT,
;; pas un reglage) : les quatre pilotages de translation tapaient tous entre 10 et 300 u/frame^2,
;; c'est-a-dire tous DERRIERE le coude de saturation des chaines. La courbe de reponse mesuree par
;; la salle elle-meme (PHYSRESP, six niveaux d'excitation) le dit sans ambiguite — gain amp/exc :
;;
;;     exc      1.5    3.5    8.0   18.0   42.0   96.0
;;     lBoob   25.2   21.0   19.3   19.6   15.8    7.5
;;     LtoeStrap 29.7 28.7   28.3   26.8   12.4    5.5
;;
;; le gain est CONSTANT jusqu'a 18, puis s'effondre d'un facteur 3 a 5. Au-dela du coude la chaine
;; est collee a son plafond geometrique et rend la meme amplitude quoi qu'on lui fasse : 16 chaines
;; sur 22 rendaient donc le meme chiffre sous une secousse, une translation et une inclinaison
;; (backhair : 3 % d'ecart). Ce n'etait pas la physique qui etait plate, c'etait le stimulus qui
;; etait partout le meme — sature. « Diverses accelerations » veut dire un EVENTAIL, et updown et
;; leftright, qui portaient les magnitudes IDENTIQUES sur deux axes, n'etaient pas deux stimuli
;; differents : c'etait le meme, tourne.
;;
;;   0 updown     vertical, 18 u/frame^2 — DANS LA BANDE LINEAIRE, la reponse y est proportionnelle
;;   1 leftright  horizontal, 52 u/frame^2 — la secousse franche
;;   2 accel      trajectoire plane, magnitude qui balaie 2 -> 96, donc qui TRAVERSE le coude
;;   3 jerk       vitesse POSEE d'un coup et arrets brutaux — « a-coups »
;;   4 tilt       elle SE PENCHE ET TIENT LA POSE : le seul pilotage qui n'est pas une secousse
;;   5 (aucun)    la ligne de base, traitee par l'appelant (physroom-hold)
;; Les unites sont des unites de jeu par frame^2 (4096 u = 1 m, 60 Hz).
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-drive phys-subject ((mode int) (f int))
  (let ((ax 0.0) (ay 0.0) (az 0.0)
        (seg (/ f 15)))
    (cond
      ;; --- LES TROIS PILOTAGES CONTINUS SONT IMPOSES EN POSITION, PAS EN ACCELERATION ----------
      ;; Mesure du 2026-08-11 : `updown` commandait 18 u/frame^2 et la chaine en recevait 173.
      ;; L'ecart venait du garde-fou : la vitesse etait INTEGREE, la position derivait jusqu'aux
      ;; +/- 3 m, et la butee remettait la vitesse a zero D'UN COUP — un a-coup de plusieurs
      ;; centaines d'unites au milieu de la fenetre de mesure. Les trois pilotages « doux » etaient
      ;; donc, en pratique, le meme choc que `jerk`, et c'est une deuxieme facon dont la salle
      ;; rendait cinq colonnes identiques.
      ;; Une trajectoire sinusoidale POSEE a une acceleration exactement connue (A w^2) et ne
      ;; s'approche jamais du garde-fou : le stimulus publie par PHYSSTIM est alors celui que la
      ;; chaine recoit vraiment, et le gain de ROOM-RESPONSE a enfin un denominateur honnete.
      ;; Periode 36 frames (w = 0.1745 rad/frame, w^2 = 0.03046) : exactement un cycle complet
      ;; dans les 36 frames effectivement mesurees.
      ((< mode 3)
       (let* ((mag (cond
                     ((zero? mode) 18.0)
                     ((= mode 1)   52.0)
                     ;; « diverses accelerations » : la meme trajectoire subie de 2 a 96
                     ;; u/frame^2, donc de part et d'autre du coude de saturation (18 a 42).
                     (else (+ 2.0 (* 94.0 (/ (the float f) (the float PHYSROOM-WIN)))))))
              (amp (/ mag PHYSROOM-W2))
              (ph  (* 65536.0 (/ (the float f) (the float PHYSROOM-PERIOD))))
              (s   (sin ph)))
         (vector-copy! (-> self root trans) (-> self home))
         (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
         (cond
           ((zero? mode) (set! (-> self root trans y) (+ (-> self home y) (* amp s))))
           ((= mode 1)   (set! (-> self root trans x) (+ (-> self home x) (* amp s))))
           (else
            (set! (-> self root trans x) (+ (-> self home x) (* amp s)))
            (set! (-> self root trans z) (+ (-> self home z) (* 0.5 amp (cos ph))))))))
      ((= mode 3)
       ;; a-coups : toutes les 10 frames la vitesse est ECRASEE, pas accumulee. Un segment sur
       ;; trois est un arret net (vitesse exactement nulle) : c'est le pire cas pour une chaine.
       (when (zero? (mod f 10))
         (let ((s (mod (/ f 10) 6)))
           (case s
             ((0) (set-vector! (-> self vel) 0.0 0.0 0.0 1.0))
             ((1) (set-vector! (-> self vel) 210.0 0.0 0.0 1.0))
             ((2) (set-vector! (-> self vel) 0.0 -260.0 0.0 1.0))
             ((3) (set-vector! (-> self vel) 0.0 0.0 0.0 1.0))
             ((4) (set-vector! (-> self vel) -240.0 0.0 190.0 1.0))
             (else (set-vector! (-> self vel) 0.0 300.0 0.0 1.0))))))
      (else
       ;; TILT : ELLE SE PENCHE EN AVANT ET ELLE TIENT LA POSE.
       ;;
       ;; Ce que ce mode faisait AVANT, et pourquoi il ne pouvait rien mesurer : il balayait
       ;; +/- 60 degres en sinus sur 45 frames, tangage puis roulis. A hauteur de tete (~7000 u de
       ;; l'axe) ca fait 1.047 rad x (2 pi / 45)^2 x 7000 = 143 u/frame^2 — la PLUS VIOLENTE des
       ;; cinq secousses, alors qu'elle porte le nom de l'inclinaison. Le pilotage cense mesurer la
       ;; gravite mesurait donc la meme chose que les quatre autres, et rendait le meme chiffre :
       ;; c'est exactement le « chestL tilt 0.3889 contre accel 0.3490 » que le superviseur a
       ;; reproche a ce tableau.
       ;;
       ;; Maintenant : rampe en demi-cosinus jusqu'a 60 degres sur PHYSROOM-TILTRAMP frames, puis
       ;; POSE TENUE. Pendant la tenue l'acceleration de translation est nulle et l'orientation ne
       ;; change plus : la seule chose qui agisse encore sur la chaine est la gravite exprimee dans
       ;; le repere de l'ancre. C'est le stimulus que l'owner decrit — « quand elle se penche en
       ;; avant pour souder » — et c'est le seul des cinq qui ne soit pas une agitation.
       (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
       (vector-copy! (-> self root trans) (-> self home))
       (let* ((u (if (< f PHYSROOM-TILTRAMP)
                   (/ (the float f) (the float PHYSROOM-TILTRAMP))
                   1.0))
              (a (* PHYSROOM-TILTDEG 0.5 (- 1.0 (cos (* 32768.0 u))))))
         (quaternion-axis-angle! (-> self root quat) 1.0 0.0 0.0 (degrees a)))))
    ;; `ax/ay/az` ne servent plus qu'a `jerk`, qui pose sa vitesse lui-meme : les trois pilotages
    ;; continus imposent desormais leur POSITION et n'integrent rien.
    (when (and (= mode 3) (or (!= ax 0.0) (!= ay 0.0) (!= az 0.0)))
      (set! (-> self vel x) (+ (-> self vel x) ax))
      (set! (-> self vel y) (+ (-> self vel y) ay))
      (set! (-> self vel z) (+ (-> self vel z) az))))
  ;; INTEGRATION + GARDE-FOU, ET SEULEMENT POUR `jerk`. La butee des +/- 3 m remet la vitesse a zero
  ;; d'un coup : c'est un a-coup de plus, ce qui est exactement le propos de `jerk` et exactement le
  ;; contraire du propos des trois autres. C'est pour ca qu'ils n'integrent plus.
  (when (= mode 3)
    (set! (-> self root trans x) (+ (-> self root trans x) (-> self vel x)))
    (set! (-> self root trans y) (+ (-> self root trans y) (-> self vel y)))
    (set! (-> self root trans z) (+ (-> self root trans z) (-> self vel z)))
    (when (> (fabs (- (-> self root trans x) (-> self home x))) PHYSROOM-LIMIT)
      (set! (-> self root trans x) (+ (-> self home x) (* PHYSROOM-LIMIT (if (> (-> self vel x) 0.0) 1.0 -1.0))))
      (set! (-> self vel x) 0.0))
    (when (> (fabs (- (-> self root trans y) (-> self home y))) PHYSROOM-LIMIT)
      (set! (-> self root trans y) (+ (-> self home y) (* PHYSROOM-LIMIT (if (> (-> self vel y) 0.0) 1.0 -1.0))))
      (set! (-> self vel y) 0.0))
    (when (> (fabs (- (-> self root trans z) (-> self home z))) PHYSROOM-LIMIT)
      (set! (-> self root trans z) (+ (-> self home z) (* PHYSROOM-LIMIT (if (> (-> self vel z) 0.0) 1.0 -1.0))))
      (set! (-> self vel z) 0.0)))
  ;; les quatre pilotages de translation laissent le sujet DROIT : sans ca l'inclinaison de la
  ;; fenetre precedente resterait en place et contaminerait la suivante.
  (when (< mode 4) (quaternion-identity! (-> self root quat)))
  (none))

(defbehavior physroom-hold phys-subject ()
  "immobile, pile sur le point de depart ET DROITE : c'est l'etat de repos de SPEC section 4."
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-identity! (-> self root quat))
  (none))

;; ------------------------------------------------------------------------------------------------
;; SPEC 10-13 — L'ORIENTATION, SUR DEUX AXES ET SUR TOUTE LA PLAGE.
;; Sa §13 : « supine, prone, upright and lateral states SHALL NOT exist as unrelated hard-coded
;; morph targets ; the equilibrium state shall vary CONTINUOUSLY with the local gravity direction ».
;; Une salle qui ne penche qu'a 60 degres vers l'avant ne peut ni verifier §10 (sur le dos), ni §12
;; (sur le cote), ni la CONTINUITE entre les deux — c'est le trou d'instrument que ce cycle ferme.
;; `axis` 0 ET 1 : CE COMMENTAIRE NE NOMME PLUS RIEN, ET VOICI POURQUOI IL A ETE RETIRE.
;; Il disait « 0 = tangage (avant/arriere, atteint prone et supine), 1 = roulis (lateral) ».
;; LES DEUX ETAIENT FAUX, et le cycle 67 en a conclu que §13 etait INJOUABLE faute d'un
;; operateur inclinant le sujet autour de son axe LATERAL. Cet operateur est `axis 1`, et il
;; tourne dans toutes les courses depuis que ce balayage existe. La trace le dit :
;;   axis 0 -> rotation autour du MONDE X, a 6.6 deg de l'axe avant/arriere du sujet : c'est un
;;             ROULIS. `PHYSORI4 r0` (gravite projetee sur le lateral sortant de l'ancre) y monte
;;             a +0.9797 (i=2) et -0.9797 (i=4) : gravite LATERALE, le geste de sa §12.
;;   axis 1 -> rotation autour du MONDE Z, a 11.5 deg de l'axe LATERAL du sujet : c'est un
;;             TANGAGE. `PHYSORI4 r2` y monte a -0.9933 (i=6) et +0.9933 (i=8), et -0.7702 a
;;             i=5 : penche AVANT de 45 deg, le geste que sa §13 chiffre.
;; LE ROLE D'UNE CELLULE NE SE LIT PLUS ICI. Il se derive de `PHYSORI4` — la gravite mesuree par
;; cellule dans la base de l'ancre — par le chemin unique `orole()` de `physics_room_table.py`.
;; Deux cycles avaient deja constate que l'etiquette de `axis 0` etait fausse et l'avaient note
;; A DEUX SITES D'APPEL (voir plus bas, PH-SYM) au lieu de la retirer d'ici : une note par site
;; est un verrou deguise, elle n'a jamais atteint `axis 1`, et §13 l'a paye.
(defbehavior physroom-orient phys-subject ((axis int) (deg float))
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (if (zero? axis)
    (quaternion-axis-angle! (-> self root quat) 1.0 0.0 0.0 (degrees deg))
    (quaternion-axis-angle! (-> self root quat) 0.0 0.0 1.0 (degrees deg)))
  (none))

;; LA TABLE DES ORIENTATIONS BALAYEES. Les quatre POLES de sa spec y sont (±90 sur chaque axe), et
;; les intermediaires a 45 sont la pour §13 : entre deux poles la forme doit varier CONTINUMENT,
;; ce qui ne se lit que si on echantillonne entre les poles. 0 degre est inclus comme ligne de
;; base : cette orientation-la doit rendre 1.000 / 1.000 / 1.000, sinon tout le reste est decale.
(defconstant PHYSROOM-ORIN 9)
(define *physroom-ori-ax* (new 'static 'array int32 9 0 0 0 0 0 1 1 1 1))
(define *physroom-ori-dg* (new 'static 'array float 9
                               0.0 45.0 90.0 -45.0 -90.0 45.0 90.0 -45.0 -90.0))

(defbehavior physroom-lean phys-subject ((deg float))
  "immobile mais INCLINEE de `deg` degres SUR LE COTE — le nom `lean` et la phrase « vers l'avant »
   qui tenaient ici etaient faux : la rotation est autour du MONDE X, a 6.6 deg de l'axe
   avant/arriere du sujet, donc un ROULIS. Mesure : l'ecart au miroir passe de 0.237 deg (pose
   `idle`) a 143.213 deg (pose `tilt`), ce qu'une rotation autour du lateral ne peut pas faire
   (elle commute avec la reflexion). Le penche AVANT que reclame la 6e passe de l'owner est joue
   par `physroom-orient axis=1`, cellules i=5 et i=6 du balayage. L'excitation d'acceleration retombe a zero,
   donc ce qui reste dans l'ecart a la pose du modele n'est plus que la gravite. C'est la mesure
   que reclame la 6e passe de l'owner : « aucun mouvement quand elle se penche en avant pour
   souder, pas coherent du tout »."
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-axis-angle! (-> self root quat) 1.0 0.0 0.0 (degrees deg))
  (none))

;; EXCITATION CALIBREE : une acceleration d'amplitude CONNUE, alternee, sur un seul axe. C'est
;; l'entree de la courbe de reponse — l'amplitude de pointe en sortie se lit dans la meme fenetre.
(defbehavior physroom-drive-exc phys-subject ((f int) (mag float))
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-identity! (-> self root quat))
  ;; deplacement sinusoidal pur : |acceleration| = mag, sans discontinuite qui melangerait la
  ;; reponse au seuil qu'on cherche.
  (let* ((w  (/ 65536.0 24.0))
         (ph (* w (the float f)))
         (amp (/ mag (* (/ 6.2831853 24.0) (/ 6.2831853 24.0)))))
    (set! (-> self root trans x) (+ (-> self home x) (* amp (sin ph))))
    (set! (-> self root trans y) (+ (-> self home y) (* 0.4 amp (sin (* 2.0 ph))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; SPEC 24/25/26/27 — UNE IMPULSION ISOLEE, SUR UN SEUL AXE, PUIS ON LACHE.
;;
;; POURQUOI CETTE PHASE EXISTE, ET C'EST UNE MESURE QUI LA MOTIVE, PAS UNE IDEE.
;; La fenetre de repos (`PHYSROOM-PH-IDLE`) suit CINQ pilotages et une courbe de reponse : ce qui y
;; sonne est un MELANGE de modes, pas un mode propre. La table de la course precedente le dit
;; elle-meme : `ROOM-RINGFIT-SEP: chain=chestL v/ap confondus`, et les deux projections rendent
;; 2.420 et 2.435 Hz — 0.6 % d'ecart la ou la raideur livree (`slat=1.2195`, `sap=1.1111`) impose
;; 5.4 %. Une serie projetee sur trois axes ne rend trois frequences que si les trois modes ont ete
;; excites SEPAREMENT ; sinon les trois projections rendent le meme mode dominant.
;; Et l'axe lateral n'y est pratiquement pas excite : residu ABSOLU identique aux trois axes
;; (1.0e-4 a 1.9e-4) pour une valeur efficace 8 a 13 fois plus petite — le residu relatif de 0.095
;; et 0.194 mesure donc l'ABSENCE D'EXCITATION, pas un mauvais ajustement.
;;
;; C'est le protocole que sa §27 ecrit mot pour mot — « After ONE STRONG ISOLATED IMPULSE » — et
;; que la salle n'a jamais execute.
;;
;; LA FORME DE L'IMPULSION. Demi-cosinus sur `PHYSROOM-IMPF` frames : deplacement 0 -> A, vitesse
;; NULLE aux deux bouts, acceleration maximale au milieu. Aucune discontinuite de position ni de
;; vitesse — donc rien qui puisse declencher le rebasement de discontinuite de sa §37 (« artificial
;; transforms must not generate physical breast impulses ») et faire avaler l'impulsion.
;; Apres `PHYSROOM-IMPF` le sujet est TENU immobile a `home + A` : le mode sonne librement autour
;; d'un equilibre identique a celui de `home`, puisque l'orientation n'a pas bouge.
;;
;; L'AMPLITUDE EST CHOISIE DANS LA BANDE LINEAIRE, ET C'EST UN CHOIX METHODOLOGIQUE.
;; `a_max = A/2 * (pi/T)^2` = 365 * 0.5 * (3.1416/10)^2 = 18.0 u/frame^2 — exactement le niveau que
;; la salle documente comme « DANS LA BANDE LINEAIRE, la reponse y est proportionnelle » (voir la
;; table des pilotages). Une frequence propre et un rapport d'amortissement sont des proprietes du
;; systeme LINEARISE : les mesurer sous saturation `tanh` (§21) rendrait la signature du limiteur,
;; pas celle du ressort. Ce que ces fenetres ne mesurent donc PAS, et il faut le dire : le regime
;; fort de sa §27. Celui-la reste mesure par la fenetre de repos, qui suit les cinq pilotages.
;;
;; `ax` : 0 = VERTICAL (Y monde), 1 = AVANT-ARRIERE (Z monde), 2 = LATERAL (X monde). Le sujet est
;; a quaternion identite pendant toute la phase, donc les axes monde coincident avec le triedre de
;; sa §7 (+X lateral, +Y haut, +Z avant) — c'est ce qui rend l'axe d'EXCITATION comparable a l'axe
;; de MESURE, qui lui est pris dans le triedre de l'ancre.
(defconstant PHYSROOM-IMPF 10)      ;; duree de l'impulsion, en frames (comparaisons entieres)
(defconstant PHYSROOM-IMPFF 10.0)   ;; la MEME duree en flottant. Deux constantes et pas un `the` :
                                    ;; `(the float <litteral entier>)` se replie en REINTERPRETATION
                                    ;; de bits, pas en conversion — 10 y deviendrait 1.4e-44.
(defconstant PHYSROOM-IMPA 365.0)   ;; amplitude du pas, en unites de jeu -> 18.0 u/frame^2 de pic
(defconstant PHYSROOM-AXW 160)      ;; fenetre totale : 10 d'impulsion + 150 de ring-down libre

(defbehavior physroom-drive-imp phys-subject ((f int) (ax int))
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-identity! (-> self root quat))
  ;; `f` est BORNE par l'appelant a PHYSROOM-IMPF : au-dela, `s` vaut 1.0 et le sujet est tenu
  ;; immobile au bout de son pas. Un seul chemin de code pour l'impulsion et pour la tenue.
  ;; ON POUSSE DANS LE TRIEDRE DE L'ANCRE, PAS EN AXES MONDE — ET C'EST UNE MESURE QUI L'IMPOSE.
  ;; Premiere version : impulsions le long de MONDE-Y / MONDE-Z / MONDE-X. Part de la reponse
  ;; tombant sur la projection VERTICALE du solveur, relevee sur la course :
  ;;     chestL  MONDE-Y -> v 21.5 %  ap 38.9 %  lat 39.5 %   (dominee par LAT)
  ;;     chestR  MONDE-Y -> v 25.7 %  ap 56.7 %  lat 17.5 %   (dominee par AP)
  ;; Cinq fenetres sur six dominees par le MEME axe : le repere du sujet et le triedre de l'ancre
  ;; ne sont pas alignes, donc aucune de ces trois impulsions n'isolait un mode propre — et les
  ;; trois frequences qu'elles rendaient etaient trois melanges, pas trois frequences propres.
  ;; Conclure §24 la-dessus aurait ete exactement la mesure non discriminante que le contrat
  ;; interdit. On demande donc au solveur la direction MONDE de SON axe, et on pousse dessus.
  (let* ((tt (if (>= f PHYSROOM-IMPF) 1.0 (/ (the float f) PHYSROOM-IMPFF)))
         (s  (* 0.5 (- 1.0 (cos (* 32768.0 tt)))))
         (d  (* PHYSROOM-IMPA s))
         ;; les deux seins partagent la MEME ancre (le buste), donc le meme triedre : la chaine 0
         ;; suffit a le porter. Si elle n'est pas encore classee, les trois composantes valent 0 —
         ;; c'est le cas que `PHYSAXW` publie, pour qu'une impulsion nulle ne se lise jamais comme
         ;; une absence de reponse.
         (ux (phys-axis-world (-> self slot) 0 ax 0))
         (uy (phys-axis-world (-> self slot) 0 ax 1))
         (uz (phys-axis-world (-> self slot) 0 ax 2)))
    (set! (-> self root trans x) (+ (-> self home x) (* d ux)))
    (set! (-> self root trans y) (+ (-> self home y) (* d uy)))
    (set! (-> self root trans z) (+ (-> self home z) (* d uz))))
  (none))

;; LA MEME IMPULSION, MAIS SIGNEE ET REFERMEE SUR ELLE-MEME (cycle 52).
;; `physroom-drive-imp` pousse toujours dans le sens POSITIF de l'axe du solveur et TIENT le sujet
;; au bout de son pas : c'est ce qu'il faut pour lire un ring-down, et c'est exactement ce qui rend
;; ses trois fenetres incapables de repondre a la question du cycle 51. Celle-ci ajoute les deux
;; choses qui manquent, et rien d'autre :
;;   * le SENS (`sg` vaut +1.0 ou -1.0), a amplitude STRICTEMENT identique — c'est la condition
;;     pour que l'ecart mesure soit imputable au sens et a rien d'autre ;
;;   * le RETOUR a `home`, en demi-cosinus lui aussi, pour que la fenetre suivante reparte du meme
;;     etat. Sans lui, la fenetre `-` heriterait de la pose ou la fenetre `+` s'est arretee, et
;;     l'asymetrie mesuree serait celle du RANG, pas celle du SENS.
;; Le retour est une impulsion de sens oppose : il est donc suivi de 60 frames de calme (5.05
;; constantes de temps, residu 0.6 %) AVANT la fenetre suivante, et ce qu'il en reste est PUBLIE
;; par `PHYSSGN3` au lieu d'etre suppose negligeable.
(defbehavior physroom-drive-sgn phys-subject ((f int) (ax int) (sg float))
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-identity! (-> self root quat))
  (let* ((d  (cond
               ;; montee 0 -> A
               ((<= f PHYSROOM-SGNI)
                (* PHYSROOM-IMPA
                   (* 0.5 (- 1.0 (cos (* 32768.0 (/ (the float f) PHYSROOM-SGNIF)))))))
               ;; tenue a A : la fenetre de mesure
               ((<= f PHYSROOM-SGNM) PHYSROOM-IMPA)
               ;; descente A -> 0
               ((<= f PHYSROOM-SGNR)
                (* PHYSROOM-IMPA
                   (* 0.5 (+ 1.0 (cos (* 32768.0 (/ (the float (- f PHYSROOM-SGNM))
                                                    PHYSROOM-SGNIF)))))))
               ;; calme, pile sur `home`
               (else 0.0)))
         (dd (* d sg))
         ;; MEME source d'axe que `physroom-drive-imp` : on demande au solveur la direction MONDE
         ;; de SON axe et on pousse dessus. Pousser en axes monde ferait lire une projection.
         (ux (phys-axis-world (-> self slot) 0 ax 0))
         (uy (phys-axis-world (-> self slot) 0 ax 1))
         (uz (phys-axis-world (-> self slot) 0 ax 2)))
    (set! (-> self root trans x) (+ (-> self home x) (* dd ux)))
    (set! (-> self root trans y) (+ (-> self home y) (* dd uy)))
    (set! (-> self root trans z) (+ (-> self home z) (* dd uz))))
  (none))

;; les six niveaux d'excitation, en unites de jeu par frame^2 (4096 u = 1 m, 60 Hz). Echelle
;; geometrique : chaque niveau vaut ~2.3x le precedent, du frisson au coup sec.
(defun physroom-exc-level ((i int))
  (case i
    ((0) 1.5)
    ((1) 3.5)
    ((2) 8.0)
    ((3) 18.0)
    ((4) 42.0)
    (else 96.0)))

;; ------------------------------------------------------------------------------------------------
;; REMAPPAGE PAR NOM DES CANAUX D'ANIMATION — CORRECTION D'UN DEFAUT DE L'INSTRUMENT.
;;
;; LE DEFAUT, MESURE. `do-joint-math!` (process-drawable.gc:238-278) applique les canaux d'animation
;; PAR POSITION : le canal `t` va au node-list `t+3` du squelette PORTEUR (boucle :265-271), et le
;; NOMBRE de canaux vient du porteur (`(-> obj draw mgeo num-joints)`, :247) — jamais de l'animation.
;; La salle joue les 31 animations de Keira sur le seul porteur du village 1 : `physroom-set-anim` ne
;; change que `(-> self draw art-group)` puis re-evalue le channel.
;;
;; Or les six rigs de Keira sont identiques sur les node-list 1 a 28 et DIVERGENT ensuite :
;;
;;     art-group                  joints   positions fausses / 96
;;     assistant                    96      0
;;     assistant-village3           96      0     (table strictement identique au village 1)
;;     assistant-village2           96     60
;;     assistant-firecanyon         94     68
;;     assistant-lavatube-start     94     68
;;     assistant-lavatube-end       94     68
;;
;; 8 animations sur 31 pilotent donc le bon os, 23 pilotent le mauvais ; 17 des 46 maillons de
;; chaines (15 chaines sur 22) ont leur joint pilote dans la zone divergente. Le JEU n'est pas
;; touche (seul `assistant-lod0` porte un compagnon HD) : c'est l'INSTRUMENT qui est corrompu sur
;; 74 % de son domaine.
;;
;; LE POINT D'ACCROCHE. `prebind-function` (joint-h.gc:60) est appelee depuis
;; process-drawable.gc:254-255, ENTRE la decompression et la lecture joint par joint : c'est
;; exactement la ou le tableau de transformq peut encore etre remis dans l'ordre du porteur.
;; Disposition du scratchpad, confirmee par lurkerworm.gc:192-199 (`(&+ arg0 432)` = tq[6].quat) :
;; 128 octets de matrices, puis 48 octets par transformq. Le canal `t` est donc le transformq
;; d'indice `t` a `arg0 + 128`, et il correspond au joint d'indice `t+2` du art-joint-geo.
;;
;; CE QUI N'EST PAS FAIT ICI, ET POURQUOI : ni spawn d'un second art-group (5 entrees HD, 20 tables
;; statiques regenerees, refonte de hd-char-for-mgeo), ni retrait des 23 animations (SPEC 6 exige la
;; couverture complete et `ROOM-ANIMS 31/31 skipped=0` doit rester vrai).
;; ------------------------------------------------------------------------------------------------

(defun physroom-build-rest! ((jg art-joint-geo) (nch int))
  "Pose de repos LOCALE du PORTEUR, canal par canal, dans *physroom-tqrest*. C'est ce que recoivent
   les canaux sans source (point 3 : `torch` et `torchTIP` n'existent pas sur les trois rigs a 94
   joints). La bind-pose stockee par un joint EST son inverse-bind (jak-hd.gc:471), donc la
   transformation LOCALE de repos du joint k vaut inv(bind-pose[k]) . bind-pose[parent(k)] — le
   L'_k de jak-hd.gc:510-512. Elle est decomposee en (translation, quaternion, echelle) parce que
   c'est la forme que consomme la lecture (cspace<-parented-transformq-joint!,
   process-drawable.gc:271). Retourne le nombre de canaux effectivement derives ; tout canal dont la
   decomposition ne tient pas reste a l'identite et manque a ce compte, qui est publie."
  (set! *physroom-restok* 0)
  (let ((ib (new 'stack-no-clear 'matrix))
        (lk (new 'stack-no-clear 'matrix)))
    (dotimes (p PHYSROOM-MAXCH)
      (let ((tq (-> *physroom-tqrest* p)))
        ;; valeur par defaut, ecrite AVANT toute tentative : identite locale.
        (set-vector! (-> tq trans) 0.0 0.0 0.0 1.0)
        (quaternion-identity! (-> tq quat))
        (set-vector! (-> tq scale) 1.0 1.0 1.0 1.0)
        (when (and (< p nch) (< (+ p 2) (-> jg length)))
          (let ((j (-> jg data (+ p 2))))
            (when (and j (nonzero? (the-as int j)) (-> j parent))
              (matrix-4x4-inverse! ib (-> j bind-pose))
              (matrix*! lk ib (-> j parent bind-pose))
              ;; decomposition : longueur de ligne = echelle, ligne normalisee = rotation. Une
              ;; longueur nulle ou non finie fait echouer le test et laisse l'identite en place —
              ;; c'est le garde-fou anti-NaN, une matrice singuliere ne peut pas polluer le squelette.
              (let ((ok #t))
                (dotimes (r 3)
                  (let ((len (vector-length (-> lk vector r))))
                    (cond
                      ((> len 0.000001)
                       (set! (-> tq scale data r) len)
                       (vector-float*! (-> lk vector r) (-> lk vector r) (/ 1.0 len)))
                      (else (set! ok #f)))))
                (when ok
                  (matrix->quaternion (-> tq quat) lk)
                  (let ((qn (vector-length (the-as vector (-> tq quat)))))
                    (cond
                      ((and (> qn 0.5) (< qn 2.0))
                       (quaternion-normalize! (-> tq quat))
                       (set! (-> tq trans quad) (-> lk vector 3 quad))
                       (set! (-> tq trans w) 1.0)
                       (+! *physroom-restok* 1))
                      (else
                       ;; quaternion inexploitable : on remet TOUT a l'identite, echelle comprise.
                       (set-vector! (-> tq trans) 0.0 0.0 0.0 1.0)
                       (quaternion-identity! (-> tq quat))
                       (set-vector! (-> tq scale) 1.0 1.0 1.0 1.0))))))))))))
  *physroom-restok*)

(defun physroom-chan-of ((ajg art-joint-geo) (nm string))
  "Position de CANAL, dans le rig `ajg`, du joint qui porte le nom `nm`. -1 s'il n'y est pas.
   Le type passe a lookup-idx-of-art (joint.gc:733-739) est #f EXPRES : la branche typee compare
   `(-> data i type)` a un type, ce qu'un `joint` ne satisfait jamais, et la variante art-group de la
   meme methode (joint.gc:659) applique en plus la ruse « sauter le nom de l'art-group », qui n'a
   aucun sens pour un nom de joint.
   Les indices 0 et 1 du art-joint-geo sont les node-list 1 et 2 (align / prejoint) : ils sont
   pilotes par les DEUX MATRICES du scratchpad (process-drawable.gc:260-264), pas par un canal, donc
   ils ne sont la source de rien."
  (let ((s (lookup-idx-of-art ajg nm (the-as type #f))))
    (if s
      (let ((i (the-as int s))) (if (>= i 2) (- i 2) -1))
      -1)))

(defun physroom-prebind ((arg0 pointer) (arg1 int) (arg2 process-drawable))
  "Permute le tableau de transformq du scratchpad AVANT la lecture joint par joint. Posee sur le
   squelette du sujet par `physroom-build-perm!`, et RETIREE des que la permutation est l'identite :
   sur `assistant` et `assistant-village3` cette fonction n'est jamais appelee.
   `arg1` est `num-joints + 2` (process-drawable.gc:248), donc le nombre de canaux vaut arg1 - 2."
  (let* ((subj (the-as phys-subject arg2))
         (n    (min (- arg1 2) (min (-> subj nchan) PHYSROOM-MAXCH)))
         (dst  (the-as (inline-array transformq) (&+ arg0 128))))
    (when (> (-> subj nperm) 0)
      ;; instantane des canaux tels que l'animation vient de les ecrire. Sans lui, une permutation
      ;; qui n'est pas une suite de transpositions disjointes ecraserait ses propres sources.
      (dotimes (i n)
        (set! (-> *physroom-tqbuf* i trans quad) (-> dst i trans quad))
        (set! (-> *physroom-tqbuf* i quat quad) (-> dst i quat quad))
        (set! (-> *physroom-tqbuf* i scale quad) (-> dst i scale quad)))
      (dotimes (p n)
        (let ((s (-> *physroom-perm* p)))
          (cond
            ((= s p))   ;; la source est deja a la bonne place
            ((and (>= s 0) (< s n))
             (set! (-> dst p trans quad) (-> *physroom-tqbuf* s trans quad))
             (set! (-> dst p quat quad) (-> *physroom-tqbuf* s quat quad))
             (set! (-> dst p scale quad) (-> *physroom-tqbuf* s scale quad)))
            (else
             ;; AUCUNE SOURCE : pose de repos du porteur. Le choix est publie par animation
             ;; (PHYSREMAPORPHAN), jamais silencieux.
             (set! (-> dst p trans quad) (-> *physroom-tqrest* p trans quad))
             (set! (-> dst p quat quad) (-> *physroom-tqrest* p quat quad))
             (set! (-> dst p scale quad) (-> *physroom-tqrest* p scale quad))))))))
  0
  (none))

(defbehavior physroom-build-perm! phys-subject ((ai int) (ag art-group))
  "Construit la permutation POSITION DE CANAL DE L'ANIMATION -> POSITION DE CANAL DU PORTEUR, une
   fois par changement d'animation, et arme (ou desarme) la prebind-function.
   Le rig de l'animation est `(-> ag data 0)` : chaque art-group porte son art-joint-geo a l'indice
   0 (art-elts.gc:20,30,47,52) et `initialize-skeleton` (process-drawable.gc:352-354) valide ce
   contrat. Le type est verifie ici quand meme, et un manquement est publie."
  (set! (-> self nperm) 0)
  (let* ((jg  (-> self draw jgeo))
         ;; n = 0 si le porteur n'a pas de rig : la boucle de noms ne s'ouvre pas, et aucune branche
         ;; de ce corps ne lit `jg` quand n vaut 0.
         (n   (if (nonzero? jg) (min (-> self nchan) (min PHYSROOM-MAXCH (- (-> jg length) 2))) 0))
         (e   (-> ag data 0))
         (ajg (the-as art-joint-geo e))
         (njo (if (and e (nonzero? (the-as int e)) (= (-> e type) art-joint-geo)) (-> ajg length) -1)))
    (cond
      ((< njo 0)
       (format 0 "PHYSREMAPFAIL a=~D ag=~S reason=no-joint-geo-at-index-0~%" ai (-> ag name)))
      ((= ajg jg)
       ;; le rig du PORTEUR lui-meme : identite, aucun tampon, aucun appel, aucune recherche de nom.
       (dotimes (p n) (set! (-> *physroom-perm* p) p)))
      (else
       (dotimes (p n)
         (let ((s (physroom-chan-of ajg (-> jg data (+ p 2) name))))
           (set! (-> *physroom-perm* p) s)
           (when (!= s p) (+! (-> self nperm) 1))))
       (when (> (-> self nperm) 0)
         (dotimes (p n)
           (when (< (-> *physroom-perm* p) 0)
             (format 0 "PHYSREMAPORPHAN a=~D chan=~D joint=~S fallback=carrier-rest-pose restok=~D~%"
                     ai p (-> jg data (+ p 2) name) *physroom-restok*))))))
    (format 0 "PHYSREMAP a=~D ag=~S joints=~D permuted=~D identity=~D~%"
            ai (-> ag name) njo (-> self nperm) (if (> (-> self nperm) 0) 0 1)))
  (when (nonzero? (-> self skel))
    (if (> (-> self nperm) 0)
      (set! (-> self skel prebind-function) physroom-prebind)
      (set! (-> self skel prebind-function) (the-as (function pointer int process-drawable none) #f))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; ANIMATION. On pose le groupe de frames du channel 0 a la main et on avance frame-num nous-memes
;; (num-func-identity) : c'est exactement ce que fait initialize-skeleton (process-drawable.gc:405)
;; et ca nous laisse maitre du temps, donc de la reproductibilite des fenetres. Le `draw art-group`
;; est bascule sur celui de l'animation, comme le fait anim-tester.gc:515 pour jouer les animations
;; d'un art-group sur un squelette deja en place.
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-set-anim phys-subject ((ai int))
  (let* ((ag (-> *physroom-anim-ag* ai))
         (an (the-as art-joint-anim (-> ag data (-> *physroom-anim-ix* ai)))))
    (set! (-> self draw art-group) ag)
    ;; LES CANAUX DE CETTE ANIMATION SONT CEUX DE SON RIG, PAS CEUX DU PORTEUR : on construit la
    ;; permutation par NOM avant que la premiere frame ne soit lue.
    (physroom-build-perm! ai ag)
    (ja-channel-set! 1)
    (let ((ch (-> self skel root-channel 0)))
      (joint-control-channel-group-eval! ch an num-func-identity)
      (set! (-> ch frame-num) 0.0))
    (set! (-> self fnum) 0.0)
    (set! (-> self adir) 1.0)
    ;; LE NOMBRE DE FRAMES DE L'ANIMATION, tel que le lit le jeu lui-meme. La salle utilisait
    ;; `(-> an data 0 length)` — la taille du premier bloc de donnees compressees, PAS une duree.
    ;; Le moteur d'animation, lui, borne `frame-num` a `(-> frame-group frames num-frames)`
    ;; (joint.gc:948). Les deux ne coincident pas, et la salle rejouait donc une fraction arbitraire
    ;; de chaque animation en croyant les jouer entieres.
    (set! (-> self nframe) (the float (-> an frames num-frames)))
    ;; LA VITESSE DE LECTURE DU JEU, et c'est LA cause racine de « la salle mesure l'agitation ».
    ;;
    ;; La salle avancait `frame-num` de 1.0 par frame de jeu. Le jeu, lui, l'avance de
    ;; `inc * (-> frame-group speed) * time-adjust-ratio` (process-drawable-h.gc:46,
    ;; `num-func-loop!`) : la vitesse propre de l'animation est un FACTEUR, et les animations de
    ;; jak1 ont des keyframes espacees justement parce qu'elles sont interpolees entre deux.
    ;; Avancer d'une keyframe ENTIERE par frame joue l'animation plusieurs fois trop vite, et
    ;; l'acceleration croit comme le CARRE du facteur de vitesse.
    ;;
    ;; Ce que ca donnait, mesure (`acc` = pire acceleration de la pose d'auteur REELLEMENT recue par
    ;; la pointe, en u/frame^2) : backHair1 recevait 2447 u/frame^2 SANS AUCUN PILOTAGE — 2150 m/s^2,
    ;; 219 g, sur une animation d'attente. Les cinq pilotages commandaient 18, 52, 96, 434 et 11
    ;; u/frame^2 : ils etaient noyes d'un facteur 25 a 130, et les cinq colonnes rendaient donc le
    ;; meme chiffre. La salle ne mesurait pas la physique de Keira, elle mesurait la Keira qu'elle
    ;; secouait — celle que l'owner ne voit jamais, puisque le jeu ne joue pas ses animations comme
    ;; ca.
    (set! (-> self aspeed) (fmax 0.01 (-> an speed)))
    ;; LA LONGUEUR ET LA VITESSE REELLES, publiees : personne n'a a les deviner, et c'est le
    ;; chiffre qui prouve a quelle vitesse la salle joue reellement l'animation.
    (format 0 "PHYSANIMLEN a=~D n=~f speed=~f~%" ai (-> self nframe) (-> self aspeed)))
  (none))

;; LECTURE CONTINUE : ALLER-RETOUR, JAMAIS DE RETOUR BRUTAL A LA FRAME 0.
;;
;; C'EST LA CAUSE RACINE DE L'ECHEC « DISCRIMINANT », ET C'ETAIT UN DEFAUT DE L'INSTRUMENT, PAS DE
;; LA PHYSIQUE. L'ancienne version faisait `(when (>= fnum (- nframe 1.0)) (set! fnum 0.0))` : en UNE
;; frame, le squelette entier sautait de la derniere pose de l'animation a la premiere. Sur une
;; animation qui BOUCLE (les idle) les deux poses se ressemblent et le saut est petit ; sur une
;; TRANSITION (`assistant-idle-transition-right-to-left`, `assistant-idle-transition-to-welding`,
;; `assistant-village2-idle-hut-stop-welding`) elles n'ont rien a voir, et le personnage se
;; TELEPORTAIT d'une pose a l'autre. La difference seconde de cette teleportation est une
;; acceleration de plusieurs centaines d'unites par frame^2 — bien au-dela des 18 a 96 u/frame^2 que
;; la salle commande, et bien au-dela du coude de saturation mesure par PHYSRESP (18 a 42).
;;
;; Consequence exacte de ce que la gate reproche : la gate prend le MAXIMUM sur les animations, donc
;; pour chaque pilotage elle tombait sur une animation de transition, et y lisait la reponse au coup
;; de teleportation — la meme sous les cinq pilotages, puisqu'elle ne doit rien au pilotage. Les
;; chaines les plus courtes y etaient collees a leur plafond geometrique (lKneeFlap : os de 8 cm,
;; excursion de pointe 14,4 cm SOUS ANIMATION SEULE). On ne mesurait pas la physique de Keira, on
;; mesurait le rebond de la salle qui la secouait 20 fois par seconde.
;;
;; La lecture aller-retour visite EXACTEMENT les memes poses (SPEC 6 : « toutes ses animations »),
;; dans les deux sens, sans aucune discontinuite de position. Ce n'est pas un filtre et ca ne retire
;; aucun mouvement : ca retire une teleportation que le jeu ne fait pas non plus (en jeu, les
;; animations sont enchainees par un fondu, jamais par un saut de frame-num).
(defbehavior physroom-advance-anim phys-subject ((step float))
  (when (nonzero? (-> self skel))
    (let ((last (fmax 1.0 (- (-> self nframe) 1.0))))
      (set! (-> self fnum) (+ (-> self fnum) (* (-> self adir) (* step (-> self aspeed)))))
      (when (>= (-> self fnum) last)
        (set! (-> self fnum) last)
        (set! (-> self adir) -1.0)
        (+! (-> self wraps) 1))
      (when (<= (-> self fnum) 0.0)
        (set! (-> self fnum) 0.0)
        (set! (-> self adir) 1.0)
        (+! (-> self wraps) 1)))
    (set! (-> self skel root-channel 0 frame-num) (-> self fnum)))
  (none))

;; ------------------------------------------------------------------------------------------------
;; PUBLICATION D'UNE FENETRE. Une ligne par chaine. La cle `k` encode (chaine, animation,
;; pilotage) : format est cape a 8 parametres (destination + format + 6), et on veut les quatre
;; colonnes sur la meme ligne pour qu'elles ne puissent pas etre reassemblees de travers.
;;   amp  = AMPLITUDE de l'ecart de pointe du a la physique seule (diagonale de sa boite)
;;   root = pire residu d'ancrage de la racine
;;   pen  = pire penetration residuelle au-dela du plancher de pose modele
;;   jump = pire saut de l'ecart de pointe sur UNE frame
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-emit-window phys-subject ()
  (dotimes (c (-> self nchain))
   ;; une chaine que le moteur a ecartee (pose de modele hors de portee de son porteur) n'a pas de
   ;; mesure a publier : publier des zeros pour elle serait un chiffre invente.
   (when (> (phys-chain-links (-> self slot) c) 0)
    (cond
      ;; LIGNE DE BASE : meme animation, meme duree de fenetre, AUCUN pilotage. Publiee sur sa
      ;; propre ligne et jamais comme une mesure de pilotage : elle sert a soustraire, pas a
      ;; compter. La confondre avec un `row` donnerait a chaque chaine un pilotage artificiellement
      ;; faible, et ferait passer la gate DISCRIMINANT sans rien mesurer de plus.
      ((>= (-> self drive) PHYSROOM-DRIVES)
       (format 0 "PHYSBASE c=~D a=~D amp=~f jump=~f ns=~f~%"
               c (-> self ai)
               (phys-tip-amp (-> self slot) c)
               (phys-stat (-> self slot) c 2)
               (phys-stat (-> self slot) c 0)))
      (else
       (format 0 "PHYSROW k=~D amp=~f root=~f pen=~f jump=~f ns=~f~%"
               (+ (* (+ (* c PHYSROOM-MAXANIM) (-> self ai)) PHYSROOM-DRIVES) (-> self drive))
               (phys-tip-amp (-> self slot) c)
               (phys-stat (-> self slot) c 3)
               (phys-pen-col (-> self slot) c)
               (phys-stat (-> self slot) c 2)
               (phys-stat (-> self slot) c 0))
       ;; [NOTE-150] MEME CLE `k`, meme fenetre : la profondeur AJOUTEE sous la peau DESSINEE.
       ;; Elle ne peut pas tenir sur la ligne ci-dessus (`format` est cape a 6 valeurs) et elle ne
       ;; doit pas etre agregee autrement : la gate COLLIDE se prononce par (chaine, animation,
       ;; pilotage), donc son domaine doit etre le meme.
       (format 0 "PHYSROW2 k=~D skinadd=~f~%"
               (+ (* (+ (* c PHYSROOM-MAXANIM) (-> self ai)) PHYSROOM-DRIVES) (-> self drive))
               (phys-stat (-> self slot) c 20))))
    ;; ---- SPEC 14-20 : LA REPONSE DE COM PAR REGIME, ET C'EST LA SEULE FORME COMPARABLE ------
    ;; Ses §14 a §20 sont les SEULES lignes de sa spec qui relient un STIMULUS a une REPONSE
    ;; attendue, et chacune donne sa propre bande de COM : saut 15-32 % B0, atterrissage 25-40 %,
    ;; freinage 10-30 %, lacet 10-28 %, tangage 30-40 % d'apex, roulis 15-22 %. Le PLUS GRAND
    ;; chiffre de COM de toute sa spec est 0.40 B0 (§16, atterrissage tres dur) — et c'est aussi
    ;; le plafond dur de sa §22. Aucun regime n'en autorise davantage.
    ;; Un maximum de COURSE (`PHYSDIAG8`) ne se compare a AUCUNE de ces bandes : il melange les
    ;; regimes. Celui-ci est le maximum de LA fenetre, donc d'un seul (chaine, animation,
    ;; pilotage), et il est remis a zero juste apres publication.
    ;; NATURE : une LONGUEUR rapportee a B0, maximum sur la fenetre — pas un cumul, pas une
    ;; variance. REPERE : le monde, frame ecrite, contre la pose d'auteur de la MEME frame,
    ;; deformation comprise. LECTURE A LA POSE D'AUTEUR : 0.0000. `d` >= PHYSROOM-DRIVES designe
    ;; la ligne de base SANS pilotage — c'est elle qui dit ce que l'animation seule produit, donc
    ;; ce qu'il faut soustraire avant d'attribuer quoi que ce soit au pilotage.
    (format 0 "PHYSCOMW c=~D a=~D d=~D comex=~f~%"
            c (-> self ai) (-> self drive)
            (phys-diag (-> self slot) c 23))
    ;; ---- SPEC 6 + SPEC 22 : LE COM PONDERE PAR LA MASSE — LA GRANDEUR QUE SA BORNE NOMME ----
    ;; Sa §6 definit `P0` = « neutral breast center-of-mass position » et sa §22 borne « Breast
    ;; COM: normal <= 35% B0, hard transient <= 40% B0 » (cite mot pour mot du fichier de spec).
    ;; UN CENTRE DE MASSE EST UNE MOYENNE PONDEREE PAR LA MASSE. `comex` ci-dessus est un MAXIMUM
    ;; SUR LES DEUX MAILLONS — ce n'est pas la meme grandeur, et c'est la seconde qui etait
    ;; publiee sous le nom que la spec donne a la premiere (NOTE-112, cycle 41).
    ;; Ici : la somme des excursions de centroide de chaque maillon PONDEREES PAR SA MASSE DE PEAU
    ;; (`comw=`, mesuree sur le mesh LIVRE), formee VECTORIELLEMENT et DANS LA MEME FRAME. C'est
    ;; une identite exacte du skinning lineaire, pas une recomposition majorante : la moitie
    ;; ANCREE de la chair (`chest`, `?shoulder` — 45.9 % / 46.1 %) y entre avec une excursion
    ;; nulle, ce qu'un maximum ne peut pas representer.
    ;;   com  NATURE : une LONGUEUR rapportee a B0, MAXIMUM de la fenetre.
    ;;   coms/comn : somme et compte sur les FRAMES de la fenetre -> la MOYENNE, qui est ce que
    ;;        §22 borne ; un maximum seul ne dit pas si une borne cliperait une queue ou
    ;;        muselerait la reponse.
    ;;   comhi : combien de FRAMES au-dessus du plafond dur de 0.40 B0.
    ;; REPERE : le monde, frame ecrite, contre la pose d'auteur de la MEME frame, deformation
    ;; comprise — celui de `comex`, pour que les deux soient comparables ligne a ligne.
    ;; LECTURE A LA POSE D'AUTEUR : 0.0000. Chaine sans `comw=` : AUCUNE ligne, jamais un zero.
    ;; DEUX LIGNES, et ce n'est pas un choix de style : `format` de GOAL n'accepte pas plus de
    ;; huit parametres, destination et chaine comprises (meme contrainte que PHYSGRAD/PHYSGRADS).
    (format 0 "PHYSCOMX c=~D a=~D d=~D com=~f coms=~f~%"
            c (-> self ai) (-> self drive)
            (phys-diag (-> self slot) c 43)
            (phys-diag (-> self slot) c 44))
    (format 0 "PHYSCOMX2 c=~D a=~D d=~D comn=~f comhi=~f~%"
            c (-> self ai) (-> self drive)
            (phys-diag (-> self slot) c 45)
            (phys-diag (-> self slot) c 46))
    ;; ---- SPEC 14/16/17/18/19/20/22 : L'APEX. SIX SECTIONS LE BORNENT, RIEN NE LE PUBLIAIT ----
    ;; [NOTE-139] du moteur. Ce que ces deux lignes portent, et ce qu'elles NE portent PAS :
    ;;   apex : NATURE une LONGUEUR rapportee a B0 (602 u, sa §6), MAXIMUM DE LA FENETRE. Ce
    ;;        n'est PAS le COM : le COM est la moyenne ponderee de TOUT le nuage de chair, dont
    ;;        46 % est ancre ; l'apex est le centroide du DECILE DISTAL seul. Les deux repondent
    ;;        a des lignes differentes de la spec et ne sont pas interchangeables.
    ;;   ax/ay/az : les trois composantes SIGNEES du meme vecteur, relevees A L'ARGMAX de `apex`,
    ;;        donc sur UNE frame et toutes les trois ensemble — jamais trois maxima separes.
    ;;   cydn/cyup : SPEC 15, les DEUX extremes de la composante verticale du COM sur la fenetre,
    ;;        publies TOUS DEUX EN POSITIF (`cydn` = le plus bas atteint, change de signe). La
    ;;        traversee du neutre qu'exige §15 se lit `cydn > 0 ET cyup > 0` ; un seul des deux a
    ;;        zero veut dire que l'organe n'a jamais change de cote pendant la fenetre.
    ;; REPERE : le monde, frame ecrite, contre la pose d'auteur de la MEME frame, deformation
    ;; comprise — le meme que `comex` et `com`, pour que les trois se comparent ligne a ligne.
    ;; LECTURE QUAND LE DEFAUT EST ABSENT : 0.0000 partout a la pose d'auteur. Une chaine sans
    ;; enregistrement `ax` n'emet AUCUNE de ces deux lignes — jamais un apex publie a zero.
    ;; DEUX LIGNES parce que `format` de GOAL est cape a huit parametres, destination et chaine
    ;; de format comprises : six valeurs par ligne au maximum.
    (format 0 "PHYSAPEX c=~D a=~D d=~D apex=~f ax=~f ay=~f~%"
            c (-> self ai) (-> self drive)
            (phys-diag (-> self slot) c 53)
            (phys-diag (-> self slot) c 54)
            (phys-diag (-> self slot) c 55))
    (format 0 "PHYSAPEX2 c=~D a=~D d=~D az=~f cydn=~f cyup=~f~%"
            c (-> self ai) (-> self drive)
            (phys-diag (-> self slot) c 56)
            (phys-diag (-> self slot) c 57)
            (phys-diag (-> self slot) c 58))
    ;; ---- LES TROIS TERMES DE L'APEX (cycle 73, [NOTE-338]) -------------------------------------
    ;; NATURE : deux VECTEURS, en unites de B0, sans dimension. REPERE : le MONDE, difference de
    ;; deux points de la meme frame (la pose simulee et la pose d'AUTEUR du meme joint), donc le
    ;; meme repere que `apex`/`ax`/`ay`/`az` juste au-dessus.
    ;;   `tp` = la part que le maillon a TRANSLATEE — le SEUL terme qu'une borne du moteur borne
    ;;          aujourd'hui (`jak-hd-physics.gc:3120-3141`, asymptote 0.50 B0).
    ;;   `dp` = la part apportee par le TENSEUR de deformation applique au bras de chair.
    ;;   `rp` = ce qui reste, la ROTATION de visee : il ne s'emet PAS, il se DERIVE par
    ;;          `rp = (ax,ay,az) - tp - dp`. L'emettre serait publier une quatrieme mesure
    ;;          redondante que rien ne pourrait contredire ; le deriver rend l'identite
    ;;          `e = tp + rp + dp` VERIFIABLE, et c'est le seul controle que ce canal possede.
    ;; LES SIX VALEURS SONT PRISES AU MEME ARGMAX QUE `apex` (jak-hd-physics.gc, meme bloc `when`),
    ;; donc sur LA MEME FRAME : trois maxima pris sur trois frames differentes ne se soustraient
    ;; pas, et c'est exactement le piege `argmax-anchor-is-not-a-population` du registre.
    ;; LECTURE QUAND LE DEFAUT EST ABSENT : 0.0000 partout a la pose d'auteur.
    (format 0 "PHYSAPEXT c=~D a=~D d=~D tx=~f ty=~f tz=~f~%"
            c (-> self ai) (-> self drive)
            (phys-diag (-> self slot) c 59)
            (phys-diag (-> self slot) c 60)
            (phys-diag (-> self slot) c 61))
    (format 0 "PHYSAPEXD c=~D a=~D d=~D dx=~f dy=~f dz=~f~%"
            c (-> self ai) (-> self drive)
            (phys-diag (-> self slot) c 62)
            (phys-diag (-> self slot) c 63)
            (phys-diag (-> self slot) c 64))
    ;; ---- SPEC 22 : L'ATTRIBUTION DE `comex` A SES TROIS TERMES (cycle 35 etape 1) ----------
    ;; `comex` est le plus gros depassement ouvert de toute la spec (1.85 / 1.91 B0 contre un
    ;; plafond dur de 0.40). Le cycle 34 a prouve PAR INTERVENTION que borner le point libre ne le
    ;; baisse pas — il fallait donc savoir QUEL terme le porte avant de dimensionner un correctif.
    ;;   e = (p_sim - p_auth) + R_auth.(rot - I).lc + R_auth.rot.(T - I).lc
    ;;        \___ tp ___/      \______ rp ______/    \_______ dp _______/
    ;;   [A] le joint a bouge · [B] le maillon a tourne x son bras · [C] le tenseur x son bras
    ;; C'est une IDENTITE, pas un modele : la somme des trois EST `e`, quelles que soient les
    ;; valeurs. Ce qui est publie sont les PROJECTIONS SIGNEES sur `e^`, donc
    ;;   tp + rp + dp = comex * b0c   EXACTEMENT — et le lecteur le verifie (M0 des predictions).
    ;; Des normes ne se recomposeraient pas : deux termes peuvent s'annuler et trois normes ne le
    ;; diraient pas.
    ;; NATURE : trois LONGUEURS SIGNEES en unites de jeu (4096 = 1 m), relevees a l'ARGMAX de
    ;;   `comex` DE CETTE FENETRE — un seul echantillon pour les trois, jamais trois maxima
    ;;   independants (piege `RAD-FLESH-IPAIR` du cycle 34 : deux lecteurs de la meme trace
    ;;   retenaient deux fenetres differentes et sortaient cinq violations d'appariement).
    ;; REPERE : le monde, meme frame, contre la pose d'auteur de cette frame — celui de `comex`.
    ;; LECTURE QUAND LE DEFAUT EST ABSENT : tp = rp = dp = 0.0000 a la pose d'auteur.
    ;; `lk` = QUEL MAILLON porte ce maximum. Les deux ecrivent le MEME emplacement 23 et leurs bras
    ;; de levier n'ont rien de comparable : maillon 0 = os de 1.73 B0, chair a 1.08 B0 ; maillon 1 =
    ;; os de 0.23 B0, chair a 0.86 B0, soit 3.7x son propre os. Sans cette colonne l'attribution ne
    ;; designe aucune piece — et le correctif de l'etape 2 non plus.
    ;; DEUX LIGNES, ET C'EST UNE CONTRAINTE DE `format`, PAS UN CHOIX : toutes les autres lignes de
    ;; ce fichier tiennent en SIX valeurs, aucune n'en porte sept. Plutot que de parier sur une
    ;; septieme et risquer une troncature SILENCIEUSE, `lk` sort sur sa propre ligne, meme cle
    ;; (c, a, d) — le lecteur les rapproche par cette cle, comme il le fait deja pour PHYSRESTW/S.
    (format 0 "PHYSCOMD c=~D a=~D d=~D tp=~f rp=~f dp=~f~%"
            c (-> self ai) (-> self drive)
            (phys-diag (-> self slot) c 31)
            (phys-diag (-> self slot) c 32)
            (phys-diag (-> self slot) c 33))
    (format 0 "PHYSCOMDL c=~D a=~D d=~D lk=~f~%"
            c (-> self ai) (-> self drive)
            (phys-diag (-> self slot) c 34))
    ;; SPEC 9 — LA DECOMPOSITION DE `comex` EN CE QUI EST STATIQUE ET CE QUI EST DYNAMIQUE.
    ;; `comex` se mesure contre la POSE D'AUTEUR ; le ressort, lui, vise `attache +
    ;; R_ancre . u_capture . bl` (jak-hd-physics.gc:2686). Si ces deux poses different, `comex`
    ;; est non nul meme avec un solveur immobile et converge — et aucune raideur, aucun limiteur,
    ;; aucun contact ne peut la faire baisser. Les deux lignes separent les deux :
    ;;   rgap = |cible de repos - pose d'auteur| / B0   AUCUNE dynamique n'y entre
    ;;   perr = |position simulee - cible de repos| / B0  la part que la dynamique produit
    ;; NATURE longueurs / B0 ; REPERE le monde, meme frame, meme attache, meme longueur d'os ;
    ;; ABSENT rgap = 0.0000 si la cible de repos EST la pose d'auteur. Deux lignes parce que
    ;; `format` de GOAL est cape a huit parametres, destination et chaine comprises.
    (format 0 "PHYSRESTW c=~D a=~D d=~D rgap=~f perr=~f~%"
            c (-> self ai) (-> self drive)
            (phys-diag (-> self slot) c 24)
            (phys-diag (-> self slot) c 26))
    (format 0 "PHYSRESTS c=~D a=~D d=~D rgsum=~f pesum=~f rgn=~f~%"
            c (-> self ai) (-> self drive)
            (phys-diag (-> self slot) c 25)
            (phys-diag (-> self slot) c 28)
            (phys-diag (-> self slot) c 27))
    ;; ---- SPEC 37, LA MOITIE TRANSLATION DU REBASE (cycle 33 etape 3) ------------------------
    ;; Sa 37 : « rebase on teleport / cutscene / discontinuity — artificial transforms must not
    ;; generate physical breast impulses ». La moitie ROTATION existe depuis longtemps
    ;; (`jak-hd-physics.gc:3701-3707`, roulis de l'ancre, seuil de 0.5 rad) ; la moitie TRANSLATION
    ;; a ete mesuree ABSENTE au cycle 33 etape 2 : 62 fenetres SANS PILOTAGE sur 62 portaient un
    ;; ecart apex/cible > 5 B0 et la pose ECRITE sautait de 0.29-0.31 B0 en une frame.
    ;; NATURE   `fired` = un COMPTE de frames ou le rebase a agi dans CETTE fenetre (pas un taux,
    ;;   pas une amplitude) · `amax` = le MAXIMUM du deplacement de l'ancre d'une frame a la
    ;;   suivante, en unites de jeu.
    ;; REPERE   le monde, entre deux frames consecutives, sur la position de l'ANCRE elle-meme.
    ;; ABSENT   `amax` = 0.0000 sur la premiere frame d'une chaine (aucune frame precedente) et
    ;;   pendant l'idle a pose figee ; `fired` = 0 quand aucune discontinuite n'est franchie.
    ;; POURQUOI `amax` EXISTE A COTE DE `fired` : un compteur seul ne dit pas si le seuil est bon.
    ;;   `amax` donne la DISTRIBUTION, donc si un seuil peut separer une translation legitime d'une
    ;;   discontinuite — ou si les deux se recouvrent, auquel cas aucun seuil sur cette grandeur ne
    ;;   le peut et il faut le dire.
    (format 0 "PHYSREBASE c=~D a=~D d=~D fired=~f amax=~f~%"
            c (-> self ai) (-> self drive)
            (phys-diag (-> self slot) c 29)
            (phys-diag (-> self slot) c 30))
    ;; LE STIMULUS REELLEMENT RECU, pour CHAQUE fenetre y compris la ligne de base. Compare a
    ;; l'amplitude commandee (PHYSSTIM), il dit si le pilotage a domine ou s'il a ete noye.
    (format 0 "PHYSACC c=~D a=~D d=~D acc=~f wraps=~D~%"
            c (-> self ai) (-> self drive)
            (phys-tip-stim (-> self slot) c)
            (-> self wraps))
    ;; LE GRADIENT, MAILLON PAR MAILLON (7e passe : « entre la racine et les pointes c'est zone de
    ;; guerre et les pointes bougent quasi pas »). Une ligne par maillon : c'est la seule forme qui
    ;; puisse porter un degrade, la ou un scalaire par chaine n'en montre rien.
    ;; DEUX GRANDEURS PAR MAILLON, ET LEUR ECART EST LE SUJET. 10e passe : « le milieu bouge
    ;; beaucoup plus que les pointes » alors que `amp` publiait une suite croissante.
    ;;   amp = ecart a la pose d'auteur — il CUMULE le long de la chaine, donc une pointe soudee a
    ;;         son parent herite du chiffre de son parent et parait mobile ;
    ;;   ang = deviation ANGULAIRE par rapport a l'attache, en degres — le mouvement PROPRE du
    ;;         maillon, nul pour un maillon qui suit rigidement son parent.
    ;; C'est `ang` que SPEC 2 exige croissante ; `amp` reste publiee pour que l'ecart entre les deux
    ;; soit lisible au lieu d'etre affirme.
    ;; NATURE / REPERE / LECTURE-HORS-DEFAUT — ecrits ici au cycle 39 parce que le preflight les
    ;; signalait absents et que leur absence a failli me faire lire cette ligne de travers.
    ;;   amp  NATURE : une ETENDUE, pas une valeur instantanee — la DIAGONALE DE LA BOITE
    ;;        ENGLOBANTE de l'ecart a la pose d'auteur, ACCUMULEE sur toute la fenetre
    ;;        (`phys-link-amp`, jak-hd-physics.gc:4143-4155, sur `*phys-ox/oy/oz*` :3219-3224).
    ;;        REPERE : LOCAL A L'ANCRE (`chest`), pas le monde — `*phys-o**` est tourne par `w2l`
    ;;        a jak-hd-physics.gc:3170-3177. UNITES : unites de jeu (4096 = 1 m).
    ;;   ang  NATURE : un MAXIMUM de fenetre (`phys-link-ang` :4163-4168 sur `*phys-la*` :3345-3346),
    ;;        en degres. REPERE : RELATIF A L'ATTACHE — le parent SIMULE si `l > 0`, l'ancre sinon
    ;;        (:3296-3304) — donc une deviation propre, NON ADDITIVE le long de la chaine.
    ;;   LECTURE QUAND LE DEFAUT EST ABSENT : les deux valent 0.0000 a la pose d'auteur, et `ang`
    ;;        vaut 0.0000 IDENTIQUEMENT sur un maillon epingle par `rootlock` (il n'est ni integre
    ;;        ni ecrit) — c'est ce qui en fait le controle positif d'une ablation de racine.
    ;;   PIEGE, PAYE AU CYCLE 39 : `ang` est un maximum de FENETRE alors que `tp/rp/dp` de
    ;;        `PHYSCOMD` sont releves a l'ARGMAX de `comex`. Reconstruire une corde
    ;;        `2*L*sin(ang/2)` et la comparer a `tp` rapproche donc DEUX FRAMES DIFFERENTES :
    ;;        c'est une verification d'ordre de grandeur, jamais une identite.
    (dotimes (l (phys-chain-links (-> self slot) c))
      ;; `a0`/`a1` : le MEME angle releve aux etages du solveur (apres integration seule, puis
      ;; apres contraintes + attenuation). `ang` reste la valeur ECRITE. C'est la comparaison des
      ;; trois qui designe l'etage qui aplatit la pointe -- defaut `hair-gradient`, PRIORITE 1 :
      ;; un seul chiffre en sortie ne pouvait pas le dire, et trois passes ont bute dessus.
      (format 0 "PHYSGRAD c=~D a=~D d=~D l=~D amp=~f ang=~f~%"
              c (-> self ai) (-> self drive) l
              (phys-link-amp (-> self slot) c l)
              (phys-link-ang (-> self slot) c l))
      ;; ---- SPEC 6 + SPEC 22 : LE CENTRE DE MASSE EST UNE MOYENNE PONDEREE, PAS UN MAXIMUM ----
      ;; Sa §6 definit `P0` = « neutral breast center-of-mass POSITION » et sa §22 borne « Breast
      ;; COM ». Un centre de masse est la moyenne des positions PONDEREE PAR LA MASSE sur toute la
      ;; population de chair. `comex` (PHYSCOMW ci-dessus) publie autre chose : le MAXIMUM sur les
      ;; deux maillons de l'excursion de leurs deux centroides de geometrie possedee
      ;; (jak-hd-physics.gc:3963-3964, emplacement 23 indexe par CHAINE — les deux maillons
      ;; ecrasent le meme emplacement). Un maximum sur deux echantillons ne repond pas a une
      ;; question de POPULATION : le maillon 0 ne possede que 18.9 % / 22.0 % de la masse du nuage
      ;; et 45.6 % / 45.3 % de cette masse est portee par `chest`, qui N'EST PAS SIMULE — donc dont
      ;; l'excursion vaut ZERO par construction, puisque sa matrice ecrite EST sa matrice d'auteur.
      ;;   ee  NATURE : une LONGUEUR rapportee a B0, MAXIMUM de la fenetre, POUR CE MAILLON SEUL —
      ;;       la meme grandeur que `comex`, avant que le maximum sur les maillons ne l'ecrase.
      ;;   jt  NATURE : une LONGUEUR rapportee a B0, relevee A LA FRAME QUI MAXIMISE `ee` de CE
      ;;       maillon (jamais son propre maximum : deux maxima independants viendraient de deux
      ;;       frames differentes — piege `RAD-FLESH-IPAIR` du cycle 34). C'est |p_sim - p_auteur|
      ;;       du JOINT seul, donc la part de l'excursion qui NE DEPEND PAS de `lc` : elle dit ce
      ;;       que vaudrait la mesure si le centre de chair etait pose exactement sur le joint.
      ;; REPERE : le monde, meme frame, contre la pose d'auteur de la MEME frame — celui de `comex`.
      ;; LECTURE QUAND LE DEFAUT EST ABSENT : `ee` = `jt` = 0.0000 a la pose d'auteur.
      ;; POURQUOI LA PONDERATION N'EST PAS FAITE ICI : les poids de peau ne sont pas une donnee que
      ;; le moteur lit — les publier bruts laisse la ponderation au lecteur, avec ses poids MESURES
      ;; sur le mesh livre et cites. Un chiffre unique cache ici serait invivrifiable.
      (format 0 "PHYSCOMWL c=~D a=~D d=~D l=~D ee=~f jt=~f~%"
              c (-> self ai) (-> self drive) l
              (phys-diag (-> self slot) c (+ 35 l))
              (phys-diag (-> self slot) c (+ 39 l)))
      ;; LIGNE SEPAREE, et ce n'est pas un choix de style : `format` de GOAL n'accepte pas plus de
      ;; huit parametres, destination et chaine comprises.
      (format 0 "PHYSGRADS c=~D a=~D d=~D l=~D a0=~f a1=~f~%"
              c (-> self ai) (-> self drive) l
              (phys-link-ang-stage (-> self slot) c l 0)
              (phys-link-ang-stage (-> self slot) c l 1)))
    ;; ---- PHYSSTG — LES SEPT ETAGES DE LA BORNE DE SPEC 22 DANS UNE MEME FRAME (cycle 74) ----
    ;; Le cycle 73 a etabli que le filet de `jak-hd-physics.gc` ne PEUT PAS laisser le maillon
    ;; racine au-dessus de 0.50 B0 a l'instant ou il s'applique, et que la valeur LIVREE vaut
    ;; 0.6670 B0. Quinze passes de contraintes separent les deux instants. Cette ligne les ouvre.
    ;;   NATURE : une LONGUEUR rapportee a `B0` (SPEC 6, la CHAIR, 602.0 u) — la MEME grandeur que
    ;;            `jt` de PHYSCOMWL ci-dessus, relevee a SEPT instants de la frame au lieu d'un.
    ;;   REPERE : le monde, contre la pose d'AUTEUR de la MEME frame.
    ;;   POPULATION : les sept valeurs viennent d'UNE SEULE frame, celle qui maximise l'etage 6
    ;;            dans la fenetre. Ce ne sont PAS sept maximums independants — ceux-la viendraient
    ;;            de sept frames differentes et ne pourraient soutenir aucun modele reliant deux
    ;;            etages (piege `RAD-FLESH-IPAIR`, cycle 34).
    ;;   LECTURE QUAND LE DEFAUT EST ABSENT : 0.0000 aux sept etages, a la pose d'auteur.
    ;;   ETAGES : 0 avant le filet · 1 apres le filet · 2 apres la 1re contrainte de LONGUEUR ·
    ;;            3 apres la 1re COLLISION · 4 apres les 8 iterations · 5 avant la peau ·
    ;;            6 apres la peau = LA VALEUR LIVREE.
    ;;   CONTROLE INTERNE GRATUIT : l'etage 1 est <= 0.50 B0 par ALGEBRE (`ds = kn + cp*tanh(x)`,
    ;;            strictement < kn+cp). S'il ne l'est pas, c'est L'INSTRUMENT qui est faux, pas le
    ;;            solveur, et rien d'autre de cette ligne n'est lisible.
    (dotimes (st 7)
      (format 0 "PHYSSTG c=~D a=~D d=~D st=~D jt=~f~%"
              c (-> self ai) (-> self drive) st
              (phys-diag (-> self slot) c (+ 72 st))))
    ;; L'ALLONGEMENT ET LE STIMULUS GRAVITAIRE DE CETTE FENETRE. Par fenetre, donc attribuables a un
    ;; PILOTAGE : « ils s'allongent sur les mouvements brusques » ne se verifie pas sur un total de
    ;; course. `gn` = |g_effective|/|g| vu par l'ancre, `tf` = la part TANGENTIELLE de cette gravite,
    ;; seule capable de faire tourner le lien — le reste est annule par la contrainte de longueur.
    (format 0 "PHYSSTR c=~D a=~D d=~D el=~f gn=~f tf=~f~%"
            c (-> self ai) (-> self drive)
            (phys-stat (-> self slot) c 17)
            (phys-stat (-> self slot) c 18)
            (phys-stat (-> self slot) c 19))
    ;; SPEC 8 / 36 / 29 — LA FORME, PAR FENETRE, DONC ATTRIBUABLE A UN PILOTAGE.
    ;; NATURE : trois echelles sans dimension (lateral, vertical, projection) et leur determinant,
    ;; puis le MAXIMUM sur la fenetre du mode secondaire de §36 (fraction d'epaisseur) et de la
    ;; torsion de §29 (radians). REPERE : le triedre de sa §7. LECTURE HORS DEFAUT : 1 / 1 / 1 / 1
    ;; et deux zeros — c'est ce que doit rendre une fenetre debout et immobile, et c'est ce qui
    ;; rend la ligne DISCRIMINANTE : sous `jerk` elle ne peut pas rendre la meme chose que sous
    ;; `updown` si le canal est vraiment alimente par le mouvement.
    ;; CE QUE CE N'EST PAS : la deformation vue sur le mesh. C'est ce que le solveur COMMANDE a la
    ;; racine ; la peau, graduee en r^1.63, n'en recoit qu'une part croissante vers la pointe.
    (format 0 "PHYSSHAPE c=~D a=~D d=~D sx=~f sy=~f sz=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 0)
            (phys-shape (-> self slot) c 1)
            (phys-shape (-> self slot) c 2))
    (format 0 "PHYSSHAPE2 c=~D a=~D d=~D det=~f secm=~f twm=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 3)
            (phys-shape (-> self slot) c 5)
            (phys-shape (-> self slot) c 7))
    ;; `secr` = le mode secondaire AVANT le plafond de §38, `dynm` = l'etirement dynamique de
    ;; §22/38. Le premier existe parce qu'un `secm` colle a 0.0700 sur toutes les fenetres ne dit
    ;; pas s'il frole le plafond ou s'il le defonce d'un facteur dix : c'est la signature du
    ;; limiteur sature, et sans cette ligne elle est invisible.
    (format 0 "PHYSSHAPE3 c=~D a=~D d=~D secr=~f dynm=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 12)
            (phys-shape (-> self slot) c 13))
    ;; §23, cinquieme terme de sa liste : la PRESSION DE CONTACT. `prsr` est publie a cote de `prsm`
    ;; pour la meme raison que `secr` a cote de `secm` : un plafond touche partout n'est pas une
    ;; amplitude, et sans la valeur brute on ne peut pas le savoir.
    (format 0 "PHYSSHAPE4 c=~D a=~D d=~D prsm=~f prsr=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 19)
            (phys-shape (-> self slot) c 20))
    ;; ---- SPEC 23 : LES DEUX ENTREES DU TENSEUR, AVANT LEUR PLAFOND (cycle 35 etape 3) --------
    ;; M3 du cycle 35 a etabli que le tenseur est le porteur RESTANT de sa §22 (0.2614 B0 de
    ;; moyenne). Or ses deux SORTIES sont collees a leur plafond (`dynm` = `PHYS-DYN-MAX` = 0.2500
    ;; et `prsm` = `PHYS-PRS-MAX` = 0.2500, exactement, dans toutes les courses mesurees). Une
    ;; sortie collee a son plafond ne dit pas de combien l'ENTREE le depasse — et une entree
    ;; saturee ne repond a aucun stimulus, quoi qu'on lui donne. C'est le mode d'echec du cycle 34
    ;; (une saturation ecrite comme multiplicateur de force gelait le rappel a 46.3 u/frame).
    ;; `dlr` = l'entree d'ETIREMENT avant son `fmin` ; `prsr` (ci-dessus) est deja son equivalent
    ;; pour la PRESSION. `dsat`/`psat` comptent les frames ou chacune a mordu, `nfr` est leur
    ;; denominateur COMMUN — sans lui ce sont des comptes, pas des parts, et deux comptes de
    ;; portees differentes ne se comparent pas.
    ;; NATURE : `dlr` sans dimension (fraction d'etirement), maximum de fenetre ; `dsat`/`psat`/`nfr`
    ;; des COMPTES de frames cumules sur la fenetre. REPERE : le triedre de sa §7, comme le reste
    ;; de `phys-shape`. LECTURE HORS DEFAUT : dlr = 0.0000 et dsat = psat = 0 au repos d'auteur.
    (format 0 "PHYSSHAPE5 c=~D a=~D d=~D dlr=~f dsat=~f nfr=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 21)
            (phys-shape (-> self slot) c 22)
            (phys-shape (-> self slot) c 24))
    (format 0 "PHYSSHAPE6 c=~D a=~D d=~D psat=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 23))
    ;; ---- CYCLE 36 ETAPE 1 : LA NATURE DE L'ENTREE DE PRESSION -------------------------------
    ;; L'etape 3 du cycle 35 a mesure `prsr` a 53.5x / 61.1x son plafond. En remontant a la source,
    ;; `pr0 = PHYS-PRS-K * |*phys-cpu* tl| / b0f` (jak-hd-physics.gc:3787) et `*phys-cpu*` est un
    ;; CUMUL : remis a zero une fois par frame (:3121), puis incremente a CHAQUE evenement de
    ;; contact (:1810-1812) pendant les 45 balayages de la frame (15 appels a `phys-collide-chain`,
    ;; `sweeps = 3` chacun). Inverse, la mesure du cycle 35 vaut |cpu| = 17 899 u (chestL) et
    ;; 20 435 u (chestR), soit 4.4 et 5.0 METRES de poussee cumulee en UNE frame — pour une
    ;; penetration mesuree de 390 u et 374 u. Le rapport vaut 45.9 et 54.7, et il y a 45 balayages.
    ;; CES CINQ CHIFFRES SEPARENT TROIS HYPOTHESES QU'UN SEUL SCALAIRE CONFOND :
    ;;   npf   NATURE un COMPTE d'evenements de poussee, sans unite.
    ;;   pmax  NATURE une LONGUEUR (u de jeu, 4096 = 1 m) : le plus GRAND evenement SEUL.
    ;;   psum  NATURE une LONGUEUR (u) : somme des MODULES — a distinguer de `cl`, qui est le
    ;;         module de leur somme VECTORIELLE. `psum >> cl` = des poussees qui s'annulent, donc
    ;;         deux volumes qui se disputent le lien ; `psum ~ cl` = la meme poussee repetee.
    ;;   lsw   NATURE un ORDINAL de balayage, 1 a 45 : le DERNIER ou une poussee a encore tire.
    ;;         Si la boucle convergeait, il serait petit ; a 45 elle ne converge pas.
    ;;   dom   NATURE un COMPTE de frames ou une poussee a eu lieu sur le maillon pointe — LE
    ;;         DOMAINE. Sans lui, un zero sur les quatre autres serait un zero de domaine vide.
    ;; REPERE : le MONDE pour les longueurs (la poussee est ecrite en monde, :1810-1812).
    ;; LES QUATRE PREMIERES SONT RELEVEES A L'ARGMAX DE `cl`, PAS EN MAXIMA INDEPENDANTS — c'est la
    ;; lecon N3/N4 du cycle 35 : deux maxima de fenetre pris sur des grandeurs differentes ne se
    ;; comparent pas, parce que l'argmax n'est pas la meme frame.
    ;; LECTURE HORS DEFAUT : npf = pmax = psum = lsw = 0 quand rien ne touche.
    ;; Deux lignes parce que `format` est cape a six parametres apres la chaine.
    (format 0 "PHYSSHAPE7 c=~D a=~D d=~D npf=~f pmax=~f psum=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 25)
            (phys-shape (-> self slot) c 26)
            (phys-shape (-> self slot) c 27))
    (format 0 "PHYSSHAPE8 c=~D a=~D d=~D lsw=~f dom=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 28)
            (phys-shape (-> self slot) c 32))
    ;; ---- CYCLE 37 ETAPE 1 : LA BOUCLE DE CONTRAINTES CONVERGE-T-ELLE ? ----------------------
    ;; `lsw = 45/45`, mesure au cycle 36, compte le dernier balayage ou une poussee est NON NULLE.
    ;; Il ne dit RIEN de son AMPLITUDE — une boucle qui converge proprement peut rendre 45/45 avec
    ;; une derniere poussee de 0.01 u. J'en avais quand meme conclu « la boucle ne converge pas » en
    ;; tete du rapport du cycle 36 : c'est un compteur d'evenements lu comme une amplitude, et ces
    ;; trois grandeurs-ci tranchent.
    ;;   slast  NATURE une LONGUEUR (u de jeu, 4096 = 1 m) : somme des MODULES des poussees du
    ;;          GROUPE DE COLLISION SEULE (balayages 34 a 45, appels 12 a 15 — ce groupe n'a AUCUNE
    ;;          contrainte de longueur pour ramener le lien en arriere). `slast/psum` proche de zero
    ;;          = la boucle converge ; comparable a 12/45 = 0.267 = elle ne converge pas.
    ;;   nlast  NATURE un COMPTE d'evenements dans ce meme groupe. C'est le DOMAINE de `slast` :
    ;;          sans lui, `slast = 0` ne se distingue pas d'un groupe qui n'a pas tourne.
    ;;   p1     NATURE une LONGUEUR (u) : le module de la PREMIERE poussee de la frame. Elle dit ce
    ;;          qu'UNE projection accomplit, a comparer a la penetration RESIDUELLE apres les 45.
    ;; REPERE : le MONDE (la poussee est ecrite en monde, jak-hd-physics.gc:1810-1812).
    ;; RELEVEES A L'ARGMAX DE `cl`, comme les quatre precedentes — pas en maxima independants.
    ;; LECTURE HORS DEFAUT : les trois a zero quand rien ne touche.
    (format 0 "PHYSSHAPE9 c=~D a=~D d=~D slast=~f nlast=~f p1=~f~%"
            c (-> self ai) (-> self drive)
            (phys-shape (-> self slot) c 29)
            (phys-shape (-> self slot) c 30)
            (phys-shape (-> self slot) c 31))
    ;; §23/§22 — L'ELONGATION DU TISSU PORTEE PAR LE DEGRE DE LIBERTE RADIAL, sur cette fenetre.
    ;; Elle se lit CONTRE SA PROPRE BANDE, qui n'est pas celle de l'apex : « local tissue
    ;; elongation: common 5-15 %, large 15-21 %, exceptional 21-25 %, absolute clamp 25 % ».
    ;; `rrm` est le maximum de |elongation|/B0 sur la fenetre, `rr` sa valeur a l'instant de la
    ;; publication — les deux, parce qu'un maximum seul ne dit pas si l'oscillateur est encore
    ;; vivant a la fin de la fenetre ou s'il s'est eteint.
    ;; NATURE : deformation sans unite. REPERE : axe de l'os, triedre de l'ancre.
    ;; LIGNE DE BASE : 0.0 exactement au repos debout (§9).
    ;; `rrr` EST LE MEME MAXIMUM AVANT LA BORNE §22, et `sat` le nombre de frames ou elle a mordu.
    ;; Sans ces deux champs, un canal COLLE a sa borne rend le meme `rrm` qu'un canal qui l'effleure
    ;; — et c'est precisement cette confusion qui a laisse le canal de deformation atteindre son
    ;; plafond absolu sur LES DIX fenetres sans qu'aucune ligne ne le dise. Un limiteur qui mord en
    ;; permanence ne borne plus une mesure, il la remplace.
    ;; DEUX LIGNES, et ce n'est pas un choix de style : `format` de GOAL est cape a huit parametres
    ;; (meme raison qu'a `PHYSREST` ci-dessous, et la premiere ecriture de ce bloc l'a appris en
    ;; refusant de compiler). `sat` part donc sur sa propre ligne, ce qui tombe bien : c'est un
    ;; compteur GLOBAL au solveur, pas une grandeur par chaine.
    (format 0 "PHYSRAD c=~D a=~D d=~D rr=~f rrm=~f rrr=~f~%"
            c (-> self ai) (-> self drive)
            (phys-chain-radial (-> self slot) c 1)
            (phys-chain-radial (-> self slot) c 2)
            (phys-chain-radial (-> self slot) c 3))
    (format 0 "PHYSRADSAT c=~D d=~D sat=~f~%"
            c (-> self drive)
            (phys-chain-radial (-> self slot) c 4))
    ;; ---- LES MEMES TROIS, PAR MAILLON (cycle 33) -------------------------------------------
    ;; NATURE : deux maximums de FENETRE d'une DEFORMATION rapportee a B0 (§6), plus un COMPTE de
    ;;   frames — pas une amplitude agregee, pas une variance.
    ;; REPERE : l'axe de l'os du MAILLON, dans le triedre de l'ANCRE (§7).
    ;; ABSENT : 0.0 sur les trois quand le maillon n'a pas de degre de liberte radial arme — c'est
    ;;   exactement ce que lisait le maillon distal avant le cycle 32.
    ;; POURQUOI ELLE EXISTE : `rrr` publie par `PHYSRAD` est un maximum SUR LA CHAINE. Il vaut
    ;;   1.42 B0 pour un plafond de 0.40 sans dire QUEL maillon sature, et les deux remedes
    ;;   candidats de §22 (borne par maillon, ou raideur radiale du distal) sont indiscernables
    ;;   tant qu'on ne le sait pas. Un agregat par chaine qui cache une verite par maillon est le
    ;;   defaut exact que le cycle 31 a corrige sur `PHYSRINGCX`.
    (dotimes (l (phys-chain-links (-> self slot) c))
      (format 0 "PHYSRADL c=~D d=~D l=~D rrm=~f rrr=~f sat=~f~%"
              c (-> self drive) l
              (phys-chain-radial-link (-> self slot) c l 2)
              (phys-chain-radial-link (-> self slot) c l 3)
              (phys-chain-radial-link (-> self slot) c l 4)))
    ;; ---- LA DECOMPOSITION EXACTE DE `rrr`, PAR MAILLON (cycle 33 etape 2) -------------------
    ;; NATURE : deux LONGUEURS SIGNEES rapportees a B0 (§6), relevees A LA FRAME DE L'ARGMAX de
    ;;   `rrr` — pas deux maximums independants : le maximum d'une somme n'est pas la somme des
    ;;   maximums, et deux agregats separes ne se recomposeraient pas.
    ;; REPERE : l'axe de l'os du maillon (m^), le MEME que `rrr`. Aucun changement de repere.
    ;; ABSENT : `mlb` = 0.0000 exactement si la contrainte de longueur etait deja tenue a la
    ;;   mesure ; `cdev` = 0.0000 exactement a la premiere frame (amorcage cp := px, §9).
    ;; POURQUOI ELLE EXISTE : `dr0 = dot(cp-a,m^) - bl` melange DEUX choses que le cycle 33
    ;;   etape 1 n'a pas separees — l'os qui n'est pas encore sur sa sphere (`phys-length-chain`
    ;;   tourne APRES cette mesure) et la chair qui depasse la pointe. `mlb + cdev = rrr` au
    ;;   signe pres est une IDENTITE : si la course ne la verifie pas, l'instrument est faux.
    (dotimes (l (phys-chain-links (-> self slot) c))
      (format 0 "PHYSRADLD c=~D d=~D l=~D mlb=~f cdev=~f~%"
              c (-> self drive) l
              (phys-chain-radial-link (-> self slot) c l 5)
              (phys-chain-radial-link (-> self slot) c l 6)))
    ;; LA SCISSION DE `cdev`, CYCLE 34 — `cdev` melange encore DEUX choses (identite [NOTE-84]) :
    ;;     cdev = dot(cp - tg, m^)  +  dot(tg - px, m^)
    ;;            \_____ ctg _____/     \_ par soustraction _/
    ;;             (C) le point LIBRE     (D) la CONTRAINTE ecarte
    ;;             n'a pas rejoint SA     l'OS de SA cible
    ;;             cible
    ;; NATURE : `ctg` est une LONGUEUR SIGNEE / B0 (§6), `cdd` la NORME du MEME ecart. Les deux
    ;;   relevees A LA FRAME DE L'ARGMAX de `rrr` — les memes que `mlb`/`cdev` ci-dessus, jamais
    ;;   des maximums independants (max(a+b) != max(a)+max(b)).
    ;; REPERE : `ctg` sur l'axe de l'os `m^`, le MEME que `rrr`, `mlb` et `cdev`. `cdd` est une
    ;;   norme, donc sans repere. Monde, meme frame, meme `b0e`.
    ;; ABSENT : les deux valent 0.0000 EXACTEMENT a la premiere frame de la fenetre (amorcage
    ;;   `cp := px` et `tg` construit sur la meme pose), et `cdd` = 0 si le point libre est SUR sa
    ;;   cible. Un zero est donc un etat neutre, pas un trou de mesure.
    ;; CONTROLE D'INTEGRITE, ET IL N'EST PAS TAUTOLOGIQUE : |ctg| <= cdd. Les deux membres sont
    ;;   calcules par des chemins DIFFERENTS (produit scalaire contre racine de somme de carres).
    ;; DEUX LIGNES et non une : `format` de GOAL est cape a huit parametres, destination comprise.
    (dotimes (l (phys-chain-links (-> self slot) c))
      (format 0 "PHYSRADLE c=~D d=~D l=~D ctg=~f cdd=~f~%"
              c (-> self drive) l
              (phys-chain-radial-link (-> self slot) c l 7)
              (phys-chain-radial-link (-> self slot) c l 8)))))
  ;; SPEC 33/34 — LA RESTITUTION SUR CETTE FENETRE. Une ligne par fenetre, pas par chaine : les
  ;; compteurs sont globaux au solveur. `n` est le DOMAINE (contacts ou elle a mordu) ; sans lui,
  ;; `vin`/`vout` a zero ne distinguent pas « rien ne touche » de « rien ne s'applique ».
  ;; `m` = sorties effectivement RELUES a la frame suivante ; `esum/n` = le melange 0.06 / 0.02.
  ;; DEUX LIGNES, et ce n'est pas un choix de style : `format` de GOAL est cape a huit parametres,
  ;; destination et chaine comprises.
  (format 0 "PHYSREST a=~D d=~D n=~f m=~f vin=~f~%"
          (-> self ai) (-> self drive)
          (phys-rest 0) (phys-rest 4) (phys-rest 1))
  ;; `twsat` = les frames ou la saturation douce de la torsion (SPEC 29, bornee par l'enveloppe
  ;; d'apex de SPEC 38) a mordu. Un limiteur sans compteur est precisement ce que le contrat
  ;; interdit ; celui-ci publie combien de fois il agit, a cote de l'amplitude qu'il borne.
  (format 0 "PHYSREST2 a=~D d=~D vout=~f esum=~f twsat=~f~%"
          (-> self ai) (-> self drive)
          (phys-rest 2) (phys-rest 3)
          (phys-shape (-> self slot) 0 18))
  ;; LA FENETRE DE `comex` SE FERME ICI, ET SEULEMENT LA SIENNE. `phys-comexw-reset!` ne touche que
  ;; l'emplacement 23 : le maximum de COURSE (19) et la distribution cumulee (20/21/22) traversent
  ;; les fenetres, c'est leur portee. Un `phys-diag-reset!` ici les detruirait tous les quatre.
  (phys-comexw-reset!)
  (none))

;; ------------------------------------------------------------------------------------------------
;; L'ENREGISTREMENT DE POSE, ETIQUETE — L'EMETTEUR UNIQUE (cycle 67).
;;
;; POURQUOI. Le superviseur a grave le 2026-08-21 a 01:20 que toute ligne publiant une comparaison
;; GAUCHE/DROITE doit porter, sur la meme ligne, l'ecart au miroir de la pose ou elle a ete relevee,
;; et que le correctif se pose AU PRODUCTEUR. Or le producteur du tableau ne peut calculer cet ecart
;; que si la salle a ENREGISTRE la pose au point de protocole de la phase. Quatre phases le font
;; deja, chacune avec sa propre etiquette recopiee a la main (`PHYSREGB`, `PHYSREGSB`, `PHYSSYMB`,
;; `PHYSSGNB`) ; les autres ne le font pas du tout, et leurs lignes gauche/droite etaient donc
;; publiees sans que personne puisse dire dans quelle pose — `ROOM-GRAVSAG-MIRROR` (x1.18 entre les
;; deux seins) et `ROOM-SPEC7-MIROIR` en sont deux.
;;
;; UN SEUL EMETTEUR, ETIQUETE, pour que la prochaine phase n'ait pas a recopier six lignes de
;; `format` — c'est la recopie qui a produit le trou. NATURE : une direction UNITAIRE, sans
;; dimension, par (chaine, maillon). REPERE : le MONDE. LECTURE QUAND LE DEFAUT EST ABSENT : le rig
;; est miroir a 0.005 deg en pose de bind (cycle 53), donc deux directions exactement opposees par
;; la reflexion laterale. LECTURE PURE : `phys-chain-bone` n'ecrit rien.
(defbehavior physroom-emit-poseb phys-subject ((tag string))
  (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
    (when hd
      (dotimes (c (-> self nchain))
       (when (> (phys-chain-links (-> self slot) c) 0)
        (dotimes (l (phys-chain-links (-> self slot) c))
          (format 0 "PHYSPOSETAG tag=~S c=~D l=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                  tag c l
                  (phys-chain-bone hd (-> self slot) c l 0)
                  (phys-chain-bone hd (-> self slot) c l 1)
                  (phys-chain-bone hd (-> self slot) c l 2)))))))
  (none))

;; POSITION MOYENNE de la pointe dans le repere de l'ancre, axe par axe. Une ligne a part parce que
;; `format` est cape a six parametres et que ces trois-la doivent rester solidaires du tag.
(defbehavior physroom-emit-mean phys-subject ((tag string))
  (dotimes (c (-> self nchain))
    (when (> (phys-chain-links (-> self slot) c) 0)
      (format 0 "PHYSMEAN tag=~S c=~D x=~f y=~f z=~f~%"
              tag c
              (phys-tip-mean (-> self slot) c 0)
              (phys-tip-mean (-> self slot) c 1)
              (phys-tip-mean (-> self slot) c 2))
      ;; LE STIMULUS GRAVITAIRE DE LA MEME FENETRE, a cote de la reponse. Un affaissement nul avec
      ;; gn=0 dit « la gravite n'est pas arrivee » ; avec gn=1.0 et tf~0 il dit « elle est arrivee et
      ;; la geometrie de l'os l'annule » ; avec gn=1.0 et tf~1 il dit « la chaine n'y repond pas ».
      ;; Trois diagnostics differents que le seul `sag` confondait.
      (format 0 "PHYSGRAV tag=~S c=~D gn=~f tf=~f~%"
              tag c
              (phys-stat (-> self slot) c 18)
              (phys-stat (-> self slot) c 19))))
  ;; LA POSE DE CETTE FENETRE, SOUS LE MEME TAG. `ROOM-GRAVSAG-MIRROR` compare le `sag` des deux
  ;; seins : sans cette ligne, son rapport ne peut pas dire s'il decrit le personnage ou la pose.
  (physroom-emit-poseb tag)
  (none))

(defbehavior physroom-emit-diag phys-subject ((tag string))
  "LES QUATRE DEFAUTS DE LA 6e PASSE, CHAINE PAR CHAINE. Un total global ne dit pas si ce sont les
   meches fines qui jittent ou les sangles de cheville : ces compteurs-la sont par chaine.
     selfcol  corrections venues d'un volume porte par les PROPRES joints de la chaine — ZERO
     flip     paires (lien, volume) ayant change d'etat de contrainte d'une frame a l'autre : la
              mesure du jitter lui-meme
     inv      inversions corrigees / invres inversions RESIDUELLES — ZERO
     elong    pire allongement RELATIF d'un lien (|l/l0 - 1|) — « les seins s'allongent »"
  (dotimes (c (-> self nchain))
    (when (> (phys-chain-links (-> self slot) c) 0)
      ;; CYCLE 36 : `retreat=` EST PARTI D'ICI, ET CE N'EST PAS UN DE-SCOPE. L'emplacement 1 de
      ;; `*phys-dg*` n'a AUCUN ecrivain dans le moteur (`grep "PHYS-DG) 1)"` : vide) depuis le
      ;; retrait de `phys-retreat-chain` le 2026-08-13, dont NOTE-93 est la pierre tombale. Ce
      ;; champ publiait donc un zero qu'aucun chemin de code ne pouvait faire monter — un zero de
      ;; domaine VIDE, pas une mesure. On ne l'arme pas (ce serait remettre la fonction que la
      ;; pierre tombale interdit) : on cesse de le publier.
      (format 0 "PHYSDIAG tag=~S c=~D selfcol=~f flip=~f~%"
              tag c
              (phys-diag (-> self slot) c 0)
              (phys-diag (-> self slot) c 2))
      ;; ---- PHYSSTGT — LES SEPT ETAGES DE LA BORNE DE SPEC 22, MAIS PAR JAMBE (cycle 75) ----
      ;; Meme grandeur, meme latch et memes limites que `PHYSSTG` ([NOTE-340], et sa limite de
      ;; DISCRIMINATION vaut ici aussi) : `|p_rlk - pose auteur| / B0`, sept instants d'UNE MEME
      ;; frame, celle qui maximise l'etage 6 DEPUIS LA DERNIERE REMISE A ZERO DU DIAGNOSTIC.
      ;; Ce que ce `tag` ajoute : les jambes `skin-armed` et `skin-disarmed` balayent les MEMES
      ;; 31 animations avec le MEME pilotage et pour SEULE variable `*phys-skin-off*`. Le cout de
      ;; la contrainte de peau sur la §22 se lit donc sur la MEME population que le benefice que
      ;; `ROOM-SKINPEN-CONTROL` publie sur elle — au lieu d'un rapport entre deux populations,
      ;; qui est le defaut que ce dossier traque depuis le cycle 34.
      ;; CONTROLE GRATUIT : sur `skin-disarmed`, `phys-skin-chain` sort en tete de fonction, donc
      ;; l'etage 6 doit valoir l'etage 5 AU BIT. S'il ne le vaut pas, l'interrupteur ne desarme
      ;; pas ce que je crois, ou la sonde ne lit pas ce que je crois.
      (dotimes (st 7)
        (format 0 "PHYSSTGT tag=~S c=~D st=~D jt=~f~%"
                tag c st (phys-diag (-> self slot) c (+ 72 st))))
      (format 0 "PHYSDIAG2 tag=~S c=~D inv=~f invres=~f elong=~f rad=~f~%"
              tag c
              (phys-diag (-> self slot) c 3)
              (phys-diag (-> self slot) c 4)
              (phys-diag (-> self slot) c 5)
              (phys-diag (-> self slot) c 6))
      ;; LES TROIS DEFAUTS DE LA 11e PASSE, chaine par chaine, chacun avec sa NATURE ecrite a cote
      ;; de lui parce qu'un chiffre sans nature est ce qui a produit les faux verts de la veille :
      ;;   bendcut  DEGRES retires par l'attenuation d'angle des CHEVEUX (un suppresseur, donc il
      ;;            se chiffre). Repere : l'attache du maillon. Zero quand la meche ne se replie
      ;;            jamais au-dela de la limite que le rig lui donne.
      ;;   shape    |p - T| / longueur de l'os, SANS DIMENSION : l'echelle de la deformation que le
      ;;            skinning lineaire impose a la chair. C'est « ca change de taille, plus petit,
      ;;            plus gros, ecrase ». Zero quand le maillon est a sa pose de modele.
      ;;   buried   paires (lien, volume) ou le lien est ENTIEREMENT dans un volume A SA POSE DE
      ;;            MODELE, comptees une fois par frame : un pan dont la pose est DANS la jambe n'a
      ;;            aucune surface a traverser, donc meshpen reste a zero pendant que l'owner le
      ;;            voit disparaitre (« comme si son pantacourt s'arretait aux genoux »). Zero
      ;;            quand la piece est dehors, la ou elle se voit.
      (format 0 "PHYSDIAG3 tag=~S c=~D bendcut=~f shape=~f buried=~f tiprot=~f~%"
              tag c
              (phys-diag (-> self slot) c 7)
              (phys-diag (-> self slot) c 8)
              (phys-diag (-> self slot) c 9)
              (phys-diag (-> self slot) c 10))
      ;;   side     paires (lien, volume) ou le lien est passe du COTE OPPOSE de l'axe du volume
      ;;            dans lequel sa pose de modele se trouvait. C'est ROOM-SIDE, reclame par les
      ;;            DIRECTIVES depuis la 11e passe et jamais ecrit jusqu'ici. Aucune autre colonne
      ;;            ne peut voir ce defaut : la profondeur de penetration est MAXIMALE sur l'axe et
      ;;            REDESCEND quand le lien ressort de l'autre cote, donc un lien qui a traverse de
      ;;            part en part rend une profondeur faible, indistinguable d'un lien sagement
      ;;            dehors. NATURE : un compte de paires (un changement de COTE est discret, une
      ;;            distance ne peut pas le decrire). REPERE : celui du VOLUME — direction du point
      ;;            le plus proche de son axe vers le lien, comparee entre la pose du modele et
      ;;            maintenant. LECTURE QUAND LE DEFAUT EST ABSENT : 0.
      (format 0 "PHYSDIAG4 tag=~S c=~D side=~f~%"
              tag c
              (phys-diag (-> self slot) c 11))
      ;;   volprio  paires (lien, volume) que la DECISION 1 a ECARTEES parce qu'un autre volume
      ;;            decidait deja pour ce lien cette frame. C'est le seul chiffre qui dise OU les
      ;;            volumes se contredisent, et il manquait : `ROOM-INVERSIONS residual=379`
      ;;            n'etait attribuable a aucune chaine. Une chaine dont ce compte est GRAND est
      ;;            une chaine que des volumes se disputaient, donc que le recul epinglait
      ;;            (kneeflapR : retreat 15913 frames sur 17893).
      ;;            NATURE : un compte de paires sur la fenetre. REPERE : sans objet.
      ;;            LECTURE QUAND LE DEFAUT EST ABSENT : 0 — aucun conflit, personne n'est ecarte.
      (format 0 "PHYSDIAG5 tag=~S c=~D volprio=~f~%"
              tag c
              (phys-diag (-> self slot) c 12))
      ;;   worstvol L'ARGMAX DE `pen`, ET IL MANQUAIT. `pen` ne publiait qu'un maximum : on savait
      ;;            COMBIEN, jamais CONTRE QUOI. `res` = le pire residu de la fenetre (u de jeu,
      ;;            franchise de pose d'auteur deduite), `ci` = l'indice du volume qui le porte
      ;;            dans l'ordre de `ROOM-COLLIDER-COVERAGE`. NATURE : une distance signee et un
      ;;            INDICE, pas une moyenne. REPERE : celui du volume. LECTURE HORS DEFAUT :
      ;;            res <= 0 et ci sans objet.
      (format 0 "PHYSDIAG6 tag=~S c=~D worstres=~f worstci=~f~%"
              tag c
              (phys-diag (-> self slot) c 17)
              (phys-diag (-> self slot) c 18))
      ;;   skinpen  (SPEC 18) la pire entree du lien SOUS LA VRAIE PEAU, en unites de jeu. A lire
      ;;            A COTE de `pen` : `pen` mesure contre les VOLUMES, qui ne representent que
      ;;            29.7 % de la geometrie pilotee (mesure du 2026-08-13, probe_skin_in_volume.py),
      ;;            et 0 % pour backhair et les deux pantflap. Un zero de `pen` ne dit donc rien
      ;;            de ce que l'owner voit ; `skinpen` mesure la meme position contre le mesh qui
      ;;            est DESSINE. NATURE : profondeur signee, positive = sous la peau. REPERE : le
      ;;            monde, a la frame ecrite. LECTURE HORS DEFAUT : 0.
      ;;            `tests` = echantillons reellement compares. Un skinpen nul avec tests=0 veut
      ;;            dire « je n'ai pas regarde » et se lit comme tel, jamais comme « rien ne passe ».
      ;;   skinadd  [NOTE-150] la profondeur AJOUTEE sous cette meme peau par la PHYSIQUE :
      ;;            `sd(point d'auteur) - sd(point simule)`, MEME frame, MEME surface, MEME lien.
      ;;            `skinpen` mesure l'ANATOMIE (l'os de poitrine est interieur par construction) ;
      ;;            celle-ci retranche cet offset EXACTEMENT au lieu de l'estimer sur une autre
      ;;            fenetre. NATURE : une longueur, max de fenetre. REPERE : le monde, frame ecrite.
      ;;            LECTURE HORS DEFAUT : 0.0000 — et la pose d'auteur la rend AU BIT.
      (format 0 "PHYSSKIN tag=~S c=~D skinpen=~f skinadd=~f tests=~D~%"
              tag c (phys-skinpen-worst (-> self slot) c)
              (phys-skinadd-worst (-> self slot) c) (phys-skintest-count))
      ;;   skinrest [NOTE-154] LA LIGNE DE BASE AU REPOS que l'arbitrage du 2026-08-20 13:20 exige :
      ;;            la profondeur sous la MEME peau du point que L'AUTEUR a dessine. « Physique
      ;;            desarmee » au sens exact — la pose d'auteur EST la pose sans physique — et prise
      ;;            A LA MEME FRAME, donc sans le piege `ratio-of-two-statistics` qu'une fenetre de
      ;;            repos separee aurait introduit. NATURE : une longueur, max de fenetre.
      ;;   skinout  COMBIEN DE FOIS LE POINT D'AUTEUR A ETE LU **DEHORS**. CETTE LEGENDE ETAIT
      ;;            PERIMEE et je la corrige au lieu de la laisser : elle datait de l'epoque ou la
      ;;            grandeur portait sur le JOINT, interieur par construction du rig, et disait donc
      ;;            « toute lecture positive est anatomiquement impossible ». Depuis [NOTE-161] elle
      ;;            porte sur un SOMMET EXTREMAL DE PEAU, pour lequel etre DEHORS est la DEFINITION
      ;;            meme d'un point de surface. Ce compte est un DOMAINE, pas une alarme, et le
      ;;            faire servir de motif de rejet etait un faux rouge. LECTURE SAINE : > 0.
      ;;   skinmiss [NOTE-157] combien d'evaluations n'ont trouve AUCUN echantillon a portee. Un
      ;;            `skinpen` de 0 avec un `skinmiss` non nul n'est pas « le lien est dehors »,
      ;;            c'est « je n'ai pas regarde » — et les deux ne doivent jamais se confondre.
      ;; [NOTE-158] LA COUVERTURE DE LA PEAU, PUBLIEE. Une troncature silencieuse est un de-scope :
      ;; tant que ce couple n'etait pas dans le tableau, `sets=64/92` vivait dans une ligne de log
      ;; que personne ne rapprochait de `skinpen`.
      ;; `chain=` EST NEUF ET IL FAUT LE LIRE AVEC `sets=`. Depuis le cycle 62 la famille `bs`
      ;; porte DEUX populations : les os de CORPS, comptes par `sets=`, et les os de CHAINE,
      ;; comptes par `chain=`. `declared=` compte les deux. Sans ce troisieme champ, la garde de
      ;; couverture lit `sets < declared` et conclut « 4 ensembles JETES par le plafond » alors
      ;; qu'ils sont RANGES AILLEURS EXPRES — c'est une garde dont la premisse a change, et une
      ;; garde qui garde la mauvaise premisse produit un faux rouge.
      (format 0 "PHYSBSURF sets=~D declared=~D max=~D chain=~D~%"
              (phys-bsurf-sets (-> self slot)) (phys-bsurf-declared (-> self slot)) PHYS-BSURF-MAX
              (phys-bsurf-chain-sets (-> self slot)))
      (format 0 "PHYSSKIN2 tag=~S c=~D skinrest=~f skinout=~D skinmiss=~f~%"
              tag c (phys-skinrest-worst (-> self slot) c) (phys-skinout-count)
              (phys-skinmiss-count (-> self slot) c))
      ;;   SPEC 33 — LA SURFACE MEDIALE DE L'AUTRE SEIN, ET SON DOMAINE.
      ;;   Sa 33 dit « medial surfaces shall collide or repel BEFORE visible interpenetration ».
      ;;   Jusqu'au cycle 62 le sein oppose etait exclu de TOUTE surface que le moteur lit
      ;;   (`physics_c14_meshsamples.py` excluait les os de chaine de `bs`), donc le DOMAINE de la
      ;;   section etait VIDE PAR CONSTRUCTION et aucune valeur ne pouvait rien en dire — ni un
      ;;   rouge, ni un vert. Les quatre colonnes ci-dessous sont le MEME calcul, les MEMES sommets
      ;;   et la MEME frame que `skinpen`/`skinrest` juste au-dessus : seule la SURFACE change.
      ;;   medgap  NATURE : distance SIGNEE minimale du sommet de peau a la surface de l'AUTRE
      ;;           sein, unites de jeu, positive = separees. REPERE : le monde, frame mesuree, les
      ;;           DEUX seins a leur position RESOLUE. LECTURE HORS DEFAUT : > 0.
      ;;   medgapa la MEME grandeur au point d'AUTEUR, les deux seins a leur pose d'auteur : c'est
      ;;           l'ecart que l'AUTEUR a dessine, donc la ligne de base « physique desarmee ».
      ;;   medpen / medrest : la pire PENETRATION (max de -sd) sur chaque colonne.
      ;;   medn    LE DOMAINE. `medn=0` veut dire « aucune lecture valide » et se lit comme tel,
      ;;           JAMAIS comme « aucune penetration » : c'est exactement la confusion que la
      ;;           section a subie pendant 62 cycles.
      ;;   far     LES LECTURES HORS DU SUPPORT DU NUAGE, comptees et publiees au lieu d'etre
      ;;           jetees en silence. `|sd| <= |p - q|` : une profondeur de 2618 u EXIGE que le
      ;;           plus proche echantillon soit a 64 cm, donc ce n'est pas une penetration, c'est
      ;;           un plan prolonge loin de la ou il a ete echantillonne. Ces lectures-la ne
      ;;           peuvent pas ecrire `pen`.
      ;;   space   L'ESPACEMENT MOYEN du nuage de l'autre sein, mesure sur la donnee LIVREE. Le
      ;;           rayon de support vaut 2 x cette valeur : aucune longueur n'est choisie a la
      ;;           main, et le rapport publie `far/n` dit combien la borne a exclu.
      (format 0 "PHYSMED tag=~S c=~D gap=~f gapa=~f pen=~f~%"
              tag c (phys-medial (-> self slot) c 0) (phys-medial (-> self slot) c 1)
              (phys-medial (-> self slot) c 2))
      (format 0 "PHYSMED2 tag=~S c=~D rest=~f n=~f far=~f space=~f~%"
              tag c (phys-medial (-> self slot) c 3) (phys-medial (-> self slot) c 4)
              (phys-medial (-> self slot) c 5) (phys-medial (-> self slot) c 6))
      ;;   frac / gapi : LE CONTROLE POSITIF DE SPEC 33, APPAIRE. Le meme point, dans la MEME
      ;;   frame, avance d'une FRACTION `frac` de son approche vers le plus proche echantillon de
      ;;   la surface opposee. La reponse attendue est une PREDICTION — `gapi = (1 - frac) x gap`,
      ;;   soit une BAISSE de `frac x gap` — et non un ratio a une ligne de base qui bouge
      ;;   (arbitrage du 2026-08-20 13:20). L'exces comme le defaut sont un echec.
      ;;   LE CHAMP A CHANGE DE NOM AU CYCLE 62, ET C'EST DELIBERE : il portait `inj=` en UNITES DE
      ;;   JEU, il porte maintenant une FRACTION SANS DIMENSION. Republier une grandeur de nature
      ;;   differente sous le MEME nom est la faute de l'echange de denominateur — un lecteur
      ;;   perime doit ECHOUER a lire, pas lire 0.5 comme 0.5 unite.
      (format 0 "PHYSMED3 tag=~S c=~D frac=~f gapi=~f~%"
              tag c (phys-med-inject-get) (phys-medial (-> self slot) c 7))
      ;;   rootrot  l'angle, EN DEGRES, reellement ecrit dans la 3x3 du maillon `rootlock` — le
      ;;            PREMIER SEGMENT de la meche, celui qui part du cuir chevelu. Il valait 0.0000
      ;;            structurellement jusqu'a ce cycle : la boucle d'ecriture du moteur sautait tout
      ;;            `l < rlk`, donc ~50 % de la geometrie des cheveux (earL 82/158, backhair
      ;;            167/320, lmidhair 212/383 ...) etait soudee au crane et une meche a 2 joints se
      ;;            reduisait a un segment rigide articule EN SON MILIEU. C'est le residu de
      ;;            `hair-gradient` que ROOM-GRADIENT ne pouvait pas voir : sur une chaine a 2
      ;;            maillons la suite publiee est [0, x], et une suite de deux termes dont le
      ;;            premier est nul ne peut JAMAIS echouer a un test de croissance — la gate y etait
      ;;            vide de sens, sur 5 des 7 chaines de cheveux.
      ;;            NATURE : un angle (une ORIENTATION ecrite, pas une amplitude ni une variance).
      ;;            REPERE : la direction d'os du joint, pose du modele -> position simulee de son
      ;;            enfant, prise depuis SON ANCRE — donc son mouvement PROPRE, pas celui herite du
      ;;            crane. LECTURE QUAND LE DEFAUT EST PRESENT : 0.0000 exactement.
      ;;   raddropm LE PRIX DU MUR DUR D'EXCURSION, en unites de jeu cumulees sur la fenetre :
      ;;            l'excursion que le plafond `rmax` a RETIREE a cette chaine. Le compte
      ;;            (`raddrop`, colonne voisine) disait combien de fois le mur mordait ; il ne
      ;;            disait pas ce qu'il coutait, et SPEC 7 l'exige de tout suppresseur (« on
      ;;            chiffre combien de mouvement il retire »). La somme existait deja dans le
      ;;            moteur mais GLOBALE, donc imputable a aucune chaine.
      ;;            NATURE : une longueur CUMULEE (une somme d'ecarts retires), surtout pas une
      ;;            amplitude — elle croit avec la duree de la fenetre et ne se compare qu'entre
      ;;            chaines d'une MEME course. REPERE : ecart a la pose ANIMEE du lien, le meme
      ;;            que celui que le mur plafonne. LECTURE QUAND LE DEFAUT EST ABSENT : 0, et le
      ;;            mur n'a alors jamais mordu.
      ;; `offdrift` — CYCLE 59. De combien le DECALAGE DU VOLUME (`offs`) a tourne entre l'ENTREE
      ;; et la SORTIE de `phys-collide-chain`, en unites de jeu, maximum de fenetre. Le solveur
      ;; calcule `offs` UNE FOIS sur la direction d'entree du lien et pousse `joint + offs` pendant
      ;; 3 balayages et 4 tours de finition sans jamais le recalculer ; `phys-link-pen`, lui, le
      ;; recalcule sur la position de SORTIE. Cette colonne dit si les deux parlent du meme point.
      ;;   NATURE  : une LONGUEUR (4096 u = 1 m), maximum de fenetre. Ni un angle ni un compte.
      ;;   REPERE  : monde, a la frame resolue — celui de `offs`.
      ;;   ABSENT  : 0.0000, la direction du lien n'a pas bouge pendant la resolution.
      ;;   CONTROLE: `*phys-col-off*` desarme le mur, donc plus aucune poussee, donc `offdrift`
      ;;             doit tomber au bruit de la seule contrainte de longueur.
      (format 0 "PHYSDIAG6 tag=~S c=~D offdrift=~f~%" tag c (phys-diag (-> self slot) c 16))
      (format 0 "PHYSDIAG6 tag=~S c=~D rootrot=~f raddropm=~f~%"
              tag c
              (phys-diag (-> self slot) c 14)
              (phys-diag (-> self slot) c 15))
      ;;   retfblen OU S'ALLONGE L'OS, ET DE COMBIEN — l'ATTRIBUTION de `elong` a un chemin precis.
      ;;            `elong` (PHYSDIAG2) dit qu'une chaine s'allonge, jamais OU. Cette colonne compte
      ;;            l'erreur de longueur laissee par LE REPLI de `phys-retreat-chain` : quand la
      ;;            sphere du modele est entierement fermee (aucune des 63 directions balayees n'est
      ;;            admissible), le repli garde `want = |auteur(kk) - attache SIMULEE|` au lieu de la
      ;;            longueur du modele, et c'est lui qui ecrit EN DERNIER dans la frame — l'os
      ;;            s'allonge donc d'exactement ce rapport.
      ;;            CE QUE LA MESURE A ETABLI (2026-08-13) : `retfblen` vaut 1.3163 sur `lmidhair` et
      ;;            1.2856 sur `rmidhair`, soit exactement leur `elong` de la meme course au
      ;;            dix-millieme, et 0.0000 sur les vingt autres chaines. Ce repli n'est donc pas UNE
      ;;            source de l'allongement, c'est LA source.
      ;;            ELLE N'EST PAS LE CONTROLE D'UN CORRECTIF : deux correctifs ont ete essayes a cet
      ;;            endroit le 2026-08-13 et la mesure les a REFUSES tous les deux (ils ramenaient
      ;;            STRETCH a 0.0003 en faisant monter `meshpen` a 0.2238 puis 0.2726 m et `ROOM-SIDE`
      ;;            a 1056 puis 1089 — regle 6). Le detail est dans `jak-hd-physics.gc`, meme branche.
      ;;            NATURE : un rapport sans dimension, |want/ml - 1| — un MAXIMUM sur la fenetre,
      ;;            pas un cumul. REPERE : aucun, une longueur sur une longueur prises depuis la
      ;;            meme attache. LECTURE QUAND LE DEFAUT EST ABSENT : 0, et le repli n'a alors
      ;;            jamais tire sur cette chaine.
      ;; CYCLE 36 : `PHYSDIAG7` EST RETIREE EN ENTIER. Elle ne portait que `retfblen`
      ;; (emplacement 16 de `*phys-dg*`), qui n'a lui non plus AUCUN ecrivain depuis le retrait de
      ;; `phys-retreat-chain`. Le raisonnement ci-dessus reste ecrit : il dit ce que cette grandeur
      ;; MESURERAIT si le repli existait, et il faudra le relire si un jour il revient.
      ;;   comex    SPEC 22 — L'EXCURSION DU CENTRE DE CHAIR, EN B0. Sa §22 borne le COM (« normal
      ;;            <= 35 % B0, hard transient <= 40 % B0 ») ET l'apex (42 % / 50 %). Le moteur
      ;;            borne le JOINT avec la bande de l'APEX et le CANAL RADIAL avec la bande du COM :
      ;;            aucune des deux grandeurs bornees n'EST le centre de masse de la chair. Cette
      ;;            colonne est la premiere mesure de la grandeur que sa borne de COM nomme.
      ;;            Elle est prise sur le centroide MESURE de la geometrie que le joint possede,
      ;;            transporte par la matrice ECRITE (rotation + deformation de §8/§10-13) et
      ;;            compare a la matrice d'AUTEUR de la meme frame — donc deformation COMPRISE,
      ;;            comme le cycle 27 l'a etabli pour le COM des §10-12.
      ;;            NATURE : une LONGUEUR rapportee a B0, MAXIMUM sur la fenetre (pas un cumul,
      ;;            pas une variance). REPERE : le monde, a la frame ecrite, contre la pose
      ;;            d'auteur de la MEME frame. LECTURE A LA POSE D'AUTEUR : 0.0000.
      ;;   comsum / comn / comhi — LA DISTRIBUTION, PARCE QU'UN MAXIMUM NE DIT PAS SI UNE BORNE
      ;;            CLIPERAIT UN EXTREME OU MUSELLERAIT LA REPONSE. `comsum/comn` rend la moyenne,
      ;;            `comhi/comn` la part d'echantillons qui depassent deja le plafond DUR de sa
      ;;            §22 (0.40 B0) — donc la part que la borne mordrait si on la posait. C'est la
      ;;            seule grandeur qui separe un correctif d'un suppresseur, et son absence est
      ;;            precisement ce qui a fait echouer les deux tentatives de resserrement.
      ;;            NATURE : deux COMPTES et une SOMME, CUMULES sur la fenetre — ils croissent
      ;;            avec sa duree et ne se comparent qu'entre chaines d'une MEME course.
      (format 0 "PHYSDIAG8 tag=~S c=~D comex=~f comsum=~f comn=~f comhi=~f~%"
              tag c
              (phys-diag (-> self slot) c 19)
              (phys-diag (-> self slot) c 20)
              (phys-diag (-> self slot) c 21)
              (phys-diag (-> self slot) c 22))))
  ;; CLIQUET CORRIGE (cycle 60). `*phys-skinpen*` n'etait remis a zero QU'UNE FOIS (:2456) : les
  ;; huit tags emis apres `run` republiaient donc tous le meme maximum courant — 644.2134/638.9550
  ;; a l'identique sur la course du 13:04, huit fenetres qui affichaient la meme mesure. Un maximum
  ;; qui ne se remet pas a zero mange ses propres fenetres (registre : `ratchet-running-max`).
  ;; `run` est le PREMIER tag emis, donc sa valeur ne change pas : la correction ne touche que les
  ;; huit tags qui etaient faux.
  ;; [NOTE-241] CE QUE LA CONTRAINTE DE PEAU RETIRE, UNE FOIS PAR TAG. Un correctif qui enleve du
  ;; mouvement se CHIFFRE (SPEC 7). AGREGAT DE JAMBE et GLOBAL A LA COURSE : il n'est pas par
  ;; chaine, donc il ne se lit jamais comme une colonne par chaine (regle 7).
  ;; NATURE : un compte et deux longueurs (unites de jeu, 4096 = 1 m). REPERE : le monde.
  ;; LECTURE QUAND LA CONTRAINTE NE MORD PAS : les trois a zero.
  (format 0 "PHYSSKINC tag=~S n=~f sum=~f worst=~f reste=~f~%"
          tag (phys-skc 0) (phys-skc 1) (phys-skc 2) (phys-skc 3))
  ;; [NOTE-447] CE QUE LA BORNE DE SPEC 22 SUR LA VALEUR LIVREE A REPRIS, UNE FOIS PAR TAG.
  ;; C'est le pendant exact de `PHYSSKINC` : une borne qui enleve du mouvement se CHIFFRE (SPEC 7),
  ;; et celle-ci reprend a `phys-skin-chain` une part de ce que la ligne du dessus dit qu'elle a
  ;; achete. Les deux se lisent donc COTE A COTE, sur la MEME population, jamais separement.
  ;;   NATURE : un COMPTE (nombre de corrections) et une LONGUEUR CUMULEE rapportee a `B0`
  ;;            (SPEC 6, la CHAIR, 602,0 u) — PAS des unites de jeu, contrairement a `PHYSSKINC`.
  ;;   REPERE : le monde, contre la pose d'AUTEUR de la MEME frame rebasee sur l'ecart du parent.
  ;;   AGREGAT DE JAMBE, GLOBAL A LA COURSE : jamais une colonne par chaine (regle 7).
  ;;   LECTURE QUAND LA BORNE NE MORD PAS : les deux a zero — et desarmee (`*phys-e22-off*` = 1)
  ;;   elle DOIT rendre exactement 0, c'est son controle negatif.
  (format 0 "PHYSE22 tag=~S n=~f cut_b0=~f~%" tag (phys-skc 4) (phys-skc 5))
  (phys-skinpen-reset!)
  (none))

(defbehavior physroom-max-pen phys-subject ()
  (let ((m -1000000000.0))
    (dotimes (c (-> self nchain))
      (when (> (phys-chain-links (-> self slot) c) 0)
        (let ((p (phys-pen-col (-> self slot) c)))
          (when (> p m) (set! m p)))))
    m))

;; ------------------------------------------------------------------------------------------------
;; LE RAPPORT BRUT. Aucune conclusion ici : des nombres, et le script en fait un tableau. S'il
;; manque une preuve (un target apparu pendant la mesure), le nombre le dit et le script refuse
;; d'ecrire « joueur absent ».
;; ------------------------------------------------------------------------------------------------
;; L'AMPLITUDE DU STIMULUS de chaque pilotage, en unites de jeu par frame^2. C'est ce que la salle
;; COMMANDE, pas ce qu'elle observe : c'est le denominateur du gain de ROOM-RESPONSE. Sans lui,
;; comparer deux amplitudes de pointe obtenues sous deux stimuli differents ne veut rien dire — et
;; c'est precisement ce que faisait le tableau precedent.
;;   jerk    la vitesse est POSEE, pas accumulee : le stimulus est le pire saut de vitesse d'une
;;           frame a l'autre, (-240,0,190) -> (0,300,0), soit 434 u/frame^2.
;;   tilt    pose TENUE : plus aucune acceleration de repere. Le stimulus est la gravite elle-meme
;;           vue depuis l'ancre, 2 |g| sin(30 deg) = 11.16 u/frame^2 a 60 degres.
;; L'AMPLITUDE DU DEFAUT INJECTE PAR LE CONTROLE POSITIF, en unites de jeu. Elle est ECRITE ICI et
;; publiee telle quelle : le critere de l'arbitrage du 13:20 compare la hausse mesuree A CE NOMBRE,
;; donc le nombre ne peut pas etre ajuste apres coup sans que la comparaison le dise.
(defconstant PHYSROOM-INJECT 400.0)

(defun physroom-stim-mag ((mode int))
  (case mode
    ((0) 18.0)
    ((1) 52.0)
    ((2) 96.0)
    ((3) 434.0)
    (else 11.16)))

(defbehavior physroom-report phys-subject ()
  (dotimes (d PHYSROOM-DRIVES)
    (format 0 "PHYSSTIM dr=~D mag=~f~%" d (physroom-stim-mag d)))
  (format 0 "PHYSNOPLAY viol=~D actors=~D killed=~D~%"
          (-> self viol) (-> self nactor) (-> self killed))
  (format 0 "PHYSCOUNTS anims=~D enum=~D chains=~D drives=~D ags=~D~%"
          (-> self nanim) (-> self nenum) (-> self nchain) PHYSROOM-DRIVES (-> self nag))
  (format 0 "PHYSKEY maxanim=~D drives=~D slot=~D hdpid=~D win=~D~%"
          PHYSROOM-MAXANIM PHYSROOM-DRIVES (-> self slot) (-> self hdpid) PHYSROOM-WIN)
  ;; `inject` = l'amplitude REELLEMENT posee, en unites de jeu. L'arbitrage du 2026-08-20 13:20
  ;; remplace le ratio par une PREDICTION : injecter X doit faire monter la mesure de X a 25 % pres.
  ;; Sans cette valeur publiee, le critere n'a pas de X et retombe sur l'ancien ratio.
  ;; `armed`/`disarmed` = LA PAIRE a l'argmax de la reponse appariee ([NOTE-459]).
  ;; `armedmax`/`disarmedmax` = les deux anciens maxima latches independamment, conserves pour que
  ;; la comparaison avec les courses anterieures reste possible. Rien n'est retire.
  (format 0 "PHYSPC injections=~D armed=~f disarmed=~f inject=~f armedmax=~f disarmedmax=~f~%"
          (-> self injn) (-> self arm) (-> self dis) PHYSROOM-INJECT
          (-> self armx) (-> self disx))
  ;; L'UNITE DE `atan`, MESUREE A L'EXECUTION ET PAS DEDUITE D'UNE LECTURE DE SOURCE (regle 0).
  ;; L'ecriture d'orientation du moteur passait `(* 57.2957795 (atan sin cos))` a
  ;; `matrix-axis-angle!` — une conversion radians->degres. Si `atan` rend des UNITES DE ROTATION,
  ;; cette multiplication fait tourner l'os 57 fois trop et `sin` replie ensuite modulo un tour :
  ;; toute chaine qui flechit ecrit alors une orientation fausse, sans qu'aucun chiffre de POSITION
  ;; puisse le voir. Les trois nombres tranchent, et ils se lisent sans rien savoir du moteur :
  ;;   atan45   = (atan 1 1). 8192 => 65536 unites par tour ; 0.7854 => des radians.
  ;;   sinq     = (sin 8192). 0.7071 => 8192 vaut bien 45 degres dans l'unite qu'accepte `sin`,
  ;;              donc dans celle qu'accepte `matrix-axis-angle!`, qui l'appelle.
  ;;   bad      = ce que l'ancienne ligne aurait passe pour ce meme angle de 45 degres.
  (format 0 "PHYSUNITS atan45=~f sinq=~f bad=~f~%"
          (atan 1.0 1.0) (sin 8192.0) (* 57.2957795 (atan 1.0 1.0)))
  ;; LE GARDE-FOU DE PHASE, VERSION MESUREE (cycle 67). `maxvisited` est le plus haut numero de
  ;; phase que la course a REELLEMENT traverse ; `ok` vaut 1 seulement s'il est reste sous REPORT.
  ;; La ligne `PHYSROOM-PHASEGUARD` emise au demarrage reste, avec sa conjonction nommee : les deux
  ;; se lisent ensemble, et un desaccord entre elles designe une phase que la liste a oubliee.
  (format 0 "PHYSROOM-PHASEVISITED maxvisited=~D report=~D ok=~D~%"
          *physroom-maxvisited* PHYSROOM-PH-REPORT
          (if (< *physroom-maxvisited* PHYSROOM-PH-REPORT) 1 0))
  (format 0 "PHYSEND~%")
  (none))

;; ------------------------------------------------------------------------------------------------
;; SPEC 14 A 20 — LES PROFILS DE MOUVEMENT DES SEPT REGIMES.
;;
;; RIEN N'EST INTEGRE ICI, ET C'EST UNE CORRECTION DEJA PAYEE. La salle a mesure le 2026-08-11
;; qu'un pilotage integre derive jusqu'au garde-fou des +/- 3 m, lequel remet la vitesse a zero
;; D'UN COUP — un a-coup de plusieurs centaines d'unites au milieu de la fenetre de mesure. Les
;; profils ci-dessous sont POSES analytiquement : leur acceleration est exactement celle que le
;; bloc de constantes annonce, et le stimulus publie est celui que la chaine recoit vraiment.
;; ------------------------------------------------------------------------------------------------

(defun physroom-jump-y ((v0 float) (tp float) (tf float) (tl float) (vl float) (t float))
  "Hauteur du sujet le long d'un saut COMPLET — detente, vol balistique, reception — avec `t` en
   frames depuis le debut de la detente. `v0` vitesse de decollage (u/frame), `tp`/`tf`/`tl` les
   trois durees, `vl` le MODULE de la vitesse d'impact.

   NATURE : une longueur, unites de jeu, relative au point de depart. REPERE : monde, axe Y.
   LECTURE A t=0 : 0.0000 exactement.

   LA CONTINUITE C1 N'EST PAS UN DETAIL D'ESTHETIQUE. Une discontinuite de VITESSE serait un
   a-coup qu'on n'a pas commande et qui entrerait dans la mesure sous le nom du regime ; une
   discontinuite de POSITION declencherait le rebasement de discontinuite de sa §37 (« artificial
   transforms must not generate physical breast impulses »), qui AVALERAIT le regime entier et
   rendrait un zero qu'on lirait comme « pas de reponse ». Les deux raccords sont donc exacts :
   la detente arrive a `v0` avec une acceleration nulle, le vol repart de `v0`, la reception part
   de `-vl` et arrive a zero."
  (let ((yp (* 0.5 (* v0 tp))))
    (cond
      ;; DETENTE — demi-sinus d'acceleration : a(t) = A.sin(pi.t/tp), A = v0.pi/(2.tp).
      ;; L'integrale de a sur [0,tp] vaut exactement v0, donc le decollage se fait a la vitesse
      ;; annoncee et pas a une vitesse qui depend du pas d'integration.
      ((< t tp)
       (* 0.5 (* v0 (- t (* (/ tp 3.14159265) (sin (* 32768.0 (/ t tp))))))))
      ;; VOL — balistique pur. C'est le seul regime ou la salle n'invente aucune force : elle
      ;; laisse tomber l'ancre a -g, et tout ce que la chaine fait est sa propre affaire.
      ((< t (+ tp tf))
       (let ((tau (- t tp)))
         (+ yp (- (* v0 tau) (* 0.5 (* PHYSROOM-REGG (* tau tau)))))))
      ;; RECEPTION — demi-sinus de deceleration, symetrique de la detente.
      (else
       (let* ((yf (+ yp (- (* v0 tf) (* 0.5 (* PHYSROOM-REGG (* tf tf))))))
              (sg (fmin tl (- t (+ tp tf)))))
         (+ yf (+ (- 0.0 (* vl sg))
                  (* 0.5 (* vl (- sg (* (/ tl 3.14159265) (sin (* 32768.0 (/ sg tl))))))))))))))

(defun physroom-run-z ((t float))
  "Avancee du sujet le long d'un demarrage suivi d'un arret net, `t` en frames depuis le depart.
   0 -> 4.5 m/s en 0.6 s (8.53 u/frame^2), puis 4.5 -> 0 en 0.3 s (17.06 u/frame^2). Ce sont deux
   ECHELONS d'acceleration et c'est voulu : sa §17 s'appelle « Horizontal Acceleration and
   BRAKING », et un freinage humain EST un echelon (le pied se pose). La position et la vitesse
   restent continues, donc le rebasement de §37 ne peut pas se declencher.
   NATURE : une longueur, unites de jeu. REPERE : monde, axe Z (+Z = l'avant). A t=0 : 0.0000."
  (let* ((a1 8.53) (t1 36.0) (a2 17.06))
    (if (< t t1)
      (* 0.5 (* a1 (* t t)))
      (let ((v1 (* a1 t1))
            (z1 (* 0.5 (* a1 (* t1 t1))))
            (tau (fmin 18.0 (- t t1))))
        (+ z1 (- (* v1 tau) (* 0.5 (* a2 (* tau tau)))))))))

(defun physroom-reg-ang ((r int) (f int) (dr int))
  "Angle commande, EN DEGRES, pour la fenetre de rotation `r` a la frame `f` de son pilotage de
   `dr` frames. Profil demi-cosinus : vitesse angulaire NULLE aux deux bouts, acceleration
   angulaire maximale au milieu. Un echelon d'angle serait une acceleration angulaire infinie,
   c'est-a-dire le contraire d'un stimulus dont on connait la magnitude.
   NATURE : un angle en degres. REPERE : l'axe donne par `physroom-reg-axis`. A f=0 : la valeur
   de DEPART du regime, qui n'est pas toujours zero (r=12 part de 70 deg, r=14 de +35)."
  (let* ((u (fmin 1.0 (/ (the float f) (the float dr))))
         (s (* 0.5 (- 1.0 (cos (* 32768.0 u))))))
    (case r
      ((9)  (* 90.0 s))
      ((10) (* 150.0 s))
      ((11) (* 70.0 s))
      ((12) (* 70.0 (- 1.0 s)))
      ((13) (* 35.0 s))
      ((14) (- 35.0 (* 70.0 s)))
      (else 0.0))))

(defun physroom-reg-axis ((r int))
  "0 = tangage (X, l'avant/arriere de sa §19) · 1 = lacet (Y, sa §18) · 2 = roulis (Z, sa §20)."
  (cond ((or (= r 9) (= r 10)) 1)
        ((or (= r 11) (= r 12)) 0)
        (else 2)))

(defun physroom-reg-kind ((r int))
  "0 temoin · 1 detente · 2 vol · 3 reception · 4 course · 5 lacet · 6 tangage · 7 roulis"
  (cond ((zero? r) 0)
        ((or (= r 1) (= r 4)) 1)
        ((or (= r 2) (= r 5)) 2)
        ((or (= r 3) (= r 6)) 3)
        ((or (= r 7) (= r 8)) 4)
        ((or (= r 9) (= r 10)) 5)
        ((or (= r 11) (= r 12)) 6)
        (else 7)))

(defun physroom-reg-acmd ((r int))
  "Acceleration LINEAIRE de pointe COMMANDEE, u/frame^2 (11.162 = 1 g). Zero sur les regimes de
   rotation : leur stimulus est angulaire et sort dans `alp`. Publiee pour que le lecteur puisse
   confronter la reponse a son ENTREE — sans elle, un gain n'a pas de denominateur."
  (case r
    ((1) 13.19) ((2) 11.16) ((3) 16.85)
    ((4) 21.24) ((5) 11.16) ((6) 34.74)
    ((7) 8.53)  ((8) 17.06)
    (else 0.0)))

(defun physroom-reg-alp ((r int))
  "Acceleration ANGULAIRE de pointe COMMANDEE, rad/frame^2 MULTIPLIEE PAR 10000. Le facteur n'est
   pas un ornement : `alpha` vaut 0.0068 a 0.0293 rad/frame^2, et l'impression flottante de GOAL
   n'en montrerait pas assez de chiffres pour distinguer deux regimes voisins. Le lecteur divise
   par 10000 — et le tableau le dit a l'endroit ou il l'affiche."
  (case r
    ((9) 134.57) ((10) 292.96) ((11) 104.66) ((12) 104.66) ((13) 68.35) ((14) 136.70)
    (else 0.0)))

(defbehavior physroom-reg-pose phys-subject ((ax int) (deg float))
  "Oriente le sujet de `deg` degres autour de l'axe `ax`, EN FAISANT DECRIRE A L'ANCRE L'ARC QUE
   DECRIRAIT UN VRAI TORSE — pas l'arc que la geometrie du moteur lui impose par defaut.

   LE DEFAUT QUE CE BLOC CORRIGE EST MESURE, PAS SUPPOSE. La course C49E1 publiait, pour chaque
   regime de rotation, `r_eff = amax / omega` : le bras de levier REEL de l'ancre. Predit (le
   `chest` autour de la hanche) : 239.8 u en lacet, 956.9 en tangage, 926.4 en roulis. MESURE :
   13748, 12085, 6675. La rotation de `root quat` ne pivote donc PAS autour de `root trans`, et
   l'ancre etait lancee sur un arc de 3.3 m — un stimulus 7 a 57 fois trop fort portant le nom
   d'un geste humain qu'il ne decrivait plus. Recomposees, les trois mesures donnent
   |Y_ancre - hanche| = 894 u la ou le mesh livre dit 926.4 (3.5 % d'ecart, dont ~2 frames de
   retard d'echantillonnage) : LA VERTICALE ETAIT JUSTE, seul l'horizontal etait deporte.

   LA CORRECTION NE SUPPOSE PLUS RIEN, ELLE MESURE. `(cex, cey, cez)` est l'offset de l'ancre a
   `home`, releve A L'EXECUTION sur la premiere frame de la fenetre, alors que le sujet est
   encore droit et immobile. On pivote alors autour de `p = c_mesure - c_anatomique`, ce qui
   donne, apres simplification :

       ancre(theta) = home + (c_mesure - c_anat) + R . c_anat

   c'est-a-dire un point FIXE plus un arc de rayon |c_anat| — exactement le bras d'un torse, quel
   que soit le deport que le moteur ajoute. Le controle est le meme `r_eff` qui a leve le defaut :
   il doit maintenant retomber sur 239.8 / 956.9 / 926.4. S'il n'y retombe pas, la correction est
   fausse et le tableau le dira au lieu de l'affirmer.

   NATURE : une pose (position + orientation). REPERE : monde. A `deg` = 0 : `home` et l'identite
   au bit pres, quel que soit `(cex, cey, cez)` — `p - R.p` s'annule."
  (let* ((c  (cos (degrees deg)))
         (sn (sin (degrees deg)))
         (px (- (-> self cex) 0.0))
         (py (- (-> self cey) PHYSROOM-CANY))
         (pz (- (-> self cez) PHYSROOM-CANZ)))
    (cond
      ((zero? ax)
       (quaternion-axis-angle! (-> self root quat) 1.0 0.0 0.0 (degrees deg))
       (set! (-> self root trans y) (+ (-> self home y) (+ (* py (- 1.0 c)) (* pz sn))))
       (set! (-> self root trans z) (+ (-> self home z) (- (* pz (- 1.0 c)) (* py sn)))))
      ((= ax 1)
       (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (degrees deg))
       (set! (-> self root trans x) (+ (-> self home x) (- (* px (- 1.0 c)) (* pz sn))))
       (set! (-> self root trans z) (+ (-> self home z) (+ (* pz (- 1.0 c)) (* px sn)))))
      (else
       (quaternion-axis-angle! (-> self root quat) 0.0 0.0 1.0 (degrees deg))
       (set! (-> self root trans x) (+ (-> self home x) (+ (* px (- 1.0 c)) (* py sn))))
       (set! (-> self root trans y) (+ (-> self home y) (- (* py (- 1.0 c)) (* px sn)))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; LA MEME POSE, MAIS AUTOUR D'UN AXE MESURE SUR LE SUJET (cycle 67).
;;
;; LE DEFAUT QUE CE BLOC EXISTE POUR CONTROLER, ET IL EST MESURE. `physroom-reg-pose` tourne autour
;; des axes du MONDE, pris litteralement : (1,0,0) pour ce que `physroom-reg-axis` appelle
;; « tangage », (0,1,0) pour le lacet, (0,0,1) pour le « roulis ». Or les sections 18 a 20 sont
;; definies dans le repere du SUJET, et le sujet n'est pas aligne sur le monde. Mesure de cette
;; course, en repere monde (`PHYSAXW`) :
;;
;;     axe LATERAL du sujet = (-0.081, 0.183, 0.980)
;;        angle avec le monde X = 85.3 deg · avec Y = 79.5 deg · avec Z = 11.5 deg
;;
;;   r=9/10  « lacet »   monde Y : a 11.9 deg du VERTICAL du sujet          -> c'est bien un lacet
;;   r=11/12 « tangage » monde X : a  6.6 deg de l'AVANT/ARRIERE du sujet   -> c'est un ROULIS
;;   r=13/14 « roulis »  monde Z : a 11.5 deg du LATERAL du sujet           -> c'est un TANGAGE
;;
;; **Les deux se jouent donc l'un pour l'autre.** Trois preuves independantes concordent :
;;   (a) la geometrie du rig LIVRE — lBoob (+0.09, 1.95, 0.10) et rBoob (-0.09, 1.95, 0.10) dans
;;       `keira-hd-lod0.glb` : la separation gauche/droite est a 100 % sur l'axe lateral, donc une
;;       rotation AUTOUR de cet axe deplace les deux seins A L'IDENTIQUE (c'est un tangage) et une
;;       rotation perpendiculaire les deplace differemment (c'est un lacet ou un roulis) ;
;;   (b) l'algebre : une rotation autour du lateral COMMUTE avec la reflexion dans le plan de
;;       normale laterale, donc elle laisse l'ecart au miroir INVARIANT. `physroom-lean` tourne
;;       autour du monde X et fait passer cet ecart de 0.237 deg (`idle`) a 143.213 deg (`tilt`) :
;;       l'axe X n'est donc pas le lateral, et ce que la salle appelle « penchee vers l'avant »
;;       est une inclinaison LATERALE ;
;;   (c) la mesure du cycle 66 : le « roulis » rend un rapport gauche/droite de 1.002 / 1.045
;;       (symetrique — signature d'un tangage) et le « tangage » 1.166 / 2.259 (asymetrique —
;;       signature d'un roulis). Ca donne enfin sa cause a l'anomalie que le cycle 66 publiait
;;       sans en avoir : « §19 est la seule que la pose propre aggrave, et je n'ai pas de cause ».
;;
;; CE BLOC NE CORRIGE RIEN EN PLACE : `physroom-reg-pose` n'est pas touche, et les quinze fenetres
;; de PH-REG / PH-REGS / PH-REGT gardent leur trace au bit. PH-REGA rejoue les SIX fenetres de
;; rotation autour des axes MESURES sur le sujet, appendue, pour que les deux lectures se comparent
;; dans la MEME course. C'est la discipline du cycle 66, appliquee a l'axe au lieu de la pose.
;;
;; NATURE : une pose (position + orientation). REPERE : monde, mais l'AXE vient du sujet.
;; A `deg` = 0 : `home` et l'identite au bit pres — `p - R.p` s'annule, comme dans l'original.
(defbehavior physroom-reg-pose-axis phys-subject ((nx float) (ny float) (nz float) (deg float))
  (let* ((c  (cos (degrees deg)))
         (sn (sin (degrees deg)))
         (px (- (-> self cex) 0.0))
         (py (- (-> self cey) PHYSROOM-CANY))
         (pz (- (-> self cez) PHYSROOM-CANZ))
         ;; Rodrigues : R.p = p.c + (n x p).s + n.(n.p).(1-c). C'est la generalisation EXACTE des
         ;; trois cas ecrits a la main dans `physroom-reg-pose` — on peut le verifier en y posant
         ;; n = (1,0,0), qui redonne (px, py.c - pz.s, py.s + pz.c).
         (np (+ (* nx px) (+ (* ny py) (* nz pz))))
         (cx (- (* ny pz) (* nz py)))
         (cy (- (* nz px) (* nx pz)))
         (cz (- (* nx py) (* ny px)))
         (k  (- 1.0 c))
         (rx (+ (* px c) (+ (* cx sn) (* nx (* np k)))))
         (ry (+ (* py c) (+ (* cy sn) (* ny (* np k)))))
         (rz (+ (* pz c) (+ (* cz sn) (* nz (* np k))))))
    (quaternion-axis-angle! (-> self root quat) nx ny nz (degrees deg))
    ;; ancre(theta) = home + (p - R.p) : un point FIXE plus un arc de rayon |p|, exactement comme
    ;; l'original — seul l'axe change.
    (set! (-> self root trans x) (+ (-> self home x) (- px rx)))
    (set! (-> self root trans y) (+ (-> self home y) (- py ry)))
    (set! (-> self root trans z) (+ (-> self home z) (- pz rz))))
  (none))

(defbehavior physroom-tr-set phys-subject ((yy float) (zz float))
  "Pose la TRANSLATION du sujet : `yy` le long de sa VERTICALE, `zz` le long de son AVANT/ARRIERE.

   DEUX MODES, ET LE DEFAUT EST L'ANCIEN AU BIT PRES. En mode MONDE (`*physroom-reg-trmode*` = 0)
   ce sont litteralement les axes Y et Z du monde, et cette fonction ecrit EXACTEMENT les deux
   memes champs qu'avant son existence — c'est ce qui garde la trace de PH-REG / PH-REGS / PH-REGT
   identique. En mode SUJET elle compose les deux memes grandeurs sur les axes MESURES de l'ancre,
   orientes par deux signes eux-memes mesures et latches a l'entree de la phase.

   NATURE : une position, unites de jeu (4096 u = 1 m). REPERE : monde pour le vecteur ECRIT, mais
   la DIRECTION vient du sujet. LECTURE A yy = zz = 0 : `home` exactement, dans les deux modes —
   donc le temoin r=0 ne peut pas differer entre les deux passes, et c'est verifiable."
  (cond
    ((zero? *physroom-reg-trmode*)
     (set! (-> self root trans y) (+ (-> self home y) yy))
     (set! (-> self root trans z) (+ (-> self home z) zz)))
    (else
     (let ((us (-> self tus))
           (fs (-> self tfs)))
       (set! (-> self root trans x)
             (+ (-> self home x) (+ (* yy (* us (phys-axis-world (-> self slot) 0 0 0)))
                                    (* zz (* fs (phys-axis-world (-> self slot) 0 1 0))))))
       (set! (-> self root trans y)
             (+ (-> self home y) (+ (* yy (* us (phys-axis-world (-> self slot) 0 0 1)))
                                    (* zz (* fs (phys-axis-world (-> self slot) 0 1 1))))))
       (set! (-> self root trans z)
             (+ (-> self home z) (+ (* yy (* us (phys-axis-world (-> self slot) 0 0 2)))
                                    (* zz (* fs (phys-axis-world (-> self slot) 0 1 2)))))))))
  (none))

(defbehavior physroom-reg-drive phys-subject ((r int) (f int))
  "Pose la position et l'orientation du sujet pour la fenetre `r`. `f` est la frame comptee DEPUIS
   LE DEBUT DU PILOTAGE : `f < 0` veut dire qu'on est encore dans le repos qui precede.

   LE REPOS N'EST PAS UNE TENUE A `home`, C'EST UN RETOUR DOUX PUIS UNE TENUE. Un regime finit
   ailleurs qu'il n'a commence (le saut fort atterrit 693 u plus haut, la course s'arrete 2.02 m
   plus loin, le roulis finit a -35 deg). Y ramener le sujet D'UN COUP serait une impulsion
   artificielle de plusieurs milliers d'unites — precisement ce que sa §37 interdit de generer —
   et elle sonnerait dans la fenetre suivante sous le nom du regime suivant. Le retour se fait
   donc en demi-cosinus sur PHYSROOM-RETF frames (vitesse nulle aux deux bouts), et il reste
   ensuite `pre - RETF` frames de tenue pure : 30 frames au minimum, soit 2.5 constantes de temps
   du mode principal, PLUS les 60 du retour lui-meme."
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (vector-copy! (-> self root trans) (-> self home))
  (quaternion-identity! (-> self root quat))
  (cond
    ((< f 0)
     (let* ((k (+ f (-> *physroom-reg-pre* r)))
            (u (fmin 1.0 (/ (the float k) PHYSROOM-RETFF)))
            (b (* 0.5 (+ 1.0 (cos (* 32768.0 u))))))
       (cond
         ;; le retour doux emprunte le MEME axe que le pilotage qui l'a produit : sinon il
         ;; ramenerait le sujet par un chemin que rien n'a commande.
         ((and (!= (-> self retang) 0.0) (nonzero? *physroom-reg-axmode*))
          (physroom-reg-pose-axis (-> self rax) (-> self ray) (-> self raz)
                                  (* b (-> self retang))))
         ((!= (-> self retang) 0.0)
          (physroom-reg-pose (-> self retax) (* b (-> self retang))))
         (else
          ;; LE RETOUR DOUX EMPRUNTE LE MEME AXE QUE LE PILOTAGE QUI L'A PRODUIT, exactement comme
          ;; le retour des rotations le fait deja : sinon il ramenerait le sujet par un chemin que
          ;; rien n'a commande, et ce chemin entrerait dans la fenetre suivante sous son nom.
          (physroom-tr-set (* b (-> self rety)) (* b (-> self retz)))))))
    (else
     (let ((ft (the float f)) (yy 0.0) (zz 0.0) (aa 0.0) (xa 0))
       (case r
         ;; SAUT ORDINAIRE — h = 0.25 m. v0 = 151.2 u/frame ; vitesse d'impact 150.17 (le vol est
         ;; tronque a 27 frames pour 27.09 exactes, l'ecart est porte par la reception).
         ((1) (set! yy (physroom-jump-y 151.2 18.0 27.0 14.0 150.17 (fmin 18.0 ft))))
         ((2) (set! yy (physroom-jump-y 151.2 18.0 27.0 14.0 150.17 (+ 18.0 (fmin 27.0 ft)))))
         ((3) (set! yy (physroom-jump-y 151.2 18.0 27.0 14.0 150.17 (+ 45.0 (fmin 14.0 ft)))))
         ;; SAUT FORT — h = 0.45 m. v0 = 202.8 ; vitesse d'impact 199.03 ; reception en 9 frames.
         ((4) (set! yy (physroom-jump-y 202.8 15.0 36.0 9.0 199.03 (fmin 15.0 ft))))
         ((5) (set! yy (physroom-jump-y 202.8 15.0 36.0 9.0 199.03 (+ 15.0 (fmin 36.0 ft)))))
         ((6) (set! yy (physroom-jump-y 202.8 15.0 36.0 9.0 199.03 (+ 51.0 (fmin 9.0 ft)))))
         ;; COURSE — le demarrage et le freinage sont UNE trajectoire, pas deux stimuli.
         ((7) (set! zz (physroom-run-z (fmin 36.0 ft))))
         ((8) (set! zz (physroom-run-z (+ 36.0 (fmin 18.0 ft)))))
         ((0) (set! yy 0.0))
         (else
          ;; L'OFFSET SE RELEVE A LA PREMIERE FRAME, LE SUJET ENCORE DROIT ET IMMOBILE : c'est la
          ;; seule frame ou `ancre - home` vaut l'offset et rien d'autre. Une fenetre CHAINEE
          ;; (`pre` = 0) HERITE de la valeur, et c'est voulu — le corps y est deja tourne, la
          ;; relever la donnerait un offset contamine par la rotation en cours.
          (when (and (zero? f) (> (-> *physroom-reg-pre* r) 0))
            (let ((ax0 (phys-diag (-> self slot) 0 50))
                  (ay0 (phys-diag (-> self slot) 0 51))
                  (az0 (phys-diag (-> self slot) 0 52)))
              ;; SENTINELLE : un triplet EXACTEMENT nul veut dire que le canal n'a rien ecrit, pas
              ;; que l'ancre est a l'origine du monde. Sans ce test on prendrait `-home` pour un
              ;; offset et on lancerait le sujet sur un arc de plusieurs dizaines de metres. Le
              ;; repli est le pivot ANATOMIQUE seul, et la ligne publiee dit lequel des deux a
              ;; servi — jamais un silence.
              (cond
                ((and (= ax0 0.0) (= ay0 0.0) (= az0 0.0))
                 (set! (-> self cex) 0.0)
                 (set! (-> self cey) (+ PHYSROOM-CANY (- PHYSROOM-HIPY 0.0)))
                 (set! (-> self cez) PHYSROOM-CANZ)
                 (format 0 "PHYSREGL r=~D cex=~f cey=~f cez=~f src=0~%"
                         r (-> self cex) (-> self cey) (-> self cez)))
                (else
                 (set! (-> self cex) (- ax0 (-> self home x)))
                 (set! (-> self cey) (- ay0 (-> self home y)))
                 (set! (-> self cez) (- az0 (-> self home z)))
                 (format 0 "PHYSREGL r=~D cex=~f cey=~f cez=~f src=1~%"
                         r (-> self cex) (-> self cey) (-> self cez))))))
          ;; L'AXE MESURE SE RELEVE AU MEME POINT QUE L'OFFSET, ET POUR LA MEME RAISON : le
          ;; sujet y est encore droit, donc ses axes propres y sont ceux du repos. Une fenetre
          ;; CHAINEE (`pre` = 0) HERITE de l'axe, et c'est voulu — c'est la meme flexion qui se
          ;; poursuit, et le corps y est deja tourne.
          ;; LA CORRESPONDANCE EST CELLE DE L'ANATOMIE, PAS CELLE DES ETIQUETTES :
          ;;   lacet   (§18, r=9/10)  -> autour du VERTICAL          (`phys-axis-world` 0)
          ;;   tangage (§19, r=11/12) -> autour du LATERAL           (`phys-axis-world` 2)
          ;;   roulis  (§20, r=13/14) -> autour de l'AVANT/ARRIERE   (`phys-axis-world` 1)
          (when (and (nonzero? *physroom-reg-axmode*) (zero? f)
                     (> (-> *physroom-reg-pre* r) 0))
            (let ((wa (cond ((or (= r 9) (= r 10)) 0)
                            ((or (= r 11) (= r 12)) 2)
                            (else 1))))
              (set! (-> self rax) (phys-axis-world (-> self slot) 0 wa 0))
              (set! (-> self ray) (phys-axis-world (-> self slot) 0 wa 1))
              (set! (-> self raz) (phys-axis-world (-> self slot) 0 wa 2))
              ;; SENTINELLE : un triedre non classe rend trois zeros, et tourner autour d'un axe
              ;; nul ne ferait rien du tout en le laissant passer pour un geste joue. On le DIT.
              (when (< (+ (* (-> self rax) (-> self rax))
                          (+ (* (-> self ray) (-> self ray))
                             (* (-> self raz) (-> self raz)))) 0.5)
                (set! (-> self rax) 0.0) (set! (-> self ray) 1.0) (set! (-> self raz) 0.0))
              (format 0 "PHYSREGAAX r=~D wa=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                      r wa (-> self rax) (-> self ray) (-> self raz))))
          (set! xa (physroom-reg-axis r))
          (set! aa (physroom-reg-ang r f (-> *physroom-reg-drv* r)))
          ;; LE SENS S'APPLIQUE ICI, donc `retang` — memorise juste apres — le porte aussi et le
          ;; retour doux retrace le MEME chemin. L'appliquer plus bas laisserait le retour remonter
          ;; par l'autre cote, ce qui serait un stimulus qu'on n'a pas commande.
          (when (nonzero? *physroom-reg-axmode*)
            (set! aa (* *physroom-reg-sgn* aa)))))
       ;; L'ETAT DE FIN EST MEMORISE A CHAQUE FRAME : a la derniere du pilotage il porte donc
       ;; exactement le point d'arrivee, qui est ce dont le retour doux a besoin.
       (set! (-> self rety) yy)
       (set! (-> self retz) zz)
       (set! (-> self retang) aa)
       (set! (-> self retax) xa)
       (cond
         ((and (>= r 9) (nonzero? *physroom-reg-axmode*))
          (physroom-reg-pose-axis (-> self rax) (-> self ray) (-> self raz) aa))
         ((>= r 9) (physroom-reg-pose xa aa))
         (else (physroom-tr-set yy zz))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; L'ETAT DU LIMITEUR DE SPEC 21, PAR FENETRE DE REGIME (cycle 71).
;;
;; POURQUOI CETTE LIGNE EXISTE. §14, §16, §17, §18, §19 et §20 bornent TOUTES un « apex
;; displacement » en % B0, et cet apex est produit par le ressort principal. Ce ressort porte une
;; saturation de sa §21 ecrite comme MULTIPLICATEUR DE FORCE (jak-hd-physics.gc:2938-2943) :
;;
;;     kn  = 0.42 * B0   cpp = 0.08 * B0
;;     xr  = fmin(0.99, (dd - kn)/cpp)          <- L'ARGUMENT EST PLAFONNE
;;     |f| = k2s * (kn + cpp * xr/(1-xr))
;;
;; Sous `kn` c'est l'identite stricte. Au-dessus de `kn + 0.99*cpp = 0.4992 B0` l'argument GELE :
;; le numerateur vaut kn + 99*cpp et la force de rappel devient CONSTANTE. Une force constante est
;; un TAUX, pas une BORNE — c'est le defaut que le cycle 34 a mesure et corrige sur l'AUTRE canal
;; (le point libre de sa §23) et qui n'a jamais ete porte sur celui-ci.
;;
;; L'ARGUMENT DE CE MUR EST DEJA CALCULE PAR LE MOTEUR : c'est `*phys-dg*` 26, le maximum de
;; fenetre de |position simulee - cible de repos| / B0 (jak-hd-physics.gc:2825-2832). Il etait
;; publie SEULEMENT par `physroom-emit-window` (PH-MEAS, par animation x pilotage) et JAMAIS par
;; une fenetre de REGIME. Six sections publiaient donc une bande d'apex sans que rien ne dise si
;; leur propre fenetre avait ete lue dans la zone gelee. Un flux muet de plus, le quatrieme.
;;
;; NATURE : DEUX LONGUEURS RAPPORTEES A B0, sans dimension, MAXIMUM SUR LA FENETRE (le moteur les
;;   accumule par `>`, jak-hd-physics.gc:2829-2832). Ce ne sont PAS des moyennes et PAS des series.
;; REPERE : le monde, meme frame, meme attache, meme longueur d'os que la cible — c'est une
;;   difference de deux points exprimes dans le meme repere, donc invariante par rotation.
;; LIGNE DE BASE : `rgap` = 0 exactement si la cible de repos EST la pose d'auteur ; `perr` = 0
;;   exactement si le solveur est immobile sur cette cible. La fenetre temoin r=0 de PH-REG ne
;;   recoit AUCUN pilotage : c'est elle qui donne son echelle a toutes les autres.
;; CE QUE CHACUNE SEPARE, ET C'EST TOUT L'INTERET D'EN PUBLIER DEUX :
;;   `rgap` = |cible de repos - pose d'auteur| / B0   AUCUNE dynamique n'y entre ;
;;   `perr` = |position simulee - cible de repos| / B0  la part que la dynamique produit, et
;;            l'ARGUMENT EXACT du mur ci-dessus.
;;   Un `perr` grand avec un `rgap` nul est une demande dynamique ; l'inverse serait un decalage
;;   statique de la cible, que ni la raideur ni le limiteur ne peuvent faire baisser.
;; RESERVE, ECRITE PARCE QU'ELLE BORNE LA PORTEE DE LA LIGNE : le moteur n'ecrit ces deux
;;   emplacements que sous `(= l rlk)` (jak-hd-physics.gc:2824) — c'est donc la demande du maillon
;;   RACINE de la chaine, pas celle du distal. Le distal n'a pas d'equivalent publie, et cette
;;   ligne ne pretend pas en porter un.
;; `ph` = la phase qui l'emet, parce que les cinq phases de regime jouent les MEMES fenetres dans
;;   des poses differentes et qu'une ligne qui ne dit pas d'ou elle vient ne se rapproche de rien.
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-emit-limit phys-subject ((ph int) (c int) (r int))
  (format 0 "PHYSREGW ph=~D c=~D r=~D rgap=~f perr=~f~%"
          ph c r
          (phys-diag (-> self slot) c 24)
          (phys-diag (-> self slot) c 26))
  (none))

(defbehavior physroom-emit-regime phys-subject ((r int))
  "Publie la fenetre de regime `r` : UNE ligne de stimulus, puis TROIS par chaine.

   POURQUOI LE STIMULUS SORT AUSSI. Une reponse sans son entree n'est pas une mesure, c'est un
   nombre. `acmd`/`alp` sont ce que la salle a COMMANDE ; `amax` — le deplacement de l'ancre
   d'une frame a la suivante, que le moteur mesure deja pour sa §37 — est ce que l'ancre a
   REELLEMENT fait. Les confronter est le seul moyen de savoir que le regime a eu lieu, et sur
   les rotations `amax / omega` rend le BRAS DE LEVIER reel, a comparer a celui qu'on a suppose
   depuis le mesh. Un commentaire n'est pas une preuve : ces deux nombres le sont.

   TROIS LIGNES ET PAS UNE, ET C'EST UNE CONTRAINTE : `format` de GOAL est cape a huit
   parametres, destination et chaine de format comprises. Le lecteur les rapproche par la cle
   (c, r), comme il le fait deja pour PHYSCOMX/PHYSCOMX2 et PHYSRESTW/PHYSRESTS."
  (format 0 "PHYSREGD r=~D kind=~D drv=~D acmd=~f alp=~f~%"
          r (physroom-reg-kind r) (-> *physroom-reg-drv* r)
          (physroom-reg-acmd r) (physroom-reg-alp r))
  (dotimes (c (-> self nchain))
    (when (> (phys-chain-links (-> self slot) c) 0)
      (format 0 "PHYSREG c=~D r=~D com=~f cx=~f cy=~f cz=~f~%"
              c r
              (phys-diag (-> self slot) c 43)
              (phys-diag (-> self slot) c 47)
              (phys-diag (-> self slot) c 48)
              (phys-diag (-> self slot) c 49))
      (format 0 "PHYSREG2 c=~D r=~D csum=~f cn=~f amax=~f cmx2=~f~%"
              c r
              (phys-diag (-> self slot) c 44)
              (phys-diag (-> self slot) c 45)
              (phys-diag (-> self slot) c 30)
              (phys-diag (-> self slot) c 23))
      (format 0 "PHYSREG3 c=~D r=~D ee0=~f ee1=~f jt0=~f jt1=~f~%"
              c r
              (phys-diag (-> self slot) c 35)
              (phys-diag (-> self slot) c 36)
              (phys-diag (-> self slot) c 39)
              (phys-diag (-> self slot) c 40))
      ;; QUATRIEME LIGNE (cycle 51) — L'APEX DE CETTE FENETRE DE REGIME. C'est la seule grandeur
      ;; que §14, §16, §17, §18, §19 et §20 bornent toutes, et §19 ne borne QUE celle-la : sans
      ;; elle six sections restent injugeables quel que soit le solveur. `apex`/`ax`/`ay`/`az` =
      ;; emplacements 53-56, memes NATURE et REPERE que PHYSAPEX ci-dessus (maximum de fenetre,
      ;; vecteur releve a l'argmax). `cydn`/`cyup` sortent sur PHYSREG5 : la traversee du neutre
      ;; de §15 se juge sur les fenetres de VOL (r=2, r=5), pas sur une moyenne de course.
      (format 0 "PHYSREG4 c=~D r=~D apex=~f ax=~f ay=~f az=~f~%"
              c r
              (phys-diag (-> self slot) c 53)
              (phys-diag (-> self slot) c 54)
              (phys-diag (-> self slot) c 55)
              (phys-diag (-> self slot) c 56))
      (format 0 "PHYSREG5 c=~D r=~D cydn=~f cyup=~f~%"
              c r
              (phys-diag (-> self slot) c 57)
              (phys-diag (-> self slot) c 58))
      (physroom-emit-limit PHYSROOM-PH-REG c r)))
  (none))

;; ------------------------------------------------------------------------------------------------
;; LA MACHINE A ETATS. Une frame = un pas.
;; ------------------------------------------------------------------------------------------------
(defbehavior physroom-tick phys-subject ()
  ;; la zone reste vide a chaque frame, et on compte ce qu'on y trouve.
  (let ((n (physroom-sweep (< (-> self phase) PHYSROOM-PH-REPORT))))
    (when (> n (-> self nactor)) (set! (-> self nactor) n))
    ;; une frame de MESURE contaminee par un target vivant est une violation. Les phases
    ;; d'amorcage ne comptent pas : c'est la qu'on nettoie.
    (when (and (> *physroom-ntarget* 0) (> (-> self phase) PHYSROOM-PH-SETTLE))
      (+! (-> self viol) 1)))

  (+! (-> self pframe) 1)

  ;; LE MAXIMUM REELLEMENT VISITE, retenu ici et nulle part ailleurs : c'est le seul point par
  ;; lequel toutes les phases passent. Voir la note de `*physroom-maxvisited*`.
  ;; REPORT et DONE sont EXCLUS : ce sont les deux phases terminales, elles ne font aucun travail
  ;; et les compter rendrait le verdict vrai par construction — un faux rouge permanent. Ce qu'on
  ;; cherche est une phase de TRAVAIL numerotee au-dessus de REPORT, et une telle phase n'est ni
  ;; REPORT ni DONE : elle apparait donc bien dans ce maximum.
  (when (and (!= (-> self phase) PHYSROOM-PH-REPORT)
             (!= (-> self phase) PHYSROOM-PH-DONE)
             (> (-> self phase) *physroom-maxvisited*))
    (set! *physroom-maxvisited* (-> self phase)))

  (cond
    ;; ---- 0. AMORCAGE : attendre le compagnon HD et ses chaines -------------------------------
    ((= (-> self phase) PHYSROOM-PH-SETTLE)
     (physroom-hold)
     (physroom-advance-anim 1.0)
     (when (< (-> self slot) 0)
       (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
         (when (and hd (= (-> hd type) jak-hd))
           (set! (-> self hdpid) (the int (-> hd pid)))
           (set! (-> self slot) (phys-slot-of (the int (-> hd pid))))
           (when (>= (-> self slot) 0)
             (set! (-> self nchain) (phys-slot-chains (-> self slot)))))))
     (when (and (>= (-> self pframe) PHYSROOM-SETTLE) (> (-> self nchain) 0))
       ;; la topologie REELLEMENT resolue par le moteur, pas celle que le fichier promet, et la
       ;; longueur que le MODELE donne a chaque os : c'est le plafond geometrique de l'amplitude de
       ;; ce lien, publie pour que personne n'ait a la deviner. Publie EN FIN d'amorcage : les os du
       ;; compagnon ne portent une pose que quand son propre do-joint-math! a tourne, et le publier
       ;; a la frame de sa naissance ne donnait que des zeros (mesure du 2026-08-11).
       (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
         (when (and hd (= (-> hd type) jak-hd))
           (dotimes (c (-> self nchain))
             (let ((j0 (phys-chain-joint (-> self slot) c 0)))
               (format 0 "PHYSCHAIN c=~D links=~D fam=~D hang=~f j0=~S~%"
                       c
                       (phys-chain-links (-> self slot) c)
                       (phys-chain-family (-> self slot) c)
                       (phys-chain-hang (-> self slot) c)
                       (if (and (>= j0 0) (nonzero? (-> hd draw)) (nonzero? (-> hd draw jgeo)))
                         (-> hd draw jgeo data j0 name)
                         "?")))
             ;; LE TRIEDRE DE SPEC 24/29, TEL QUE LE SOLVEUR L'A CLASSE — et les trois facteurs de
             ;; raideur qu'il a REELLEMENT appliques, pas ceux qu'une constante annonce.
             ;; NATURE : des index de ligne (sans unite) et des facteurs multiplicatifs (sans
             ;; unite). REPERE : les lignes de la matrice de l'ANCRE. LIGNE DE BASE : `ok=0` avec
             ;; les trois facteurs a 1.000 = chaine non classee, donc integration isotrope, donc
             ;; bit pour bit celle d'avant l'anisotropie.
             ;; `sv/sap/slat` sont `1/mobilite` de sa §29 : 1.000 / 1.111 / 1.220 attendus.
             ;; DEUX LIGNES, ET CE N'EST PAS UN CHOIX DE STYLE : `format` de GOAL n'accepte pas
             ;; plus de huit parametres, destination et chaine de format comprises (meme plafond
             ;; que `PHYSGRADS` et `PHYSRINGA`). Huit champs ne tiennent pas sur une ligne.
             ;; `ok` = CLASSEE (la mesure par axe tourne) ; `arm` = raideur par axe ARMEE. Les deux
             ;; sont publies separement parce qu'ils ne disent pas la meme chose : aujourd'hui
             ;; ok=1 arm=0 sur les deux seins, et c'est exactement l'etat que la directive du
             ;; 09:45 decrit — mesure oui, application non, tant que la structure est un point.
             (format 0 "PHYSAXIS c=~D ok=~D arm=~D rv=~D rap=~D rlat=~D~%"
                     c
                     (phys-chain-axis (-> self slot) c 0)
                     (phys-chain-axis (-> self slot) c 4)
                     (phys-chain-axis (-> self slot) c 1)
                     (phys-chain-axis (-> self slot) c 2)
                     (phys-chain-axis (-> self slot) c 3))
             (format 0 "PHYSAXISS c=~D sv=~f sap=~f slat=~f~%"
                     c
                     (phys-chain-axis-stiff (-> self slot) c 0)
                     (phys-chain-axis-stiff (-> self slot) c 1)
                     (phys-chain-axis-stiff (-> self slot) c 2))
             ;; CE QUI A NOMME LES AXES, ET AVEC QUELS CHIFFRES. Le cycle 9 a trouve que les roles
             ;; `ap` et `lat` etaient INTERVERTIS : §29 posait 0.90 sur le lateral et 0.82 sur
             ;; l'avant-arriere, §24 comparait 2.50/2.65 Hz aux mauvais axes, et RIEN ne pouvait le
             ;; signaler — une mesure par axe qui ne publie que des VALEURS ne peut pas attraper une
             ;; permutation de ses propres axes. Il faut une grandeur dont la reponse est connue
             ;; D'AVANCE par la geometrie : le segment qui va d'un sein a l'autre est lateral par
             ;; anatomie. Il doit donc tomber ENTIEREMENT sur la ligne nommee `lat`.
             ;; NATURE : deux longueurs signees et une norme, en unites de jeu. REPERE : le triedre
             ;; de l'ANCRE. LIGNE DE BASE : `src=0` et trois zeros = pas de chaine partenaire, le
             ;; nommage est retombe sur la protrusion propre de l'organe.
             ;; CE QUI DISCRIMINE : `slat` doit porter ~712 u (17.4 cm mesures sur le rig) et `sap`
             ;; ~0. Si les deux sont du meme ordre, la separation ne designe rien et le verdict de
             ;; nommage est sans valeur — a lire avant toute conclusion sur §24 ou §29.
             (format 0 "PHYSAXNAME c=~D src=~D rlat=~D sja=~f sjb=~f len=~f~%"
                     c
                     (phys-chain-axis (-> self slot) c 5)
                     (phys-chain-axis (-> self slot) c 3)
                     (phys-chain-axsep (-> self slot) c 0)
                     (phys-chain-axsep (-> self slot) c 1)
                     (phys-chain-axsep (-> self slot) c 2))
             ;; LE SENS DU TRIEDRE, PAS SEULEMENT SES INDICES. `PHYSAXIS` dit QUELLE ligne porte
             ;; l'avant-arriere ; il ne dit pas dans quel SENS elle pointe, et c'est ce sens seul
             ;; qui separe supine de prone — donc qui decide lequel des deux triplets de §10/§11
             ;; s'applique. Voir la note de `phys-tri-world` : la mesure qui a fixe ce signe date
             ;; d'une epoque ou `axa` valait 0, et la course publie aujourd'hui `rap=2`.
             ;; NATURE : cosinus directeurs, sans unite. REPERE : MONDE — les memes axes que
             ;; `PHYSAXW`, pour que `fz . ligne[rap]` se calcule sur la trace sans rien supposer.
             ;; LIGNE DE BASE : trois zeros = triedre non releve (`fok=0`), aucune conclusion.
             ;; L'AXE 0 — LE LATERAL SORTANT, ET C'EST CELUI DONT SA §7 PARLE EXPLICITEMENT.
             ;; Il etait le SEUL des trois a n'etre jamais publie comme VECTEUR : la ligne
             ;; `PHYSAXNAME` n'en donnait que la signature SCALAIRE (`sja`, la separation des deux
             ;; seins projetee dessus). Or §7 dit « for the left and right breasts, outward +X
             ;; should be MIRRORED so that the equations remain symmetrical » : c'est une clause sur
             ;; le VECTEUR, et sans lui §7 restait `NON ETABLI` faute de pouvoir la lire. Aucun
             ;; calcul neuf — `phys-tri-world` accepte l'indice 0 depuis toujours (`*phys-fx*`), il
             ;; n'etait simplement pas appele avec.
             ;; NATURE : cosinus directeurs, sans unite. REPERE : MONDE, les memes axes que
             ;; `PHYSAXW` et que les deux lignes `PHYSTRI` ci-dessous, donc les trois se composent
             ;; sans rien supposer. LIGNE DE BASE : trois zeros = triedre non releve (`fok=0`),
             ;; aucune conclusion — jamais lu comme « axe nul ».
             (format 0 "PHYSTRI c=~D a=0 x=~,,5f y=~,,5f z=~,,5f~%"
                     c
                     (phys-tri-world (-> self slot) c 0 0)
                     (phys-tri-world (-> self slot) c 0 1)
                     (phys-tri-world (-> self slot) c 0 2))
             (format 0 "PHYSTRI c=~D a=2 x=~,,5f y=~,,5f z=~,,5f~%"
                     c
                     (phys-tri-world (-> self slot) c 2 0)
                     (phys-tri-world (-> self slot) c 2 1)
                     (phys-tri-world (-> self slot) c 2 2))
             (format 0 "PHYSTRI c=~D a=1 x=~,,5f y=~,,5f z=~,,5f~%"
                     c
                     (phys-tri-world (-> self slot) c 1 0)
                     (phys-tri-world (-> self slot) c 1 1)
                     (phys-tri-world (-> self slot) c 1 2))
             ;; LA POSE DANS LAQUELLE CE TRIEDRE EST RELEVE (cycle 67). `ROOM-SPEC7-MIROIR` publie
             ;; `angle(a0[chestL], -a0[chestR])` et en tire un verdict `MIROIR TENU` : sans cette
             ;; ligne, ce verdict ne sait pas dans quelle pose il a ete pris. Une seule ligne par
             ;; (chaine, maillon), le meme emetteur que partout ailleurs.
             (when (zero? c) (physroom-emit-poseb "settle"))
             ;; L'AXE D'OS AU REPOS, PAR MAILLON, LU DANS LE MOTEUR AU LIEU D'ETRE AJUSTE.
             ;; `ROOM-ORIAXIS` l'ajuste par ACP sur la dispersion de neuf deplacements et imprime
             ;; « NON PLAN — le reste du bloc est invalide » sur les DEUX chaines ; SPEC 10/11/12 et
             ;; l'anisotropie de SPEC 29 composent quand meme le long de lui. Le solveur, lui, a
             ;; releve cette direction une fois a la meme frame que `g_ref` : c'est `*phys-ux*`, et
             ;; elle n'etait publiee nulle part. Mesure hors moteur du cycle 26 : l'ajustement etait
             ;; a 4.50 deg de la verite sur `chestL` et a 16.84 deg sur `chestR`. NATURE : vecteur
             ;; unitaire. REPERE : la base de l'ANCRE, comme `PHYSTRI` et `PHYSORICOML`.
             (dotimes (l (phys-chain-links (-> self slot) c))
               (format 0 "PHYSURST c=~D l=~D ux=~,,5f uy=~,,5f uz=~,,5f~%"
                       c l
                       (phys-link-rest-dir (-> self slot) c l 0)
                       (phys-link-rest-dir (-> self slot) c l 1)
                       (phys-link-rest-dir (-> self slot) c l 2)))
             ;; LES LIGNES DE L'ANCRE AU MEME INSTANT, par ROLE (0=vertical, 1=AP, 2=lateral) —
             ;; `PHYSAXW` publie les memes vecteurs, mais dans une phase ULTERIEURE et sous une
             ;; autre pose. Comparer `fz` a une ligne relevee 3000 frames plus tard n'aurait aucun
             ;; sens ; ces deux lignes-ci sont lues sur LA MEME frame que `PHYSTRI`.
             (format 0 "PHYSAXR c=~D a=1 x=~,,5f y=~,,5f z=~,,5f~%"
                     c
                     (phys-axis-world (-> self slot) c 1 0)
                     (phys-axis-world (-> self slot) c 1 1)
                     (phys-axis-world (-> self slot) c 1 2))
             (format 0 "PHYSAXR c=~D a=0 x=~,,5f y=~,,5f z=~,,5f~%"
                     c
                     (phys-axis-world (-> self slot) c 0 0)
                     (phys-axis-world (-> self slot) c 0 1)
                     (phys-axis-world (-> self slot) c 0 2))
             (dotimes (l (phys-chain-links (-> self slot) c))
               (format 0 "PHYSBONE c=~D l=~D len=~f~%"
                       c l (phys-chain-bone hd (-> self slot) c l -1))
               ;; QUELS JOINTS CETTE CHAINE ECRIT REELLEMENT. Verdict owner du 2026-08-11 : « un
               ;; polygone de la semelle de la chaussure gauche se fait la malle » et « les
               ;; languettes des bandes de genoux ne bougent pas du tout » — les deux se decident
               ;; sur la liste des joints ECRITS, pas sur une intention dans les donnees.
               (let ((j (phys-chain-joint (-> self slot) c l)))
                 (format 0 "PHYSJOINT c=~D l=~D idx=~D name=~S~%"
                         c l j
                         (if (and (>= j 0) (nonzero? (-> hd draw)) (nonzero? (-> hd draw jgeo)))
                           (-> hd draw jgeo data j name)
                           "?"))))
             ;; LES VOLUMES QUE LE MOTEUR A RESOLUS, par nom de joint : sans eux un zero de
             ;; penetration ne prouve rien (le tableau annoncait zero alors qu'aucun collider de
             ;; buste n'existait et que l'owner voyait les bretelles traverser le torse).
             (when (zero? c)
               (dotimes (ci (phys-slot-colliders (-> self slot)))
                 (let ((j  (phys-collider-field (-> self slot) ci 0))
                       (j2 (phys-collider-field (-> self slot) ci 1)))
                   (format 0 "PHYSCOL ci=~D j=~S j2=~S~%"
                           ci
                           (if (and (>= j 0) (nonzero? (-> hd draw jgeo)))
                             (-> hd draw jgeo data j name) "?")
                           (if (and (>= j2 0) (nonzero? (-> hd draw jgeo)))
                             (-> hd draw jgeo data j2 name) "-"))))))))
       ;; LE SQUELETTE EST-IL SEULEMENT POSE ? Une course device du 2026-08-11 a publie 1584
       ;; lignes a ZERO partout avec 13 millions de paires « lien entierement dans le volume » :
       ;; les os du compagnon etaient restes a l'ORIGINE (il n'avait jamais ete rendu, donc son
       ;; do-joint-math! n'avait jamais tourne). Des zeros pris sur un squelette non pose ne
       ;; mesurent rien, et un tableau qui les publie est un faux vert. On refuse de mesurer.
       (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
         (when (and hd (= (-> hd type) jak-hd) (nonzero? (-> hd draw))
                    (nonzero? (-> hd draw skeleton)))
           (let* ((skel (-> hd draw skeleton))
                  (a (phys-chain-joint (-> self slot) 0 0))
                  (d (if (and (>= a 0) (< (+ a 1) (-> skel length)))
                       (vector-length (the-as vector (-> skel bones (+ a 1) transform vector 3)))
                       0.0)))
             (format 0 "PHYSPOSED joint0=~D dist-from-origin=~f~%" a d)
             (when (< d 1.0)
               (format 0 "PHYSFAIL reason=skeleton-not-posed-bones-at-origin~%")
               (set! (-> self phase) PHYSROOM-PH-DONE)))))
       (phys-auth-reset!)
       ;; MESURER LE CONFLIT ENTRE VOLUMES SANS L'ARBITRER. La priorite (DECISION 1) reste DESARMEE
       ;; — elle a ete retiree sur mesure, parce qu'ecarter un volume deplace le conflit au lieu de
       ;; le resoudre et fait TRAVERSER (DIRECTIVES regle 6). Mais ses compteurs vivaient DANS la
       ;; branche desarmee, donc `ROOM-VOLPRIO` publiait `pairs_ignored=0 chains=0` : un zero tire
       ;; d'un domaine vide, qui se lit comme « les volumes ne se contredisent plus ». La salle arme
       ;; donc la passe de SELECTION seule : elle compte, elle ne decide pas. Le jeu, lui, ne l'arme
       ;; jamais et ne paie pas la passe.
       (phys-prio-meas-set! 1)
       (phys-limiter-reset!)
       (phys-inversions-reset!)
       (phys-skin-meas-set! 1)
       (phys-skinpen-reset!)
       (phys-diag-reset!)
       (set! (-> self phase) PHYSROOM-PH-MEAS)
       (set! (-> self pframe) 0)
       (set! (-> self ai) 0)
       (set! (-> self drive) 0)
       (physroom-set-anim 0)
       (phys-stats-reset!)))

    ;; ---- 1. MESURE : toutes les animations x les quatre pilotages -----------------------------
    ((= (-> self phase) PHYSROOM-PH-MEAS)
     (if (>= (-> self drive) PHYSROOM-DRIVES)
       (physroom-hold)                                  ;; sous-fenetre de LIGNE DE BASE
       (physroom-drive (-> self drive) (-> self pframe)))
     (physroom-advance-anim 1.0)
     ;; AUCUNE FENETRE NE COMMENCE SUR UNE DISCONTINUITE (voir PHYSROOM-MEASAT). Les 54 premieres
     ;; frames absorbent le saut d'entree — changement d'animation, retour a la verticale, retour au
     ;; point de depart — et pour `tilt` elles contiennent en plus la rampe qui l'amene a 60 degres.
     ;; Meme regle pour les six sous-fenetres : les amplitudes restent comparables entre elles.
     (when (= (-> self pframe) PHYSROOM-MEASAT) (phys-stats-reset!))
     ;; ---- LA DIRECTION DES OS DE POITRINE, UNE FOIS PAR ANIMATION (cycle 54) -----------------
     ;; POURQUOI ICI. Le cycle 53 a mesure que le rig est bilateralement symetrique a 0.005 deg en
     ;; pose de BIND, et que la pose TENUE par la salle pendant toutes ses phases de mesure est a
     ;; 43.4 deg du miroir parfait — c'est la derniere animation jouee qui reste en place. Tout
     ;; ecart gauche/droite du dossier (sa §32, sa §18, sa §12, et celui que j'ai publie au cycle
     ;; 52) porte donc cette asymetrie. La question qui reste — accident de CETTE animation, ou
     ;; regle sur les 31 ? — se lit sans aucun balayage neuf : cette phase les joue deja toutes.
     ;; UNE SEULE SOUS-FENETRE (`drive` = 0, une translation, sujet a quaternion identite) pour que
     ;; la direction relevee soit celle de l'ANIMATION et pas d'une inclinaison du sujet.
     ;; NATURE : une direction UNITAIRE, sans dimension. REPERE : le MONDE. LIGNE DE BASE : en pose
     ;; de bind les deux os sont miroirs a 0.005 deg — c'est ce que cette ligne doit retrouver si
     ;; une animation tient une pose symetrique. LECTURE PURE : `phys-chain-bone` n'ecrit rien.
     (when (and (zero? (-> self drive)) (= (-> self pframe) PHYSROOM-MEASAT))
       (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
         (when hd
           (dotimes (c (-> self nchain))
            (when (> (phys-chain-links (-> self slot) c) 0)
             (dotimes (l (phys-chain-links (-> self slot) c))
               (format 0 "PHYSPOSEB a=~D c=~D l=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                       (-> self ai) c l
                       (phys-chain-bone hd (-> self slot) c l 0)
                       (phys-chain-bone hd (-> self slot) c l 1)
                       (phys-chain-bone hd (-> self slot) c l 2))))))))
     ;; ---- LE BALAYAGE DE POSE RESOLU A LA FRAME (cycle 67) ----------------------------------
     ;; Voir la note de `PHYSROOM-POSESTEP`. Ici, dans la sous-fenetre de LIGNE DE BASE : le sujet
     ;; est tenu par `physroom-hold`, l'animation avance a sa vitesse propre, aucun pilotage n'est
     ;; commande. C'est la seule condition de la course ou la direction relevee est celle de la
     ;; POSE et de rien d'autre. AUCUNE FRAME N'EST AJOUTEE : cette sous-fenetre existe deja et
     ;; dure `PHYSROOM-WIN` frames par animation.
     ;; `PHYSPOSEB` n'est PAS touche : il reste emis a `drive = 0`, `pframe = MEASAT`, exactement
     ;; comme au cycle 54, pour que le rang de la pose epinglee reste comparable a ce qu'il etait.
     ;; On AJOUTE, on ne remplace pas — c'est la discipline du cycle 66.
     (when (and (>= (-> self drive) PHYSROOM-DRIVES)
                (zero? (mod (-> self pframe) PHYSROOM-POSESTEP)))
       (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
         (when hd
           (let ((sc (physroom-mirror-score hd (-> self slot)))
                 (k  (+ (* (-> self ai) 100) (-> self pframe))))
             (+! *physroom-scan-n* 1)
             (format 0 "PHYSPOSEF k=~D a=~D f=~f s=~f~%" k (-> self ai) (-> self fnum) sc)
             ;; LA POPULATION EST PUBLIEE, PAS SEULEMENT SON ARGMAX. Le tableau REFAIT le maximum
             ;; depuis ces lignes et publie les deux : un argmax qu'on ne peut pas recalculer est
             ;; une affirmation, pas une mesure (registre : `argmax-anchor-is-not-a-population`).
             (dotimes (c (-> self nchain))
              (when (> (phys-chain-links (-> self slot) c) 0)
               (dotimes (l (phys-chain-links (-> self slot) c))
                 (format 0 "PHYSPOSEFB k=~D c=~D l=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                         k c l
                         (phys-chain-bone hd (-> self slot) c l 0)
                         (phys-chain-bone hd (-> self slot) c l 1)
                         (phys-chain-bone hd (-> self slot) c l 2)))))
             ;; L'ARGMAX RETENU EN COURSE : c'est lui que PH-REGT rejouera. La pose cesse d'etre
             ;; CHOISIE par un nom ecrit dans le source pour devenir le maximum MESURE sur la
             ;; population entiere. Un score non calculable (-2.0) ne peut jamais gagner.
             ;;
             ;; ET IL NE SE DECIDE PAS DANS LE TRANSITOIRE. Les 54 premieres frames de toute
             ;; sous-fenetre absorbent le saut d'entree — ici la fin d'oscillation du cinquieme
             ;; pilotage, qui vient de s'arreter. Une pose lue dedans porte le ring-down du
             ;; pilotage precedent et pas seulement la pose : elle pourrait gagner pour une raison
             ;; qui n'a rien a voir avec la symetrie. `PHYSROOM-MEASAT` est le point d'etablissement
             ;; que la salle utilise DEJA partout ailleurs — on ne s'invente pas un seuil.
             ;; Les echantillons du transitoire sont quand meme EMIS : c'est ce qui permet au
             ;; tableau de mesurer de combien le transitoire deplace le score, au lieu de le
             ;; supposer negligeable.
             (when (and (>= (-> self pframe) PHYSROOM-MEASAT) (> sc *physroom-best-s*))
               (set! *physroom-best-s* sc)
               (set! *physroom-best-a* (-> self ai))
               (set! *physroom-best-f* (-> self fnum)))))))
     (when (>= (-> self pframe) PHYSROOM-WIN)
       (physroom-emit-window)
       (set! (-> self pframe) 0)
       (+! (-> self drive) 1)
       (when (>= (-> self drive) PHYSROOM-SUBW)
         (set! (-> self drive) 0)
         (+! (-> self ai) 1)
         (when (< (-> self ai) (-> self nanim)) (physroom-set-anim (-> self ai))))
       (cond
         ((>= (-> self ai) (-> self nanim))
          ;; le bilan par chaine de TOUTE la course de mesure, avant que les phases de controle
          ;; ne viennent s'y ajouter.
          (physroom-emit-diag "run")
          (phys-diag-reset!)
          (set! (-> self phase) PHYSROOM-PH-RESP)
          (set! (-> self lvl) 0)
          (physroom-set-anim 0)
          (phys-stats-reset!))
         (else
          (phys-stats-reset!)))))

    ;; ---- 2. LA COURBE DE REPONSE (6e passe : « trop statiques sur les mouvements faibles, trop
    ;; ---- hysteriques sur les brusques »). Meme animation figee, meme chaine, meme fenetre : la
    ;; ---- SEULE chose qui change d'un niveau au suivant est l'amplitude de l'excitation. Une
    ;; ---- marche dans la courbe designe un seuil ; une droite dit qu'il n'y en a pas.
    ((= (-> self phase) PHYSROOM-PH-RESP)
     (physroom-drive-exc (-> self pframe) (physroom-exc-level (-> self lvl)))
     ;; la premiere moitie du niveau est un ETABLISSEMENT, pas une mesure : sans elle le niveau 0
     ;; lisait la fin d'oscillation de la phase precedente (amplitude 0.62 m pour une excitation de
     ;; 1.5 u/frame^2, soit un gain de reference faux, donc une courbe fausse).
     (when (= (-> self pframe) (/ PHYSROOM-RESPW 2)) (phys-stats-reset!))
     (when (>= (-> self pframe) PHYSROOM-RESPW)
       (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
           (format 0 "PHYSRESP c=~D lvl=~D exc=~f amp=~f jump=~f~%"
                   c (-> self lvl) (physroom-exc-level (-> self lvl))
                   (phys-tip-amp (-> self slot) c)
                   (phys-stat (-> self slot) c 2))))
       (set! (-> self pframe) 0)
       (+! (-> self lvl) 1)
       (phys-stats-reset!)
       (when (>= (-> self lvl) PHYSROOM-RESPL)
         (set! (-> self phase) PHYSROOM-PH-IDLE))))

    ;; ---- 3. LE REPOS : immobile, animation figee. La cible de l'ecart ne bouge plus, donc au
    ;; ---- repos l'ecart a la pose du modele doit tendre vers zero (SPEC section 4), sauf pour ce
    ;; ---- qui doit pendre (hang > 0), compte a part.
    ((= (-> self phase) PHYSROOM-PH-IDLE)
     (physroom-hold)
     ;; ---- LE RING-DOWN, FRAME PAR FRAME (defaut `hair-pudding`, owner 2026-08-13) ------------
     ;; « la gelatine c'est plus du pudding, c'est pas trop lent et mou, c'est vraiment pas
     ;; coherent... On dirait les mouvements quand on tape sur un pudding, pas des mouvements
     ;; naturels de cheveux ! »
     ;;
     ;; NATURE : une forme de reponse DANS LE TEMPS — la decroissance libre apres l'arret du
     ;;   stimulus, et le retard de phase d'un maillon sur son parent. Ce n'est PAS une amplitude :
     ;;   un pudding et une chaine de cheveux peuvent bouger AUTANT, ce qui les separe est la forme.
     ;;   Un scalaire d'amplitude par chaine ne peut donc structurellement pas voir ce defaut.
     ;; REPERE : LOCAL — la deviation angulaire du maillon PAR RAPPORT A SON PARENT, en degres,
     ;;   telle que `phys-link-ang` la publie. Jamais le monde, ou une pointe soudee a son parent
     ;;   afficherait le grand chiffre de son parent (la faute de la 10e passe).
     ;; LIGNE DE BASE : `lbang`/`rbang`, mesurees dans la MEME course. C'est le controle apparie de
     ;;   l'owner — meme moteur, meme salle : il APPROUVE les meches fines et REJETTE les grosses,
     ;;   donc la cible est la valeur MESUREE sur les fines, jamais un nombre choisi.
     ;; RESERVE : `ang` est un MODULE (toujours positif), le signal est donc REDRESSE — la frequence
     ;;   apparente vaut le DOUBLE de la reelle, une oscillation libre laisse DEUX minima, et le
     ;;   retard n'est determine que MODULO une demi-periode.
     ;;
     ;; POURQUOI ON IMPRIME PUIS ON REMET A ZERO, DANS CET ORDRE — c'est ce qu'une relecture casse
     ;; en premier : `*phys-la*` est un MAXIMUM COURANT, pas un instantane. Ce qu'on lit ici est
     ;; donc le maximum accumule DEPUIS LE RESET DE LA FRAME PRECEDENTE, c'est-a-dire la valeur de
     ;; cette frame-la. Toutes les chaines doivent etre imprimees AVANT le reset, sinon les
     ;; dernieres liraient un compteur deja vide. D'ou : une seule remise a zero, apres la boucle.
     ;; Et c'est `phys-ang-reset!` (etroit) et surtout PAS `phys-stats-reset!` : ce dernier remet
     ;; aussi `stat 0` et `*phys-thas*` a zero, ce qui maintiendrait la garde de `phys-link-ang`
     ;; baissee en permanence et rendrait un mur de `ang=0.0`.
     ;; `pframe` est incremente EN TETE de `physroom-tick`, donc `f` va de 1 a PHYSROOM-IDLES-1 :
     ;; le tableau trie et travaille en offset relatif au premier `f`.
     (when (< (-> self pframe) PHYSROOM-IDLES)
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (dotimes (l (phys-chain-links (-> self slot) c))
           (format 0 "PHYSRING c=~D f=~D l=~D ang=~f~%"
                   c (-> self pframe) l (phys-link-ang (-> self slot) c l))
           ;; LA MEME DEVIATION, SIGNEE ET VECTORIELLE — voir la note de `*phys-lsv*`.
           ;; NATURE : un vecteur `u_courant - u_modele`, tous deux unitaires depuis la MEME
           ;;   attache ; sa norme vaut 2 sin(theta/2), sa direction porte la PHASE que `ang`
           ;;   detruit. REPERE : le MONDE, et il n'est immobile QUE dans cette fenetre-ci
           ;;   (`physroom-hold` fige position, orientation et animation) — c'est pourquoi elle
           ;;   n'est publiee nulle part ailleurs. LECTURE QUAND LE DEFAUT EST ABSENT : (0,0,0).
           ;; Sans elle, une periode plane et une precession rendent la MEME colonne de chiffres,
           ;; et trois cycles ont conclu trois choses differentes de la meme trace.
           (format 0 "PHYSRING3 c=~D f=~D l=~D x=~f y=~f z=~f~%"
                   c (-> self pframe) l
                   (phys-link-dev (-> self slot) c l 0)
                   (phys-link-dev (-> self slot) c l 1)
                   (phys-link-dev (-> self slot) c l 2))
           ;; LA MEME DEVIATION, MAIS PROJETEE PAR AXE DANS LE REPERE DE L'ANCRE — c'est ce que
           ;; SPEC 24 exige, et c'est la seule forme qui puisse le rendre : elle demande TROIS
           ;; frequences propres (vertical 2.30 Hz, avant-arriere 2.50 Hz, lateral 2.65 Hz), et une
           ;; serie projetee sur son axe principal ne peut en rendre qu'UNE, celle de l'axe
           ;; dominant. SPEC 7 fixe le repere : « all dynamic calculations shall occur relative to
           ;; the torso/root transform rather than directly in world space ».
           ;;
           ;; NATURE : deplacement instantane signe du maillon par rapport a sa pose d'auteur — une
           ;;   SERIE TEMPORELLE, pas une amplitude agregee.
           ;; REPERE : triedre orthonorme de l'ANCRE (torse), jamais le monde : un maillon herite du
           ;;   mouvement de son parent, et c'est en repere monde que son mouvement propre devient
           ;;   illisible.
           ;; LIGNE DE BASE : la serie vaut 0 sur toute sa longueur quand la chaine est exactement
           ;;   sur la pose d'auteur.
           ;;
           ;; `v` = axe 0 (vertical), `ap` = axe 1 (avant-arriere), `lat` = axe 2 (lateral).
           ;; LIGNE SEPAREE, et ce n'est pas un choix de style : `format` de GOAL n'accepte pas plus
           ;; de huit parametres, destination et chaine de format comprises (cf. la note de
           ;; `PHYSGRADS` plus haut). Celle-ci en fait exactement huit : c'est le plafond, aucun
           ;; champ ne peut y etre ajoute.
           ;; SEPT DECIMALES, ET C'EST UNE CORRECTION D'INSTRUMENT MESUREE. `~f` en imprime quatre,
           ;; soit un pas de quantification de 1e-4 ; la serie LATERALE vaut 1e-3 a 7.6e-3, donc
           ;; un a deux chiffres significatifs, et elle ne prend que 33 valeurs distinctes sur 149
           ;; echantillons. Le bruit de quantification qui en resulte (rms 2.9e-5) faisait 16 a
           ;; 28 % du residu d'ajustement qui a fait declarer l'axe lateral « non lisible ».
           ;; On ne peut pas conclure sur une bande de 4 % avec un instrument qui quantifie a 10 %.
           (format 0 "PHYSRINGA c=~D f=~D l=~D v=~,,7f ap=~,,7f lat=~,,7f~%"
                   c (-> self pframe) l
                   (phys-link-dev-anc (-> self slot) c l 0)
                   (phys-link-dev-anc (-> self slot) c l 1)
                   (phys-link-dev-anc (-> self slot) c l 2))
           ;; ET L'ATTRIBUTION PAR ETAGE, LA MEME FRAME : `a0` = l'angle que L'INTEGRATION SEULE
           ;; produit, `a1` = ce qu'il reste apres la boucle de contraintes et l'attenuation.
           ;; `a0 - a1` EST, en degres et par frame, ce que les contraintes retirent — la seule
           ;; facon de separer « le solveur n'oscille pas » de « quelque chose vide l'oscillation ».
           (format 0 "PHYSRINGS c=~D f=~D l=~D a0=~f a1=~f~%"
                   c (-> self pframe) l
                   (phys-link-ang-stage (-> self slot) c l 0)
                   (phys-link-ang-stage (-> self slot) c l 1)))))
       (phys-ang-reset!))
     ;; frame-num CONSTANTE : la pose d'auteur est immobile, c'est ca « la pose du modele ».
     ;; [NOTE-156] LA LIGNE DE BASE AU REPOS DE SPEC 33/34, PHYSIQUE DESARMEE. -> jak-hd-physics-NOTES.md
     ;; Le maximum de peau repart de zero ICI pour que le tag `rest` emis en fin de fenetre ne porte
     ;; QUE cette fenetre — sans cette remise a zero il porterait tout ce qui precede, et un cliquet
     ;; est precisement le defaut corrige ailleurs dans ce meme cycle.
     (when (= (-> self pframe) PHYSROOM-IDLES)
       (phys-stats-reset!)
       (phys-skinpen-reset!))
     (when (>= (-> self pframe) (+ PHYSROOM-IDLES PHYSROOM-IDLEM))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSIDLE c=~D dev=~f hang=~f amp=~f fam=~D~%"
                 c
                 (phys-stat (-> self slot) c 5)
                 (phys-chain-hang (-> self slot) c)
                 (phys-tip-amp (-> self slot) c)
                 (phys-chain-family (-> self slot) c))))
       ;; [NOTE-156] `PHYSSKIN tag=rest` — LA LIGNE DE BASE QUE SPEC 33/34 EXIGE.
       ;; MEME code, MEME point (`*phys-px*`), MEME predicat que le `skinpen` de la course : c'est
       ;; la SEULE facon de comparer les deux sans changer de grandeur en chemin.
       ;; « PHYSIQUE DESARMEE » EST ICI UNE MESURE, PAS UNE PROMESSE : la fenetre est `physroom-hold`
       ;; (position figee, orientation figee, animation figee) et `PHYSIDLE dev` ci-dessus PUBLIE
       ;; l'ecart residuel du joint a sa pose d'auteur sur cette meme fenetre. C'est le desarmement
       ;; lui-meme qui est chiffre, chaine par chaine, a cote de la ligne de base qu'il justifie.
       (physroom-emit-diag "rest")
       ;; ---- SPEC 9 : POURQUOI L'ETAT DEBOUT N'EST PAS NEUTRE. `PHYSIDLE dev` dit QUE l'ecart
       ;; ---- existe (23.86 / 19.40 u la ou sa SPEC 9 exige 0.0000) ; il ne dit pas D'OU il vient,
       ;; ---- et deux mecanismes le produiraient a l'identique : un terme moteur non nul au repos,
       ;; ---- ou une cible elastique qui n'est pas la pose d'auteur. `PHYSRINGS a0=1.3975
       ;; ---- a1=1.3993` a deja tranche que ce n'est PAS la boucle de contraintes (elle n'ajoute
       ;; ---- que 0.0018 deg) : c'est donc une FORCE, et la seule qui subsiste au repos est
       ;; ---- `gsc * g_effective`.
       ;;
       ;; NATURE : un rapport sans dimension, |g_local - g_ref| / |g| — l'AMPLITUDE DU STIMULUS
       ;;   gravitaire, pas la reponse. C'est le meme `*phys-st*` 18 que ROOM-GRAVSAG publie pour
       ;;   l'inclinaison ; ici il est lu sur la fenetre de REPOS, ou personne ne l'avait lu.
       ;; REPERE : celui de l'ancre (SPEC 7), comme `gl` dont il est tire.
       ;; LIGNE DE BASE, ET C'EST TOUT L'INTERET : la SPEC 3 la donne elle-meme — « standing still
       ;;   gives g_local = g_ref [...] therefore a_drive = 0 ». Debout, ce nombre DOIT valoir 0 ;
       ;;   a 60 degres il vaut ~1.0 (mesure : 0.8326). Un `gn` non nul dans cette fenetre-ci EST
       ;;   la cause de SPEC 9, lue a l'execution, et non plus deduite du source.
       ;; `tf` est sa part TANGENTIELLE : la part radiale ne peut produire aucun deplacement
       ;;   angulaire, donc c'est `gn * tf` qui porte l'ecart, pas `gn` seul.
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSIDLEG c=~D gn=~f tf=~f~%"
                 c (phys-stat (-> self slot) c 18) (phys-stat (-> self slot) c 19))))
       ;; la POSITION MOYENNE debout : c'est le terme `at0` de ROOM-GRAVSAG.
       (physroom-emit-mean "idle")
       (set! (-> self phase) PHYSROOM-PH-TILT)
       (set! (-> self pframe) 0)
       (phys-stats-reset!)))

    ;; ---- 4. ELLE SE PENCHE, ET ON TIENT LA POSE. Meme animation figee, meme chaine, meme duree
    ;; ---- que le repos : la SEULE difference est l'inclinaison du tronc. Une gravite exprimee dans
    ;; ---- le repere de l'ancre ne deplace rien quand elle est droite et agit des qu'elle penche,
    ;; ---- donc l'ecart a la pose du modele doit MONTER ici et nulle part ailleurs. C'est la mesure
    ;; ---- que reclame la 6e passe : « aucun mouvement quand elle se penche en avant pour souder ».
    ((= (-> self phase) PHYSROOM-PH-TILT)
     (physroom-lean PHYSROOM-TILTDEG)
     ;; ---- SPEC 24 — LA MEME SERIE, MAIS SOUS UNE EXCITATION DE DIRECTION DIFFERENTE ----------
     ;; Le refit du ring-down de REPOS donne la MEME demi-periode sur `v` et `ap` (13 frames), et
     ;; les MEMES croisements de zero : dans cette fenetre-la la poitrine fait un balancement PLAN,
     ;; donc deux projections d'un seul vecteur oscillant selon une direction fixe. Une seule
     ;; frequence peut en sortir, quelles que soient les raideurs par axe — et §29 est pourtant bien
     ;; armee (`sap 1.1111`, `slat 1.2195` lus a l'execution). Ce n'est donc pas le solveur qui ne
     ;; separe pas les trois modes de sa §24, c'est L'EXCITATION.
     ;;
     ;; Cette phase en fournit une SECONDE, gratuitement et sans rien ajouter au solveur : les 60
     ;; degres sont rendus en UNE frame (voir la note de `physroom-hold`), donc le debut de la
     ;; fenetre est une IMPULSION, et son azimut dans le plan tangent de l'ancre n'a aucune raison
     ;; d'etre celui du residu de la fenetre de repos. Deux directions d'excitation, deux ring-downs
     ;; a comparer : si les demi-periodes DIFFERENT, l'anisotropie de §29 est demontree a
     ;; l'execution ; si elles sont egales, c'est que la raideur par axe n'atteint pas la reponse,
     ;; et il faudra une impulsion par axe.
     ;;
     ;; NATURE / REPERE / LIGNE DE BASE : identiques a `PHYSRINGA` de la fenetre de repos (voir sa
     ;; note) — deviation signee du maillon a sa pose d'auteur, projetee sur le triedre de l'ANCRE
     ;; (SPEC 7), nulle sur toute sa longueur quand la chaine est sur la pose d'auteur. Le seul
     ;; changement est le CHEMIN parcouru avant la fenetre, ce qui est precisement la variable.
     ;; Le suffixe `T` distingue les deux fenetres : les melanger rendrait le refit ininterpretable.
     (when (< (-> self pframe) PHYSROOM-IDLES)
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (dotimes (l (phys-chain-links (-> self slot) c))
           ;; meme correction de resolution que `PHYSRINGA` — voir sa note.
           (format 0 "PHYSRINGAT c=~D f=~D l=~D v=~,,7f ap=~,,7f lat=~,,7f~%"
                   c (-> self pframe) l
                   (phys-link-dev-anc (-> self slot) c l 0)
                   (phys-link-dev-anc (-> self slot) c l 1)
                   (phys-link-dev-anc (-> self slot) c l 2))))))
     (when (= (-> self pframe) PHYSROOM-IDLES) (phys-stats-reset!))
     (when (>= (-> self pframe) (+ PHYSROOM-IDLES PHYSROOM-IDLEM))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSTILT c=~D deg=~f dev=~f amp=~f fam=~D~%"
                 c PHYSROOM-TILTDEG
                 (phys-stat (-> self slot) c 5)
                 (phys-tip-amp (-> self slot) c)
                 (phys-chain-family (-> self slot) c))))
       ;; la POSITION MOYENNE penchee a 60 degres : c'est le terme `at60` de ROOM-GRAVSAG, et
       ;; l'ecart avec `at0` EST la reponse a la gravite. Rien d'autre n'a change entre les deux
       ;; phases : meme animation figee, meme position, meme duree, meme amortissement — seule
       ;; l'orientation de l'ancre differe.
       (physroom-emit-mean "tilt")
       (set! (-> self phase) PHYSROOM-PH-BACK)
       (set! (-> self pframe) 0)
       (phys-stats-reset!)))

    ;; ---- 4 bis. ELLE SE REDRESSE, ET ON TIENT LA POSE. Le cycle 0 -> 60 -> 0 est ferme ici, et
    ;; ---- c'est la seule phase qui puisse voir l'hysteresis que l'owner decrit (voir la note de
    ;; ---- PHYSROOM-PH-BACK). Copie conforme de PHYSROOM-PH-IDLE : meme appel, meme etablissement,
    ;; ---- meme fenetre, meme emetteur. Seul le CHEMIN parcouru avant differe.
    ((= (-> self phase) PHYSROOM-PH-BACK)
     (physroom-hold)
     (when (= (-> self pframe) PHYSROOM-IDLES) (phys-stats-reset!))
     (when (>= (-> self pframe) (+ PHYSROOM-IDLES PHYSROOM-IDLEM))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSBACK c=~D dev=~f hang=~f amp=~f fam=~D~%"
                 c
                 (phys-stat (-> self slot) c 5)
                 (phys-chain-hang (-> self slot) c)
                 (phys-tip-amp (-> self slot) c)
                 (phys-chain-family (-> self slot) c))))
       ;; la POSITION MOYENNE redressee, APRES l'aller-retour. Son ecart avec `idle` EST
       ;; l'hysteresis ; son ecart avec `tilt` est la part du sag qui a bien ete rendue.
       (physroom-emit-mean "back")
       (set! (-> self phase) PHYSROOM-PH-AXV)
       (set! (-> self ori) 0)
       (set! (-> self pframe) 0)
       (phys-stats-reset!)))

    ;; ---- 4 ter. SPEC 24/25/26/27 — UNE IMPULSION ISOLEE PAR AXE, PUIS ON LACHE.
    ;; Les trois phases sont IDENTIQUES a l'axe pres, et c'est voulu : trois series produites par
    ;; le meme chemin de code se comparent entre elles sans qu'aucun ecart puisse venir de
    ;; l'instrument. Voir la note de `physroom-drive-imp` pour la forme de l'impulsion et pour le
    ;; choix de l'amplitude (bande LINEAIRE — une frequence propre est une propriete du systeme
    ;; linearise ; sous saturation §21 on lirait le limiteur).
    ;;
    ;; NATURE : une SERIE TEMPORELLE de deplacement signe du maillon par rapport a sa pose
    ;;   d'auteur, projetee sur les trois axes. Ce n'est pas une amplitude agregee.
    ;; REPERE : le triedre orthonorme de l'ANCRE (torse) — le meme que `PHYSRINGA`, donc les
    ;;   valeurs des deux fenetres sont directement comparables. Jamais le monde.
    ;; LIGNE DE BASE : la serie vaut 0 partout quand la chaine est exactement sur la pose d'auteur.
    ;; CE QUI DISCRIMINE : l'axe EXCITE. Si les trois fenetres rendaient la meme frequence, c'est
    ;;   que l'anisotropie de §29 n'atteint pas le solveur — le contraire du resultat qu'on cherche
    ;;   a confirmer, et c'est bien ce qui rend la mesure decidable.
    ((or (= (-> self phase) PHYSROOM-PH-AXV)
         (= (-> self phase) PHYSROOM-PH-AXB)
         (= (-> self phase) PHYSROOM-PH-AXL)
         (= (-> self phase) PHYSROOM-PH-AXZV)
         (= (-> self phase) PHYSROOM-PH-AXZB)
         (= (-> self phase) PHYSROOM-PH-AXZL))
     (let ((ax (cond ((or (= (-> self phase) PHYSROOM-PH-AXV)
                          (= (-> self phase) PHYSROOM-PH-AXZV)) 0)
                     ((or (= (-> self phase) PHYSROOM-PH-AXB)
                          (= (-> self phase) PHYSROOM-PH-AXZB)) 1)
                     (else 2)))
           ;; les trois fenetres Z sont les MEMES que les trois premieres, contrainte de longueur
           ;; en moins : meme impulsion, meme amplitude, meme fenetre, meme emetteur. C'est ce qui
           ;; rend la comparaison des deux selectivites lisible — un seul terme change.
           (nolen (if (or (= (-> self phase) PHYSROOM-PH-AXZV)
                          (= (-> self phase) PHYSROOM-PH-AXZB)
                          (= (-> self phase) PHYSROOM-PH-AXZL)) 1 0)))
       (phys-len-off-set! nolen)
       (physroom-drive-imp (-> self pframe) ax)
       ;; LA DIRECTION REELLEMENT POUSSEE, publiee une fois par fenetre. Sans elle, une impulsion
       ;; nulle (chaine non classee) et une impulsion sans reponse rendraient la meme serie plate.
       (when (= (-> self pframe) 1)
         (format 0 "PHYSAXW ax=~D ux=~,,5f uy=~,,5f uz=~,,5f~%"
                 ax
                 (phys-axis-world (-> self slot) 0 ax 0)
                 (phys-axis-world (-> self slot) 0 ax 1)
                 (phys-axis-world (-> self slot) 0 ax 2))
         ;; LES COMPTEURS DE DIAGNOSTIC COUVRENT CETTE FENETRE ET RIEN D'AUTRE. Sans ce reset,
         ;; `worstres` publie plus bas serait le maximum depuis la derniere remise a zero — donc
         ;; celui d'une AUTRE fenetre, et les six lignes seraient toutes egales au meme maximum
         ;; herite. C'est exactement le defaut que le cycle 28 s'est reproche (« transporter une
         ;; mesure d'une fenetre a une autre »). Rien d'existant n'est perturbe : entre la sortie
         ;; de PH-INVPC (`physroom-emit-diag "run"`) et PH-ORI (qui remet a zero lui-meme a
         ;; `PHYSROOM-ORIS`), aucun emetteur ne lit `*phys-dg*`.
         (phys-diag-reset!))
       ;; la serie ne commence QU'APRES l'impulsion : pendant les 10 frames du pas, le sujet bouge,
       ;; et ce qu'on veut est la decroissance LIBRE qui suit. Le `skip` de l'ajustement (12) reste
       ;; celui des autres fenetres — on ne change pas l'estimateur pour une fenetre seulement.
       (when (> (-> self pframe) PHYSROOM-IMPF)
         (dotimes (c (-> self nchain))
           (let ((nl (phys-chain-links (-> self slot) c)))
             (dotimes (l nl)
               ;; DEUX TAGS, pas un champ `len=` : la seconde ligne est deja a huit parametres,
               ;; le plafond de `format`. `PHYSRINGAZ` porte les fenetres a contrainte LEVEE, avec
               ;; exactement la meme disposition de champs, donc le meme parseur a un nom pres.
               (format 0 (if (zero? nolen)
                           "PHYSRINGAX c=~D f=~D l=~D ax=~D v=~,,7f~%"
                           "PHYSRINGAZ c=~D f=~D l=~D ax=~D v=~,,7f~%")
                       c (- (-> self pframe) PHYSROOM-IMPF) l ax
                       (phys-link-dev-anc (-> self slot) c l 0))
               ;; DEUX LIGNES, et ce n'est pas un choix de style : `format` de GOAL plafonne a huit
               ;; parametres, destination et chaine comprises. Avec `ax` en plus, les trois axes ne
               ;; tiennent plus sur une ligne — voir la note de `PHYSRINGA`.
               ;; `ax` EST REPETE SUR LA SECONDE LIGNE, et c'est necessaire : les trois fenetres
               ;; repartent chacune a la frame 0, donc `f` seule ne designe pas une fenetre. Sans
               ;; `ax` ici, l'appariement des deux lignes serait ambigu entre les trois axes.
               ;; Huit parametres exactement : c'est le plafond, aucun champ de plus.
               (format 0 (if (zero? nolen)
                           "PHYSRINGAX2 c=~D f=~D ax=~D l=~D ap=~,,7f lat=~,,7f~%"
                           "PHYSRINGAZ2 c=~D f=~D ax=~D l=~D ap=~,,7f lat=~,,7f~%")
                       c (- (-> self pframe) PHYSROOM-IMPF) ax l
                       (phys-link-dev-anc (-> self slot) c l 1)
                       (phys-link-dev-anc (-> self slot) c l 2))
               ;; ---- LA MEME FENETRE, LUE PAR L'INSTRUMENT NON AVEUGLE -------------------------
               ;; `PHYSRINGAX` porte une difference de vecteurs UNITAIRES : elle ne peut pas voir
               ;; le degre de liberte RADIAL, qui est a 92 % l'axe VERTICAL de SPEC 24 (PCA du
               ;; cycle 8 : serie plane a 1 %, meme direction nulle dans les 12 fenetres). Les
               ;; deux tags sortent du MEME instant de la MEME course, donc la frequence lue sur
               ;; l'une et sur l'autre ne differe que par la grandeur projetee.
               ;; NATURE : deplacement signe en unites de jeu. REPERE : triedre de l'ancre (SPEC 7).
               ;; LIGNE DE BASE : 0 partout a la pose d'auteur. Voir `*phys-ldb*`.
               ;; `PHYSRINGAX` N'EST PAS RETIREE : sans elle, la comparaison n'aurait pas d'avant.
               (format 0 (if (zero? nolen)
                           "PHYSRINGBX c=~D f=~D l=~D ax=~D v=~,,7f~%"
                           "PHYSRINGBZ c=~D f=~D l=~D ax=~D v=~,,7f~%")
                       c (- (-> self pframe) PHYSROOM-IMPF) l ax
                       (phys-link-dev-anc-abs (-> self slot) c l 0))
               (format 0 (if (zero? nolen)
                           "PHYSRINGBX2 c=~D f=~D ax=~D l=~D ap=~,,7f lat=~,,7f~%"
                           "PHYSRINGBZ2 c=~D f=~D ax=~D l=~D ap=~,,7f lat=~,,7f~%")
                       c (- (-> self pframe) PHYSROOM-IMPF) ax l
                       (phys-link-dev-anc-abs (-> self slot) c l 1)
                       (phys-link-dev-anc-abs (-> self slot) c l 2))
               ;; ---- SPEC 23 : LE TROISIEME DEGRE DE LIBERTE, DANS LA MEME FENETRE -------------
               ;; `PHYSRINGAX` et `PHYSRINGBX` lisent toutes deux la position du JOINT, et ce joint
               ;; vit sur une sphere : leur composante radiale est nulle par construction (la
               ;; premiere parce qu'elle differencie des vecteurs UNITAIRES, la seconde parce que
               ;; |u| = |m|). Aucune des deux ne peut donc porter le mode que sa §24 appelle
               ;; « intentionally the SLOWEST » — il est a 84.5 % radial. Cette ligne-ci porte
               ;; l'etat radial LUI-MEME, celui que §23 integre.
               ;; NATURE : une DEFORMATION signee rapportee a B0 (§6), serie temporelle.
               ;; REPERE : l'axe de l'os, dans le triedre de l'ancre. LIGNE DE BASE : 0.0 a la pose
               ;; d'auteur. CE QUI DISCRIMINE : c'est le SEUL des trois tags dont la valeur peut
               ;; etre non nulle quand le joint ne bouge pas — si elle reste plate quand les deux
               ;; autres oscillent, le degre de liberte n'est pas arrive.
               (format 0 (if (zero? nolen)
                           "PHYSRINGCX c=~D f=~D l=~D ax=~D v=~,,7f~%"
                           "PHYSRINGCZ c=~D f=~D l=~D ax=~D v=~,,7f~%")
                       c (- (-> self pframe) PHYSROOM-IMPF) l ax
                       ;; PAR MAILLON depuis le cycle 31. `phys-chain-radial` lit un tableau PAR
                       ;; CHAINE, ecrase a chaque tour de la boucle par maillon du solveur : cette
                       ;; ligne imprimait donc la MEME valeur pour l=0 et l=1 (verifie : max|l0-l1|
                       ;; = 0 sur les 6 combinaisons chaine x axe, 150 frames). L'axe VERTICAL de
                       ;; sa §24 se lit sur CE canal — il n'avait donc aucune resolution par maillon.
                       (phys-chain-radial-link (-> self slot) c l 1))))))
       (when (>= (-> self pframe) PHYSROOM-AXW)
         ;; ---- SPEC 33 : L'INTERPENETRATION, MESUREE DANS UNE FENETRE OU LA CONTRAINTE DE
         ;; ---- LONGUEUR EST TOUR A TOUR EN PLACE ET LEVEE. C'est l'ABLATION que le cycle 28 a
         ;; ---- reclamee sans pouvoir la faire : les six fenetres AX/AXZ portent la MEME
         ;; ---- impulsion, la MEME amplitude, la MEME duree et le MEME emetteur — un seul terme
         ;; ---- change (`nolen`). Le residu de penetration est donc comparable ligne a ligne,
         ;; ---- ce que les tags `self`/`side`/`cone` ne permettent pas (fenetres differentes).
         ;;   res    NATURE : une PROFONDEUR en unites de jeu (4096 = 1 m), maximum sur la
         ;;          fenetre, APRES tout le solveur — pas une amplitude, pas une variance.
         ;;          REPERE : le monde, a la frame ecrite. C'est le residu AU-DELA du plancher de
         ;;          pose d'auteur, donc 0 = « rien n'entre plus loin que le modele ne le fait ».
         ;;          LECTURE QUAND LE DEFAUT EST ABSENT : 0.0000.
         ;;   ci     l'indice du VOLUME qui porte ce residu — sans lui, un residu qui change de
         ;;          volume se lirait comme un residu qui bouge.
         ;;   rot0   l'angle REELLEMENT ecrit dans la 3x3 du maillon 0 (degres, max de fenetre).
         ;;          `rootrot` (PHYSDIAG6) ne peut pas le publier sur une chaine dont les donnees
         ;;          ne declarent aucun `rootlock` : son site d'ecriture est garde par
         ;;          `(< l rlk0)`, donc `l < 0`, donc un domaine VIDE — son 0.0000 sur chestL et
         ;;          chestR n'est pas une mesure. Celui-ci a `l = 0`, qui existe toujours.
         (dotimes (c (-> self nchain))
           (when (> (phys-chain-links (-> self slot) c) 0)
             (format 0 "PHYSAXRES c=~D ax=~D nolen=~D res=~f ci=~f rot0=~f~%"
                     c ax nolen
                     (phys-diag (-> self slot) c 17)
                     (phys-diag (-> self slot) c 18)
                     (phys-diag (-> self slot) c 13))
             ;; l'excursion du centre de chair de la MEME fenetre (voir PHYSDIAG8) : c'est elle
             ;; que sa §22 borne a 0.35/0.40 B0, et la seule facon de savoir si un residu de
             ;; penetration vient d'une excursion hors bande ou d'un solveur qui n'a pas pousse.
             (format 0 "PHYSAXCOM c=~D ax=~D nolen=~D comex=~f~%"
                     c ax nolen
                     (phys-diag (-> self slot) c 19))))
         ;; LE RENDEMENT GEOMETRIQUE DE LA POUSSEE DE CONTACT, CUMULE, LU A LA SORTIE DE CHAQUE
         ;; FENETRE. Ces trois compteurs ne sont PAS remis a zero ici : `PHYSTAN` (PH-INVPC) les
         ;; publie deja en cumule et les remettre a zero changerait sa valeur. C'est la
         ;; DIFFERENCE entre deux lignes consecutives qui donne la fenetre.
         ;;   NATURE : `n` un COMPTE, `sumdepth` et `removed` des LONGUEURS CUMULEES (unites de
         ;;   jeu). `removed/sumdepth` est le rendement moyen `1 - cos^2(normale, radiale)` : a 1
         ;;   la poussee est entierement tangentielle (la contrainte de longueur n'en retire
         ;;   rien), a 0 elle est entierement radiale (la contrainte la confisque en totalite).
         (format 0 "PHYSAXTAN ax=~D nolen=~D n=~D sumdepth=~f removed=~f~%"
                 ax nolen (phys-tan-count) (phys-tan-depth) (phys-tan-eff))
         (set! (-> self pframe) 0)
         (phys-stats-reset!)
         ;; LE CONTROLE EST RENDU A 0 A CHAQUE SORTIE DE FENETRE. Un controle qui resterait arme
         ;; contaminerait toutes les mesures suivantes — c'est la faute que `phys-rest-k-set!`
         ;; evite deja de la meme facon.
         (phys-len-off-set! 0)
         (set! (-> self phase)
               (cond ((= (-> self phase) PHYSROOM-PH-AXV)  PHYSROOM-PH-AXB)
                     ((= (-> self phase) PHYSROOM-PH-AXB)  PHYSROOM-PH-AXL)
                     ((= (-> self phase) PHYSROOM-PH-AXL)  PHYSROOM-PH-AXZV)
                     ((= (-> self phase) PHYSROOM-PH-AXZV) PHYSROOM-PH-AXZB)
                     ((= (-> self phase) PHYSROOM-PH-AXZB) PHYSROOM-PH-AXZL)
                     (else PHYSROOM-PH-ORI))))))

    ;; ---- 4 quater. SPEC 10-13 — LES EQUILIBRES PAR ORIENTATION, ET LEUR CONTINUITE.
    ;; Chaque orientation est TENUE (aucun pilotage, aucune acceleration) le temps que la reponse
    ;; dynamique s'eteigne, puis mesuree. Ce qui est publie est l'ENTREE (la direction de la gravite
    ;; vue par le solveur dans le triedre de sa §7) A COTE de la SORTIE (les trois echelles et leur
    ;; determinant). Les deux ensemble, et sur neuf orientations, sont la seule forme qui puisse
    ;; repondre a sa §13 : une table de morphs figes rendrait des paliers, un equilibre continu
    ;; rend une courbe.
    ((= (-> self phase) PHYSROOM-PH-ORI)
     ;; ---- QUATRE PASSES SUR LE MEME BALAYAGE : LA MESURE, PUIS SES TROIS CONTROLES ----------
     ;; Le cycle 12 a mesure que la reponse de la chaine est REDRESSEE sur l'axe avant-arriere :
     ;; a stimulus tangentiel egal a 12-39 % pres, elle repond 8.7 a 30.3 fois plus quand la
     ;; gravite tire vers l'ARRIERE que vers l'AVANT, pendant que les paires LATERALES — meme
     ;; instrument, meme fenetre — restent entre 1.2 et 2.3. Aucune anisotropie ne produit ca.
     ;; Le cycle 12 a nomme le defaut et a ecrit qu'il ne devinait pas sa cause. Voici la mesure
     ;; qui la designe, au lieu d'une hypothese : on refait LE MEME balayage avec, tour a tour,
     ;; chacun des trois mecanismes suspects DESARME. Celui dont le desarmement rend le canal
     ;; symetrique est le coupable ; si aucun ne le fait, les trois sont innocentes et la liste
     ;; se reduit d'autant — ce qui est aussi un resultat.
     ;;   k=0  rien de desarme      -> la mesure de reference, IDENTIQUE au cycle 12
     ;;   k=1  contrainte de LONGUEUR levee   (`phys-len-off-set!`)
     ;;   k=2  contrainte de COTE levee       (`phys-side-off-set!`)
     ;;   k=3  rayon de capsule interpole     (`phys-cone-off-set!`) — sonde la FORME du volume
     ;;   k=4  MUR DE COLLISION desarme       (`phys-col-off-set!`)  — sonde son PLANCHER
     ;;   k=5  BORNE §22 DU CANAL RADIAL levee (`phys-rr-off-set!`)  — sonde son ECRETAGE
     ;;
     ;; k=5 EST NEUVE (cycle 28) ET ELLE EST LA SUITE DIRECTE DE L'ATTRIBUTION DE §12.
     ;; Le COM exact, publie desormais sur les CINQ passes (`PHYSCTLDF`/`PHYSCTLML`), designe
     ;; la CONTRAINTE DE LONGUEUR : k=1 fait passer le pole medial de `chestL` de 0.0807 a
     ;; 0.2141 B0 et celui de `chestR` de 0.0283 a 0.2095 — les deux ENTRENT dans la bande
     ;; 0.15-0.24 de sa §12 — pendant que k=2, k=3 et k=4 les laissent a x1.00. Le MUR DE
     ;; COLLISION est donc EXONERE de ce defaut-la, et l'hypothese du champ de contact permanent
     ;; est refutee par sa propre ablation.
     ;; Mais la contrainte de longueur ne peut pas etre retiree (sa §1bis : l'os ne s'allonge
     ;; pas). Ce qu'elle fait est CONFISQUER la composante du pilotage le long de l'os, a charge
     ;; pour le canal radial de §23 de la rendre. k=5 demande si ce canal la rend : desarmee, la
     ;; borne `rcap = 0.40 B0` laisse passer le brut, que `ROOM-RAD` mesure deja jusqu'a
     ;; 0.6843 B0 (43 % retires) avec `rrt` colle a 0.3999 sur les HUIT orientations non nulles
     ;; des DEUX chaines. Si le pole medial remonte avec lui, l'ecretage EST le mecanisme.
     ;;
     ;; k=4 EST NEUVE (cycle 14) ET ELLE COMBLE LE TROU QUE LE CYCLE 13 A NOMME. k=2 et k=3 sont
     ;; exoneres a quatre decimales, k=1 symetrise mais c'est le MECANISME (rehaussement radial
     ;; pur, donc isotrope dans son propre corps), pas la CAUSE de l'asymetrie. Le seul suspect qui
     ;; ait la bonne taille ET le bon signe — le mur plafonne a la profondeur d'auteur, avec la
     ;; pose d'auteur EXACTEMENT sur sa frontiere — n'etait desarme par AUCUNE des trois passes.
     ;; Voir [NOTE-53] de `jak-hd-physics-NOTES.md`.
     ;;
     ;; LA PASSE k=0 EST BIT POUR BIT CELLE DU CYCLE 12 : tous les emetteurs existants
     ;; (`PHYSORI`, `PHYSORI2/3/4`, `PHYSORICOM`, `PHYSORICOM2`, `PHYSORITR`) restent gardes par
     ;; `(zero? ok)`, donc le tableau et ses gates ne voient aucun changement. Les trois passes de
     ;; controle n'ajoutent que `PHYSORICTL`, un tag neuf que rien d'existant ne lit.
     (let ((oi (mod (-> self ori) PHYSROOM-ORIN))
           (ok (/ (-> self ori) PHYSROOM-ORIN)))
      (physroom-orient (-> *physroom-ori-ax* oi) (-> *physroom-ori-dg* oi))
      ;; le controle de CETTE passe, arme a sa premiere frame et jamais ailleurs
      (when (= (-> self pframe) 1)
        (phys-len-off-set!  (if (= ok 1) 1 0))
        (phys-side-off-set! (if (= ok 2) 1 0))
        (phys-cone-off-set! (if (= ok 3) 1 0))
        (phys-col-off-set!  (if (= ok 4) 1 0))
        (phys-rr-off-set!   (if (= ok 5) 1 0)))
     ;; ---- LE PIC TRANSITOIRE D'ETABLISSEMENT, PUIS LA REMISE A ZERO DE LA FENETRE -------------
     ;; Deux choses en un seul point, et elles vont ensemble :
     ;;
     ;; 1. `PHYSORITR` publie le maximum du canal radial sur les 60 frames d'ETABLISSEMENT, juste
     ;;    avant qu'elles soient effacees. C'est la seule ligne de sa spec qui parle d'un
     ;;    TRANSITOIRE d'orientation : §11 `HangingTransientLengthMax = 1.30` contre
     ;;    `HangingLengthScale = 1.23` en tenu. Sans cet emetteur le transitoire est perdu, et un
     ;;    depassement d'etablissement serait indistinguable de l'equilibre.
     ;;
     ;; 2. `phys-stats-reset!` remet la fenetre a zero A LA FIN DE L'ETABLISSEMENT. Sans lui, la
     ;;    POSITION MOYENNE de la pointe (`phys-tip-mean`) couvrirait les 60 frames de transitoire
     ;;    EN PLUS des 30 de mesure, et rendrait une moyenne de trajectoire au lieu d'un
     ;;    equilibre. `PH-TILT` fait deja exactement ca a `PHYSROOM-IDLES` (voir sa note) ; c'est
     ;;    la meme correction, au meme endroit du meme motif.
     ;;
     ;; POURQUOI 60 FRAMES SUFFISENT, et ce n'est pas une supposition : le mode principal livre
     ;; `omega = 14.4515 rad/s` et `zeta = 0.35` (SPEC 24/25, verifies par identite arithmetique
     ;; sur la donnee livree), donc une constante de temps `1/(zeta.omega) = 0.198 s`, soit 11.9
     ;; frames a 60 Hz. 60 frames = 5.05 constantes de temps, residu `e^-5.05 = 0.6 %`. Ce que
     ;; `PHYSORICOM` mesure ensuite est donc bien un EQUILIBRE, a 0.6 % pres, et non un transitoire.
     ;; `PHYSORITR` est la pour le prouver au lieu de le supposer : si le pic d'etablissement
     ;; n'excede pas le tenu, il n'y avait rien a attendre ; s'il l'excede, sa §11 le chiffre.
     ;;
     ;; AUCUNE LIGNE EXISTANTE N'EST TOUCHEE PAR CE RESET : `PHYSORI`, `PHYSORI2`, `PHYSORI3` et
     ;; `PHYSORI4` lisent toutes `phys-shape`, dont aucun des index publies (0-3, 8-11, 15-17) ne
     ;; figure dans `phys-stats-reset!`. Verifiable par diff du tableau avant/apres.
      (when (= (-> self pframe) PHYSROOM-ORIS)
       (when (zero? ok)
        (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
          (format 0 "PHYSORITR c=~D i=~D rrt=~,,7f~%"
                  c oi (phys-chain-radial (-> self slot) c 2)))))
       (phys-stats-reset!)
       ;; les compteurs de diagnostic couvrent la FENETRE DE MESURE et rien d'autre : sans ce
       ;; reset ils cumuleraient l'etablissement, ou vit justement le pic de §37.
       (phys-diag-reset!))
      (when (>= (-> self pframe) (+ PHYSROOM-ORIS PHYSROOM-ORIM))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (when (zero? ok)
         (format 0 "PHYSORI c=~D i=~D gx=~f gy=~f gz=~f~%"
                 c oi
                 (phys-shape (-> self slot) c 9)
                 (phys-shape (-> self slot) c 10)
                 (phys-shape (-> self slot) c 11))
         (format 0 "PHYSORI2 c=~D i=~D sx=~f sy=~f sz=~f det=~f~%"
                 c oi
                 (phys-shape (-> self slot) c 0)
                 (phys-shape (-> self slot) c 1)
                 (phys-shape (-> self slot) c 2)
                 (phys-shape (-> self slot) c 3))
         (format 0 "PHYSORI4 c=~D i=~D r0=~f r1=~f r2=~f~%"
                 c oi
                 (phys-shape (-> self slot) c 15)
                 (phys-shape (-> self slot) c 16)
                 (phys-shape (-> self slot) c 17))
         (format 0 "PHYSORI3 c=~D i=~D ax=~D deg=~f arm=~f~%"
                 c oi
                 (-> *physroom-ori-ax* oi)
                 (-> *physroom-ori-dg* oi)
                 (phys-shape (-> self slot) c 8))
         ;; ---- LA REPONSE STATIQUE, A COTE DE L'ENTREE STATIQUE ---------------------------------
         ;; CE QUE §10-§13 NOMMENT ET QUE PERSONNE N'A JAMAIS LU. Ses trois sections d'orientation
         ;; donnent chacune un DEPLACEMENT, pas seulement des echelles de forme :
         ;;     §10 supine   `SupineCOMDepth        = 0.23 B0`
         ;;     §11 prone    `HangingCOMDisplacement = 0.24 B0`
         ;;     §12 lateral  `SideGravityCOM         = 0.19 B0`
         ;; `PHYSORI2` ne publie que les ECHELLES (la forme). Le deplacement n'etait emis nulle
         ;; part dans cette phase — c'est le trou que le cycle 11 a nomme pour §11 et qui vaut en
         ;; realite pour les trois.
         ;;
         ;; ET C'EST AUSSI L'INSTRUMENT DE §29, QUI N'EN AVAIT AUCUN. Son preset nomme ses quatre
         ;; valeurs `VerticalCompliance / APCompliance / LateralCompliance / TorsionalCompliance` :
         ;; ce sont des COMPLIANCES, c'est-a-dire des deplacements par unite de force. Les mesurer
         ;; par des FREQUENCES melange raideur et masse et rend §24 et §29 sur-determinees l'une
         ;; par l'autre ; les mesurer ICI ne demande que des equilibres tenus. Neuf orientations
         ;; donnent neuf couples (direction de gravite, deplacement) : de quoi ajuster un tenseur
         ;; de compliance 3x3 et en lire l'anisotropie, avec son residu.
         ;;
         ;; DEUX CANAUX, ET ILS SONT ORTHOGONAUX PAR CONSTRUCTION — donc publies SEPAREMENT et
         ;; jamais additionnes en un seul nombre dont la nature serait ambigue :
         ;;   `tx/ty/tz` = position MOYENNE de la pointe sur la fenetre de mesure, ecart a la pose
         ;;      d'auteur. La contrainte de longueur lui confisque la composante le long de l'os :
         ;;      ce canal est donc TANGENTIEL, et c'est un deplacement d'APEX (le point que le
         ;;      solveur integre), pas de COM — §22 lui donne ses propres bandes (0.42 / 0.50 B0).
         ;;   `rr` = le canal radial de §23, le long de l'os, que la contrainte confisquait. Sa
         ;;      nature declaree est le deplacement de COM rapporte a B0 (§22 : 0.35 / 0.40).
         ;; NATURE : deux DEPLACEMENTS SOUTENUS (moyennes de fenetre), pas des variances — un
         ;; equilibre ne bouge plus, donc toute grandeur de dispersion y lit zero par construction.
         ;; REPERE : le triedre de SPEC 7 (+X lateral, +Y haut, +Z avant), celui-la meme dans
         ;; lequel `PHYSORI` publie deja `gx/gy/gz`. Les deux se lisent donc composante a composante.
         ;; UNITES : `tx/ty/tz` en unites de jeu (B0 = 602 est dans la trace, ligne `[HD-PHYS] b0`) ;
         ;; `rr` et `rrm` deja rapportes a B0.
         ;; LIGNE DE BASE : l'orientation i=0 est la pose debout d'auteur, ou §9 exige 0.0000 —
         ;; c'est la ligne de base MESUREE de ce bloc, pas une supposition, et si elle n'est pas
         ;; nulle toutes les autres sont decalees d'autant.
         (format 0 "PHYSORICOM c=~D i=~D tx=~f ty=~f tz=~f~%"
                 c oi
                 (phys-tip-mean (-> self slot) c 0)
                 (phys-tip-mean (-> self slot) c 1)
                 (phys-tip-mean (-> self slot) c 2))
         (format 0 "PHYSORICOM2 c=~D i=~D rr=~,,7f rrm=~,,7f n=~f~%"
                 c oi
                 (phys-chain-radial (-> self slot) c 1)
                 (phys-chain-radial (-> self slot) c 2)
                 (phys-stat (-> self slot) c 15))
         ;; ---- LA DEFORMATION EN ESPACE ANCRE, TELLE QUELLE ------------------------------------
         ;; Le cycle 26 a compose le COM de ses §10/§11/§12 en RECONSTRUISANT cette matrice hors
         ;; moteur depuis les trois echelles de `PHYSORI2` et le triedre. La reconstruction ne
         ;; couvrait que `dfa` : `dfb` (etirement dynamique, SPEC 38) et `dfc` (pression de contact,
         ;; SPEC 23) restaient DEHORS, et le COM publie n'etait donc que PARTIEL — il le disait.
         ;; Ces neuf nombres sont le produit COMPLET que le solveur applique, dans la base de
         ;; l'ancre : plus rien a reconstruire, plus rien a omettre.
         ;; NATURE : matrice sans dimension, rapport a la forme d'auteur. REPERE : base de l'ANCRE,
         ;; celle de `PHYSORICOML` — donc peau et joints se composent enfin dans le meme repere.
         ;; LECTURE HORS DEFAUT : diag(1,1,1) a l'orientation 0, ou §9 exige la pose d'auteur.
         ;; UNE LIGNE DE MATRICE PAR LIGNE DE TRACE : `format` est un appel de fonction et GOAL en
         ;; plafonne les parametres a 8, donc les neuf elements ne tiennent pas sur une ligne.
         (dotimes (r 3)
           (format 0 "PHYSDFMA c=~D i=~D r=~D m0=~,,6f m1=~,,6f m2=~,,6f~%"
                   c oi r
                   (phys-dfm-anc (-> self slot) c r 0)
                   (phys-dfm-anc (-> self slot) c r 1)
                   (phys-dfm-anc (-> self slot) c r 2)))
         ;; ---- LE DEPLACEMENT DE **CHAQUE MAILLON**, POUR QUE §10/§11/§12 SOIENT LUES SUR UN COM
         ;; Ses trois sections chiffrent un deplacement de CENTRE DE MASSE (`SupineCOMDepth 0.23`,
         ;; `HangingCOMDisplacement 0.24`, `SideGravityCOM 0.19`, en B0). `PHYSORICOM` ci-dessus ne
         ;; sait publier que l'APEX — le point que le solveur integre — et le declare lui-meme comme
         ;; une BORNE SUPERIEURE : sous une rotation autour de l'ancre un apex se deplace plus qu'un
         ;; COM. Comparer l'un a la cible de l'autre est le piege `instrument-axis-vs-complaint`, et
         ;; c'est pour ca que le rapport du cycle 20 refuse de RE-REGLER §10/§12 avant d'avoir fait
         ;; bouger l'instrument. Depuis que la structure de §23 est posee, l'organe porte DEUX
         ;; maillons : le COM devient calculable au lieu d'etre borne.
         ;;   Sous skinning lineaire, le deplacement d'un sommet est la somme ponderee de ceux de
         ;;   ses joints ; dans le repere de l'ancre un joint NON simule a un ecart identiquement
         ;;   nul (il ne s'ecarte pas de la pose d'auteur). Donc, sur l'organe :
         ;;       d_COM = ( W_0 . d_0 + W_1 . d_1 ) / N
         ;;   ou W_j = somme des poids de peau du joint j et N = nombre de sommets de l'organe,
         ;;   TOUS TROIS MESURES SUR LE MESH LIVRE par `.autoport/probe_breast_com_mass.py` — aucune
         ;;   valeur choisie. Cette ligne fournit les d_j, et rien d'autre.
         ;; NATURE : un DEPLACEMENT SOUTENU (l'equilibre est tenu a 0.6 % sur cette fenetre, cf. la
         ;;   note de PHYSROOM-ORIM), en unites de jeu — pas une variance, pas une amplitude.
         ;; REPERE : le triedre de l'ANCRE dans l'ordre de SPEC 24 (v, ap, lat), celui de
         ;;   `phys-link-dev-anc-abs` — PAS l'ordre (x,y,z) de SPEC 7 qu'emploie `PHYSORICOM`. Les
         ;;   deux triedres sont orthonormes, donc la NORME se compare directement d'une ligne a
         ;;   l'autre ; les composantes, elles, ne se melangent pas. Le tableau ne compose que des
         ;;   normes, et son CONTROLE est precisement la : |d| du maillon de pointe lu ici doit
         ;;   retomber sur |t| de `PHYSORICOM`, qui vient d'un autre accumulateur et d'un autre
         ;;   triedre. Un ecart entre les deux mesure l'erreur du montage, il ne se corrige pas.
         ;; LIGNE DE BASE : l'orientation i=0 est la pose debout d'auteur, ou §9 exige 0.0000.
         (dotimes (l (phys-chain-links (-> self slot) c))
           (format 0 "PHYSORICOML c=~D i=~D l=~D dv=~f dap=~f dlat=~f~%"
                   c oi l
                   (phys-link-dev-anc-abs (-> self slot) c l 0)
                   (phys-link-dev-anc-abs (-> self slot) c l 1)
                   (phys-link-dev-anc-abs (-> self slot) c l 2))))
         ;; ---- LA MEME REPONSE, PASSE PAR PASSE : c'est le corps de l'experience -------------
         ;; Emis sur les QUATRE passes, y compris k=0, pour que la comparaison se fasse entre
         ;; lignes de MEME nature et de MEME emetteur. Comparer une passe de controle a la ligne
         ;; `PHYSORICOM` de reference marcherait aussi, mais ferait dependre le verdict de deux
         ;; formats differents — et c'est le genre d'ecart qui se paie.
         ;; `inv`/`flip`/`retreat` sont les compteurs de la FENETRE DE MESURE (remis a zero a
         ;; `PHYSROOM-ORIS`) : ils disent si une COLLISION ou un LIMITEUR a mordu pendant
         ;; l'equilibre. Une reponse redressee accompagnee d'un compteur asymetrique designe le
         ;; mecanisme ; une reponse redressee avec des compteurs a zero des deux cotes l'exclut.
         (format 0 "PHYSORICTL c=~D k=~D i=~D tx=~f ty=~f tz=~f~%"
                 c ok oi
                 (phys-tip-mean (-> self slot) c 0)
                 (phys-tip-mean (-> self slot) c 1)
                 (phys-tip-mean (-> self slot) c 2))
         ;; `format` de GOAL est cape a SIX parametres apres la chaine — `retreat` part donc sur
         ;; sa propre ligne plutot que d'etre sacrifie. C'est la meme contrainte qui a deja
         ;; impose de scinder `PHYSRAD` / `PHYSRADSAT`.
         (format 0 "PHYSORICTL2 c=~D k=~D i=~D rr=~,,7f inv=~f flip=~f~%"
                 c ok oi
                 (phys-chain-radial (-> self slot) c 1)
                 (phys-diag (-> self slot) c 3)
                 (phys-diag (-> self slot) c 2))
         ;; CYCLE 36 : `retreat=` retire ici aussi — meme emplacement 1 sans ecrivain.
         (format 0 "PHYSORICTL3 c=~D k=~D i=~D shape=~f~%"
                 c ok oi
                 (phys-diag (-> self slot) c 8))
         ;; ---- LES DEUX INGREDIENTS DU **COM EXACT**, SUR LES CINQ PASSES ---------------------
         ;; POURQUOI CET AJOUT, ET C'EST UN TROU D'INSTRUMENT, PAS UN MANQUE DE MESURE.
         ;; §12 lateral est SOUS sa bande d'UN POLE PAR SEIN, en miroir (chestL i=2 0.0807,
         ;; chestR i=4 0.0283, cibles 0.19). Le cycle 27 a nomme ce defaut « le prochain chantier
         ;; de physique » et l'a laisse SANS CAUSE. L'appareil qui existe pour attribuer une cause
         ;; est le balayage a cinq passes ci-dessus (k=0 reference, k=1..4 un mecanisme desarme
         ;; chacun) — mais il ne publie que `PHYSORICTL`, c'est-a-dire l'APEX. Or l'apex est
         ;; AVEUGLE a ce defaut precis : sur les deux poles lateraux de `chestL` il rend
         ;; 0.34999 / 0.34112, soit 2.6 % d'ecart, la ou le COM exact en rend 0.0807 / 0.1862,
         ;; un facteur 2.31. L'ablation ne peut donc pas voir le defaut qu'elle est censee
         ;; attribuer, et ses quatre verdicts « SYMETRISE — CE MECANISME EST LA CAUSE » sont
         ;; vacuous par construction : la reference elle-meme est deja symetrique SUR CETTE
         ;; GRANDEUR-LA. « Une mesure qui ne peut pas voir ce qu'elle mesure ne vaut rien. »
         ;;
         ;; CE QUI EST EMIS, ET RIEN D'AUTRE : les deux entrees que `probe_oricom_exact.py`
         ;; consomme deja pour la passe de reference — la deformation complete en espace ancre
         ;; (`phys-dfm-anc`, l'equivalent de `PHYSDFMA`) et l'ecart par maillon
         ;; (`phys-link-dev-anc-abs`, l'equivalent de `PHYSORICOML`). Memes accesseurs, memes
         ;; unites, meme repere : la passe k=0 de ces lignes doit reproduire `PHYSDFMA` et
         ;; `PHYSORICOML` AU BIT PRES, et c'est le controle interne de l'ajout.
         ;;
         ;; NATURE : `df` matrice sans dimension (rapport a la forme d'auteur) ; `ml` deplacement
         ;; soutenu par maillon, en unites de jeu, RELATIF AU PARENT (cumul telescopique a faire
         ;; en aval, comme pour `PHYSORICOML`). REPERE : base de l'ANCRE pour les deux.
         ;; LIGNE DE BASE : a i=0 (pose debout d'auteur) `df` = diag(1,1,1) et `ml` = 0 — §9.
         ;;
         ;; INDICE COMPOSE, ET POURQUOI : `format` n'accepte que SIX parametres apres la chaine
         ;; (`PHYSDFMA` en use exactement six), or il en faudrait sept avec `k` ET `r`. On plie
         ;; donc les deux petits indices en un seul, EN BASE DIX pour qu'il reste lisible a l'oeil
         ;; dans la trace : `kr = 10*k + r` donne 0,1,2 · 10,11,12 · ... · 40,41,42, et
         ;; `kl = 10*k + l` donne 0,1 · 10,11 · ... · 40,41. Le decodage est `k = kr/10`,
         ;; `r = kr mod 10`, et l'aval DOIT verifier que `r < 3` / `l < PHYS-LINKS` avant d'y
         ;; croire — un indice compose mal relu est un piege deja paye sur ce dossier.
         (dotimes (r 3)
           (format 0 "PHYSCTLDF c=~D kr=~D i=~D m0=~,,6f m1=~,,6f m2=~,,6f~%"
                   c (+ (* 10 ok) r) oi
                   (phys-dfm-anc (-> self slot) c r 0)
                   (phys-dfm-anc (-> self slot) c r 1)
                   (phys-dfm-anc (-> self slot) c r 2)))
         (dotimes (l (phys-chain-links (-> self slot) c))
           (format 0 "PHYSCTLML c=~D kl=~D i=~D dv=~f dap=~f dlat=~f~%"
                   c (+ (* 10 ok) l) oi
                   (phys-link-dev-anc-abs (-> self slot) c l 0)
                   (phys-link-dev-anc-abs (-> self slot) c l 1)
                   (phys-link-dev-anc-abs (-> self slot) c l 2)))))
       (+! (-> self ori) 1)
       (set! (-> self pframe) 0)
       (phys-stats-reset!)
       (when (>= (-> self ori) (* 6 PHYSROOM-ORIN))
         ;; LES QUATRE CONTROLES SONT RENDUS AVANT DE SORTIR. Un controle laisse arme
         ;; contaminerait tout le reste de la course — c'est la faute que `phys-len-off-set!`
         ;; evite deja de la meme facon a la sortie des fenetres d'axe.
         (phys-len-off-set! 0)
         (phys-side-off-set! 0)
         (phys-cone-off-set! 0)
         (phys-col-off-set! 0)
         (phys-rr-off-set! 0)
         (set! (-> self phase) PHYSROOM-PH-SHAKE)))))

    ;; ---- 4 ter. ON SECOUE, PUIS ON RELACHE — le cycle ferme dans le regime ou le defaut vit.
    ;; ---- Voir la note de PHYSROOM-PH-SHAKE : le cycle `tilt` est quasi-statique et n'exerce pas
    ;; ---- les termes a memoire ; celui-ci les exerce.
    ((= (-> self phase) PHYSROOM-PH-SHAKE)
     (physroom-drive 3 (-> self pframe))            ;; `jerk` : vitesse posee d'un coup, arrets brutaux
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self phase) PHYSROOM-PH-SHAKEN)
       (set! (-> self pframe) 0)))

    ((= (-> self phase) PHYSROOM-PH-SHAKEN)
     (physroom-hold)
     ;; ---- §36 ET §29-TORSION — LA SERIE LIBRE DES DEUX MODES SCALAIRES ----------------------
     ;; LE FAUX VERT DU CYCLE 11 VENAIT D'ICI, ET IL FAUT LE DIRE : sa §36 etait rapportee
     ;; « zeta 0.65 » parce que la constante `PHYS-SEC-Z` vaut 0.65 — le piege
     ;; `declared-but-never-selected`. Le cycle 11 l'a corrige au niveau des COEFFICIENTS (les
     ;; deux nombres sont imprimes a l'init et le polynome caracteristique donne 0.6502 / 5.1995
     ;; Hz), et a ecrit lui-meme que ce n'est PAS la meme chose qu'observer 5.20 Hz dans une
     ;; serie. Voici la serie. C'est le seul endroit de la course ou les deux modes decroissent
     ;; LIBREMENT : `physroom-hold` fige la position ET l'orientation, et cette phase n'appelle
     ;; PAS `physroom-advance-anim` — l'animation ne les excite donc plus, contrairement aux
     ;; fenetres par animation ou §27 lit un plancher d'excitation au lieu d'un ring-down.
     ;; Ce qui precede est `PH-SHAKE` (`jerk`, vitesse posee d'un coup) : sa §36 demande
     ;; precisement « after a change in direction of the global breast mass ».
     ;;
     ;; NATURE : deux SERIES TEMPORELLES, une valeur signee par frame — pas des maximums. C'est
     ;; ce qui permet d'en ajuster frequence et amortissement ; `secm`/`twm`, qui sont des
     ;; maximums de fenetre, ne le permettent pas et c'est pour ca qu'ils ont laisse passer
     ;; le faux vert. `s` = modulation d'epaisseur de §36 (fraction, sans dimension) ;
     ;; `tw` = torsion relative de §29 (radians).
     ;; REPERE : la racine de la chaine. LIGNE DE BASE : 0.0 exactement au repos.
     ;;
     ;; CE QUE LA SERIE PEUT MONTRER ET QUE LES COEFFICIENTS NE PEUVENT PAS : `*phys-sec*` est
     ;; ECRETE A `PHYS-SEC-MAX` **DANS L'ETAT** (`(set! (-> *phys-sec* sc) smc)`), pas seulement
     ;; en sortie. Un ecretage a l'interieur de la boucle n'est pas une borne d'affichage : il
     ;; change la dynamique, et le mode livre cesse d'etre l'oscillateur dont le polynome donne
     ;; 0.6502. Le cycle 11 a mesure que ce plafond est atteint sur 6 fenetres sur 10. La serie
     ;; le rend lisible : tout echantillon a |s| = 0.0700000 est ECRETE, et l'ajustement ne doit
     ;; porter que sur les autres. Sa §37 demande d'ailleurs l'inverse de cet ecretage
     ;; (« soft displacement clamps should be preferred to abrupt positional clamps »).
     ;; 90 frames = 7.8 periodes amorties du mode a 5.2 Hz (T_d = 15.2 frames a zeta 0.65) :
     ;; assez pour le premier depassement, qui est ce qui porte zeta, et pour voir le plancher.
     (when (<= (-> self pframe) 90)
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSSEC c=~D f=~D s=~,,7f tw=~,,7f~%"
                 c (-> self pframe)
                 (phys-shape (-> self slot) c 4)
                 (phys-shape (-> self slot) c 6)))))
     ;; ---- §27 — LA FENETRE QUE LE CYCLE 11 A NOMMEE SANS LA CONSTRUIRE --------------------
     ;; Sa §27 commence par « AFTER ONE STRONG ISOLATED IMPULSE » et donne une echelle complete :
     ;; reponse dominante 0.3-0.6 s, mouvement secondaire 0.6-1.2 s, essentiellement stabilise
     ;; 1.0-1.5 s, immobile 1.3-1.7 s. Jusqu'ici §27 etait lue sur les fenetres PAR ANIMATION,
     ;; ou les 31 animations continuent d'exciter la chaine : le cycle 11 a montre que `t1` et
     ;; `t05` y sortaient CENSURES a `>2.48 s` alors que la theorie donne 1.05 s a zeta = 0.35 —
     ;; c'est-a-dire que la fenetre ne mesurait pas un ring-down mais le plancher d'excitation de
     ;; l'animation. Il a ecrit : « je n'ai pas construit la fenetre qui le mesurerait ». La voici,
     ;; et c'est la MEME que celle du mode secondaire ci-dessus, pour la meme raison : `PH-SHAKE`
     ;; est une impulsion isolee et forte (`jerk`), `PH-SHAKEN` fige position, orientation ET
     ;; animation. Rien ne re-excite la chaine pendant la decroissance.
     ;; 150 frames = 2.50 s, soit tout l'escalier de sa §27 avec de la marge au-dela du dernier
     ;; barreau (1.7 s) : sans cette marge, « immobile a 1.7 s » ne serait pas distinguable de
     ;; « fenetre trop courte », qui est exactement la censure qu'on corrige.
     ;; NATURE : une SERIE TEMPORELLE signee de la deviation du maillon a sa pose d'auteur, par
     ;; axe — pas une amplitude agregee : c'est la decroissance de l'ENVELOPPE qui porte §27.
     ;; REPERE : le triedre de l'ANCRE (SPEC 7), identique a `PHYSRINGA` (voir sa note) — les deux
     ;; series sont donc directement comparables, et leur ECART mesure ce que l'animation ajoutait.
     ;; LIGNE DE BASE : 0.0 sur toute la longueur quand la chaine est sur la pose d'auteur.
     (when (<= (-> self pframe) 150)
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (dotimes (l (phys-chain-links (-> self slot) c))
           (format 0 "PHYSRINGSH c=~D f=~D l=~D v=~,,7f ap=~,,7f lat=~,,7f~%"
                   c (-> self pframe) l
                   (phys-link-dev-anc (-> self slot) c l 0)
                   (phys-link-dev-anc (-> self slot) c l 1)
                   (phys-link-dev-anc (-> self slot) c l 2))))))
     (when (= (-> self pframe) PHYSROOM-IDLES) (phys-stats-reset!))
     (when (>= (-> self pframe) (+ PHYSROOM-IDLES PHYSROOM-IDLEM))
       ;; meme etablissement et meme fenetre que `idle` et `back` : les trois poses sont comparables.
       (physroom-emit-mean "shaken")
       (set! (-> self phase) PHYSROOM-PH-SHAKEPC)
       (set! (-> self pframe) 0)
       (phys-side-off-set! 1)                       ;; CONTROLE POSITIF : contrainte de cote LEVEE
       (phys-stats-reset!)))

    ((= (-> self phase) PHYSROOM-PH-SHAKEPC)
     (physroom-drive 3 (-> self pframe))            ;; MEME secousse, meme duree : seule la garde differe
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self phase) PHYSROOM-PH-SHAKENPC)
       (set! (-> self pframe) 0)))

    ((= (-> self phase) PHYSROOM-PH-SHAKENPC)
     (physroom-hold)
     (when (= (-> self pframe) PHYSROOM-IDLES) (phys-stats-reset!))
     (when (>= (-> self pframe) (+ PHYSROOM-IDLES PHYSROOM-IDLEM))
       (physroom-emit-mean "shakenpc")
       (phys-side-off-set! 0)                       ;; on DESARME : la suite de la course est normale
       (set! (-> self phase) PHYSROOM-PH-PCOFF)
       (set! (-> self pframe) 0)
       (phys-inject-set! 0.0)
       (phys-inject-count-reset!)
       (phys-stats-reset!)
       ;; [NOTE-150] la fenetre DESARMEE du controle positif doit partir d'un maximum de peau VIDE,
       ;; sinon `skinadd` y arriverait deja charge par les fenetres precedentes et le controle
       ;; comparerait deux cumuls au lieu de deux fenetres.
       (phys-skinpen-reset!)))

    ;; ---- 5. CONTROLE POSITIF, branche DESARMEE : la penetration telle qu'elle est ------------
    ((= (-> self phase) PHYSROOM-PH-PCOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       ;; [NOTE-155] `dis` NE VIENT PLUS DE CETTE FENETRE. L'injection etait posee EN PLACE dans
       ;; l'etat porte d'une frame a l'autre, donc les deux branches comparaient deux TRAJECTOIRES
       ;; et non deux mesures : c'est ce qui rendait 110.85 u pour 400 u injectes. La sonde
       ;; appariee mesure les deux valeurs sur LA MEME frame, dans la fenetre ARMEE ; cette
       ;; fenetre-ci ne sert plus qu'a publier la peau desarmee.
       ;; [NOTE-150] la BRANCHE DESARMEE du controle, cote PEAU. `physroom-emit-diag` publie
       ;; `PHYSSKIN skinadd=` puis remet le maximum a zero, donc la branche ARMEE qui suit mesure
       ;; SA fenetre et rien d'autre. Les colonnes PHYSDIAG* de ces deux tags sont, elles, des
       ;; CUMULS depuis la derniere remise a zero du diagnostic : elles ne sont pas per-fenetre et
       ;; aucun verdict ne s'en tire.
       (physroom-emit-diag "pcoff")
       (set! (-> self phase) PHYSROOM-PH-PCON)
       (set! (-> self pframe) 0)
       (phys-inject-count-reset!)
       (phys-stats-reset!)
       ;; on POSE le defaut : chaque lien libre est pousse de 400 unites (~10 cm) vers l'interieur
       ;; du corps APRES resolution. Si le compteur de penetration ne monte pas, il ne mesure rien.
       (phys-inject-set! PHYSROOM-INJECT)))

    ;; ---- 6. CONTROLE POSITIF, branche ARMEE --------------------------------------------------
    ((= (-> self phase) PHYSROOM-PH-PCON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       ;; [NOTE-459] LA PAIRE, ET PLUS DEUX MAXIMA INDEPENDANTS. Ce qui est publie comme
       ;; `armed`/`disarmed` est desormais le COUPLE releve a l'argmax de la reponse appariee
       ;; `w - b` : meme LIEN, meme FRAME, meme regime d'offset, meme fonction de mesure. Les deux
       ;; anciens maxima independants restent publies a cote (`armedmax`/`disarmedmax`) : rien
       ;; n'est retire, c'est la LIGNE DE VERDICT qui change de grandeur.
       ;; POURQUOI : mesure sur trois etats de solveur genuinement differents, meme injection de
       ;; 400 u — `armed` varie de 1,4 % pendant que `disarmed` varie de 375,6 %. Leur difference
       ;; mesurait donc la LIGNE DE BASE, pas l'injection.
       (let ((b PHYS-NOCONTACT) (a PHYS-NOCONTACT) (r PHYS-NOCONTACT)
             (pa PHYS-NOCONTACT) (pb PHYS-NOCONTACT))
         (dotimes (c (-> self nchain))
           (when (> (phys-chain-links (-> self slot) c) 0)
             (let ((bb (phys-pc-base (-> self slot) c))
                   (aa (phys-pc-inj  (-> self slot) c))
                   (rr (phys-pc-pair (-> self slot) c 0)))
               (when (> bb b) (set! b bb))
               (when (> aa a) (set! a aa))
               (when (> rr r)
                 (set! r rr)
                 (set! pa (phys-pc-pair (-> self slot) c 1))
                 (set! pb (phys-pc-pair (-> self slot) c 2))))))
         (set! (-> self dis) (if (> r PHYS-NOCONTACT-LIMIT) pb b))
         (set! (-> self arm) (if (> r PHYS-NOCONTACT-LIMIT) pa a))
         (set! (-> self armx) a)
         (set! (-> self disx) b))
       (physroom-emit-diag "pcon")                  ;; [NOTE-150] la branche ARMEE, cote PEAU
       (set! (-> self injn) (phys-inject-count))
       (phys-inject-set! 0.0)
       (set! (-> self phase) PHYSROOM-PH-AUTHPC)
       (set! (-> self pframe) 0)))

    ;; ---- 7. L'ANIMATION D'AUTEUR (SPEC 5) : d'abord le bilan de la course, ensuite un CONTROLE
    ;; ---- POSITIF. Le controle retarde l'animation d'une frame dans la position ecrite — le defaut
    ;; ---- exact que la SPEC interdit — et le compteur d'identite doit s'effondrer. Un compteur qui
    ;; ---- ne bouge pas sous le defaut ne mesure rien, et le zero qu'il annonce ne vaut rien.
    ((= (-> self phase) PHYSROOM-PH-AUTHPC)
     (when (= (-> self pframe) 1)
       ;; CYCLE 36 — QUATRE COMPTEURS DE LIMITEUR SANS AUCUN ECRIVAIN SONT PARTIS D'ICI.
       ;; `*phys-retreat-n*`, `*phys-retreat-sum*`, `*phys-retfb-n*` et `*phys-sphere-n*` sont
       ;; DEFINIS, PUBLIES et REMIS A ZERO — et rien, nulle part, ne les incremente (verifie par
       ;; grep sur les quatre noms : une definition, une lecture, une remise a zero, zero
       ;; ecriture). Ils datent de `phys-retreat-chain`, retiree le 2026-08-13.
       ;; ET CE N'EST PAS UN DETAIL DE MENAGE : le rapport du cycle 35 a publie « limiteurs :
       ;; recul 0 fois, plafond-taille 0 fois — aucun suppresseur n'a tire » comme un ACQUIS. La
       ;; PREMIERE MOITIE de cette phrase (« recul 0 fois ») reposait sur `retreat_n`/`retreat_sum`,
       ;; donc sur un zero de domaine VIDE : elle est retiree. La SECONDE (« plafond-taille 0 fois »)
       ;; repose sur `raddrop_n`/`raddrop_sum`, qui ONT un ecrivain (:1263-1264) : elle tient, et je
       ;; le dis aussi precisement que je retire l'autre. `buried` (:2194) a un ecrivain lui aussi.
       (format 0 "PHYSLIM raddrop_n=~f raddrop_sum=~f buried=~f~%"
               (phys-limiter 2) (phys-limiter 3) (phys-limiter 4))
       ;; CYCLE 36 : `PHYSLIM2` retiree en entier — elle ne portait que `retreat_fallback`,
       ;; c'est-a-dire `*phys-retfb-n*`, sans ecrivain.
       ;; CETTE LIGNE PUBLIAIT UN CHIFFRE QUI N'EXISTE PAS DANS LE MOTEUR. Elle lisait
       ;; `(phys-limiter 6)` et `(phys-limiter 7)` sous les noms `radial_n` / `radial_sum` ; il n'y a
       ;; AUCUN compteur radial dans jak-hd-physics.gc, ces deux index tombent donc dans la branche
       ;; `else` et rendaient tous les deux `*phys-buried-n*`. La course du 2026-08-12 le dit au
       ;; chiffre pres :
       ;;     PHYSLIM  buried=987636       PHYSLIM3  radial_n=987636  radial_sum=987636
       ;; et le tableau en tirait « part radiale de la force, ecartee : 987623 fois, 987623.0000
       ;; u/frame^2 au total soit 1.0000 par declenchement ». Un ratio de 1.0000 etait la signature :
       ;; c'etait le meme compteur divise par lui-meme. Trois etiquettes pour une seule grandeur,
       ;; dont deux fausses.
       ;;
       ;; A SA PLACE, LE BALAYAGE DE SPHERE DU RECUL — un vrai compteur, et le pendant exact de
       ;; `retreat_fallback` : meme evenement declencheur (le point de depart du modele penetre),
       ;; l'un compte les sauvetages, l'autre les renoncements. NATURE : un compte d'evenements sur
       ;; la course. REPERE : sans objet (ce n'est pas une grandeur geometrique). LECTURE QUAND LE
       ;; DEFAUT EST ABSENT : zero des deux cotes — la pose du modele est admissible et l'arc suffit.
       ;; CYCLE 36 : `PHYSLIM3` retiree en entier — `sphere_n` est `*phys-sphere-n*`, sans
       ;; ecrivain. La mise en garde ci-dessus reste ecrite : elle raconte comment DEUX etiquettes
       ;; fausses ont deja vecu sur cette ligne, et c'est la troisieme fois qu'elle se vide.
       ;; SPEC 21/22 — CE QUE LA SATURATION D'EXCURSION A RETIRE. NATURE : `sat_n` est un compte
       ;; d'evenements sur la course, `sat_sum` une LONGUEUR cumulee en unites de jeu. REPERE : une
       ;; magnitude de deplacement, invariante par rotation. LECTURE QUAND LE DEFAUT EST ABSENT :
       ;; `sat_n=0` — la poitrine est restee sous le `HardMaxApexDisplacement = 0.50 B0` de l'owner
       ;; et rien n'a ete borne. C'est le chiffrage que la SPEC 7 du contrat exige de tout
       ;; suppresseur : sans lui, « borne » et « brime » seraient indiscernables.
       ;; `stif_n` (SPEC 21 sous forme de FORCE) est d'une autre NATURE : un compte de SOUS-PAS
       ;; integres au-dela du genou 0.42 B0, sans `sum` parce qu'un ressort ne retire rien. Les deux
       ;; se lisent ENSEMBLE : `stif_n` grand avec `sat_n` effondre = la force fait le travail et le
       ;; filet ne sert plus. `sat_n` qui reste haut = le ressort est mal pose.
       (format 0 "PHYSLIM4 sat_n=~f sat_sum=~f stif_n=~f~%"
               (phys-limiter 9) (phys-limiter 10) (phys-limiter 6))
       ;; LE MUR DU POINT LIBRE de §21/§22 (cycle 34 etape 2). MEME NATURE que `sat_n`/`sat_sum` :
       ;; un COMPTE d'evenements et une LONGUEUR cumulee en unites de jeu, sur toute la course.
       ;; REPERE : une magnitude de deplacement, invariante par rotation. LECTURE QUAND LE DEFAUT
       ;; EST ABSENT : `wall_n=0` — le tissu n'est jamais sorti de sa bande de 0.40 B0, et ce n'est
       ;; PAS « le mecanisme est absent » : il est identite stricte sous 0.336 B0 par construction
       ;; de `phys-softmin`. Sa §7 exige ce chiffrage de tout suppresseur, sans quoi « borne » et
       ;; « brime » sont indiscernables — et ici la distinction se lit sur `ROOM-RAD-FLESH`, qui
       ;; publie ce que chaque canal vaut AVANT (course precedente) et APRES.
       (format 0 "PHYSLIMW wall_n=~f wall_sum=~f~%"
               (phys-limiter 11) (phys-limiter 12))
       ;; QUEL VOLUME CONTRAINT QUEL MAILLON, sur toute la course. Une ligne par triplet non nul :
       ;; c'est la question que trois cycles ont posee sans instrument (« lbang est en contact
       ;; 17893 frames sur 17893 avec un AUTRE volume, non identifie »), et depuis le 2026-08-14
       ;; l'index du MAILLON n'est plus jete a l'ecriture — deux cycles ont bute sur « lequel des
       ;; deux maillons du sein viole ? » sans pouvoir y repondre.
       ;;   NATURE  : un COMPTE de triplets (frame, MAILLON, volume) ou ce volume-la demandait une
       ;;             correction cette frame (`res > 0`). Ni une distance, ni une amplitude — et un
       ;;             contact a profondeur nulle n'en est pas un.
       ;;   REPERE  : celui du VOLUME TESTE (le solide `ci`, dans son repere anime), puisque c'est
       ;;             contre lui que la profondeur `res` est evaluee.
       ;;   ABSENT  : aucune ligne pour ce maillon — aucun volume ne l'a jamais contraint.
       ;; Le nom du volume est deja publie par `PHYSCOL ci= j= j2=`, on n'imprime donc que l'index.
       ;; La borne des maillons vient de `phys-chain-links`, JAMAIS de `PHYS-LINKS` : une chaine a
       ;; 2 maillons publierait sinon deux colonnes vides indistinguables d'un zero mesure.
       (dotimes (c (-> self nchain))
         (let ((nl (phys-chain-links (-> self slot) c)))
           (when (> nl 0)
             (dotimes (ci (phys-slot-colliders (-> self slot)))
               (dotimes (l nl)
                 (let ((n (phys-chain-vol (-> self slot) c l ci)))
                   (when (> n 0)
                     (format 0 "PHYSCVOL c=~D l=~D ci=~D n=~D max=~f~%" c l ci n
                             (phys-chain-volmax (-> self slot) c l ci)))))))))
       ;; `max=` — CYCLE 59 [NOTE-146]. LA COLONNE QUI MANQUAIT DEPUIS 44 CYCLES.
       ;;   NATURE  : une LONGUEUR en unites de jeu (4096 u = 1 m), MAXIMUM DE COURSE du residu
       ;;             signe `res = dep - feff` pour CE couple (maillon, volume). Meme grandeur et
       ;;             memes unites que la colonne `meshpen` du tableau, qui n'en publie que le
       ;;             maximum GLOBAL — d'ou l'impossibilite, jusqu'ici, de dire ce que vaudrait le
       ;;             residu si on retirait le volume qui porte ce maximum.
       ;;   REPERE  : celui du VOLUME TESTE, comme `res` : la profondeur y est evaluee.
       ;;   ABSENT  : pas de ligne du tout (le couple n'a jamais eu `res > 0`), jamais un `max=0`.
       ;;   CONTROLE: `*phys-col-off*` (controle k=4) passe `feff` a PHYS-VOL-FREE, donc `res` tres
       ;;             negatif, donc AUCUNE ligne. Le compteur tombe avec le mur, il ne survit pas.
       ;; POURQUOI CE N'EST PAS UN DOUBLON DE `PHYSDIAG6 worstres/worstci` : celui-la est un ARGMAX
       ;; — il repond DANS une frame et ne dit rien d'une POPULATION. Le registre porte le piege
       ;; sous `argmax-anchor-is-not-a-population`, et le dossier COLLIDE le paie : cinq familles de
       ;; correctifs ont vise « le volume fautif » sans jamais savoir si le second etait a 5 % ou a
       ;; 80 % du premier.
       ;; QUELS VOLUMES SE DISPUTENT QUEL LIEN — l'attribution que `PHYSCVOL` ne peut pas donner,
       ;; parce qu'il ne se remplit que pendant la fenetre de controle positif (mesure du
       ;; 2026-08-13 : `meshpen_max=0.0000` sur toutes les phases de mesure). Celui-ci vient de la
       ;; passe de SELECTION, donc de toute la course.
       ;;   NATURE  : un COMPTE de triplets (frame, lien, volume) ou ce volume etait l'un d'au moins
       ;;             DEUX a contraindre le meme lien. Ni une distance, ni une amplitude.
       ;;   REPERE  : sans objet (c'est un compte).
       ;;   ABSENT  : 0 — le lien n'a jamais eu plus d'un volume a la fois, donc rien a arbitrer.
       ;;   CONTROLE: le desarmement de `*phys-prio-meas*`, qui doit rendre TOUTE la colonne a zero.
       (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
           (dotimes (ci (phys-slot-colliders (-> self slot)))
             (let ((n (phys-chain-conf (-> self slot) c ci)))
               (when (> n 0)
                 (format 0 "PHYSCFVOL c=~D ci=~D n=~D~%" c ci n))))))
       ;; SPEC 33 — LE DOMAINE DE CHAQUE PAIRE, ET PAS SEULEMENT SES CONTACTS.
       ;; Le cycle 7 a publie « 0 contact sein<->sein sur 2978 » puis a ecrit lui-meme, dans ses
       ;; non-prouves, que la cause geometrique n'etait PAS etablie. Un zero dont on ignore le
       ;; domaine ne prouve rien : la paire a-t-elle failli se toucher, ou est-elle restee a
       ;; un demi-metre ? Cette ligne repond, a l'execution, pour TOUTE paire effectivement testee.
       ;;   NATURE  : `dm` et `fl` sont des LONGUEURS (unites de jeu, 4096 u = 1 m), pas des comptes.
       ;;             `dm` = profondeur d'approche MAXIMALE atteinte sur toute la course ;
       ;;             `fl` = le plancher que la paire tolere (sa profondeur A LA POSE D'AUTEUR).
       ;;   REPERE  : monde.
       ;;   ABSENT  : `dm` NEGATIF — les deux surfaces ne se sont jamais rejointes, et |dm| EST
       ;;             l'ecart minimal atteint entre elles. `dm > fl` est la condition de contact.
       ;;   DISCRIMINANT : `ok=0` veut dire que la paire n'a JAMAIS ete echantillonnee (exclusion
       ;;             structurelle, joint hors squelette) — a ne pas lire comme « 0 mesure ».
       (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
           (dotimes (ci (phys-slot-colliders (-> self slot)))
             (when (> (phys-chain-vol-dom (-> self slot) c ci 2) 0.0)
               (format 0 "PHYSPAIR c=~D ci=~D dm=~f fl=~f~%"
                       c ci
                       (phys-chain-vol-dom (-> self slot) c ci 0)
                       (phys-chain-vol-dom (-> self slot) c ci 1))))))
       (dotimes (c (-> self nchain))
        (when (> (phys-chain-links (-> self slot) c) 0)
         (format 0 "PHYSAUTH c=~D hit=~f ok=~f dot=~f nrm=~f dsum=~f~%"
                 c
                 (phys-auth (-> self slot) c 0)
                 (phys-auth (-> self slot) c 1)
                 (phys-auth (-> self slot) c 2)
                 (phys-auth (-> self slot) c 3)
                 (phys-auth (-> self slot) c 4))
         (format 0 "PHYSAUTH2 c=~D usum=~f tmov=~f contact=~f fam=~D~%"
                 c (phys-auth (-> self slot) c 5) (phys-auth (-> self slot) c 6)
                 (phys-auth (-> self slot) c 7)
                 (phys-chain-family (-> self slot) c))))
       (phys-auth-reset!)
       (phys-auth-lag-set! 1))
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (phys-auth-lag-set! 0)
       (dotimes (c (-> self nchain))
         (when (> (phys-chain-links (-> self slot) c) 0)
           (format 0 "PHYSAUTHPC c=~D hit=~f ok=~f~%"
                   c (phys-auth (-> self slot) c 0) (phys-auth (-> self slot) c 1))))
       (set! (-> self phase) PHYSROOM-PH-INVPC)
       (set! (-> self pframe) 0)))

    ;; ---- 8. LES INVERSIONS (verdict owner : « un de ses seins retourne vers l'interieur »).
    ;; ---- D'abord le compte de la course, puis un CONTROLE POSITIF qui miroite chaque lien libre a
    ;; ---- travers son attache : le compteur doit monter. Un compteur d'inversions a zero qui ne
    ;; ---- bouge pas sous le defaut ne prouve rien.
    ((= (-> self phase) PHYSROOM-PH-INVPC)
     (when (= (-> self pframe) 1)
       ;; `reseatfb` = re-assises retombees sur l'ancienne heuristique (rayon le long de l'os du
       ;; porteur) au lieu de la place que le rig donne. Doit valoir ZERO : c'est cette heuristique
       ;; qui posait le pan du pantacourt a 429 u du genou la ou le rig le met a 1349.
       (format 0 "PHYSRESEAT n=~f fallback=~f~%" (phys-inversions 2) (phys-inversions 4))
       ;; LA POUSSEE TANGENTIELLE DE LA BOUCLE DE FINITION A-T-ELLE TIRE ? Regle 0 : le
       ;; correctif de NOTE-61 ne se prouve pas par son commentaire. `n` = nombre de poussees,
       ;; `sumdepth` = somme des profondeurs vues a l'entree (u de jeu), donc `sumdepth/n` est la
       ;; profondeur MOYENNE que les balayages laissaient derriere eux. A n=0 le bloc n'a jamais
       ;; ete atteint et tout `meshpen` publie a cote est a lire comme AVANT le correctif.
       ;; [NOTE-125] `oldremoved` est le CONTROLE APPARIE : ce que l'ancien pas (`dd*s^2`) aurait
       ;; retire sur EXACTEMENT les memes evenements, cumule dans la meme course. `removed/
       ;; oldremoved` mesure donc le correctif sans dependre d'aucune autre course.
       ;; `capn`/`capdepth` comptent les evenements ou la calotte est VIDE — aucun deplacement a
       ;; longueur constante ne peut sortir le joint — et `capgive` est le rayon RELATIF qu'il
       ;; aurait fallu en plus. C'est la mesure qui dit si la longueur doit ceder ensuite
       ;; (SPEC 33 « local compression ») et de combien, a comparer aux bandes de SPEC 22.
       ;; NATURE : `n`/`capn` des COMPTES, `sumdepth`/`removed`/`oldremoved`/`capdepth` des
       ;; LONGUEURS CUMULEES (unites de jeu), `capgive` un RAPPORT sans dimension (max, pas moyenne).
       ;; REPERE : monde, position ecrite ; le rayon est celui de la sphere de l'ATTACHE du lien.
       ;; LECTURE HORS DEFAUT : `removed/sumdepth` -> 1 (le pas retire ce qu'il voit), `capn` -> 0.
       ;; `PHYSTAN` garde EXACTEMENT ses trois champs : tout ce qui la lit deja continue de la lire
       ;; sans changement. Les champs neufs vont sur une ligne A PART (`format` de GOAL est borne a
       ;; 8 parametres, et une ligne separee est de toute facon plus sure pour les parseurs).
       (format 0 "PHYSTAN n=~D sumdepth=~f removed=~f~%"
               (phys-tan-count) (phys-tan-depth) (phys-tan-eff))
       (format 0 "PHYSTAN2 oldremoved=~f capn=~D capdepth=~f capgive=~f~%"
               (phys-tan-old) (phys-tan-cap) (phys-tan-capd) (phys-tan-capg))
       (format 0 "PHYSINV phase=run flips=~f degen=~f reseat=~f residual=~f~%"
               (phys-inversions 0) (phys-inversions 1) (phys-inversions 2) (phys-inversions 3))
       (phys-inversions-reset!)
       (phys-inv-inject-set! 1))
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (phys-inv-inject-set! 0)
       (format 0 "PHYSINV phase=control flips=~f degen=~f reseat=~f residual=~f~%"
               (phys-inversions 0) (phys-inversions 1) (phys-inversions 2) (phys-inversions 3))
       (set! (-> self phase) PHYSROOM-PH-SELFOFF)
       (set! (-> self pframe) 0)
       (phys-diag-reset!)))

    ;; ---- 8/9. L'AUTO-COLLISION (6e passe, defaut 1 : « les meches fines jittent like crazy des
    ;; ---- que la tete bouge »). Les colliders `Lbanga`, `Lmidhaira`, `lBoob` sont les JOINTS-RACINES
    ;; ---- des chaines elles-memes et les capsules `Lbangb->Lbanga` sont leurs MAILLONS : sans
    ;; ---- exclusion, une meche est poussee hors de son propre volume en permanence. L'exclusion est
    ;; ---- structurelle, donc le compteur est structurellement nul — et un zero que rien ne peut
    ;; ---- faire monter ne prouve rien. La branche ARMEE leve l'exclusion : il DOIT monter.
    ((= (-> self phase) PHYSROOM-PH-SELFOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (physroom-emit-diag "self-disarmed")
       (phys-diag-reset!)
       (phys-self-inject-set! 1)
       (set! (-> self phase) PHYSROOM-PH-SELFON)
       (set! (-> self pframe) 0)))

    ((= (-> self phase) PHYSROOM-PH-SELFON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (physroom-emit-diag "self-armed")
       (phys-self-inject-set! 0)
       (phys-diag-reset!)
       (set! (-> self ai) 0)
       (physroom-set-anim 0)
       (set! (-> self phase) PHYSROOM-PH-SIDEOFF)
       (set! (-> self pframe) 0)))

    ;; ---- 9bis. CONTROLE POSITIF DE LA CONTRAINTE DE COTE, DEUX BRANCHES A EXPOSITION EGALE.
    ;; ---- `side` est tombe de 11446 a 0 quand la contrainte est arrivee ; un compteur qui
    ;; ---- s'effondre est soit une correction, soit un predicat devenu inevaluable. La branche
    ;; ---- DESARMEE (contrainte en place) et la branche ARMEE (contrainte levee, rien d'autre)
    ;; ---- jouent TOUTES LES ANIMATIONS, PHYSROOM-PCW frames chacune, meme pilotage : c'est la
    ;; ---- seule facon de comparer deux comptes, et c'est ce qui manquait quand les deux
    ;; ---- rendaient zero (la fenetre de 90 frames sur l'animation 0 ne joue simplement pas les
    ;; ---- animations ou les lunettes traversent le buste).
    ((= (-> self phase) PHYSROOM-PH-SIDEOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (physroom-emit-diag "side-disarmed")
          (phys-diag-reset!)
          (phys-side-off-set! 1)
          (set! (-> self ai) 0)
          (physroom-set-anim 0)
          (set! (-> self phase) PHYSROOM-PH-SIDEON)))))

    ((= (-> self phase) PHYSROOM-PH-SIDEON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (physroom-emit-diag "side-armed")
          (phys-side-off-set! 0)
          (phys-diag-reset!)
          (phys-stats-reset!)
          (set! (-> self ai) 0)
          (physroom-set-anim 0)
          (set! (-> self phase) PHYSROOM-PH-CONEOFF)))))

    ;; ---- 9quater. CONTROLE POSITIF DU PREDICAT CONIQUE, DEUX BRANCHES A EXPOSITION EGALE.
    ;; ---- DESARMEE = le predicat corrige (le solide que la donnee designe). ARMEE = le rayon
    ;; ---- interpole sur le parametre de projection, c'est-a-dire l'ensemble plus PETIT d'avant :
    ;; ---- le solveur y cesse de pousser plus tot, donc la penetration residuelle DOIT monter.
    ((= (-> self phase) PHYSROOM-PH-CONEOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (set! (-> self condis) (physroom-max-pen))
          (format 0 "PHYSCONE tag=cone-disarmed maxpen=~f~%" (-> self condis))
          (physroom-emit-diag "cone-disarmed")
          (phys-diag-reset!)
          (phys-stats-reset!)
          (phys-cone-off-set! 1)
          (set! (-> self ai) 0)
          (physroom-set-anim 0)
          (set! (-> self phase) PHYSROOM-PH-CONEON)))))

    ((= (-> self phase) PHYSROOM-PH-CONEON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (set! (-> self conarm) (physroom-max-pen))
          (format 0 "PHYSCONE tag=cone-armed maxpen=~f~%" (-> self conarm))
          (physroom-emit-diag "cone-armed")
          (phys-cone-off-set! 0)
          (phys-diag-reset!)
          (phys-stats-reset!)
          (set! (-> self ai) 0)
          (physroom-set-anim 0)
          (set! (-> self phase) PHYSROOM-PH-PROXOFF)))))

    ;; ---- 9quinquies. CYCLE 37 ETAPE 2 — LES SPHERES PROXIMALES SONT-ELLES DU TRAVAIL REDONDANT ?
    ;; Le cycle 35 a mesure, sur le mesh LIVRE, que les deux spheres de chair d'un sein decrivent LA
    ;; MEME chair : recouvrement 75.6 % / 65.3 %, chaque centre a l'INTERIEUR de la sphere de
    ;; l'autre, et sur les 55 sommets de `chestL` la PROXIMALE ne couvre pas UN SEUL sommet que la
    ;; DISTALE ne couvre deja. Le cycle 37 etape 1 a mesure que la boucle de contraintes NE CONVERGE
    ;; PAS : 3.16 a 3.98 volumes poussent par balayage, a 86-100 u chacun, sans decroissance sur les
    ;; 45 balayages. DEUX de ces volumes sont les deux spheres du sein OPPOSE.
    ;; DEUX JAMBES A EXPOSITION EGALE, meme pilotage, meme duree, memes animations :
    ;;   DESARMEE = ce qu'on livre (`*phys-prox-off*` = 0, et il y reste apres la mesure) ;
    ;;   ARMEE    = les spheres proximales cessent d'etre des obstacles.
    ;; CE QUI EST PUBLIE, ET POURQUOI CES TROIS GRANDEURS :
    ;;   maxpen  la penetration residuelle — elle NE DOIT PAS se degrader si la sphere est redondante ;
    ;;   npush   le NOMBRE de poussees cumule sur la jambe — c'est le CONTROLE POSITIF de l'ablation
    ;;           elle-meme : s'il ne baisse pas, l'interrupteur n'a rien desarme et les deux jambes
    ;;           mesurent la meme chose. Un zero sans ce compte serait un zero de domaine vide ;
    ;;   psum    la somme des MODULES (u), et `slast` la meme restreinte aux balayages 34-45 :
    ;;           le travail du groupe de COLLISION SEULE, celui qui prouve la non-convergence.
    ;; NATURE : `maxpen`/`psum`/`slast` des LONGUEURS (unites de jeu, 4096 = 1 m), `npush` un COMPTE.
    ;; REPERE : le monde. AGREGES sur la jambe, jamais des maxima de fenetre — la convergence est une
    ;; question de POPULATION, et l'etape 1 a paye pour l'apprendre.
    ((= (-> self phase) PHYSROOM-PH-PROXOFF)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (set! (-> self proxdis) (physroom-max-pen))
          (format 0 "PHYSPROX tag=prox-disarmed maxpen=~f~%" (-> self proxdis))
          (dotimes (c (-> self nchain))
            (format 0 "PHYSPROXC tag=prox-disarmed c=~D npush=~f psum=~f slast=~f~%"
                    c
                    (phys-cpc (-> self slot) c 0)
                    (phys-cpc (-> self slot) c 1)
                    (phys-cpc (-> self slot) c 2)))
          (physroom-emit-diag "prox-disarmed")
          (phys-diag-reset!)
          (phys-stats-reset!)
          (phys-prox-off-set! 1)
          (set! (-> self ai) 0)
          (physroom-set-anim 0)
          (set! (-> self phase) PHYSROOM-PH-PROXON)))))

    ((= (-> self phase) PHYSROOM-PH-PROXON)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (set! (-> self proxarm) (physroom-max-pen))
          (format 0 "PHYSPROX tag=prox-armed maxpen=~f~%" (-> self proxarm))
          (dotimes (c (-> self nchain))
            (format 0 "PHYSPROXC tag=prox-armed c=~D npush=~f psum=~f slast=~f~%"
                    c
                    (phys-cpc (-> self slot) c 0)
                    (phys-cpc (-> self slot) c 1)
                    (phys-cpc (-> self slot) c 2)))
          (physroom-emit-diag "prox-armed")
          ;; L'INTERRUPTEUR REVIENT A ZERO : ce qu'on livre n'a pas change.
          (phys-prox-off-set! 0)
          (phys-diag-reset!)
          (phys-stats-reset!)
          (set! (-> self phase) PHYSROOM-PH-RESTA)
          (phys-rest-k-set! 1.0)))))

    ;; ---- 9 bis. SPEC 33/34 — LA RESTITUTION, ET SON CONTROLE POSITIF.
    ;; Deux jambes IDENTIQUES : meme secousse `jerk`, meme duree, meme animation. La SEULE
    ;; difference est le coefficient. `A` porte ses valeurs (0.06 sein<->sein, 0.02 buste) ; `B`
    ;; les multiplie par 15, ce qui porte le sein<->sein a 0.90. Ce qui doit MONTER entre les deux
    ;; est la vitesse normale SORTANTE relue a la frame suivante — pas un compteur de passages,
    ;; qui ne dirait que « le code est atteint », et pas un rapport deduit de `e`, qui se
    ;; comparerait a lui-meme.
    ;; SI `n` EST ZERO SUR LES DEUX JAMBES, LE DOMAINE EST VIDE et rien n'est prouve ici : c'est
    ;; ecrit tel quel dans le rapport, jamais transforme en vert.
    ((= (-> self phase) PHYSROOM-PH-RESTA)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (format 0 "PHYSRESTLEG tag=spec n=~f m=~f vin=~f vout=~f esum=~f~%"
               (phys-rest 0) (phys-rest 4) (phys-rest 1) (phys-rest 2) (phys-rest 3))
       (phys-stats-reset!)
       (phys-rest-k-set! 15.0)
       (set! (-> self phase) PHYSROOM-PH-RESTB)
       (set! (-> self pframe) 0)))

    ((= (-> self phase) PHYSROOM-PH-RESTB)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (format 0 "PHYSRESTLEG tag=x15 n=~f m=~f vin=~f vout=~f esum=~f~%"
               (phys-rest 0) (phys-rest 4) (phys-rest 1) (phys-rest 2) (phys-rest 3))
       (phys-rest-k-set! 1.0)
       (phys-stats-reset!)
       (phys-diag-reset!)
       (set! (-> self reg) 0)
       (set! (-> self phase) PHYSROOM-PH-REG)
       (set! (-> self pframe) 0)))

    ;; ---- 9 ter. SPEC 14 A 20 — LES SEPT REGIMES DYNAMIQUES, ET LEUR TEMOIN -------------------
    ;; Quinze fenetres, chacune : `pre` frames de repos (retour doux + tenue), `drv` frames de
    ;; pilotage, `post` frames de tenue MESUREES elles aussi — le pic d'une reponse sous-amortie
    ;; tombe apres la fin du stimulus, pas pendant.
    ;;
    ;; LA FENETRE DE MESURE S'OUVRE EXACTEMENT AU DEBUT DU PILOTAGE. Sans ce reset, le maximum
    ;; publie serait celui du regime PRECEDENT et de son retour vers `home`. C'est le meme geste,
    ;; au meme endroit du meme motif, que PH-ORI a `PHYSROOM-ORIS` et PH-TILT a `PHYSROOM-IDLES` —
    ;; et c'est ce qui rend les quinze fenetres comparables entre elles.
    ;;
    ;; `pre = 0` VEUT DIRE QUE LA FENETRE ENCHAINE SANS RUPTURE. Les trois fenetres d'un saut sont
    ;; alors les trois phases d'UN SEUL mouvement, ce que sa §15 exige (« naturally through
    ;; integration rather than through a scripted bounce animation ») ; le reset separe les
    ;; MESURES sans separer le MOUVEMENT.
    ;;
    ;; L'ANIMATION N'AVANCE PAS PENDANT CETTE PHASE, comme dans PH-ORI et les phases d'impulsion :
    ;; la pose d'auteur est TENUE. Une animation qui jouerait ajouterait sa propre acceleration au
    ;; joint de poitrine, et la reponse ne serait plus attribuable au regime. Ce que l'animation
    ;; tenue produit malgre tout est mesure par la fenetre r=0, qui ne recoit AUCUN pilotage :
    ;; c'est la ligne de base a soustraire, et sans elle aucun des quatorze autres chiffres n'a
    ;; d'echelle.
    ((= (-> self phase) PHYSROOM-PH-REG)
     (let* ((r    (-> self reg))
            (pre  (-> *physroom-reg-pre* r))
            (drv  (-> *physroom-reg-drv* r))
            (post (-> *physroom-reg-post* r)))
       (physroom-reg-drive r (- (-> self pframe) (+ pre 1)))
       ;; `(max 1 pre)` ET PAS `pre` — C'EST UN DEFAUT MESURE, PAS UNE PRECAUTION.
       ;; `pframe` est remis a 0 a la fin d'une fenetre puis INCREMENTE en tete du tick suivant :
       ;; il ne vaut donc JAMAIS 0 a l'interieur de la phase. Ecrit `(= pframe pre)`, le reset ne
       ;; se declenchait pas du tout sur les six fenetres CHAINEES (`pre` = 0), qui heritaient
       ;; donc du maximum de la precedente. La course C49E1 le montre sans ambiguite sur une
       ;; colonne independante : `cn` (le nombre de frames agregees) valait 18 pour r=1, puis 45
       ;; pour r=2 et 104 pour r=3 — le cumul exact des fenetres precedentes, au lieu de 27 et 14.
       ;; Six des quinze fenetres publiaient le chiffre d'une autre.
       (when (= (-> self pframe) (max 1 pre))
         ;; ---- LA POSE DANS LAQUELLE §14 A §20 SONT MESUREES, PUBLIEE (cycle 65) -------------
         ;; PH-SGN (cycle 55) et PH-SYM (cycle 56) EPINGLENT leur pose par son nom et la
         ;; REVALIDENT a l'execution (`PHYSSGNB`, `PHYSSYMB`). PH-REG ne fait ni l'un ni l'autre :
         ;; il TIENT la pose que la phase precedente lui laisse — la queue de la derniere
         ;; animation de la liste — et l'animation n'avance plus ensuite. Les sept regimes de
         ;; §14 a §20 sont donc joues dans une pose HERITEE dont l'ecart au miroir n'a jamais ete
         ;; releve, alors que cinq de ces sections publient des ecarts gauche/droite (jusqu'a
         ;; x5.79 sur §18) et que la regle du 2026-08-20 05:20 exige que toute mesure d'asymetrie
         ;; se releve dans une pose dont la symetrie est PROUVEE avant la course.
         ;;
         ;; CE BLOC NE CHANGE RIEN AU COMPORTEMENT : il PUBLIE, au meme point de protocole que
         ;; `PHYSSGNB` (fenetre temoin r=0, sujet droit, immobile, a `home` — `physroom-reg-drive`
         ;; y rend `home` + identite au bit), la direction monde de chaque os. Le tableau en tire
         ;; l'ecart au miroir avec la MEME formule que pour `PHYSSYMB`. On ne suppose plus que la
         ;; pose est acceptable ni qu'elle ne l'est pas : on la mesure.
         (when (zero? r)
           (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
             (when hd
               (dotimes (c (-> self nchain))
                (when (> (phys-chain-links (-> self slot) c) 0)
                 (dotimes (l (phys-chain-links (-> self slot) c))
                   (format 0 "PHYSREGB c=~D l=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                           c l
                           (phys-chain-bone hd (-> self slot) c l 0)
                           (phys-chain-bone hd (-> self slot) c l 1)
                           (phys-chain-bone hd (-> self slot) c l 2))))))))
         (phys-comexw-reset!)
         (phys-stats-reset!))
       (when (>= (-> self pframe) (+ pre (+ drv post)))
         (physroom-emit-regime r)
         (set! (-> self pframe) 0)
         (+! (-> self reg) 1)
         (when (>= (-> self reg) PHYSROOM-REGN)
           (physroom-hold)
           (phys-stats-reset!)
           (phys-diag-reset!)
           (set! (-> self sgi) -1)   ;; -1 = la rampe d'ENTREE, voir PHYSROOM-SGNE
           (set! (-> self phase) PHYSROOM-PH-SGN)))))

    ;; ---- 9 quater. LA REPONSE PAR SENS DE STIMULUS (cycle 52) ---------------------------------
    ;; Voir la note des constantes PHYSROOM-SGN*. Cette phase est la DERNIERE phase de travail :
    ;; elle est placee en AVAL de tout ce que la trace publie deja, si bien qu'aucune ligne
    ;; existante ne peut changer de valeur a cause d'elle. C'est ce que la prediction P2 mise, et
    ;; c'est le seul controle qui autorise a lire les chiffres neufs : le cycle 50 a mesure que les
    ;; fenetres se contaminent, donc une phase INSEREE au milieu aurait deplace 257 lignes de `row`
    ;; et rendu tout le reste inattribuable.
    ((= (-> self phase) PHYSROOM-PH-SGN)
     ;; ---- LA RAMPE D'ENTREE, ET L'ETAT DU SQUELETTE QU'ELLE PERMET DE RELEVER ----------------
     ;; Tant que `sgi` vaut -1 on TIENT `home` : c'est la rampe d'entree (voir PHYSROOM-SGNE). A
     ;; sa derniere frame le sujet est droit, immobile et pose — la seule frame ou la direction de
     ;; l'os se lit sans qu'un pilotage la contamine. `PHYSSGNB` la publie la, et nulle part
     ;; ailleurs : c'est la grandeur qui decide de ce que la contrainte de longueur confisque.
     (when (< (-> self sgi) 0)
       (physroom-hold)
       ;; ---- L'EPINGLE DE POSE (cycle 55) -----------------------------------------------------
       ;; Le cycle 53 a mesure que la pose tenue est a 43.4 deg du miroir parfait quand le rig est
       ;; symetrique a 0.005 deg, et le cycle 54 que celle-la est la 3e PIRE sur 31. Tout ecart
       ;; gauche/droite lu ici portait donc la pose. On epingle celle que la mesure designe, et on
       ;; l'avance du MEME nombre de frames que le protocole d'echantillonnage du cycle 54 pour
       ;; retomber sur la pose qui y valait 4.0 / 5.4 deg. `PHYSSGNB` la REVALIDE ensuite a
       ;; l'execution : on ne fait pas confiance au choix, on le mesure.
       (when (= (-> self pframe) 1)
         (cond
           ((>= *physroom-symai* 0)
            (physroom-set-anim *physroom-symai*)
            (format 0 "PHYSSGNPOSE ai=~D src=name~%" *physroom-symai*))
           (else
            (format 0 "PHYSSGNPOSE ai=-1 src=INTROUVABLE~%"))))
       (when (and (>= *physroom-symai* 0)
                  (> (-> self pframe) 1) (<= (-> self pframe) (+ 1 PHYSROOM-MEASAT)))
         (physroom-advance-anim 1.0))
       (when (>= (-> self pframe) PHYSROOM-SGNE)
         (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
           (when hd
             (dotimes (c (-> self nchain))
              (when (> (phys-chain-links (-> self slot) c) 0)
               (dotimes (l (phys-chain-links (-> self slot) c))
                 (format 0 "PHYSSGNB c=~D l=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                         c l
                         (phys-chain-bone hd (-> self slot) c l 0)
                         (phys-chain-bone hd (-> self slot) c l 1)
                         (phys-chain-bone hd (-> self slot) c l 2)))))))
         (set! (-> self sgi) 0)
         (set! (-> self pframe) 0)
         (phys-comexw-reset!)
         (phys-stats-reset!)))
     (when (>= (-> self sgi) 0)
     (let* ((i  (-> self sgi))
            (p  (/ i 36))                     ;; 0 = premiere passe, 1 = passe a ordre INVERSE
            (j  (mod i 36))
            (w  (mod j 2))                    ;; 0 = premiere fenetre de la cellule, 1 = seconde
            (a  (mod (/ j 2) 3))              ;; 0 = vertical · 1 = avant-arriere · 2 = lateral
            (k  (/ j 6))                      ;; l'ablation, meme numerotation que PH-ORI
            ;; L'ORDRE EST EQUILIBRE DEUX FOIS : par la parite de (k + a) DANS une passe, et par
            ;; la PASSE elle-meme, qui inverse tout. Une meme cellule (k, axe, sens) est donc
            ;; jouee une fois en 1re position et une fois en 2e — c'est ce qui separe l'effet du
            ;; SENS de celui du RANG, que le cycle 52 n'avait pas su trancher.
            (si (if (= (mod (+ (+ k a) p) 2) 0)
                  (if (zero? w) 1 -1)
                  (if (zero? w) -1 1)))
            ;; `(the float <int>)` REINTERPRETE les bits en GOAL : on ne convertit pas, on choisit.
            (sg (if (= si 1) 1.0 -1.0)))
       (physroom-drive-sgn (-> self pframe) a sg)
       ;; L'ABLATION EST ARMEE A LA PREMIERE FRAME DE LA FENETRE ET JAMAIS AILLEURS — meme geste,
       ;; meme endroit que PH-ORI. `pframe` est remis a 0 en fin de fenetre puis INCREMENTE en tete
       ;; du tick suivant : il ne vaut donc jamais 0 dans la phase, et un reset ecrit `(= pframe 0)`
       ;; ne se declencherait jamais. C'est le defaut que le cycle 49 a paye sur six fenetres.
       (when (= (-> self pframe) 1)
         (phys-len-off-set!  (if (= k 1) 1 0))
         (phys-side-off-set! (if (= k 2) 1 0))
         (phys-cone-off-set! (if (= k 3) 1 0))
         (phys-col-off-set!  (if (= k 4) 1 0))
         (phys-rr-off-set!   (if (= k 5) 1 0))
         ;; la fenetre de mesure s'ouvre EXACTEMENT au debut de l'impulsion
         (phys-comexw-reset!)
         (phys-stats-reset!))
       ;; ---- LA REPONSE, a la fin de la tenue et avant le retour ------------------------------
       (when (= (-> self pframe) PHYSROOM-SGNM)
         (dotimes (c (-> self nchain))
          (when (> (phys-chain-links (-> self slot) c) 0)
           (format 0 "PHYSSGN c=~D i=~D k=~D a=~D s=~D apex=~,,7f~%"
                   c i k a si (phys-diag (-> self slot) c 53))
           ;; le COM a cote de l'apex — les deux grandeurs que sa spec borne — et le STIMULUS
           ;; REELLEMENT RECU par la pointe. Une reponse sans son entree n'est pas une mesure :
           ;; c'est `stim` qui prouve que les deux sens sont la MEME experience (prediction P6).
           (format 0 "PHYSSGN2 c=~D i=~D com=~,,7f stim=~,,7f~%"
                   c i (phys-diag (-> self slot) c 43) (phys-tip-stim (-> self slot) c))
           ;; LE VECTEUR de l'apex, releve a l'argmax : c'est lui qui porte `A_dir`. Une asymetrie
           ;; de DIRECTION est invisible a une amplitude, et c'est precisement la forme sous
           ;; laquelle le cycle 51 a vu le defaut (la PART verticale de la reponse, pas sa taille).
           (format 0 "PHYSSGN4 c=~D i=~D ax=~,,7f ay=~,,7f az=~,,7f~%"
                   c i
                   (phys-diag (-> self slot) c 54)
                   (phys-diag (-> self slot) c 55)
                   (phys-diag (-> self slot) c 56)))))
       ;; ---- LE CALME QUI FERME LA FENETRE : ce que l'instrument lit stimulus ABSENT ------------
       (when (= (-> self pframe) (+ PHYSROOM-SGNR 1))
         (phys-comexw-reset!)
         (phys-stats-reset!))
       (when (>= (-> self pframe) PHYSROOM-SGNW)
         (dotimes (c (-> self nchain))
          (when (> (phys-chain-links (-> self slot) c) 0)
           (format 0 "PHYSSGN3 c=~D i=~D bapex=~,,7f bcom=~,,7f~%"
                   c i (phys-diag (-> self slot) c 53) (phys-diag (-> self slot) c 43))))
         (set! (-> self pframe) 0)
         (+! (-> self sgi) 1)
         (when (>= (-> self sgi) PHYSROOM-SGNN)
           ;; ON DESARME TOUT AVANT DE SORTIR. Une ablation laissee armee contaminerait la suite de
           ;; la course — c'est la faute que `phys-len-off-set!` a deja value une fois.
           (phys-len-off-set! 0)
           (phys-side-off-set! 0)
           (phys-cone-off-set! 0)
           (phys-col-off-set! 0)
           (phys-rr-off-set! 0)
           (physroom-hold)
           (phys-stats-reset!)
           (phys-diag-reset!)
           (set! (-> self symi) -1)   ;; -1 = la rampe d'ENTREE, voir PHYSROOM-SYME
           (set! (-> self phase) PHYSROOM-PH-SYM))))))

    ;; ---- 9 quinquies. LES MEMES STIMULI DANS DEUX POSES (cycle 56) -----------------------------
    ;; Voir le pave des constantes PHYSROOM-SYM*. Cette phase est APPENDUE apres PH-SGN et avant
    ;; REPORT : elle est donc en aval de tout ce que la trace publie deja, et `physroom-report` ne
    ;; publie que des compteurs statiques (magnitudes de pilotage, comptes, unites d'`atan`). Aucune
    ;; ligne existante ne peut changer de valeur a cause d'elle. Les SEULES lignes ajoutees sous un
    ;; tag DEJA EXISTANT sont les `PHYSANIMLEN` qu'emet `physroom-set-anim` a chaque epingle — une
    ;; par cellule, donc huit. Je l'ecris ICI, avant la course, parce que le cycle 55 l'a decouvert
    ;; APRES et a du le rattraper dans son rapport.
    ((= (-> self phase) PHYSROOM-PH-SYM)
     ;; ---- LA RAMPE D'ENTREE ------------------------------------------------------------------
     ;; PH-SGN sort en `physroom-hold` apres 60 frames de calme, donc la chaine devrait deja etre
     ;; au repos. « Devrait » n'est pas une mesure : la rampe est la quand meme, et `PHYSSYM2`
     ;; publie le stimulus recu par chaque cellule pour que la premiere se prouve comme les autres.
     (when (< (-> self symi) 0)
       (physroom-hold)
       (when (>= (-> self pframe) PHYSROOM-SYME)
         (set! (-> self symi) 0)
         (set! (-> self pframe) 0)
         (phys-comexw-reset!)
         (phys-stats-reset!)))
     (when (>= (-> self symi) 0)
     (let* ((i   (-> self symi))
            (m   (/ i 2))
            (q   (mod i 2))
            ;; L'ORDRE DES DEUX JAMBES EST EQUILIBRE : la jambe symetrique est jouee en 1re
            ;; position pour m pair et en 2e pour m impair. Sans ca, « symetrique » et « premiere
            ;; de la paire » seraient la meme chose et le RANG porterait l'ecart au lieu de la
            ;; pose — c'est le defaut que le cycle 52 n'avait pas su trancher sur PH-SGN et que la
            ;; double passe a ordre inverse a du corriger apres coup.
            (p   (mod (+ q m) 2))
            ;; p = 0 -> la pose SYMETRIQUE · p = 1 -> l'ASYMETRIQUE. Les deux par leur NOM.
            (ai  (if (zero? p) *physroom-symai* *physroom-asymai*))
            (r   (-> *physroom-sym-r* m))
            (dw  (-> *physroom-sym-dw* m))
            ;; les trois bornes de la cellule, comptees sur `pframe`
            (t0  (+ 1 PHYSROOM-MEASAT))          ;; fin de l'avance d'animation
            (t1  (+ t0 PHYSROOM-SYMS))           ;; fin de l'etablissement = ouverture de fenetre
            (t2  (+ t1 dw))                      ;; fin du pilotage + tenue = lecture
            ;; LE RETOUR DOUX (cycle 65). Voir le pave de la section 7 : sans lui la « queue de
            ;; calme » commencait par un saut de 90 ou 150 deg en UNE frame, et la ligne de base
            ;; qu'elle donne mesurait cette impulsion-la.
            (tr  (+ t2 PHYSROOM-RETF))           ;; fin du retour doux vers `home`
            (t3  (+ tr PHYSROOM-SYMT)))          ;; fin de la queue de calme = ligne de base
       ;; ---- 1. L'EPINGLE DE POSE, PAR SON NOM ET JAMAIS PAR UN INDEX ------------------------
       (when (= (-> self pframe) 1)
         (physroom-hold)
         (cond
           ((>= ai 0)
            (physroom-set-anim ai)
            (format 0 "PHYSSYMPOSE i=~D p=~D m=~D ai=~D~%" i p m ai))
           (else
            (format 0 "PHYSSYMPOSE i=~D p=~D m=~D ai=-1~%" i p m))))
       ;; ---- 2. L'AVANCE JUSQU'AU POINT DE PROTOCOLE -----------------------------------------
       ;; EXACTEMENT PHYSROOM-MEASAT avances, le meme nombre que l'echantillonnage des 31 poses du
       ;; cycle 54 et que l'epingle du cycle 55 : c'est ce qui rend les trois comparables.
       (when (and (>= ai 0) (> (-> self pframe) 1) (<= (-> self pframe) t0))
         (physroom-advance-anim 1.0))
       (when (and (> (-> self pframe) 1) (<= (-> self pframe) t1))
         (physroom-hold))
       ;; ---- 3. LA POSE EST REVALIDEE A L'EXECUTION, ON NE FAIT PAS CONFIANCE AU CHOIX --------
       ;; Meme geste que `PHYSSGNB` au cycle 55 : la direction monde de chaque os est publiee a la
       ;; premiere frame d'etablissement, sujet droit et immobile. C'est de la que l'ecart au
       ;; miroir parfait se recalcule, cellule par cellule — une epingle qui n'aurait pas pris se
       ;; verrait ici, et pas dans une supposition.
       (when (= (-> self pframe) (+ t0 1))
         (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
           (when hd
             (dotimes (c (-> self nchain))
              (when (> (phys-chain-links (-> self slot) c) 0)
               (dotimes (l (phys-chain-links (-> self slot) c))
                 (format 0 "PHYSSYMB i=~D c=~D l=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                         i c l
                         (phys-chain-bone hd (-> self slot) c l 0)
                         (phys-chain-bone hd (-> self slot) c l 1)
                         (phys-chain-bone hd (-> self slot) c l 2))))))))
       ;; ---- 4. LA FENETRE S'OUVRE A LA FIN DE L'ETABLISSEMENT --------------------------------
       ;; L'OFFSET DE LEVIER EST RELEVE ICI ET PAS AILLEURS. `physroom-reg-drive` ne le releve qu'a
       ;; `f = 0` ET quand `pre > 0` ; on l'appelle a partir de `f = 1`, donc il ne le releverait
       ;; jamais et garderait celui de PH-REG — releve dans une AUTRE pose. Or c'est justement la
       ;; pose qui est la variable de ce cycle : un levier herite rendrait les deux jambes
       ;; identiques par construction sur la moitie du mecanisme. Meme sentinelle qu'a `:2088` — un
       ;; triplet exactement nul veut dire que le canal n'a rien ecrit, pas que l'ancre est a
       ;; l'origine du monde, et le repli est le pivot anatomique seul.
       (when (= (-> self pframe) t1)
         (let ((ax0 (phys-diag (-> self slot) 0 50))
               (ay0 (phys-diag (-> self slot) 0 51))
               (az0 (phys-diag (-> self slot) 0 52)))
           (cond
             ((and (= ax0 0.0) (= ay0 0.0) (= az0 0.0))
              (set! (-> self cex) 0.0)
              (set! (-> self cey) (+ PHYSROOM-CANY (- PHYSROOM-HIPY 0.0)))
              (set! (-> self cez) PHYSROOM-CANZ)
              (format 0 "PHYSSYML i=~D cex=~f cey=~f cez=~f src=0~%"
                      i (-> self cex) (-> self cey) (-> self cez)))
             (else
              (set! (-> self cex) (- ax0 (-> self home x)))
              (set! (-> self cey) (- ay0 (-> self home y)))
              (set! (-> self cez) (- az0 (-> self home z)))
              (format 0 "PHYSSYML i=~D cex=~f cey=~f cez=~f src=1~%"
                      i (-> self cex) (-> self cey) (-> self cez)))))
         (phys-comexw-reset!)
         (phys-stats-reset!)
         (phys-diag-reset!))
       ;; ---- 5. LE PILOTAGE -------------------------------------------------------------------
       ;; Le lacet passe par `physroom-reg-drive`, DONC par le meme profil demi-cosinus, le meme
       ;; bras de levier et la meme fenetre `drv + post` que §18 mesure dans PH-REG. La gravite
       ;; laterale passe par `physroom-orient`, donc par le meme geste que PH-ORI. Dans les deux cas
       ;; l'instrument est celui de la section, pas un instrument a moi.
       (when (and (> (-> self pframe) t1) (<= (-> self pframe) t2))
         (cond
           ((>= r 0) (physroom-reg-drive r (- (-> self pframe) t1)))
           (else     (physroom-orient (-> *physroom-sym-ax* m) (-> *physroom-sym-dg* m)))))
       ;; ---- 6. LA LECTURE --------------------------------------------------------------------
       (when (= (-> self pframe) t2)
         (dotimes (c (-> self nchain))
          (when (> (phys-chain-links (-> self slot) c) 0)
           (format 0 "PHYSSYM i=~D p=~D m=~D c=~D apex=~,,7f com=~,,7f~%"
                   i p m c
                   (phys-diag (-> self slot) c 53)
                   (phys-diag (-> self slot) c 43))
           (format 0 "PHYSSYM2 i=~D c=~D ax=~,,7f ay=~,,7f az=~,,7f stim=~,,7f~%"
                   i c
                   (phys-diag (-> self slot) c 54)
                   (phys-diag (-> self slot) c 55)
                   (phys-diag (-> self slot) c 56)
                   (phys-tip-stim (-> self slot) c))
           ;; LA FORME, parce que §12 ne borne pas un apex mais un APLATISSEMENT (-15 a -25 %).
           (format 0 "PHYSSYM4 i=~D c=~D sx=~,,7f sy=~,,7f sz=~,,7f det=~,,7f~%"
                   i c
                   (phys-shape (-> self slot) c 0)
                   (phys-shape (-> self slot) c 1)
                   (phys-shape (-> self slot) c 2)
                   (phys-shape (-> self slot) c 3))
           ;; L'ENTREE A COTE DE LA SORTIE : la direction de la gravite LUE PAR LE SOLVEUR dans le
           ;; triedre de sa §7. C'est elle qui dit lequel des deux seins est du cote gravite, et
           ;; c'est une MESURE — l'etiquette d'axe du commentaire de `physroom-orient` est fausse.
           (format 0 "PHYSSYM5 i=~D c=~D gx=~,,7f gy=~,,7f gz=~,,7f~%"
                   i c
                   (phys-shape (-> self slot) c 9)
                   (phys-shape (-> self slot) c 10)
                   (phys-shape (-> self slot) c 11))
           ;; LE COTE GRAVITE, LU SUR L'ANATOMIE ET PAS SUR LE TRIEDRE — ET C'EST TOUTE LA
           ;; DIFFERENCE. `gso` est le cosinus entre la gravite locale et le segment qui va du sein
           ;; OPPOSE a celui-ci : > 0 = la gravite pointe VERS ce sein, donc c'est lui le
           ;; « gravity-side breast » de sa §12. Il ne passe NI par `fx` NI par le melange de
           ;; poles ; il ne peut donc pas republier leur verdict. `PHYSSYM5 gx`, lui, EST le canal
           ;; d'aplatissement depuis le miroir de §7 : le lire comme un cote serait une tautologie.
           ;; NATURE : un cosinus, sans unite. REPERE : la base de l'ANCRE, comme `PHYSTRI`.
           ;; LECTURE QUAND LE DEFAUT EST ABSENT : le sein de plus petit `sx` est celui dont `gso`
           ;; est le PLUS GRAND. Le test DISCRIMINE — il ne peut pas rendre vrai par construction,
           ;; et avant le cycle 63 il rendait FAUX sur les deux poles lateraux.
           (let ((sl (phys-chain-axsep (-> self slot) c 2)))
             (format 0 "PHYSSYM6 i=~D c=~D gso=~,,7f sepn=~,,7f~%"
                     i c
                     (if (> sl 0.0001)
                       (/ (+ (* (phys-shape (-> self slot) c 15) (phys-chain-axsep (-> self slot) c 3))
                             (+ (* (phys-shape (-> self slot) c 16) (phys-chain-axsep (-> self slot) c 4))
                                (* (phys-shape (-> self slot) c 17) (phys-chain-axsep (-> self slot) c 5))))
                          sl)
                       0.0)
                     sl)))))
       ;; ---- 7. LE RETOUR DOUX, PUIS LA QUEUE DE CALME QUI DONNE LA LIGNE DE BASE -------------
       ;;
       ;; CE BLOC CORRIGE UN DEFAUT MESURE, PAS UNE INELEGANCE (cycle 65). Jusqu'ici la queue
       ;; s'ouvrait sur `physroom-hold` a `t2+1`, et `physroom-hold` fait `quaternion-identity!` :
       ;; le sujet passait donc de son orientation pilotee — 90 deg en lacet, 150 en lacet fort,
       ;; +/-90 en lateral — a la verticale EN UNE FRAME. La table appelait ensuite cette fenetre
       ;; « ce que l'instrument lit stimulus ABSENT » et s'en servait de plancher de resolution.
       ;;
       ;; LA REGLE ETAIT DEJA ECRITE, DANS `physroom-reg-drive` : « Y ramener le sujet D'UN COUP
       ;; serait une impulsion artificielle de plusieurs milliers d'unites — precisement ce que sa
       ;; §37 interdit de generer ». PH-REG l'applique depuis le cycle 49 ; PH-SYM, ecrit sept
       ;; cycles plus tard, ne l'appliquait pas.
       ;;
       ;; LA MESURE QUI L'ETABLIT est sur la trace du cycle 63b, sans rien relancer : `bapex` (la
       ;; « queue de calme ») vaut 0.5191 a 0.9286 B0 contre un `apex` PILOTE de 0.2227 a 0.7764.
       ;; Sur la cellule i=0 la queue lit x1.60 (chestL) et x2.39 (chestR) la reponse pilotee. Le
       ;; ring-down n'explique pas ca : les 45 frames de `post` sont DANS la fenetre de pilotage
       ;; par construction (`dw` = drv + post), donc le pic sous-amorti est deja dans `apex`.
       ;;
       ;; CONSEQUENCE, ET C'EST ELLE QUI COUTE : le critere `|apexL - apexR| <= res` comparait un
       ;; ecart de 0.03 a 0.22 B0 a un plancher de 0.61 a 0.93 B0. LES HUIT CELLULES SUR HUIT
       ;; sortaient « NON RESOLU ». L'instrument bati au cycle 56 pour dire si l'asymetrie
       ;; gauche/droite de §12 et §18 est une propriete du personnage ou de la POSE ne pouvait
       ;; rien dire, et le disait sous une forme qui ressemblait a un resultat.
       ;;
       ;; LE RETOUR RETRACE LE CHEMIN DE SA PROPRE CELLULE, jamais un chemin generique : la cellule
       ;; de lacet redescend par `physroom-reg-pose` (donc par l'arc de torse mesure), la cellule
       ;; laterale par `physroom-orient`. Meme demi-cosinus, meme duree et memes constantes que
       ;; `physroom-reg-drive` — aucune constante neuve. A `u = 1` le facteur vaut 0 et les deux
       ;; operateurs rendent `home` + identite au bit, donc le `physroom-hold` qui suit est un
       ;; no-op et le raccord est continu en position ET en vitesse.
       (when (and (> (-> self pframe) t2) (<= (-> self pframe) tr))
         (let* ((u (fmin 1.0 (/ (the float (- (-> self pframe) t2)) PHYSROOM-RETFF)))
                (b (* 0.5 (+ 1.0 (cos (* 32768.0 u))))))
           (cond
             ((>= r 0)
              (physroom-reg-pose (physroom-reg-axis r)
                                 (* b (physroom-reg-ang r (-> *physroom-reg-drv* r)
                                                          (-> *physroom-reg-drv* r)))))
             (else
              (physroom-orient (-> *physroom-sym-ax* m) (* b (-> *physroom-sym-dg* m)))))))
       ;; LA FENETRE DE LIGNE DE BASE S'OUVRE APRES LE RETOUR, ET C'EST TOUT L'INTERET : ce qu'elle
       ;; lit est alors le residu d'une chaine qu'on a laissee revenir, pas la reponse a un saut.
       (when (= (-> self pframe) (+ tr 1))
         (physroom-hold)
         (phys-comexw-reset!)
         (phys-stats-reset!))
       (when (> (-> self pframe) (+ tr 1))
         (physroom-hold))
       (when (>= (-> self pframe) t3)
         (dotimes (c (-> self nchain))
          (when (> (phys-chain-links (-> self slot) c) 0)
           (format 0 "PHYSSYM3 i=~D c=~D bapex=~,,7f bcom=~,,7f~%"
                   i c
                   (phys-diag (-> self slot) c 53)
                   (phys-diag (-> self slot) c 43))))
         (set! (-> self pframe) 0)
         (+! (-> self symi) 1)
         (when (>= (-> self symi) PHYSROOM-SYMN)
           (physroom-hold)
           (phys-stats-reset!)
           (phys-diag-reset!)
           ;; [NOTE-241] les deux jambes de la contrainte de peau sont APPENDUES ici, en AVAL de
           ;; tout ce que la trace publie deja : aucune ligne existante ne peut changer de valeur a
           ;; cause d'elles. Une phase INSEREE au milieu aurait deplace les `row` et rendu le reste
           ;; inattribuable — c'est l'argument que PH-SGN et PH-SYM ont chacun ecrit avant moi.
           (set! (-> self ai) 0)
           (physroom-set-anim 0)
           (set! (-> self pframe) 0)
           ;; ELLE EST DESARMEE EN LIVRAISON ([NOTE-241]) : c'est LA TRANSITION qui l'arme, et pas
           ;; un test sur `pframe`. Le compteur est incremente EN TETE du tick, donc il ne vaut
           ;; JAMAIS 0 dans le corps d'une phase — `phase-window-reset-never-fires` au registre, et
           ;; c'est mon propre compteur `PHYSSKINC n=0` qui a montre que la ligne etait morte.
           (phys-skin-off-set! 0)
           (set! (-> self phase) PHYSROOM-PH-SKINARM))))))

    ;; ---- 9 quater. SPEC 33/34 — LE CONTROLE POSITIF DE LA CONTRAINTE DE PEAU -------------------
    ;; Deux balayages des 31 animations, memes fenetres, meme pilotage, le SEUL ecart etant
    ;; `*phys-skin-off*`. ARMEE d'abord (c'est l'etat LIVRE), DESARMEE ensuite, et l'interrupteur
    ;; revient a zero a la fin : ce qu'on livre n'a pas change. La prediction est signee d'avance —
    ;; desarmee, `skinpen` doit REMONTER ; si les deux jambes rendent la meme chose, la contrainte
    ;; n'est pas ce qui a fait bouger le chiffre, et je le dirai au lieu de le taire.
    ((= (-> self phase) PHYSROOM-PH-SKINARM)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (physroom-emit-diag "skin-armed")
          (phys-diag-reset!)
          (phys-stats-reset!)
          (phys-skin-off-set! 1)
          (set! (-> self ai) 0)
          (physroom-set-anim 0)
          (set! (-> self phase) PHYSROOM-PH-SKINDIS)))))

    ((= (-> self phase) PHYSROOM-PH-SKINDIS)
     (physroom-drive 3 (-> self pframe))
     (physroom-advance-anim 1.0)
     (when (>= (-> self pframe) PHYSROOM-PCW)
       (set! (-> self pframe) 0)
       (+! (-> self ai) 1)
       (cond
         ((< (-> self ai) (-> self nanim))
          (physroom-set-anim (-> self ai)))
         (else
          (physroom-emit-diag "skin-disarmed")
          ;; L'INTERRUPTEUR REVIENT A SA VALEUR DE LIVRAISON, QUI EST 0 (ARMEE).
          (phys-skin-off-set! 0)
          (phys-diag-reset!)
          (phys-stats-reset!)
          (physroom-hold)
          (set! (-> self reg) -1)   ;; -1 = la rampe d'entree, voir PHYSROOM-REGSE
          (set! (-> self phase) PHYSROOM-PH-REGS)))))

    ;; ---- 9 quinquies. SPEC 14 A 20 REJOUEES DANS LA POSE EPINGLEE (cycle 66) -----------------
    ;; Voir le pave de PHYSROOM-PH-REGS. Tout ici est celui de PH-REG — meme tables, meme
    ;; `physroom-reg-drive`, meme point d'ouverture de fenetre — SAUF la pose, qui est epinglee
    ;; PAR SON NOM et REVALIDEE a l'execution par `PHYSREGSB`. On ne fait pas confiance a
    ;; l'epingle, on la mesure : c'est le geste du cycle 55, repris tel quel.
    ((= (-> self phase) PHYSROOM-PH-REGS)
     (cond
       ((< (-> self reg) 0)
        (physroom-hold)
        ;; L'ETAT DE RETOUR EST REMIS A ZERO : `physroom-reg-drive` s'en sert pour sa rampe `pre`,
        ;; et il porte encore le point d'arrivee de la DERNIERE fenetre de PH-REG (le roulis finit
        ;; a -35 deg). Sans ca la premiere rampe de PH-REGS redescendrait d'un angle herite d'une
        ;; autre phase, dans une autre pose — un stimulus qu'on n'a pas commande.
        (when (= (-> self pframe) 1)
          (set! (-> self retang) 0.0)
          (set! (-> self rety) 0.0)
          (set! (-> self retz) 0.0)
          (cond
            ((>= *physroom-symai* 0)
             (physroom-set-anim *physroom-symai*)
             (format 0 "PHYSREGSPOSE ai=~D src=name~%" *physroom-symai*))
            (else
             ;; UNE EPINGLE QUI N'A PAS PRIS SE DIT. Sans cette ligne la phase rejouerait la pose
             ;; heritee sous le nom de « pose epinglee » — le faux vert le plus facile a produire.
             (format 0 "PHYSREGSPOSE ai=-1 src=INTROUVABLE~%"))))
        (when (and (>= *physroom-symai* 0)
                   (> (-> self pframe) 1) (<= (-> self pframe) (+ 1 PHYSROOM-MEASAT)))
          (physroom-advance-anim 1.0))
        (when (>= (-> self pframe) PHYSROOM-REGSE)
          (set! (-> self reg) 0)
          (set! (-> self pframe) 0)
          (phys-comexw-reset!)
          (phys-stats-reset!)))
       (else
        (let* ((r    (-> self reg))
               (pre  (-> *physroom-reg-pre* r))
               (drv  (-> *physroom-reg-drv* r))
               (post (-> *physroom-reg-post* r)))
          (physroom-reg-drive r (- (-> self pframe) (+ pre 1)))
          (when (= (-> self pframe) (max 1 pre))
            ;; LA POSE EST REVALIDEE ICI, au meme point de protocole que `PHYSREGB` dans PH-REG :
            ;; fenetre temoin r=0, sujet droit, immobile, a `home`. Les deux nombres se comparent
            ;; donc directement, et c'est tout l'objet de cette phase.
            (when (zero? r)
              (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
                (when hd
                  (dotimes (c (-> self nchain))
                   (when (> (phys-chain-links (-> self slot) c) 0)
                    (dotimes (l (phys-chain-links (-> self slot) c))
                      (format 0 "PHYSREGSB c=~D l=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                              c l
                              (phys-chain-bone hd (-> self slot) c l 0)
                              (phys-chain-bone hd (-> self slot) c l 1)
                              (phys-chain-bone hd (-> self slot) c l 2))))))))
            (phys-comexw-reset!)
            (phys-stats-reset!))
          (when (>= (-> self pframe) (+ pre (+ drv post)))
            ;; LES DEUX GRANDEURS SUR LESQUELLES §14 A §20 SONT JUGEES, et pas une de plus :
            ;; l'apex (emplacement 53) que six sections bornent, et le COM (43) que §14, §16, §17
            ;; et §18 bornent. Memes emplacements que `PHYSREG4` et `PHYSREG`, donc meme nature,
            ;; meme repere, meme B0 — un canal neuf rendrait les deux passes incomparables.
            (dotimes (c (-> self nchain))
              (when (> (phys-chain-links (-> self slot) c) 0)
                (format 0 "PHYSREGS c=~D r=~D apex=~f com=~f~%"
                        c r
                        (phys-diag (-> self slot) c 53)
                        (phys-diag (-> self slot) c 43))
                (physroom-emit-limit PHYSROOM-PH-REGS c r)))
            (set! (-> self pframe) 0)
            (+! (-> self reg) 1)
            (when (>= (-> self reg) PHYSROOM-REGN)
              (physroom-hold)
              (phys-stats-reset!)
              (phys-diag-reset!)
              (set! (-> self reg) -1)
              (set! (-> self pframe) 0)
              (set! (-> self phase) PHYSROOM-PH-REGT)))))))

    ;; ---- 9 sexies. SPEC 14 A 20 DANS LA POSE LA PLUS SYMETRIQUE MESUREE (cycle 67) -----------
    ;; Voir le pave de PHYSROOM-PH-REGT. C'est PH-REGS mot pour mot — memes tables, meme
    ;; `physroom-reg-drive`, meme point d'ouverture, memes emplacements de lecture (53 = apex,
    ;; 43 = COM) — et UNE SEULE variable declaree : la pose, qui n'est plus un nom ecrit dans le
    ;; source mais l'ARGMAX du balayage resolu a la frame.
    ((= (-> self phase) PHYSROOM-PH-REGT)
     (cond
       ((< (-> self reg) 0)
        (physroom-hold)
        (when (= (-> self pframe) 1)
          ;; meme remise a zero de l'etat de retour qu'a l'entree de PH-REGS, et pour la meme
          ;; raison : la derniere fenetre de PH-REGS finit a -35 deg de roulis.
          (set! (-> self retang) 0.0)
          (set! (-> self rety) 0.0)
          (set! (-> self retz) 0.0)
          (cond
            ((>= *physroom-best-a* 0)
             (physroom-set-anim *physroom-best-a*)
             ;; LE PAS D'AVANCE EST CALCULE POUR TOMBER EXACTEMENT SUR LA FRAME RETENUE.
             ;; `physroom-advance-anim` fait `fnum += adir * step * aspeed` ; on veut `fnum = f`
             ;; apres EXACTEMENT `PHYSROOM-MEASAT` avances, comme dans PH-REGS, pour que le point
             ;; de protocole soit le meme. D'ou `step = f / (MEASAT * aspeed)`. Une avance a 1.0
             ;; comme dans PH-REGS tomberait sur `54 * aspeed`, c'est-a-dire sur la frame que
             ;; personne n'a choisie — celle-la meme dont ce cycle montre qu'elle est le probleme.
             (set! (-> self regstep)
                   (/ *physroom-best-f*
                      (fmax 0.0001 (* (the float PHYSROOM-MEASAT) (-> self aspeed)))))
             (format 0 "PHYSREGTPOSE a=~D f=~f s=~f step=~f src=argmax~%"
                     *physroom-best-a* *physroom-best-f* *physroom-best-s* (-> self regstep)))
            (else
             ;; UN ARGMAX QUI N'A PAS PRIS SE DIT, et la phase rejoue alors la pose heritee sous
             ;; son propre nom au lieu de la faire passer pour la pose resserree.
             (set! (-> self regstep) 0.0)
             (format 0 "PHYSREGTPOSE a=-1 f=0.0 s=-2.0 step=0.0 src=INTROUVABLE~%"))))
        (when (and (>= *physroom-best-a* 0)
                   (> (-> self pframe) 1) (<= (-> self pframe) (+ 1 PHYSROOM-MEASAT)))
          (physroom-advance-anim (-> self regstep)))
        (when (>= (-> self pframe) PHYSROOM-REGTE)
          (set! (-> self reg) 0)
          (set! (-> self pframe) 0)
          (phys-comexw-reset!)
          (phys-stats-reset!)))
       (else
        (let* ((r    (-> self reg))
               (pre  (-> *physroom-reg-pre* r))
               (drv  (-> *physroom-reg-drv* r))
               (post (-> *physroom-reg-post* r)))
          (physroom-reg-drive r (- (-> self pframe) (+ pre 1)))
          (when (= (-> self pframe) (max 1 pre))
            ;; LA POSE EST REVALIDEE ICI, au MEME point de protocole que `PHYSREGB` et
            ;; `PHYSREGSB` : fenetre temoin r=0, sujet droit, immobile, a `home`. Les TROIS
            ;; nombres se comparent donc directement, et c'est tout l'objet de cette phase.
            (when (zero? r)
              (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
                (when hd
                  (dotimes (c (-> self nchain))
                   (when (> (phys-chain-links (-> self slot) c) 0)
                    (dotimes (l (phys-chain-links (-> self slot) c))
                      (format 0 "PHYSREGTB c=~D l=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                              c l
                              (phys-chain-bone hd (-> self slot) c l 0)
                              (phys-chain-bone hd (-> self slot) c l 1)
                              (phys-chain-bone hd (-> self slot) c l 2))))))))
            (phys-comexw-reset!)
            (phys-stats-reset!))
          (when (>= (-> self pframe) (+ pre (+ drv post)))
            (dotimes (c (-> self nchain))
              (when (> (phys-chain-links (-> self slot) c) 0)
                (format 0 "PHYSREGT c=~D r=~D apex=~f com=~f~%"
                        c r
                        (phys-diag (-> self slot) c 53)
                        (phys-diag (-> self slot) c 43))
                (physroom-emit-limit PHYSROOM-PH-REGT c r)))
            (set! (-> self pframe) 0)
            (+! (-> self reg) 1)
            (when (>= (-> self reg) PHYSROOM-REGN)
              (physroom-hold)
              (phys-stats-reset!)
              (phys-diag-reset!)
              (set! (-> self reg) -1)
              (set! (-> self pframe) 0)
              (set! (-> self phase) PHYSROOM-PH-REGA)))))))

    ;; ---- 9 septies. §18 A §20 AUTOUR DES AXES DU SUJET (cycle 67) ----------------------------
    ;; C'est PH-REGT mot pour mot — meme pose epinglee, memes tables, memes emplacements de
    ;; lecture — et UNE SEULE variable declaree : l'AXE de rotation, qui cesse d'etre un axe du
    ;; monde ecrit a la main pour devenir celui que le sujet porte, mesure a l'execution.
    ((= (-> self phase) PHYSROOM-PH-REGA)
     (cond
       ((< (-> self reg) 0)
        (physroom-hold)
        (when (= (-> self pframe) 1)
          (set! (-> self retang) 0.0)
          (set! (-> self rety) 0.0)
          (set! (-> self retz) 0.0)
          ;; LE DRAPEAU N'EST ARME QU'ICI, et il est desarme a la sortie de la phase : tout ce qui
          ;; precede doit rester identique au bit, et un drapeau qui survit a sa phase est le
          ;; moyen le plus simple de casser ca sans le voir.
          (set! *physroom-reg-axmode* 1)
          (cond
            ((>= *physroom-best-a* 0)
             (physroom-set-anim *physroom-best-a*)
             (set! (-> self regstep)
                   (/ *physroom-best-f*
                      (fmax 0.0001 (* (the float PHYSROOM-MEASAT) (-> self aspeed)))))
             (format 0 "PHYSREGAPOSE a=~D f=~f s=~f step=~f src=argmax~%"
                     *physroom-best-a* *physroom-best-f* *physroom-best-s* (-> self regstep)))
            (else
             (set! (-> self regstep) 0.0)
             (format 0 "PHYSREGAPOSE a=-1 f=0.0 s=-2.0 step=0.0 src=INTROUVABLE~%"))))
        (when (and (>= *physroom-best-a* 0)
                   (> (-> self pframe) 1) (<= (-> self pframe) (+ 1 PHYSROOM-MEASAT)))
          (physroom-advance-anim (-> self regstep)))
        ;; LA POSE EST REVALIDEE A LA FIN DE LA RAMPE, sujet droit, immobile, a `home` : la meme
        ;; condition que le point de protocole de `PHYSREGB` / `PHYSREGSB` / `PHYSREGTB`. PH-REGA
        ;; ne joue pas la fenetre temoin r=0, donc c'est ici et pas ailleurs.
        (when (= (-> self pframe) (- PHYSROOM-REGAE 1))
          (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
            (when hd
              (dotimes (c (-> self nchain))
               (when (> (phys-chain-links (-> self slot) c) 0)
                (dotimes (l (phys-chain-links (-> self slot) c))
                  (format 0 "PHYSREGAB c=~D l=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                          c l
                          (phys-chain-bone hd (-> self slot) c l 0)
                          (phys-chain-bone hd (-> self slot) c l 1)
                          (phys-chain-bone hd (-> self slot) c l 2))))))
            ;; LES TROIS AXES DU SUJET AU MEME INSTANT : c'est la donnee qui rend la substitution
            ;; d'axe VERIFIABLE au lieu d'etre affirmee dans un commentaire.
            (dotimes (wa 3)
              (format 0 "PHYSREGAW wa=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                      wa
                      (phys-axis-world (-> self slot) 0 wa 0)
                      (phys-axis-world (-> self slot) 0 wa 1)
                      (phys-axis-world (-> self slot) 0 wa 2)))))
        (when (>= (-> self pframe) PHYSROOM-REGAE)
          (set! (-> self reg) PHYSROOM-REGA0)
          (set! (-> self pframe) 0)
          (phys-comexw-reset!)
          (phys-stats-reset!)))
       (else
        (let* ((r    (-> self reg))
               (pre  (-> *physroom-reg-pre* r))
               (drv  (-> *physroom-reg-drv* r))
               (post (-> *physroom-reg-post* r)))
          (physroom-reg-drive r (- (-> self pframe) (+ pre 1)))
          (when (= (-> self pframe) (max 1 pre))
            (phys-comexw-reset!)
            (phys-stats-reset!))
          (when (>= (-> self pframe) (+ pre (+ drv post)))
            (dotimes (c (-> self nchain))
              (when (> (phys-chain-links (-> self slot) c) 0)
                (format 0 "PHYSREGA c=~D r=~D sgn=~f apex=~f com=~f~%"
                        c r *physroom-reg-sgn*
                        (phys-diag (-> self slot) c 53)
                        (phys-diag (-> self slot) c 43))
                (physroom-emit-limit PHYSROOM-PH-REGA c r)))
            ;; LE SENS REELLEMENT OBTENU — ET CETTE FOIS AVEC UNE GRANDEUR QUI VARIE.
            ;;
            ;; LA VERSION PRECEDENTE NE MESURAIT RIEN, ET LE CYCLE 67 L'A PUBLIE : elle lisait
            ;; `phys-axis-world`, c'est-a-dire le triedre que le SOLVEUR a classe UNE FOIS a
            ;; l'ancre. Il ne tourne pas avec le sujet. Resultat : `apy=0.095867` sur les SIX
            ;; fenetres, exactement la valeur de repos — une constante sous six stimuli differents,
            ;; donc un instrument non discriminant, rejete.
            ;;
            ;; CE QUI VARIE, LUI, EST LA POSITION DE L'ANCRE. `phys-diag 50/51/52` la rend en
            ;; repere monde, et c'est deja la grandeur dont `PHYSREGL` tire l'offset de pivot :
            ;; on ne fabrique pas un canal neuf, on relit celui-la a la fin du pilotage.
            ;; `dap` / `dver` / `dlat` sont son deplacement depuis le repos, PROJETE sur les trois
            ;; axes du sujet.
            ;; NATURE : trois LONGUEURS signees, en unites moteur (4096 u = 1 m).
            ;; REPERE : les axes du SUJET releves au repos — c'est dans ce repere-la, et pas dans
            ;;   celui du monde, que « avant » et « bas » ont un sens.
            ;; LECTURE HORS DEFAUT : 0,0,0 (aucune rotation). SENS : l'axe AP du solveur pointe
            ;;   vers l'ARRIERE (mesure ci-dessus), donc **dap < 0 = flexion VERS L'AVANT** ; l'axe
            ;;   vertical pointe vers le BAS, donc dver > 0 = l'ancre descend.
            (let* ((ax0 (phys-diag (-> self slot) 0 50))
                   (ay0 (phys-diag (-> self slot) 0 51))
                   (az0 (phys-diag (-> self slot) 0 52))
                   (dx  (- (- ax0 (-> self home x)) (-> self cex)))
                   (dy  (- (- ay0 (-> self home y)) (-> self cey)))
                   (dz  (- (- az0 (-> self home z)) (-> self cez))))
              (format 0 "PHYSREGAD r=~D sgn=~f dap=~f dver=~f dlat=~f~%"
                      r *physroom-reg-sgn*
                      (+ (* dx (phys-axis-world (-> self slot) 0 1 0))
                         (+ (* dy (phys-axis-world (-> self slot) 0 1 1))
                            (* dz (phys-axis-world (-> self slot) 0 1 2))))
                      (+ (* dx (phys-axis-world (-> self slot) 0 0 0))
                         (+ (* dy (phys-axis-world (-> self slot) 0 0 1))
                            (* dz (phys-axis-world (-> self slot) 0 0 2))))
                      (+ (* dx (phys-axis-world (-> self slot) 0 2 0))
                         (+ (* dy (phys-axis-world (-> self slot) 0 2 1))
                            (* dz (phys-axis-world (-> self slot) 0 2 2))))))
            (set! (-> self pframe) 0)
            (+! (-> self reg) 1)
            (when (>= (-> self reg) PHYSROOM-REGN)
              (cond
                ;; PREMIERE PASSE FINIE : on rejoue les SIX MEMES fenetres dans l'autre sens. Le
                ;; retour doux de la fenetre 9 ramenera le sujet depuis l'angle de fin de la
                ;; fenetre 14, comme entre deux fenetres ordinaires — aucune impulsion ajoutee.
                ((> *physroom-reg-sgn* 0.0)
                 (set! *physroom-reg-sgn* -1.0)
                 (set! (-> self reg) PHYSROOM-REGA0)
                 (set! (-> self pframe) 0)
                 (phys-comexw-reset!)
                 (phys-stats-reset!))
                (else
                 (physroom-hold)
                 (set! *physroom-reg-axmode* 0)
                 (set! *physroom-reg-sgn* 1.0)
                 (phys-stats-reset!)
                 (phys-diag-reset!)
                 (set! (-> self reg) -1)
                 (set! (-> self pframe) 0)
                 (set! (-> self phase) PHYSROOM-PH-REGB)))))))))

    ;; ---- 9 octies. §14 A §17 SUR LES AXES DU SUJET (cycle 70) --------------------------------
    ;; PH-REGT et PH-REGA ont rejoue les ROTATIONS ; celle-ci rejoue les TRANSLATIONS. Meme pose
    ;; epinglee, memes tables de duree et d'amplitude, memes emplacements de lecture, et UNE SEULE
    ;; variable declaree : l'axe. Voir le pave de `PHYSROOM-PH-REGB` pour la mesure qui la motive.
    ((= (-> self phase) PHYSROOM-PH-REGB)
     (cond
       ((< (-> self reg) 0)
        (physroom-hold)
        (when (= (-> self pframe) 1)
          (set! (-> self rety) 0.0)
          (set! (-> self retz) 0.0)
          (set! (-> self retang) 0.0)
          (cond
            ((>= *physroom-best-a* 0)
             (physroom-set-anim *physroom-best-a*)
             (set! (-> self regstep)
                   (/ *physroom-best-f*
                      (fmax 0.0001 (* (the float PHYSROOM-MEASAT) (-> self aspeed)))))
             (format 0 "PHYSREGBPOSE a=~D f=~f s=~f step=~f src=argmax~%"
                     *physroom-best-a* *physroom-best-f* *physroom-best-s* (-> self regstep)))
            (else
             (set! (-> self regstep) 0.0)
             (format 0 "PHYSREGBPOSE a=-1 f=0.0 s=-2.0 step=0.0 src=INTROUVABLE~%"))))
        (when (and (>= *physroom-best-a* 0)
                   (> (-> self pframe) 1) (<= (-> self pframe) (+ 1 PHYSROOM-MEASAT)))
          (physroom-advance-anim (-> self regstep)))
        ;; LES DEUX SENS SE MESURENT ICI ET NULLE PART AILLEURS : sujet DROIT, IMMOBILE, a `home`.
        ;; C'est la seule condition ou « le haut » et « l'avant » ont une definition, et c'est aussi
        ;; la ou l'offset de l'ancre vaut l'offset et rien d'autre.
        (when (= (-> self pframe) (- PHYSROOM-REGBE 1))
          (let* ((gv  (phys-shape (-> self slot) 0 16))
                 (ap0 (phys-link-rest-dir (-> self slot) 0 0 2))
                 (ap1 (phys-link-rest-dir (-> self slot) 1 0 2))
                 (gok (if (> (fabs gv) 0.5) 1 0))
                 (aok (if (and (> (fabs ap0) 0.03) (> (fabs ap1) 0.03) (> (* ap0 ap1) 0.0)) 1 0)))
            ;; le HAUT est l'oppose de la gravite ; l'AVANT est le sens de la saillie du sein.
            (set! (-> self tus) (if (> gv 0.0) -1.0 1.0))
            (set! (-> self tfs) (if (> ap0 0.0) 1.0 -1.0))
            ;; UN SENS QUI NE SE MESURE PAS N'EST PAS DEVINE : la phase retombe en mode MONDE et le
            ;; DIT. Une passe qui se croirait en repere sujet sans y etre serait le faux vert type.
            (set! *physroom-reg-trmode* (if (and (nonzero? gok) (nonzero? aok)) 1 0))
            ;; DEUX LIGNES ET PAS UNE : `format` de GOAL plafonne a huit parametres, destination
            ;; et chaine de format COMPRISES. Le lecteur les rapproche, il n'y en a qu'une paire.
            (format 0 "PHYSREGBS gv=~,,6f ap0=~,,6f ap1=~,,6f~%" gv ap0 ap1)
            (format 0 "PHYSREGBS2 us=~f fs=~f gok=~D aok=~D trm=~D~%"
                    (-> self tus) (-> self tfs) gok aok *physroom-reg-trmode*))
          ;; L'OFFSET DE L'ANCRE, RELEVE AU MEME INSTANT ET POUR LA MEME RAISON. Les fenetres de
          ;; TRANSLATION ne passent pas par la branche qui le releve pour les rotations ; sans ce
          ;; relevage, `PHYSREGBD` soustrairait l'offset laisse par la derniere fenetre de PH-REGA.
          (let ((ax0 (phys-diag (-> self slot) 0 50))
                (ay0 (phys-diag (-> self slot) 0 51))
                (az0 (phys-diag (-> self slot) 0 52)))
            (cond
              ((and (= ax0 0.0) (= ay0 0.0) (= az0 0.0))
               (format 0 "PHYSREGBL cex=0.0 cey=0.0 cez=0.0 src=0~%"))
              (else
               (set! (-> self cex) (- ax0 (-> self home x)))
               (set! (-> self cey) (- ay0 (-> self home y)))
               (set! (-> self cez) (- az0 (-> self home z)))
               (format 0 "PHYSREGBL cex=~f cey=~f cez=~f src=1~%"
                       (-> self cex) (-> self cey) (-> self cez)))))
          (dotimes (wa 3)
            (format 0 "PHYSREGBW wa=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                    wa
                    (phys-axis-world (-> self slot) 0 wa 0)
                    (phys-axis-world (-> self slot) 0 wa 1)
                    (phys-axis-world (-> self slot) 0 wa 2)))
          ;; L'ENREGISTREMENT DE POSE DE CETTE PHASE, AU MEME POINT DE PROTOCOLE QUE `PHYSREGTB` ET
          ;; `PHYSREGAB`. SANS LUI, LE VERROU D'ASYMETRIE REFUSE — a juste titre — toute ligne qui
          ;; comparerait les deux chaines sur cette passe, et c'est precisement la comparaison qui
          ;; porte le resultat : un rig symetrique a 0,005 deg en bind doit rendre des reponses
          ;; egales quand le stimulus tombe sur le bon axe. Une phase qui produit une comparaison
          ;; gauche/droite sans publier sa pose n'est pas une phase finie.
          (let ((hd (if (-> self child) (the-as jak-hd (-> self child 0)) (the-as jak-hd #f))))
            (when hd
              (dotimes (c (-> self nchain))
               (when (> (phys-chain-links (-> self slot) c) 0)
                (dotimes (l (phys-chain-links (-> self slot) c))
                  (format 0 "PHYSREGBB c=~D l=~D ux=~,,6f uy=~,,6f uz=~,,6f~%"
                          c l
                          (phys-chain-bone hd (-> self slot) c l 0)
                          (phys-chain-bone hd (-> self slot) c l 1)
                          (phys-chain-bone hd (-> self slot) c l 2))))))))
        (when (>= (-> self pframe) PHYSROOM-REGBE)
          (set! (-> self reg) PHYSROOM-REGB0)
          (set! (-> self pframe) 0)
          (phys-comexw-reset!)
          (phys-stats-reset!)))
       (else
        (let* ((r    (-> self reg))
               (pre  (-> *physroom-reg-pre* r))
               (drv  (-> *physroom-reg-drv* r))
               (post (-> *physroom-reg-post* r)))
          (physroom-reg-drive r (- (-> self pframe) (+ pre 1)))
          (when (= (-> self pframe) (max 1 pre))
            (phys-comexw-reset!)
            (phys-stats-reset!))
          (when (>= (-> self pframe) (+ pre (+ drv post)))
            (dotimes (c (-> self nchain))
              (when (> (phys-chain-links (-> self slot) c) 0)
                ;; `PHYSREGBV` ET PAS `PHYSREGB` : le tag `PHYSREGB` EXISTE DEJA — c'est celui
                ;; des directions d'os de PH-REG (`c= l= ux= uy= uz=`). Deux enregistrements de
                ;; NATURE differente sous une meme etiquette rendent tout `grep -c` faux et
                ;; peuvent tromper n'importe quel lecteur futur. Mesure de la premiere course de
                ;; ce cycle : `grep -c "^PHYSREGB "` rendait 22 la ou les deux populations valent
                ;; 4 et 18. Renomme avant publication.
                (format 0 "PHYSREGBV c=~D r=~D trm=~D apex=~f com=~f~%"
                        c r *physroom-reg-trmode*
                        (phys-diag (-> self slot) c 53)
                        (phys-diag (-> self slot) c 43))
                (physroom-emit-limit PHYSROOM-PH-REGB c r)))
            ;; LE GESTE OBTENU, NOMME PAR LA MESURE — meme canal que `PHYSREGAD`, meme raison.
            ;; NATURE : trois LONGUEURS signees, unites de jeu (4096 u = 1 m).
            ;; REPERE : les axes du SUJET, ORIENTES par les deux signes mesures ci-dessus, donc
            ;;   `dver > 0` = l'ancre MONTE et `dap > 0` = elle va vers l'AVANT sans qu'aucune
            ;;   convention n'ait ete choisie. LECTURE HORS PILOTAGE : 0, 0, 0 (le temoin r=0).
            ;; CE QUI DISCRIMINE : un saut doit rendre `dap` et `dlat` quasi nuls, une course doit
            ;;   rendre `dver` et `dlat` quasi nuls. C'est la composante qui MANQUE qui nomme le
            ;;   geste, pas celle qui domine (lecon du cycle 68, payee sur un classificateur faux).
            (let* ((ax0 (phys-diag (-> self slot) 0 50))
                   (ay0 (phys-diag (-> self slot) 0 51))
                   (az0 (phys-diag (-> self slot) 0 52))
                   (dx  (- (- ax0 (-> self home x)) (-> self cex)))
                   (dy  (- (- ay0 (-> self home y)) (-> self cey)))
                   (dz  (- (- az0 (-> self home z)) (-> self cez))))
              (format 0 "PHYSREGBD r=~D trm=~D dap=~f dver=~f dlat=~f~%"
                      r *physroom-reg-trmode*
                      (* (-> self tfs)
                         (+ (* dx (phys-axis-world (-> self slot) 0 1 0))
                            (+ (* dy (phys-axis-world (-> self slot) 0 1 1))
                               (* dz (phys-axis-world (-> self slot) 0 1 2)))))
                      (* (-> self tus)
                         (+ (* dx (phys-axis-world (-> self slot) 0 0 0))
                            (+ (* dy (phys-axis-world (-> self slot) 0 0 1))
                               (* dz (phys-axis-world (-> self slot) 0 0 2)))))
                      (+ (* dx (phys-axis-world (-> self slot) 0 2 0))
                         (+ (* dy (phys-axis-world (-> self slot) 0 2 1))
                            (* dz (phys-axis-world (-> self slot) 0 2 2))))))
            (set! (-> self pframe) 0)
            (+! (-> self reg) 1)
            (when (>= (-> self reg) PHYSROOM-REGBN)
              (physroom-hold)
              (set! *physroom-reg-trmode* 0)
              (phys-stats-reset!)
              (phys-diag-reset!)
              (set! (-> self phase) PHYSROOM-PH-REPORT)))))))

    ;; ---- 10. RAPPORT --------------------------------------------------------------------------
    ((= (-> self phase) PHYSROOM-PH-REPORT)
     (physroom-report)
     (set! (-> self phase) PHYSROOM-PH-DONE)
     (set! (-> self pframe) 0))

    (else
     (physroom-hold)))
  (none))

(defstate phys-subject-run (phys-subject)
  :code (behavior () (loop (suspend)))
  :trans (behavior () (physroom-tick))
  :post (behavior () (ja-post)))

;; ------------------------------------------------------------------------------------------------
;; UN ART-GROUP DE KEIRA, PAR NOM. Deux sources, dans cet ordre, et la source utilisee est publiee :
;;
;;   1. DEJA RESIDENT dans le repertoire d'art d'un niveau charge. C'est le cas sur le DEVICE, ou la
;;      salle s'ouvre depuis une partie vivante : `assistant` est deja dans le repertoire de
;;      village1. Il faut alors le re-declarer dans celui de level-default, parce que c'est la que
;;      initialize-skeleton va le chercher pour un sujet sans entite (process-drawable.gc:343).
;;   2. CHARGE depuis un .go isole (`loado`), le cas x86 ou la salle part de l'ecran titre et ou
;;      aucun niveau n'est charge.
;;
;; Mesure du 2026-08-11 qui a impose ce chemin : sur le device, `files/out/jak1/obj/assistant-ag.go`
;; n'existe pas (seul le jeu de CGO/DGO y est extrait), `loado` a echoue — et le test de nullite
;; etait FAUX : `loado` rend le SYMBOLE #f, dont l'offset n'est pas zero, donc
;; `(nonzero? (the-as int ag))` etait VRAI et la salle continuait sur un art-group inexistant au lieu
;; d'echouer bruyamment. C'est le piege s7 : la nullite d'un basic se teste contre #f, pas contre 0
;; (et 0 est truthy, donc il faut LES DEUX tests).
;; ------------------------------------------------------------------------------------------------
(defun physroom-load-ag ((name string))
  ;; `art-group-get-by-name` est la methode du jeu lui-meme (level.gc:892) : elle balaie les trois
  ;; emplacements de niveau (level0, level1, level-default) et compare le nom que l'art-group porte.
  ;; On ne reimplemente pas la recherche, on appelle celle qui fait foi.
  (let ((res (art-group-get-by-name *level* name)))
    (cond
      ((and res (nonzero? (the-as int res)))
       ;; deja en memoire : on le re-declare dans level-default et on ne recharge rien
       (set-loaded-art (-> *level* level-default art-group) res)
       (format 0 "PHYSAG name=~S source=resident~%" name)
       res)
      (else
       (let ((ag (the-as art-group (loado (make-file-name (file-kind art-group) name 6 #f) global))))
         (cond
           ((and ag (nonzero? (the-as int ag)) (type-type? (-> ag type) art-group))
            (login ag)
            (set-loaded-art (-> *level* level-default art-group) ag)
            (format 0 "PHYSAG name=~S source=loado~%" name)
            ag)
           (else
            (format 0 "PHYSAGFAIL name=~S~%" name)
            (the-as art-group #f))))))))

;; ------------------------------------------------------------------------------------------------
;; NAISSANCE DU SUJET
;; ------------------------------------------------------------------------------------------------
(defbehavior init-phys-subject phys-subject ()
  (set! (-> self phase) PHYSROOM-PH-SETTLE)
  (set! (-> self pframe) 0)
  (set! (-> self ai) 0)
  (set! (-> self drive) 0)
  (set! (-> self slot) -1)
  (set! (-> self nchain) 0)
  (set! (-> self viol) 0)
  (set! (-> self nactor) 0)
  (set! (-> self killed) 0)
  (set! (-> self nanim) 0)
  (set! (-> self nenum) 0)
  (set! (-> self nag) 0)
  (set! (-> self dis) 0.0)
  (set! (-> self arm) 0.0)
  (set! (-> self injn) 0)
  (set! (-> self lvl) 0)
  (set! (-> self nchan) 0)
  (set! (-> self nperm) 0)
  (set! (-> self reg) 0)
  (set! (-> self rety) 0.0)
  (set! (-> self retz) 0.0)
  (set! (-> self retang) 0.0)
  (set! (-> self retax) 0)
  (set! (-> self cex) 0.0)
  (set! (-> self cey) 0.0)
  (set! (-> self cez) 0.0)
  (set! (-> self fnum) 0.0)
  (set! (-> self adir) 1.0)
  (set! (-> self aspeed) 1.0)
  (set! (-> self wraps) 0)
  (set! (-> self nframe) 1.0)
  (set! (-> self root) (new 'process 'trsqv))
  (vector-identity! (-> self root scale))
  (quaternion-identity! (-> self root quat))
  (set-vector! (-> self vel) 0.0 0.0 0.0 1.0)
  (position-in-front-of-camera! (-> self root trans) 40960.0 4096.0)
  (vector-copy! (-> self home) (-> self root trans))
  ;; l'art-group du sujet, charge PAR NOM et sans niveau, puis le squelette dessus.
  (let ((ag0 (physroom-load-ag (-> *physroom-ag-names* 0))))
    (cond
      ((and ag0 (nonzero? (the-as int ag0)))
       (+! (-> self nag) 1)
       (initialize-skeleton self *phys-subject-sg* '())
       (logclear! (-> self draw status) (draw-status no-skeleton-update))
       ;; LE NOMBRE DE CANAUX DU PORTEUR, tel que `do-joint-math!` le lit (process-drawable.gc:247),
       ;; et la pose de repos qui servira aux canaux sans source. Les deux sont etablis AVANT le
       ;; premier `physroom-set-anim`, donc avant la premiere permutation.
       (set! (-> self nchan)
             (if (nonzero? (-> self draw mgeo)) (the int (-> self draw mgeo num-joints)) 0))
       (when (and (nonzero? (-> self draw jgeo)) (> (-> self nchan) 0))
         (physroom-build-rest! (-> self draw jgeo) (-> self nchan)))
       (format 0 "PHYSREST chan=~D restok=~D~%" (-> self nchan) *physroom-restok*)
       (let ((njoint (if (nonzero? (-> self draw jgeo)) (-> self draw jgeo length) -1)))
         (format 0 "PHYSSUBJECT ag=~S elems=~D bones=~D joints=~D mgeo=~S~%"
                 (-> ag0 name)
                 (-> ag0 length)
                 (if (nonzero? (-> self draw skeleton)) (-> self draw skeleton length) -1)
                 njoint
                 (if (nonzero? (-> self draw mgeo)) (-> self draw mgeo name) "?"))
         ;; LA TABLE DES ANIMATIONS : les SIX art-groups de Keira. Une animation n'est retenue que
         ;; si son nombre de joints est celui du rig du sujet ; sinon elle est publiee REFUSEE.
         (dotimes (g (-> *physroom-ag-names* length))
           (let ((ag (if (zero? g) ag0 (physroom-load-ag (-> *physroom-ag-names* g)))))
             (when (and ag (nonzero? (the-as int ag)))
               (when (nonzero? g) (+! (-> self nag) 1))
               (dotimes (i (-> ag length))
                 (let ((e (-> ag data i)))
                   (when (and (nonzero? (the-as int e)) (= (-> e type) art-joint-anim))
                     (+! (-> self nenum) 1)
                     ;; TOUTES LES ANIMATIONS, Y COMPRIS CELLES DES VARIANTES (owner 2026-08-11
                     ;; 16:15 : « faut tester vraiment toutes les animations qu'utilise le perso
                     ;; tout au long du jeu, pas quelques unes ! »).
                     ;;
                     ;; Les 13 ecartees vivent sur les art-groups de Fire Canyon et des Lava Tubes,
                     ;; dont le rig porte 94 joints la ou celui du village 1 en porte 96. L'ancienne
                     ;; regle `(= nj njoint)` les refusait — un de-scope avec une raison ecrite
                     ;; a cote, ce qui n'est pas une couverture.
                     ;;
                     ;; Pourquoi les jouer sur CE rig est correct, et non un contournement : le
                     ;; nombre de joints ecrits est porte par le bloc compresse de l'ANIMATION
                     ;; (`frame-group frames`, joint.gc:940-955), pas par le squelette. Une
                     ;; animation a 94 joints en pilote 94 ; les joints 94 et 95, qui n'existent que
                     ;; sur le rig du village 1, gardent leur pose precedente. La salle publie donc
                     ;; le compte de chaque animation (`joints=`) ET la liste des joints propres au
                     ;; rig porteur, pour que personne n'ait a supposer lesquels ne sont pas pilotes.
                     ;; Si un de ces joints portait une chaine, la mesure le dirait : le compteur
                     ;; d'ancrage `rootdev` de cette chaine partirait, et la gate ROOT le refuserait.
                     (let ((nj (-> e length)))
                       (cond
                         ((< (-> self nanim) PHYSROOM-MAXANIM)
                          (set! (-> *physroom-anim-ag* (-> self nanim)) ag)
                          (set! (-> *physroom-anim-ix* (-> self nanim)) i)
                          (format 0 "PHYSANIM a=~D ag=~S name=~S joints=~D~%"
                                  (-> self nanim) (-> ag name) (-> e name) nj)
                          (when (string= (-> e name) PHYSROOM-SYMNAME)
                            (set! *physroom-symai* (-> self nanim)))
                          (when (string= (-> e name) PHYSROOM-ASYMNAME)
                            (set! *physroom-asymai* (-> self nanim)))
                          (when (!= nj njoint)
                            (format 0 "PHYSANIMRIG ag=~S name=~S joints=~D porteur=~D~%"
                                    (-> ag name) (-> e name) nj njoint))
                          (+! (-> self nanim) 1))
                         (else
                          (format 0 "PHYSANIMSKIP ag=~S name=~S joints=~D want=~D~%"
                                  (-> ag name) (-> e name) nj njoint))))))))))
         (format 0 "PHYSANIMS accepted=~D enumerated=~D ags=~D~%"
                 (-> self nanim) (-> self nenum) (-> self nag))
         ;; QUI PEUT PORTER LA PHYSIQUE : la physique de Keira vit sur son compagnon HD, et le
         ;; compagnon ne se greffe que sur un acteur dont le nom de merc est mappe. On ne le
         ;; suppose pas en lisant le source : on appelle la fonction que le jeu appelle, pour les
         ;; six mgeo de Keira, et on publie sa reponse. entry=-1 = aucun compagnon, donc aucune
         ;; chaine, donc rien a mesurer sur ce rig-la.
         (#when FLAG_HD_MODELS
           (dotimes (g (-> *physroom-mgeo-names* length))
             (format 0 "PHYSMGEO ag=~S mgeo=~S entry=~D~%"
                     (-> *physroom-ag-names* g)
                     (-> *physroom-mgeo-names* g)
                     (hd-desired-entry-for-mgeo (-> *physroom-mgeo-names* g))))))
       (cond
         ((> (-> self nanim) 0)
          (physroom-set-anim 0)
          (go phys-subject-run))
         (else
          (format 0 "PHYSFAIL reason=no-playable-animation~%")
          (deactivate self))))
      (else
       (format 0 "PHYSFAIL reason=art-group-assistant-not-loadable~%")
       (deactivate self))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; L'ENTREE. Appelee depuis C++ (kmachine.cpp, env OG_PHYS_ROOM) via *listener-function*, donc avec
;; un `pp` valide. Trois gestes, dans cet ordre : tuer le joueur, couper la naissance d'entites,
;; spawner le sujet.
;; ------------------------------------------------------------------------------------------------
(defun phys-room-start ()
  ;; NATURE / REPERE : un CONTROLE D'INVARIANT sur les numeros de phase, pas une mesure physique.
  ;; Il n'a ni repere spatial ni ligne de base — il rend 1 ou 0, et 0 invalide la course entiere.
  ;; POURQUOI IL EXISTE : `PHYSROOM-PH-PROXON` a vecu deux cycles a 31, c'est-a-dire au-dessus de
  ;; REPORT et sur le meme numero que DONE (cf. la note au-dessus de PHYSROOM-PH-REPORT). Le
  ;; balayage d'acteurs etrangers etait donc DESARME sur une jambe d'ablation et arme sur l'autre,
  ;; et rien dans aucune trace ne le disait. Cette ligne le dit, a chaque course, avant tout le
  ;; reste. Ce n'est pas une prevention structurelle — le seul vrai remede serait de numeroter les
  ;; phases par construction — mais c'est la fin du silence, et elle coute une ligne.
  ;; CYCLE 49 : `maxwork` designait PROXON (30) alors que la derniere phase de travail est
  ;; desormais PH-REG (31). Un garde-fou qui ne surveille pas la phase qu'on vient d'ajouter ne
  ;; garde rien — c'est exactement le silence que ce garde-fou a ete ecrit pour finir.
  ;; CYCLE 52 : `maxwork` designe desormais PH-SGN (32), la nouvelle derniere phase de TRAVAIL.
  ;; Le cycle 49 avait deja paye ce silence une fois — le garde-fou surveillait PROXON (30) quand
  ;; la derniere phase etait PH-REG (31). Un garde-fou qui ne surveille pas la phase qu'on vient
  ;; d'ajouter ne garde rien. PH-REG reste teste, il n'est pas retire de la conjonction.
  ;; CYCLE 56 : `maxwork` designe desormais PH-SYM (33). C'est la TROISIEME fois que cette ligne se
  ;; met a jour, et les deux premieres etaient des rattrapages APRES coup — le garde-fou surveillait
  ;; PROXON quand la derniere phase etait PH-REG, puis PH-REG quand c'etait PH-SGN. Un garde-fou qui
  ;; ne surveille pas la phase qu'on vient d'ajouter ne garde rien. Les anciennes restent dans la
  ;; conjonction : on n'en retire jamais une, on en ajoute.
  ;; CYCLE 67 : `maxwork` designait encore PH-SYM (33) alors que PH-SKINARM (34), PH-SKINDIS (35)
  ;; et PH-REGS (36) etaient arrivees depuis. QUATRIEME rattrapage de la meme ligne, et le troisieme
  ;; que son propre commentaire raconte. La conjonction nommee est complete ici — on n'en retire
  ;; jamais une, on en ajoute — mais elle ne porte PLUS le verdict a elle seule : `PHYSROOM-
  ;; PHASEVISITED`, emis en fin de course, publie le maximum REELLEMENT VISITE. Une liste qu'il
  ;; faut penser a rallonger ne garde rien ; une mesure n'a rien a se rappeler.
  ;; CYCLE 70 : CINQUIEME RATTRAPAGE, ET LE DERNIER — la ligne CALCULE desormais son maximum au
  ;; lieu de le nommer. `PH-REGB` (39) arrive, et une liste qu'il faut penser a rallonger a chaque
  ;; phase ajoutee ne garde rien : c'est le constat que ce commentaire fait quatre fois. Le `max`
  ;; ci-dessous est evalue a la compilation sur les MEMES constantes que la conjonction, donc une
  ;; phase ajoutee demain SANS etre ajoutee ici sera visible par `PHYSROOM-PHASEVISITED`, qui la
  ;; MESURE. Deux garde-fous, l'un derive et l'autre mesure, et aucun qui repose sur ma memoire.
  (format 0 "PHYSROOM-PHASEGUARD maxwork=~D report=~D done=~D ok=~D~%"
          (max PHYSROOM-PH-REGB (max PHYSROOM-PH-REGA (max PHYSROOM-PH-REGT PHYSROOM-PH-REGS)))
          PHYSROOM-PH-REPORT PHYSROOM-PH-DONE
          (if (and (< PHYSROOM-PH-PROXON PHYSROOM-PH-REPORT)
                   (< PHYSROOM-PH-REG PHYSROOM-PH-REPORT)
                   (< PHYSROOM-PH-SGN PHYSROOM-PH-REPORT)
                   (< PHYSROOM-PH-SYM PHYSROOM-PH-REPORT)
                   (< PHYSROOM-PH-SKINARM PHYSROOM-PH-REPORT)
                   (< PHYSROOM-PH-SKINDIS PHYSROOM-PH-REPORT)
                   (< PHYSROOM-PH-REGS PHYSROOM-PH-REPORT)
                   (< PHYSROOM-PH-REGT PHYSROOM-PH-REPORT)
                   (< PHYSROOM-PH-REGB PHYSROOM-PH-REPORT)
                   (< PHYSROOM-PH-REGA PHYSROOM-PH-REPORT)
                   (< PHYSROOM-PH-REPORT PHYSROOM-PH-DONE))
              1 0))
  (format 0 "PHYSROOM-START target-before=~A~%" *target*)
  (stop 'debug)                     ;; logic-target.gc:1268 — kill-by-name 'target + *target* = #f
  (set! *spawn-actors* #f)          ;; entity.gc:1029 — plus aucune entite ne nait
  (set! (-> *pc-settings* recharged-enhanced-models?) #t)
  (set! (-> *pc-settings* hd-look-keira) 1)   ;; 1 = keira-hd (entry 2)
  (set! (-> *pc-settings* physics?) #t)
  (#when FLAG_HD_MODELS (pc-set-recharged-enhanced-models! 1))
  (pc-set-physics! 1 (-> *pc-settings* physics-quality))
  (set! *physroom-proc*
        (the-as (pointer phys-subject)
                (process-spawn phys-subject :init init-phys-subject :from *pc-dead-pool* :to *default-pool*)))
  (format 0 "PHYSROOM-START target-after=~A spawned=~D~%" *target* (if (nonzero? (the-as int *physroom-proc*)) 1 0))
  ;; PREUVE D'EXECUTION DES DEUX CONVERTISSEURS DE NOTE-50, et pas une relecture de leur source.
  ;; Un Pade transcrit de travers en GOAL rendrait un nombre plausible et fausserait TOUT
  ;; l'amortissement en silence ; ces deux lignes sont ce qui l'interdit. Les valeurs attendues
  ;; sont calculees hors du jeu et ecrites dans le rapport AVANT la course :
  ;;   phys-decay 0.1686  -> 0.844847   (mode principal, retention par frame)
  ;;   phys-decay 0.7079  -> 0.492673   (mode secondaire SPEC 36)
  ;;   phys-osc-k2 0.65 0.5445367 -> 0.207351  et sa retention 0.492672  (SPEC 36 exact)
  ;;   phys-osc-k2 0.35 0.2838553 -> 0.072584                            (torsion SPEC 29)
  ;; NATURE : facteurs sans dimension d'une recurrence. REPERE : aucun, ce sont des scalaires.
  ;; LECTURE HORS DEFAUT : les six nombres ci-dessus, au 1e-5.
  (format 0 "PHYSDECAY a=~f b=~f~%" (phys-decay 0.1686) (phys-decay 0.7079))
  (format 0 "PHYSOSCK2 sec=~f seckd=~f tor=~f~%"
          (phys-osc-k2 0.65 0.5445367)
          (phys-decay (* 2.0 (* 0.65 0.5445367)))
          (phys-osc-k2 0.35 0.2838553))
  (none))

)
