(define *phys-sds* (new 'global 'array 'float (* PHYS-SC 3))) (define *phys-sdv* (new 'global 'array 'float (* PHYS-SC 3)))
(define *phys-sec*  (new 'global 'array 'float PHYS-SC))   ;; §36 modulation d'epaisseur (fraction)
