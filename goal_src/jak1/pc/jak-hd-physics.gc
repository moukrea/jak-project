;;-*-Lisp-*-
(in-package goal)

;; jak-hd-physics.gc — PHYSIQUE SECONDAIRE, DÉPART PROPRE (2026-08-11)
;;
;; L'owner, 2026-08-11 : « pour ce qui est de la physique, tu devrais parker tous les commits
;; propres à la physique sur une branche dédiée et repartir propre en ne faisant un focus que sur
;; Keira comme on a dit ».
;;
;; L'ancien moteur (6000 lignes) est parké sur la branche `physics-attic-2026-08-11`. Il n'est PAS
;; une base de travail : la cause mesurée de son échec est l'empilement de suppresseurs — il est
;; passé de 1940 à 6000 lignes, les clamps de 9 à 84 occurrences, la détection d'animation d'auteur
;; de 45 à 172 — jusqu'à ce que 42 % des mesures soient à mouvement nul et que les mèches et les
;; oreilles de Keira ne bougent plus du tout (earL 0.0092). On ne le rustine pas, on le réécrit.
;;
;; CE FICHIER EST LE SQUELETTE. Il fournit exactement les 5 prises que le reste du jeu attend, et
;; rien d'autre. La physique se construit dedans, en suivant `.autoport/prompts/SPEC-keira-physique.md`
;; et dans cet ordre :
;;
;;   ÉTAPE 1 — LA SALLE DE TEST, SANS JOUEUR. Jak n'est pas spawné (ni endormi, ni hors champ :
;;             absent). Le sujet est spawné par nom, seul dans la zone, déplacé haut/bas,
;;             gauche/droite, avec diverses accélérations et à-coups, et TOUTES ses animations
;;             jouées, chaque chiffre extrême portant le nom de l'animation.
;;   ÉTAPE 2 — les chaînes de Keira, GÉNÉRÉES depuis son rig : oreilles, cheveux (racine ancrée),
;;             mèches, seins, lunettes, ce qui pend. Rien d'autre.
;;   ÉTAPE 3 — les collisions de la liste exacte de la SPEC §3, avec de vrais colliders qui suivent
;;             la forme du personnage.
;;   ÉTAPE 4 — repos = pose du modèle (sauf ce qui pend), et priorité à l'intention d'animation ND.
;;
;; RÈGLES QUI NE SE RENÉGOCIENT PAS : un commentaire n'est pas une preuve (toute affirmation cite
;; une trace d'exécution) ; tout zéro exige un contrôle positif qui a fait MONTER le compteur ;
;; aucun suppresseur par défaut, et tout suppresseur ajouté chiffre le mouvement qu'il retire.

(#when FLAG_PHYSICS

  ;; ---- les 5 prises attendues par le reste du jeu -----------------------------------------------
  ;; jak-hd.gc appelle init/step/release sur chaque compagnon HD ; process-drawable.gc appelle
  ;; phys-rider-post! sur les acteurs stock ; progress-pc.gc audite le menu depuis init.
  ;; Elles sont inertes tant que l'étape 1 n'a pas produit de mesure : une physique non mesurée
  ;; n'est pas livrable, et une prise vide est honnête là où un moteur non prouvé ne l'est pas.

  (defun jak-hd-physics-init ((obj jak-hd)) (none))

  (defun jak-hd-physics-step ((obj jak-hd)) (none))

  (defun jak-hd-physics-release ((obj jak-hd)) (none))

  (defun phys-note-covered! ((n int)) (none))

  (defun phys-rider-post! ((obj process-drawable)) (none))
  )
