(defun phys-bsurf-sets ((slot int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS)) (-> *phys-slot-nbsurf* slot) 0))

(defun phys-bsurf-chain-sets ((slot int))
  "Combien d'ensembles de surface sont portes par des os de CHAINE dans ce slot. Ils sont ranges
   APRES les ensembles de corps et ne sont lus que par une requete qui nomme sa chaine."
  (let ((r 0))
    (when (and (>= slot 0) (< slot PHYS-SLOTS))
      (dotimes (cc PHYS-CHAINS) (+! r (-> *phys-bscn* (+ (* slot PHYS-CHAINS) cc)))))
    r))

(defun phys-bsurf-declared ((slot int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS)) (-> *phys-slot-nbsurf-decl* slot) 0))
