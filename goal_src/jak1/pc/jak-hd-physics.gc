(define *phys-apx* (new 'global 'array 'float PHYS-SCL)) (define *phys-apy* (new 'global 'array 'float PHYS-SCL)) (define *phys-apz* (new 'global 'array 'float PHYS-SCL))
(define *phys-c2* (new 'global 'array 'float 3))          ;; sortie de `phys-pt-exc!`, jamais lue ailleurs

(defun phys-pt-exc! ((bm matrix) (pre matrix) (ox float) (oy float) (oz float))
  "[NOTE-139] L'EXCURSION D'UN POINT DE CHAIR d'offset (ox,oy,oz) en espace os -> *phys-c2*. -> jak-hd-physics-NOTES.md"
  (set! (-> *phys-c2* 0) (- (+ (-> bm vector 3 x) (+ (* ox (-> bm vector 0 x)) (+ (* oy (-> bm vector 1 x)) (* oz (-> bm vector 2 x))))) (+ (-> pre vector 3 x) (+ (* ox (-> pre vector 0 x)) (+ (* oy (-> pre vector 1 x)) (* oz (-> pre vector 2 x)))))))
  (set! (-> *phys-c2* 1) (- (+ (-> bm vector 3 y) (+ (* ox (-> bm vector 0 y)) (+ (* oy (-> bm vector 1 y)) (* oz (-> bm vector 2 y))))) (+ (-> pre vector 3 y) (+ (* ox (-> pre vector 0 y)) (+ (* oy (-> pre vector 1 y)) (* oz (-> pre vector 2 y)))))))
  (set! (-> *phys-c2* 2) (- (+ (-> bm vector 3 z) (+ (* ox (-> bm vector 0 z)) (+ (* oy (-> bm vector 1 z)) (* oz (-> bm vector 2 z))))) (+ (-> pre vector 3 z) (+ (* ox (-> pre vector 0 z)) (+ (* oy (-> pre vector 1 z)) (* oz (-> pre vector 2 z)))))))
  (none))

