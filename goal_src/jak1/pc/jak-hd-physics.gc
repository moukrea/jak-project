;;-*-Lisp-*-
(in-package goal)

;; jak-hd-physics.gc — PHYSIQUE SECONDAIRE DE KEIRA (depart propre 2026-08-11).
;;
;; L'ancien moteur (6000 lignes) est parke sur `physics-attic-2026-08-11`. Il n'est PAS une base de
;; travail : la cause MESUREE de son echec est l'empilement de suppresseurs (1940 -> 6000 lignes,
;; clamps 9 -> 84, detection d'anim 45 -> 172) jusqu'a ce que 42 % des mesures soient a zero.
;; Celui-ci implemente `.autoport/prompts/SPEC-keira-physique.md`, section par section, et RIEN
;; d'autre. Aucun gel de calme, aucun sommeil, aucune hysteresis, aucun clamp de vitesse, aucun
;; masque ni filtre de volume : ce qui limite une chaine est soit la LONGUEUR D'UN OS, soit un
;; COLLIDER, soit la POSE DU MODELE. Ce sont les trois seuls limiteurs de la SPEC.
;;
;; LA FORME DU MOTEUR — et c'est elle qui fait tomber trois exigences d'un coup.
;; Le simule n'est pas la position du joint : c'est son ECART a la pose d'auteur, exprime dans le
;; repere de l'os porteur (l'ancre). La position ecrite vaut
;;
;;     p_l  =  T_l  +  R_ancre . o_l                (T = pose retargetee, o = ecart simule)
;;
;; d'ou, sans un seul cas particulier :
;;   SPEC 2  la racine ne bouge pas   -> o = 0 sur les liens `rootlock` : ils ne sont ni integres
;;                                       ni ecrits, la pose du retarget reste, au bit pres.
;;   SPEC 4  le repos = le modele     -> famille A (gravite nulle) : o -> 0, donc p -> T. Ce n'est
;;                                       pas un reglage, c'est le point fixe de l'integrateur.
;;                                       Famille B (gravite) : o s'arrete sur un ecart statique,
;;                                       ca pend et ca reste pendu.
;;   SPEC 5  l'animation d'auteur     -> le deplacement d'auteur (T) traverse avec un coefficient
;;                                       de 1 : la physique AJOUTE o, elle ne remplace rien et ne
;;                                       peut donc pas retarder l'animation. Un ressort ecrit en
;;                                       repere monde, lui, la retarde — c'est ce que mesure la
;;                                       colonne `authored` de la salle, et c'est ce qui separe
;;                                       les deux formes.
;;   SPEC 1  ce qui a de la physique  -> les chaines viennent du fichier de donnees, genere depuis
;;                                       le rig. Le moteur ne connait aucun nom de joint en dur.
;;   SPEC 3  collisions propres       -> projection hors des volumes ajustes sur le mesh, avec le
;;                                       PLANCHER DE POSE MODELE : un lien deja dans un volume au
;;                                       repos (une racine de cheveu sous le cuir chevelu) a le
;;                                       droit d'y etre, il n'a pas le droit d'aller PLUS PROFOND.
;;                                       C'est ce qui remplace le `colskip` retire.
;;   SPEC 7  ce qui fait foi          -> la position ECRITE du joint, mesuree ici meme.
;;
;; REGLE 0 (owner) : un commentaire n'est pas une preuve. Tout ce que ce fichier PRETEND faire est
;; mesure par la salle de test (phys-room.gc) et publie dans keira-room-table.txt.

(#when FLAG_PHYSICS

;; ------------------------------------------------------------------------------------------------
;; PONT C++ — le magasin de parametres vit dans game/kernel/jak1/kmachine.cpp (parse de
;; recharged_assets/physics_chains.txt). Aucune valeur flottante ne traverse la frontiere : tout
;; arrive en MILLI-unites (kmachine.cpp:884-887, phys_mi:1721).
;; ------------------------------------------------------------------------------------------------
(define-extern pc-physics-enabled              (function int))
(define-extern pc-physics-num-chains           (function string int))
(define-extern pc-physics-joint-role           (function string string int))
(define-extern pc-physics-chain-param-mi       (function string int int int))
(define-extern pc-physics-chain-link-radius-mi (function string int int int))
(define-extern pc-physics-num-colliders        (function string int))
(define-extern pc-physics-collider-param-mi    (function string int int int))
(define-extern pc-physics-collider-is-joint    (function string int string int))
(define-extern pc-physics-collider-is-joint2   (function string int string int))

;; parametres de chaine (ids: kmachine.cpp:998-1038)
(defconstant PHYS-P-STIFF   0)
(defconstant PHYS-P-DAMP    1)
(defconstant PHYS-P-GRAV    2)
(defconstant PHYS-P-RADIUS  6)
(defconstant PHYS-P-ROOTLK  7)
(defconstant PHYS-P-MASS   19)
(defconstant PHYS-P-HANG   20)
(defconstant PHYS-P-FAMILY 22)
(defconstant PHYS-P-COUPLE 27)
;; L'ANGLE QUE LA PEAU PEUT ENCAISSER, EN DEGRES — CHEVEUX SEULEMENT, 0 = pas de limite.
;; Owner 2026-08-11 21:15 : « certains maillons meriteraient un traitement pour eviter de creer des
;; angles extremes qui mettent en lumiere le lack of geometrie » ; 22:35, le perimetre : « juste sur
;; les meches, pas le reste, encore moins les seins ». La valeur est DERIVEE DU RIG par le
;; generateur (2*atan(min(L_entrant,L_sortant)/rayon), l'angle ou les deux tubes de peau se
;; croisent) et recalculee par son controle 6b : le moteur ne connait toujours aucun nom de joint.
(defconstant PHYS-P-MAXANG  3)

;; champs de collider (kmachine.cpp:1920-1986)
(defconstant PHYS-C-RADIUS 0)
(defconstant PHYS-C-SHAPE  3)
(defconstant PHYS-C-RADIUS2 4)
;; 6e passe de l'owner : « lBoob et rBoob sont des spheres NUES posees sur le joint-racine, alors
;; que tout le reste du corps est en capsules derivees. Une sphere au joint ne peut pas epouser un
;; sein. » Le centre de la sphere est desormais le CENTROIDE MESURE de la geometrie du joint, dans
;; l'espace bind de ce joint ; le moteur le transforme par la matrice de l'os, donc il suit
;; l'animation. Absent des donnees = 0,0,0 = le centre reste le joint (comportement d'avant).
(defconstant PHYS-C-OFFX   7)
(defconstant PHYS-C-OFFY   8)
(defconstant PHYS-C-OFFZ   9)

;; ------------------------------------------------------------------------------------------------
;; TAILLES. Un slot = un compagnon HD vivant. Keira seule aujourd'hui, mais le jeu peut porter
;; quatre compagnons (jak/daxter/keira/samos) et le moteur ne doit pas se marcher dessus.
;; ------------------------------------------------------------------------------------------------
(defconstant PHYS-SLOTS  4)
(defconstant PHYS-CHAINS 28)
(defconstant PHYS-LINKS  4)
(defconstant PHYS-COLS   96)
(defconstant PHYS-JOINTS 128)

(defconstant PHYS-SC   (* PHYS-SLOTS PHYS-CHAINS))
(defconstant PHYS-SCL  (* PHYS-SLOTS PHYS-CHAINS PHYS-LINKS))
(defconstant PHYS-SCO  (* PHYS-SLOTS PHYS-COLS))

;; identite du slot
(define *phys-slot-pid*  (new 'global 'array 'int32 PHYS-SLOTS))
(define *phys-slot-nch*  (new 'global 'array 'int32 PHYS-SLOTS))
(define *phys-slot-nco*  (new 'global 'array 'int32 PHYS-SLOTS))

;; topologie des chaines
(define *phys-nlink*  (new 'global 'array 'int32 PHYS-SC))
(define *phys-anchor* (new 'global 'array 'int32 PHYS-SC))   ;; joint porteur (parent rig du lien 0)
(define *phys-joint*  (new 'global 'array 'int32 PHYS-SCL))  ;; index de joint HD par lien

;; parametres resolus une fois a l'init
(define *phys-stiff*  (new 'global 'array 'float PHYS-SC))
(define *phys-damp*   (new 'global 'array 'float PHYS-SC))
(define *phys-grav*   (new 'global 'array 'float PHYS-SC))
(define *phys-mass*   (new 'global 'array 'float PHYS-SC))
(define *phys-hang*   (new 'global 'array 'float PHYS-SC))
(define *phys-couple* (new 'global 'array 'float PHYS-SC))
(define *phys-fam*    (new 'global 'array 'int32 PHYS-SC))   ;; 1 = A, 2 = B
(define *phys-rootlk* (new 'global 'array 'int32 PHYS-SC))
(define *phys-maxang* (new 'global 'array 'float PHYS-SC))   ;; degres, 0 = aucune limite d'angle
(define *phys-rad*    (new 'global 'array 'float PHYS-SCL))  ;; demi-epaisseur par lien
;; ------------------------------------------------------------------------------------------------
;; LE VOLUME QU'UN LIEN PORTE QUAND IL BOUGE — et c'est LE MEME que celui qu'il presente quand il
;; est un OBSTACLE. Owner, 6e passe : « c'est pas juste les capsules de collision qui bougent pas,
;; mais plutot mes capsules de collision qui sont pas bonnes ».
;;
;; Le moteur croyait deux choses differentes du meme morceau de corps :
;;   * comme OBSTACLE, le sein est la sphere que le generateur a ajustee sur le mesh — rayon 183,
;;     centre au CENTROIDE mesure de sa geometrie, 662 unites hors du joint (`collider lBoob`) ;
;;   * comme MOBILE, il etait une sphere de rayon 656 posee SUR LE JOINT — la demi-epaisseur
;;     `radii=`, qui mesure la distance des sommets a l'AXE de l'os, un axe qui traverse le sein de
;;     part en part. 656 unites, c'est 16 cm de rayon centre a 16 cm du sein.
;; Deux volumes pour un seul sein, et c'est le gros et mal place qui decidait de ses mouvements.
;; Mesure du 2026-08-11 18:40 : la poitrine reculait 8653 fois et son plafond d'excursion mordait
;; 1910 fois par course — la gravite arrivait bien (gn=0.83, tf=0.70) et la collision la renvoyait.
;;
;; Ce n'est ni un masque ni un flag (DIRECTIVES 4) : aucune donnee nouvelle, aucune exception par
;; nom. On cesse simplement d'avoir deux definitions du meme volume. Un joint qui ne declare aucune
;; sphere garde exactement le comportement precedent (`*phys-rad*`, centre sur le joint).
(define *phys-lcr* (new 'global 'array 'float PHYS-SCL))  ;; rayon du volume porte par le lien
(define *phys-lcx* (new 'global 'array 'float PHYS-SCL))  ;; son centre, en espace bind du joint
(define *phys-lcy* (new 'global 'array 'float PHYS-SCL))
(define *phys-lcz* (new 'global 'array 'float PHYS-SCL))

;; ETAT SIMULE — l'ecart a la pose d'auteur, dans le repere de l'ancre (verlet : courant + precedent)
(define *phys-ox*  (new 'global 'array 'float PHYS-SCL))
(define *phys-oy*  (new 'global 'array 'float PHYS-SCL))
(define *phys-oz*  (new 'global 'array 'float PHYS-SCL))
(define *phys-o1x* (new 'global 'array 'float PHYS-SCL))
(define *phys-o1y* (new 'global 'array 'float PHYS-SCL))
(define *phys-o1z* (new 'global 'array 'float PHYS-SCL))
;; position MONDE commitee (ardoise de travail des contraintes : longueur d'os, colliders)
(define *phys-px*  (new 'global 'array 'float PHYS-SCL))
(define *phys-py*  (new 'global 'array 'float PHYS-SCL))
(define *phys-pz*  (new 'global 'array 'float PHYS-SCL))
;; historique MONDE de la pose d'auteur, par lien : sa difference seconde est l'acceleration du
;; repere que la chaine subit. C'est la seule chose qui EXCITE une chaine dont l'ecart cible est nul.
(define *phys-t1x* (new 'global 'array 'float PHYS-SCL))
(define *phys-t1y* (new 'global 'array 'float PHYS-SCL))
(define *phys-t1z* (new 'global 'array 'float PHYS-SCL))
(define *phys-t2x* (new 'global 'array 'float PHYS-SCL))
(define *phys-t2y* (new 'global 'array 'float PHYS-SCL))
(define *phys-t2z* (new 'global 'array 'float PHYS-SCL))
(define *phys-warm* (new 'global 'array 'int32 PHYS-SC))     ;; 0 = pas encore amorce

;; colliders resolus (index de joint, -1 = absent)
(define *phys-cj*  (new 'global 'array 'int32 PHYS-SCO))
(define *phys-cj2* (new 'global 'array 'int32 PHYS-SCO))
(define *phys-cr*  (new 'global 'array 'float PHYS-SCO))
(define *phys-cr2* (new 'global 'array 'float PHYS-SCO))
;; centre de la sphere dans l'espace bind de son joint (0,0,0 = sur le joint)
(define *phys-cox* (new 'global 'array 'float PHYS-SCO))
(define *phys-coy* (new 'global 'array 'float PHYS-SCO))
(define *phys-coz* (new 'global 'array 'float PHYS-SCO))

;; ------------------------------------------------------------------------------------------------
;; LA POSE D'AUTEUR DE CHAQUE VOLUME, PRISE UNE FOIS PAR FRAME AVANT QUE QUOI QUE CE SOIT N'ECRIVE.
;;
;; Le plancher de pose modele (`floor0`) repond a UNE question : « a quelle profondeur ce lien
;; est-il deja, DANS LA POSE QUE L'AUTEUR A SCULPTEE ? » — ce qui est deja dedans au repos y reste.
;; C'est une propriete de la POSE DU MODELE, des deux cotes : le lien ET le volume.
;;
;; Or les chaines sont resolues l'une apres l'autre et chacune ECRIT son joint dans le squelette
;; avant que la suivante ne commence. Un volume porte par un joint simule (`lBoob`, `rBoob` : la
;; poitrine n'a pas de rootlock, donc son lien 0 est ecrit) presentait donc sa position SIMULEE au
;; calcul de `floor0`, pendant que le lien y etait pris a sa pose d'auteur. Les deux membres
;; n'etaient pas dans le meme etat, et le sens de l'erreur est exactement celui du defaut que
;; l'owner decrit : quand le sein simule se rapproche des lunettes, `floor0` MONTE, donc la
;; tolerance monte, donc la poussee qui devrait naitre a ce moment precis n'existe pas.
;; Algebre, sur les nombres du fichier de donnees : `gogglesMid` rl=150, sphere `lBoob` r=322 ->
;; `floor0 = 472 - d`, et `floor0 >= 2*rl = 300` des que d <= 172 u : la paire est declaree LIBRE
;; et ne sera plus jamais repoussee. C'est « les lunettes clipent legerement avec les seins, et
;; meme en idle ».
;;
;; La correction ne change pas la regle, elle la rend coherente : `floor0` est desormais mesure
;; contre le volume A SA POSE D'AUTEUR (ce tableau), et la penetration courante `dep` contre le
;; volume a sa position COURANTE. Pour les 31 volumes qui ne sont portes par aucun joint simule les
;; deux sont identiques au bit pres, donc rien d'autre ne bouge.
(define *phys-crax* (new 'global 'array 'float PHYS-SCO))   ;; extremite A, monde, pose d'auteur
(define *phys-cray* (new 'global 'array 'float PHYS-SCO))
(define *phys-craz* (new 'global 'array 'float PHYS-SCO))
(define *phys-crbx* (new 'global 'array 'float PHYS-SCO))   ;; extremite B (capsule), idem
(define *phys-crby* (new 'global 'array 'float PHYS-SCO))
(define *phys-crbz* (new 'global 'array 'float PHYS-SCO))
(define *phys-crok* (new 'global 'array 'int32 PHYS-SCO))   ;; 1 = instantane pris cette frame

;; ------------------------------------------------------------------------------------------------
;; MESURE (SPEC 7). Les colonnes du tableau de la salle sont accumulees ICI parce que c'est ici que
;; la position ecrite est connue. La salle remet a zero au debut de chaque fenetre et relit a la
;; fin ; elle n'invente aucun instrument par-dessus.
;;    0 nsamp    frames de la fenetre
;;    1 sumjump  somme des |delta o| de pointe (moyenne = vitesse de pointe)
;;    2 maxjump  pire |delta o| de pointe sur UNE frame
;;    3 maxroot  pire residu d'ancrage : max(|p0 - T0|, |residu de longueur du 1er lien libre|)
;;    4 maxpen   pire penetration RESIDUELLE (au-dela du plancher de pose modele) apres commit
;;    5 maxidle  pire |p - T| sur les liens libres = ecart a la pose du modele
;;  6..11 boite englobante de l'ecart de pointe (oxmin oxmax oymin oymax ozmin ozmax) : sa
;;         diagonale est l'AMPLITUDE de mouvement de la pointe due a la physique seule. L'animation
;;         d'auteur n'y contribue pas d'un micron : une chaine qui ne fait que suivre son os
;;         anime mesure zero. C'est volontairement le test le plus severe de « ca bouge ».
;; 12..15 SOMME de l'ecart de pointe et NOMBRE de frames : leur quotient est la POSITION MOYENNE de
;;         la pointe dans le repere de l'ancre. C'est un DEPLACEMENT SOUTENU, pas une variance, et
;;         c'est la seule chose qui puisse mesurer la gravite. Verdict de l'owner du 2026-08-11
;;         16:15 : « aucun mouvement en fonction de l'inclinaison quand elle se penche en avant pour
;;         souder, zero gravite sur ses seins ». Une inclinaison tenue ne produit AUCUNE variance —
;;         la chaine se pose sur un nouvel equilibre et ne bouge plus — donc la boite englobante
;;         (6..11) y mesure zero et l'a toujours mesure. La reponse gravitaire est l'ecart entre la
;;         moyenne a 0 degre et la moyenne a 60 degres : c'est ROOM-GRAVSAG, et rien ne le mesurait.
;;    16 pire |acceleration MONDE de la pose d'auteur| de la POINTE sur la fenetre, en u/frame^2.
;;         C'est LE STIMULUS QUE LA CHAINE A REELLEMENT RECU, quelle qu'en soit la source. Sans lui
;;         on ne peut pas distinguer « la chaine ne repond pas au pilotage » de « le pilotage est
;;         noye sous autre chose », et c'est cette confusion qui a fait publier des amplitudes
;;         identiques sous cinq stimuli differents.
;; ------------------------------------------------------------------------------------------------
;;    17 pire ALLONGEMENT RELATIF d'un lien sur la fenetre, |longueur/longueur_de_repos - 1|.
;;         NATURE : un rapport sans dimension. REPERE : aucun — c'est une longueur divisee par une
;;         longueur, mesuree entre le lien et SON ATTACHE (lien precedent, ou ancre pour le lien 0),
;;         donc invariante par tout mouvement du personnage. LECTURE QUAND LE DEFAUT EST ABSENT : 0,
;;         parce qu'une chaine qui ne fait que tourner autour de son attache garde sa longueur au
;;         bit pres. La meme grandeur existait deja par CHAINE et par COURSE (phys-diag 5) : elle est
;;         ici par FENETRE, donc attribuable a un pilotage — « ils s'allongent sur les mouvements
;;         BRUSQUES » est une phrase sur un pilotage, pas sur une course.
;;    18 |g_effective| / |g|, sans dimension, max sur la fenetre. NATURE : l'amplitude du stimulus
;;         gravitaire lui-meme, pas la reponse. REPERE : celui de l'ancre. LECTURE QUAND LE DEFAUT
;;         EST ABSENT : 0 debout (les deux gravites s'annulent), 1.0 a 60 degres. Sans elle, un
;;         affaissement nul ne dit pas si c'est la gravite qui n'arrive pas ou la chaine qui n'y
;;         repond pas — et c'est exactement l'ambiguite qui a coute trois passes.
;;    19 fraction TANGENTIELLE de g_effective : sqrt(1 - (g^.b^)^2) ou b^ est la direction de l'os.
;;         NATURE : sans dimension, dans [0,1]. La contrainte de longueur n'autorise qu'une ROTATION
;;         autour de l'attache : la part de la gravite dirigee LE LONG de l'os ne peut produire aucun
;;         deplacement, elle est annulee par construction. Une chaine dont la gravite est presque
;;         radiale ne s'affaissera jamais, quelle que soit la valeur de `gravity=` — c'est une
;;         propriete geometrique du rig, et sans ce nombre elle est indiscernable d'un bug.
(defconstant PHYS-ST 20)
(define *phys-st*  (new 'global 'array 'float (* PHYS-SC PHYS-ST)))
;; ------------------------------------------------------------------------------------------------
;; LE GRADIENT LE LONG DE LA CHAINE (7e passe de l'owner, 2026-08-11 16:30) : « entre la racine et
;; les pointes c'est zone de guerre et les pointes bougent quasi pas, au lieu d'un degrade
;; progressif des racines aux pointes ».
;;
;; Il decrit une FORME et le tableau publiait un SCALAIRE. `tipvar` ne regarde que la POINTE : une
;; chaine dont le maillon du milieu part en vrille pendant que la pointe reste collee a la pose
;; d'auteur rend exactement le meme `tipvar` qu'une chaine saine. Aucune mesure ne pouvait donc voir
;; le defaut qu'il decrit, et c'est la meme famille d'aveuglement que la reponse plate du matin.
;;
;; On garde donc la boite englobante de l'ecart POUR CHAQUE MAILLON, pas seulement pour la pointe.
;; SPEC 2 exige que la suite soit CROISSANTE de la racine vers la pointe ; toute chaine dont un
;; maillon intermediaire depasse sa pointe est un echec, quel que soit son `tipvar`.
;; 6 valeurs par maillon : oxmin oxmax oymin oymax ozmin ozmax.
(defconstant PHYS-LB 6)
(define *phys-lb* (new 'global 'array 'float (* PHYS-SCL PHYS-LB)))

;; ------------------------------------------------------------------------------------------------
;; LE GRADIENT, MAIS DANS LE BON REPERE — 10e passe de l'owner (2026-08-11 18:00) :
;;
;;   « les meches c'est mieux, mais le MILIEU est plus hysterique (bouge beaucoup plus) que les
;;     POINTES, c'est pas cense ! »
;;
;; La boite englobante ci-dessus disait le contraire (link0 0.0000, link1 0.2240, link2 0.3846,
;; croissante). Elle a tort, et pour une raison structurelle : elle mesure l'ecart de CHAQUE maillon
;; a sa pose d'auteur, un ecart qui se CUMULE le long de la chaine. Une pointe soudee a son parent —
;; qui ne bouge donc pas d'un micron PAR RAPPORT A LUI — herite integralement de l'ecart du parent et
;; affiche un grand chiffre. C'est la meme faute que « differencier la position au lieu de la
;; sortie » : la grandeur mesuree n'est pas celle du defaut decrit.
;;
;; Le mouvement PROPRE d'un maillon, c'est sa deviation ANGULAIRE par rapport a son attache :
;;
;;      angle( p_l - attache_l ,  auteur_l - auteur_attache )     en degres
;;
;; Elle vaut zero pour un maillon qui suit rigidement son parent, quelle que soit l'agitation de
;; celui-ci, et c'est CETTE suite que SPEC 2 exige croissante de la racine vers la pointe.
;; NATURE : un angle (une forme), pas une amplitude. REPERE : celui du PARENT, par construction.
;; LECTURE QUAND LE DEFAUT EST ABSENT : une suite croissante, racine a 0 (rootlock).
(define *phys-la* (new 'global 'array 'float PHYS-SCL))

(define *phys-tx*  (new 'global 'array 'float PHYS-SC))   ;; ecart de pointe, frame precedente
(define *phys-ty*  (new 'global 'array 'float PHYS-SC))
(define *phys-tz*  (new 'global 'array 'float PHYS-SC))
(define *phys-thas* (new 'global 'array 'int32 PHYS-SC))

;; SPEC 5 — L'ANIMATION D'AUTEUR. Detection PAR CHAINE, dans le repere de l'ancre (rotation
;; comprise) : c'est la seule facon de distinguer « l'animateur a bouge CET os » de « l'os porteur a
;; tourne et a emmene la chaine avec lui ». Le second n'est pas une intention d'auteur sur la
;; chaine, et le confondre avec la premiere est exactement le piege qui a fige l'ancien moteur.
;;   u = pointe d'AUTEUR en repere ancre, s = pointe ECRITE en repere ancre (s = u + o).
;;   frame PILOTEE PAR L'ANIM  : |delta u| > PHYS-AUTH-EPS
;;   TRANSMISSION de la chaine : somme(delta s . delta u) / somme(delta u . delta u)
;; Un ressort en repere monde retarde l'auteur et transmet ~0.5 ; la forme additive transmet 1.0.
;; Ces compteurs survivent aux fenetres : c'est le bilan de la course.
(define *phys-rtx*  (new 'global 'array 'float PHYS-SC))
(define *phys-rty*  (new 'global 'array 'float PHYS-SC))
(define *phys-rtz*  (new 'global 'array 'float PHYS-SC))
(define *phys-rhas* (new 'global 'array 'int32 PHYS-SC))
(define *phys-ahit* (new 'global 'array 'float PHYS-SC))
(define *phys-aok*  (new 'global 'array 'float PHYS-SC))
(define *phys-adot* (new 'global 'array 'float PHYS-SC))
(define *phys-anrm* (new 'global 'array 'float PHYS-SC))
(define *phys-dsum* (new 'global 'array 'float PHYS-SC))   ;; somme |delta ecart| sur ces frames
(define *phys-usum* (new 'global 'array 'float PHYS-SC))   ;; somme |delta auteur| sur ces frames
;; somme, sur TOUTE la course, du deplacement MONDE de la pose d'auteur de la pointe. Une chaine dont
;; ce nombre est nul pendant que le personnage est secoue n'est pas attachee au personnage : c'est la
;; seconde preuve, independante du rapport de distance, qu'un joint a ete envoye ailleurs.
(define *phys-tmov* (new 'global 'array 'float PHYS-SC))
;; frames, sur toute la course, ou cette chaine avait au moins une paire (lien, volume) EN CONTACT.
;; Publie a cote de la penetration : un zero sur une chaine qui n'a jamais rien touche ne dit pas la
;; meme chose qu'un zero sur une chaine qui a frotte le crane pendant 3000 frames.
(define *phys-conf* (new 'global 'array 'float PHYS-SC))
;; seuil de detection, en unites de jeu par frame (4096 u = 1 m). Un os que l'anim ne touche pas ne
;; bouge PAS dans ce repere : le seuil separe l'intention du bruit numerique de la cascade de
;; matrices, il ne filtre aucun mouvement reel.
(defconstant PHYS-AUTH-EPS 1.0)
;; tolerance de l'identite « position ecrite - pose d'auteur == ecart simule remis dans le monde »,
;; en unites de jeu. Les deux membres valent ~1e2 unites et une rotation de flottant 32 bits y laisse
;; ~1e-5. 0.05 u (12 micrometres) est trois mille fois au-dessus de ce bruit et vingt fois en dessous
;; du plus petit deplacement d'auteur detectable (1 u) : la fenetre est large des deux cotes.
(defconstant PHYS-AUTH-TOL 0.05)

;; MARGE DE SORTIE de la projection de collision, en unites de jeu (0.5 u = 0.12 mm). Ce n'est pas
;; un suppresseur de mouvement : c'est la tolerance qui rend la sortie STRICTEMENT geometrique
;; plutot que « a l'arrondi pres ». Sans elle, resoudre a l'egalite laisse un residu de signe
;; aleatoire de l'ordre de 1e-3 u, et « penetration nulle » devient « penetration nulle une fois
;; sur deux ». Elle retire 0.12 mm d'amplitude a la chaine, chiffre dans le rapport.
(defconstant PHYS-COL-MARGIN 0.5)

;; ------------------------------------------------------------------------------------------------
;; LA GRAVITE DE LA FAMILLE A DEPLACE LA CIBLE DU RESSORT, ELLE NE LUTTE PLUS CONTRE LUI.
;;
;; Superviseur, 2026-08-11 16:15, apres le troisieme « zero gravite sur ses seins » : « le ressort
;; qui ramene a la pose du modele est un rappel POSITIONNEL permanent, la gravite une force
;; constante bien plus faible. La cible du ressort doit s'incliner avec l'ancre, de sorte qu'a 60
;; degres l'equilibre lui-meme soit deplace. Sans ca, aucun reglage de gravity= ne produira jamais
;; quoi que ce soit. »
;;
;; PREMIERE REPONSE (7e passe) : deplacer la CIBLE du ressort plutot qu'ajouter une force, d'une
;; distance valant `gravity x 0.33 x longueur_d_os`. Elle a ete essayee, mesuree, et elle a ECHOUE :
;;
;;   * mesure du 2026-08-11 17:06, chestL : sag = 0.0156 m — la plus petite des 22 chaines, sept
;;     fois moins que backhair (0.1149) ;
;;   * le superviseur a TRIPLE `gravity=` (0.45 -> 1.30) entre deux builds : sag inchange a 0.0156.
;;     Une grandeur qui ne bouge pas quand son propre reglage est triple ne depend pas de ce
;;     reglage. C'etait la preuve, et elle etait deja dans le tableau.
;;
;; POURQUOI. Une cible plafonnee a une fraction de l'os est ecrasee par la contrainte de longueur
;; des qu'elle est dirigee LE LONG de l'os : la contrainte n'autorise qu'une rotation autour de
;; l'attache, donc la composante radiale est annulee par construction et ce qui survit est un
;; residu du second ordre, insensible au reglage. C'est exactement la geometrie d'un sein, dont l'os
;; part du buste vers l'avant pendant que l'inclinaison fait basculer la gravite... vers l'avant.
;; Et 0.33 etait un nombre invente, sans rien derriere (SPEC 7).
;;
;; CE QUI EST FAIT MAINTENANT : la gravite est une FORCE pour les deux familles, exactement comme la
;; famille B que l'owner a validee sur les bretelles. L'equilibre statique vaut alors g_eff/k2 —
;; proportionnel a `gravity=`, donc reglable a l'oeil, et sans constante inventee. Avec le reglage
;; du jour (stiffness 1.45, mass 1.45 => k2 = 0.0159, gravity 1.30) la poitrine dispose de
;; 1.30 x 11.16 / 0.0159 = 912 u = 22 cm d'affaissement d'equilibre AVANT projection, dont la part
;; utile est la composante TANGENTIELLE — publiee a cote du resultat (phys-stat 19) pour que
;; « la gravite n'arrive pas » et « la geometrie l'annule » cessent d'etre indiscernables.
;; La contrainte de longueur transforme ensuite ce deplacement en ROTATION autour de l'ancre a
;; longueur invariante : c'est la regle de l'owner, et elle s'applique sans exception ici aussi.
;; ------------------------------------------------------------------------------------------------

;; SENTINELLE « aucun contact ». Un residu de penetration reel ne depasse jamais quelques milliers
;; d'unites, donc -1e9 ne peut pas etre confondu avec une mesure ; le SEUIL de reconnaissance est en
;; revanche a -1e6 et pas a -999999999.0, parce que ce dernier s'arrondit a -1e9 EXACTEMENT en
;; flottant 32 bits : la comparaison devenait fausse et la sentinelle traversait jusque dans le
;; tableau (-244140 m sur earL, mesure du 2026-08-11). Meme piege qu'un 0 truthy.
;; ZONE MORTE du test de cote, en cosinus. Le test « le lien est-il du mauvais cote de l'axe ? » est
;; un SIGNE de produit scalaire : quand le lien frole le plan de l'axe, le vrai produit vaut ~0 et
;; son signe se decide sur l'arrondi, donc le solveur peut miroiter puis se re-miroiter sans fin.
;; On n'agit donc que quand le lien est FRANCHEMENT de l'autre cote : cos < -0.05. Comparaison au
;; carre, sans racine, parce que ce test est dans la boucle chaude.
;; CE QUI EST MESURE, et rien de plus : sur x86 la zone morte fait passer les corrections de 8338 a
;; 7313 par course et le residu de 638 a 595, sans rien changer aux amplitudes. Une course device a
;; bien rapporte 85 396 420 corrections, mais SON squelette n'etait pas pose (toutes les mesures a
;; zero, 13 millions de paires « lien entierement dans le volume ») : ce chiffre-la ne dit rien sur
;; arm64, il dit que la course etait degeneree. Ne pas le citer comme une divergence de backend.
(defconstant PHYS-SIDE-COS 0.05)
(defconstant PHYS-SIDE-COS2 0.0025)

(defconstant PHYS-NOCONTACT -1000000000.0)
(defconstant PHYS-NOCONTACT-LIMIT -1000000.0)

;; injection de defaut pour le CONTROLE POSITIF (SPEC 7 : tout zero exige un controle qui a fait
;; MONTER le compteur). 0 = desarme. > 0 = chaque lien libre est pousse de N unites vers l'interieur
;; du corps APRES la resolution : la penetration residuelle doit alors exploser. La salle arme,
;; mesure, desarme.
(define *phys-inject* 0.0)
;; combien de poussees ont REELLEMENT eu lieu. Un controle positif qui n'a rien injecte ne prouve
;; rien : c'est ce compteur, pas la valeur armee, qui dit que le defaut a ete pose.
(define *phys-injn* 0)

;; RETARD D'UNE FRAME injecte pour le CONTROLE POSITIF du canal d'auteur. 0 = desarme. Arme, la
;; position ecrite est batie sur la pose d'auteur de la frame PRECEDENTE au lieu de celle-ci : c'est
;; exactement le defaut que la SPEC 5 interdit (la physique retarde l'animation). Le compteur
;; d'identite doit alors s'effondrer. Sans ce controle, « l'animation passe intacte » serait une
;; affirmation invérifiable sur notre propre construction.
(define *phys-auth-lag* 0)

;; ce que les limiteurs RETIRENT de mouvement, mesure et non estime (SPEC 7 : un suppresseur se
;; chiffre). Deux limiteurs peuvent reculer un lien :
;;   retreat  quand la projection ne trouve aucun point admissible, le lien recule vers sa pose de
;;            modele — la seule position admissible par construction ;
;;   raddrop  quand un lien SEUL (pas de parent simule) depasse le rayon que le mesh lui mesure.
(define *phys-retreat-n*   0)
(define *phys-retreat-sum* 0.0)
(define *phys-raddrop-n*   0)
(define *phys-raddrop-sum* 0.0)
;; paires (lien, volume) ou le lien est ENTIEREMENT dans le volume a sa pose de modele : pas de
;; surface devant lui, donc rien a traverser. Comptees a chaque mesure, publiees par la salle.
(define *phys-buried-n*    0)
;; ... et le MEME compte, mais PAR CHAINE et UNE SEULE FOIS PAR FRAME. Le compteur global ci-dessus
;; est incremente par chaque appel de `phys-link-pen`, y compris les douze pas de dichotomie du
;; recul : son total (369 876) est un nombre d'evaluations, pas un nombre de paires enfouies, et il
;; ne dit pas QUELLE chaine est enfouie. Or c'est exactement la question que pose « le bas du
;; pantacourt est avale a l'interieur des mollets ». Ce drapeau n'est leve que pendant la passe de
;; MESURE (phys-pen-chain), donc le compte par chaine est un compte de frames x paires.
(define *phys-buried-tally* 0)
;; INVERSIONS. Owner 2026-08-11 : « j'ai encore vu un de ses seins retourne vers l'interieur ».
;; Cause : le ressort est symetrique autour de l'ancre, donc le cote oppose est un equilibre STABLE
;; mais FAUX, et la contrainte de longueur se taisait dans le cas degenere (distance sous 1e-4), ce
;; qui laissait la porte ouverte. Comptees ici, remises a zero par la salle, et un controle positif
;; les provoque expres pour prouver que le compteur voit quelque chose.
(define *phys-invn*    0)      ;; corrections appliquees (le solveur a remis un lien de son cote)
(define *phys-invres*  0)      ;; INVERSIONS RESIDUELLES apres tout le solveur : doit valoir ZERO
(define *phys-invfix*  0)
(define *phys-inv-inject* 0)
;; RE-ASSISES : liens dont la pose du modele est hors de portee de leur porteur et que le moteur
;; replace sur lui. Owner/superviseur 2026-08-11 : « pantflapL retablie — elle avait ete supprimee du
;; fichier au lieu d'etre REPAREE ».
(define *phys-reseat-n* 0)
;; ... et combien de ces re-assises ont du retomber sur l'ancienne heuristique (rayon le long de
;; l'os du porteur) faute de bind-pose lisible. Doit valoir ZERO : un secours silencieux est un
;; defaut qui attend, et c'est celui-la qui posait le pan du pantacourt dans le mollet.
(define *phys-reseat-fb* 0)
;; REPLIS DU RECUL : fois ou le point de depart de sa recherche, pris sur la sphere du MODELE,
;; n'etait pas admissible et ou il a fallu repartir de la pose d'auteur exacte. Chacun laisse un
;; residu d'allongement sur ce lien-la : le chiffre dit combien, au lieu de le laisser deviner.
(define *phys-retfb-n* 0)

;; ------------------------------------------------------------------------------------------------
;; DIAGNOSTIC PAR CHAINE (6e passe de l'owner). Les trois defauts qu'il decrit se decident chaine
;; par chaine, donc les compteurs qui les mesurent sont PAR CHAINE — un total global ne dit pas si
;; ce sont les meches fines qui jittent ou les sangles de cheville.
;;   0 selfcol  corrections venues d'un volume porte par les PROPRES joints de la chaine. « Une
;;              meche est en collision permanente avec elle-meme » : doit valoir ZERO, et le
;;              controle positif (*phys-self-inject*) desarme l'exclusion pour le faire monter.
;;   1 retreat  reculs vers la pose du modele (le limiteur violent : il saute)
;;   2 flip     (lien, volume) qui ont CHANGE d'etat de contrainte d'une frame a l'autre. C'etait un
;;              interrupteur binaire evalue chaque frame sur la pose du modele : quand il bascule,
;;              la position du lien saute. C'est la mesure du defaut « jitter » lui-meme.
;;   3 inv      inversions corrigees (le lien etait passe du mauvais cote de son attache)
;;   4 invres   inversions RESIDUELLES apres tout le solveur : doit valoir ZERO
;;   5 elong    pire allongement RELATIF du premier lien libre (|l/l0 - 1|) : « les seins
;;              s'allongent sur les changements brusques de direction » — doit rester sous 3 %.
;;   6 raddrop  fois ou le PLAFOND D'EXCURSION d'un lien seul (son propre rayon mesure) a mordu.
;;              C'est un suppresseur, donc SPEC 7 exige qu'il chiffre ce qu'il retire, PAR CHAINE :
;;              un affaissement gravitaire ecrete par ce plafond se lit ici et nulle part ailleurs.
;;   7 bendcut  DEGRES retires par l'attenuation d'angle des CHEVEUX, cumules sur la fenetre.
;;              NATURE : un angle cumule, donc un SUPPRESSEUR chiffre (SPEC 7). REPERE : celui de
;;              l'attache du maillon, comme la mesure d'angle elle-meme. LECTURE QUAND LE DEFAUT EST
;;              ABSENT : 0 — une meche qui ne se replie jamais au-dela de sa limite geometrique ne
;;              paie rien, et c'est le cas de lmidhair (116 deg mesures pour une limite de 141.6).
;;   8 shape    pire ECART RELATIF du maillon a sa pose de modele, |p - T| / longueur de son os.
;;              NATURE : un rapport sans dimension — la DEFORMATION que le skinning lineaire impose
;;              a la chair, pas une amplitude : deux sommets voisins dont les poids different d'un
;;              dixieme s'ecartent d'un dixieme de ce nombre. C'est la grandeur de « ca change de
;;              taille, plus petit plus gros ecrase » (owner, 11e passe), que ni tipvar (une
;;              variance) ni elong (la longueur de l'OS, qui ne bouge pas) ne pouvaient decrire.
;;              REPERE : aucun, c'est une longueur sur une longueur mesuree depuis l'attache.
;;              LECTURE QUAND LE DEFAUT EST ABSENT : 0 (le maillon est a sa pose de modele).
;;  10 tiprot   pire ROTATION D'OS effectivement ECRITE dans la matrice du DERNIER maillon, en
;;              degres. NATURE : un angle. REPERE : celui de l'attache du maillon. LECTURE QUAND LE
;;              DEFAUT EST PRESENT : ZERO — c'est le defaut, le dernier maillon ne recevait qu'une
;;              translation, donc sa peau etait cisaillee de toute la rotation manquante. C'est donc
;;              une mesure a l'envers des autres : un NON-ZERO est la preuve d'execution du chemin
;;              neuf, et il doit valoir la deviation angulaire que ROOM-GRADIENT publie pour ce meme
;;              maillon (chestL 39.29 deg, earL 35.95, toestrapL 15.39 sur la course du 2026-08-12).
;;   9 buried   paires (lien, volume) ou le lien est ENTIEREMENT dans un volume A SA POSE DE MODELE,
;;              donc sans surface devant lui — le compteur global existait deja, il est ici PAR
;;              CHAINE. C'est la mesure du « bas du pantacourt avale a l'interieur des mollets,
;;              comme s'il s'arretait aux genoux » : un pan dont la pose de modele est dans la
;;              jambe n'a rien a traverser, donc meshpen reste a zero pendant que l'owner le voit
;;              disparaitre. NATURE : un compte de paires. LECTURE QUAND LE DEFAUT EST ABSENT : 0.
;;   11 side     paires (lien, volume) ou le lien a TRAVERSE l'axe du volume dans lequel sa pose de
;;              modele se trouvait : il est du COTE OPPOSE a celui que l'auteur lui donne.
;;              C'est la mesure que les DIRECTIVES reclament depuis la 11e passe (`ROOM-SIDE`), et
;;              elle existe parce qu'aucune des autres ne peut voir ce defaut-la : une profondeur
;;              de penetration est MAXIMALE sur l'axe et REDESCEND quand le lien ressort de
;;              l'autre cote, donc un lien qui a traverse de part en part rend une profondeur
;;              faible — indistinguable d'un lien sagement dehors. C'est pour ca que « le bas du
;;              pantacourt est a l'interieur des mollets » et « en cinematique les lunettes
;;              traversent le buste pour aller se poser dans le dos » coexistent avec meshpen=0.
;;              NATURE : un COMPTE de paires, pas une distance — le defaut est un changement de
;;              COTE, une grandeur discrete, et une distance ne peut pas le decrire.
;;              REPERE : celui du volume — direction allant du point le plus proche de son AXE vers
;;              le lien, comparee entre la pose du modele et maintenant. Ni monde, ni ancre : c'est
;;              le volume qui a deux cotes.
;;              LECTURE QUAND LE DEFAUT EST ABSENT : 0. Un lien qui reste du cote ou l'auteur l'a
;;              pose ne compte jamais, quelle que soit son amplitude.
(defconstant PHYS-DG 12)
(define *phys-dg* (new 'global 'array 'float (* PHYS-SC PHYS-DG)))
;; etat de contrainte de la frame precedente, par (lien, volume), pour compter les bascules.
;; 1 bit par volume, un mot par lien : PHYS-COLS <= 96 tient sur trois mots de 32 bits.
(defconstant PHYS-FLIPW 3)
(define *phys-fl* (new 'global 'array 'int32 (* PHYS-SCL PHYS-FLIPW)))
(define *phys-flhas* (new 'global 'array 'int32 PHYS-SCL))
;; CONTROLE POSITIF de l'auto-collision : arme, l'exclusion chaine<->ses propres volumes est levee.
;; Le compteur `selfcol` doit alors monter — sinon il ne mesure rien.
(define *phys-self-inject* 0)

;; nombre de joints du rig courant (relu a chaque step, pas de cache douteux)
(define *phys-njoint* 0)

;; deltas de propagation aux descendants non simules (les verres de lunettes pendent sous
;; gogglesMid : si on bouge le milieu sans eux, ils se decrochent).
(define *phys-dmat* (new 'global 'inline-array 'matrix PHYS-JOINTS))
(define *phys-dhas* (new 'global 'array 'int32 PHYS-JOINTS))

;; ------------------------------------------------------------------------------------------------
;; petits utilitaires
;; ------------------------------------------------------------------------------------------------
(defun phys-mi->f ((v int))
  "milli-unites du magasin C++ -> flottant."
  (/ (the float v) 1000.0))

(defun phys-slot-for-pid ((pid int))
  "slot deja alloue a ce pid, -1 sinon."
  (let ((r -1))
    (dotimes (i PHYS-SLOTS)
      (when (and (< r 0) (= (-> *phys-slot-pid* i) pid)) (set! r i)))
    r))

(defun phys-slot-alloc ((pid int))
  "premier slot libre, -1 si plein."
  (let ((r -1))
    (dotimes (i PHYS-SLOTS)
      (when (and (< r 0) (zero? (-> *phys-slot-pid* i))) (set! r i)))
    (when (>= r 0) (set! (-> *phys-slot-pid* r) pid))
    r))

;; ------------------------------------------------------------------------------------------------
;; INIT — resolution des chaines DEPUIS LE RIG. Le moteur ne porte aucun nom de joint : il parcourt
;; les joints du squelette HD, demande au magasin C++ le role de chaque NOM, et se construit ses
;; chaines. Une chaine absente du fichier de donnees n'existe pas ; un joint absent du rig non plus.
;; ------------------------------------------------------------------------------------------------
(defun jak-hd-physics-init ((obj jak-hd))
  (when (and (nonzero? (-> obj draw)) (nonzero? (-> obj draw jgeo)))
    (let* ((agname (-> *hd-ag-names* (-> obj entry)))
           (nch    (pc-physics-num-chains agname)))
      (cond
        ((<= nch 0)
         (format 0 "[HD-PHYS] no chain data for ~S — physics inert for this model~%" agname))
        (else
         (let ((slot (phys-slot-alloc (the int (-> obj pid)))))
           (cond
             ((< slot 0)
              (format 0 "[HD-PHYS] no free sim slot — physics inert for ~S~%" agname))
             (else
              (let ((njoint (-> obj draw jgeo length))
                    (nc     (min nch PHYS-CHAINS)))
                (set! (-> *phys-slot-nch* slot) nc)
                ;; remise a zero de la topologie du slot
                (dotimes (c PHYS-CHAINS)
                  (let ((sc (+ (* slot PHYS-CHAINS) c)))
                    (set! (-> *phys-nlink* sc) 0)
                    (set! (-> *phys-anchor* sc) -1)
                    (set! (-> *phys-warm* sc) 0)
                    (set! (-> *phys-thas* sc) 0)
                    (set! (-> *phys-rhas* sc) 0)))
                ;; --- 1. les joints portent les chaines : on lit le rig, pas une liste en dur ---
                (dotimes (k njoint)
                  (let* ((jn   (-> obj draw jgeo data k name))
                         (role (if jn (pc-physics-joint-role agname jn) -1)))
                    (when (>= role 0)
                      (let ((c    (shr role 8))
                            (link (logand role 255)))
                        (when (and (< c nc) (< link PHYS-LINKS))
                          (let ((sc (+ (* slot PHYS-CHAINS) c)))
                            (set! (-> *phys-joint* (+ (* sc PHYS-LINKS) link)) k)
                            (when (>= (+ link 1) (-> *phys-nlink* sc))
                              (set! (-> *phys-nlink* sc) (+ link 1)))
                            ;; l'ancre est le parent RIG du lien 0 (255 = racine -> pas d'ancre)
                            (when (zero? link)
                              (let ((p (the int (-> (-> obj khd-par) k))))
                                (set! (-> *phys-anchor* sc) (if (= p 255) -1 p))))))))))
                ;; --- 2. les parametres, une fois, depuis le fichier de donnees ---
                (let ((armed 0) (links 0))
                  (dotimes (c nc)
                    (let ((sc (+ (* slot PHYS-CHAINS) c)))
                      (set! (-> *phys-stiff* sc)  (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-STIFF)))
                      (set! (-> *phys-damp* sc)   (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-DAMP)))
                      (set! (-> *phys-grav* sc)   (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-GRAV)))
                      (set! (-> *phys-couple* sc) (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-COUPLE)))
                      (set! (-> *phys-hang* sc)   (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-HANG)))
                      (let ((m (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-MASS))))
                        (set! (-> *phys-mass* sc) (if (< m 0.01) 1.0 m)))
                      (set! (-> *phys-fam* sc)    (the int (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-FAMILY))))
                      (set! (-> *phys-rootlk* sc) (the int (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-ROOTLK))))
                      (set! (-> *phys-maxang* sc) (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-MAXANG)))
                      ;; rayons par lien : `radii=` s'il existe, sinon le `radius=` de la chaine
                      (let ((base (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-RADIUS))))
                        (dotimes (l PHYS-LINKS)
                          (let ((r (phys-mi->f (pc-physics-chain-link-radius-mi agname c l))))
                            (set! (-> *phys-rad* (+ (* sc PHYS-LINKS) l)) (if (< r 0.01) base r)))))
                      (when (> (-> *phys-nlink* sc) 0)
                        (+! armed 1)
                        (+! links (-> *phys-nlink* sc)))))
                  ;; --- 3. les colliders, ajustes sur le mesh, resolus vers des index de joint ---
                  (let ((nco (min (pc-physics-num-colliders agname) PHYS-COLS)))
                    (set! (-> *phys-slot-nco* slot) nco)
                    (dotimes (ci nco)
                      (let ((sco (+ (* slot PHYS-COLS) ci)))
                        (set! (-> *phys-cj* sco) -1)
                        (set! (-> *phys-cj2* sco) -1)
                        (set! (-> *phys-cr* sco)  (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-RADIUS)))
                        (let ((r2 (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-RADIUS2))))
                          (set! (-> *phys-cr2* sco) (if (< r2 0.01) (-> *phys-cr* sco) r2)))
                        (set! (-> *phys-cox* sco) (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-OFFX)))
                        (set! (-> *phys-coy* sco) (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-OFFY)))
                        (set! (-> *phys-coz* sco) (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-OFFZ)))
                        (dotimes (k njoint)
                          (let ((jn (-> obj draw jgeo data k name)))
                            (when jn
                              (when (and (< (-> *phys-cj* sco) 0)
                                         (nonzero? (pc-physics-collider-is-joint agname ci jn)))
                                (set! (-> *phys-cj* sco) k))
                              (when (and (< (-> *phys-cj2* sco) 0)
                                         (nonzero? (pc-physics-collider-is-joint2 agname ci jn)))
                                (set! (-> *phys-cj2* sco) k)))))))
                    ;; --- 3b. LE VOLUME QUE CHAQUE LIEN PORTE. Par defaut sa demi-epaisseur,
                    ;; --- centree sur le joint (comportement precedent). Si ce joint declare deja
                    ;; --- une SPHERE ajustee sur le mesh, c'est ELLE — centre et rayon — parce que
                    ;; --- c'est le meme morceau de corps, qu'il bouge ou qu'il soit heurte.
                    (dotimes (c nc)
                      (let ((sc (+ (* slot PHYS-CHAINS) c)))
                        (dotimes (l PHYS-LINKS)
                          (let ((scl (+ (* sc PHYS-LINKS) l)))
                            (set! (-> *phys-lcr* scl) (-> *phys-rad* scl))
                            (set! (-> *phys-lcx* scl) 0.0)
                            (set! (-> *phys-lcy* scl) 0.0)
                            (set! (-> *phys-lcz* scl) 0.0)
                            (let ((kk (-> *phys-joint* scl)))
                              (when (>= kk 0)
                                (dotimes (ci nco)
                                  (let ((sco (+ (* slot PHYS-COLS) ci)))
                                    (when (and (= (-> *phys-cj* sco) kk) (< (-> *phys-cj2* sco) 0))
                                      (set! (-> *phys-lcr* scl) (-> *phys-cr* sco))
                                      (set! (-> *phys-lcx* scl) (-> *phys-cox* sco))
                                      (set! (-> *phys-lcy* scl) (-> *phys-coy* sco))
                                      (set! (-> *phys-lcz* scl) (-> *phys-coz* sco))
                                      (format 0 "[HD-PHYS] vol c=~D l=~D joint=~D r=~f -> r=~f off=~f~%"
                                              c l kk (-> *phys-rad* scl) (-> *phys-cr* sco)
                                              (sqrtf (+ (* (-> *phys-cox* sco) (-> *phys-cox* sco))
                                                        (+ (* (-> *phys-coy* sco) (-> *phys-coy* sco))
                                                           (* (-> *phys-coz* sco) (-> *phys-coz* sco)))))))))))))))
                    ;; PREUVE D'EXECUTION (regle 0) : ce que le moteur a REELLEMENT resolu, pas ce
                    ;; que le fichier promet. Le validateur et la salle s'ancrent sur cette ligne.
                    (format 0 "[HD-PHYS] init ~S slot=~D chains=~D links=~D colliders=~D joints=~D~%"
                            agname slot armed links nco njoint)))))))))))
  (none))

(defun jak-hd-physics-release ((obj jak-hd))
  (let ((slot (phys-slot-for-pid (the int (-> obj pid)))))
    (when (>= slot 0)
      (set! (-> *phys-slot-pid* slot) 0)
      (set! (-> *phys-slot-nch* slot) 0)
      (set! (-> *phys-slot-nco* slot) 0)))
  (none))

;; ------------------------------------------------------------------------------------------------
;; QUEL VOLUME EST UNE SURFACE POUR QUEL LIEN — et pourquoi ce n'est pas un filtre de donnees.
;;
;; « Traverser le mesh » suppose une surface a traverser. Un lien dont la sphere est ENTIEREMENT
;; contenue dans un volume a sa pose de modele n'a aucune surface de ce volume devant lui : il est
;; a l'interieur du corps, et il y etait deja avant qu'on simule quoi que ce soit. Le contraindre
;; quand meme n'apporte rien de visible et coute tout : mesure du 2026-08-11, `LpantFlap` est
;; enfoui a la fois dans la capsule de la cuisse (rayon 1321) et dans celle des hanches (810), dont
;; les normales de sortie s'opposent ; l'intersection des deux contraintes se reduit a sa pose de
;; modele et la chaine etait MORTE (amplitude 0.0062 m, quand le plancher de la SPEC est 0.05).
;;
;; Le critere est donc geometrique, calcule a chaque frame sur la pose du modele, et identique dans
;; la resolution ET dans la mesure : un volume V contraint un lien L d'autant moins qu'il l'enfouit
;; profondement au repos. Aucun flag, aucun masque, aucune liste (DIRECTIVES 4).
;;
;; POURQUOI CE N'EST PLUS UN INTERRUPTEUR. Il l'a ete : « V contraint L si et seulement si
;; profondeur_repos < 2*rayon(L) ». Or `profondeur_repos` est recalculee A CHAQUE FRAME sur la pose
;; d'auteur, donc elle traverse ce seuil en cours d'animation — et le jour ou elle le traverse, le
;; lien passe SANS TRANSITION de « contraint » a « libre » et saute. C'est un des deux seuils que la
;; 6e passe de l'owner designe : « les meches fines jittent like crazy des que la tete bouge » et
;; « les grosses meches : rien sur les petits mouvements, hysteriques sur les brusques ». Une
;; reponse non lineaire, c'est un seuil, et celui-ci etait binaire.
;;
;; La forme continue garde EXACTEMENT les deux extremes et interpole entre eux : plus le lien est
;; deja enfoui au repos, plus on lui laisse de mou, et le mou part a l'infini pile quand il est
;; entierement dedans.
;;      w = clamp01((2*rl - floor0) / rl)        w=1 des que floor0 <= rl, w=0 a floor0 = 2*rl
;;      plancher effectif = floor0 / w           = floor0 quand w=1, -> +inf quand w -> 0
;; Aucun nombre nouveau : les deux memes grandeurs (floor0, rl) qu'avant.
(defconstant PHYS-VOL-FREE 1000000000.0)

;; ------------------------------------------------------------------------------------------------
;; UN PLAFOND QUI NE SE COLLE PAS — et c'est le correctif de « l'effet gelee ».
;;
;; Owner, 11e passe (2026-08-11 21:15) : « lors de mouvements brusques il y a un effet d'etirement
;; et un peu gelee ou ca change de taille (plus petit, plus gros, plus long, plus court, ecrase),
;; c'est PAS COHERENT ». Le mot qui compte est « pas coherent » : ce n'est pas l'amplitude qui le
;; gene, c'est qu'elle ne suive pas le mouvement. Precision du 21:20 : « c'est pas des ballons durs
;; non plus, c'est naturel que ca change un peu de forme ».
;;
;; MESURE, et elle est sans appel. Deviation angulaire du maillon, sous QUATRE pilotages
;; radicalement differents (ROOM-GRADIENT, course du 2026-08-11 23:07) :
;;     chestL      39.2379  39.2540  39.2541  39.2460
;;     pantflapL   59.9995  60.0121  60.0465  60.0049
;;     kneeflapL   43.7184  43.7257  43.7179  ...
;;     toestrapL   15.3923  15.3932  15.3926  15.3929
;; La meme valeur a quatre decimales sous une secousse, une translation et une inclinaison a 60
;; degres : la signature d'un plafond EPINGLE. Toutes les chaines a un maillon sont collees a leur
;; plafond d'excursion (leur propre rayon ajuste) sur la totalite du pilotage.
;;
;; Un plafond dur `min(e, cap)` fait deux degats, et les deux sont dans son retour :
;;   * la sortie ne depend plus de l'entree — d'ou « ne bouge pas assez sur les mouvements soft,
;;     et ca bouge sur les brusques » : la reponse est plate au-dessus du seuil et proportionnelle
;;     en dessous, c'est-a-dire une MARCHE, exactement ce que la DECISION 3 du superviseur exige
;;     de supprimer ;
;;   * sa derivee est discontinue au seuil. Quand l'excitation oscille autour du plafond, la
;;     position ecrite alterne entre « ecretee » et « libre » a chaque frame, la peau suit en
;;     cisaillement lineaire, et ca donne un changement de taille qui n'est correle a rien. C'est
;;     la definition meme de « gelee ».
;;
;; LA FORME UTILISEE ICI est le min DOUX de norme p (p = 4) :
;;     e' = e / (1 + (e/cap)^4)^(1/4)
;; C'est un REMPLACEMENT du plafond dur, pas un suppresseur de plus (SPEC 7) :
;;   e = 0.25 cap -> 99.9 % conserve      e = 0.50 cap -> 98.5 %      e = cap -> 84.1 %
;;   e = 2 cap    -> 0.985 cap            e -> inf     -> cap
;; Donc : identique en dessous de la moitie du plafond (le mouvement subtil que l'owner juge
;; « quasiment parfait » n'est pas touche), meme plafond a l'infini (aucune amplitude gagnee sur
;; un defaut), STRICTEMENT CROISSANT partout (la sortie suit l'entree, donc la deformation redevient
;; correlee au stimulus) et derivable partout (plus de bascule d'une frame a l'autre).
;; ------------------------------------------------------------------------------------------------
;; IL NE S'APPLIQUE QU'UNE FOIS PAR FRAME, ET CE N'EST PAS UN DETAIL D'IMPLEMENTATION.
;;
;; Un plafond dur est IDEMPOTENT : min(min(e,c),c) = min(e,c). On peut donc l'appeler autant de fois
;; qu'on veut dans une boucle de Gauss-Seidel, il ne retire rien de plus. Ce min doux ne l'est PAS :
;; f(e) < e pour TOUT e > 0, meme tres en dessous du plafond, donc l'appeler onze fois par frame
;; (8 + 3 iterations de contraintes) compose : f^11(c) = 0.841^11 = 0.15 c.
;;
;; CE N'EST PAS UNE DEDUCTION, C'EST UNE MESURE. Premiere version posee DANS la boucle de
;; contraintes, course x86 du 2026-08-12 : onze chaines sous 60 % de leur plancher —
;;     chestL 0.3866 -> 0.1987 (-49 %)   chestR 0.3789 -> 0.1846 (-51 %)
;;     kneeflapL 0.1680 -> 0.0840 (-50 %)  toestrapL 0.1279 -> 0.0654 (-49 %)
;; soit exactement le « tout est muted as heck » que la gate FLOOR existe pour empecher, et que
;; l'owner a deja vu une fois. La gate l'a arrete avant l'APK ; le plafond dur est retabli la ou il
;; tourne en boucle, et ce min doux ne sert plus qu'aux passes APPELEES UNE SEULE FOIS PAR FRAME.
;;
;; REGLE GENERALE, parce que le piege se representera : un limiteur pose dans une boucle de solveur
;; DOIT etre idempotent. S'il ne l'est pas, il n'a rien a y faire — il se pose en dehors, une fois.
(defun phys-softmin ((v float) (cap float))
  "min DOUX de v et cap : identite loin en dessous, asymptote a cap loin au-dessus, croissant et
   derivable partout. NON IDEMPOTENT : ne jamais l'appeler dans une boucle de contraintes."
  (if (or (<= cap 0.0) (<= v 0.0))
    v
    (let* ((r  (/ v cap))
           (r2 (* r r)))
      (/ v (sqrtf (sqrtf (+ 1.0 (* r2 r2))))))))

(defun phys-vol-floor ((floor0 float) (rl float))
  "profondeur maximale que cette paire (lien, volume) tolere. PHYS-VOL-FREE = aucune surface
   devant le lien, donc rien a traverser.

   LA TOLERANCE EST LA PROFONDEUR DE REPOS, PAS UN MULTIPLE DE CELLE-CI. C'est la correction du
   2026-08-12, et c'est le mecanisme de `pant-calf`.

   La regle voulue est celle de la SPEC : « ce qui est deja dedans au repos y reste » — donc la
   franchise accordee a une paire EST sa profondeur d'auteur, ni plus ni moins. L'ancienne forme
   accordait `floor0 / w` avec `w = (2 rl - floor0) / rl`, c'est-a-dire `floor0 * rl / (2 rl -
   floor0)` : une fonction qui DIVERGE quand `floor0` approche `2 rl`. Elle ne disait plus « reste
   ou tu es », elle disait « enfonce-toi encore, de plus en plus, a mesure que tu es deja
   enfonce ».

   MESURE, sur le pan de pantacourt gauche (`LpantFlap`, rl = 429, capsule de mollet
   `Lankle->Lknee`), pose du modele :
       profondeur au repos  floor0 = 614.4 u
       tolerance ACCORDEE   feff   = 1082.0 u      = 1.76 x la profondeur de repos
       soit 467.6 u = 11.4 cm de penetration EN PLUS de la pose que l'auteur a sculptee,
       avant que le moindre volume ne le repousse.
   Onze centimetres, c'est la moitie d'un mollet : c'est litteralement « le bas de son pantacourt
   est a l'interieur de ses mollets, comme s'il s'arretait aux genoux » (owner, 11e passe, puis
   2e signalement le 2026-08-12). Le defaut n'etait ni un rayon trop petit ni une chaine trop
   molle : la collision AUTORISAIT le pan a s'enfoncer.

   CE QUI EST GARDE, ET POURQUOI. La branche PHYS-VOL-FREE reste : un lien entierement contenu
   dans un volume (`floor0 >= 2 rl`) n'a effectivement aucune surface devant lui, et c'est aussi
   l'etat que `phys-flip-count` (ligne 1330) lit pour compter les bascules de contrainte —
   supprimer la branche aurait rendu ce compteur structurellement muet. Seule la zone
   intermediaire change, et elle change vers la seule valeur que la SPEC nomme.

   LA POSE DU MODELE RESTE ADMISSIBLE, ce qui est l'invariant dont depend `phys-retreat-chain` :
   a cette pose la profondeur vaut exactement `floor0`, donc exactement `feff`, et le test de
   penetration est STRICT (`dep > feff`). L'egalite est exacte et non approchee — les deux appels
   passent par cette fonction avec les memes entrees. Le recul par dichotomie garde donc son point
   d'arrivee, et « rien ne traverse » reste vrai a la derniere operation de la frame.

   2026-08-12 — LA BRANCHE « ENTIEREMENT DEDANS = PLUS AUCUNE CONTRAINTE » EST RETIREE, et c'est
   la cause racine de `goggles-tunnel`.

   Elle rendait PHYS-VOL-FREE des que `floor0 >= 2 rl`, c'est-a-dire : « ce lien est deja tout
   entier dans ce volume a sa pose d'auteur, donc il n'a aucune surface devant lui ». Le
   raisonnement est juste sur la SURFACE et faux sur la DECISION : n'avoir aucune surface devant
   soi n'autorise pas a s'enfoncer plus loin. Une fois FREE, la paire n'est plus contrainte DU
   TOUT et le lien peut traverser la piece de part en part.
   MESURE de la course du 2026-08-12 (colonne `buried`, PAR CHAINE, memes volumes) :
       goggles   50642 paires (lien, volume) declarees FREE      tiprot 175.81 deg
       botstrapR 37603                                           tiprot 177.89 deg
       rbang     16740                                           topstrapL 7019, kneeflapL 7019
   50 642 fois par course, les lunettes n'avaient plus AUCUN volume devant elles. C'est
   exactement « en cinematique les lunettes TRAVERSENT le buste pour aller se poser dans le dos » :
   il suffit qu'une pose d'auteur les enfonce de 165 u de plus (mesure : `gogglesBase` est a 227 u
   dedans pour 2 rl = 392 u) pour que le buste cesse d'exister pour elles.

   LA REGLE DEVIENT UNIFORME, ET C'EST LA PHRASE DE LA SPEC SANS EXCEPTION : la franchise
   accordee a une paire EST sa profondeur d'auteur. `feff = floor0`, toujours.

   ET ELLE SE DEGRADE TOUTE SEULE DANS LE CAS QUI AVAIT MOTIVE LA BRANCHE. `dep` est maximale sur
   l'AXE du volume et vaut alors `rr + rl` : un lien dont la pose d'auteur est SUR l'axe a
   `floor0 = rr + rl`, le maximum atteignable, donc `dep > floor0` est impossible et la paire est
   libre — sans branche, par arithmetique. Et pour un lien enfoui MAIS excentre (le pan de
   pantacourt, a 95 u de l'axe du mollet), la contrainte se lit « ne t'approche pas de l'axe plus
   que l'auteur ne t'y a mis » : elle laisse toute la rotation autour de la jambe et interdit la
   seule chose que l'owner voit, l'enfoncement. C'est ce que la branche FREE lui accordait."
  floor0)

;; ------------------------------------------------------------------------------------------------
;; GEOMETRIE — un lien contre un collider. Le collider est une SPHERE (joint2 < 0) ou une CAPSULE
;; (segment joint..joint2, rayon interpole). Les deux suivent la forme reelle du personnage : leurs
;; rayons sont ajustes sur les sommets skinnes du mesh par le generateur, pas poses a la main.
;; Retourne la profondeur de penetration (0 si dehors) et ecrit la normale de sortie dans `nrm`.
;; ------------------------------------------------------------------------------------------------
(defun phys-axis-dir ((pt vector) (ca vector) (cb vector) (out vector))
  "Direction unitaire allant du point le plus proche de l'AXE du volume vers `pt`, que `pt` soit
   dedans ou dehors. `phys-collide-depth` ne peut pas servir a ca : elle ecrit une normale
   arbitraire (0,1,0) des que le point est hors du volume, ce qui est correct pour une poussee et
   faux pour un COTE. Rend #f quand le point est sur l'axe, ou aucun cote n'existe."
  (let ((cx (-> ca x)) (cy (-> ca y)) (cz (-> ca z)))
    (let* ((ax (- (-> cb x) (-> ca x)))
           (ay (- (-> cb y) (-> ca y)))
           (az (- (-> cb z) (-> ca z)))
           (dd (+ (* ax ax) (+ (* ay ay) (* az az)))))
      (when (>= dd 0.000001)
        (let ((t0 (/ (+ (* (- (-> pt x) (-> ca x)) ax)
                        (+ (* (- (-> pt y) (-> ca y)) ay)
                           (* (- (-> pt z) (-> ca z)) az)))
                     dd)))
          (when (< t0 0.0) (set! t0 0.0))
          (when (> t0 1.0) (set! t0 1.0))
          (set! cx (+ (-> ca x) (* ax t0)))
          (set! cy (+ (-> ca y) (* ay t0)))
          (set! cz (+ (-> ca z) (* az t0))))))
    (let* ((dx (- (-> pt x) cx))
           (dy (- (-> pt y) cy))
           (dz (- (-> pt z) cz))
           (d  (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))
      (cond
        ((< d 0.001) #f)
        (else
         (set-vector! out (/ dx d) (/ dy d) (/ dz d) 0.0)
         #t)))))

(defun phys-collide-depth ((pt vector) (rlink float) (ca vector) (cb vector)
                           (ra float) (rb float) (capsule? symbol) (nrm vector))
  (let ((cx 0.0) (cy 0.0) (cz 0.0) (rr ra))
    (cond
      ((not capsule?)
       (set! cx (-> ca x)) (set! cy (-> ca y)) (set! cz (-> ca z)))
      (else
       ;; projection sur le segment, parametre borne a [0,1]
       (let* ((ax (- (-> cb x) (-> ca x)))
              (ay (- (-> cb y) (-> ca y)))
              (az (- (-> cb z) (-> ca z)))
              (dd (+ (* ax ax) (* ay ay) (* az az)))
              (t0 (if (< dd 0.000001)
                    0.0
                    (/ (+ (* (- (-> pt x) (-> ca x)) ax)
                          (* (- (-> pt y) (-> ca y)) ay)
                          (* (- (-> pt z) (-> ca z)) az))
                       dd))))
         (when (< t0 0.0) (set! t0 0.0))
         (when (> t0 1.0) (set! t0 1.0))
         (set! cx (+ (-> ca x) (* ax t0)))
         (set! cy (+ (-> ca y) (* ay t0)))
         (set! cz (+ (-> ca z) (* az t0)))
         (set! rr (+ ra (* (- rb ra) t0))))))
    (let* ((dx (- (-> pt x) cx))
           (dy (- (-> pt y) cy))
           (dz (- (-> pt z) cz))
           (d2 (+ (* dx dx) (* dy dy) (* dz dz)))
           (d  (sqrtf d2))
           (want (+ rr rlink)))
      (cond
        ((>= d want)
         (set! (-> nrm x) 0.0) (set! (-> nrm y) 1.0) (set! (-> nrm z) 0.0)
         0.0)
        ((< d 0.001)
         ;; centre exactement sur l'axe : direction arbitraire mais stable
         (set! (-> nrm x) 0.0) (set! (-> nrm y) 1.0) (set! (-> nrm z) 0.0)
         want)
        (else
         (set! (-> nrm x) (/ dx d)) (set! (-> nrm y) (/ dy d)) (set! (-> nrm z) (/ dz d))
         (- want d))))))

;; ------------------------------------------------------------------------------------------------
;; CONTRAINTE 1 — CE QUE LA GEOMETRIE DU PERSONNAGE AUTORISE. Deux cas, et un seul des deux est une
;; longueur d'os :
;;
;;   * TOUT lien libre garde EXACTEMENT la longueur que le modele donne a son os, autour de son
;;     attache : le lien precedent quand il y en a un, l'ANCRE quand le lien est seul. `want` est
;;     relu dans le squelette NON ECRIT a chaque frame, ce n'est pas un cache.
;;   * le seul cas particulier restant est l'os qui N'EXISTE PAS dans le modele (le joint est
;;     confondu avec son attache : `LpantFlap` l'etait). La sphere de rotation s'y reduit a un
;;     point et epinglerait le lien ; ce lien-la garde donc pour seul plafond SA PROPRE TAILLE,
;;     le rayon que le generateur a ajuste sur les sommets skinnes qu'il possede.
;; ------------------------------------------------------------------------------------------------
(defun phys-length-chain ((skel skeleton) (sc int) (n int) (rlk int) (an int) (nbone int))
  "LA CONTRAINTE DE LONGUEUR, DURE, ET LA MEME POUR LES DEUX FORMES DE LIEN.

   Owner, 5e passe : « les changements brusques de direction causent un truc chelou au niveau des
   seins, ils s'allongent, c'est un peu debile » — « une chaine a un seul os doit TOURNER AUTOUR DE
   SON ANCRE A LONGUEUR INVARIANTE, jamais se translater ni s'allonger ». Ce que faisait l'ancienne
   version pour un lien SEUL : elle bornait |p - pose_du_lien| par le rayon du lien. C'est un
   plafond de POSITION, pas une longueur — sous forte acceleration le lien s'ecartait de son ancre
   et la distance ancre->lien changeait, donc il S'ALLONGEAIT. Desormais un lien seul est traite
   exactement comme un lien de chaine, son attache etant l'ANCRE au lieu du lien precedent :
   projection sur la sphere de rayon `want`, ou `want` est la longueur que LE MODELE donne a cet os,
   relue chaque frame. Une egalite, pas un plafond : ca tourne, ca ne s'etire pas.

   Owner, 2e/3e/4e passes (trois fois) : « j'ai encore vu un de ses seins retourne vers l'interieur,
   la meme animation relancee et c'etait nickel ». Le ressort est symetrique autour de l'attache,
   donc le cote oppose est un equilibre STABLE mais FAUX. Le test de cote est donc ici, contre la
   DIRECTION DU MODELE — et plus contre l'axe d'un volume, ou il ne voulait rien dire (un volume est
   une coquille symetrique, son axe ne designe aucun « bon cote »)."
  (dotimes (l n)
    (when (>= l rlk)
      (let* ((scl (+ (* sc PHYS-LINKS) l))
             (kk  (-> *phys-joint* scl))
             (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
        (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
          (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                 (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                 (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                 (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                        (-> skel bones (+ kp 1) transform vector 3 x)))
                 (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                        (-> skel bones (+ kp 1) transform vector 3 y)))
                 (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                        (-> skel bones (+ kp 1) transform vector 3 z)))
                 (want (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz)))))
                 (dx (- (-> *phys-px* scl) bx))
                 (dy (- (-> *phys-py* scl) by))
                 (dz (- (-> *phys-pz* scl) bz))
                 (d  (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))
            (cond
              ((< want 0.01)
               ;; L'OS N'EXISTE PAS DANS LE MODELE : le joint est confondu avec son attache, donc
               ;; « tourner autour d'elle a longueur invariante » n'a pas de sens — la sphere est un
               ;; point et le lien serait EPINGLE. C'est exactement ce qui avait tue LpantFlap.
               ;; Ce lien-la garde le seul plafond que la geometrie lui donne : SA PROPRE TAILLE,
               ;; le rayon que le mesh lui mesure. Compte et publie comme le limiteur qu'il est.
               (let* ((rmax (-> *phys-rad* scl))
                      (tx (-> skel bones (+ kk 1) transform vector 3 x))
                      (ty (-> skel bones (+ kk 1) transform vector 3 y))
                      (tz (-> skel bones (+ kk 1) transform vector 3 z))
                      (ex (- (-> *phys-px* scl) tx))
                      (ey (- (-> *phys-py* scl) ty))
                      (ez (- (-> *phys-pz* scl) tz))
                      (e  (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez)))))
                      ;; PLAFOND DUR, ET IL DOIT LE RESTER : voir la note d'IDEMPOTENCE au-dessus
                      ;; de `phys-softmin`. Ce bloc tourne onze fois par frame.
                      (e2 rmax))
                 (when (and (> e rmax) (> e 0.0001))
                   (let ((s (/ e2 e)))
                     (set! *phys-raddrop-n* (+ *phys-raddrop-n* 1))
                     (set! *phys-raddrop-sum* (+ *phys-raddrop-sum* (- e e2)))
                     (set! (-> *phys-dg* (+ (* sc PHYS-DG) 6))
                           (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 6))))
                     (set! (-> *phys-px* scl) (+ tx (* ex s)))
                     (set! (-> *phys-py* scl) (+ ty (* ey s)))
                     (set! (-> *phys-pz* scl) (+ tz (* ez s)))))))
              (else
               ;; CAS DEGENERE : le lien s'est confondu avec son attache, la direction n'existe
               ;; plus. Se taire ici laissait le lien se restabiliser n'importe ou, y compris du
               ;; mauvais cote — on REPART de la direction du modele.
               (when (<= d 0.0001)
                 (set! *phys-invfix* (+ *phys-invfix* 1))
                 (set! dx mx) (set! dy my) (set! dz mz) (set! d want))
               ;; LE COTE, ET SEULEMENT SUR LE PREMIER LIEN LIBRE — celui dont l'attache est RIGIDE.
               ;; C'est exactement ce que l'owner a demande : « une chaine A UN SEUL OS de famille A
               ;; doit rester du cote de la pose du modele ». Sur un lien PROFOND (dont l'attache est
               ;; elle-meme simulee), ce test serait une butee d'articulation a 90 degres que
               ;; personne n'a demandee.
               ;;
               ;; 2026-08-12 — LE PREDICAT ETAIT `l = 0`, ET IL NE POUVAIT PAS TIRER. La boucle
               ;; au-dessus saute deja tout `l < rlk` : sur une chaine `rootlock=1` le maillon 0
               ;; n'est jamais visite, donc `l = 0` n'y est JAMAIS vrai. Le test ne tournait donc que
               ;; sur les 11 chaines a un seul os, et etait structurellement mort sur les 11 autres —
               ;; oreilles, cheveux, meches, lunettes, bretelles. La colonne `inv` de la course le
               ;; dit sans ambiguite : 27 a 93 corrections sur chaque chaine a un os, ZERO sur
               ;; chacune des onze chaines rootlockees.
               ;;
               ;; Or le premier maillon LIBRE d'une chaine rootlockee est dans la meme situation
               ;; geometrique qu'un os seul : son attache est le maillon rigide, qui porte la pose du
               ;; modele au bit pres. Ce n'est pas un lien profond, c'est LE lien attache a du rigide.
               ;; `l = rlk` est donc la lecture fidele de l'intention ecrite ci-dessus, et `l = 0`
               ;; n'y coincidait que par accident quand `rootlock` valait 0.
               ;;
               ;; CE QUE CA CORRIGE, MESURE (colonne `tiprot`, course du 2026-08-12) : les onze
               ;; chaines sans test de cote repliaient leur maillon libre jusqu'a
               ;;     topstrapL 179.06   botstrapR 177.89   topstrapR 176.75   goggles 175.81
               ;;     botstrapL 174.55   earR 161.36        earL 156.25        lmidhair 125.76
               ;; 179 degres, c'est une bretelle retournee bout pour bout : elle repart vers le
               ;; torse, et c'est « la bretelle clipe au travers de l'elastique orange ». Un tissu
               ;; cousu a l'epaule ne peut pas se replier au-dela de son propre point d'attache.
               ;; On REFLECHIT la composante le long de la direction du modele, ce qui remet le lien
               ;; de son cote SANS changer sa longueur. La zone morte evite le miroitement sans fin
               ;; quand le lien frole le plan perpendiculaire, ou le signe du produit scalaire se
               ;; decide sur l'arrondi.
               (let* ((m2  (+ (* mx mx) (+ (* my my) (* mz mz))))
                      (u2  (+ (* dx dx) (+ (* dy dy) (* dz dz))))
                      (dot (+ (* dx mx) (+ (* dy my) (* dz mz)))))
                 (when (and (= l rlk) (< dot 0.0) (> m2 0.0)
                            (> (* dot dot) (* PHYS-SIDE-COS2 (* u2 m2))))
                   (set! *phys-invn* (+ *phys-invn* 1))
                   (set! (-> *phys-dg* (+ (* sc PHYS-DG) 3))
                         (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 3))))
                   (let ((kr (/ (* 2.0 dot) m2)))
                     (set! dx (- dx (* kr mx)))
                     (set! dy (- dy (* kr my)))
                     (set! dz (- dz (* kr mz))))))
               ;; LONGUEUR INVARIANTE : projection sur la sphere de rayon `want` centree sur
               ;; l'attache.
               (let ((dd (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))
                 (when (> dd 0.0001)
                   (let ((s (/ want dd)))
                     (set! (-> *phys-px* scl) (+ bx (* dx s)))
                     (set! (-> *phys-py* scl) (+ by (* dy s)))
                     (set! (-> *phys-pz* scl) (+ bz (* dz s))))))
               ;; ET L'EXCURSION D'UN LIEN SEUL RESTE BORNEE PAR SA PROPRE TAILLE. C'est le meme
               ;; limiteur qu'avant (le rayon que le mesh mesure pour ce lien), la TRANSLATION en
               ;; moins : on raccourcit la corde jusqu'a ce rayon puis on revient sur la sphere,
               ;; donc la longueur reste invariante et le lien ne fait que tourner moins loin.
               ;; Sans lui, `anklestrapL` — dont l'ancre est a 47 cm — part a 1,49 m de pointe et
               ;; 0,77 m de racine sous les a-coups de la salle (mesure du 2026-08-11).
               ;;
               ;; IL NE PORTE QUE SUR LE MAILLON 0, DONC QUE SUR LES CHAINES SANS `rootlock`, ET
               ;; C'EST DELIBERE — le tableau de la salle a longtemps affirme le contraire (« il
               ;; porte desormais sur tout maillon libre ») pendant que le code lisait `l = 0` : la
               ;; colonne `raddrop` de la course le demontrait deja, 15 000 a 25 000 declenchements
               ;; sur chacune des onze chaines a un os et EXACTEMENT ZERO sur chacune des onze
               ;; chaines rootlockees. Le texte est corrige avec ce commit ; le code ne l'est pas,
               ;; et voici le chiffre qui l'interdit :
               ;;   `rmax` est la DEMI-EPAISSEUR du morceau de geometrie, pas un budget de course.
               ;;   Etendu au maillon libre d'une bretelle, il vaudrait 157 u sur un os de 1366 u,
               ;;   soit une butee a 2*asin(157/2732) = 6.6 degres : la bretelle serait morte.
               ;;   Sur un os seul, `rmax` et l'os sont du meme ordre (lBoob 656 contre 977 u,
               ;;   soit 39.2 degres) et la butee reste plausible.
               ;; Ce qui borne le repliement d'un maillon libre profond est donc le test de COTE
               ;; ci-dessus (une demi-sphere autour de la direction du modele), pas ce rayon.
               (when (= l 0)
                 (let* ((rmax (-> *phys-rad* scl))
                        (tx (-> skel bones (+ kk 1) transform vector 3 x))
                        (ty (-> skel bones (+ kk 1) transform vector 3 y))
                        (tz (-> skel bones (+ kk 1) transform vector 3 z))
                        (ex (- (-> *phys-px* scl) tx))
                        (ey (- (-> *phys-py* scl) ty))
                        (ez (- (-> *phys-pz* scl) tz))
                        (e  (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez)))))
                        ;; PLAFOND DUR, ET IL DOIT LE RESTER (idempotence, cf. `phys-softmin`).
                        (e2 rmax))
                   (when (and (> e rmax) (> e 0.0001))
                     (set! *phys-raddrop-n* (+ *phys-raddrop-n* 1))
                     (set! *phys-raddrop-sum* (+ *phys-raddrop-sum* (- e e2)))
                     (set! (-> *phys-dg* (+ (* sc PHYS-DG) 6))
                           (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 6))))
                     (let* ((f  (/ e2 e))
                            (qx (- (+ tx (* ex f)) bx))
                            (qy (- (+ ty (* ey f)) by))
                            (qz (- (+ tz (* ez f)) bz))
                            (ql (sqrtf (+ (* qx qx) (+ (* qy qy) (* qz qz))))))
                       (when (> ql 0.0001)
                         (let ((s2 (/ want ql)))
                           (set! (-> *phys-px* scl) (+ bx (* qx s2)))
                           (set! (-> *phys-py* scl) (+ by (* qy s2)))
                           (set! (-> *phys-pz* scl) (+ bz (* qz s2))))))))))))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; L'ANGLE QUE LA PEAU PEUT ENCAISSER — CHEVEUX SEULEMENT (`maxangle` > 0 dans les donnees, derive
;; du rig par le generateur, absent partout ailleurs).
;;
;; Owner, 11e passe (2026-08-11 21:15) : « certains maillons meriteraient un traitement pour eviter
;; de creer des angles extremes qui mettent en lumiere le lack of geometrie — soit une subdivision
;; intelligente, soit une ATTENUATION sur les angles extremes ». Puis le perimetre, ferme a 22:35 :
;; « c'est juste sur les meches, pas le reste, encore moins les seins ».
;; Mesure du 2026-08-11 (ROOM-GRADIENT) : lbang link1 = 178.57 deg, rbang 176.20, backhair 176.95.
;; 178 degres, c'est une epingle a cheveux : la meche se replie sur elle-meme et la peau, qui n'a
;; pas les aretes pour ca, se croise.
;;
;; TROIS PROPRIETES, et chacune repond a un mot de sa phrase :
;;   * « attenuation », pas clamp : min DOUX (phys-softmin), donc pas d'a-coup au passage du seuil ;
;;   * « certains maillons » : chaque maillon est teste separement, seul le fautif paie ;
;;   * longueur invariante : on ne fait que ramener la direction vers celle du modele SUR LE MEME
;;     ARC, donc l'os ne change pas de taille et `elong` n'en voit rien.
;;
;; APPELE UNE SEULE FOIS PAR FRAME, entre la boucle de contraintes et la finition — voir la note
;; d'idempotence de `phys-softmin` : pose DANS la boucle, il coutait la moitie du mouvement de onze
;; chaines. La finition qui suit (collision puis recul) garde donc le dernier mot sur « rien ne
;; traverse », et le passage de longueur qu'elle contient le dernier mot sur la longueur.
;; ------------------------------------------------------------------------------------------------
(defun phys-bend-chain ((skel skeleton) (sc int) (n int) (rlk int) (an int) (nbone int))
  (let ((amax (-> *phys-maxang* sc)))
    (when (> amax 0.0)
      (dotimes (l n)
        (when (>= l rlk)
          (let* ((scl (+ (* sc PHYS-LINKS) l))
                 (kk  (-> *phys-joint* scl))
                 (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
            (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
              (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                     (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                     (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                     (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                            (-> skel bones (+ kp 1) transform vector 3 x)))
                     (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                            (-> skel bones (+ kp 1) transform vector 3 y)))
                     (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                            (-> skel bones (+ kp 1) transform vector 3 z)))
                     (dx (- (-> *phys-px* scl) bx))
                     (dy (- (-> *phys-py* scl) by))
                     (dz (- (-> *phys-pz* scl) bz))
                     (m2 (+ (* mx mx) (+ (* my my) (* mz mz))))
                     (d2 (+ (* dx dx) (+ (* dy dy) (* dz dz)))))
                (when (and (> m2 0.000001) (> d2 0.000001))
                  (let* ((ml (sqrtf m2))
                         (dl (sqrtf d2))
                         (ux (/ mx ml)) (uy (/ my ml)) (uz (/ mz ml))
                         (vx (/ dx dl)) (vy (/ dy dl)) (vz (/ dz dl))
                         (cs (+ (* ux vx) (+ (* uy vy) (* uz vz))))
                         (px (- vx (* cs ux))) (py (- vy (* cs uy))) (pz (- vz (* cs uz)))
                         (pl (sqrtf (+ (* px px) (+ (* py py) (* pz pz)))))
                         ;; `atan` de GOAL rend des UNITES DE ROTATION (65536 = un tour) ;
                         ;; 360/65536 = 0.0054931641 les convertit en degres, et 182.04444
                         ;; revient aux unites que `sin`/`cos` attendent.
                         (adeg (* 0.0054931641 (atan pl cs)))
                         (adg2 (phys-softmin adeg amax)))
                    (when (and (> pl 0.0001) (< adg2 (- adeg 0.01)))
                      (let* ((au (* 182.04444 adg2))
                             (cc (cos au))
                             (ss (sin au))
                             (qx (/ px pl)) (qy (/ py pl)) (qz (/ pz pl)))
                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 7))
                              (+ (- adeg adg2) (-> *phys-dg* (+ (* sc PHYS-DG) 7))))
                        (set! (-> *phys-px* scl) (+ bx (* dl (+ (* cc ux) (* ss qx)))))
                        (set! (-> *phys-py* scl) (+ by (* dl (+ (* cc uy) (* ss qy)))))
                        (set! (-> *phys-pz* scl) (+ bz (* dl (+ (* cc uz) (* ss qz))))))))))))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; OU EST LE CENTRE D'UN VOLUME. Une sphere n'est pas forcement centree sur son joint : la 6e passe
;; de l'owner dit « une sphere au joint ne peut pas epouser un sein ». Son centre est le CENTROIDE
;; MESURE de la geometrie que ce joint porte, ecrit dans les donnees en espace bind du joint, et
;; ramene ici dans le monde par la matrice de l'os — donc il suit l'animation comme le joint. Un
;; offset absent vaut (0,0,0) et le centre redevient le joint, au bit pres.
;; ------------------------------------------------------------------------------------------------
;; LE DECALAGE MONDE entre le joint d'un lien et le CENTRE du volume qu'il porte. Nul quand ce joint
;; ne declare aucune sphere ajustee — le comportement est alors exactement celui d'avant, au bit
;; pres. Ne tourne que la rotation de l'os : c'est un vecteur, pas un point.
(defun phys-link-off! ((skel skeleton) (scl int) (kk int) (out vector))
  (let ((ox (-> *phys-lcx* scl))
        (oy (-> *phys-lcy* scl))
        (oz (-> *phys-lcz* scl)))
    (cond
      ((and (= ox 0.0) (= oy 0.0) (= oz 0.0))
       (set-vector! out 0.0 0.0 0.0 0.0))
      (else
       (set-vector! out ox oy oz 0.0)
       (vector-rotate*! out out (the-as matrix (-> skel bones (+ kk 1) transform))))))
  (none))

(defun phys-col-centre ((skel skeleton) (sco int) (cj int) (out vector))
  (let ((ox (-> *phys-cox* sco))
        (oy (-> *phys-coy* sco))
        (oz (-> *phys-coz* sco)))
    (cond
      ((and (= ox 0.0) (= oy 0.0) (= oz 0.0))
       (vector-copy! out (the-as vector (-> skel bones (+ cj 1) transform vector 3))))
      (else
       (set-vector! out ox oy oz 1.0)
       (vector-matrix*! out out (the-as matrix (-> skel bones (+ cj 1) transform))))))
  (none))

(defun phys-snapshot-colliders! ((skel skeleton) (slot int) (nco int) (nbone int))
  "Releve la position d'auteur des deux extremites de chaque volume, AVANT que la premiere chaine
   n'ecrive quoi que ce soit dans le squelette. Appele une fois par frame, en tete du pas."
  (let ((ca (new 'stack-no-clear 'vector)))
    (dotimes (ci nco)
      (let* ((sco (+ (* slot PHYS-COLS) ci))
             (cj  (-> *phys-cj* sco))
             (cj2 (-> *phys-cj2* sco)))
        (cond
          ((and (>= cj 0) (< (+ cj 1) nbone))
           (phys-col-centre skel sco cj ca)
           (set! (-> *phys-crax* sco) (-> ca x))
           (set! (-> *phys-cray* sco) (-> ca y))
           (set! (-> *phys-craz* sco) (-> ca z))
           (cond
             ((and (>= cj2 0) (< (+ cj2 1) nbone))
              (set! (-> *phys-crbx* sco) (-> skel bones (+ cj2 1) transform vector 3 x))
              (set! (-> *phys-crby* sco) (-> skel bones (+ cj2 1) transform vector 3 y))
              (set! (-> *phys-crbz* sco) (-> skel bones (+ cj2 1) transform vector 3 z)))
             (else
              (set! (-> *phys-crbx* sco) (-> ca x))
              (set! (-> *phys-crby* sco) (-> ca y))
              (set! (-> *phys-crbz* sco) (-> ca z))))
           (set! (-> *phys-crok* sco) 1))
          (else (set! (-> *phys-crok* sco) 0))))))
  (none))

(defun phys-col-rest! ((sco int) (ra vector) (rb vector))
  "Les deux extremites du volume `sco` a leur pose d'auteur de cette frame (instantane ci-dessus).
   Rend #f quand aucun instantane n'a ete pris : l'appelant retombe alors sur le squelette."
  (cond
    ((zero? (-> *phys-crok* sco)) #f)
    (else
     (set-vector! ra (-> *phys-crax* sco) (-> *phys-cray* sco) (-> *phys-craz* sco) 1.0)
     (set-vector! rb (-> *phys-crbx* sco) (-> *phys-crby* sco) (-> *phys-crbz* sco) 1.0)
     #t)))

;; ------------------------------------------------------------------------------------------------
;; UNE CHAINE SE COGNE-T-ELLE DANS SON PROPRE VOLUME ? Owner, 4e et 6e passes : « les pointes et
;; racines sont ancrees avec l'entre-deux qui bouge enormement », « les meches fines jittent like
;; crazy des que la tete bouge ». Les colliders `Lbanga`, `Lmidhaira`, `lBoob`... sont les
;; JOINTS-RACINES des chaines elles-memes, et les capsules `Lbangb->Lbanga` sont des MAILLONS de la
;; meche : sans exclusion, une meche est poussee hors de sa propre sphere de racine et de ses
;; propres maillons, en permanence.
;; L'exclusion est STRUCTURELLE (chaine <-> elle-meme), pas un `colskip` : elle ne lit aucune
;; donnee, elle compare des index de joints deja resolus.
;; ------------------------------------------------------------------------------------------------
(defun phys-col-own? ((sc int) (n int) (cj int) (cj2 int))
  (let ((own #f))
    (dotimes (l2 n)
      (let ((k2j (-> *phys-joint* (+ (* sc PHYS-LINKS) l2))))
        (when (and (>= k2j 0) (or (= cj k2j) (= cj2 k2j))) (set! own #t))))
    own))

;; ------------------------------------------------------------------------------------------------
;; CONTRAINTE 2 — LES COLLIDERS, avec le PLANCHER DE POSE MODELE. `floor0` est la profondeur du
;; MEME lien a sa place d'auteur dans le MEME volume ; le plancher EFFECTIF en derive de facon
;; CONTINUE (phys-vol-floor) : ce qui est deja dedans au repos y reste, ce qui va plus profond est
;; repousse, et un lien deja entierement dedans n'a aucune surface devant lui. Calcule a chaque
;; frame, par (lien, volume) — ce n'est ni un masque de donnees ni un filtre de volumes.
;; `sweeps` > 1 parce que sortir d'un volume peut faire entrer dans le voisin (hanche/cuisse,
;; crane/oreille) : un balayage unique laisse ce residu-la sur la table.
;;
;; LA POUSSEE NE CHANGE PAS LA LONGUEUR DU LIEN — 10e passe de l'owner (2026-08-11 18:00) : « les
;; seins s'allongent de nouveau sur les mouvements brusques ». Le pari du build precedent etait
;; ecrit noir sur blanc : si l'etirement revient, c'est la contrainte de longueur qui cede. Il est
;; revenu, et la mesure le chiffre — chestL 7.0 %, chestR 7.6 %, botstrapL 113 %.
;;
;; La cause est l'ORDRE, pas la contrainte : le solveur terminait sur (collision, recul) pour que
;; « rien ne traverse » soit vrai a la derniere operation, et la poussee de collision est une
;; TRANSLATION le long de la normale de sortie. Quand cette normale est dirigee dans l'axe de
;; l'attache — c'est exactement le cas d'un sein pousse par la capsule du buste, dont l'axe passe
;; par l'ancre — la translation est purement RADIALE : elle n'a aucun autre effet que d'allonger le
;; lien. Repasser la longueur apres coup remettait le lien dans le volume dont il venait de sortir
;; (penetration mesuree a +0.07 m sur rbang), donc ce n'etait pas la solution non plus.
;;
;; La sortie est de rendre la poussee elle-meme compatible avec la sphere : on pousse, puis on
;; REPROJETTE sur la sphere de rayon `want` centree sur l'attache. Le lien tourne au lieu de
;; s'etirer, et « rien ne traverse » reste garanti par la derniere operation de la frame, le recul,
;; qui cherche son point admissible SUR CETTE MEME SPHERE (phys-retreat-chain, branche `sphere?`) en
;; partant de la pose du modele — admissible par construction, puisque le plancher de pose modele
;; est defini comme la profondeur du lien A CETTE POSE. Les deux contraintes cessent donc de se
;; contredire : la longueur devient dure sans que la collision cede quoi que ce soit.
;; ------------------------------------------------------------------------------------------------
(defun phys-collide-chain ((skel skeleton) (sc int) (n int) (rlk int) (nbone int)
                           (nco int) (margin float) (sweeps int))
  (let ((slot (/ sc PHYS-CHAINS))
        (pt   (new 'stack-no-clear 'vector))
        (rest (new 'stack-no-clear 'vector))
        (off  (new 'stack-no-clear 'vector))
        (ca   (new 'stack-no-clear 'vector))
        (cb   (new 'stack-no-clear 'vector))
        (ra   (new 'stack-no-clear 'vector))
        (rb   (new 'stack-no-clear 'vector))
        (nrm  (new 'stack-no-clear 'vector)))
    (dotimes (l n)
      (when (>= l rlk)
        (let* ((scl (+ (* sc PHYS-LINKS) l))
               (kk  (-> *phys-joint* scl))
               (rl  (-> *phys-lcr* scl))
               (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) (-> *phys-anchor* sc))))
          (when (and (>= kk 0) (< (+ kk 1) nbone))
            ;; on raisonne sur le CENTRE du volume porte par le lien, pas sur son joint : c'est le
            ;; volume que le generateur a mesure sur le mesh, le meme que ce lien presente aux
            ;; autres chaines. Le decalage est rigide, donc la poussee se reporte telle quelle sur
            ;; le joint a la sortie.
            (phys-link-off! skel scl kk off)
            (vector-copy! rest (the-as vector (-> skel bones (+ kk 1) transform vector 3)))
            (set! (-> rest x) (+ (-> rest x) (-> off x)))
            (set! (-> rest y) (+ (-> rest y) (-> off y)))
            (set! (-> rest z) (+ (-> rest z) (-> off z)))
            (set! (-> pt x) (+ (-> *phys-px* scl) (-> off x)))
            (set! (-> pt y) (+ (-> *phys-py* scl) (-> off y)))
            (set! (-> pt z) (+ (-> *phys-pz* scl) (-> off z)))
            (set! (-> pt w) 1.0)
            (dotimes (sub sweeps)
              (dotimes (ci nco)
                (let* ((sco (+ (* slot PHYS-COLS) ci))
                       (cj  (-> *phys-cj* sco))
                       (cj2 (-> *phys-cj2* sco))
                       (own (phys-col-own? sc n cj cj2)))
                  ;; ARME, le controle positif LEVE l'exclusion : le compteur `selfcol` doit alors
                  ;; monter. Un zero que rien ne peut faire monter ne prouve rien — et c'est
                  ;; exactement ce qui vient d'arriver. Depuis qu'un lien porte LE MEME volume que
                  ;; celui que son joint declare, lever la seule exclusion ne suffit plus : le lien
                  ;; est au centre de sa propre sphere, donc ENTIEREMENT dedans, donc `phys-vol-floor`
                  ;; le declare libre et aucune poussee ne peut naitre. Mesure : le compteur arme est
                  ;; tombe de 4457 a 0 sans qu'aucun defaut n'ait ete corrige. Le controle doit donc
                  ;; injecter le DEFAUT lui-meme — une chaine repoussee hors de ses propres volumes —
                  ;; et non seulement retirer sa protection : arme, le plancher des paires propres
                  ;; passe a zero.
                  (let ((selfpair (and own (nonzero? *phys-self-inject*))))
                  (when selfpair (set! own #f))
                  (when (and (not own) (>= cj 0) (< (+ cj 1) nbone))
                    (phys-col-centre skel sco cj ca)
                    (if (and (>= cj2 0) (< (+ cj2 1) nbone))
                      (vector-copy! cb (the-as vector (-> skel bones (+ cj2 1) transform vector 3)))
                      (vector-copy! cb ca))
                    ;; `floor0` contre le volume A SA POSE D'AUTEUR, `dep` contre sa position
                    ;; COURANTE : le plancher de pose modele est une propriete de la pose du
                    ;; modele des DEUX cotes (cf. phys-snapshot-colliders!).
                    (when (not (phys-col-rest! sco ra rb))
                      (vector-copy! ra ca) (vector-copy! rb cb))
                    (let* ((cap?   (and (>= cj2 0) (< (+ cj2 1) nbone)))
                           (floor0 (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                       (-> *phys-cr2* sco) cap? nrm))
                           (feff   (if selfpair 0.0 (phys-vol-floor floor0 rl)))
                           (dep    (phys-collide-depth pt rl ca cb (-> *phys-cr* sco)
                                                       (-> *phys-cr2* sco) cap? nrm)))
                      (when (> dep feff)
                        (let ((push (+ (- dep feff) margin)))
                          ;; une correction issue d'un volume PROPRE a la chaine : elle ne peut
                          ;; arriver que sous controle positif, et c'est ce compteur qui le dit.
                          (when (nonzero? *phys-self-inject*)
                            (when (phys-col-own? sc n cj cj2)
                              (set! (-> *phys-dg* (* sc PHYS-DG))
                                    (+ 1.0 (-> *phys-dg* (* sc PHYS-DG))))))
                          (set! (-> pt x) (+ (-> pt x) (* (-> nrm x) push)))
                          (set! (-> pt y) (+ (-> pt y) (* (-> nrm y) push)))
                          (set! (-> pt z) (+ (-> pt z) (* (-> nrm z) push)))))))))))
            ;; retour aux coordonnees du JOINT : le solveur, la contrainte de longueur et l'ecriture
            ;; dans le squelette raisonnent tous sur le joint, jamais sur le centre du volume.
            (set! (-> pt x) (- (-> pt x) (-> off x)))
            (set! (-> pt y) (- (-> pt y) (-> off y)))
            (set! (-> pt z) (- (-> pt z) (-> off z)))
            ;; ROTATION, PAS TRANSLATION : la poussee est ramenee sur la sphere de l'attache. Un os
            ;; que le modele ne donne pas (`want` ~ 0) n'a pas de sphere : il garde le comportement
            ;; en translation, borne ailleurs par son propre rayon.
            (when (and (>= kp 0) (< (+ kp 1) nbone))
              (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                     (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                     (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                     (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                            (-> skel bones (+ kp 1) transform vector 3 x)))
                     (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                            (-> skel bones (+ kp 1) transform vector 3 y)))
                     (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                            (-> skel bones (+ kp 1) transform vector 3 z)))
                     (want (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz)))))
                     (ux (- (-> pt x) bx))
                     (uy (- (-> pt y) by))
                     (uz (- (-> pt z) bz))
                     (ul (sqrtf (+ (* ux ux) (+ (* uy uy) (* uz uz))))))
                (when (and (> want 0.01) (> ul 0.0001))
                  (let ((s (/ want ul)))
                    (set! (-> pt x) (+ bx (* ux s)))
                    (set! (-> pt y) (+ by (* uy s)))
                    (set! (-> pt z) (+ bz (* uz s)))))))
            (set! (-> *phys-px* scl) (-> pt x))
            (set! (-> *phys-py* scl) (-> pt y))
            (set! (-> *phys-pz* scl) (-> pt z)))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; COMBIEN DE PAIRES (LIEN, VOLUME) ONT BASCULE D'ETAT DEPUIS LA FRAME PRECEDENTE. C'est la mesure
;; du defaut que la 6e passe designe : un interrupteur binaire evalue chaque frame sur la pose du
;; modele saute quand il bascule, et le lien saute avec lui. On mesure l'etat CONTRAINT / LIBRE
;; (plancher effectif fini ou non) par paire, on le compare a celui de la frame precedente, et on
;; publie le nombre de bascules par chaine. La forme continue doit le faire tomber.
;; ------------------------------------------------------------------------------------------------
(defun phys-popcount ((v int))
  "nombre de bits a 1 dans les 32 bits bas de v."
  (let ((c 0) (x (logand v #xffffffff)))
    (while (nonzero? x)
      (+! c (the int (logand x 1)))
      (set! x (shr x 1)))
    c))

(defun phys-flip-count ((skel skeleton) (sc int) (n int) (rlk int) (nbone int) (nco int))
  (let ((slot (/ sc PHYS-CHAINS))
        (rest (new 'stack-no-clear 'vector))
        (cur  (new 'stack-no-clear 'vector))
        (off  (new 'stack-no-clear 'vector))
        (ca   (new 'stack-no-clear 'vector))
        (cb   (new 'stack-no-clear 'vector))
        (ra   (new 'stack-no-clear 'vector))
        (rb   (new 'stack-no-clear 'vector))
        (nrm  (new 'stack-no-clear 'vector)))
    (dotimes (l n)
      (when (>= l rlk)
        (let* ((scl (+ (* sc PHYS-LINKS) l))
               (kk  (-> *phys-joint* scl))
               (rl  (-> *phys-lcr* scl)))
          (when (and (>= kk 0) (< (+ kk 1) nbone))
            (phys-link-off! skel scl kk off)
            (vector-copy! rest (the-as vector (-> skel bones (+ kk 1) transform vector 3)))
            (set! (-> rest x) (+ (-> rest x) (-> off x)))
            (set! (-> rest y) (+ (-> rest y) (-> off y)))
            (set! (-> rest z) (+ (-> rest z) (-> off z)))
            (set! (-> cur x) (+ (-> *phys-px* scl) (-> off x)))
            (set! (-> cur y) (+ (-> *phys-py* scl) (-> off y)))
            (set! (-> cur z) (+ (-> *phys-pz* scl) (-> off z)))
            (set! (-> cur w) 1.0)
            (let ((w0 0) (w1 0) (w2 0))
              (dotimes (ci (min nco (* 32 PHYS-FLIPW)))
                (let* ((sco (+ (* slot PHYS-COLS) ci))
                       (cj  (-> *phys-cj* sco))
                       (cj2 (-> *phys-cj2* sco))
                       (bit 0))
                  (when (and (not (phys-col-own? sc n cj cj2)) (>= cj 0) (< (+ cj 1) nbone))
                    (phys-col-centre skel sco cj ca)
                    (if (and (>= cj2 0) (< (+ cj2 1) nbone))
                      (vector-copy! cb (the-as vector (-> skel bones (+ cj2 1) transform vector 3)))
                      (vector-copy! cb ca))
                    (when (not (phys-col-rest! sco ra rb))
                      (vector-copy! ra ca) (vector-copy! rb cb))
                    ;; L'ETAT SUIVI EST « EN CONTACT », plus « contraint ou libre ». Depuis que la
                    ;; branche PHYS-VOL-FREE est retiree, toute paire est contrainte : garder
                    ;; l'ancien predicat aurait rendu ce bit constamment 1, donc le compteur de
                    ;; bascules identiquement nul — un instrument mort qui affiche du vert. Le
                    ;; predicat de contact est celui de `phys-link-pen`, donc les deux passes
                    ;; parlent de la meme chose : dedans a la pose du modele, ou dedans maintenant.
                    (let* ((cap?   (and (>= cj2 0) (< (+ cj2 1) nbone)))
                           (floor0 (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                       (-> *phys-cr2* sco) cap? nrm))
                           (dep    (phys-collide-depth cur rl ca cb (-> *phys-cr* sco)
                                                       (-> *phys-cr2* sco) cap? nrm)))
                      (when (or (> floor0 0.0) (> dep 0.0)) (set! bit 1))))
                  (when (nonzero? bit)
                    (cond
                      ((< ci 32)  (set! w0 (logior w0 (ash 1 ci))))
                      ((< ci 64)  (set! w1 (logior w1 (ash 1 (- ci 32)))))
                      (else       (set! w2 (logior w2 (ash 1 (- ci 64)))))))))
              (let ((fb (* scl PHYS-FLIPW)))
                (when (nonzero? (-> *phys-flhas* scl))
                  (let ((ch (+ (phys-popcount (logxor w0 (-> *phys-fl* fb)))
                               (+ (phys-popcount (logxor w1 (-> *phys-fl* (+ fb 1))))
                                  (phys-popcount (logxor w2 (-> *phys-fl* (+ fb 2))))))))
                    (when (> ch 0)
                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 2))
                            (+ (the float ch) (-> *phys-dg* (+ (* sc PHYS-DG) 2)))))))
                (set! (-> *phys-fl* fb) w0)
                (set! (-> *phys-fl* (+ fb 1)) w1)
                (set! (-> *phys-fl* (+ fb 2)) w2)
                (set! (-> *phys-flhas* scl) 1))))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; MESURE de la penetration RESIDUELLE d'UN lien place en `pt` : meme predicat, memes volumes, meme
;; plancher de pose modele que la resolution, mais SANS marge et sans rien deplacer. C'est la seule
;; definition de « ca traverse » du moteur, et elle sert aux trois usages (resoudre, reculer,
;; mesurer) — il n'y a donc pas d'instrument de mesure different de l'instrument de decision.
;; ------------------------------------------------------------------------------------------------
(defun phys-link-pen ((skel skeleton) (sc int) (n int) (nbone int) (nco int) (l int) (pt vector))
  (let ((slot (/ sc PHYS-CHAINS))
        (worst PHYS-NOCONTACT)
        (rest (new 'stack-no-clear 'vector))
        (off  (new 'stack-no-clear 'vector))
        (q    (new 'stack-no-clear 'vector))
        (ca   (new 'stack-no-clear 'vector))
        (cb   (new 'stack-no-clear 'vector))
        (ra   (new 'stack-no-clear 'vector))
        (rb   (new 'stack-no-clear 'vector))
        (ua   (new 'stack-no-clear 'vector))
        (ub   (new 'stack-no-clear 'vector))
        (nrm  (new 'stack-no-clear 'vector)))
    (let* ((scl (+ (* sc PHYS-LINKS) l))
           (kk  (-> *phys-joint* scl))
           (rl  (-> *phys-lcr* scl)))
      (when (and (>= kk 0) (< (+ kk 1) nbone))
        ;; `pt` arrive en coordonnees de JOINT (c'est ce que manipulent le solveur et le recul) :
        ;; on le porte sur le centre du volume, comme la resolution.
        (phys-link-off! skel scl kk off)
        (vector-copy! rest (the-as vector (-> skel bones (+ kk 1) transform vector 3)))
        (set! (-> rest x) (+ (-> rest x) (-> off x)))
        (set! (-> rest y) (+ (-> rest y) (-> off y)))
        (set! (-> rest z) (+ (-> rest z) (-> off z)))
        (set! (-> q x) (+ (-> pt x) (-> off x)))
        (set! (-> q y) (+ (-> pt y) (-> off y)))
        (set! (-> q z) (+ (-> pt z) (-> off z)))
        (set! (-> q w) 1.0)
        (dotimes (ci nco)
          (let* ((sco (+ (* slot PHYS-COLS) ci))
                 (cj  (-> *phys-cj* sco))
                 (cj2 (-> *phys-cj2* sco))
                 (own (phys-col-own? sc n cj cj2)))
            (when (and own (nonzero? *phys-self-inject*)) (set! own #f))
            (when (and (not own) (>= cj 0) (< (+ cj 1) nbone))
              (phys-col-centre skel sco cj ca)
              (if (and (>= cj2 0) (< (+ cj2 1) nbone))
                (vector-copy! cb (the-as vector (-> skel bones (+ cj2 1) transform vector 3)))
                (vector-copy! cb ca))
              (when (not (phys-col-rest! sco ra rb))
                (vector-copy! ra ca) (vector-copy! rb cb))
              (let* ((cap?   (and (>= cj2 0) (< (+ cj2 1) nbone)))
                     (floor0 (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                 (-> *phys-cr2* sco) cap? nrm))
                     (feff   (phys-vol-floor floor0 rl))
                     (dep    (phys-collide-depth q rl ca cb (-> *phys-cr* sco)
                                                 (-> *phys-cr2* sco) cap? nrm))
                     (res    (- dep feff)))
                ;; DE QUEL COTE DU VOLUME EST-ON ? Compte une fois par frame (le meme drapeau que
                ;; `buried` : `phys-pen-chain` l'arme, le recul ne l'arme pas, donc les 3 reculs et
                ;; leurs 12 pas de dichotomie ne comptent pas). Un lien dont la pose de modele est
                ;; DANS le volume et qui se retrouve du cote oppose de l'axe a traverse la piece
                ;; de part en part — et la profondeur ne peut pas le voir, puisqu'elle est
                ;; maximale sur l'axe et redescend en ressortant.
                (when (and (nonzero? *phys-buried-tally*) (> floor0 0.0))
                  (when (and (phys-axis-dir rest ra rb ua) (phys-axis-dir q ca cb ub))
                    (when (< (+ (* (-> ua x) (-> ub x))
                                (+ (* (-> ua y) (-> ub y)) (* (-> ua z) (-> ub z))))
                             0.0)
                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 11))
                            (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 11)))))))
                ;; `buried` = le lien est entierement dans ce volume A SA POSE DE MODELE. Depuis le
                ;; 2026-08-12 c'est une MESURE et plus une DECISION : elle ne dispense plus la paire
                ;; d'etre contrainte (cf. phys-vol-floor, branche FREE retiree). Le nombre reste
                ;; publie parce que c'est lui qui a designe `goggles-tunnel` — mais il ne commande
                ;; plus rien, et l'instrument de mesure cesse d'etre l'instrument de derogation.
                (when (>= floor0 (* 2.0 rl))
                  (set! *phys-buried-n* (+ *phys-buried-n* 1))
                  (when (nonzero? *phys-buried-tally*)
                    (set! (-> *phys-dg* (+ (* sc PHYS-DG) 9))
                          (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 9))))))
                ;; EN CONTACT = dedans a sa pose de modele, ou dedans maintenant. Une paire dont
                ;; les deux profondeurs sont nulles (un volume a l'autre bout du corps) n'est pas
                ;; un contact : la compter rendrait le residu identiquement nul et la colonne
                ;; deviendrait un zero constant, c.-a-d. indistinguable d'une colonne fabriquee.
                (when (and (or (> floor0 0.0) (> dep 0.0)) (> res worst))
                  (set! worst res))))))))
    worst))

(defun phys-pen-chain ((skel skeleton) (sc int) (n int) (rlk int) (nbone int) (nco int))
  (let ((worst PHYS-NOCONTACT)
        (pt (new 'stack-no-clear 'vector)))
    ;; SEULE passe de la frame ou l'enfouissement est compte par chaine (voir *phys-buried-tally*).
    (set! *phys-buried-tally* 1)
    (dotimes (l n)
      (when (>= l rlk)
        (let ((scl (+ (* sc PHYS-LINKS) l)))
          (set! (-> pt x) (-> *phys-px* scl))
          (set! (-> pt y) (-> *phys-py* scl))
          (set! (-> pt z) (-> *phys-pz* scl))
          (set! (-> pt w) 1.0)
          (let ((r (phys-link-pen skel sc n nbone nco l pt)))
            (when (> r worst) (set! worst r))))))
    (set! *phys-buried-tally* 0)
    ;; la sentinelle est RENDUE TELLE QUELLE : « aucun contact » n'est pas « penetration nulle »,
    ;; et c'est l'appelant qui compte les deux separement. Confondre les deux, c'est annoncer un
    ;; zero mesure la ou rien n'a ete mesure.
    worst))

;; ------------------------------------------------------------------------------------------------
;; CONTRAINTE 3 — LA POSE DU MODELE, DERNIER RECOURS (SPEC : « ce qui limite une chaine est soit la
;; longueur d'un os, soit un collider, soit LA POSE DU MODELE »).
;;
;; La projection de Gauss-Seidel peut tourner en rond : sortir d'un volume fait rentrer dans le
;; voisin (crane/oreille, hanche/cuisse), et il reste alors un residu — mesure du 2026-08-11 :
;; 0.0270 m sur les lunettes, 0.0839 m sur une sangle, apres 36 balayages. Un residu, c'est du mesh
;; traverse, et la regle 6 de l'owner ne s'en accommode pas.
;;
;; Or il existe TOUJOURS un point admissible : la pose du modele elle-meme, ou la profondeur EST le
;; plancher pour chaque volume (meme calcul, memes entrees, donc egalite exacte). Le lien recule
;; donc vers sa pose de modele jusqu'a redevenir admissible — recherche par dichotomie, 12 pas, qui
;; aboutit par construction. Ce que ce recul retire de mouvement est compte et publie ; il ne se
;; declenche que quand la projection a echoue.
;;
;; IL RECULE SUR LA SPHERE, PAS EN LIGNE DROITE. Owner, 5e passe : « les changements brusques de
;; direction causent un truc chelou au niveau des seins, ils s'allongent, c'est un peu debile. »
;; Reculer en ligne droite vers la pose du modele traverse l'interieur de la sphere : la distance a
;; l'attache diminue, donc l'os RACCOURCIT — et c'est le dernier geste de la frame, donc c'est
;; exactement ce que l'owner voit. Mesure du 2026-08-11 : avec le recul rectiligne, l'allongement
;; relatif atteint 7,5 % sur chestL et 83 % sur botstrapL. La pose du modele est SUR la sphere par
;; construction (|T_lien - T_attache| = want), donc tout le chemin peut y rester : on interpole la
;; DIRECTION puis on la renormalise a `want`. Meme dichotomie, meme point d'arrivee, longueur
;; invariante d'un bout a l'autre.
;; ------------------------------------------------------------------------------------------------
(defun phys-retreat-chain ((skel skeleton) (sc int) (n int) (rlk int) (nbone int) (nco int))
  (let ((pt (new 'stack-no-clear 'vector))
        (bs (new 'stack-no-clear 'vector)))
    (dotimes (l n)
      (when (>= l rlk)
        (let* ((scl (+ (* sc PHYS-LINKS) l))
               (kk  (-> *phys-joint* scl))
               (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) (-> *phys-anchor* sc))))
          (when (and (>= kk 0) (< (+ kk 1) nbone))
            (set! (-> pt x) (-> *phys-px* scl))
            (set! (-> pt y) (-> *phys-py* scl))
            (set! (-> pt z) (-> *phys-pz* scl))
            (set! (-> pt w) 1.0)
            (when (> (phys-link-pen skel sc n nbone nco l pt) 0.0)
              (let* ((tx (-> skel bones (+ kk 1) transform vector 3 x))
                     (ty (-> skel bones (+ kk 1) transform vector 3 y))
                     (tz (-> skel bones (+ kk 1) transform vector 3 z))
                     ;; l'attache et le rayon de la sphere sur laquelle ce lien vit
                     (ok? (and (>= kp 0) (< (+ kp 1) nbone)))
                     (bx (if (not ok?) 0.0
                           (if (> l 0) (-> *phys-px* (- scl 1))
                             (-> skel bones (+ kp 1) transform vector 3 x))))
                     (by (if (not ok?) 0.0
                           (if (> l 0) (-> *phys-py* (- scl 1))
                             (-> skel bones (+ kp 1) transform vector 3 y))))
                     (bz (if (not ok?) 0.0
                           (if (> l 0) (-> *phys-pz* (- scl 1))
                             (-> skel bones (+ kp 1) transform vector 3 z))))
                     (wx (- tx bx)) (wy (- ty by)) (wz (- tz bz))
                     (want (sqrtf (+ (* wx wx) (+ (* wy wy) (* wz wz)))))
                     ;; la direction et la longueur que LE MODELE donne a cet os. Elles ne valent
                     ;; `w`/`want` ci-dessus que si l'attache n'a pas bouge.
                     (mx (if ok? (- tx (-> skel bones (+ kp 1) transform vector 3 x)) 0.0))
                     (my (if ok? (- ty (-> skel bones (+ kp 1) transform vector 3 y)) 0.0))
                     (mz (if ok? (- tz (-> skel bones (+ kp 1) transform vector 3 z)) 0.0))
                     (ml (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz)))))
                     ;; la sphere n'existe que si l'os existe ; sinon on recule en ligne droite,
                     ;; comme avant, et c'est publie par le meme compteur.
                     (sphere? (and ok? (> want 0.01)))
                     (ux (- (-> pt x) bx)) (uy (- (-> pt y) by)) (uz (- (-> pt z) bz))
                     (dx (- (-> pt x) tx))
                     (dy (- (-> pt y) ty))
                     (dz (- (-> pt z) tz))
                     (lo 0.0)     ;; le point de depart, TESTE et non plus suppose (it = 0)
                     (hi 1.0)     ;; inadmissible, on vient de le mesurer
                     ;; LA MEILLEURE PENETRATION RENCONTREE SUR LE CHEMIN. > 0 = aucun point
                     ;; admissible n'existe, pas meme la pose du modele.
                     (bestp 1000000000.0))
                ;; LA SPHERE DU RECUL DOIT ETRE CELLE DE LA CONTRAINTE DE LONGUEUR. Elle ne l'etait
                ;; pas : le recul se normalisait sur |auteur(kk) - attache COURANTE|, qui n'est pas
                ;; la longueur du modele des que l'attache a bouge — donc le lien revenait sur une
                ;; AUTRE sphere et la longueur cedait sur les liens profonds. La mesure le disait
                ;; sans ambiguite : les deux SEULES chaines a trois maillons du fichier, lbang
                ;; (0.1346) et rbang (0.2756), etaient les deux SEULES a s'allonger ; les onze
                ;; chaines a deux maillons, dont le lien libre a une attache immobile, mesuraient
                ;; toutes 0.0000.
                ;; Le point de depart de la recherche (lo = 0) doit rester ADMISSIBLE : c'est
                ;; l'invariant qui garantit « rien ne traverse » (regle 6, non negociable). Sur la
                ;; sphere du modele il ne l'est plus par construction, donc on le TESTE, et on
                ;; retombe sur l'ancienne base — la pose d'auteur exacte — quand il ne l'est pas.
                ;; Ce repli est compte, pas taire.
                (when (and sphere? (> ml 0.01) (> (fabs (- ml want)) 0.01))
                  ;; le point lo = 0 sur la sphere du modele : l'attache courante plus le vecteur
                  ;; d'os du modele (de longueur ml, donc deja sur la sphere).
                  (set! (-> bs x) (+ bx mx))
                  (set! (-> bs y) (+ by my))
                  (set! (-> bs z) (+ bz mz))
                  (set! (-> bs w) 1.0)
                  (cond
                    ((> (phys-link-pen skel sc n nbone nco l bs) 0.0)
                     (set! *phys-retfb-n* (+ *phys-retfb-n* 1)))
                    (else
                     (set! wx mx) (set! wy my) (set! wz mz) (set! want ml))))
                ;; ------------------------------------------------------------------------
                ;; `lo = 0` (LA POSE DU MODELE) N'EST PLUS SUPPOSE ADMISSIBLE : IL EST TESTE.
                ;;
                ;; L'invariant « la pose du modele est toujours admissible » repose sur
                ;; `dep(pose du modele) == floor0`. Il a cesse d'etre vrai le jour ou `floor0` a ete
                ;; mesure contre l'INSTANTANE d'auteur du volume pendant que `dep` l'est contre sa
                ;; position COURANTE (phys-snapshot-colliders!) : pour un volume porte par un joint
                ;; SIMULE, les deux membres ne decrivent plus le meme obstacle.
                ;;
                ;; MESURE, course du 2026-08-12 : UNE ligne sur 3410 sortait avec une penetration
                ;; positive — `rmidhair`, anim `assistant-firecanyon-idle-down`, drive `accel`,
                ;; 0.0017 m. Et c'est la seule signature possible : apres le recul, la position
                ;; ecrite est celle d'un `lo` TESTE admissible... sauf si `lo` est reste a 0, auquel
                ;; cas rien ne l'a jamais teste. `rmidhair` est la chaine 6 ; `lmidhair` (chaine 5),
                ;; `lbang`, `rbang`, `earL`, `earR` ont deja ecrit leurs joints quand elle est
                ;; resolue, et ce sont precisement les joints qui portent les spheres qu'elle
                ;; heurte. Sa pose de modele peut donc etre AVALEE par une meche voisine qui a
                ;; bouge, et le recul n'avait alors plus aucun point d'ancrage.
                ;;
                ;; La reponse honnete n'est pas de faire semblant : quand aucun point admissible
                ;; n'existe sur le chemin, on se pose sur le MOINS MAUVAIS, et on le compte. La
                ;; premiere evaluation est donc `mid = 0` — elle coute un appel et transforme une
                ;; hypothese en mesure. Quand elle est admissible (le cas courant), `lo` reste 0 et
                ;; tout le reste est identique au bit pres : ce n'est pas un chemin nouveau, c'est
                ;; le meme chemin avec sa premiere marche verifiee.
                ;; ------------------------------------------------------------------------
                (dotimes (it 13)
                  (let ((mid (if (zero? it) 0.0 (* 0.5 (+ lo hi)))))
                    (cond
                      (sphere?
                       ;; direction interpolee entre la pose du modele et la position courante,
                       ;; renormalisee a `want` : on ne quitte jamais la sphere.
                       (let* ((vx (+ wx (* mid (- ux wx))))
                              (vy (+ wy (* mid (- uy wy))))
                              (vz (+ wz (* mid (- uz wz))))
                              (vl (sqrtf (+ (* vx vx) (+ (* vy vy) (* vz vz))))))
                         (cond
                           ((> vl 0.0001)
                            (let ((s (/ want vl)))
                              (set! (-> bs x) (+ bx (* vx s)))
                              (set! (-> bs y) (+ by (* vy s)))
                              (set! (-> bs z) (+ bz (* vz s)))))
                           (else
                            (set! (-> bs x) tx) (set! (-> bs y) ty) (set! (-> bs z) tz)))))
                      (else
                       (set! (-> bs x) (+ tx (* dx mid)))
                       (set! (-> bs y) (+ ty (* dy mid)))
                       (set! (-> bs z) (+ tz (* dz mid)))))
                    (set! (-> bs w) 1.0)
                    (let ((p (phys-link-pen skel sc n nbone nco l bs)))
                      (when (< p bestp)
                        (set! bestp p))
                      ;; L'EVALUATION it = 0 MESURE, ELLE NE DECIDE PAS. Elle teste `mid = 0`, la
                      ;; pose du modele, pour savoir si l'ancre de la recherche est admissible — et
                      ;; c'est tout. Lui laisser mettre a jour l'intervalle etait un bug mesure :
                      ;; quand la pose du modele penetre, `hi` tombait a 0, l'intervalle [lo,hi] se
                      ;; refermait sur le point de depart et les douze pas suivants ne cherchaient
                      ;; plus rien. La dichotomie a le droit de partir d'une borne inadmissible et
                      ;; de trouver quand meme un point admissible plus loin sur l'arc ; c'est ce
                      ;; qu'elle faisait, et ce que ce premier pas lui avait retire.
                      ;; MESURE : 8 lignes a penetration positive sur 3410 avec la mise a jour,
                      ;; 1 sans (pire cas 0.0030 m contre 0.0017 m), sur deux courses completes.
                      (when (nonzero? it)
                        (if (> p 0.0)
                          (set! hi mid)
                          (set! lo mid))))))
                ;; AUCUN POINT ADMISSIBLE SUR LE CHEMIN — donc pas meme la pose du modele (bestp est
                ;; le minimum sur les 13 points, et il est positif). C'est COMPTE, et publie par
                ;; ROOM-RETREAT-ANCHOR : 668 fois par course.
                ;;
                ;; ET LE LIEN SE POSE QUAND MEME SUR LA POSE DU MODELE — j'ai essaye le contraire et
                ;; la mesure l'a refuse. Version essayee le 2026-08-12 : se poser sur le MOINS
                ;; MAUVAIS point du chemin (`tf = bestt`), qui a par construction une penetration
                ;; INFERIEURE OU EGALE a celle de la pose du modele. Course complete, meme salle,
                ;; meme animation, seule cette ligne changee :
                ;;     lignes de mesure a penetration positive : 1 sur 3410  ->  8 sur 3410
                ;;     pire penetration                        : 0.0017 m   ->  0.0030 m
                ;; Le raisonnement local etait juste et le resultat global pire, parce que la pose du
                ;; modele n'est pas seulement un point admissible : c'est un POINT FIXE. S'y reposer
                ;; ramene la chaine au meme etat a chaque frame ; se poser sur un minimum local la
                ;; laisse ailleurs, et la frame suivante repart de plus loin. Un minimum instantane
                ;; ne vaut pas un point fixe. Retire — pas adouci, retire — et le compteur reste.
                (let ((tf lo))
                  (when (> bestp 0.0)
                    (set! *phys-retfb-n* (+ *phys-retfb-n* 1)))
                  (set! *phys-retreat-n* (+ *phys-retreat-n* 1))
                  (set! *phys-retreat-sum*
                        (+ *phys-retreat-sum*
                           (* (- 1.0 tf) (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz)))))))
                  (cond
                    (sphere?
                     (let* ((vx (+ wx (* tf (- ux wx))))
                            (vy (+ wy (* tf (- uy wy))))
                            (vz (+ wz (* tf (- uz wz))))
                            (vl (sqrtf (+ (* vx vx) (+ (* vy vy) (* vz vz))))))
                       (cond
                         ((> vl 0.0001)
                          (let ((s (/ want vl)))
                            (set! (-> *phys-px* scl) (+ bx (* vx s)))
                            (set! (-> *phys-py* scl) (+ by (* vy s)))
                            (set! (-> *phys-pz* scl) (+ bz (* vz s)))))
                         (else
                          (set! (-> *phys-px* scl) tx)
                          (set! (-> *phys-py* scl) ty)
                          (set! (-> *phys-pz* scl) tz)))))
                    (else
                     (set! (-> *phys-px* scl) (+ tx (* dx tf)))
                     (set! (-> *phys-py* scl) (+ ty (* dy tf)))
                     (set! (-> *phys-pz* scl) (+ tz (* dz tf)))))))))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; LA POSE DU MODELE EST-ELLE PLAUSIBLE ? — verifie a la premiere frame de chaque chaine, sur le
;; squelette retargete, et publie.
;;
;; Un morceau de geometrie ne peut pas pendre a cinquante fois sa propre epaisseur de l'os qui le
;; porte : ce n'est plus un appendice, c'est un joint que le retarget a envoye ailleurs, et le
;; simuler ne produirait que du bruit autour d'une position fausse. Mesure du 2026-08-11 sur le rig
;; keira-hd : `LpantFlap` est a 1 061 122 unites (259 m) de Lknee, soit 2473 fois son rayon ajuste,
;; et sa pose ne bougeait pas d'une frame a l'autre pendant que le personnage etait secoue — alors
;; que la pire chaine SAINE est a 15.1 fois son rayon (lbang). Le seuil de 50 tombe donc dans un
;; fosse de deux ordres de grandeur, il n'est pas ajuste pour faire passer quoi que ce soit. Les
;; rapports des 22 chaines sont publies dans le tableau.
;;
;; Ce n'est pas un flag de derogation (DIRECTIVES 4) : rien dans les donnees ne le declare, c'est
;; une mesure faite sur la pose retargetee a l'execution, et la chaine est ecartee AVEC son chiffre.
(defconstant PHYS-POSE-RATIO 50.0)

(defun phys-pose-repair ((obj jak-hd) (skel skeleton) (sc int) (n int) (an int) (nbone int)
                        (report symbol))
  "RE-ASSEOIR un lien que le retarget a envoye ailleurs, au lieu de le simuler autour d'une position
   fausse ET au lieu de le supprimer des donnees. Owner/superviseur du 2026-08-11 : une chaine se
   REPARE, elle ne se retire pas. La position de secours est derivee du rig et de rien d'autre : le
   porteur, prolonge le long de SON os (de son parent vers lui), a la distance que le mesh mesure
   pour ce lien (son rayon ajuste). Elle est ecrite dans le squelette AVANT la physique, donc la
   geometrie du lien suit, et la reparation est comptee et publiee. C'est un defaut de MODELE
   corrige au dernier moment possible, pas une physique inventee."
  (let ((seat (new 'stack-no-clear 'vector))
        (dir  (new 'stack-no-clear 'vector))
        (ib   (new 'stack-no-clear 'matrix))
        (lk   (new 'stack-no-clear 'matrix)))
    (dotimes (l n)
      (let* ((scl (+ (* sc PHYS-LINKS) l))
             (kk  (-> *phys-joint* scl))
             (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an))
             (rl  (-> *phys-rad* scl)))
        (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone) (> rl 0.01))
          (let ((d (vector-vector-distance
                     (the-as vector (-> skel bones (+ kk 1) transform vector 3))
                     (the-as vector (-> skel bones (+ kp 1) transform vector 3)))))
            (when report
              (format 0 "[HD-PHYS] pose c=~D l=~D dist=~f rad=~f ratio=~f~%"
                      (mod sc PHYS-CHAINS) l d rl (/ d rl)))
            (when (> d (* PHYS-POSE-RATIO rl))
              ;; ------------------------------------------------------------------------------
              ;; LA PLACE DE SECOURS EST CELLE QUE LE RIG DONNE, PAS UNE DISTANCE INVENTEE.
              ;;
              ;; Owner, 11e passe (2026-08-11 21:15) : « le bas de son pantacourt clipe toujours a
              ;; l'interieur de ses mollets au lieu d'etre visible, COMME SI SON PANTACOURT
              ;; S'ARRETAIT AUX GENOUX ». C'est litteralement ce que la re-assise faisait.
              ;;
              ;; MESURE (.autoport/probe_keira_volumes.py, 2026-08-12, sur le rig et le mesh) :
              ;;     LpantFlap est a 1349 u de Lknee dans la pose BIND — une pose parfaitement
              ;;     saine. C'est le RETARGET qui l'envoie a 1 061 104 u (259 m) a l'execution.
              ;;     La re-assise le replacait a `rl` = 429 u du genou : 3.1 fois trop pres,
              ;;     c.-a-d. juste sous le genou au lieu de la mi-mollet. Le pan de tissu etait
              ;;     donc dessine dans la jambe, et son enfouissement dans la capsule du mollet
              ;;     rendait tout volume inoperant devant lui (phys-vol-floor le declare libre).
              ;;     Elle est re-assise 18 101 fois par course : le defaut est permanent.
              ;;
              ;; `rl` est un RAYON — l'epaisseur du morceau de geometrie — et rien n'autorisait a
              ;; s'en servir comme d'une LONGUEUR D'OS. Le rig porte la vraie valeur et le moteur
              ;; y a acces : la bind-pose d'un joint EST son inverse-bind (jak-hd.gc:461), donc
              ;;     L = inv(bind-pose[kk]) . bind-pose[kp]
              ;; a pour translation la position bind de kk DANS LE REPERE BIND DE kp — exactement
              ;; la meme construction que `L'_k` du retarget (jak-hd.gc:500-502). Portee par la
              ;; matrice courante du porteur, elle rend la place que le modele lui donne, direction
              ;; ET distance, sans une seule constante inventee.
              ;; A defaut (jgeo hors de portee), on retombe sur l'ancienne heuristique, et ce repli
              ;; est COMPTE a part : un secours silencieux est un defaut qui attend.
              ;; ------------------------------------------------------------------------------
              (let ((done #f))
                (when (and (nonzero? (-> obj draw jgeo))
                           (< kk (-> obj draw jgeo length))
                           (< kp (-> obj draw jgeo length)))
                  (matrix-4x4-inverse! ib (-> obj draw jgeo data kk bind-pose))
                  (matrix*! lk ib (-> obj draw jgeo data kp bind-pose))
                  (set-vector! seat (-> lk vector 3 x) (-> lk vector 3 y) (-> lk vector 3 z) 1.0)
                  (when (> (+ (fabs (-> seat x)) (+ (fabs (-> seat y)) (fabs (-> seat z)))) 0.01)
                    (vector-matrix*! seat seat (the-as matrix (-> skel bones (+ kp 1) transform)))
                    (set! done #t)))
                (when (not done)
                  (set! *phys-reseat-fb* (+ *phys-reseat-fb* 1))
                  ;; direction de l'os du porteur : de SON parent vers lui. A defaut (porteur
                  ;; racine), la verticale du monde vers le bas — ce qui pend, pend.
                  (let ((gp (the int (-> (-> obj khd-par) kp))))
                    (cond
                      ((and (!= gp 255) (< (+ gp 1) nbone))
                       (set! (-> dir x) (- (-> skel bones (+ kp 1) transform vector 3 x)
                                           (-> skel bones (+ gp 1) transform vector 3 x)))
                       (set! (-> dir y) (- (-> skel bones (+ kp 1) transform vector 3 y)
                                           (-> skel bones (+ gp 1) transform vector 3 y)))
                       (set! (-> dir z) (- (-> skel bones (+ kp 1) transform vector 3 z)
                                           (-> skel bones (+ gp 1) transform vector 3 z)))
                       (set! (-> dir w) 0.0))
                      (else (set-vector! dir 0.0 -1.0 0.0 0.0))))
                  (let ((dl (vector-length dir)))
                    (if (> dl 0.01)
                      (vector-float*! dir dir (/ rl dl))
                      (set-vector! dir 0.0 (- 0.0 rl) 0.0 0.0)))
                  (set! (-> seat x) (+ (-> skel bones (+ kp 1) transform vector 3 x) (-> dir x)))
                  (set! (-> seat y) (+ (-> skel bones (+ kp 1) transform vector 3 y) (-> dir y)))
                  (set! (-> seat z) (+ (-> skel bones (+ kp 1) transform vector 3 z) (-> dir z)))))
              (when report
                (format 0 "[HD-PHYS] reseat c=~D l=~D dist=~f rad=~f ratio=~f~%"
                        (mod sc PHYS-CHAINS) l d rl (/ d rl))
                ;; LA PREUVE QUE LA PLACE A CHANGE, et de combien : la distance au porteur que le
                ;; rig donne, contre celle que l'ancienne heuristique donnait (le rayon `rl`).
                (format 0 "[HD-PHYS] reseat-at c=~D l=~D bind=~f oldheur=~f~%"
                        (mod sc PHYS-CHAINS) l
                        (vector-vector-distance
                          seat (the-as vector (-> skel bones (+ kp 1) transform vector 3)))
                        rl))
              (set! *phys-reseat-n* (+ *phys-reseat-n* 1))
              (set! (-> skel bones (+ kk 1) transform vector 3 x) (-> seat x))
              (set! (-> skel bones (+ kk 1) transform vector 3 y) (-> seat y))
              (set! (-> skel bones (+ kk 1) transform vector 3 z) (-> seat z))
              (set! (-> skel bones (+ kk 1) transform vector 3 w) 1.0)))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; LE PAS — appele depuis do-joint-math! de jak-hd, APRES fill-jak-hd-bones!. A cet instant le
;; squelette porte la pose retargetee complete en espace MONDE (jak-hd.gc:551-556), et rien ne l'a
;; encore lue : bones-mtx-calc-execute (drawable.gc:895) vient bien plus tard dans la frame.
;; ------------------------------------------------------------------------------------------------
(defun jak-hd-physics-step ((obj jak-hd))
  (let ((slot (phys-slot-for-pid (the int (-> obj pid)))))
    (when (and (>= slot 0)
               (nonzero? (pc-physics-enabled))
               (nonzero? (-> obj draw))
               (nonzero? (-> obj draw skeleton))
               (nonzero? (-> obj draw jgeo)))
      (let* ((skel   (-> obj draw skeleton))
             (nbone  (-> skel length))
             (njoint (min (-> obj draw jgeo length) PHYS-JOINTS))
             (nch    (-> *phys-slot-nch* slot))
             (nco    (-> *phys-slot-nco* slot))
             (dt     0.0166667)
             ;; 9.81 m/s^2 dans les unites de l'integrateur : 9.81 * 4096 u/m / 3600 frames^2/s^2
             ;; = 11.16 u/frame^2. L'ancienne valeur (-160, ENCORE multipliee par dt^2) donnait
             ;; 0.044 u/frame^2, 250 fois trop faible : la famille B ne pendait pas du tout. C'est
             ;; une erreur d'unites, pas un reglage.
             (gy     -11.16))
        (set! *phys-njoint* njoint)
        (dotimes (k njoint) (set! (-> *phys-dhas* k) 0))
        ;; LA POSE D'AUTEUR DES VOLUMES, AVANT QUE LA PREMIERE CHAINE N'ECRIVE. Les chaines sont
        ;; resolues l'une apres l'autre et chacune ecrit son joint dans le squelette : passe ce
        ;; point, `skel bones` ne porte plus la pose d'auteur pour les joints deja traites.
        (phys-snapshot-colliders! skel slot nco nbone)
        (let ((w2l  (new 'stack-no-clear 'matrix))
              (pre  (new 'stack-no-clear 'matrix))
              (inv  (new 'stack-no-clear 'matrix))
              (rot  (new 'stack-no-clear 'matrix))
              (tmp  (new 'stack-no-clear 'matrix))
              (anc  (new 'stack-no-clear 'vector))
              (tw   (new 'stack-no-clear 'vector))
              (acc  (new 'stack-no-clear 'vector))
              (fl   (new 'stack-no-clear 'vector))
              (gl   (new 'stack-no-clear 'vector))
              (gref (new 'stack-no-clear 'vector))
              (ov   (new 'stack-no-clear 'vector))
              (uv   (new 'stack-no-clear 'vector))
              (uv2  (new 'stack-no-clear 'vector))
              (sv   (new 'stack-no-clear 'vector))
              (pt   (new 'stack-no-clear 'vector))
              (tgt  (new 'stack-no-clear 'vector))
              (rest (new 'stack-no-clear 'vector))
              (nrm  (new 'stack-no-clear 'vector)))
          (dotimes (c nch)
            (let* ((sc  (+ (* slot PHYS-CHAINS) c))
                   (an  (-> *phys-anchor* sc)))
              ;; LA POSE DU MODELE EST-ELLE PLAUSIBLE ? Une fois par chaine, a sa premiere frame, ou
              ;; le squelette porte enfin la pose retargetee. Une chaine ecartee passe a zero lien et
              ;; tout ce qui suit la saute — y compris son bloc de mesure, sinon elle publierait des
              ;; chiffres pris sur le joint d'a cote.
              (when (and (> (-> *phys-nlink* sc) 0) (>= an 0) (< (+ an 1) nbone))
                (phys-pose-repair obj skel sc (-> *phys-nlink* sc) an nbone
                                  (zero? (-> *phys-warm* sc))))
              (let* ((n   (-> *phys-nlink* sc))
                     (rlk (max 0 (min (-> *phys-rootlk* sc) (max 0 (- n 1))))))
              (when (and (> n 0) (>= an 0) (< (+ an 1) nbone))
                (let ((am (the-as matrix (-> skel bones (+ an 1) transform))))
                  (vector-copy! anc (the-as vector (-> am vector 3)))
                  (matrix-4x4-inverse! w2l am)
                  ;; ---------------------------------------------------------------------------
                  ;; LA GRAVITE, VUE DEPUIS LE REPERE DE L'ANCRE. Owner, 6e passe : « les seins
                  ;; n'ont pas l'air d'etre soumis a la gravite, aucun mouvement quand elle se
                  ;; penche en avant pour souder, pas coherent du tout. »
                  ;;
                  ;; Famille B (ce qui PEND) : gravite absolue. Elle deplace l'equilibre, ca pend
                  ;; et ca reste pendu — c'est l'exception de SPEC 4.
                  ;;
                  ;; Famille A (ce qu'elle EST) : SPEC 4 exige qu'au repos on retrouve EXACTEMENT
                  ;; la pose du modele, donc une gravite absolue est interdite — elle affaisserait
                  ;; la poitrine en permanence. Mais la pose du modele est deja une pose SOUS
                  ;; gravite : le sculpteur l'a modelee debout. Ce qui doit agir, c'est donc l'ECART
                  ;; entre la gravite d'aujourd'hui et celle de la pose de reference, tous deux
                  ;; exprimes dans le repere de l'ancre :
                  ;;
                  ;;     g_effective = R_ancre^-1 . g_monde  -  R_bind^-1 . g_monde
                  ;;
                  ;; Le second terme est CONSTANT (la bind-pose du rig porte l'inverse-bind, donc sa
                  ;; rotation EST R_bind^-1). Buste droit -> les deux termes s'annulent, l'equilibre
                  ;; reste la pose du modele au bit pres. Buste incline -> l'ecart apparait et la
                  ;; poitrine tombe. Rotation autour de l'axe de la gravite -> invariante, donc un
                  ;; simple demi-tour n'invente aucune force.
                  ;; La bind-pose peut porter une echelle : on renormalise, sinon l'amplitude de la
                  ;; reference ne serait pas celle de la gravite.
                  ;;
                  ;; LES DEUX TERMES SONT RAMENES A LA MEME LONGUEUR AVANT D'ETRE SOUSTRAITS. Le
                  ;; premier sortait BRUT de `w2l` — donc a l'echelle de la matrice de l'os, qui
                  ;; n'est pas garantie orthonormale sur un squelette retargete — pendant que le
                  ;; second etait explicitement renormalise a |g|. La difference de deux vecteurs
                  ;; qui n'ont pas la meme unite n'est pas une difference de gravites : debout, ou
                  ;; les deux rotations sont censees s'annuler, il restait (1 - echelle) x |g|.
                  ;; ---------------------------------------------------------------------------
                  (set-vector! gl 0.0 gy 0.0 0.0)
                  (vector-rotate*! gl gl w2l)
                  (let ((gn (vector-length gl)))
                    (when (> gn 0.0001) (vector-float*! gl gl (/ (fabs gy) gn))))
                  (when (and (= (-> *phys-fam* sc) 1)
                             (nonzero? (-> obj draw jgeo))
                             (< an (-> obj draw jgeo length)))
                    (set-vector! gref 0.0 gy 0.0 0.0)
                    (vector-rotate*! gref gref (-> obj draw jgeo data an bind-pose))
                    (let ((gn (vector-length gref)))
                      (when (> gn 0.0001)
                        (vector-float*! gref gref (/ (fabs gy) gn))
                        (set! (-> gl x) (- (-> gl x) (-> gref x)))
                        (set! (-> gl y) (- (-> gl y) (-> gref y)))
                        (set! (-> gl z) (- (-> gl z) (-> gref z))))))
                  (let* ((warm (-> *phys-warm* sc))
                         (w    (/ (* 6.2831853 (-> *phys-stiff* sc))
                                  (sqrtf (fmax 0.01 (-> *phys-mass* sc)))))
                         (k2   (* w w dt dt))
                         (dmp  (-> *phys-damp* sc))
                         (gsc  (-> *phys-grav* sc))
                         (cpl  (-> *phys-couple* sc)))
                    (set! (-> *phys-warm* sc) (min 3 (+ warm 1)))
                    ;; LE STIMULUS GRAVITAIRE LUI-MEME, avant toute reponse. Sans ce nombre, un
                    ;; affaissement nul est indiscernable entre « la gravite n'arrive pas jusqu'a
                    ;; cette chaine » et « la chaine n'y repond pas », et c'est cette ambiguite qui
                    ;; a laisse quatre passes de l'owner sans reponse. 0 debout, 1.0 a 60 degres.
                    (let* ((stb (* sc PHYS-ST))
                           (gm  (/ (vector-length gl) (fabs gy))))
                      (when (> gm (-> *phys-st* (+ stb 18))) (set! (-> *phys-st* (+ stb 18)) gm)))
                    ;; ---- 1. INTEGRATION DE L'ECART, lien par lien, dans le repere de l'ancre ----
                    (dotimes (l n)
                      (let* ((scl (+ (* sc PHYS-LINKS) l))
                             (k   (-> *phys-joint* scl)))
                        (when (and (>= k 0) (< (+ k 1) nbone))
                          (vector-copy! tw (the-as vector (-> skel bones (+ k 1) transform vector 3)))
                          ;; acceleration MONDE de la pose d'auteur de CE lien (difference seconde) :
                          ;; elle contient la translation ET la rotation du porteur, donc un simple
                          ;; tour de tete excite la chaine.
                          (set-vector! acc 0.0 0.0 0.0 0.0)
                          (when (> warm 1)
                            (set! (-> acc x) (+ (- (-> tw x) (* 2.0 (-> *phys-t1x* scl))) (-> *phys-t2x* scl)))
                            (set! (-> acc y) (+ (- (-> tw y) (* 2.0 (-> *phys-t1y* scl))) (-> *phys-t2y* scl)))
                            (set! (-> acc z) (+ (- (-> tw z) (* 2.0 (-> *phys-t1z* scl))) (-> *phys-t2z* scl))))
                          (set! (-> *phys-t2x* scl) (-> *phys-t1x* scl))
                          (set! (-> *phys-t2y* scl) (-> *phys-t1y* scl))
                          (set! (-> *phys-t2z* scl) (-> *phys-t1z* scl))
                          ;; LE STIMULUS REELLEMENT RECU PAR LA POINTE, quelle qu'en soit la
                          ;; source (pilotage de la salle, rotation du porteur, animation). Mesure
                          ;; ici parce que c'est ici, et seulement ici, que l'acceleration de la
                          ;; pose d'auteur est connue.
                          (when (and (> warm 1) (= l (- n 1)))
                            (let ((aa (sqrtf (+ (* (-> acc x) (-> acc x))
                                                (+ (* (-> acc y) (-> acc y))
                                                   (* (-> acc z) (-> acc z))))))
                                  (stb (* sc PHYS-ST)))
                              (when (> aa (-> *phys-st* (+ stb 16)))
                                (set! (-> *phys-st* (+ stb 16)) aa))))
                          (when (and (> warm 0) (= l (- n 1)))
                            ;; deplacement monde de la pose d'auteur de la POINTE, cumule
                            (let ((mx (- (-> tw x) (-> *phys-t1x* scl)))
                                  (my (- (-> tw y) (-> *phys-t1y* scl)))
                                  (mz (- (-> tw z) (-> *phys-t1z* scl))))
                              (set! (-> *phys-tmov* sc)
                                    (+ (-> *phys-tmov* sc)
                                       (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz))))))))
                          (set! (-> *phys-t1x* scl) (-> tw x))
                          (set! (-> *phys-t1y* scl) (-> tw y))
                          (set! (-> *phys-t1z* scl) (-> tw z))
                          (cond
                            ((or (< warm 1) (< l rlk))
                             ;; SPEC 2 : lien rigide (rootlock), ou premiere frame. L'ecart est nul,
                             ;; la pose du modele est ecrite telle quelle.
                             (set! (-> *phys-ox* scl) 0.0)
                             (set! (-> *phys-oy* scl) 0.0)
                             (set! (-> *phys-oz* scl) 0.0)
                             (set! (-> *phys-o1x* scl) 0.0)
                             (set! (-> *phys-o1y* scl) 0.0)
                             (set! (-> *phys-o1z* scl) 0.0)
                             (set! (-> *phys-px* scl) (-> tw x))
                             (set! (-> *phys-py* scl) (-> tw y))
                             (set! (-> *phys-pz* scl) (-> tw z)))
                            (else
                             ;; pseudo-force du repere accelere, vue depuis le repere de l'ancre
                             (set-vector! fl (* -1.0 cpl (-> acc x))
                                             (* -1.0 cpl (-> acc y))
                                             (* -1.0 cpl (-> acc z)) 0.0)
                             (vector-rotate*! fl fl w2l)
                             ;; LA GRAVITE EST UNE FORCE, POUR LES DEUX FAMILLES — et c'est le
                             ;; correctif de fond du « toujours rien sur la gravite quand elle se
                             ;; penche », signale par l'owner aux 6e, 7e, 8e et 10e passes.
                             ;;
                             ;; La famille A ne recevait AUCUNE force : elle recevait un DEPLACEMENT
                             ;; DE CIBLE valant `gravity x 0.33 x longueur_de_l_os`. Deux
                             ;; consequences, et la seconde explique pourquoi tripler `gravity=` (de
                             ;; 0.45 a 1.30) n'a rien change de visible :
                             ;;   * 0.33 est un nombre invente, sans rien derriere (SPEC 7) ;
                             ;;   * une cible plafonnee a une fraction de l'os est ecrasee par la
                             ;;     contrainte de longueur des qu'elle est dirigee LE LONG de l'os,
                             ;;     et ce qui en survit ne depend plus lineairement de `gravity=`.
                             ;; La forme correcte est celle que la famille B utilise deja et que
                             ;; l'owner a validee sur les bretelles : une force, dont l'equilibre
                             ;; vaut F/k. Les deux familles partagent donc maintenant UNE ligne, et
                             ;; leur seule difference est le vecteur de gravite lui-meme — absolu
                             ;; pour ce qui PEND, differentiel (ecart a la pose de reference) pour
                             ;; ce qu'elle EST. `gravity=` redevient un reglage qui agit
                             ;; proportionnellement, donc reglable par l'oeil.
                             ;;
                             ;; ET LA PART DE CETTE GRAVITE QUE LA GEOMETRIE AUTORISE. La contrainte
                             ;; de longueur n'admet qu'une ROTATION autour de l'attache : la
                             ;; composante de la gravite dirigee dans l'axe de l'os ne peut produire
                             ;; aucun deplacement. Une chaine dont la gravite est presque radiale ne
                             ;; s'affaissera JAMAIS, quel que soit le reglage — c'est une propriete
                             ;; du rig, pas un bug, et sans ce nombre publie les deux sont
                             ;; indiscernables.
                             (when (= l (- n 1))
                               (let* ((stb (* sc PHYS-ST))
                                      (kpg (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
                                 (when (and (>= kpg 0) (< (+ kpg 1) nbone))
                                   (let* ((qx (- (-> tw x) (-> skel bones (+ kpg 1) transform vector 3 x)))
                                          (qy (- (-> tw y) (-> skel bones (+ kpg 1) transform vector 3 y)))
                                          (qz (- (-> tw z) (-> skel bones (+ kpg 1) transform vector 3 z)))
                                          (ql (sqrtf (+ (* qx qx) (+ (* qy qy) (* qz qz)))))
                                          (gn (vector-length gl)))
                                     (when (and (> ql 0.01) (> gn 0.0001))
                                       ;; la direction de l'os est en MONDE, la gravite effective en
                                       ;; repere d'ancre : on ramene l'os dans le repere de l'ancre
                                       ;; pour que le produit scalaire ait un sens.
                                       (set-vector! sv qx qy qz 0.0)
                                       (vector-rotate*! sv sv w2l)
                                       (let* ((sl (vector-length sv))
                                              (cs (if (> sl 0.0001)
                                                    (/ (+ (* (-> sv x) (-> gl x))
                                                          (+ (* (-> sv y) (-> gl y))
                                                             (* (-> sv z) (-> gl z))))
                                                       (* sl gn))
                                                    0.0))
                                              (tf (sqrtf (fmax 0.0 (- 1.0 (* cs cs))))))
                                         (when (> tf (-> *phys-st* (+ stb 19)))
                                           (set! (-> *phys-st* (+ stb 19)) tf))))))))
                             ;; --------------------------------------------------------------
                             ;; UNE BARRIERE DEVANT LE MUR.
                             ;;
                             ;; ELLE A ETE ECRITE POUR `flesh-jelly` ET ELLE NE LE CORRIGE PAS —
                             ;; c'est un A/B complet qui le dit, et je l'ecris ici plutot que de
                             ;; laisser le commentaire promettre ce que la mesure refuse. Deux
                             ;; courses de salle completes (3410 mesures chacune), cette barriere
                             ;; pour SEULE variable, `ROOM-JELLY excess` (la seule grandeur qui
                             ;; nomme le defaut) :
                             ;;   chestL accel  0.5510 -> 0.4348   chestL jerk  0.6055 -> 0.5510
                             ;;   chestL leftright 0.0543 -> 0.5061   chestL tilt 0.1743 -> 0.3342
                             ;;   chestR accel  0.1261 -> 0.1225   chestR jerk  0.3258 -> 0.4023
                             ;; Mieux sur les deux pilotages brusques a gauche, PIRE ailleurs et
                             ;; pire sur `jerk` a droite. Ce n'est pas une correction, c'est un
                             ;; deplacement. `flesh-jelly` reste OUVERT et cette barriere n'a pas
                             ;; le droit d'etre citee comme sa reponse.
                             ;;
                             ;; CE QU'ELLE FAIT VRAIMENT, et c'est pour ca qu'elle est gardee :
                             ;;   impacts du mur dur (`raddrop`), les dix chaines a un os :
                             ;;     chestL 18894->5099  chestR 15434->4365  kneeflapL 20061->5665
                             ;;     pantflapL 19011->5120  toestrapR 24918->7572  anklestrapR 24039->5572
                             ;;     soit -69 % a -77 % partout ;
                             ;;   traversees d'axe (`ROOM-SIDE`) : 13344 -> 11446, -14 % ;
                             ;;   lignes de mesure a penetration positive : 2 -> 1 sur 3410.
                             ;; PRIX, mesure et non estime : amplitude de pointe -0.4 % a -4.9 %
                             ;; (pire cas pantflapR), et affaissement gravitaire INCHANGE —
                             ;; `ROOM-GRAVSAG` chestL 0.0725 contre 0.0725, chestR 0.1039 contre
                             ;; 0.1022. L'acquis que l'owner a nomme (« quand elle se penche :
                             ;; nickel ») n'est donc pas touche, et aucune chaine n'approche son
                             ;; plancher.
                             ;;
                             ;; LE DIAGNOSTIC QUI RESTE OUVERT, pour que le prochain cycle ne le
                             ;; redecouvre pas : sous pilotage, l'ecart demande par la force du
                             ;; repere vaut ~11 950 u (gain statique 1/k2 = 62.9 x une force de
                             ;; 190 u/frame^2) pour un budget d'excursion de 656. Le systeme est
                             ;; sature d'un facteur 18, donc la position ecrite ne depend plus de
                             ;; l'AMPLITUDE de la force mais seulement de sa DIRECTION — et sous
                             ;; un a-coup cette direction change de signe d'une frame a l'autre.
                             ;; Adoucir le mur ne change rien a ca : il faut soit desaturer (donc
                             ;; toucher raideur/couplage, c'est-a-dire l'amplitude que l'owner a
                             ;; approuvee), soit sous-echantillonner le pas. Les deux se decident
                             ;; devant son oeil, pas ici.
                             ;;
                             ;; Owner, 11e passe : « lors de mouvements brusques il y a un effet
                             ;; d'etirement et un peu gelee ou ca change de taille, c'est PAS
                             ;; COHERENT ! » ; 21:20 : « c'est pas des ballons durs non plus, c'est
                             ;; naturel que ca change un peu de forme... c'est juste beaucoup trop ».
                             ;;
                             ;; CE QUE LA COURSE DU 2026-08-12 MESURE, et c'est sans ambiguite :
                             ;;   `tiprot` chestL = 39.2376 / 39.2525 / 39.2890 / 39.2449 degres
                             ;;   sous updown / leftright / accel / jerk — LA MEME VALEUR A TROIS
                             ;;   DECIMALES sous une translation, une acceleration et un a-coup de
                             ;;   39 g. C'est la signature d'un plafond EPINGLE, pas d'une reponse.
                             ;;   Elle se recalcule a la main : le mur borne |p - T| par `rmax` =
                             ;;   656 u sur un os de 977 u, soit 2*asin(656/1954) = 39.24 degres.
                             ;;   `raddrop` = 18 894 declenchements sur chestL, 15 434 sur chestR.
                             ;;
                             ;; POURQUOI CA FAIT DE LA GELEE. Le gain statique de l'integrateur vaut
                             ;; 1/k2 = 1/0.0159 = 62.9 : sous le pilotage `accel` la force du repere
                             ;; (couple 1.55 x 122.9 u/frame^2) demande un ecart de ~11 950 u pour
                             ;; un budget de 656. Le systeme est donc SATURE en permanence, la
                             ;; position ecrite ne depend plus de l'AMPLITUDE de la force mais
                             ;; seulement de sa DIRECTION — et sous un a-coup cette direction change
                             ;; de signe d'une frame a l'autre. Mesure : `jump` = 0.1604 m sur une
                             ;; seule frame, soit 657 u, c'est-a-dire exactement le plafond traverse
                             ;; de part en part. Un plafond dur a une derivee discontinue ; « ca
                             ;; change de taille et ce n'est correle a rien » en est la definition.
                             ;;
                             ;; LA FORME POSEE ICI est une raideur qui MONTE quand on approche du
                             ;; plafond, au lieu d'un mur qu'on percute :
                             ;;      k_eff = k2 / (1 - (|o|/cap)^6)     plafonnee a 1.0
                             ;; C'est une FORCE, dans l'integrateur, appelee UNE FOIS par frame :
                             ;; le piege d'idempotence de `phys-softmin` ne s'y applique pas, et le
                             ;; mur reste en place derriere elle comme garantie (`raddrop` dit s'il
                             ;; sert encore).
                             ;; L'EXPOSANT 6 N'EST PAS UN REGLAGE, c'est ce qui protege les deux
                             ;; acquis que l'owner a valides :
                             ;;   |o| = 0.50 cap -> k_eff = 1.016 k2  (mouvement subtil : intact)
                             ;;   |o| = 0.58 cap -> k_eff = 1.038 k2  (c'est l'equilibre gravitaire
                             ;;                    mesure : 379 u pour un cap de 656 — le « bon sag »
                             ;;                    perd 0.5 %, pas 33 % comme le ferait un exposant 2)
                             ;;   |o| = 0.95 cap -> k_eff = 3.77 k2   (la butee se sent enfin venir)
                             ;;   |o| -> cap     -> k_eff -> plafond  (on n'y arrive plus jamais)
                             ;; STABILITE : le plafond de 1.0 est verifie, pas suppose. Le polynome
                             ;; caracteristique du schema est z^2 - (2 - dmp - k)z + (1 - dmp) ; avec
                             ;; le plus petit amortissement des chaines concernees (0.26) et k = 1.0
                             ;; le discriminant est negatif et le module des racines vaut
                             ;; sqrt(1 - 0.26) = 0.86 < 1. La divergence n'apparait qu'au-dela de
                             ;; k = 3.3.
                             ;; PERIMETRE : exactement celui du mur — le maillon 0 d'une chaine sans
                             ;; `rootlock`. Un maillon qui n'a pas de mur n'a pas de barriere, sinon
                             ;; ce serait un suppresseur de plus et non le remplacement d'un existant.
                             ;; --------------------------------------------------------------
                             (let* ((ox (-> *phys-ox* scl))
                                    (oy (-> *phys-oy* scl))
                                    (oz (-> *phys-oz* scl))
                                    (bcap (if (= l 0) (-> *phys-rad* scl) 0.0))
                                    (kb (if (> bcap 0.01)
                                          (let* ((r2 (/ (+ (* ox ox) (+ (* oy oy) (* oz oz)))
                                                        (* bcap bcap)))
                                                 (r6 (fmin 0.98 (* r2 (* r2 r2)))))
                                            (fmin 1.0 (/ k2 (- 1.0 r6))))
                                          k2))
                                    (vx (* (- ox (-> *phys-o1x* scl)) (- 1.0 dmp)))
                                    (vy (* (- oy (-> *phys-o1y* scl)) (- 1.0 dmp)))
                                    (vz (* (- oz (-> *phys-o1z* scl)) (- 1.0 dmp)))
                                    (ax (+ (* (- 0.0 kb) ox) (-> fl x) (* gsc (-> gl x))))
                                    (ay (+ (* (- 0.0 kb) oy) (-> fl y) (* gsc (-> gl y))))
                                    (az (+ (* (- 0.0 kb) oz) (-> fl z) (* gsc (-> gl z)))))
                               (set! (-> *phys-o1x* scl) ox)
                               (set! (-> *phys-o1y* scl) oy)
                               (set! (-> *phys-o1z* scl) oz)
                               (set! (-> *phys-ox* scl) (+ ox vx ax))
                               (set! (-> *phys-oy* scl) (+ oy vy ay))
                               (set! (-> *phys-oz* scl) (+ oz vz az)))
                             ;; position MONDE = pose d'auteur + ecart, remis dans le monde
                             (set-vector! ov (-> *phys-ox* scl) (-> *phys-oy* scl) (-> *phys-oz* scl) 0.0)
                             (vector-rotate*! ov ov am)
                             (set! (-> *phys-px* scl) (+ (-> tw x) (-> ov x)))
                             (set! (-> *phys-py* scl) (+ (-> tw y) (-> ov y)))
                             (set! (-> *phys-pz* scl) (+ (-> tw z) (-> ov z))))))))

                    ;; ---- 2. LES CONTRAINTES. Gauss-Seidel : longueur puis collision, puis des
                    ;; ---- balayages de collision seuls pour finir — la collision est la contrainte
                    ;; ---- dure de la SPEC 3, c'est donc elle qui doit etre exacte a la fin.
                    (dotimes (it 8)
                      (phys-length-chain skel sc n rlk an nbone)
                      (phys-collide-chain skel sc n rlk nbone nco PHYS-COL-MARGIN 3))
                    ;; L'ATTENUATION D'ANGLE DES CHEVEUX, UNE SEULE FOIS (cf. phys-bend-chain et la
                    ;; note d'idempotence de phys-softmin). Elle se pose ICI, pas apres la finition :
                    ;; la sequence doit toujours se terminer sur (collision, recul) pour que « rien
                    ;; ne traverse » soit vrai a la derniere operation de la frame.
                    (phys-bend-chain skel sc n rlk an nbone)
                    ;; FINITION, trois tours de (collision + recul), puis UN DERNIER passage de
                    ;; longueur : c'est lui qui a le dernier mot sur le cote et sur la longueur, et
                    ;; c'est la forme du resultat que l'owner voit. Les trois se tiennent :
                    ;;  * la poussee de collision est radiale a un volume, elle ne change pas le
                    ;;    cote par rapport a l'ATTACHE ;
                    ;;  * le recul va vers la pose du modele, qui est du BON cote par construction ;
                    ;;  * le passage de longueur final ne fait que tourner autour de l'attache, donc
                    ;;    il ne peut pas creer de penetration a l'echelle du residu mesure ensuite.
                    ;; La longueur entre DANS la boucle de finition, mais la sequence se termine
                    ;; toujours sur (collision, recul) : le recul va vers la pose du modele, qui est
                    ;; admissible par construction, donc la derniere operation de la frame garantit
                    ;; « rien ne traverse » (regle 6 de l'owner, non negociable). Terminer par la
                    ;; longueur a fait remonter la penetration a +0.07 m sur rbang et +0.06 m sur
                    ;; les lunettes (mesure du 2026-08-11) : une rotation apres coup peut reposer le
                    ;; lien dans un volume dont il venait de sortir.
                    (dotimes (it 3)
                      (phys-length-chain skel sc n rlk an nbone)
                      (phys-collide-chain skel sc n rlk nbone nco PHYS-COL-MARGIN 3)
                      (let ((r0 *phys-retreat-n*))
                        (phys-retreat-chain skel sc n rlk nbone nco)
                        (when (> *phys-retreat-n* r0)
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 1))
                                (+ (the float (- *phys-retreat-n* r0))
                                   (-> *phys-dg* (+ (* sc PHYS-DG) 1)))))))
                    ;; combien de paires (lien, volume) ont bascule d'etat de contrainte depuis la
                    ;; frame precedente : la mesure du defaut « jitter » lui-meme.
                    (phys-flip-count skel sc n rlk nbone nco)

                    ;; ---- 3bis. CONTROLE POSITIF DES INVERSIONS. Arme, chaque lien libre est
                    ;; ---- MIROITE a travers son attache : c'est exactement le defaut que l'owner a
                    ;; ---- vu deux fois. Le compteur d'inversions doit alors monter — la correction
                    ;; ---- s'applique a la frame suivante, quand la contrainte revoit le cote.
                    (when (nonzero? *phys-inv-inject*)
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let ((scl (+ (* sc PHYS-LINKS) l)))
                            (set! (-> *phys-px* scl) (- (* 2.0 (-> anc x)) (-> *phys-px* scl)))
                            (set! (-> *phys-py* scl) (- (* 2.0 (-> anc y)) (-> *phys-py* scl)))
                            (set! (-> *phys-pz* scl) (- (* 2.0 (-> anc z)) (-> *phys-pz* scl)))))))

                    ;; ---- 3. INJECTION DE DEFAUT (controle positif). Desarmee = 0.0. ----
                    (when (> *phys-inject* 0.01)
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (dx (- (-> anc x) (-> *phys-px* scl)))
                                 (dy (- (-> anc y) (-> *phys-py* scl)))
                                 (dz (- (-> anc z) (-> *phys-pz* scl)))
                                 (d  (sqrtf (+ (* dx dx) (* dy dy) (* dz dz)))))
                            (when (> d 0.01)
                              (let ((s (/ *phys-inject* d)))
                                (set! *phys-injn* (+ *phys-injn* 1))
                                (set! (-> *phys-px* scl) (+ (-> *phys-px* scl) (* dx s)))
                                (set! (-> *phys-py* scl) (+ (-> *phys-py* scl) (* dy s)))
                                (set! (-> *phys-pz* scl) (+ (-> *phys-pz* scl) (* dz s)))))))))

                    ;; ---- 4. LES CONTRAINTES ONT BOUGE LA POSITION : on remet cet effet dans
                    ;; ---- l'ecart, sinon la frame suivante repartirait d'un etat que rien ne
                    ;; ---- soutient (et la vitesse verlet perdrait la perte d'energie du choc).
                    (dotimes (l n)
                      (when (>= l rlk)
                        (let* ((scl (+ (* sc PHYS-LINKS) l))
                               (k   (-> *phys-joint* scl)))
                          (when (and (>= k 0) (< (+ k 1) nbone))
                            (set-vector! ov
                              (- (-> *phys-px* scl) (-> skel bones (+ k 1) transform vector 3 x))
                              (- (-> *phys-py* scl) (-> skel bones (+ k 1) transform vector 3 y))
                              (- (-> *phys-pz* scl) (-> skel bones (+ k 1) transform vector 3 z))
                              0.0)
                            (vector-rotate*! ov ov w2l)
                            (set! (-> *phys-ox* scl) (-> ov x))
                            (set! (-> *phys-oy* scl) (-> ov y))
                            (set! (-> *phys-oz* scl) (-> ov z))))))

                    ;; ---- 4bis. CONTROLE POSITIF DU CANAL D'AUTEUR. Arme, la position ecrite est
                    ;; ---- batie sur la pose d'auteur de la frame PRECEDENTE : l'animation est
                    ;; ---- retardee d'une frame, ce que la SPEC 5 interdit. Applique APRES le
                    ;; ---- report dans l'ecart, sinon l'ecart absorberait le defaut et le compteur
                    ;; ---- d'identite ne verrait rien — c'est le piege qui rendrait le controle
                    ;; ---- muet.
                    (when (nonzero? *phys-auth-lag*)
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (k   (-> *phys-joint* scl)))
                            (when (and (>= k 0) (< (+ k 1) nbone))
                              ;; t2 porte la pose d'auteur de la frame PRECEDENTE : le bloc
                              ;; d'integration vient d'y decaler l'ancienne valeur de t1.
                              (set! (-> *phys-px* scl)
                                    (+ (-> *phys-px* scl)
                                       (- (-> *phys-t2x* scl) (-> skel bones (+ k 1) transform vector 3 x))))
                              (set! (-> *phys-py* scl)
                                    (+ (-> *phys-py* scl)
                                       (- (-> *phys-t2y* scl) (-> skel bones (+ k 1) transform vector 3 y))))
                              (set! (-> *phys-pz* scl)
                                    (+ (-> *phys-pz* scl)
                                       (- (-> *phys-t2z* scl) (-> skel bones (+ k 1) transform vector 3 z)))))))))

                    ;; ------------------------------------------------------------------------
                    ;; 5. MESURE (SPEC 7). ELLE SE FAIT ICI, AVANT L'ECRITURE, et c'est structurel :
                    ;; une fois le squelette ecrit, `skel bones` porte la pose SIMULEE et la pose
                    ;; d'auteur a disparu. Ce qui est compare : *phys-p** = la pose COMMITEE (elle
                    ;; sera ecrite telle quelle au bloc suivant), `skel bones` = le RETARGET.
                    ;; ------------------------------------------------------------------------
                    (let ((stb (* sc PHYS-ST)))
                      ;; --- LE GRADIENT : la boite englobante de l'ecart POUR CHAQUE MAILLON.
                      ;; Un maillon rootlock a un ecart identiquement nul et mesure donc zero, ce
                      ;; qui est exactement ce que SPEC 2 demande de la racine.
                      (dotimes (l n)
                        (let* ((scl (+ (* sc PHYS-LINKS) l))
                               (lb  (* scl PHYS-LB))
                               (ox  (-> *phys-ox* scl))
                               (oy  (-> *phys-oy* scl))
                               (oz  (-> *phys-oz* scl)))
                          (when (< ox (-> *phys-lb* (+ lb 0))) (set! (-> *phys-lb* (+ lb 0)) ox))
                          (when (> ox (-> *phys-lb* (+ lb 1))) (set! (-> *phys-lb* (+ lb 1)) ox))
                          (when (< oy (-> *phys-lb* (+ lb 2))) (set! (-> *phys-lb* (+ lb 2)) oy))
                          (when (> oy (-> *phys-lb* (+ lb 3))) (set! (-> *phys-lb* (+ lb 3)) oy))
                          (when (< oz (-> *phys-lb* (+ lb 4))) (set! (-> *phys-lb* (+ lb 4)) oz))
                          (when (> oz (-> *phys-lb* (+ lb 5))) (set! (-> *phys-lb* (+ lb 5)) oz))))
                      ;; --- ecart a la pose du modele, par lien libre (SPEC 4, lu au repos) ---
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (k   (-> *phys-joint* scl)))
                            (when (and (>= k 0) (< (+ k 1) nbone))
                              (set! (-> pt x) (-> *phys-px* scl))
                              (set! (-> pt y) (-> *phys-py* scl))
                              (set! (-> pt z) (-> *phys-pz* scl))
                              (set! (-> pt w) 1.0)
                              (let ((dv (vector-vector-distance
                                          pt (the-as vector (-> skel bones (+ k 1) transform vector 3)))))
                                (when (> dv (-> *phys-st* (+ stb 5)))
                                  (set! (-> *phys-st* (+ stb 5)) dv)))))))
                      ;; --- residu SIGNE de penetration (SPEC 3). > 0 = ca traverse, <= 0 = la
                      ;; --- marge qui reste avant de traverser. Le maximum de la fenetre part donc
                      ;; --- de -1e9 (voir phys-stats-reset!) et non de zero : un maximum plafonne a
                      ;; --- zero aurait rendu la colonne constante et donc inverifiable.
                      (let ((pen (phys-pen-chain skel sc n rlk nbone nco)))
                        (when (> pen PHYS-NOCONTACT-LIMIT)
                          ;; frame ou au moins une paire (lien, volume) etait en contact : c'est la
                          ;; seule sorte de frame ou « penetration nulle » veut dire quelque chose.
                          (set! (-> *phys-conf* sc) (+ 1.0 (-> *phys-conf* sc)))
                          (when (> pen (-> *phys-st* (+ stb 4)))
                            (set! (-> *phys-st* (+ stb 4)) pen))))
                      ;; --- ancrage de la racine (SPEC 2). Deux residus, on garde le pire :
                      ;;      a) de combien la RACINE ecrite s'ecarte de la racine du modele
                      ;;         (identiquement nul sur un lien rootlock : il n'est pas ecrit) ;
                      ;;      b) de combien le PREMIER LIEN LIBRE s'ecarte de la longueur que le
                      ;;         modele donne a son os — son attache est l'ancre quand il est seul.
                      (let ((rd 0.0))
                        (let ((k0 (-> *phys-joint* (* sc PHYS-LINKS))))
                          (when (and (>= k0 0) (< (+ k0 1) nbone))
                            (set! (-> pt x) (-> *phys-px* (* sc PHYS-LINKS)))
                            (set! (-> pt y) (-> *phys-py* (* sc PHYS-LINKS)))
                            (set! (-> pt z) (-> *phys-pz* (* sc PHYS-LINKS)))
                            (set! (-> pt w) 1.0)
                            (set! rd (vector-vector-distance
                                       pt (the-as vector (-> skel bones (+ k0 1) transform vector 3))))))
                        (let* ((l0   rlk)
                               (scl  (+ (* sc PHYS-LINKS) l0))
                               (kk   (-> *phys-joint* scl))
                               (kp   (if (> l0 0) (-> *phys-joint* (- scl 1)) an)))
                          (when (and (< l0 n) (>= kk 0) (>= kp 0)
                                     (< (+ kk 1) nbone) (< (+ kp 1) nbone))
                            (let* ((want (vector-vector-distance
                                           (the-as vector (-> skel bones (+ kk 1) transform vector 3))
                                           (the-as vector (-> skel bones (+ kp 1) transform vector 3))))
                                   (bx (if (> l0 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                                   (by (if (> l0 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                                   (bz (if (> l0 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                                   (dx (- (-> *phys-px* scl) bx))
                                   (dy (- (-> *phys-py* scl) by))
                                   (dz (- (-> *phys-pz* scl) bz))
                                   (got (sqrtf (+ (* dx dx) (* dy dy) (* dz dz))))
                                   (res (fabs (- got want))))
                              (when (> res rd) (set! rd res)))))
                        (when (> rd (-> *phys-st* (+ stb 3)))
                          (set! (-> *phys-st* (+ stb 3)) rd)))
                      ;; --- ALLONGEMENT RELATIF et INVERSION RESIDUELLE, sur la position ECRITE et
                      ;; --- APRES tout le solveur. Ce sont les deux nombres que la 5e et la 2e/3e/4e
                      ;; --- passe de l'owner exigent : « ils s'allongent, c'est un peu debile » et
                      ;; --- « un de ses seins retourne vers l'interieur ». Meme attache, meme
                      ;; --- direction de modele que la contrainte : l'instrument de mesure est
                      ;; --- l'instrument de decision.
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (kk  (-> *phys-joint* scl))
                                 (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
                            (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
                              (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                                     (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                                     (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                                     (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                                            (-> skel bones (+ kp 1) transform vector 3 x)))
                                     (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                                            (-> skel bones (+ kp 1) transform vector 3 y)))
                                     (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                                            (-> skel bones (+ kp 1) transform vector 3 z)))
                                     (ux (- (-> *phys-px* scl) bx))
                                     (uy (- (-> *phys-py* scl) by))
                                     (uz (- (-> *phys-pz* scl) bz))
                                     (m2 (+ (* mx mx) (+ (* my my) (* mz mz))))
                                     (u2 (+ (* ux ux) (+ (* uy uy) (* uz uz))))
                                     (dot (+ (* ux mx) (+ (* uy my) (* uz mz)))))
                                (when (> m2 0.0001)
                                  ;; LA DEFORMATION QUE LA CHAIR SUBIT, et ce n'est ni tipvar ni
                                  ;; elong. Owner, 11e passe : « ca change de taille, plus petit,
                                  ;; plus gros, plus long, plus court, ecrase ». Le skinning est
                                  ;; LINEAIRE : deux sommets voisins dont les poids sur ce joint
                                  ;; different de w se separent de w x |p - T|. Rapporte a la
                                  ;; longueur de l'os — la distance sur laquelle les poids passent
                                  ;; de 1 a 0 — ce quotient EST l'echelle de la deformation locale.
                                  ;; `elong` ne peut pas la voir : elle mesure la longueur de l'OS,
                                  ;; qui est justement invariante par construction, et `tipvar` est
                                  ;; une variance, pas une forme.
                                  (let* ((wx (- (-> *phys-px* scl)
                                                (-> skel bones (+ kk 1) transform vector 3 x)))
                                         (wy (- (-> *phys-py* scl)
                                                (-> skel bones (+ kk 1) transform vector 3 y)))
                                         (wz (- (-> *phys-pz* scl)
                                                (-> skel bones (+ kk 1) transform vector 3 z)))
                                         (sh (/ (sqrtf (+ (* wx wx) (+ (* wy wy) (* wz wz))))
                                                (sqrtf m2))))
                                    (when (> sh (-> *phys-dg* (+ (* sc PHYS-DG) 8)))
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 8)) sh)))
                                  (let ((el (fabs (- (/ (sqrtf u2) (sqrtf m2)) 1.0))))
                                    (when (> el (-> *phys-dg* (+ (* sc PHYS-DG) 5)))
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 5)) el))
                                    ;; LE MEME ALLONGEMENT, MAIS PAR FENETRE : « ils s'allongent sur
                                    ;; les mouvements BRUSQUES » est une phrase sur un PILOTAGE, et
                                    ;; le compteur par course ne peut pas la verifier.
                                    (when (> el (-> *phys-st* (+ stb 17)))
                                      (set! (-> *phys-st* (+ stb 17)) el)))
                                  ;; LE MOUVEMENT PROPRE DU MAILLON : l'angle entre sa direction
                                  ;; courante et la direction que le MODELE donne au meme os, tous
                                  ;; deux mesures depuis LA MEME ATTACHE. Un maillon qui suit
                                  ;; rigidement son parent vaut zero ici quelle que soit l'agitation
                                  ;; du parent — c'est ce que la boite englobante ne pouvait pas
                                  ;; voir, et c'est la suite que SPEC 2 exige croissante.
                                  (when (> u2 0.0001)
                                    (let* ((cx (- (* uy mz) (* uz my)))
                                           (cy (- (* uz mx) (* ux mz)))
                                           (cz (- (* ux my) (* uy mx)))
                                           (sn (sqrtf (+ (* cx cx) (+ (* cy cy) (* cz cz)))))
                                           ;; 360 / 65536 : `atan` rend des unites de rotation, on
                                           ;; publie des degres.
                                           (ang (* 0.0054931641 (atan sn dot))))
                                      (when (> ang (-> *phys-la* scl))
                                        (set! (-> *phys-la* scl) ang))))
                                  ;; L'INSTRUMENT DE MESURE EST L'INSTRUMENT DE DECISION : le
                                  ;; solveur ne corrige le cote QUE sur le PREMIER LIEN LIBRE, celui
                                  ;; dont l'attache est rigide, donc la mesure ne le compte que la.
                                  ;; Compter les liens profonds donnait 24 117 « inversions
                                  ;; residuelles » que rien ne corrigeait et que rien n'avait
                                  ;; demande de corriger — un chiffre sans decision derriere.
                                  ;; Le predicat suit celui du solveur (`l = rlk`, corrige le
                                  ;; 2026-08-12) : sur les chaines rootlockees `l = 0` n'etait
                                  ;; jamais visite, donc les deux lisaient zero par construction.
                                  (when (and (= l rlk) (< dot 0.0)
                                             (> (* dot dot) (* PHYS-SIDE-COS2 (* u2 m2))))
                                    (set! *phys-invres* (+ *phys-invres* 1))
                                    (set! (-> *phys-dg* (+ (* sc PHYS-DG) 4))
                                          (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 4)))))))))))
                      ;; --- la pointe : amplitude de l'ecart (physique seule) et intention
                      ;; --- d'auteur sur CETTE chaine, la meme frame (SPEC 5).
                      (let* ((sclt (+ (* sc PHYS-LINKS) (- n 1)))
                             (kt   (-> *phys-joint* sclt)))
                        (when (and (>= kt 0) (< (+ kt 1) nbone))
                          (let ((ox (-> *phys-ox* sclt))
                                (oy (-> *phys-oy* sclt))
                                (oz (-> *phys-oz* sclt)))
                            ;; pointe d'AUTEUR dans le repere de l'ancre (transformation de POINT :
                            ;; w = 1, la translation compte)
                            (set-vector! uv (-> skel bones (+ kt 1) transform vector 3 x)
                                            (-> skel bones (+ kt 1) transform vector 3 y)
                                            (-> skel bones (+ kt 1) transform vector 3 z)
                                            1.0)
                            (vector-matrix*! uv uv w2l)
                            ;; boite englobante de l'ecart de pointe
                            (when (< ox (-> *phys-st* (+ stb 6)))  (set! (-> *phys-st* (+ stb 6)) ox))
                            (when (> ox (-> *phys-st* (+ stb 7)))  (set! (-> *phys-st* (+ stb 7)) ox))
                            (when (< oy (-> *phys-st* (+ stb 8)))  (set! (-> *phys-st* (+ stb 8)) oy))
                            (when (> oy (-> *phys-st* (+ stb 9)))  (set! (-> *phys-st* (+ stb 9)) oy))
                            (when (< oz (-> *phys-st* (+ stb 10))) (set! (-> *phys-st* (+ stb 10)) oz))
                            (when (> oz (-> *phys-st* (+ stb 11))) (set! (-> *phys-st* (+ stb 11)) oz))
                            ;; POSITION MOYENNE de la pointe dans le repere de l'ancre. La boite
                            ;; ci-dessus ne retient que la VARIANCE : sous une inclinaison TENUE la
                            ;; chaine se pose sur un nouvel equilibre et ne bouge plus, donc la
                            ;; boite y mesure zero et l'a toujours mesure (PHYSTILT amp=0.0000 sur
                            ;; 19 chaines sur 22). La gravite ne se lit que dans le DEPLACEMENT
                            ;; SOUTENU, c'est-a-dire ici.
                            (set! (-> *phys-st* (+ stb 12)) (+ ox (-> *phys-st* (+ stb 12))))
                            (set! (-> *phys-st* (+ stb 13)) (+ oy (-> *phys-st* (+ stb 13))))
                            (set! (-> *phys-st* (+ stb 14)) (+ oz (-> *phys-st* (+ stb 14))))
                            (set! (-> *phys-st* (+ stb 15)) (+ 1.0 (-> *phys-st* (+ stb 15))))
                            ;; L'IDENTITE DU CANAL D'AUTEUR, EN REPERE MONDE. `sv` recoit le
                            ;; deplacement ecrit-moins-auteur, `uv` l'ecart simule remis dans le
                            ;; monde ; leur difference doit etre nulle. Mesure EN MONDE et non en
                            ;; repere d'ancre parce que le sujet vit a ~1e5 unites de l'origine :
                            ;; la transformation de point y soustrait deux grandeurs de 1e6 pour en
                            ;; rendre une de 1e2, et la seule annulation catastrophique du flottant
                            ;; 32 bits y vaut 0.06 unite — au-dessus de la tolerance, donc un
                            ;; compteur qui echouait sur 40 % des frames sans qu'aucun defaut
                            ;; n'existe (mesure du 2026-08-11). En monde, les deux membres valent
                            ;; ~1e2 et le bruit tombe a 1e-5.
                            (set-vector! sv
                              (- (-> *phys-px* sclt) (-> skel bones (+ kt 1) transform vector 3 x))
                              (- (-> *phys-py* sclt) (-> skel bones (+ kt 1) transform vector 3 y))
                              (- (-> *phys-pz* sclt) (-> skel bones (+ kt 1) transform vector 3 z))
                              0.0)
                            (set-vector! uv2 ox oy oz 0.0)
                            (vector-rotate*! uv2 uv2 am)
                            (when (nonzero? (-> *phys-thas* sc))
                              (let* ((cdx (- ox (-> *phys-tx* sc)))
                                     (cdy (- oy (-> *phys-ty* sc)))
                                     (cdz (- oz (-> *phys-tz* sc)))
                                     (d   (sqrtf (+ (* cdx cdx) (* cdy cdy) (* cdz cdz)))))
                                (set! (-> *phys-st* (+ stb 0)) (+ 1.0 (-> *phys-st* (+ stb 0))))
                                (set! (-> *phys-st* (+ stb 1)) (+ d (-> *phys-st* (+ stb 1))))
                                (when (> d (-> *phys-st* (+ stb 2))) (set! (-> *phys-st* (+ stb 2)) d))
                                (when (nonzero? (-> *phys-rhas* sc))
                                  (let* ((adx (- (-> uv x) (-> *phys-rtx* sc)))
                                         (ady (- (-> uv y) (-> *phys-rty* sc)))
                                         (adz (- (-> uv z) (-> *phys-rtz* sc)))
                                         (am2 (+ (* adx adx) (* ady ady) (* adz adz)))
                                         (amg (sqrtf am2)))
                                    (when (> amg PHYS-AUTH-EPS)
                                      ;; L'ANIMATION EST-ELLE PASSEE INTACTE ? La position ecrite
                                      ;; doit valoir la pose d'AUTEUR + l'ecart simule, sans que le
                                      ;; second n'ampute le premier : dans le repere de l'ancre cela
                                      ;; s'ecrit s == u + o, et l'ecart mesure ici est
                                      ;; |s - u - o|. Il vaut zero quand l'animation traverse a
                                      ;; coefficient 1 et NE PEUT PAS valoir zero si quoi que ce
                                      ;; soit la met a l'echelle, la mixe ou la retarde — c'est ce
                                      ;; que le controle positif (*phys-auth-lag*) verifie en
                                      ;; retardant l'animation d'une frame.
                                      (let* ((ex (- (-> sv x) (-> uv2 x)))
                                             (ey (- (-> sv y) (-> uv2 y)))
                                             (ez (- (-> sv z) (-> uv2 z)))
                                             (er (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez)))))
                                             (sdx (+ adx cdx)) (sdy (+ ady cdy)) (sdz (+ adz cdz)))
                                        (set! (-> *phys-ahit* sc) (+ 1.0 (-> *phys-ahit* sc)))
                                        (when (<= er PHYS-AUTH-TOL)
                                          (set! (-> *phys-aok* sc) (+ 1.0 (-> *phys-aok* sc))))
                                        ;; publies mais NON gates : la correlation du deplacement
                                        ;; ecrit avec celui d'auteur, et les deux amplitudes qui
                                        ;; disent pourquoi cette correlation est bruitee des que le
                                        ;; pilotage domine l'animation.
                                        (set! (-> *phys-adot* sc)
                                              (+ (-> *phys-adot* sc)
                                                 (+ (* sdx adx) (+ (* sdy ady) (* sdz adz)))))
                                        (set! (-> *phys-anrm* sc) (+ (-> *phys-anrm* sc) am2))
                                        (set! (-> *phys-dsum* sc) (+ (-> *phys-dsum* sc) d))
                                        (set! (-> *phys-usum* sc) (+ (-> *phys-usum* sc) amg))))))))
                            (set! (-> *phys-tx* sc) ox)
                            (set! (-> *phys-ty* sc) oy)
                            (set! (-> *phys-tz* sc) oz)
                            (set! (-> *phys-thas* sc) 1)
                            (set! (-> *phys-rtx* sc) (-> uv x))
                            (set! (-> *phys-rty* sc) (-> uv y))
                            (set! (-> *phys-rtz* sc) (-> uv z))
                            (set! (-> *phys-rhas* sc) 1)))))

                    ;; ---- 6. ECRITURE DANS LE SQUELETTE (SPEC 7 : c'est ca qui fait foi) ----
                    (dotimes (l n)
                      (when (>= l rlk)
                        (let* ((scl (+ (* sc PHYS-LINKS) l))
                               (k   (-> *phys-joint* scl)))
                          (when (and (>= k 0) (< (+ k 1) nbone))
                            (let ((bm (the-as matrix (-> skel bones (+ k 1) transform))))
                              (matrix-copy! pre bm)
                              ;; ------------------------------------------------------------
                              ;; ORIENTATION. « Sans ca la chaine se translate sans tourner et le
                              ;; SKINNING CISAILLE » — la phrase etait deja la, et elle designait
                              ;; un defaut qui n'etait traite qu'a MOITIE.
                              ;;
                              ;; Le bloc ne tournait le lien que s'il avait un ENFANT SIMULE a
                              ;; viser : `(when (< (+ l 1) n))`. Le DERNIER maillon de chaque
                              ;; chaine n'en a pas, donc il ne recevait qu'une translation, sa
                              ;; matrice 3x3 restant celle de la pose d'auteur. Or `chestL` et
                              ;; `chestR` sont des chaines a UN SEUL maillon : leur unique maillon
                              ;; EST le dernier, donc le sein n'a JAMAIS tourne — il GLISSAIT, avec
                              ;; son orientation figee, jusqu'a 656 unites (16 cm) de cote.
                              ;;
                              ;; C'est mot pour mot ce que l'owner decrit (11e passe) : « lors de
                              ;; mouvements brusques il y a un effet d'etirement et un peu gelee ou
                              ;; ca change de taille — plus petit, plus gros, plus long, plus court,
                              ;; ECRASE ». Un os qui se deplace sans tourner cisaille sa peau
                              ;; exactement de la rotation qu'il n'a pas appliquee : les sommets
                              ;; ponderes sur lui suivent la translation, ceux ponderes sur le
                              ;; porteur ne bougent pas, et la chair entre les deux s'etire.
                              ;;
                              ;; Le dernier maillon vise donc SA PROPRE DIRECTION D'OS : de son
                              ;; attache vers lui, pose du modele -> position simulee. C'est la
                              ;; meme rotation que la contrainte de longueur lui fait deja subir
                              ;; (elle ne l'autorise qu'a tourner autour de son attache), donc on
                              ;; n'invente rien : on ECRIT enfin dans la matrice la rotation que le
                              ;; solveur avait deja decidee.
                              ;;
                              ;; CA NE COUTE AUCUNE AMPLITUDE : la position ecrite ne change pas
                              ;; d'un bit, seule la 3x3 change. Le plancher est donc invariant par
                              ;; construction, et ce n'est pas un pari — `tipvar` est calcule sur
                              ;; l'ecart AVANT ce bloc.
                              ;;
                              ;; La pose d'AUTEUR de l'attache doit venir de `*phys-t1*` et non du
                              ;; squelette : le maillon precedent a deja ete ECRASE par sa position
                              ;; simulee quelques lignes plus haut (la boucle ecrit dans l'ordre).
                              ;; Pour le maillon 0 l'attache est l'ANCRE, que cette chaine n'ecrit
                              ;; jamais, donc le squelette y porte encore la pose d'auteur.
                              ;; ------------------------------------------------------------
                              (let ((have #f))
                                (cond
                                  ((< (+ l 1) n)
                                   (let* ((sclc (+ (* sc PHYS-LINKS) (+ l 1)))
                                          (kc   (-> *phys-joint* sclc)))
                                     (when (and (>= kc 0) (< (+ kc 1) nbone))
                                       (vector-copy! tgt (the-as vector (-> skel bones (+ kc 1) transform vector 3)))
                                       (set! (-> rest x) (- (-> tgt x) (-> bm vector 3 x)))
                                       (set! (-> rest y) (- (-> tgt y) (-> bm vector 3 y)))
                                       (set! (-> rest z) (- (-> tgt z) (-> bm vector 3 z)))
                                       (set! (-> pt x) (- (-> *phys-px* sclc) (-> *phys-px* scl)))
                                       (set! (-> pt y) (- (-> *phys-py* sclc) (-> *phys-py* scl)))
                                       (set! (-> pt z) (- (-> *phys-pz* sclc) (-> *phys-pz* scl)))
                                       (set! have #t))))
                                  (else
                                   (let ((kp (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
                                     (when (and (>= kp 0) (< (+ kp 1) nbone))
                                       (let ((ax (if (> l 0) (-> *phys-t1x* (- scl 1))
                                                   (-> skel bones (+ kp 1) transform vector 3 x)))
                                             (ay (if (> l 0) (-> *phys-t1y* (- scl 1))
                                                   (-> skel bones (+ kp 1) transform vector 3 y)))
                                             (az (if (> l 0) (-> *phys-t1z* (- scl 1))
                                                   (-> skel bones (+ kp 1) transform vector 3 z)))
                                             (bx2 (if (> l 0) (-> *phys-px* (- scl 1))
                                                    (-> skel bones (+ kp 1) transform vector 3 x)))
                                             (by2 (if (> l 0) (-> *phys-py* (- scl 1))
                                                    (-> skel bones (+ kp 1) transform vector 3 y)))
                                             (bz2 (if (> l 0) (-> *phys-pz* (- scl 1))
                                                    (-> skel bones (+ kp 1) transform vector 3 z))))
                                         (set! (-> rest x) (- (-> bm vector 3 x) ax))
                                         (set! (-> rest y) (- (-> bm vector 3 y) ay))
                                         (set! (-> rest z) (- (-> bm vector 3 z) az))
                                         (set! (-> pt x) (- (-> *phys-px* scl) bx2))
                                         (set! (-> pt y) (- (-> *phys-py* scl) by2))
                                         (set! (-> pt z) (- (-> *phys-pz* scl) bz2))
                                         (set! have #t))))))
                                (when have
                                  (set! (-> rest w) 1.0)
                                  (set! (-> pt w) 1.0)
                                  (begin
                                    (let ((la (vector-length rest)) (lb (vector-length pt)))
                                      (when (and (> la 0.01) (> lb 0.01))
                                        (vector-float*! rest rest (/ 1.0 la))
                                        (vector-float*! pt pt (/ 1.0 lb))
                                        (vector-cross! nrm rest pt)
                                        (let ((sn (vector-length nrm))
                                              (cs (vector-dot rest pt)))
                                          (when (> sn 0.0001)
                                            (vector-float*! nrm nrm (/ 1.0 sn))
                                            ;; `atan` de GOAL rend des UNITES DE ROTATION (65536 =
                                            ;; un tour ; `cos` y est `(sin (+ 16384 x))`), pas des
                                            ;; radians — et `matrix-axis-angle!` en attend aussi,
                                            ;; puisqu'elle appelle `sin`/`cos`. La conversion
                                            ;; « x 57.2957795 » qui etait ici traitait la sortie
                                            ;; comme des radians : elle multipliait l'angle par 57,
                                            ;; et `sin` ne garde que les 16 bits bas, donc un
                                            ;; flechissement de 1 degre faisait tourner l'os de 57
                                            ;; degres et au-dela ca repliait modulo un tour. Toute
                                            ;; chaine qui flechissait ecrivait donc une orientation
                                            ;; fausse — c'est le « petits bugs de geometrie sur les
                                            ;; grosses meches » et le « polygone de la semelle de la
                                            ;; chaussure gauche qui se fait la malle » de la 3e
                                            ;; passe. La position, elle, etait juste : seule
                                            ;; l'orientation partait, donc rien dans les chiffres de
                                            ;; position ne pouvait le voir.
                                            ;; PREUVE D'EXECUTION du chemin neuf : l'angle
                                            ;; REELLEMENT ecrit dans la 3x3 du dernier maillon.
                                            ;; Avant ce cycle il valait structurellement zero.
                                            (when (>= (+ l 1) n)
                                              (let ((ad (* 0.0054931641 (atan sn cs))))
                                                (when (> ad (-> *phys-dg* (+ (* sc PHYS-DG) 10)))
                                                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 10)) ad))))
                                            (matrix-axis-angle! rot nrm (atan sn cs))
                                            (set! (-> bm vector 3 x) 0.0)
                                            (set! (-> bm vector 3 y) 0.0)
                                            (set! (-> bm vector 3 z) 0.0)
                                            (matrix*! tmp bm rot)
                                            (matrix-copy! bm tmp))))))))
                              ;; translation : la position simulee, telle quelle
                              (set! (-> bm vector 3 x) (-> *phys-px* scl))
                              (set! (-> bm vector 3 y) (-> *phys-py* scl))
                              (set! (-> bm vector 3 z) (-> *phys-pz* scl))
                              (set! (-> bm vector 3 w) 1.0)
                              ;; delta pour les descendants non simules
                              (when (< k PHYS-JOINTS)
                                (matrix-4x4-inverse! inv pre)
                                (matrix*! (-> *phys-dmat* k) inv bm)
                                (set! (-> *phys-dhas* k) 1)))))))
                    ))))))
          ;; ---- propagation aux descendants non simules (verres de lunettes, etc.) ----
          (dotimes (k njoint)
            (when (zero? (-> *phys-dhas* k))
              (let ((p (the int (-> (-> obj khd-par) k))))
                (when (and (!= p 255) (< p PHYS-JOINTS) (nonzero? (-> *phys-dhas* p))
                           (< (+ k 1) nbone))
                  (let ((bm (the-as matrix (-> skel bones (+ k 1) transform))))
                    (matrix*! tmp bm (-> *phys-dmat* p))
                    (matrix-copy! bm tmp)
                    (matrix-copy! (-> *phys-dmat* k) (-> *phys-dmat* p))
                    (set! (-> *phys-dhas* k) 1))))))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; les deux prises restantes attendues par le reste du jeu.
;; ------------------------------------------------------------------------------------------------
(defun phys-note-covered! ((n int)) (none))

;; process-drawable.gc:287 appelle ceci sur TOUT process-drawable — y compris les compagnons HD,
;; AVANT fill-jak-hd-bones! (jak-hd.gc:552-553). Le rider stock n'est pas dans le perimetre de
;; cette phase (KEIRA SEULE, via son compagnon HD) : il ne fait rien, et surtout pas sur un
;; compagnon dont la pose n'est pas encore retargetee.
(defun phys-rider-post! ((obj process-drawable)) (none))

;; ------------------------------------------------------------------------------------------------
;; ACCES POUR LA SALLE DE TEST (phys-room.gc). Les accumulateurs vivent ici parce que c'est ici que
;; la position ecrite est connue ; la salle ne fait que fenetrer et publier.
;; ------------------------------------------------------------------------------------------------
(defun phys-stats-reset! ()
  (dotimes (sc PHYS-SC)
    (let ((stb (* sc PHYS-ST)))
      (dotimes (i 6) (set! (-> *phys-st* (+ stb i)) 0.0))
      ;; somme et compte de la position moyenne de la pointe (12..15), pire stimulus recu (16),
      ;; pire allongement relatif (17), stimulus gravitaire (18) et sa part tangentielle (19).
      (dotimes (i 8) (set! (-> *phys-st* (+ stb (+ 12 i))) 0.0))
      ;; le residu signe de penetration est un maximum qui a le droit d'etre negatif
      (set! (-> *phys-st* (+ stb 4)) PHYS-NOCONTACT)
      ;; la boite englobante part vide : un min a 0 la forcerait a contenir l'origine et
      ;; gonflerait l'amplitude mesuree.
      (set! (-> *phys-st* (+ stb 6))   1000000000.0)
      (set! (-> *phys-st* (+ stb 7))  -1000000000.0)
      (set! (-> *phys-st* (+ stb 8))   1000000000.0)
      (set! (-> *phys-st* (+ stb 9))  -1000000000.0)
      (set! (-> *phys-st* (+ stb 10))  1000000000.0)
      (set! (-> *phys-st* (+ stb 11)) -1000000000.0))
    ;; la boite de CHAQUE maillon part vide, comme celle de la pointe.
    (dotimes (l PHYS-LINKS)
      (let ((lb (* (+ (* sc PHYS-LINKS) l) PHYS-LB)))
        (dotimes (i 3)
          (set! (-> *phys-lb* (+ lb (* 2 i)))        1000000000.0)
          (set! (-> *phys-lb* (+ lb (+ (* 2 i) 1))) -1000000000.0)))
      ;; la deviation angulaire propre de CHAQUE maillon part de zero : c'est un maximum, et un
      ;; maillon qui suit rigidement son parent doit pouvoir lire exactement zero.
      (set! (-> *phys-la* (+ (* sc PHYS-LINKS) l)) 0.0))
    (set! (-> *phys-thas* sc) 0))
  (none))

(defun phys-stat ((slot int) (chain int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= which 0) (< which PHYS-ST))
    (-> *phys-st* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-ST) which))
    0.0))

;; la colonne du tableau : le residu signe de la fenetre, ou 0 si aucune frame de la fenetre n'a eu
;; le moindre contact. Le nombre de frames en contact est publie a part (phys-auth which=7).
(defun phys-pen-col ((slot int) (chain int))
  (let ((v (phys-stat slot chain 4)))
    (if (< v PHYS-NOCONTACT-LIMIT) 0.0 v)))

;; AMPLITUDE de mouvement de la pointe due a la PHYSIQUE seule, sur la fenetre : la diagonale de la
;; boite englobante de l'ecart. Zero si la fenetre n'a pas de frame.
(defun phys-tip-amp ((slot int) (chain int))
  (if (< (phys-stat slot chain 0) 0.5)
    0.0
    (let ((dx (- (phys-stat slot chain 7) (phys-stat slot chain 6)))
          (dy (- (phys-stat slot chain 9) (phys-stat slot chain 8)))
          (dz (- (phys-stat slot chain 11) (phys-stat slot chain 10))))
      (if (or (< dx 0.0) (< dy 0.0) (< dz 0.0))
        0.0
        (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))))

;; POSITION MOYENNE de la pointe sur la fenetre, dans le repere de l'ancre, axe par axe (0=x 1=y
;; 2=z). C'est le DEPLACEMENT SOUTENU dont la salle fait ROOM-GRAVSAG : la difference entre la
;; moyenne debout et la moyenne penchee a 60 degres EST la reponse a la gravite. Zero si la fenetre
;; n'a pas de frame — jamais une valeur inventee.
(defun phys-tip-mean ((slot int) (chain int) (axis int))
  (let ((n (phys-stat slot chain 15)))
    (if (or (< n 0.5) (< axis 0) (> axis 2))
      0.0
      (/ (phys-stat slot chain (+ 12 axis)) n))))

;; LE STIMULUS QUE LA POINTE A REELLEMENT RECU sur la fenetre, en u/frame^2 : le pire module de
;; l'acceleration de sa pose d'auteur. C'est le denominateur honnete du gain — celui que la salle
;; COMMANDE ne vaut que si rien d'autre ne le domine, et c'est ce chiffre-la qui le dit.
(defun phys-tip-stim ((slot int) (chain int))
  (phys-stat slot chain 16))

;; AMPLITUDE DE MOUVEMENT D'UN MAILLON DONNE, meme instrument que `phys-tip-amp` mais pris sur le
;; maillon `link` au lieu de la pointe. C'est la suite que SPEC 2 exige croissante de la racine vers
;; la pointe, et la seule mesure capable de voir « le milieu part en vrille et la pointe ne bouge
;; pas » — que `tipvar`, qui ne regarde que la pointe, rendait indistinguable d'une chaine saine.
(defun phys-link-amp ((slot int) (chain int) (link int))
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (let* ((lb (* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link) PHYS-LB))
           (dx (- (-> *phys-lb* (+ lb 1)) (-> *phys-lb* (+ lb 0))))
           (dy (- (-> *phys-lb* (+ lb 3)) (-> *phys-lb* (+ lb 2))))
           (dz (- (-> *phys-lb* (+ lb 5)) (-> *phys-lb* (+ lb 4)))))
      (if (or (< dx 0.0) (< dy 0.0) (< dz 0.0))
        0.0
        (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))))

;; LE MOUVEMENT PROPRE D'UN MAILLON, en DEGRES : sa deviation angulaire par rapport a SON ATTACHE.
;; 10e passe de l'owner : « le milieu est plus hysterique (bouge beaucoup plus) que les pointes,
;; c'est pas cense ! » — pendant que `phys-link-amp` publiait une suite croissante. Les deux ne
;; mesurent pas la meme chose : `phys-link-amp` est un ecart a la pose d'auteur, donc il CUMULE le
;; long de la chaine et une pointe soudee a son parent y affiche le chiffre de son parent. Celle-ci
;; est relative au parent par construction et vaut zero pour un maillon qui ne bouge pas tout seul.
;; Les deux sont publiees cote a cote : leur ecart EST la mesure de l'erreur de l'ancienne.
(defun phys-link-ang ((slot int) (chain int) (link int))
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (-> *phys-la* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link))))

(defun phys-slot-chains ((slot int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS)) (-> *phys-slot-nch* slot) 0))

(defun phys-chain-links ((slot int) (chain int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-nlink* (+ (* slot PHYS-CHAINS) chain))
    0))

(defun phys-chain-family ((slot int) (chain int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-fam* (+ (* slot PHYS-CHAINS) chain))
    0))

;; SPEC 4, l'exception : `hang` > 0 = « ce qui doit pendre » (les lunettes), qui ne retourne PAS a
;; la pose du modele. La salle s'en sert pour compter ces chaines a part au repos, au lieu de
;; devenir complice d'un ecart residuel qu'elle ne saurait pas expliquer.
(defun phys-chain-hang ((slot int) (chain int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-hang* (+ (* slot PHYS-CHAINS) chain))
    0.0))

(defun phys-chain-joint ((slot int) (chain int) (link int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= link 0) (< link PHYS-LINKS))
    (-> *phys-joint* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link))
    -1))

;; la longueur que LE MODELE donne a l'os d'un lien (son attache est l'ancre pour le lien 0). C'est
;; le plafond geometrique de l'amplitude de ce lien : la salle le publie pour que personne n'ait a
;; deviner si une chaine « ne bouge pas assez » ou « ne peut pas bouger plus ».
(defun phys-chain-bone ((obj jak-hd) (slot int) (chain int) (link int))
  (let ((r 0.0))
    (when (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
               (>= link 0) (< link PHYS-LINKS)
               (nonzero? (-> obj draw)) (nonzero? (-> obj draw skeleton)))
      (let* ((skel (-> obj draw skeleton))
             (nbone (-> skel length))
             (sc  (+ (* slot PHYS-CHAINS) chain))
             (scl (+ (* sc PHYS-LINKS) link))
             (kk  (-> *phys-joint* scl))
             (kp  (if (> link 0) (-> *phys-joint* (- scl 1)) (-> *phys-anchor* sc))))
        (when (and (< link (-> *phys-nlink* sc)) (>= kk 0) (>= kp 0)
                   (< (+ kk 1) nbone) (< (+ kp 1) nbone))
          (set! r (vector-vector-distance
                    (the-as vector (-> skel bones (+ kk 1) transform vector 3))
                    (the-as vector (-> skel bones (+ kp 1) transform vector 3)))))))
    r))

(defun phys-inject-set! ((v float))
  (set! *phys-inject* v)
  (none))

(defun phys-inject-count () *phys-injn*)

(defun phys-inject-count-reset! ()
  (set! *phys-injn* 0)
  (none))

;; CONTROLE POSITIF DU CANAL D'AUTEUR : 1 = l'animation est retardee d'une frame dans la position
;; ecrite. Le compteur d'identite doit s'effondrer ; s'il ne bouge pas, il ne mesure rien.
(defun phys-auth-lag-set! ((v int))
  (set! *phys-auth-lag* v)
  (none))

;; CE QUE LES LIMITEURS ONT RETIRE, en unites de jeu (SPEC 7 : un suppresseur se chiffre).
;; which 0 = recul vers la pose du modele : nombre de fois / total retire
;;       2 = plafond de taille d'un lien seul : nombre de fois / total retire
(defun phys-limiter ((which int))
  (case which
    ((0) (the float *phys-retreat-n*))
    ((1) *phys-retreat-sum*)
    ((2) (the float *phys-raddrop-n*))
    ((3) *phys-raddrop-sum*)
    ((5) (the float *phys-retfb-n*))
    (else (the float *phys-buried-n*))))

;; INVERSIONS (SPEC 5 / verdict owner) : which 0 = bascules corrigees, 1 = cas degeneres rattrapes.
(defun phys-inversions ((which int))
  (case which
    ((0) (the float *phys-invn*))
    ((1) (the float *phys-invfix*))
    ((2) (the float *phys-reseat-n*))
    ;; 4 = re-assises retombees sur l'ancienne heuristique. Doit valoir ZERO.
    ((4) (the float *phys-reseat-fb*))
    (else (the float *phys-invres*))))

(defun phys-inv-inject-set! ((v int))
  (set! *phys-inv-inject* v)
  (none))

;; ------------------------------------------------------------------------------------------------
;; DIAGNOSTIC PAR CHAINE — les quatre defauts de la 6e passe se lisent ici, chaine par chaine.
;; which : 0 selfcol  1 retreat  2 flip  3 inv  4 invres  5 elong (allongement relatif max)
;; ------------------------------------------------------------------------------------------------
(defun phys-diag ((slot int) (chain int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= which 0) (< which PHYS-DG))
    (-> *phys-dg* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-DG) which))
    0.0))

(defun phys-diag-reset! ()
  (dotimes (i (* PHYS-SC PHYS-DG)) (set! (-> *phys-dg* i) 0.0))
  ;; l'etat de contrainte de la frame precedente est oublie aussi : sinon la premiere frame de la
  ;; fenetre suivante compterait une bascule qui n'a pas eu lieu dans cette fenetre.
  (dotimes (i PHYS-SCL) (set! (-> *phys-flhas* i) 0))
  (none))

;; CONTROLE POSITIF DE L'AUTO-COLLISION : 1 = l'exclusion chaine <-> ses propres volumes est LEVEE.
;; Le compteur `selfcol` doit alors monter. Un zero structurel que rien ne peut faire monter ne
;; prouve rien — c'est la regle « tout zero exige un controle positif qui a tire ».
(defun phys-self-inject-set! ((v int))
  (set! *phys-self-inject* v)
  (none))

(defun phys-inversions-reset! ()
  (set! *phys-invn* 0)
  (set! *phys-invres* 0)
  (set! *phys-invfix* 0)
  (none))

;; le collider resolu numero ci : son joint, son second joint (-1 = sphere), ses deux rayons. Publie
;; par la salle pour que le tableau puisse dire QUELLES PARTIES DU CORPS sont couvertes — un zero de
;; penetration contre un ensemble qui ne couvre pas le corps ne prouve rien.
(defun phys-collider-field ((slot int) (ci int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= ci 0) (< ci (-> *phys-slot-nco* slot)))
    (let ((sco (+ (* slot PHYS-COLS) ci)))
      (case which
        ((0) (-> *phys-cj* sco))
        (else (-> *phys-cj2* sco))))
    -1))

(defun phys-slot-colliders ((slot int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS)) (-> *phys-slot-nco* slot) 0))

(defun phys-limiter-reset! ()
  (set! *phys-retreat-n* 0)
  (set! *phys-retreat-sum* 0.0)
  (set! *phys-raddrop-n* 0)
  (set! *phys-raddrop-sum* 0.0)
  (set! *phys-buried-n* 0)
  (set! *phys-retfb-n* 0)
  (none))

;; SPEC 5. which 0 = frames ou l'anim pilotait cette chaine, 1 = celles ou la pose ecrite est partie
;; du meme cote, 2/3 = somme(ecrit . auteur) et somme(auteur . auteur), dont le rapport est la
;; TRANSMISSION. Ces quatre-la survivent aux fenetres : c'est le bilan de la course.
(defun phys-auth ((slot int) (chain int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (let ((sc (+ (* slot PHYS-CHAINS) chain)))
      (case which
        ((0) (-> *phys-ahit* sc))
        ((1) (-> *phys-aok* sc))
        ((2) (-> *phys-adot* sc))
        ((3) (-> *phys-anrm* sc))
        ((4) (-> *phys-dsum* sc))
        ((5) (-> *phys-usum* sc))
        ((6) (-> *phys-tmov* sc))
        (else (-> *phys-conf* sc))))
    0.0))

(defun phys-auth-reset! ()
  (dotimes (sc PHYS-SC)
    (set! (-> *phys-ahit* sc) 0.0)
    (set! (-> *phys-aok* sc) 0.0)
    (set! (-> *phys-adot* sc) 0.0)
    (set! (-> *phys-anrm* sc) 0.0)
    (set! (-> *phys-dsum* sc) 0.0)
    (set! (-> *phys-usum* sc) 0.0)
    (set! (-> *phys-tmov* sc) 0.0)
    (set! (-> *phys-conf* sc) 0.0)
    (set! (-> *phys-rhas* sc) 0))
  (none))

;; le slot de simulation d'un compagnon, pour que la salle sache ou lire ses chiffres.
(defun phys-slot-of ((pid int)) (phys-slot-for-pid pid))

)
