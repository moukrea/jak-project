;;-*-Lisp-*-
(in-package goal)

;; jak-hd-physics.gc — PHYSIQUE SECONDAIRE DE KEIRA (depart propre 2026-08-11).
;;
;; L'ancien moteur (6000 lignes) est parke sur `physics-attic-2026-08-11`. Il n'est PAS une base de
;; travail : la cause MESUREE de son echec est l'empilement de suppresseurs (1940 -> 6000 lignes,
;; clamps 9 -> 84, detection d'anim 45 -> 172) jusqu'a ce que 42 % des mesures soient a zero.
;; Celui-ci implemente `.autoport/prompts/SPEC-keira-physique.md`, section par section, et RIEN
;; d'autre. Aucun gel de calme, aucun sommeil, aucune hysteresis, aucun clamp de vitesse, aucun
;; masque ni filtre de volume : ce qui limite une chaine est soit la LONGUEUR D'UN OS, soit un
;; COLLIDER, soit la POSE DU MODELE. Ce sont les trois seuls limiteurs de la SPEC.
;;
;; LA FORME DU MOTEUR — et c'est elle qui fait tomber trois exigences d'un coup.
;; Le simule n'est pas la position du joint : c'est son ECART a la pose d'auteur, exprime dans le
;; repere de l'os porteur (l'ancre). La position ecrite vaut
;;
;;     p_l  =  T_l  +  R_ancre . o_l                (T = pose retargetee, o = ecart simule)
;;
;; d'ou, sans un seul cas particulier :
;;   SPEC 2  la racine ne bouge pas   -> o = 0 sur les liens `rootlock` : ils ne sont ni integres
;;                                       ni ecrits, la pose du retarget reste, au bit pres.
;;   SPEC 4  le repos = le modele     -> famille A (gravite nulle) : o -> 0, donc p -> T. Ce n'est
;;                                       pas un reglage, c'est le point fixe de l'integrateur.
;;                                       Famille B (gravite) : o s'arrete sur un ecart statique,
;;                                       ca pend et ca reste pendu.
;;   SPEC 5  l'animation d'auteur     -> le deplacement d'auteur (T) traverse avec un coefficient
;;                                       de 1 : la physique AJOUTE o, elle ne remplace rien et ne
;;                                       peut donc pas retarder l'animation. Un ressort ecrit en
;;                                       repere monde, lui, la retarde — c'est ce que mesure la
;;                                       colonne `authored` de la salle, et c'est ce qui separe
;;                                       les deux formes.
;;   SPEC 1  ce qui a de la physique  -> les chaines viennent du fichier de donnees, genere depuis
;;                                       le rig. Le moteur ne connait aucun nom de joint en dur.
;;   SPEC 3  collisions propres       -> projection hors des volumes ajustes sur le mesh, avec le
;;                                       PLANCHER DE POSE MODELE : un lien deja dans un volume au
;;                                       repos (une racine de cheveu sous le cuir chevelu) a le
;;                                       droit d'y etre, il n'a pas le droit d'aller PLUS PROFOND.
;;                                       C'est ce qui remplace le `colskip` retire.
;;   SPEC 7  ce qui fait foi          -> la position ECRITE du joint, mesuree ici meme.
;;
;; REGLE 0 (owner) : un commentaire n'est pas une preuve. Tout ce que ce fichier PRETEND faire est
;; mesure par la salle de test (phys-room.gc) et publie dans keira-room-table.txt.

(#when FLAG_PHYSICS

;; ------------------------------------------------------------------------------------------------
;; PONT C++ — le magasin de parametres vit dans game/kernel/jak1/kmachine.cpp (parse de
;; recharged_assets/physics_chains.txt). Aucune valeur flottante ne traverse la frontiere : tout
;; arrive en MILLI-unites (kmachine.cpp:884-887, phys_mi:1721).
;; ------------------------------------------------------------------------------------------------
(define-extern pc-physics-enabled              (function int))
(define-extern pc-physics-num-chains           (function string int))
(define-extern pc-physics-joint-role           (function string string int))
(define-extern pc-physics-chain-param-mi       (function string int int int))
(define-extern pc-physics-chain-link-radius-mi (function string int int int))
(define-extern pc-physics-num-colliders        (function string int))
(define-extern pc-physics-collider-param-mi    (function string int int int))
(define-extern pc-physics-collider-is-joint    (function string int string int))
(define-extern pc-physics-collider-is-joint2   (function string int string int))
;; SPEC 18 — les echantillons de SURFACE du mesh skinne. Le C++ les parse depuis
;; `recharged_assets/physics_mesh.txt` (prefixe `bs`) et les expose depuis toujours ; aucune ligne
;; de GOAL ne les appelait. Le consommateur avait existe (bdd5d07d9c) et le depart propre l'a
;; emporte avec les 6000 lignes de suppresseurs — on reimplemente, on ne recupere pas de bloc.
(define-extern pc-physics-num-bsurf            (function string int))
(define-extern pc-physics-bsurf-is-joint       (function string int string int))
(define-extern pc-physics-bsurf-count          (function string int int))
(define-extern pc-physics-bsurf-mi             (function string int int int int))

;; parametres de chaine (ids: kmachine.cpp:998-1038)
(defconstant PHYS-P-STIFF   0)
(defconstant PHYS-P-DAMP    1)
(defconstant PHYS-P-GRAV    2)
(defconstant PHYS-P-RADIUS  6)
(defconstant PHYS-P-ROOTLK  7)
;; [NOTE-01] 8 = `gradient`, documente par le parseur C++ comme « root->tip freedom exponent » -> jak-hd-physics-NOTES.md
(defconstant PHYS-P-GRADIENT 8)
(defconstant PHYS-P-MASS   19)
(defconstant PHYS-P-HANG   20)
(defconstant PHYS-P-FAMILY 22)
(defconstant PHYS-P-COUPLE 27)
;; [NOTE-108] SPEC 6 — `B0`, LA LONGUEUR CARACTERISTIQUE RACINE->APEX DE LA CHAIR, EN UNIT -> jak-hd-physics-NOTES.md
(defconstant PHYS-P-B0     29)
;; L'ANGLE QUE LA PEAU PEUT ENCAISSER, EN DEGRES — CHEVEUX SEULEMENT, 0 = pas de limite.
;; Owner 2026-08-11 21:15 : « certains maillons meriteraient un traitement pour eviter de creer des
;; angles extremes qui mettent en lumiere le lack of geometrie » ; 22:35, le perimetre : « juste sur
;; les meches, pas le reste, encore moins les seins ». La valeur est DERIVEE DU RIG par le
;; generateur (2*atan(min(L_entrant,L_sortant)/rayon), l'angle ou les deux tubes de peau se
;; croisent) et recalculee par son controle 6b : le moteur ne connait toujours aucun nom de joint.
(defconstant PHYS-P-MAXANG  3)

;; champs de collider (kmachine.cpp:1920-1986)
(defconstant PHYS-C-RADIUS 0)
(defconstant PHYS-C-SHAPE  3)
(defconstant PHYS-C-RADIUS2 4)
;; 6e passe de l'owner : « lBoob et rBoob sont des spheres NUES posees sur le joint-racine, alors
;; que tout le reste du corps est en capsules derivees. Une sphere au joint ne peut pas epouser un
;; sein. » Le centre de la sphere est desormais le CENTROIDE MESURE de la geometrie du joint, dans
;; l'espace bind de ce joint ; le moteur le transforme par la matrice de l'os, donc il suit
;; l'animation. Absent des donnees = 0,0,0 = le centre reste le joint (comportement d'avant).
(defconstant PHYS-C-OFFX   7)
(defconstant PHYS-C-OFFY   8)
(defconstant PHYS-C-OFFZ   9)

;; ------------------------------------------------------------------------------------------------
;; TAILLES. Un slot = un compagnon HD vivant. Keira seule aujourd'hui, mais le jeu peut porter
;; quatre compagnons (jak/daxter/keira/samos) et le moteur ne doit pas se marcher dessus.
;; ------------------------------------------------------------------------------------------------
(defconstant PHYS-SLOTS  4)
(defconstant PHYS-CHAINS 28)
(defconstant PHYS-LINKS  4)
(defconstant PHYS-COLS   96)
(defconstant PHYS-JOINTS 128)

(defconstant PHYS-SC   (* PHYS-SLOTS PHYS-CHAINS))
(defconstant PHYS-SCL  (* PHYS-SLOTS PHYS-CHAINS PHYS-LINKS))
(defconstant PHYS-SCO  (* PHYS-SLOTS PHYS-COLS))

;; identite du slot
(define *phys-slot-pid*  (new 'global 'array 'int32 PHYS-SLOTS))
(define *phys-slot-nch*  (new 'global 'array 'int32 PHYS-SLOTS))
(define *phys-slot-nco*  (new 'global 'array 'int32 PHYS-SLOTS))

;; topologie des chaines
(define *phys-nlink*  (new 'global 'array 'int32 PHYS-SC))
(define *phys-anchor* (new 'global 'array 'int32 PHYS-SC))   ;; joint porteur (parent rig du lien 0)
(define *phys-joint*  (new 'global 'array 'int32 PHYS-SCL))  ;; index de joint HD par lien

;; parametres resolus une fois a l'init
(define *phys-stiff*  (new 'global 'array 'float PHYS-SC))
(define *phys-damp*   (new 'global 'array 'float PHYS-SC))
(define *phys-grav*   (new 'global 'array 'float PHYS-SC))
(define *phys-mass*   (new 'global 'array 'float PHYS-SC))
(define *phys-hang*   (new 'global 'array 'float PHYS-SC))
(define *phys-couple* (new 'global 'array 'float PHYS-SC))
(define *phys-fam*    (new 'global 'array 'int32 PHYS-SC))   ;; 1 = A, 2 = B
(define *phys-rootlk* (new 'global 'array 'int32 PHYS-SC))
;; LIBERTE GRADUEE DE LA RACINE, 0 = aucune (le maillon 0 reste epingle, comportement d'avant ce
;; cycle au bit pres). Une valeur g dans ]0,1] rend le maillon 0 SIMULE, mais avec sa raideur
;; angulaire multipliee par 1/g^2 : sa deviation d'equilibre est donc de l'ordre de g fois celle
;; d'une racine libre. g=1 = racine entierement libre, et c'est l'etat que l'owner a DEJA rejete
;; (« cheveux decolles du crane »). Ce parametre n'existe pas pour etre mis a 1.
(define *phys-rootgr* (new 'global 'array 'float PHYS-SC))
(define *phys-b0*     (new 'global 'array 'float PHYS-SC))   ;; SPEC 6, unites, 0 = non declare
(define *phys-maxang* (new 'global 'array 'float PHYS-SC))   ;; degres, 0 = aucune limite d'angle
;; PIERRE TOMBALE DU FOURREAU — retire le 2026-08-14. Le pan de pantacourt (`pantflapL/R`) etait
;; contraint par CONCENTRICITE (borner son ecart radial a l'axe du mollet qu'il entoure) au lieu
;; d'etre ejecte de ce membre. Le mecanisme est mort dans la course actuelle : 0 chaine sur 22
;; declare `shell > 0` — les deux seules qui portent la cle sont a `shell=0` —, donc le predicat
;; rendait #f partout et le controle positif ne pouvait plus tirer (`ROOM-SHELL-CONTROL
;; armed=disarmed=0`). La cle `shell=` reste dans les donnees livrees ; seul le code mort part.
(define *phys-rad*    (new 'global 'array 'float PHYS-SCL))  ;; demi-epaisseur par lien
;; LA LONGUEUR D'OS DE CHAQUE MAILLON, relevee sur la pose ANIMEE a chaque frame.
;; (Sa moyenne `*phys-lmean*` a ete retiree le 2026-08-14 : elle ne servait qu'au ressort angulaire
;; `k2a`, qui n'existe plus depuis la bascule du 2026-08-13 22:40 — le symbole etait ecrit et lu
;; par personne dans tout `goal_src/`, verifie par recensement, et sa narration decrivait un
;; mecanisme absent.)
(define *phys-blen*  (new 'global 'array 'float PHYS-SCL))   ;; longueur d'os du maillon
;; [NOTE-02] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(define *phys-lcr* (new 'global 'array 'float PHYS-SCL))  ;; rayon du volume porte par le lien
(define *phys-lcx* (new 'global 'array 'float PHYS-SCL))  ;; son centre, en espace bind du joint
(define *phys-lcy* (new 'global 'array 'float PHYS-SCL))
(define *phys-lcz* (new 'global 'array 'float PHYS-SCL))

;; L'ECART A LA POSE D'AUTEUR, DANS LE REPERE DE L'ANCRE. Ce fut l'etat INTEGRE du solveur, et
;; c'est le modele que l'owner a rejete le 2026-08-13 a 22:40 (« on integre un ECART, pas un
;; cheveu »). Il n'est plus integre : il est DERIVE de la position monde a la section 4, et il ne
;; sert plus qu'a la mesure — toute l'instrumentation de la salle est definie sur lui, et le
;; contrat interdit de changer l'instrument en meme temps que ce qu'il mesure.
(define *phys-ox*  (new 'global 'array 'float PHYS-SCL))
(define *phys-oy*  (new 'global 'array 'float PHYS-SCL))
(define *phys-oz*  (new 'global 'array 'float PHYS-SCL))
;; `*phys-o1x/o1y/o1z*` sont retires : declares, remis a zero dans la branche d'ancre, et RELUS
;; NULLE PART — 6 occurrences dans tout `goal_src`, toutes des ecritures.
;; ETAT SIMULE — LA POSITION MONDE DE LA PARTICULE. C'est desormais le SEUL etat integre, et il n'y
;; en a pas d'autre : `p` (courant) et `q` (frame precedente), soit un verlet en position. Toute la
;; physique en decoule — la vitesse implicite `p - q` EST l'inertie, donc la masse ; la gravite s'y
;; ajoute comme une vraie acceleration monde ; la contrainte de distance et les collisions la
;; projettent. La pose au repos n'est plus imposee, elle EMERGE de cet equilibre.
(define *phys-px*  (new 'global 'array 'float PHYS-SCL))
(define *phys-py*  (new 'global 'array 'float PHYS-SCL))
(define *phys-pz*  (new 'global 'array 'float PHYS-SCL))
(define *phys-qx*  (new 'global 'array 'float PHYS-SCL))
(define *phys-qy*  (new 'global 'array 'float PHYS-SCL))
(define *phys-qz*  (new 'global 'array 'float PHYS-SCL))
;; LA DIRECTION DE REPOS DU MATERIAU, dans le repere de l'ancre, relevee UNE FOIS et constante
;; ensuite. Elle ne concerne QUE la chair de famille A a un seul maillon libre (oreilles, poitrine) :
;; un sein n'est pas une corde, c'est une masse sur un tissu elastique, et l'owner a fixe lui-meme sa
;; reference (« le point de reference c'est quand elle est debout, car c'est comme ca que le modele
;; est fait, MAIS ils suivent la gravite », SPEC 1bis). Les CHEVEUX n'en ont pas : ils pendent.
;; Elle est PRE-COMPENSEE de la fleche gravitaire a la capture, de sorte que debout l'equilibre
;; retombe exactement sur la pose du modele (SPEC 4) et que s'incliner la deplace pour de bon.
(define *phys-ux*   (new 'global 'array 'float PHYS-SCL))
(define *phys-uy*   (new 'global 'array 'float PHYS-SCL))
(define *phys-uz*   (new 'global 'array 'float PHYS-SCL))
(define *phys-ucap* (new 'global 'array 'int32 PHYS-SCL))   ;; 1 = direction de repos relevee
;; `g_ref` DE SA SPEC 3 — la gravite de la pose debout d'auteur, vue de l'ancre, relevee une fois par
;; chaine a la meme frame que `*phys-ux*`. Derivation, mesure et raison complete au site d'usage.
(define *phys-gref* (new 'global 'array 'float (* 3 PHYS-SC)))
;; historique MONDE de la pose d'auteur, par lien : sa difference seconde est l'acceleration du
;; repere que la chaine subit. C'est la seule chose qui EXCITE une chaine dont l'ecart cible est nul.
(define *phys-t1x* (new 'global 'array 'float PHYS-SCL))
(define *phys-t1y* (new 'global 'array 'float PHYS-SCL))
(define *phys-t1z* (new 'global 'array 'float PHYS-SCL))
(define *phys-t2x* (new 'global 'array 'float PHYS-SCL))
(define *phys-t2y* (new 'global 'array 'float PHYS-SCL))
(define *phys-t2z* (new 'global 'array 'float PHYS-SCL))
(define *phys-warm* (new 'global 'array 'int32 PHYS-SC))     ;; 0 = pas encore amorce

;; colliders resolus (index de joint, -1 = absent)
(define *phys-cj*  (new 'global 'array 'int32 PHYS-SCO))
(define *phys-cj2* (new 'global 'array 'int32 PHYS-SCO))
(define *phys-cr*  (new 'global 'array 'float PHYS-SCO))
(define *phys-cr2* (new 'global 'array 'float PHYS-SCO))
;; centre de la sphere dans l'espace bind de son joint (0,0,0 = sur le joint)
(define *phys-cox* (new 'global 'array 'float PHYS-SCO))
(define *phys-coy* (new 'global 'array 'float PHYS-SCO))
(define *phys-coz* (new 'global 'array 'float PHYS-SCO))

;; [NOTE-03] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(define *phys-crax* (new 'global 'array 'float PHYS-SCO))   ;; extremite A, monde, pose d'auteur
(define *phys-cray* (new 'global 'array 'float PHYS-SCO))
(define *phys-craz* (new 'global 'array 'float PHYS-SCO))
(define *phys-crbx* (new 'global 'array 'float PHYS-SCO))   ;; extremite B (capsule), idem
(define *phys-crby* (new 'global 'array 'float PHYS-SCO))
(define *phys-crbz* (new 'global 'array 'float PHYS-SCO))
(define *phys-crok* (new 'global 'array 'int32 PHYS-SCO))   ;; 1 = instantane pris cette frame

;; [NOTE-04] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(define *phys-csim* (new 'global 'array 'int32 PHYS-SCO))   ;; 1 = volume porte par un joint SIMULE
(define *phys-cdep* (new 'global 'array 'int32 PHYS-SCO))   ;; profondeur rig, pour la priorite
(define *phys-csax* (new 'global 'array 'float PHYS-SCO))   ;; extremite A, fin de frame precedente
(define *phys-csay* (new 'global 'array 'float PHYS-SCO))
(define *phys-csaz* (new 'global 'array 'float PHYS-SCO))
(define *phys-csbx* (new 'global 'array 'float PHYS-SCO))   ;; extremite B, idem
(define *phys-csby* (new 'global 'array 'float PHYS-SCO))
(define *phys-csbz* (new 'global 'array 'float PHYS-SCO))
(define *phys-csok* (new 'global 'array 'int32 PHYS-SCO))   ;; 1 = un instantane existe
;; [NOTE-05] COUPLAGE DE JACOBI — ARME depuis le 2026-08-18, apres DEUX refus mesures. -> jak-hd-physics-NOTES.md
(define *phys-jacobi-off* 0)

;; [NOTE-06] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(define *phys-lwin* (new 'global 'array 'int32 PHYS-SCL))   ;; volume decideur du lien, -1 = aucun
;; [NOTE-07] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(define *phys-prio-off* 1)
(define *phys-prio-n* 0)      ;; paires (lien, volume) ignorees par la priorite, sur la fenetre
(define *phys-prio-multi* 0)  ;; liens contraints par plus d'un volume dans la meme frame

;; [NOTE-08] MESURER LE CONFLIT SANS L'ARBITRER — 2026-08-13. -> jak-hd-physics-NOTES.md
(define *phys-prio-meas* 0)

;; [NOTE-09] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defconstant PHYS-ST 20)
(define *phys-st*  (new 'global 'array 'float (* PHYS-SC PHYS-ST)))
;; [NOTE-10] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defconstant PHYS-LB 6)
(define *phys-lb* (new 'global 'array 'float (* PHYS-SCL PHYS-LB)))

;; [NOTE-11] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(define *phys-la* (new 'global 'array 'float PHYS-SCL))
;; [NOTE-12] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(define *phys-la0* (new 'global 'array 'float PHYS-SCL))
(define *phys-la1* (new 'global 'array 'float PHYS-SCL))
;; [NOTE-13] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(define *phys-lsv* (new 'global 'array 'float (* PHYS-SCL 3)))
;; [NOTE-14] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defconstant PHYS-MOB-AP  0.90)   ;; §29 Front/back
(defconstant PHYS-MOB-LAT 0.82)   ;; §29 Lateral
;; [NOTE-73] QUEL AXE DE L'ANCRE EST QUOI — classe UNE FOIS par chaine, a sa premiere frame -> jak-hd-physics-NOTES.md
(define *phys-axv*  (new 'global 'array 'int32 PHYS-SC))   ;; index de ligne : vertical
(define *phys-axa*  (new 'global 'array 'int32 PHYS-SC))   ;; ...              avant-arriere
(define *phys-axl*  (new 'global 'array 'int32 PHYS-SC))   ;; ...              lateral
(define *phys-axok* (new 'global 'array 'int32 PHYS-SC))   ;; 1 = classe
;; la direction MONDE des trois lignes du triedre de l'ancre, normalisee : `sc*9 + ligne*3 + comp`.
;; C'est ce qui permet a la salle d'EXCITER un axe du solveur au lieu d'un axe monde — voir la note
;; du site d'ecriture, et la mesure qui l'a rendue necessaire.
(define *phys-axw*  (new 'global 'array 'float (* PHYS-SC 9)))
;; LE FACTEUR DE RAIDEUR PAR LIGNE DE LA MATRICE DE L'ANCRE, `1/mobilite` de sa §29. Il reste a 1.0
;; sur les trois lignes tant qu'aucun triedre n'a pu etre classe : la mise a jour par axe redevient
;; alors la mise a jour scalaire d'avant, BIT POUR BIT, au lieu de pousser dans une direction
;; arbitraire. C'est aussi ce qui fait que les 20 chaines gelees ne changent pas d'un bit.
(define *phys-axs* (new 'global 'array 'float (* PHYS-SC 3)))
;; [NOTE-15] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(define *phys-axan* (new 'global 'array 'int32 PHYS-SC))   ;; 1 = raideur par axe ARMEE
;; [NOTE-74] ============================================================================== -> jak-hd-physics-NOTES.md
(define *phys-axsep* (new 'global 'array 'float (* PHYS-SC 3)))  ;; sep. inter-chaine, repere ancre
(define *phys-axsrc* (new 'global 'array 'int32 PHYS-SC))  ;; 0 = pas de partenaire, 1 = separation
;; [NOTE-75] ============================================================================== -> jak-hd-physics-NOTES.md
(defconstant PHYS-MOB-TOR 0.72)    ;; §29 TorsionalCompliance
(defconstant PHYS-SEC-F   5.2)     ;; §36 frequence du mode secondaire (Hz)
(defconstant PHYS-SEC-Z   0.65)    ;; §36 DampingRatio
(defconstant PHYS-SEC-MAX 0.07)    ;; §38 SecondaryJiggleHardMax
;; §36 — LE GAIN D'EXCITATION, CALE SUR SA BANDE ET SUR RIEN D'AUTRE. Mesure de la course B, qui
;; publie l'amplitude AVANT ecretage : a 2.5 le mode secondaire rendait 19 % a 312 % selon le
;; pilotage, donc un plafond a 7 % touche en permanence — un limiteur sature, pas une amplitude.
;; A 0.05 les memes fenetres rendent : tilt 0.4-0.7 %, updown 1.5 %, jerk 4.0-4.5 %,
;; leftright 4.5-5.5 %, accel 5.7-6.2 %. Sa bande : « normal 2-5 %, strong impulse 5-7 %,
;; hard ceiling 7 % ». Le pilotage quasi-statique (tilt) tombe SOUS la bande, et c'est correct :
;; §36 est excitee par un CHANGEMENT DE DIRECTION, et une pose tenue n'en contient aucun.
(defconstant PHYS-SEC-K   0.05)
(defconstant PHYS-DYN-K   0.43)    ;; §38 NormalDynamicStretch 0.15 atteint a 0.35 B0
(defconstant PHYS-DYN-MAX 0.25)    ;; §38 AbsoluteStretchClamp
;; [NOTE-76] §23 — « the solver should then derive local deformation from COM displacement, -> jak-hd-physics-NOTES.md
(defconstant PHYS-PRS-K   0.45)
(defconstant PHYS-PRS-MAX 0.25)    ;; §12 : -25 % au pire, borne haute de sa bande
(defconstant PHYS-RST-BB  0.06)    ;; §33 restitution sein <-> sein
(defconstant PHYS-RST-CH  0.02)    ;; §34 restitution sein <-> buste / externe
;; LE TRIEDRE DE SA SPEC 7 (+X lateral sortant, +Y haut du torse, +Z vers l'avant du buste), en
;; espace ANCRE, releve UNE fois a la pose debout d'auteur — la meme frame que `g_ref` et que
;; `*phys-ux*`, pour que les trois references soient coherentes. Il ne se deduit d'aucun nom d'os :
;; +Y = -g_ref (la verticale telle que le modele a ete sculpte), +Z = la protrusion racine->apex
;; orthogonalisee, +X = leur produit. Un rig retargete peut donc arriver dans n'importe quelle
;; orientation sans que rien ici ne change.
(define *phys-fx*  (new 'global 'inline-array 'vector PHYS-SC))
(define *phys-fy*  (new 'global 'inline-array 'vector PHYS-SC))
(define *phys-fz*  (new 'global 'inline-array 'vector PHYS-SC))
(define *phys-fok* (new 'global 'array 'int32 PHYS-SC))    ;; 1 = triedre SPEC 7 releve
;; L'ECHELLE EFFECTIVEMENT APPLIQUEE, dans CE triedre : (lateral, vertical, projection). C'est la
;; grandeur que la salle publie ; sa NATURE est un rapport sans dimension a la forme d'auteur, son
;; REPERE est celui de l'ancre, et sa LECTURE HORS DEFAUT est 1.000 sur les trois (debout).
(define *phys-dfs*  (new 'global 'array 'float (* PHYS-SC 3)))
;; LA DIRECTION DE LA GRAVITE TELLE QUE LE SOLVEUR LA VOIT, dans le triedre de sa §7 : c'est
;; l'ENTREE de §10-13, et elle est publiee a cote de la sortie. Sans elle, une forme mesuree ne
;; peut pas etre rattachee a l'orientation qui l'a produite — et c'est l'orientation VUE, jamais
;; celle que la salle croit avoir commandee.
(define *phys-gc*   (new 'global 'array 'float (* PHYS-SC 3)))
;; LA MEME GRAVITE, MAIS SUR LES TROIS LIGNES DE LA MATRICE DE L'ANCRE — donc sur les axes que la
;; classification de §29 a nommes `rv`/`rap`/`rlat`. Elle repond a une question que rien ne pouvait
;; trancher jusqu'ici : la ligne appelee AP est-elle vraiment l'avant-arriere ? Sous un TANGAGE
;; c'est l'avant-arriere qui doit s'allumer, sous un ROULIS le lateral. Si c'est l'inverse, les
;; deux compliances de §29 (0.90 et 0.82) sont posees sur les mauvais axes.
(define *phys-gr*   (new 'global 'array 'float (* PHYS-SC 3)))
(define *phys-dfon* (new 'global 'array 'int32 PHYS-SC))   ;; 1 = canal de deformation arme
(define *phys-dfdet* (new 'global 'array 'float PHYS-SC))  ;; §8 : det de l'echelle appliquee
(define *phys-sec*  (new 'global 'array 'float PHYS-SC))   ;; §36 modulation d'epaisseur (fraction)
(define *phys-secv* (new 'global 'array 'float PHYS-SC))
(define *phys-secm* (new 'global 'array 'float PHYS-SC))   ;; son maximum sur la fenetre (mesure)
;; LE MEME MAXIMUM, MAIS AVANT LE PLAFOND DE SA §38. Sans lui, un mode secondaire sature se lit
;; `0.0700` a chaque fenetre et devient indiscernable d'un mode correctement excite qui frole le
;; plafond — c'est la signature du limiteur sature, deja payee une fois sur ce dossier. C'est ce
;; nombre-la qui dit de combien le gain d'excitation est a cote, et c'est la seule facon de le
;; caler sur SA bande (2-5 % normal, 5-7 % impulsion forte) sans le regler sur l'instrument.
(define *phys-secr* (new 'global 'array 'float PHYS-SC))
(define *phys-dynm* (new 'global 'array 'float PHYS-SC))   ;; son maximum sur la fenetre
;; [NOTE-57] SPEC 23 — LE TROISIEME DEGRE DE LIBERTE QUE LA CONTRAINTE DE LONGUEUR CONFISQUAIT. -> jak-hd-physics-NOTES.md
;; [NOTE-80] PAR MAILLON DEPUIS LE CYCLE 32 : avant, le point libre de §23 n'existait que sur `rlk`. -> jak-hd-physics-NOTES.md
(define *phys-cpx*  (new 'global 'array 'float PHYS-SCL))  ;; §23 le point LIBRE, monde, PAR MAILLON
(define *phys-cpy*  (new 'global 'array 'float PHYS-SCL))
(define *phys-cpz*  (new 'global 'array 'float PHYS-SCL))
(define *phys-cqx*  (new 'global 'array 'float PHYS-SCL))  ;; le meme, frame -1 (verlet)
(define *phys-cqy*  (new 'global 'array 'float PHYS-SCL))
(define *phys-cqz*  (new 'global 'array 'float PHYS-SCL))
(define *phys-rok*  (new 'global 'array 'int32 PHYS-SCL))  ;; 1 = le point libre est amorce
(define *phys-rr*   (new 'global 'array 'float PHYS-SC))   ;; §23 elongation radiale, unites de jeu
;; [NOTE-79] L'ELONGATION RADIALE PAR MAILLON. Depuis le cycle 32 ce n'est plus un miroir de mesure :
;; c'est la valeur que LIT le solveur (terme `rdr` du tenseur de §38, plus bas). `*phys-rr*` ne
;; garde que celle du maillon RACINE. -> jak-hd-physics-NOTES.md
(define *phys-rrl*  (new 'global 'array 'float PHYS-SCL))  ;; §23 elongation radiale PAR MAILLON
(define *phys-rrm*  (new 'global 'array 'float PHYS-SC))   ;; |elongation|/B0 max fenetre, TOUS maillons
(define *phys-rrr*  (new 'global 'array 'float PHYS-SC))   ;; le meme AVANT la borne §22 (anti-saturation)
;; [NOTE-81] LES MEMES TROIS, RESOLUS PAR MAILLON — MESURE SEULE, le solveur ne les lit pas. -> jak-hd-physics-NOTES.md
(define *phys-rrml* (new 'global 'array 'float PHYS-SCL))  ;; max fenetre APRES la borne, par maillon
(define *phys-rrrl* (new 'global 'array 'float PHYS-SCL))  ;; le meme AVANT la borne, par maillon
(define *phys-rrsl* (new 'global 'array 'float PHYS-SCL))  ;; frames ou la borne a mordu, par maillon
;; [NOTE-82] LA DECOMPOSITION EXACTE DE `dr0`, RELEVEE A LA FRAME DE L'ARGMAX. -> jak-hd-physics-NOTES.md
(define *phys-rrol* (new 'global 'array 'float PHYS-SCL))  ;; (A) (ml-bl)/B0 : l'OS hors de sa sphere
(define *phys-rrcl* (new 'global 'array 'float PHYS-SCL))  ;; (B) dot(cp-px,m^)/B0 : la CHAIR au-dela
(define *phys-rrtl* (new 'global 'array 'float PHYS-SCL))  ;; (C) dot(cp-tg,m^)/B0 : la CHAIR loin de SA cible
(define *phys-cddl* (new 'global 'array 'float PHYS-SCL))  ;; |cp-tg|/B0 : la NORME du meme ecart ([NOTE-84])
;; Frames ou la borne §22 du COM a effectivement mordu. Un limiteur qui mord en PERMANENCE ne
;; borne plus, il remplace la mesure par sa propre valeur — c'est ce qui vient d'arriver au canal
;; de deformation (25.00 sur les dix fenetres). On le compte, exactement comme `*phys-twsat*`.
(define *phys-rrsat* 0)
(define *phys-prsm* (new 'global 'array 'float PHYS-SC))  ;; §23 aplatissement de contact, max fenetre
(define *phys-prsr* (new 'global 'array 'float PHYS-SC))  ;; le meme AVANT plafond (anti-saturation)
;; [NOTE-96] LES DEUX ENTREES DU TENSEUR, MESUREES AVANT LEUR PLAFOND. -> jak-hd-physics-NOTES.md
(define *phys-dynr* (new 'global 'array 'float PHYS-SC))  ;; `dl` AVANT `fmin PHYS-DYN-MAX`
(define *phys-dynn* (new 'global 'array 'float PHYS-SC))  ;; frames ou `dl` a mordu le plafond
(define *phys-prsn* (new 'global 'array 'float PHYS-SC))  ;; frames ou `pr0` a mordu le sien
(define *phys-dyna* (new 'global 'array 'float PHYS-SC))  ;; frames comptees, denominateur commun
;; [NOTE-97] CYCLE 36 ETAPE 1 — LA NATURE DE L'ENTREE DE PRESSION DU TENSEUR. -> jak-hd-physics-NOTES.md
(define *phys-cpa* (new 'global 'array 'float (* 7 PHYS-SCL)))  ;; par MAILLON : npf/pmax/psum/lastsw
;; [NOTE-105] CYCLE 37 ETAPE 1 — 4=slast 5=nlast 6=p1, LE GROUPE DE COLLISION SEULE. -> jak-hd-physics-NOTES.md
(define *phys-cpi* (new 'global 'array 'float (* 7 PHYS-SC)))   ;; les memes, releves a l'ARGMAX de `cl`
(define *phys-cpd* (new 'global 'array 'float PHYS-SC))         ;; domaine : frames ou une poussee a tire
;; [NOTE-109] CYCLE 37 ETAPE 2 — LE CUMUL PAR BRANCHE, ET L'ABLATION DE LA SPHERE PROXIMALE.
;; `*phys-cpc*` cumule sur TOUTES les frames depuis la derniere remise a zero de diagnostic :
;; 0 = nombre de poussees, 1 = somme de leurs modules (u), 2 = la meme sur les balayages 34-45.
;; C'est un AGREGAT, pas un maximum de fenetre : la question « la boucle converge-t-elle » est une
;; question de POPULATION, et le cycle 37 etape 1 a paye pour l'apprendre.
(define *phys-cpc* (new 'global 'array 'float (* 3 PHYS-SC)))
;; 1 = les SPHERES PROXIMALES cessent d'etre des obstacles. 0 EN LIVRAISON.
(define *phys-prox-off* 0)
(define *phys-swc* 0)                                           ;; ordinal d'appel de phys-collide-chain
(define *phys-vp*   (new 'global 'inline-array 'vector PHYS-SC))  ;; vitesse de pointe, frame -1
(define *phys-tw*   (new 'global 'array 'float PHYS-SC))   ;; §29 torsion : angle du TISSU (rad)
(define *phys-twv*  (new 'global 'array 'float PHYS-SC))
(define *phys-twa*  (new 'global 'array 'float PHYS-SC))   ;; roulis absolu cumule de l'ANCRE
(define *phys-a0m*  (new 'global 'inline-array 'matrix PHYS-SC))  ;; la matrice de l'ancre, frame -1
;; [NOTE-83] SPEC 37 — LA MOITIE TRANSLATION DU REBASE. -> jak-hd-physics-NOTES.md
(define *phys-anp*  (new 'global 'inline-array 'vector PHYS-SC))  ;; la POSITION de l'ancre, frame -1
(define *phys-twok* (new 'global 'array 'int32 PHYS-SC))
(define *phys-twm*  (new 'global 'array 'float PHYS-SC))   ;; |torsion| max sur la fenetre (mesure)
(define *phys-twr*  (new 'global 'array 'float PHYS-SC))   ;; torsion RELATIVE ecrite dans la 3x3
(define *phys-twsat* 0)     ;; frames ou la saturation douce de la torsion a mordu (limiteur declare)
;; La matrice de deformation de la chaine, en repere MONDE, rebatie a chaque frame. Elle vaut
;; l'identite tant que rien n'est arme : `matrix*!` par l'identite ne change pas un bit.
(define *phys-dfm* (new 'global 'inline-array 'matrix PHYS-SC))
;; LA MEME DEFORMATION, MAIS EN ESPACE ANCRE — et c'est celle-la qui est MESURABLE. `*phys-dfm*`
;; est conjuguee en monde (`w2l . A . am`), donc illisible depuis la trace sans refaire la
;; conjugaison. Le cycle 26 a du RECONSTRUIRE `A` hors moteur a partir de `PHYSORI2` (les trois
;; echelles de `dfa`) et du triedre, ce qui laissait dehors `dfb` (etirement dynamique de SPEC 38)
;; et `dfc` (pression de contact de SPEC 23) : le COM publie n'etait donc que PARTIEL. Publier `A`
;; telle quelle supprime la reconstruction ET l'omission. Ecriture SEULE, aucun lecteur dans le
;; solveur : ce tableau ne peut pas deplacer un joint.
(define *phys-dfa* (new 'global 'inline-array 'matrix PHYS-SC))
;; SPEC 33/34 — la poussee de contact CUMULEE sur la frame et le coefficient du volume qui a
;; decide. La restitution ne peut pas s'appliquer dans `phys-collide-chain` : elle y serait
;; appliquee jusqu'a 15 fois par frame (8 + 3 + 4 balayages). Elle s'applique UNE fois, apres.
(define *phys-cpu* (new 'global 'inline-array 'vector PHYS-SCL))
(define *phys-cpe* (new 'global 'array 'float PHYS-SCL))
(define *phys-rstp* (new 'global 'inline-array 'vector PHYS-SCL)) ;; normale en attente de mesure
(define *phys-rstn* 0)      ;; contacts ou une restitution a ete appliquee sur la fenetre
(define *phys-rstm* 0)      ;; sorties effectivement RELUES la frame suivante
(define *phys-rstin* 0.0)   ;; somme des vitesses normales ENTRANTES (u/frame)
(define *phys-rstout* 0.0)  ;; somme des vitesses normales SORTANTES, RELUES (0bis), pas deduites
(define *phys-rstsum* 0.0)  ;; somme des coefficients appliques (lit le melange 0.06 / 0.02)
(define *phys-rst-off* 0)   ;; 1 = restitution DESARMEE (controle negatif de la salle)
(define *phys-rst-k* 1.0)   ;; multiplicateur du controle POSITIF (1.0 = la spec)
;; LE MEME INSTANT QUE `*phys-lsv*`, MAIS DANS LE TRIEDRE DE L'ANCRE.
;; NATURE : deplacement instantane signe du maillon par rapport a sa pose d'auteur.
;; REPERE : triedre orthonorme de l'ANCRE (torse), jamais le monde — un maillon herite du mouvement
;;   de son parent, et c'est en repere monde que ce mouvement propre devient illisible ; une
;;   frequence PAR AXE (§24) ne peut structurellement pas se lire sur des x/y/z monde.
;; INSTANTANEE, ecrasee chaque frame, au meme point de la frame que `*phys-lsv*`.
;; LECTURE QUAND LE DEFAUT EST ABSENT : (0,0,0) exactement, a la pose du modele.
(define *phys-lda* (new 'global 'array 'float (* PHYS-SCL 3)))

;; [NOTE-58] LA MEME DEVIATION, NON NORMALISEE — ET C'EST LA CORRECTION D'UN AVEUGLEMENT DE `*phys-ld -> jak-hd-physics-NOTES.md
(define *phys-ldb* (new 'global 'array 'float (* PHYS-SCL 3)))

(define *phys-tx*  (new 'global 'array 'float PHYS-SC))   ;; ecart de pointe, frame precedente
(define *phys-ty*  (new 'global 'array 'float PHYS-SC))
(define *phys-tz*  (new 'global 'array 'float PHYS-SC))
(define *phys-thas* (new 'global 'array 'int32 PHYS-SC))

;; [NOTE-107] SPEC 5 — L'ANIMATION D'AUTEUR. Detection PAR CHAINE, dans le repere de l'anc -> jak-hd-physics-NOTES.md
(define *phys-rtx*  (new 'global 'array 'float PHYS-SC))
(define *phys-rty*  (new 'global 'array 'float PHYS-SC))
(define *phys-rtz*  (new 'global 'array 'float PHYS-SC))
(define *phys-rhas* (new 'global 'array 'int32 PHYS-SC))
(define *phys-ahit* (new 'global 'array 'float PHYS-SC))
(define *phys-aok*  (new 'global 'array 'float PHYS-SC))
(define *phys-adot* (new 'global 'array 'float PHYS-SC))
(define *phys-anrm* (new 'global 'array 'float PHYS-SC))
(define *phys-dsum* (new 'global 'array 'float PHYS-SC))   ;; somme |delta ecart| sur ces frames
(define *phys-usum* (new 'global 'array 'float PHYS-SC))   ;; somme |delta auteur| sur ces frames
;; somme, sur TOUTE la course, du deplacement MONDE de la pose d'auteur de la pointe. Une chaine dont
;; ce nombre est nul pendant que le personnage est secoue n'est pas attachee au personnage : c'est la
;; seconde preuve, independante du rapport de distance, qu'un joint a ete envoye ailleurs.
(define *phys-tmov* (new 'global 'array 'float PHYS-SC))
;; frames, sur toute la course, ou cette chaine avait au moins une paire (lien, volume) EN CONTACT.
;; Publie a cote de la penetration : un zero sur une chaine qui n'a jamais rien touche ne dit pas la
;; meme chose qu'un zero sur une chaine qui a frotte le crane pendant 3000 frames.
(define *phys-conf* (new 'global 'array 'float PHYS-SC))
;; seuil de detection, en unites de jeu par frame (4096 u = 1 m). Un os que l'anim ne touche pas ne
;; bouge PAS dans ce repere : le seuil separe l'intention du bruit numerique de la cascade de
;; matrices, il ne filtre aucun mouvement reel.
(defconstant PHYS-AUTH-EPS 1.0)
;; tolerance de l'identite « position ecrite - pose d'auteur == ecart simule remis dans le monde »,
;; en unites de jeu. Les deux membres valent ~1e2 unites et une rotation de flottant 32 bits y laisse
;; ~1e-5. 0.05 u (12 micrometres) est trois mille fois au-dessus de ce bruit et vingt fois en dessous
;; du plus petit deplacement d'auteur detectable (1 u) : la fenetre est large des deux cotes.
(defconstant PHYS-AUTH-TOL 0.05)

;; [NOTE-111] MARGE DE SORTIE de la projection de collision, en unites de jeu (0.5 u = 0.1 -> jak-hd-physics-NOTES.md
(defconstant PHYS-FIN-ITERS 4)

(defconstant PHYS-COL-MARGIN 0.5)

;; SPEC 10 `SupineProjectionScale = 0.70` : la projection avant perd 30 % contre le thorax. BANDE que
;; la chair cede avant que le mur ne redevienne dur, en B0 (SPEC 6 : 602 u de CHAIR, pas l'os). Elle
;; ne se regle pas, sa spec l'ecrit. Voir `phys-vol-floor` / `phys-vol-yield`.
(defconstant PHYS-FLESH-YIELD 0.30)

;; [NOTE-16] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md

;; [NOTE-17] SENTINELLE « aucun contact ». Un residu de penetration reel ne depasse jamais quelques m -> jak-hd-physics-NOTES.md
(defconstant PHYS-SIDE-COS 0.05)
(defconstant PHYS-SIDE-COS2 0.0025)

(defconstant PHYS-NOCONTACT -1000000000.0)
(defconstant PHYS-NOCONTACT-LIMIT -1000000.0)

;; injection de defaut pour le CONTROLE POSITIF (SPEC 7 : tout zero exige un controle qui a fait
;; MONTER le compteur). 0 = desarme. > 0 = chaque lien libre est pousse de N unites vers l'interieur
;; du corps APRES la resolution : la penetration residuelle doit alors exploser. La salle arme,
;; mesure, desarme.
(define *phys-inject* 0.0)
;; combien de poussees ont REELLEMENT eu lieu. Un controle positif qui n'a rien injecte ne prouve
;; rien : c'est ce compteur, pas la valeur armee, qui dit que le defaut a ete pose.
(define *phys-injn* 0)

;; RETARD D'UNE FRAME injecte pour le CONTROLE POSITIF du canal d'auteur. 0 = desarme. Arme, la
;; position ecrite est batie sur la pose d'auteur de la frame PRECEDENTE au lieu de celle-ci : c'est
;; exactement le defaut que la SPEC 5 interdit (la physique retarde l'animation). Le compteur
;; d'identite doit alors s'effondrer. Sans ce controle, « l'animation passe intacte » serait une
;; affirmation invérifiable sur notre propre construction.
(define *phys-auth-lag* 0)

;; ce que les limiteurs RETIRENT de mouvement, mesure et non estime (SPEC 7 : un suppresseur se
;; chiffre). Deux limiteurs peuvent reculer un lien :
;;   retreat  quand la projection ne trouve aucun point admissible, le lien recule vers sa pose de
;;            modele — la seule position admissible par construction ;
;;   raddrop  quand un lien SEUL (pas de parent simule) depasse le rayon que le mesh lui mesure.
(define *phys-raddrop-n*   0)
(define *phys-raddrop-sum* 0.0)
;; paires (lien, volume) ou le lien est ENTIEREMENT dans le volume a sa pose de modele : pas de
;; surface devant lui, donc rien a traverser. Comptees a chaque mesure, publiees par la salle.
(define *phys-buried-n*    0)
;; ... et le MEME compte, mais PAR CHAINE et UNE SEULE FOIS PAR FRAME. Le compteur global ci-dessus
;; est incremente par chaque appel de `phys-link-pen`, y compris les douze pas de dichotomie du
;; recul : son total (369 876) est un nombre d'evaluations, pas un nombre de paires enfouies, et il
;; ne dit pas QUELLE chaine est enfouie. Or c'est exactement la question que pose « le bas du
;; pantacourt est avale a l'interieur des mollets ». Ce drapeau n'est leve que pendant la passe de
;; MESURE (phys-pen-chain), donc le compte par chaine est un compte de frames x paires.
(define *phys-buried-tally* 0)
;; INVERSIONS. Owner 2026-08-11 : « j'ai encore vu un de ses seins retourne vers l'interieur ».
;; Cause : le ressort est symetrique autour de l'ancre, donc le cote oppose est un equilibre STABLE
;; mais FAUX, et la contrainte de longueur se taisait dans le cas degenere (distance sous 1e-4), ce
;; qui laissait la porte ouverte. Comptees ici, remises a zero par la salle, et un controle positif
;; les provoque expres pour prouver que le compteur voit quelque chose.
(define *phys-invn*    0)      ;; corrections appliquees (le solveur a remis un lien de son cote)
(define *phys-invres*  0)      ;; INVERSIONS RESIDUELLES apres tout le solveur : doit valoir ZERO
(define *phys-invfix*  0)
(define *phys-inv-inject* 0)
;; RE-ASSISES : liens dont la pose du modele est hors de portee de leur porteur et que le moteur
;; replace sur lui. Owner/superviseur 2026-08-11 : « pantflapL retablie — elle avait ete supprimee du
;; fichier au lieu d'etre REPAREE ».
(define *phys-reseat-n* 0)
;; COMBIEN DE FOIS LA PROFONDEUR A ETE POUSSEE TANGENTIELLEMENT DANS LA BOUCLE DE FINITION.
;; Regle 0 : le correctif ci-dessous ne se prouve pas par son commentaire. Ce compteur dit qu'il a
;; TIRE, et `PHYSTAN` le publie ; a zero, le bloc n'a jamais ete atteint et le tableau ment.
(define *phys-tan-n* 0)
;; la somme des profondeurs que ces poussees ont vues a l'entree (u de jeu) : elle donne l'ordre de
;; grandeur de ce qui restait a corriger apres les balayages, que le compte seul ne dit pas.
(define *phys-tan-d* 0.0)
(define *phys-tan-e* 0.0)
;; ... et combien de ces re-assises ont du retomber sur l'ancienne heuristique (rayon le long de
;; l'os du porteur) faute de bind-pose lisible. Doit valoir ZERO : un secours silencieux est un
;; defaut qui attend, et c'est celui-la qui posait le pan du pantacourt dans le mollet.
(define *phys-reseat-fb* 0)
;; [NOTE-97b] PIERRE TOMBALE — les deux compteurs de REPLI DU RECUL, retires au cycle 36. -> jak-hd-physics-NOTES.md
;; [NOTE-101b] ---------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(define *phys-sat-n* 0)
(define *phys-sat-sum* 0.0)
;; SPEC 21 SOUS SA FORME DE FORCE (le RESSORT QUI RAIDIT, 2026-08-14). Combien de SOUS-PAS ont ete
;; integres au-dela du genou de SPEC 22, donc avec un facteur de raideur > 1.
;;   NATURE : un COMPTE d'evenements (sous-pas), pas une longueur.
;;   REPERE : sans objet — c'est un compte.
;;   LECTURE QUAND LE DEFAUT EST ABSENT : 0 exactement. Sous 0.42 B0 le facteur vaut 1.0 et la garde
;;            `(> dd kn)` ne s'ouvre pas : le regime subtil que l'owner a valide n'incremente rien.
;; CE N'EST PAS UN SUPPRESSEUR ET IL N'A PAS DE `sum` : une force ne retire pas d'energie, elle la
;; rend. Ce qui en retire, c'est le plafond POSITIONNEL, et lui garde ses deux compteurs ci-dessus.
(define *phys-stif-n* 0)
(define *phys-cwn* 0)        ;; §21/§22 fois ou le MUR du point libre a mordu
(define *phys-cwsum* 0.0)    ;; §7 ce qu'il a retire, unites de jeu (un suppresseur se chiffre)
;; [NOTE-18] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(define *phys-cvh* (new 'global 'array 'int32 (* PHYS-SCL PHYS-COLS)))
;; LE SEAU DU CONFLIT, PAR CHAINE — combien de fois le volume `ci` s'est DISPUTE un lien de la
;; chaine avec au moins un autre volume, dans la meme frame. Distinct de `*phys-cvh*`, qui compte la
;; penetration RESIDUELLE apres solveur et n'est alimente que par la fenetre de controle positif
;; (mesure du 2026-08-13 : `meshpen_max = 0.0000` sur toutes les phases de mesure, donc les 90 de
;; `ROOM-CONTACT-VOL` sont les 90 frames de PCON). Celui-ci est alimente par la passe de SELECTION,
;; donc par toute la course, et il repond a la question que `ROOM-VOLPRIO` pose sans y repondre :
;; `chestR` conflicte 85895 fois contre 2264 a gauche — MAIS AVEC QUI ?
(define *phys-cfh* (new 'global 'array 'int32 (* PHYS-SC PHYS-COLS)))

;; [NOTE-64] LE DOMAINE D'UNE PAIRE, ET PAS SEULEMENT SES CONTACTS — SPEC 33. -> jak-hd-physics-NOTES.md
(define *phys-depsigned* 0.0)
(define *phys-cdm* (new 'global 'array 'float (* PHYS-SC PHYS-COLS)))
(define *phys-cfl* (new 'global 'array 'float (* PHYS-SC PHYS-COLS)))
(define *phys-cdmok* (new 'global 'array 'int32 (* PHYS-SC PHYS-COLS)))

;; [NOTE-19] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defconstant PHYS-BSURF-SETS 64)
(defconstant PHYS-BSURF-MAX  12)
(defconstant PHYS-SB  (* PHYS-SLOTS PHYS-BSURF-SETS))
(define *phys-bsk*  (new 'global 'array 'int32 PHYS-SB))   ;; index de joint de l'ensemble
(define *phys-bsn*  (new 'global 'array 'int32 PHYS-SB))   ;; echantillons retenus
(define *phys-bsr*  (new 'global 'array 'float PHYS-SB))   ;; rayon englobant (phase large)
(define *phys-bsp*  (new 'global 'inline-array 'vector (* PHYS-SB PHYS-BSURF-MAX)))
(define *phys-bsnm* (new 'global 'inline-array 'vector (* PHYS-SB PHYS-BSURF-MAX)))
(define *phys-slot-nbsurf* (new 'global 'array 'int32 PHYS-SLOTS))
;; La pire ENTREE sous la peau, par chaine, sur la fenetre de mesure.
;; NATURE : une profondeur signee, en unites de jeu, positive quand le lien est SOUS la surface.
;; REPERE : le monde, a la frame ecrite — la meme position que celle dont `meshpen` est tire, pour
;;          que les deux colonnes soient comparables terme a terme.
;; LECTURE QUAND LE DEFAUT EST ABSENT : 0. Un lien qui reste dehors n'ecrit jamais rien ici.
(define *phys-skinpen* (new 'global 'array 'float PHYS-SC))
;; combien d'echantillons ont ete VRAIMENT testes : un zero avec un compteur de tests a zero veut
;; dire « je n'ai pas regarde », pas « rien ne penetre ». Les deux se distinguent, toujours.
(define *phys-skintest* 0)
;; ARMEE PAR LA SALLE SEULE (0 par defaut). 55 ensembles x 12 echantillons par lien et par frame,
;; c'est le prix d'une mesure, pas d'un rendu : le JEU ne doit pas le payer sur le telephone de
;; l'owner. Meme forme que `*phys-prio-meas*`, dont l'armement avait deja porte la course de 420 a
;; 708 s. La phase large (rayon englobant) coupe l'essentiel, mais un cout qu'on ne mesure pas est
;; un cout qu'on decouvre chez lui.
(define *phys-skin-meas* 0)

(defconstant PHYS-DG 35)           ;; 31/32/33/34 = [NOTE-92] l'attribution de `comex`, et SON MAILLON
(define *phys-dg* (new 'global 'array 'float (* PHYS-SC PHYS-DG)))
;; [NOTE-92] LE CENTRE DE CHAIR APRES ROTATION ET AVANT DEFORMATION. -> jak-hd-physics-NOTES.md
(define *phys-c1* (new 'global 'array 'float 3))
;; etat de contrainte de la frame precedente, par (lien, volume), pour compter les bascules.
;; 1 bit par volume, un mot par lien : PHYS-COLS <= 96 tient sur trois mots de 32 bits.
(defconstant PHYS-FLIPW 3)
(define *phys-fl* (new 'global 'array 'int32 (* PHYS-SCL PHYS-FLIPW)))
(define *phys-flhas* (new 'global 'array 'int32 PHYS-SCL))
;; CONTROLE POSITIF de l'auto-collision : arme, l'exclusion chaine<->ses propres volumes est levee.
;; Le compteur `selfcol` doit alors monter — sinon il ne mesure rien.
(define *phys-self-inject* 0)
;; ARME, LA CONTRAINTE DE COTE EST LEVEE et son compteur doit MONTER. Un compteur tombe a zero
;; est soit une correction, soit un predicat devenu inevaluable — le piege de `(= l 0)`.
(define *phys-side-off* 0)
;; [NOTE-54] CONTROLE DE LA CONTRAINTE DE LONGUEUR — 1 = DESARMEE. RESTE A 0 EN LIVRAISON. -> jak-hd-physics-NOTES.md
(define *phys-len-off* 0)
;; [NOTE-53] CONTROLE k=4 — 1 = LE MUR DE COLLISION EST DESARME (`feff` -> PHYS-VOL-FREE), sur la
;; fenetre d'orientation seule. C'est le suspect que le cycle 13 a dimensionne sans le desarmer.
(define *phys-col-off* 0)
;; [NOTE-65] CONTROLE k=5 — 1 = LA BORNE §22 DU CANAL RADIAL EST DESARMEE (`rcap` -> +inf), -> jak-hd-physics-NOTES.md
(define *phys-rr-off* 0)

;; `*phys-njoint*` retiree : ecrite chaque step, RELUE PAR PERSONNE. Classe de `*phys-lmean*`.

;; deltas de propagation aux descendants non simules (les verres de lunettes pendent sous
;; gogglesMid : si on bouge le milieu sans eux, ils se decrochent).
(define *phys-dmat* (new 'global 'inline-array 'matrix PHYS-JOINTS))
(define *phys-dhas* (new 'global 'array 'int32 PHYS-JOINTS))

;; ------------------------------------------------------------------------------------------------
;; petits utilitaires
;; ------------------------------------------------------------------------------------------------
(defun phys-mi->f ((v int))
  "milli-unites du magasin C++ -> flottant."
  (/ (the float v) 1000.0))

(defun phys-slot-for-pid ((pid int))
  "slot deja alloue a ce pid, -1 sinon."
  (let ((r -1))
    (dotimes (i PHYS-SLOTS)
      (when (and (< r 0) (= (-> *phys-slot-pid* i) pid)) (set! r i)))
    r))

(defun phys-slot-alloc ((pid int))
  "premier slot libre, -1 si plein."
  (let ((r -1))
    (dotimes (i PHYS-SLOTS)
      (when (and (< r 0) (zero? (-> *phys-slot-pid* i))) (set! r i)))
    (when (>= r 0) (set! (-> *phys-slot-pid* r) pid))
    r))

;; ------------------------------------------------------------------------------------------------
;; INIT — resolution des chaines DEPUIS LE RIG. Le moteur ne porte aucun nom de joint : il parcourt
;; les joints du squelette HD, demande au magasin C++ le role de chaque NOM, et se construit ses
;; chaines. Une chaine absente du fichier de donnees n'existe pas ; un joint absent du rig non plus.
;; ------------------------------------------------------------------------------------------------
(defun jak-hd-physics-init ((obj jak-hd))
  (when (and (nonzero? (-> obj draw)) (nonzero? (-> obj draw jgeo)))
    (let* ((agname (-> *hd-ag-names* (-> obj entry)))
           (nch    (pc-physics-num-chains agname)))
      (cond
        ((<= nch 0)
         (format 0 "[HD-PHYS] no chain data for ~S — physics inert for this model~%" agname))
        (else
         (let ((slot (phys-slot-alloc (the int (-> obj pid)))))
           (cond
             ((< slot 0)
              (format 0 "[HD-PHYS] no free sim slot — physics inert for ~S~%" agname))
             (else
              (let ((njoint (-> obj draw jgeo length))
                    (nc     (min nch PHYS-CHAINS)))
                (set! (-> *phys-slot-nch* slot) nc)
                ;; remise a zero de la topologie du slot
                (dotimes (c PHYS-CHAINS)
                  (let ((sc (+ (* slot PHYS-CHAINS) c)))
                    (set! (-> *phys-nlink* sc) 0)
                    (set! (-> *phys-anchor* sc) -1)
                    (set! (-> *phys-warm* sc) 0)
                    (set! (-> *phys-thas* sc) 0)
                    (set! (-> *phys-rhas* sc) 0)
                    ;; le triedre de SPEC 24/29 se classe lui aussi a la premiere frame utile, sur
                    ;; la pose retargetee : un slot reutilise doit le reclasser, sinon la chaine
                    ;; heriterait de l'orientation d'un autre acteur. Les trois facteurs partent a
                    ;; 1.0 — l'isotropie stricte — de sorte qu'une chaine non classee integre
                    ;; exactement ce qu'elle integrait avant que ce bloc n'existe.
                    (set! (-> *phys-axok* sc) 0)
                    (set! (-> *phys-axan* sc) 0)
                    (set! (-> *phys-axsrc* sc) 0)
                    (dotimes (ii 3)
                      (set! (-> *phys-axs* (+ (* sc 3) ii)) 1.0)
                      (set! (-> *phys-axsep* (+ (* sc 3) ii)) 0.0))
                    ;; SPEC 37 — « rebase on teleportation / level transition ». Un slot reutilise
                    ;; redemande TOUTES ses references : triedre, torsion, mode secondaire. Un etat
                    ;; qui survit a un respawn est un etat qui vieillit, et sa spec l'interdit.
                    (set! (-> *phys-fok* sc) 0)
                    (set! (-> *phys-dfon* sc) 0)
                    (set! (-> *phys-dfdet* sc) 1.0)
                    (set! (-> *phys-twok* sc) 0)
                    (set! (-> *phys-tw* sc) 0.0)
                    (set! (-> *phys-twv* sc) 0.0)
                    (set! (-> *phys-twa* sc) 0.0)
                    (set! (-> *phys-twm* sc) 0.0)
                    (set! (-> *phys-sec* sc) 0.0)
                    (set! (-> *phys-secv* sc) 0.0)
                    (set! (-> *phys-secm* sc) 0.0)
                    (set! (-> *phys-secr* sc) 0.0)
                    (set! (-> *phys-dynm* sc) 0.0)
                    (set! (-> *phys-prsm* sc) 0.0)
                    (set! (-> *phys-prsr* sc) 0.0)
    (set! (-> *phys-dynr* sc) 0.0)
    (set! (-> *phys-cpd* sc) 0.0)
    (dotimes (k 7) (set! (-> *phys-cpi* (+ (* 7 sc) k)) 0.0))
    (set! (-> *phys-dynn* sc) 0.0)
    (set! (-> *phys-prsn* sc) 0.0)
    (set! (-> *phys-dyna* sc) 0.0)
                    ;; SPEC 37 « rebase on teleportation / level transition » : le degre de liberte
                    ;; radial est un ETAT, il repart donc de zero comme la torsion et le mode
                    ;; secondaire. Un tissu qui garderait son elongation a travers un respawn
                    ;; violerait §9 des la premiere frame.
                    (set! (-> *phys-rr* sc) 0.0)
                    (dotimes (ll PHYS-LINKS)
                      (set! (-> *phys-rrl* (+ (* sc PHYS-LINKS) ll)) 0.0)
                      (set! (-> *phys-rrml* (+ (* sc PHYS-LINKS) ll)) 0.0)
                      (set! (-> *phys-rrrl* (+ (* sc PHYS-LINKS) ll)) 0.0)
                      (set! (-> *phys-rrsl* (+ (* sc PHYS-LINKS) ll)) 0.0)
                      (set! (-> *phys-rrtl* (+ (* sc PHYS-LINKS) ll)) 0.0)
                      (set! (-> *phys-cddl* (+ (* sc PHYS-LINKS) ll)) 0.0)
                      (set! (-> *phys-rok* (+ (* sc PHYS-LINKS) ll)) 0))
                    (set! (-> *phys-rrm* sc) 0.0)
                    (set-vector! (-> *phys-vp* sc) 0.0 0.0 0.0 0.0)
                    (dotimes (ii 3)
                      (set! (-> *phys-dfs* (+ (* sc 3) ii)) 1.0))
                    ;; la direction de repos du materiau se releve a la premiere frame utile, sur la
                    ;; pose retargetee : un slot reutilise doit la redemander, sinon la chaine
                    ;; heriterait du repos d'un autre acteur.
                    (dotimes (l PHYS-LINKS)
                      (set! (-> *phys-ucap* (+ (* sc PHYS-LINKS) l)) 0))))
                ;; --- 1. les joints portent les chaines : on lit le rig, pas une liste en dur ---
                (dotimes (k njoint)
                  (let* ((jn   (-> obj draw jgeo data k name))
                         (role (if jn (pc-physics-joint-role agname jn) -1)))
                    (when (>= role 0)
                      (let ((c    (shr role 8))
                            (link (logand role 255)))
                        ;; UNE TRONCATURE SILENCIEUSE EST UN DE-SCOPE (2026-08-13). Un maillon
                        ;; au-dela de PHYS-LINKS etait simplement ignore, sans un mot : la chaine
                        ;; tournait avec moins d'os que les donnees en declarent et rien ne le
                        ;; disait. L'injection de joints de ce cycle amene lbang/rbang a EXACTEMENT
                        ;; 4 maillons, soit le plafond — le prochain os ajoute tomberait dans ce
                        ;; trou. On ne releve pas le plafond (il dimensionne plusieurs tableaux),
                        ;; on le rend BRUYANT.
                        (when (and (< c nc) (>= link PHYS-LINKS))
                          (format 0 "PHYSTRUNC c=~D link=~D cap=~D joint=~S~%"
                                  c link PHYS-LINKS jn))
                        (when (and (< c nc) (< link PHYS-LINKS))
                          (let ((sc (+ (* slot PHYS-CHAINS) c)))
                            (set! (-> *phys-joint* (+ (* sc PHYS-LINKS) link)) k)
                            (when (>= (+ link 1) (-> *phys-nlink* sc))
                              (set! (-> *phys-nlink* sc) (+ link 1)))
                            ;; l'ancre est le parent RIG du lien 0 (255 = racine -> pas d'ancre)
                            (when (zero? link)
                              (let ((p (the int (-> (-> obj khd-par) k))))
                                (set! (-> *phys-anchor* sc) (if (= p 255) -1 p))))))))))
                ;; --- 2. les parametres, une fois, depuis le fichier de donnees ---
                (let ((armed 0) (links 0))
                  (dotimes (c nc)
                    (let ((sc (+ (* slot PHYS-CHAINS) c)))
                      (set! (-> *phys-stiff* sc)  (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-STIFF)))
                      (set! (-> *phys-damp* sc)   (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-DAMP)))
                      (set! (-> *phys-grav* sc)   (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-GRAV)))
                      (set! (-> *phys-couple* sc) (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-COUPLE)))
                      (set! (-> *phys-hang* sc)   (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-HANG)))
                      (let ((m (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-MASS))))
                        (set! (-> *phys-mass* sc) (if (< m 0.01) 1.0 m)))
                      (set! (-> *phys-fam* sc)    (the int (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-FAMILY))))
                      (set! (-> *phys-rootlk* sc) (the int (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-ROOTLK))))
                      (set! (-> *phys-rootgr* sc) (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-GRADIENT)))
                      (set! (-> *phys-b0* sc) (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-B0)))
                      ;; PREUVE D'EXECUTION (regle 0) : un zero silencieux au parseur C++ ou a la
                      ;; garde `param_id < kPhysNumChainParams` ferait retomber la borne de SPEC 22
                      ;; sur l'os — 1.62x trop large — sans qu'aucun chiffre ne le dise. La ligne ne
                      ;; s'imprime que pour les chaines qui portent la cle : son absence est une
                      ;; mesure. L'os se lit a cote, sur `PHYSBONE`, a l'execution.
                      (when (> (-> *phys-b0* sc) 0.0)
                        (format 0 "[HD-PHYS] b0 c=~D flesh=~f anc=~D~%" c (-> *phys-b0* sc) (-> *phys-anchor* sc)))
                      ;; PREUVE D'EXECUTION (regle 0) : `gradient=` traverse le fichier de donnees,
                      ;; le parseur C++ et la garde `param_id < kPhysNumChainParams` avant d'arriver
                      ;; ici, et un zero silencieux a l'une de ces couches rendrait la racine
                      ;; graduee INERTE sans qu'aucun chiffre ne le dise -- on croirait avoir mesure
                      ;; le correctif alors qu'on aurait mesure son absence. La ligne ne s'imprime
                      ;; que pour les chaines qui le declarent, donc son ABSENCE est aussi une mesure.
                      (when (> (-> *phys-rootgr* sc) 0.0)
                        (format 0 "[HD-PHYS] rootgrade c=~D g=~f~%" c (-> *phys-rootgr* sc)))
                      (set! (-> *phys-maxang* sc) (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-MAXANG)))
                      ;; rayons par lien : `radii=` s'il existe, sinon le `radius=` de la chaine
                      (let ((base (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-RADIUS))))
                        (dotimes (l PHYS-LINKS)
                          (let ((r (phys-mi->f (pc-physics-chain-link-radius-mi agname c l))))
                            (set! (-> *phys-rad* (+ (* sc PHYS-LINKS) l)) (if (< r 0.01) base r)))))
                      (when (> (-> *phys-nlink* sc) 0)
                        (+! armed 1)
                        (+! links (-> *phys-nlink* sc)))))
                  ;; --- 2 ter. SPEC 18 : les echantillons de surface, resolus vers des joints ---
                  ;; Meme forme que les colliders juste apres : on lit ce que le C++ expose et on
                  ;; resout les NOMS d'os vers des index du rig porteur. Un ensemble dont l'os
                  ;; n'existe pas sur ce rig est de la surface qui n'a jamais pu se lier : il est
                  ;; COMPTE, jamais avale en silence.
                  (set! (-> *phys-slot-nbsurf* slot) 0)
                  (let ((nbs (pc-physics-num-bsurf agname))
                        (nb 0)
                        (unbound 0)
                        (sb (* slot PHYS-BSURF-SETS)))
                    (dotimes (i (min nbs PHYS-BSURF-SETS))
                      (let ((found -1))
                        (dotimes (k njoint)
                          (let ((jn (-> obj draw jgeo data k name)))
                            (when (and jn (< found 0)
                                       (nonzero? (pc-physics-bsurf-is-joint agname i jn)))
                              (set! found k))))
                        (cond
                          ((< found 0) (+! unbound 1))
                          (else
                           (let ((nk (min (pc-physics-bsurf-count agname i) PHYS-BSURF-MAX))
                                 (br 0.0))
                             (when (> nk 0)
                               (set! (-> *phys-bsk* (+ sb nb)) found)
                               (set! (-> *phys-bsn* (+ sb nb)) nk)
                               (dotimes (q nk)
                                 (let ((qi (+ (* (+ sb nb) PHYS-BSURF-MAX) q))
                                       (pv (-> *phys-bsp* (+ (* (+ sb nb) PHYS-BSURF-MAX) q)))
                                       (nv (-> *phys-bsnm* (+ (* (+ sb nb) PHYS-BSURF-MAX) q))))
                                   (set-vector! pv
                                     (phys-mi->f (pc-physics-bsurf-mi agname i q 0))
                                     (phys-mi->f (pc-physics-bsurf-mi agname i q 1))
                                     (phys-mi->f (pc-physics-bsurf-mi agname i q 2)) 0.0)
                                   (set-vector! nv
                                     (phys-mi->f (pc-physics-bsurf-mi agname i q 3))
                                     (phys-mi->f (pc-physics-bsurf-mi agname i q 4))
                                     (phys-mi->f (pc-physics-bsurf-mi agname i q 5)) 0.0)
                                   (let ((l (vector-length pv)))
                                     (when (> l br) (set! br l)))
                                   qi))
                               ;; le rayon englobant vient des echantillons RETENUS, jamais du
                               ;; nombre declare : un prefixe ne peut alors que le RETRECIR, et
                               ;; jamais revendiquer une portee qu'il n'a pas.
                               (set! (-> *phys-bsr* (+ sb nb)) br)
                               (+! nb 1)))))))
                    (set! (-> *phys-slot-nbsurf* slot) nb)
                    ;; PREUVE D'EXECUTION (regle 0) : sans cette ligne, un fichier absent, un
                    ;; parseur muet ou un rig sans ces os rendraient la mesure identiquement nulle
                    ;; et indistinguable d'une peau que rien ne traverse.
                    (format 0 "[HD-PHYS] bsurf ag=~S sets=~D/~D lies=~D non-lies=~D~%"
                            agname nb nbs nb unbound))
                  ;; --- 3. les colliders, ajustes sur le mesh, resolus vers des index de joint ---
                  (let ((nco (min (pc-physics-num-colliders agname) PHYS-COLS)))
                    (set! (-> *phys-slot-nco* slot) nco)
                    (dotimes (ci nco)
                      (let ((sco (+ (* slot PHYS-COLS) ci)))
                        (set! (-> *phys-cj* sco) -1)
                        (set! (-> *phys-cj2* sco) -1)
                        (set! (-> *phys-cr* sco)  (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-RADIUS)))
                        (let ((r2 (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-RADIUS2))))
                          (set! (-> *phys-cr2* sco) (if (< r2 0.01) (-> *phys-cr* sco) r2)))
                        (set! (-> *phys-cox* sco) (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-OFFX)))
                        (set! (-> *phys-coy* sco) (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-OFFY)))
                        (set! (-> *phys-coz* sco) (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-OFFZ)))
                        (dotimes (k njoint)
                          (let ((jn (-> obj draw jgeo data k name)))
                            (when jn
                              (when (and (< (-> *phys-cj* sco) 0)
                                         (nonzero? (pc-physics-collider-is-joint agname ci jn)))
                                (set! (-> *phys-cj* sco) k))
                              (when (and (< (-> *phys-cj2* sco) 0)
                                         (nonzero? (pc-physics-collider-is-joint2 agname ci jn)))
                                (set! (-> *phys-cj2* sco) k)))))))
                    ;; --- 3a bis. CE QUE CHAQUE VOLUME EST, pour l'instantane de Jacobi et pour la
                    ;; --- priorite (DECISION 1). Deux proprietes STRUCTURELLES, lues sur le rig et
                    ;; --- sur les chaines deja chargees : aucune donnee nouvelle, aucun flag.
                    ;; ---   csim : ce volume est-il porte par un joint qu'une chaine SIMULE ?
                    ;; ---   cdep : la profondeur RIG du plus proche de la racine de ses deux joints.
                    (dotimes (ci nco)
                      (let ((sco (+ (* slot PHYS-COLS) ci)))
                        (set! (-> *phys-csim* sco) 0)
                        (set! (-> *phys-csok* sco) 0)
                        (set! (-> *phys-cdep* sco) 999)
                        (let ((cj  (-> *phys-cj* sco))
                              (cj2 (-> *phys-cj2* sco)))
                          ;; porte par un joint simule ?
                          (dotimes (c2 nc)
                            (let ((sc2 (+ (* slot PHYS-CHAINS) c2)))
                              (dotimes (l2 (-> *phys-nlink* sc2))
                                (let ((kj (-> *phys-joint* (+ (* sc2 PHYS-LINKS) l2))))
                                  (when (and (>= kj 0) (or (= cj kj) (= cj2 kj)))
                                    (set! (-> *phys-csim* sco) 1))))))
                          ;; profondeur rig : on remonte `khd-par` jusqu'a la racine (255)
                          (dotimes (which 2)
                            (let ((k0 (if (zero? which) cj cj2)))
                              (when (and (>= k0 0) (< k0 njoint))
                                (let ((d 0) (k k0) (guard 0))
                                  (while (and (>= k 0) (< k PHYS-JOINTS) (< guard 128))
                                    (let ((p (the int (-> (-> obj khd-par) k))))
                                      (cond
                                        ((or (= p 255) (>= p PHYS-JOINTS)) (set! k -1))
                                        (else (set! k p) (+! d 1))))
                                    (+! guard 1))
                                  (when (< d (-> *phys-cdep* sco))
                                    (set! (-> *phys-cdep* sco) d)))))))))
                    ;; --- 3b. LE VOLUME QUE CHAQUE LIEN PORTE. Par defaut sa demi-epaisseur,
                    ;; --- centree sur le joint (comportement precedent). Si ce joint declare deja
                    ;; --- une SPHERE ajustee sur le mesh, c'est ELLE — centre et rayon — parce que
                    ;; --- c'est le meme morceau de corps, qu'il bouge ou qu'il soit heurte.
                    (dotimes (c nc)
                      (let ((sc (+ (* slot PHYS-CHAINS) c)))
                        (dotimes (l PHYS-LINKS)
                          (let ((scl (+ (* sc PHYS-LINKS) l)))
                            (set! (-> *phys-lcr* scl) (-> *phys-rad* scl))
                            (set! (-> *phys-lcx* scl) 0.0)
                            (set! (-> *phys-lcy* scl) 0.0)
                            (set! (-> *phys-lcz* scl) 0.0)
                            (let ((kk (-> *phys-joint* scl)))
                              (when (>= kk 0)
                                (dotimes (ci nco)
                                  (let ((sco (+ (* slot PHYS-COLS) ci)))
                                    (when (and (= (-> *phys-cj* sco) kk) (< (-> *phys-cj2* sco) 0))
                                      (set! (-> *phys-lcr* scl) (-> *phys-cr* sco))
                                      (set! (-> *phys-lcx* scl) (-> *phys-cox* sco))
                                      (set! (-> *phys-lcy* scl) (-> *phys-coy* sco))
                                      (set! (-> *phys-lcz* scl) (-> *phys-coz* sco))
                                      (format 0 "[HD-PHYS] vol c=~D l=~D joint=~D r=~f -> r=~f off=~f~%"
                                              c l kk (-> *phys-rad* scl) (-> *phys-cr* sco)
                                              (sqrtf (+ (* (-> *phys-cox* sco) (-> *phys-cox* sco))
                                                        (+ (* (-> *phys-coy* sco) (-> *phys-coy* sco))
                                                           (* (-> *phys-coz* sco) (-> *phys-coz* sco)))))))))))))))
                    ;; PREUVE D'EXECUTION (regle 0) : ce que le moteur a REELLEMENT resolu, pas ce
                    ;; que le fichier promet. Le validateur et la salle s'ancrent sur cette ligne.
                    (format 0 "[HD-PHYS] init ~S slot=~D chains=~D links=~D colliders=~D joints=~D~%"
                            agname slot armed links nco njoint)))))))))))
  (none))

(defun jak-hd-physics-release ((obj jak-hd))
  (let ((slot (phys-slot-for-pid (the int (-> obj pid)))))
    (when (>= slot 0)
      (set! (-> *phys-slot-pid* slot) 0)
      (set! (-> *phys-slot-nch* slot) 0)
      (set! (-> *phys-slot-nco* slot) 0)))
  (none))

;; [NOTE-20] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defconstant PHYS-VOL-FREE 1000000000.0)

;; [NOTE-21] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-softmin ((v float) (cap float))
  "min DOUX de v et cap A ZONE MORTE : IDENTITE STRICTE sous le genou kn = 0.84 cap, puis l'EXCES
   seul est sature, asymptote exacte a cap. Pente continue au genou (f'(kn) = 1), strictement
   croissante partout. NON IDEMPOTENT AU-DESSUS DU GENOU (en dessous c'est l'identite, donc
   idempotent) : ne jamais l'appeler dans une boucle de contraintes."
  (let ((kn (* 0.84 cap)))
    (if (or (<= cap 0.0) (<= v kn))
      v
      (let* ((cp (- cap kn))
             (x  (/ (- v kn) cp)))
        (+ kn (* cp (/ x (+ 1.0 x))))))))

;; [NOTE-50] UN TAUX D'AMORTISSEMENT N'EST PAS UN FACTEUR DE RETENTION. -> jak-hd-physics-NOTES.md
(defun phys-decay ((x float))
  "e^-x pour x >= 0 : le facteur de RETENTION qu'un taux `x` produit sur UN pas. Pade(3,3),
   erreur relative < 1e-6 sur [0, 0.8] — la plage reellement utilisee ici est [0.021, 0.708].
   Ne depend pas de `exp` de trigonometry.gc, routine PS2 decompilee non verifiee."
  (let* ((a (fmax 0.0 x))
         (h (* 0.5 a))
         (q (* 0.1 (* a a)))
         (c (* 0.00833333 (* a (* a a)))))
    (/ (+ (- 1.0 h) (- q c)) (+ (+ 1.0 h) (+ q c)))))

(defun phys-osc-k2 ((z float) (wh float))
  "Raideur par pas telle que la recurrence symplectique rende EXACTEMENT l'amortissement `z` et
   la pulsation dont `wh` = omega * pas. Retention a lui associer : `(phys-decay (* 2.0 z wh))`.
   `4 r sin^2(theta/2)` et JAMAIS `1 - cos theta` : egaux en algebre, mais `1 - cos` perd ses
   chiffres significatifs quand theta est petit, et theta vaut 0.06 sur le mode principal.
   Somme de termes positifs, donc k2 > 0 toujours : ne peut pas destabiliser la boucle."
  (let* ((r (phys-decay (* z wh)))
         (u (* 0.5 (* wh (sqrtf (fmax 0.0 (- 1.0 (* z z)))))))
         (s (* u (+ (- 1.0 (* 0.16666667 (* u u))) (* 0.00833333 (* (* u u) (* u u)))))))
    (+ (* (- 1.0 r) (- 1.0 r)) (* 4.0 (* r (* s s))))))

(defun phys-vol-floor ((floor0 float) (b0 float))
  "Profondeur maximale que cette paire (lien, volume) tolere : sa profondeur d'auteur PLUS ce que la
   chair cede avant de toucher l'os. La bande n'est pas choisie, c'est le seul chiffre de sa spec qui
   dise jusqu'ou la chair s'ecrase contre le thorax : SPEC 10 `SupineProjectionScale = 0.70` donne
   `0.30 * B0`, pas un point de plus. La PROFONDEUR DE COM qui en resulte n'est PAS posee : elle sort
   de l'equilibre des forces (dans la bande seule la raideur SPEC 24/29 resiste) et se lit ENSUITE
   contre la ligne de SPEC 10 qui la chiffre, 0.23 B0.
   POURQUOI ELLE NE POUVAIT PAS RESTER A `floor0` : mur UNILATERAL pose EXACTEMENT au point de repos,
   donc il repoussait le premier micron vers le thorax et laissait l'autre sens libre. Cycle 14,
   stimulus IDENTIQUE : pole libre 0.13997 B0 contre pole bloque 0.02511 B0. REDRESSEE. NOTE-55.
   `b0` = 0 rend la forme d'avant, sans complaisance : c'est ce que recoit toute paire que
   `phys-vol-yield` n'a pas reconnue comme du buste. LA POSE DU MODELE RESTE ADMISSIBLE a fortiori :
   `feff >= floor0`, test STRICT. `*phys-col-off*` DESARME le mur entierement (controle k=4) et passe
   par ICI pour couvrir les TROIS sites de `feff` d'un seul point. Voir [NOTE-53]."
  (if (nonzero? *phys-col-off*)
    PHYS-VOL-FREE
    (+ floor0 (* PHYS-FLESH-YIELD b0))))

(defun phys-vol-yield ((sc int) (cj int) (cj2 int))
  "La bande de SPEC 10 est la compression de la chair CONTRE SON PROPRE BUSTE — pas une licence de
   traverser un bras, une main ou les lunettes (regle 6). Critere STRUCTUREL, tire du rig et jamais
   d'une liste a la main (regle 4) : le volume doit porter l'ANCRE de la chaine comme extremite.
   Ancre `chest` => `chest->main`, `neck->chest`, `L|Rshoulder->chest`, RIEN d'autre : les bras,
   `head->neck` et `sphere:gogglesMid` gardent le mur dur. Meme plancher pour la mesure. NOTE-55."
  (let ((a (-> *phys-anchor* sc)))
    (if (and (>= a 0) (or (= cj a) (= cj2 a))) (-> *phys-b0* sc) 0.0)))

;; ------------------------------------------------------------------------------------------------
;; GEOMETRIE — un lien contre un collider. Le collider est une SPHERE (joint2 < 0) ou une CAPSULE
;; (segment joint..joint2, rayon interpole). Les deux suivent la forme reelle du personnage : leurs
;; rayons sont ajustes sur les sommets skinnes du mesh par le generateur, pas poses a la main.
;; Retourne la profondeur de penetration (0 si dehors) et ecrit la normale de sortie dans `nrm`.
;; ------------------------------------------------------------------------------------------------
(defun phys-axis-dir ((pt vector) (ca vector) (cb vector) (out vector))
  "Direction unitaire allant du point le plus proche de l'AXE du volume vers `pt`, que `pt` soit
   dedans ou dehors. `phys-collide-depth` ne peut pas servir a ca : elle ecrit une normale
   arbitraire (0,1,0) des que le point est hors du volume, ce qui est correct pour une poussee et
   faux pour un COTE. Rend #f quand le point est sur l'axe, ou aucun cote n'existe."
  (let ((cx (-> ca x)) (cy (-> ca y)) (cz (-> ca z)))
    (let* ((ax (- (-> cb x) (-> ca x)))
           (ay (- (-> cb y) (-> ca y)))
           (az (- (-> cb z) (-> ca z)))
           (dd (+ (* ax ax) (+ (* ay ay) (* az az)))))
      (when (>= dd 0.000001)
        (let ((t0 (/ (+ (* (- (-> pt x) (-> ca x)) ax)
                        (+ (* (- (-> pt y) (-> ca y)) ay)
                           (* (- (-> pt z) (-> ca z)) az)))
                     dd)))
          (when (< t0 0.0) (set! t0 0.0))
          (when (> t0 1.0) (set! t0 1.0))
          (set! cx (+ (-> ca x) (* ax t0)))
          (set! cy (+ (-> ca y) (* ay t0)))
          (set! cz (+ (-> ca z) (* az t0))))))
    (let* ((dx (- (-> pt x) cx))
           (dy (- (-> pt y) cy))
           (dz (- (-> pt z) cz))
           (d  (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))
      (cond
        ((< d 0.001) #f)
        (else
         ;; `w` porte la DISTANCE a l'axe. Elle est deja calculee ici ; la jeter obligeait
         ;; l'appelant a la recalculer ou a se rabattre sur une constante. C'est elle qui chiffre
         ;; « de combien le lien est passe du mauvais cote », en metres, sans terme invente.
         (set-vector! out (/ dx d) (/ dy d) (/ dz d) d)
         #t)))))

;; CONTROLE POSITIF DU PREDICAT CONIQUE : 1 = on REMET le rayon interpole sur le parametre de
;; projection, c'est-a-dire le predicat faux d'avant. Ce qu'il rend au systeme est la difference
;; exacte entre le solide que la ligne de donnees DESIGNE et l'ensemble que le moteur TESTAIT.
(define *phys-cone-off* 0)

(defun phys-collide-depth ((pt vector) (rlink float) (ca vector) (cb vector)
                           (ra float) (rb float) (capsule? symbol) (nrm vector))
  "DISTANCE AU SOLIDE QUE LA LIGNE DE DONNEES DESIGNE — l'enveloppe convexe des deux spheres.

   CE QUI ETAIT FAUX, ET C'EST MESURE (rapport du cycle 22, section 9, probe
   `.autoport/probe_mesh_vs_capsule_fidelity.py` : `sd_round_cone` contre `sd_engine`) : le code
   projetait le point sur le segment, bornait le parametre, PUIS interpolait le rayon a ce
   parametre-la. C'est evaluer f(t) = |p - C(t)| - r(t) au parametre de PROJECTION au lieu de la
   MINIMISER sur [0,1]. Pour une capsule a rayons egaux les deux coincident ; les 24 capsules
   livrees sont TOUTES coniques (`physics_chains.txt` lignes 171-240), donc l'ecart existait sur
   chacune : 186 sommets sur 7963 changeaient de cote, ecart max 0.0974 m — neuf centimetres sur
   des pieces ou l'owner voit des clips, et plus que le rayon propre des lunettes (48 mm).

   LE PARAMETRE EXACT. Avec x la coordonnee axiale de p, y sa distance a l'axe, L la longueur de
   l'axe et dr = rb - ra, f est CONVEXE en t (racine d'un quadratique moins une affine), donc son
   minimum sur [0,1] est son minimum libre borne. f'(t) = 0 donne
       t* = ( x + dr*y / sqrt(L^2 - dr^2) ) / L
   et dr = 0 le ramene a x/L, c'est-a-dire exactement l'ancien code : la correction ne touche que
   les capsules coniques. Quand L^2 <= dr^2 une sphere contient l'autre et le solide EST la plus
   grosse — le cas ou l'ancien predicat se trompait le plus, puisqu'il faisait descendre le rayon
   jusqu'au petit bout d'un cone qui n'existe pas.

   LA NORMALE EST CORRIGEE PAR LA MEME OPERATION, et ce n'est pas un bonus : au parametre optimal,
   la direction de C(t*) vers p EST le gradient de la distance signee, donc la vraie normale
   sortante du tronc de cone. A un parametre quelconque elle ne l'est pas.

   CE QUE CETTE CORRECTION NE FAIT PAS : deplacer la ligne de base. La franchise accordee a chaque
   paire (`floors`/`floorc`, lignes 1855-1858, 1943-1946, 2052) est calculee par CETTE fonction sur
   la pose du modele : elle se corrige donc du meme coup. Ce qui change est la FORME de la surface,
   pas de combien on a le droit d'y entrer."
  (let ((cx 0.0) (cy 0.0) (cz 0.0) (rr ra))
    (cond
      ((not capsule?)
       (set! cx (-> ca x)) (set! cy (-> ca y)) (set! cz (-> ca z)))
      (else
       (let* ((ax (- (-> cb x) (-> ca x)))
              (ay (- (-> cb y) (-> ca y)))
              (az (- (-> cb z) (-> ca z)))
              (dd (+ (* ax ax) (* ay ay) (* az az)))
              (dr (- rb ra))
              (a2 (- dd (* dr dr))))
         (cond
           ((< dd 0.000001)
            ;; segment degenere : les deux spheres sont concentriques, la plus grosse les contient
            (set! cx (-> ca x)) (set! cy (-> ca y)) (set! cz (-> ca z))
            (set! rr (if (> rb ra) rb ra)))
           ((and (<= a2 0.000001) (zero? *phys-cone-off*))
            ;; UNE SPHERE CONTIENT L'AUTRE : aucun tronc de cone n'existe, le solide est la grosse
            (cond
              ((>= ra rb) (set! cx (-> ca x)) (set! cy (-> ca y)) (set! cz (-> ca z)) (set! rr ra))
              (else       (set! cx (-> cb x)) (set! cy (-> cb y)) (set! cz (-> cb z)) (set! rr rb))))
           (else
            (let* ((px (- (-> pt x) (-> ca x)))
                   (py (- (-> pt y) (-> ca y)))
                   (pz (- (-> pt z) (-> ca z)))
                   (dot (+ (* px ax) (* py ay) (* pz az)))
                   (t0  (/ dot dd)))
              ;; part radiale prise sur le VECTEUR perpendiculaire, pas par |p|^2 - x^2 : la
              ;; soustraction de deux grands nombres presque egaux perd ses chiffres quand le
              ;; point est pres de l'axe, c'est-a-dire exactement le cas qui decide.
              (when (and (> a2 0.000001) (zero? *phys-cone-off*) (!= dr 0.0))
                (let* ((qx (- px (* ax t0)))
                       (qy (- py (* ay t0)))
                       (qz (- pz (* az t0)))
                       (yy (sqrtf (+ (* qx qx) (+ (* qy qy) (* qz qz))))))
                  (set! t0 (+ t0 (/ (* dr yy) (* (sqrtf dd) (sqrtf a2)))))))
              (when (< t0 0.0) (set! t0 0.0))
              (when (> t0 1.0) (set! t0 1.0))
              (set! cx (+ (-> ca x) (* ax t0)))
              (set! cy (+ (-> ca y) (* ay t0)))
              (set! cz (+ (-> ca z) (* az t0)))
              (set! rr (+ ra (* dr t0)))))))))
    (let* ((dx (- (-> pt x) cx))
           (dy (- (-> pt y) cy))
           (dz (- (-> pt z) cz))
           (d2 (+ (* dx dx) (* dy dy) (* dz dz)))
           (d  (sqrtf d2))
           (want (+ rr rlink)))
      ;; LA PROFONDEUR NON BORNEE, POUR LA MESURE SEULE. La valeur RENDUE est bornee a 0 par le bas
      ;; — c'est ce que veut une poussee — et deux paires qui ne se touchent pas rendent donc le
      ;; MEME zero, qu'elles soient a un cheveu ou a un metre. Ce store rend la grandeur SIGNEE
      ;; `want - d` : positive = recouvrement, negative = l'ecart entre les deux surfaces.
      ;; Un seul store, avant le `cond`, aucune branche touchee : la valeur de retour et la normale
      ;; sont inchangees au bit pres. Aucun consommateur du solveur ne lit cette variable.
      (set! *phys-depsigned* (- want d))
      (cond
        ((>= d want)
         (set! (-> nrm x) 0.0) (set! (-> nrm y) 1.0) (set! (-> nrm z) 0.0)
         0.0)
        ((< d 0.001)
         ;; centre exactement sur l'axe : direction arbitraire mais stable
         (set! (-> nrm x) 0.0) (set! (-> nrm y) 1.0) (set! (-> nrm z) 0.0)
         want)
        (else
         (set! (-> nrm x) (/ dx d)) (set! (-> nrm y) (/ dy d)) (set! (-> nrm z) (/ dz d))
         (- want d))))))

;; [NOTE-22] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-length-chain ((skel skeleton) (sc int) (n int) (rlk int) (an int) (nbone int))
  "LA CONTRAINTE DE LONGUEUR, DURE, ET LA MEME POUR LES DEUX FORMES DE LIEN.

   Owner, 5e passe : « les changements brusques de direction causent un truc chelou au niveau des
   seins, ils s'allongent, c'est un peu debile » — « une chaine a un seul os doit TOURNER AUTOUR DE
   SON ANCRE A LONGUEUR INVARIANTE, jamais se translater ni s'allonger ». Ce que faisait l'ancienne
   version pour un lien SEUL : elle bornait |p - pose_du_lien| par le rayon du lien. C'est un
   plafond de POSITION, pas une longueur — sous forte acceleration le lien s'ecartait de son ancre
   et la distance ancre->lien changeait, donc il S'ALLONGEAIT. Desormais un lien seul est traite
   exactement comme un lien de chaine, son attache etant l'ANCRE au lieu du lien precedent :
   projection sur la sphere de rayon `want`, ou `want` est la longueur que LE MODELE donne a cet os,
   relue chaque frame. Une egalite, pas un plafond : ca tourne, ca ne s'etire pas.

   Owner, 2e/3e/4e passes (trois fois) : « j'ai encore vu un de ses seins retourne vers l'interieur,
   la meme animation relancee et c'etait nickel ». Le ressort est symetrique autour de l'attache,
   donc le cote oppose est un equilibre STABLE mais FAUX. Le test de cote est donc ici, contre la
   DIRECTION DU MODELE — et plus contre l'axe d'un volume, ou il ne voulait rien dire (un volume est
   une coquille symetrique, son axe ne designe aucun « bon cote »).

   `*phys-len-off*` DESARME toute cette contrainte : voir la note de ce drapeau. Controle du
   cycle 8, actif sur les seules fenetres AXZ, 0 en livraison."
  (dotimes (l n)
    (when (and (>= l rlk) (zero? *phys-len-off*))
      (let* ((scl (+ (* sc PHYS-LINKS) l))
             (kk  (-> *phys-joint* scl))
             (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
        (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
          (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                 (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                 (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                 (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                        (-> skel bones (+ kp 1) transform vector 3 x)))
                 (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                        (-> skel bones (+ kp 1) transform vector 3 y)))
                 (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                        (-> skel bones (+ kp 1) transform vector 3 z)))
                 (want (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz)))))
                 (dx (- (-> *phys-px* scl) bx))
                 (dy (- (-> *phys-py* scl) by))
                 (dz (- (-> *phys-pz* scl) bz))
                 (d  (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))
            (cond
              ((< want 0.01)
               ;; L'OS N'EXISTE PAS DANS LE MODELE : le joint est confondu avec son attache, donc
               ;; « tourner autour d'elle a longueur invariante » n'a pas de sens — la sphere est un
               ;; point et le lien serait EPINGLE. C'est exactement ce qui avait tue LpantFlap.
               ;; Ce lien-la garde le seul plafond que la geometrie lui donne : SA PROPRE TAILLE,
               ;; le rayon que le mesh lui mesure. Compte et publie comme le limiteur qu'il est.
               (let* ((rmax (-> *phys-rad* scl))
                      (tx (-> skel bones (+ kk 1) transform vector 3 x))
                      (ty (-> skel bones (+ kk 1) transform vector 3 y))
                      (tz (-> skel bones (+ kk 1) transform vector 3 z))
                      (ex (- (-> *phys-px* scl) tx))
                      (ey (- (-> *phys-py* scl) ty))
                      (ez (- (-> *phys-pz* scl) tz))
                      (e  (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez)))))
                      ;; PLAFOND DUR, ET IL DOIT LE RESTER : voir la note d'IDEMPOTENCE au-dessus
                      ;; de `phys-softmin`. Ce bloc tourne onze fois par frame.
                      (e2 rmax))
                 (when (and (> e rmax) (> e 0.0001))
                   (let ((s (/ e2 e)))
                     (set! *phys-raddrop-n* (+ *phys-raddrop-n* 1))
                     (set! *phys-raddrop-sum* (+ *phys-raddrop-sum* (- e e2)))
                     ;; LE PRIX DU SUPPRESSEUR, PAR CHAINE. SPEC 7 : « on en ajoute un uniquement
                     ;; si un defaut mesure l'exige, et on chiffre COMBIEN DE MOUVEMENT IL
                     ;; RETIRE ». La somme existait deja mais GLOBALE (`*phys-raddrop-sum*`) :
                     ;; elle ne pouvait donc designer aucune chaine, et le prix du mur n'a jamais
                     ;; pu etre mis en face du mouvement qu'il coute.
                     (set! (-> *phys-dg* (+ (* sc PHYS-DG) 15))
                           (+ (- e e2) (-> *phys-dg* (+ (* sc PHYS-DG) 15))))
                     (set! (-> *phys-dg* (+ (* sc PHYS-DG) 6))
                           (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 6))))
                     (set! (-> *phys-px* scl) (+ tx (* ex s)))
                     (set! (-> *phys-py* scl) (+ ty (* ey s)))
                     (set! (-> *phys-pz* scl) (+ tz (* ez s)))))))
              (else
               ;; CAS DEGENERE : le lien s'est confondu avec son attache, la direction n'existe
               ;; plus. Se taire ici laissait le lien se restabiliser n'importe ou, y compris du
               ;; mauvais cote — on REPART de la direction du modele.
               (when (<= d 0.0001)
                 (set! *phys-invfix* (+ *phys-invfix* 1))
                 (set! dx mx) (set! dy my) (set! dz mz) (set! d want))
               ;; [NOTE-23] LE COTE, ET SEULEMENT SUR LE PREMIER LIEN LIBRE — celui dont l'attache est RIGIDE. -> jak-hd-physics-NOTES.md
               (let* ((m2  (+ (* mx mx) (+ (* my my) (* mz mz))))
                      (u2  (+ (* dx dx) (+ (* dy dy) (* dz dz))))
                      (dot (+ (* dx mx) (+ (* dy my) (* dz mz)))))
                 (when (and (= l rlk) (< dot 0.0) (> m2 0.0)
                            (> (* dot dot) (* PHYS-SIDE-COS2 (* u2 m2))))
                   (set! *phys-invn* (+ *phys-invn* 1))
                   (set! (-> *phys-dg* (+ (* sc PHYS-DG) 3))
                         (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 3))))
                   (let ((kr (/ (* 2.0 dot) m2)))
                     (set! dx (- dx (* kr mx)))
                     (set! dy (- dy (* kr my)))
                     (set! dz (- dz (* kr mz))))))
               ;; LONGUEUR INVARIANTE : projection sur la sphere de rayon `want` centree sur
               ;; l'attache.
               (let ((dd (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))
                 (when (> dd 0.0001)
                   (let ((s (/ want dd)))
                     (set! (-> *phys-px* scl) (+ bx (* dx s)))
                     (set! (-> *phys-py* scl) (+ by (* dy s)))
                     (set! (-> *phys-pz* scl) (+ bz (* dz s))))))
               ;; [NOTE-24] PIERRE TOMBALE — LE MUR D'EXCURSION EST RETIRE DE CETTE BRANCHE, A NE PAS -> jak-hd-physics-NOTES.md
               )))))))
  (none))

;; [NOTE-25] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-cap-ang! ((skel skeleton) (sc int) (n int) (rlk int) (an int) (nbone int) (stage int))
  "RELEVE L'ANGLE DE CHAQUE MAILLON A UN ETAGE DU SOLVEUR (voir la note de `*phys-la0*`).
   Rigoureusement le meme calcul que la mesure de fin de frame : direction courante prise depuis
   l'attache SIMULEE, direction du modele prise depuis l'attache ANIMEE. Deux etages mesures
   autrement ne seraient pas comparables, et c'est leur COMPARAISON qui designe le coupable."
  (dotimes (l n)
    (when (>= l rlk)
      (let* ((scl (+ (* sc PHYS-LINKS) l))
             (kk  (-> *phys-joint* scl))
             (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
        (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
          (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                 (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                 (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                 (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                        (-> skel bones (+ kp 1) transform vector 3 x)))
                 (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                        (-> skel bones (+ kp 1) transform vector 3 y)))
                 (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                        (-> skel bones (+ kp 1) transform vector 3 z)))
                 (ux (- (-> *phys-px* scl) bx))
                 (uy (- (-> *phys-py* scl) by))
                 (uz (- (-> *phys-pz* scl) bz))
                 (m2 (+ (* mx mx) (+ (* my my) (* mz mz))))
                 (u2 (+ (* ux ux) (+ (* uy uy) (* uz uz))))
                 (dot (+ (* ux mx) (+ (* uy my) (* uz mz)))))
            (when (and (> m2 0.0001) (> u2 0.0001))
              (let* ((cx (- (* uy mz) (* uz my)))
                     (cy (- (* uz mx) (* ux mz)))
                     (cz (- (* ux my) (* uy mx)))
                     (sn (sqrtf (+ (* cx cx) (+ (* cy cy) (* cz cz)))))
                     (ang (* 0.0054931641 (atan sn dot))))
                (cond
                  ((zero? stage)
                   (when (> ang (-> *phys-la0* scl)) (set! (-> *phys-la0* scl) ang)))
                  (else
                   (when (> ang (-> *phys-la1* scl)) (set! (-> *phys-la1* scl) ang)))))))))))
  (none))

(defun phys-bend-chain ((skel skeleton) (sc int) (n int) (rlk int) (an int) (nbone int))
  (let ((amax (-> *phys-maxang* sc)))
    (when (> amax 0.0)
      (dotimes (l n)
        (when (>= l rlk)
          (let* ((scl (+ (* sc PHYS-LINKS) l))
                 (kk  (-> *phys-joint* scl))
                 (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
            (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
              (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                     (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                     (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                     (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                            (-> skel bones (+ kp 1) transform vector 3 x)))
                     (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                            (-> skel bones (+ kp 1) transform vector 3 y)))
                     (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                            (-> skel bones (+ kp 1) transform vector 3 z)))
                     (dx (- (-> *phys-px* scl) bx))
                     (dy (- (-> *phys-py* scl) by))
                     (dz (- (-> *phys-pz* scl) bz))
                     (m2 (+ (* mx mx) (+ (* my my) (* mz mz))))
                     (d2 (+ (* dx dx) (+ (* dy dy) (* dz dz)))))
                (when (and (> m2 0.000001) (> d2 0.000001))
                  (let* ((ml (sqrtf m2))
                         (dl (sqrtf d2))
                         (ux (/ mx ml)) (uy (/ my ml)) (uz (/ mz ml))
                         (vx (/ dx dl)) (vy (/ dy dl)) (vz (/ dz dl))
                         (cs (+ (* ux vx) (+ (* uy vy) (* uz vz))))
                         (px (- vx (* cs ux))) (py (- vy (* cs uy))) (pz (- vz (* cs uz)))
                         (pl (sqrtf (+ (* px px) (+ (* py py) (* pz pz)))))
                         ;; `atan` de GOAL rend des UNITES DE ROTATION (65536 = un tour) ;
                         ;; 360/65536 = 0.0054931641 les convertit en degres, et 182.04444
                         ;; revient aux unites que `sin`/`cos` attendent.
                         (adeg (* 0.0054931641 (atan pl cs)))
                         (adg2 (phys-softmin adeg amax)))
                    (when (and (> pl 0.0001) (< adg2 (- adeg 0.01)))
                      (let* ((au (* 182.04444 adg2))
                             (cc (cos au))
                             (ss (sin au))
                             (qx (/ px pl)) (qy (/ py pl)) (qz (/ pz pl)))
                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 7))
                              (+ (- adeg adg2) (-> *phys-dg* (+ (* sc PHYS-DG) 7))))
                        (set! (-> *phys-px* scl) (+ bx (* dl (+ (* cc ux) (* ss qx)))))
                        (set! (-> *phys-py* scl) (+ by (* dl (+ (* cc uy) (* ss qy)))))
                        (set! (-> *phys-pz* scl) (+ bz (* dl (+ (* cc uz) (* ss qz))))))))))))))))
  (none))

;; [NOTE-102] ---------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-link-off! ((skel skeleton) (scl int) (kk int) (out vector))
  (let ((ox (-> *phys-lcx* scl))
        (oy (-> *phys-lcy* scl))
        (oz (-> *phys-lcz* scl)))
    (cond
      ((and (= ox 0.0) (= oy 0.0) (= oz 0.0))
       (set-vector! out 0.0 0.0 0.0 0.0))
      (else
       (set-vector! out ox oy oz 0.0)
       (vector-rotate*! out out (the-as matrix (-> skel bones (+ kk 1) transform))))))
  (none))

;; [NOTE-26] LE MEME DECALAGE, MAIS PORTE PAR L'ORIENTATION *SIMULEE* DU LIEN. -> jak-hd-physics-NOTES.md
(defun phys-link-off-sim! ((skel skeleton) (scl int) (kk int) (kp int) (nbone int)
                           (b vector) (p vector) (out vector))
  (phys-link-off! skel scl kk out)
  (when (and (>= kp 0) (< (+ kp 1) nbone)
             (or (!= (-> out x) 0.0) (!= (-> out y) 0.0) (!= (-> out z) 0.0)))
    (let* ((mx (- (-> skel bones (+ kk 1) transform vector 3 x) (-> skel bones (+ kp 1) transform vector 3 x)))
           (my (- (-> skel bones (+ kk 1) transform vector 3 y) (-> skel bones (+ kp 1) transform vector 3 y)))
           (mz (- (-> skel bones (+ kk 1) transform vector 3 z) (-> skel bones (+ kp 1) transform vector 3 z)))
           (ml (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz)))))
           (ux (- (-> p x) (-> b x))) (uy (- (-> p y) (-> b y))) (uz (- (-> p z) (-> b z)))
           (ul (sqrtf (+ (* ux ux) (+ (* uy uy) (* uz uz))))))
      (when (and (> ml 0.01) (> ul 0.01))
        (set! mx (/ mx ml)) (set! my (/ my ml)) (set! mz (/ mz ml))
        (set! ux (/ ux ul)) (set! uy (/ uy ul)) (set! uz (/ uz ul))
        (let ((d (* 2.0 (+ (* mx (-> out x)) (+ (* my (-> out y)) (* mz (-> out z)))))))
          (set! (-> out x) (- (-> out x) (* d mx)))
          (set! (-> out y) (- (-> out y) (* d my)))
          (set! (-> out z) (- (-> out z) (* d mz))))
        (let* ((hx (+ mx ux)) (hy (+ my uy)) (hz (+ mz uz))
               (hh (+ (* hx hx) (+ (* hy hy) (* hz hz)))))
          (when (> hh 0.000001)
            (let ((d (/ (* 2.0 (+ (* hx (-> out x)) (+ (* hy (-> out y)) (* hz (-> out z))))) hh)))
              (set! (-> out x) (- (-> out x) (* d hx)))
              (set! (-> out y) (- (-> out y) (* d hy)))
              (set! (-> out z) (- (-> out z) (* d hz)))))))))
  (none))

(defun phys-col-centre ((skel skeleton) (sco int) (cj int) (out vector))
  (let ((ox (-> *phys-cox* sco))
        (oy (-> *phys-coy* sco))
        (oz (-> *phys-coz* sco)))
    (cond
      ((and (= ox 0.0) (= oy 0.0) (= oz 0.0))
       (vector-copy! out (the-as vector (-> skel bones (+ cj 1) transform vector 3))))
      (else
       (set-vector! out ox oy oz 1.0)
       (vector-matrix*! out out (the-as matrix (-> skel bones (+ cj 1) transform))))))
  (none))

(defun phys-snapshot-colliders! ((skel skeleton) (slot int) (nco int) (nbone int))
  "Releve la position d'auteur des deux extremites de chaque volume, AVANT que la premiere chaine
   n'ecrive quoi que ce soit dans le squelette. Appele une fois par frame, en tete du pas."
  (let ((ca (new 'stack-no-clear 'vector)))
    (dotimes (ci nco)
      (let* ((sco (+ (* slot PHYS-COLS) ci))
             (cj  (-> *phys-cj* sco))
             (cj2 (-> *phys-cj2* sco)))
        (cond
          ((and (>= cj 0) (< (+ cj 1) nbone))
           (phys-col-centre skel sco cj ca)
           (set! (-> *phys-crax* sco) (-> ca x))
           (set! (-> *phys-cray* sco) (-> ca y))
           (set! (-> *phys-craz* sco) (-> ca z))
           (cond
             ((and (>= cj2 0) (< (+ cj2 1) nbone))
              (set! (-> *phys-crbx* sco) (-> skel bones (+ cj2 1) transform vector 3 x))
              (set! (-> *phys-crby* sco) (-> skel bones (+ cj2 1) transform vector 3 y))
              (set! (-> *phys-crbz* sco) (-> skel bones (+ cj2 1) transform vector 3 z)))
             (else
              (set! (-> *phys-crbx* sco) (-> ca x))
              (set! (-> *phys-crby* sco) (-> ca y))
              (set! (-> *phys-crbz* sco) (-> ca z))))
           (set! (-> *phys-crok* sco) 1))
          (else (set! (-> *phys-crok* sco) 0))))))
  (none))

(defun phys-col-rest! ((sco int) (ra vector) (rb vector))
  "Les deux extremites du volume `sco` a leur pose d'auteur de cette frame (instantane ci-dessus).
   Rend #f quand aucun instantane n'a ete pris : l'appelant retombe alors sur le squelette."
  (cond
    ((zero? (-> *phys-crok* sco)) #f)
    (else
     (set-vector! ra (-> *phys-crax* sco) (-> *phys-cray* sco) (-> *phys-craz* sco) 1.0)
     (set-vector! rb (-> *phys-crbx* sco) (-> *phys-crby* sco) (-> *phys-crbz* sco) 1.0)
     #t)))

(defun phys-col-now! ((skel skeleton) (sco int) (cj int) (cj2 int) (nbone int)
                      (ca vector) (cb vector))
  "LES DEUX EXTREMITES DU VOLUME TELLES QUE TOUTES LES CHAINES DOIVENT LES VOIR CETTE FRAME.
   NATURE : une position monde, en unites de jeu. REPERE : monde.
   CE QU'ELLE REND QUAND LE DEFAUT EST ABSENT : le squelette courant, au bit pres — c'est le cas
   des 24 volumes qu'aucune chaine ne simule, et du premier pas de chaque acteur.

   Un volume porte par un joint SIMULE est lu dans l'instantane de FIN DE FRAME PRECEDENTE. Sinon
   la reponse d'une chaine depend de son rang dans le fichier : voir la note de `*phys-csim*`."
  (cond
    ((and (zero? *phys-jacobi-off*)
          (nonzero? (-> *phys-csim* sco))
          (nonzero? (-> *phys-csok* sco)))
     (set-vector! ca (-> *phys-csax* sco) (-> *phys-csay* sco) (-> *phys-csaz* sco) 1.0)
     (set-vector! cb (-> *phys-csbx* sco) (-> *phys-csby* sco) (-> *phys-csbz* sco) 1.0))
    (else
     (phys-col-centre skel sco cj ca)
     (if (and (>= cj2 0) (< (+ cj2 1) nbone))
       (vector-copy! cb (the-as vector (-> skel bones (+ cj2 1) transform vector 3)))
       (vector-copy! cb ca))))
  (none))

(defun phys-snapshot-sim! ((skel skeleton) (slot int) (nco int) (nbone int))
  "L'instantane de JACOBI : la position de FIN DE FRAME de tout volume porte par un joint simule.
   Appelee une seule fois, apres que toutes les chaines ont ecrit. C'est ce que la frame SUIVANTE
   lira, pour toutes les chaines a la fois."
  (let ((ca (new 'stack-no-clear 'vector)))
    (dotimes (ci nco)
      (let* ((sco (+ (* slot PHYS-COLS) ci))
             (cj  (-> *phys-cj* sco))
             (cj2 (-> *phys-cj2* sco)))
        (when (and (nonzero? (-> *phys-csim* sco)) (>= cj 0) (< (+ cj 1) nbone))
          (phys-col-centre skel sco cj ca)
          (set! (-> *phys-csax* sco) (-> ca x))
          (set! (-> *phys-csay* sco) (-> ca y))
          (set! (-> *phys-csaz* sco) (-> ca z))
          (cond
            ((and (>= cj2 0) (< (+ cj2 1) nbone))
             (set! (-> *phys-csbx* sco) (-> skel bones (+ cj2 1) transform vector 3 x))
             (set! (-> *phys-csby* sco) (-> skel bones (+ cj2 1) transform vector 3 y))
             (set! (-> *phys-csbz* sco) (-> skel bones (+ cj2 1) transform vector 3 z)))
            (else
             (set! (-> *phys-csbx* sco) (-> ca x))
             (set! (-> *phys-csby* sco) (-> ca y))
             (set! (-> *phys-csbz* sco) (-> ca z))))
          (set! (-> *phys-csok* sco) 1)))))
  (none))

(defun phys-col-key ((sco int) (cj int))
  "LA CLE DE PRIORITE D'UN VOLUME — depuis le 2026-08-18, DEPARTAGE SEULEMENT (le decideur est le
   plus profond violeur, voir le site de selection) : corps avant chaine, puis parent dans le rig.

   LA REGLE ECRITE N'EST PAS TOTALISANTE, ET C'EST MESURE : trois volumes de corps sont a egalite
   de profondeur minimale 1 (`hips->main`, `chest->main`, la sphere `main`). Sans departage le
   decideur dependrait de l'ordre de parcours, c'est-a-dire du fichier — la meme faute que celle
   qu'on corrige. Le departage est l'index rig du joint porteur : les 33 `cj` sont deux a deux
   distincts (verifie sur le rig), donc la cle est TOTALE et deux frames identiques designent
   toujours le meme decideur."
  (+ (* 1000000 (-> *phys-csim* sco)) (+ (* 1000 (-> *phys-cdep* sco)) cj)))

;; [NOTE-103] ---------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-col-prox? ((slot int) (cj int) (cj2 int))
  "UN VOLUME EST UNE SPHERE PROXIMALE si son joint porteur est le joint du MAILLON 0 d'une chaine
   declaree ET qu'il n'a pas de second joint (donc une sphere, pas une capsule). Predicat DERIVE :
   aucun nom d'os n'y figure, donc il suit un renommage ou une reinjection.
   POURQUOI IL EXISTE : le cycle 35 a mesure que les deux spheres de chair d'un sein decrivent LA
   MEME chair — sur les 55 sommets de `chestL`, la proximale ne couvre pas UN SEUL sommet que la
   distale ne couvre deja. Cet interrupteur demande ce que ca coute a l'execution."
  (let ((p #f))
    (when (< cj2 0)
      (dotimes (c PHYS-CHAINS)
        (let ((k0 (-> *phys-joint* (* (+ (* slot PHYS-CHAINS) c) PHYS-LINKS))))
          (when (and (>= k0 0) (= cj k0)) (set! p #t)))))
    p))

(defun phys-col-own? ((sc int) (n int) (cj int) (cj2 int))
  (let ((own #f))
    (dotimes (l2 n)
      (let ((k2j (-> *phys-joint* (+ (* sc PHYS-LINKS) l2))))
        (when (and (>= k2j 0) (or (= cj k2j) (= cj2 k2j))) (set! own #t))))
    own))

;; [NOTE-27] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-len-project! ((skel skeleton) (scl int) (l int) (kk int) (kp int) (nbone int)
                          (pt vector))
  "RAMENE LE LIEN SUR LA SPHERE DE SON ATTACHE — ROTATION, PAS TRANSLATION. `want` est la longueur
   que le MODELE donne a cet os ; un os que le modele ne donne pas (`want` ~ 0) n'a pas de sphere et
   garde son comportement en translation. `pt` est en coordonnees de JOINT, pas en centre de volume.
   DEUX APPELANTS depuis ce cycle : c'est le correctif du residu, voir la note au balayage.

   `*phys-len-off*` DESARME la projection : voir la note de ce drapeau. C'est le controle de
   l'hypothese du cycle 8, actif sur les seules fenetres AXZ, et 0 en livraison."
  (when (and (zero? *phys-len-off*) (>= kp 0) (< (+ kp 1) nbone))
    (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
           (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
           (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
           (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                  (-> skel bones (+ kp 1) transform vector 3 x)))
           (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                  (-> skel bones (+ kp 1) transform vector 3 y)))
           (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                  (-> skel bones (+ kp 1) transform vector 3 z)))
           (want (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz)))))
           (ux (- (-> pt x) bx))
           (uy (- (-> pt y) by))
           (uz (- (-> pt z) bz))
           (ul (sqrtf (+ (* ux ux) (+ (* uy uy) (* uz uz))))))
      (when (and (> want 0.01) (> ul 0.0001))
        (let ((s (/ want ul)))
          (set! (-> pt x) (+ bx (* ux s)))
          (set! (-> pt y) (+ by (* uy s)))
          (set! (-> pt z) (+ bz (* uz s)))))))
  (none))

(defun phys-collide-chain ((skel skeleton) (sc int) (n int) (rlk int) (nbone int)
                           (nco int) (margin float) (sweeps int))
  (set! *phys-swc* (+ 1 *phys-swc*))
  (let ((slot (/ sc PHYS-CHAINS))
        (pt   (new 'stack-no-clear 'vector))
        (rest (new 'stack-no-clear 'vector))
        (off  (new 'stack-no-clear 'vector))
        (offs (new 'stack-no-clear 'vector))
        (bv   (new 'stack-no-clear 'vector))
        (pv   (new 'stack-no-clear 'vector))
        (ca   (new 'stack-no-clear 'vector))
        (cb   (new 'stack-no-clear 'vector))
        (ra   (new 'stack-no-clear 'vector))
        (rb   (new 'stack-no-clear 'vector))
        ;; les deux azimuts du veto de cote : celui de la pose d'auteur et celui du lien simule.
        ;; Memes noms et meme role que dans `phys-link-pen` (:2513-2514), pour que le predicat de
        ;; DECISION se lise exactement comme le predicat de MESURE.
        (ua   (new 'stack-no-clear 'vector))
        (ub   (new 'stack-no-clear 'vector))
        (nrm  (new 'stack-no-clear 'vector)))
    (dotimes (l n)
      (when (>= l rlk)
        (let* ((scl (+ (* sc PHYS-LINKS) l))
               (kk  (-> *phys-joint* scl))
               (rl  (-> *phys-lcr* scl))
               (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) (-> *phys-anchor* sc))))
          (when (and (>= kk 0) (< (+ kk 1) nbone))
            ;; on raisonne sur le CENTRE du volume porte par le lien, pas sur son joint : c'est le
            ;; volume que le generateur a mesure sur le mesh, le meme que ce lien presente aux
            ;; autres chaines. Le decalage est rigide, donc la poussee se reporte telle quelle sur
            ;; le joint a la sortie.
            ;; DEUX decalages, pas un : la pose du MODELE porte son volume par la matrice ANIMEE,
            ;; la position SIMULEE le porte par l'orientation SIMULEE du lien. Les confondre posait
            ;; le volume la ou le lien n'est pas des que le decalage n'etait plus nul.
            (phys-link-off! skel scl kk off)
            (if (> l 0)
              (set-vector! bv (-> *phys-px* (- scl 1)) (-> *phys-py* (- scl 1))
                              (-> *phys-pz* (- scl 1)) 1.0)
              (if (and (>= kp 0) (< (+ kp 1) nbone))
                (vector-copy! bv (the-as vector (-> skel bones (+ kp 1) transform vector 3)))
                (set-vector! bv 0.0 0.0 0.0 1.0)))
            (set-vector! pv (-> *phys-px* scl) (-> *phys-py* scl) (-> *phys-pz* scl) 1.0)
            (phys-link-off-sim! skel scl kk kp nbone bv pv offs)
            (vector-copy! rest (the-as vector (-> skel bones (+ kk 1) transform vector 3)))
            (set! (-> rest x) (+ (-> rest x) (-> off x)))
            (set! (-> rest y) (+ (-> rest y) (-> off y)))
            (set! (-> rest z) (+ (-> rest z) (-> off z)))
            (set! (-> pt x) (+ (-> *phys-px* scl) (-> offs x)))
            (set! (-> pt y) (+ (-> *phys-py* scl) (-> offs y)))
            (set! (-> pt z) (+ (-> *phys-pz* scl) (-> offs z)))
            (set! (-> pt w) 1.0)
            ;; ---- DECISION 1 : QUI DECIDE POUR CE LIEN, CETTE FRAME ----------------------------
            ;; Une passe de SELECTION, sur la position d'entree du lien, avant toute poussee : elle
            ;; ne deplace rien, elle designe. Le round-robin qu'elle remplace faisait sortir le lien
            ;; d'un volume pour l'enfoncer dans le voisin a l'iteration suivante, et le recul
            ;; finissait par l'epingler sur la pose du modele (kneeflapR, 15913 frames sur 17893).
            (set! (-> *phys-lwin* scl) -1)
            ;; ARMEE (prio-off = 0) elle DESIGNE et ses compteurs comptent ; en mesure seule
            ;; (prio-meas = 1) elle ne fait que COMPTER, et `*phys-lwin*` est rendu a -1 juste
            ;; apres, donc rien n'est ecarte. Voir *phys-prio-meas*.
            (when (or (zero? *phys-prio-off*) (nonzero? *phys-prio-meas*))
              (let ((best 2000000000) (bres 0.0) (nviol 0) (lastci 0))
                (dotimes (ci nco)
                  (let* ((sco (+ (* slot PHYS-COLS) ci))
                         (cj  (-> *phys-cj* sco))
                         (cj2 (-> *phys-cj2* sco))
                         (own (phys-col-own? sc n cj cj2))
                         (selfpair (and own (nonzero? *phys-self-inject*))))
                    (when selfpair (set! own #f))
                    (when (and (not own) (>= cj 0) (< (+ cj 1) nbone))
                      (phys-col-now! skel sco cj cj2 nbone ca cb)
                      (when (not (phys-col-rest! sco ra rb))
                        (vector-copy! ra ca) (vector-copy! rb cb))
                      (let* ((cap?   (and (>= cj2 0) (< (+ cj2 1) nbone)))
                             (floors (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                         (-> *phys-cr2* sco) cap? nrm))
                             (floorc (phys-collide-depth rest rl ca cb (-> *phys-cr* sco)
                                                         (-> *phys-cr2* sco) cap? nrm))
                             (floor0 (if (> floorc floors) floorc floors))
                             (feff   (if selfpair 0.0 (phys-vol-floor floor0 (phys-vol-yield sc cj cj2))))
                             (dep    (phys-collide-depth pt rl ca cb (-> *phys-cr* sco)
                                                         (-> *phys-cr2* sco) cap? nrm)))
                        (when (> dep feff)
                          (+! nviol 1)
                          ;; ATTRIBUTION PAR VOLUME. On incremente d'abord tout violeur, et si le
                          ;; lien n'en avait qu'UN on le retire juste apres : ce seau ne compte donc
                          ;; que les volumes qui se DISPUTAIENT le lien. Une seule passe, aucune
                          ;; geometrie recalculee.
                          (set! lastci ci)
                          ;; `sc` PORTE DEJA LE SLOT (`sc = slot*PHYS-CHAINS + c`, cf. :922) : le
                          ;; remultiplier ecrirait HORS du tableau des le slot 1. Meme indexation
                          ;; que l'accesseur `phys-chain-conf`. `*phys-cvh*` est, LUI, PAR MAILLON.
                          (let ((h (+ (* sc PHYS-COLS) ci)))
                            (set! (-> *phys-cfh* h) (+ 1 (-> *phys-cfh* h))))
                          ;; [NOTE-110] [DECISION 1, critere revise 2026-08-18] Le decideur est LE PLUS PROFOND -> jak-hd-physics-NOTES.md
                          (let ((key (phys-col-key sco cj))
                                (rv  (- dep feff)))
                            (when (or (> rv bres)
                                      (and (= rv bres) (< key best)))
                              (set! bres rv)
                              (set! best key)
                              (set! (-> *phys-lwin* scl) sco))))))))
                (when (= nviol 1)
                  (let ((h (+ (* sc PHYS-COLS) lastci)))
                    (set! (-> *phys-cfh* h) (- (-> *phys-cfh* h) 1))))
                (when (> nviol 1)
                  (set! *phys-prio-multi* (+ *phys-prio-multi* 1))
                  (set! *phys-prio-n* (+ *phys-prio-n* (- nviol 1)))
                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 12))
                        (+ (the float (- nviol 1)) (-> *phys-dg* (+ (* sc PHYS-DG) 12)))))
                ;; MESURE SEULE : on a compte, on ne decide pas. Rendre `*phys-lwin*` a -1 remet le
                ;; comportement a l'identique du desarmement — c'est la valeur que la ligne 1959
                ;; venait d'y mettre, et les deux seuls consommateurs (`skip` en poussee, `skip` au
                ;; recul) exigent de toute facon `(zero? *phys-prio-off*)`. La remise est donc
                ;; redondante par deux fois, et c'est voulu : une mesure ne doit pas pouvoir
                ;; devenir un arbitrage par accident.
                (when (nonzero? *phys-prio-off*)
                  (set! (-> *phys-lwin* scl) -1))))
            (dotimes (sub sweeps)
              (dotimes (ci nco)
                (let* ((sco (+ (* slot PHYS-COLS) ci))
                       (cj  (-> *phys-cj* sco))
                       (cj2 (-> *phys-cj2* sco))
                       (own (phys-col-own? sc n cj cj2))
                       ;; DECISION 1 : les volumes que la priorite a ecartes sont IGNORES, pas
                       ;; moyennes. Distinct de `own` a dessein — `own` est l'exclusion
                       ;; structurelle chaine<->elle-meme, que le controle positif `self-inject`
                       ;; leve ; celle-ci ne se leve que par `prio-off`, son propre controle.
                       (skip (and (zero? *phys-prio-off*)
                                  (>= (-> *phys-lwin* scl) 0)
                                  (!= sco (-> *phys-lwin* scl)))))
                  ;; [NOTE-98] ARME, le controle positif LEVE l'exclusion : le compteur `selfcol` doit alor -> jak-hd-physics-NOTES.md
                  (let ((selfpair (and own (nonzero? *phys-self-inject*))))
                  (when selfpair (set! own #f))
                  ;; [NOTE-109] L'ABLATION DU CYCLE 37 ETAPE 2, a zero en livraison.
                  (when (and (nonzero? *phys-prox-off*) (phys-col-prox? slot cj cj2))
                    (set! skip #t))
                  (when (and (not own) (not skip) (>= cj 0) (< (+ cj 1) nbone))
                    (phys-col-now! skel sco cj cj2 nbone ca cb)
                    ;; `floor0` contre le volume A SA POSE D'AUTEUR, `dep` contre sa position
                    ;; COURANTE : le plancher de pose modele est une propriete de la pose du
                    ;; modele des DEUX cotes (cf. phys-snapshot-colliders!).
                    (when (not (phys-col-rest! sco ra rb))
                      (vector-copy! ra ca) (vector-copy! rb cb))
                    ;; [NOTE-28] LE PLANCHER SE MESURE CONTRE LES DEUX POSES DU VOLUME, ET ON GARDE LA PLUS -> jak-hd-physics-NOTES.md
                    (let* ((cap?   (and (>= cj2 0) (< (+ cj2 1) nbone))))
                      (let* ((floors (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                         (-> *phys-cr2* sco) cap? nrm))
                             (floorc (phys-collide-depth rest rl ca cb (-> *phys-cr* sco)
                                                         (-> *phys-cr2* sco) cap? nrm))
                             (floor0 (if (> floorc floors) floorc floors))
                             (feff   (if selfpair 0.0 (phys-vol-floor floor0 (phys-vol-yield sc cj cj2))))
                             (dep    (phys-collide-depth pt rl ca cb (-> *phys-cr* sco)
                                                         (-> *phys-cr2* sco) cap? nrm)))
                        ;; SPEC 33 — LE DOMAINE DE LA PAIRE. Un echantillon par (lien, volume) et
                        ;; par frame, pris a l'ENTREE (`sub` = 0, avant toute poussee de ce
                        ;; balayage). `*phys-depsigned*` porte la profondeur NON bornee que
                        ;; `phys-collide-depth` vient de calculer pour `pt` — c'est le dernier des
                        ;; trois appels du `let*`, donc la variable porte bien celle de `dep`.
                        ;; Le drapeau evite un sentinelle flottant (piege deja paye) : premier
                        ;; echantillon = affectation, les suivants = maximum.
                        (when (= sub 0)
                          (let ((h (+ (* sc PHYS-COLS) ci)))
                            (set! (-> *phys-cfl* h) feff)
                            (cond
                              ((zero? (-> *phys-cdmok* h))
                               (set! (-> *phys-cdm* h) *phys-depsigned*)
                               (set! (-> *phys-cdmok* h) 1))
                              ((> *phys-depsigned* (-> *phys-cdm* h))
                               (set! (-> *phys-cdm* h) *phys-depsigned*)))))
                        (when (> dep feff)
                          (let ((push (+ (- dep feff) margin)))
                            ;; une correction issue d'un volume PROPRE a la chaine : elle ne peut
                            ;; arriver que sous controle positif, et c'est ce compteur qui le dit.
                            (when (nonzero? *phys-self-inject*)
                              (when (phys-col-own? sc n cj cj2)
                                (set! (-> *phys-dg* (* sc PHYS-DG))
                                      (+ 1.0 (-> *phys-dg* (* sc PHYS-DG))))))
                            (set! (-> pt x) (+ (-> pt x) (* (-> nrm x) push)))
                            (set! (-> pt y) (+ (-> pt y) (* (-> nrm y) push)))
                            (set! (-> pt z) (+ (-> pt z) (* (-> nrm z) push)))
                            ;; SPEC 33/34 — ON NE FAIT QUE CUMULER ICI. La poussee est appliquee a
                            ;; la POSITION comme avant (rien de change pour la regle 6 : le lien
                            ;; sort du volume) ; ce qui manquait est son effet sur la VITESSE, et il
                            ;; ne peut pas etre traite dans cette fonction, appelee 15 fois par
                            ;; frame. `e` est celui du volume qui pousse : 0.06 si ce volume est
                            ;; porte par un joint SIMULE (l'autre sein, sa §33), 0.02 sinon (buste
                            ;; et externe, sa §34). Le dernier qui pousse decide, comme pour
                            ;; l'arbitrage de volume.
                            (set! (-> *phys-cpu* scl x) (+ (-> *phys-cpu* scl x) (* (-> nrm x) push)))
                            (set! (-> *phys-cpu* scl y) (+ (-> *phys-cpu* scl y) (* (-> nrm y) push)))
                            (set! (-> *phys-cpu* scl z) (+ (-> *phys-cpu* scl z) (* (-> nrm z) push)))
                            ;; [NOTE-97] L'INSTRUMENT DU CYCLE 36 : `cl` est le module de la somme
                            ;; VECTORIELLE ci-dessus. On releve a cote le COMPTE des evenements, le
                            ;; plus GRAND seul, la somme de leurs MODULES et l'ordinal du dernier
                            ;; balayage — les quatre grandeurs qui separent une repetition d'un
                            ;; ping-pong et d'un contact reellement profond. Aucune ne modifie rien.
                            (let* ((pb (* 7 scl))
                                   (swo (+ (* 3 (- *phys-swc* 1)) (+ sub 1))))
                              (set! (-> *phys-cpa* pb) (+ 1.0 (-> *phys-cpa* pb)))
                              (when (> push (-> *phys-cpa* (+ pb 1)))
                                (set! (-> *phys-cpa* (+ pb 1)) push))
                              (set! (-> *phys-cpa* (+ pb 2)) (+ push (-> *phys-cpa* (+ pb 2))))
                              (set! (-> *phys-cpa* (+ pb 3)) (the float swo))
                              ;; [NOTE-105] CYCLE 37 : le GROUPE DE COLLISION SEULE est celui des
                              ;; appels 12 a 15, donc les balayages 34 a 45 — il n'a AUCUNE
                              ;; contrainte de longueur pour ramener le lien en arriere. Si une
                              ;; poussee y est encore d'amplitude comparable a la moyenne de la
                              ;; frame, ce n'est pas la longueur qui recree la penetration : c'est
                              ;; l'ensemble des VOLUMES qui est inconsistant. `nlast` est le
                              ;; DOMAINE de `slast`, sans quoi un zero ne se distingue pas d'un
                              ;; groupe qui n'a pas tourne. `p1` dit ce qu'UNE projection accomplit.
                              (when (>= swo 34)
                                (set! (-> *phys-cpa* (+ pb 4)) (+ push (-> *phys-cpa* (+ pb 4))))
                                (set! (-> *phys-cpa* (+ pb 5)) (+ 1.0 (-> *phys-cpa* (+ pb 5)))))
                              (when (= (-> *phys-cpa* pb) 1.0)
                                (set! (-> *phys-cpa* (+ pb 6)) push))
                              ;; [NOTE-109] LE CUMUL PAR BRANCHE — un AGREGAT, pas un maximum.
                              (let ((qb (* 3 sc)))
                                (set! (-> *phys-cpc* qb) (+ 1.0 (-> *phys-cpc* qb)))
                                (set! (-> *phys-cpc* (+ qb 1)) (+ push (-> *phys-cpc* (+ qb 1))))
                                (when (>= swo 34)
                                  (set! (-> *phys-cpc* (+ qb 2))
                                        (+ push (-> *phys-cpc* (+ qb 2)))))))
                            (set! (-> *phys-cpe* scl)
                                  (if (nonzero? (-> *phys-csim* sco)) PHYS-RST-BB PHYS-RST-CH))))
                        ;; [NOTE-29] ---------------------------------------------------------------- -> jak-hd-physics-NOTES.md
                        (when (and (zero? *phys-side-off*)
                                   (> floor0 0.0)
                                   (> dep 0.0)
                                   (phys-axis-dir rest ca cb ua)
                                   (phys-axis-dir pt ca cb ub))
                          (let ((dt0 (+ (* (-> ua x) (-> ub x))
                                        (+ (* (-> ua y) (-> ub y))
                                           (* (-> ua z) (-> ub z))))))
                            (when (< dt0 0.0)
                              (let ((cc (* dt0 (-> ub w))))
                                (set! (-> pt x) (- (-> pt x) (* cc (-> ua x))))
                                (set! (-> pt y) (- (-> pt y) (* cc (-> ua y))))
                                (set! (-> pt z) (- (-> pt z) (* cc (-> ua z))))))))))))))
              ;; LA LONGUEUR, A CHAQUE BALAYAGE — le correctif du residu de penetration. Appliquee
              ;; seulement APRES les `sweeps`, elle defaisait la part RADIALE de chaque poussee de
              ;; profondeur sans jamais la retester contre le volume, et monter le nombre de tours
              ;; n'y pouvait rien — chaque tour finissait pareil. Alternee DANS la boucle, c'est une
              ;; projection alternee sur deux ensembles (sphere de l'attache, complementaire du
              ;; volume) qui converge vers leur intersection des qu'elle est non vide. `pt` est ici
              ;; le CENTRE DU VOLUME : on repasse en coordonnees de joint pour la reprojection.
              (set! (-> pt x) (- (-> pt x) (-> offs x)))
              (set! (-> pt y) (- (-> pt y) (-> offs y)))
              (set! (-> pt z) (- (-> pt z) (-> offs z)))
              (phys-len-project! skel scl l kk kp nbone pt)
              (set! (-> pt x) (+ (-> pt x) (-> offs x)))
              (set! (-> pt y) (+ (-> pt y) (-> offs y)))
              (set! (-> pt z) (+ (-> pt z) (-> offs z))))
            ;; retour aux coordonnees du JOINT : le solveur, la contrainte de longueur et l'ecriture
            ;; dans le squelette raisonnent tous sur le joint, jamais sur le centre du volume.
            (set! (-> pt x) (- (-> pt x) (-> offs x)))
            (set! (-> pt y) (- (-> pt y) (-> offs y)))
            (set! (-> pt z) (- (-> pt z) (-> offs z)))
            ;; [NOTE-30] ------------------------------------------------------------------------------ -> jak-hd-physics-NOTES.md
            (dotimes (fin PHYS-FIN-ITERS)
              ;; --- (a) UNE SEULE PASSE SUR LES VOLUMES, DEUX CORRECTIONS.
              ;; La mise en place d'un volume (`phys-col-now!`, `phys-col-rest!`, les trois
              ;; profondeurs) coute le meme prix pour le franchissement de cote et pour la
              ;; profondeur : la faire DEUX fois doublait le cout de la boucle de finition et la
              ;; course de la salle ne tenait plus dans son delai. Une passe, deux consommateurs.
              ;; Le test de cote garde son propre interrupteur (`*phys-side-off*`) et son propre
              ;; predicat d'exclusion (`phys-col-own?` NON leve par `self-inject`), exactement
              ;; comme avant : c'est un partage de calcul, pas une fusion de semantiques.
              (let ((qx (+ (-> pt x) (-> offs x)))
                    (qy (+ (-> pt y) (-> offs y)))
                    (qz (+ (-> pt z) (-> offs z))))
                (dotimes (ci nco)
                  (let* ((sco (+ (* slot PHYS-COLS) ci))
                         (cj  (-> *phys-cj* sco))
                         (cj2 (-> *phys-cj2* sco))
                         (ownr (phys-col-own? sc n cj cj2))
                         (selfp (and ownr (nonzero? *phys-self-inject*))))
                    (when (and (or (not ownr) selfp) (>= cj 0) (< (+ cj 1) nbone))
                      (phys-col-now! skel sco cj cj2 nbone ca cb)
                      (when (not (phys-col-rest! sco ra rb))
                        (vector-copy! ra ca) (vector-copy! rb cb))
                      (let* ((cap? (and (>= cj2 0) (< (+ cj2 1) nbone)))
                             (fs (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                     (-> *phys-cr2* sco) cap? nrm))
                             (fc (phys-collide-depth rest rl ca cb (-> *phys-cr* sco)
                                                     (-> *phys-cr2* sco) cap? nrm))
                             (fe (if selfp 0.0
                                   (phys-vol-floor (if (> fc fs) fc fs)
                                                   (phys-vol-yield sc cj cj2)))))
                        (set-vector! pv qx qy qz 1.0)
                        (let ((fq (phys-collide-depth pv rl ca cb (-> *phys-cr* sco)
                                                      (-> *phys-cr2* sco) cap? nrm)))
                          ;; --- (a1) LA PROFONDEUR, POUSSEE **TANGENTIELLEMENT** A LA SPHERE
                          ;; --- DE L'ATTACHE. [NOTE-61] -> jak-hd-physics-NOTES.md
                          (when (> fq fe)
                            (let* ((ex (- (- qx (-> offs x)) (-> bv x)))
                                   (ey (- (- qy (-> offs y)) (-> bv y)))
                                   (ez (- (- qz (-> offs z)) (-> bv z)))
                                   (en (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez))))))
                              (when (> en 0.0001)
                                (let* ((iv (/ 1.0 en))
                                       (ux (* ex iv)) (uy (* ey iv)) (uz (* ez iv))
                                       (dd (- fq fe))
                                       (cn (+ (* (-> nrm x) ux)
                                              (+ (* (-> nrm y) uy) (* (-> nrm z) uz)))))
                                  (set! qx (+ qx (* dd (- (-> nrm x) (* cn ux)))))
                                  (set! qy (+ qy (* dd (- (-> nrm y) (* cn uy)))))
                                  (set! qz (+ qz (* dd (- (-> nrm z) (* cn uz)))))
                                  (set! *phys-tan-n* (+ *phys-tan-n* 1))
                                  (set! *phys-tan-d* (+ *phys-tan-d* dd))
                                  ;; `dd * s^2` = ce que le pas retire REELLEMENT. Le rapport
                                  ;; `removed/sumdepth` EST le rendement geometrique moyen.
                                  (set! *phys-tan-e*
                                        (+ *phys-tan-e* (* dd (- 1.0 (* cn cn)))))))))
                          ;; --- (a2) LE FRANCHISSEMENT D'AXE. Deux conditions, pas une : la pose
                          ;; --- d'AUTEUR doit etre dans le volume pour que « de quel cote » ait un
                          ;; --- sens pour elle, ET le maillon SIMULE doit y etre aussi.
                          (when (and (zero? *phys-side-off*) (not ownr)
                                     (> (if (> fc fs) fc fs) 0.0) (> fq 0.0))
                            (set-vector! pv qx qy qz 1.0)
                            (when (and (phys-axis-dir rest ca cb ua)
                                       (phys-axis-dir pv ca cb ub))
                              (let ((dt1 (+ (* (-> ua x) (-> ub x))
                                            (+ (* (-> ua y) (-> ub y))
                                               (* (-> ua z) (-> ub z))))))
                                (when (< dt1 0.0)
                                  (let ((cc (* dt1 (-> ub w))))
                                    (set! qx (- qx (* cc (-> ua x))))
                                    (set! qy (- qy (* cc (-> ua y))))
                                    (set! qz (- qz (* cc (-> ua z))))))))))))))
                (set! (-> pt x) (- qx (-> offs x)))
                (set! (-> pt y) (- qy (-> offs y)))
                (set! (-> pt z) (- qz (-> offs z))))
              ;; --- (b) LA LONGUEUR, et c'est la DERNIERE operation de la boucle, donc du
              ;; --- solveur : `ROOM-STRETCH` reste exact par construction.
              (phys-len-project! skel scl l kk kp nbone pt))
            (set! (-> *phys-px* scl) (-> pt x))
            (set! (-> *phys-py* scl) (-> pt y))
            (set! (-> *phys-pz* scl) (-> pt z)))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; COMBIEN DE PAIRES (LIEN, VOLUME) ONT BASCULE D'ETAT DEPUIS LA FRAME PRECEDENTE. C'est la mesure
;; du defaut que la 6e passe designe : un interrupteur binaire evalue chaque frame sur la pose du
;; modele saute quand il bascule, et le lien saute avec lui. On mesure l'etat CONTRAINT / LIBRE
;; (plancher effectif fini ou non) par paire, on le compare a celui de la frame precedente, et on
;; publie le nombre de bascules par chaine. La forme continue doit le faire tomber.
;; ------------------------------------------------------------------------------------------------
(defun phys-popcount ((v int))
  "nombre de bits a 1 dans les 32 bits bas de v."
  (let ((c 0) (x (logand v #xffffffff)))
    (while (nonzero? x)
      (+! c (the int (logand x 1)))
      (set! x (shr x 1)))
    c))

(defun phys-flip-count ((skel skeleton) (sc int) (n int) (rlk int) (nbone int) (nco int))
  (let ((slot (/ sc PHYS-CHAINS))
        (rest (new 'stack-no-clear 'vector))
        (cur  (new 'stack-no-clear 'vector))
        (off  (new 'stack-no-clear 'vector))
        (ca   (new 'stack-no-clear 'vector))
        (cb   (new 'stack-no-clear 'vector))
        (ra   (new 'stack-no-clear 'vector))
        (rb   (new 'stack-no-clear 'vector))
        (nrm  (new 'stack-no-clear 'vector)))
    (dotimes (l n)
      (when (>= l rlk)
        (let* ((scl (+ (* sc PHYS-LINKS) l))
               (kk  (-> *phys-joint* scl))
               (rl  (-> *phys-lcr* scl)))
          (when (and (>= kk 0) (< (+ kk 1) nbone))
            (phys-link-off! skel scl kk off)
            (vector-copy! rest (the-as vector (-> skel bones (+ kk 1) transform vector 3)))
            (set! (-> rest x) (+ (-> rest x) (-> off x)))
            (set! (-> rest y) (+ (-> rest y) (-> off y)))
            (set! (-> rest z) (+ (-> rest z) (-> off z)))
            (set! (-> cur x) (+ (-> *phys-px* scl) (-> off x)))
            (set! (-> cur y) (+ (-> *phys-py* scl) (-> off y)))
            (set! (-> cur z) (+ (-> *phys-pz* scl) (-> off z)))
            (set! (-> cur w) 1.0)
            (let ((w0 0) (w1 0) (w2 0))
              (dotimes (ci (min nco (* 32 PHYS-FLIPW)))
                (let* ((sco (+ (* slot PHYS-COLS) ci))
                       (cj  (-> *phys-cj* sco))
                       (cj2 (-> *phys-cj2* sco))
                       (bit 0))
                  (when (and (not (phys-col-own? sc n cj cj2)) (>= cj 0) (< (+ cj 1) nbone))
                    (phys-col-now! skel sco cj cj2 nbone ca cb)
                    (when (not (phys-col-rest! sco ra rb))
                      (vector-copy! ra ca) (vector-copy! rb cb))
                    ;; L'ETAT SUIVI EST « EN CONTACT », plus « contraint ou libre ». Depuis que la
                    ;; branche PHYS-VOL-FREE est retiree, toute paire est contrainte : garder
                    ;; l'ancien predicat aurait rendu ce bit constamment 1, donc le compteur de
                    ;; bascules identiquement nul — un instrument mort qui affiche du vert. Le
                    ;; predicat de contact est celui de `phys-link-pen`, donc les deux passes
                    ;; parlent de la meme chose : dedans a la pose du modele, ou dedans maintenant.
                    (let* ((cap?   (and (>= cj2 0) (< (+ cj2 1) nbone)))
                           (floor0 (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                       (-> *phys-cr2* sco) cap? nrm))
                           (dep    (phys-collide-depth cur rl ca cb (-> *phys-cr* sco)
                                                       (-> *phys-cr2* sco) cap? nrm)))
                      (when (or (> floor0 0.0) (> dep 0.0)) (set! bit 1))))
                  (when (nonzero? bit)
                    (cond
                      ((< ci 32)  (set! w0 (logior w0 (ash 1 ci))))
                      ((< ci 64)  (set! w1 (logior w1 (ash 1 (- ci 32)))))
                      (else       (set! w2 (logior w2 (ash 1 (- ci 64)))))))))
              (let ((fb (* scl PHYS-FLIPW)))
                (when (nonzero? (-> *phys-flhas* scl))
                  (let ((ch (+ (phys-popcount (logxor w0 (-> *phys-fl* fb)))
                               (+ (phys-popcount (logxor w1 (-> *phys-fl* (+ fb 1))))
                                  (phys-popcount (logxor w2 (-> *phys-fl* (+ fb 2))))))))
                    (when (> ch 0)
                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 2))
                            (+ (the float ch) (-> *phys-dg* (+ (* sc PHYS-DG) 2)))))))
                (set! (-> *phys-fl* fb) w0)
                (set! (-> *phys-fl* (+ fb 1)) w1)
                (set! (-> *phys-fl* (+ fb 2)) w2)
                (set! (-> *phys-flhas* scl) 1))))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; MESURE de la penetration RESIDUELLE d'UN lien place en `pt` : meme predicat, memes volumes, meme
;; plancher de pose modele que la resolution, mais SANS marge et sans rien deplacer. C'est la seule
;; definition de « ca traverse » du moteur, et elle sert aux trois usages (resoudre, reculer,
;; mesurer) — il n'y a donc pas d'instrument de mesure different de l'instrument de decision.
;; ------------------------------------------------------------------------------------------------
(defun phys-surf-sd ((skel skeleton) (slot int) (p vector) (nbone int))
  "(SPEC 18) DISTANCE SIGNEE du point `p` a la VRAIE SURFACE SKINNEE. Positive = dehors.
   NATURE : une distance, unites de jeu. REPERE : le monde, frame courante. LECTURE HORS DEFAUT :
   positive. La sentinelle 1000000.0 = « aucun echantillon a portee », ce qui n'est PAS zero.
   La surface est l'ensemble `bs` : de vrais sommets du mesh skinne avec leur normale sortante,
   dans le repere de leur os ; chaque ensemble monte la matrice VIVANTE de son os, donc en toute
   pose les echantillons SONT la surface. Plus proche echantillon puis signe par SA normale — une
   SDF de nuage de points, dont l'erreur est bornee par l'ecart entre echantillons et non par la
   façon dont une capsule epouse une machoire. C'est tout l'argument. L'echelle du rig est dans les
   matrices d'os, donc la normale tournee est renormalisee."
  (let ((best 1000000.0)
        (bestd2 1000000000000.0)
        (qw (new 'stack-no-clear 'vector))
        (nw (new 'stack-no-clear 'vector))
        (dv (new 'stack-no-clear 'vector))
        (sb (* slot PHYS-BSURF-SETS)))
    (dotimes (s (-> *phys-slot-nbsurf* slot))
      (let ((k (-> *phys-bsk* (+ sb s))))
        (when (and (>= k 0) (< (+ k 1) nbone))
          (let ((bm (the-as matrix (-> skel bones (+ k 1) transform))))
            (vector-! dv p (the-as vector (-> bm vector 3)))
            (set! (-> dv w) 0.0)
            ;; phase large : cet os est-il seulement dans les parages ?
            (when (< (vector-length dv) (+ (-> *phys-bsr* (+ sb s)) 512.0))
              (dotimes (q (-> *phys-bsn* (+ sb s)))
                (let ((qi (+ (* (+ sb s) PHYS-BSURF-MAX) q)))
                  (vector-rotate*! qw (-> *phys-bsp* qi) bm)
                  (set! (-> qw w) 0.0)
                  (vector+! qw qw (the-as vector (-> bm vector 3)))
                  (vector-! dv p qw)
                  (set! (-> dv w) 0.0)
                  (+! *phys-skintest* 1)
                  (let ((d2 (vector-dot dv dv)))
                    (when (< d2 bestd2)
                      (set! bestd2 d2)
                      (vector-rotate*! nw (-> *phys-bsnm* qi) bm)
                      (set! (-> nw w) 0.0)
                      (let ((nl (vector-length nw)))
                        (when (> nl 0.000001)
                          (vector-float*! nw nw (/ 1.0 nl))
                          (set! best (vector-dot dv nw)))))))))))))
    best))

(defun phys-skinpen-worst ((slot int) (chain int))
  "La pire entree SOUS la peau vue sur la fenetre, en unites de jeu, ou 0 si le lien est reste
   dehors. A lire A COTE de `meshpen` : celui-ci mesure contre les VOLUMES (29.7 % de la
   geometrie), celui-la contre la PEAU."
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-skinpen* (+ (* slot PHYS-CHAINS) chain))
    0.0))

(defun phys-skinpen-reset! ()
  (set! *phys-skintest* 0)
  (dotimes (i PHYS-SC) (set! (-> *phys-skinpen* i) 0.0))
  (none))

(defun phys-skin-meas-set! ((v int))
  "Arme la mesure SPEC 18. La salle l'arme, le jeu ne l'arme jamais."
  (set! *phys-skin-meas* v)
  (none))

(defun phys-skintest-count () *phys-skintest*)

(defun phys-link-pen ((skel skeleton) (sc int) (n int) (nbone int) (nco int) (l int) (pt vector)
                      (prio int))
  "LA PENETRATION DU LIEN `l` SI SON JOINT ETAIT EN `pt`.
   NATURE : une profondeur, en metres. REPERE : monde. LECTURE HORS DEFAUT : PHYS-NOCONTACT.

   `prio` = 1 quand l'appel SERT LE SOLVEUR (le recul) : la DECISION 1 s'applique, seul le volume
   decideur du lien compte pour la PROFONDEUR. `prio` = 0 quand l'appel MESURE : tous les volumes
   comptent, sinon le chiffre deviendrait aveugle a ce que la decision laisse passer.

   LE FRANCHISSEMENT D'AXE N'EST JAMAIS SOUMIS A LA PRIORITE, ET CE N'EST PAS UNE EXCEPTION DE
   CONFORT : deux volumes ne peuvent pas se contredire dessus. La pose du modele est du BON cote de
   CHAQUE axe par construction, donc reculer vers elle les satisfait tous a la fois — il n'y a
   aucun conflit a arbitrer. Le soumettre a la priorite rouvrirait `goggles-tunnel` (les lunettes
   qui traversent le buste pour se poser dans le dos), que ce veto est precisement ce qui ferme."
  (let ((slot (/ sc PHYS-CHAINS))
        (worst PHYS-NOCONTACT)
        (rest (new 'stack-no-clear 'vector))
        (off  (new 'stack-no-clear 'vector))
        (offs (new 'stack-no-clear 'vector))
        (bv   (new 'stack-no-clear 'vector))
        (q    (new 'stack-no-clear 'vector))
        (ca   (new 'stack-no-clear 'vector))
        (cb   (new 'stack-no-clear 'vector))
        (ra   (new 'stack-no-clear 'vector))
        (rb   (new 'stack-no-clear 'vector))
        (ua   (new 'stack-no-clear 'vector))
        (ub   (new 'stack-no-clear 'vector))
        (nrm  (new 'stack-no-clear 'vector)))
    (let* ((scl (+ (* sc PHYS-LINKS) l))
           (kk  (-> *phys-joint* scl))
           (rl  (-> *phys-lcr* scl))
           (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) (-> *phys-anchor* sc))))
      (when (and (>= kk 0) (< (+ kk 1) nbone))
        ;; `pt` arrive en coordonnees de JOINT (c'est ce que manipulent le solveur et le recul) :
        ;; on le porte sur le centre du volume, comme la resolution. La pose du MODELE porte son
        ;; volume par la matrice ANIMEE, le point EVALUE le porte par SA direction : sans ca la
        ;; dichotomie du recul chercherait avec un obstacle fige sur l'animation.
        (phys-link-off! skel scl kk off)
        (if (> l 0)
          (set-vector! bv (-> *phys-px* (- scl 1)) (-> *phys-py* (- scl 1)) (-> *phys-pz* (- scl 1)) 1.0)
          (if (and (>= kp 0) (< (+ kp 1) nbone))
            (vector-copy! bv (the-as vector (-> skel bones (+ kp 1) transform vector 3)))
            (set-vector! bv 0.0 0.0 0.0 1.0)))
        (phys-link-off-sim! skel scl kk kp nbone bv pt offs)
        (vector-copy! rest (the-as vector (-> skel bones (+ kk 1) transform vector 3)))
        (set! (-> rest x) (+ (-> rest x) (-> off x)))
        (set! (-> rest y) (+ (-> rest y) (-> off y)))
        (set! (-> rest z) (+ (-> rest z) (-> off z)))
        (set! (-> q x) (+ (-> pt x) (-> offs x)))
        (set! (-> q y) (+ (-> pt y) (-> offs y)))
        (set! (-> q z) (+ (-> pt z) (-> offs z)))
        (set! (-> q w) 1.0)
        (dotimes (ci nco)
          (let* ((sco (+ (* slot PHYS-COLS) ci))
                 (cj  (-> *phys-cj* sco))
                 (cj2 (-> *phys-cj2* sco))
                 (own (phys-col-own? sc n cj cj2))
                 ;; DECISION 1, cote SOLVEUR uniquement : la profondeur du volume ecarte ne
                 ;; participe pas au recul. La MESURE (`prio` = 0) continue de la voir.
                 (skip (and (nonzero? prio)
                            (zero? *phys-prio-off*)
                            (>= (-> *phys-lwin* scl) 0)
                            (!= sco (-> *phys-lwin* scl)))))
            (when (and own (nonzero? *phys-self-inject*)) (set! own #f))
            (when (and (not own) (>= cj 0) (< (+ cj 1) nbone))
              (phys-col-now! skel sco cj cj2 nbone ca cb)
              (when (not (phys-col-rest! sco ra rb))
                (vector-copy! ra ca) (vector-copy! rb cb))
              (let* ((cap?   (and (>= cj2 0) (< (+ cj2 1) nbone)))
                     (floors (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                 (-> *phys-cr2* sco) cap? nrm))
                     (floorc (phys-collide-depth rest rl ca cb (-> *phys-cr* sco)
                                                 (-> *phys-cr2* sco) cap? nrm))
                     (floor0 (if (> floorc floors) floorc floors))
                     ;; MEME PLANCHER QUE LE SOLVEUR, IMPOSE PAR UNE MESURE : ancre a la pose d'AUTEUR
                     ;; il lisait un OFFSET CONSTANT (+0.0441 m, la bande SPEC 10) qui noyait le
                     ;; controle positif (POSCONTROL 0.0668/0.0440, CONE 0.0440 SOUS 0.0441). Une
                     ;; compression que la spec AUTORISE n'est pas une penetration. NOTE-55.
                     (feff   (phys-vol-floor floor0 (phys-vol-yield sc cj cj2)))
                     (dep    (phys-collide-depth q rl ca cb (-> *phys-cr* sco)
                                                 (-> *phys-cr2* sco) cap? nrm))
                     (res    (- dep feff)))
                ;; [NOTE-31] CHANGER DE COTE EST UNE PENETRATION, ET C'EST LA SEULE QUE LA PROFONDEUR NE PEUT -> jak-hd-physics-NOTES.md
                (when (and (> floor0 0.0)
                           (phys-axis-dir rest ca cb ua) (phys-axis-dir q ca cb ub)
                           (< (+ (* (-> ua x) (-> ub x))
                                 (+ (* (-> ua y) (-> ub y)) (* (-> ua z) (-> ub z))))
                              0.0))
                  ;; compte une fois par frame (le meme drapeau que `buried` : `phys-pen-chain`
                  ;; l'arme, le recul ne l'arme pas, donc les 3 reculs et leurs 13 pas de
                  ;; dichotomie ne comptent pas).
                  (when (nonzero? *phys-buried-tally*)
                    (set! (-> *phys-dg* (+ (* sc PHYS-DG) 11))
                          (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 11)))))
                  (when (zero? *phys-side-off*)
                    (let ((wv (-> ub w)))
                      (when (> wv worst) (set! worst wv)))))
                ;; `buried` = le lien est entierement dans ce volume A SA POSE DE MODELE. Depuis le
                ;; 2026-08-12 c'est une MESURE et plus une DECISION : elle ne dispense plus la paire
                ;; d'etre contrainte (cf. phys-vol-floor, branche FREE retiree). Le nombre reste
                ;; publie parce que c'est lui qui a designe `goggles-tunnel` — mais il ne commande
                ;; plus rien, et l'instrument de mesure cesse d'etre l'instrument de derogation.
                (when (>= floor0 (* 2.0 rl))
                  (set! *phys-buried-n* (+ *phys-buried-n* 1))
                  (when (nonzero? *phys-buried-tally*)
                    (set! (-> *phys-dg* (+ (* sc PHYS-DG) 9))
                          (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 9))))))
                ;; EN CONTACT = dedans a sa pose de modele, ou dedans maintenant. Une paire dont
                ;; les deux profondeurs sont nulles (un volume a l'autre bout du corps) n'est pas
                ;; un contact : la compter rendrait le residu identiquement nul et la colonne
                ;; deviendrait un zero constant, c.-a-d. indistinguable d'une colonne fabriquee.
                ;; `skip` ne porte QUE sur la profondeur : c'est la seule grandeur sur laquelle
                ;; deux volumes qui se recouvrent peuvent se contredire.
                (when (and (not skip) (or (> floor0 0.0) (> dep 0.0)) (> res worst))
                  (set! worst res))
                ;; QUEL VOLUME PORTE LE PIRE RESIDU. `meshpen` ne publiait qu'un MAXIMUM, donc le
                ;; cycle suivant repartait sans savoir CONTRE QUOI. On garde le max de la fenetre
                ;; (17) et l'indice du volume qui le porte (18) : c'est l'argmax, pas une moyenne.
                (when (and (not skip) (or (> floor0 0.0) (> dep 0.0))
                           (> res (-> *phys-dg* (+ (* sc PHYS-DG) 17))))
                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 17)) res)
                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 18)) (the float ci)))
                ;; QUEL VOLUME CONTRAINT QUEL MAILLON. Compte les paires (lien, volume) en
                ;; VIOLATION, pas en contact : `res > 0` veut dire que ce volume-ci demande une
                ;; correction cette frame. Un contact a profondeur nulle n'est pas une contrainte,
                ;; et le compter rendrait la colonne aveugle a la difference entre les deux.
                (when (and (nonzero? *phys-buried-tally*) (> res 0.0))
                  (let ((h (+ (* (+ (* sc PHYS-LINKS) l) PHYS-COLS) ci)))
                    (set! (-> *phys-cvh* h) (+ 1 (-> *phys-cvh* h)))))))))))
    worst))

(defun phys-pen-chain ((skel skeleton) (sc int) (n int) (rlk int) (nbone int) (nco int))
  "L'INSTRUMENT MESURE TOUJOURS CONTRE LE SOLIDE QUE LA DONNEE DESIGNE, quel que soit le predicat
   que le SOLVEUR utilise. Sans ca le controle de `*phys-cone-off*` serait casse dans le sens que
   les DIRECTIVES sanctionnent : arme, le solveur cesserait de pousser ET la mesure cesserait de
   regarder, donc le compteur TOMBERAIT sous le defaut au lieu de MONTER. Ici il monte, parce que
   le solveur laisse le lien dans un solide que la mesure, elle, continue de voir en entier.
   `prio` = 0 n'a que CE seul appelant (le solveur passe 1) : la restauration est donc totale."
  (let ((worst PHYS-NOCONTACT)
        (coneprev *phys-cone-off*)
        (pt (new 'stack-no-clear 'vector)))
    (set! *phys-cone-off* 0)
    ;; SEULE passe de la frame ou l'enfouissement est compte par chaine (voir *phys-buried-tally*).
    (set! *phys-buried-tally* 1)
    (dotimes (l n)
      (when (>= l rlk)
        (let ((scl (+ (* sc PHYS-LINKS) l)))
          (set! (-> pt x) (-> *phys-px* scl))
          (set! (-> pt y) (-> *phys-py* scl))
          (set! (-> pt z) (-> *phys-pz* scl))
          (set! (-> pt w) 1.0)
          (let ((r (phys-link-pen skel sc n nbone nco l pt 0)))
            (when (> r worst) (set! worst r)))
          ;; SPEC 18, MESURE SEULE — le meme point, mesure contre la PEAU au lieu des volumes.
          ;; Aucune correction n'en decoule : cette passe ne deplace rien, donc cette ligne ne peut
          ;; pas retirer de mouvement. Elle donne l'echelle qui manquait a `meshpen`.
          (when (nonzero? *phys-skin-meas*)
            (let ((sd (phys-surf-sd skel (/ sc PHYS-CHAINS) pt nbone)))
              (when (and (< sd 0.0) (> sd -100000.0))
                (when (> (- 0.0 sd) (-> *phys-skinpen* sc))
                  (set! (-> *phys-skinpen* sc) (- 0.0 sd)))))))))
    (set! *phys-buried-tally* 0)
    (set! *phys-cone-off* coneprev)
    ;; la sentinelle est RENDUE TELLE QUELLE : « aucun contact » n'est pas « penetration nulle »,
    ;; et c'est l'appelant qui compte les deux separement. Confondre les deux, c'est annoncer un
    ;; zero mesure la ou rien n'a ete mesure.
    worst))
;; ------------------------------------------------------------------------------------------------
;; ------------------------------------------------------------------------------------------------
;; PIERRE TOMBALE — `phys-retreat-chain` a ete retiree ici le 2026-08-13 ; la note complete est a
;; l'endroit ou elle etait appelee, dans `jak-hd-physics-step`. Ses compteurs `*phys-retreat-*`
;; restent definis et restent a zero : un limiteur retire se chiffre, il ne se tait pas.
;; ------------------------------------------------------------------------------------------------

(defconstant PHYS-POSE-RATIO 50.0)

(defun phys-pose-repair ((obj jak-hd) (skel skeleton) (sc int) (n int) (an int) (nbone int)
                        (report symbol))
  "RE-ASSEOIR un lien que le retarget a envoye ailleurs, au lieu de le simuler autour d'une position
   fausse ET au lieu de le supprimer des donnees. Owner/superviseur du 2026-08-11 : une chaine se
   REPARE, elle ne se retire pas. La position de secours est derivee du rig et de rien d'autre : le
   porteur, prolonge le long de SON os (de son parent vers lui), a la distance que le mesh mesure
   pour ce lien (son rayon ajuste). Elle est ecrite dans le squelette AVANT la physique, donc la
   geometrie du lien suit, et la reparation est comptee et publiee. C'est un defaut de MODELE
   corrige au dernier moment possible, pas une physique inventee."
  (let ((seat (new 'stack-no-clear 'vector))
        (dir  (new 'stack-no-clear 'vector))
        (ib   (new 'stack-no-clear 'matrix))
        (lk   (new 'stack-no-clear 'matrix)))
    (dotimes (l n)
      (let* ((scl (+ (* sc PHYS-LINKS) l))
             (kk  (-> *phys-joint* scl))
             (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an))
             (rl  (-> *phys-rad* scl)))
        (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone) (> rl 0.01))
          (let ((d (vector-vector-distance
                     (the-as vector (-> skel bones (+ kk 1) transform vector 3))
                     (the-as vector (-> skel bones (+ kp 1) transform vector 3)))))
            (when report
              (format 0 "[HD-PHYS] pose c=~D l=~D dist=~f rad=~f ratio=~f~%"
                      (mod sc PHYS-CHAINS) l d rl (/ d rl)))
            (when (> d (* PHYS-POSE-RATIO rl))
              ;; [NOTE-32] ------------------------------------------------------------------------------ -> jak-hd-physics-NOTES.md
              (let ((done #f))
                (when (and (nonzero? (-> obj draw jgeo))
                           (< kk (-> obj draw jgeo length))
                           (< kp (-> obj draw jgeo length)))
                  (matrix-4x4-inverse! ib (-> obj draw jgeo data kk bind-pose))
                  (matrix*! lk ib (-> obj draw jgeo data kp bind-pose))
                  (set-vector! seat (-> lk vector 3 x) (-> lk vector 3 y) (-> lk vector 3 z) 1.0)
                  (when (> (+ (fabs (-> seat x)) (+ (fabs (-> seat y)) (fabs (-> seat z)))) 0.01)
                    (vector-matrix*! seat seat (the-as matrix (-> skel bones (+ kp 1) transform)))
                    (set! done #t)))
                (when (not done)
                  (set! *phys-reseat-fb* (+ *phys-reseat-fb* 1))
                  ;; direction de l'os du porteur : de SON parent vers lui. A defaut (porteur
                  ;; racine), la verticale du monde vers le bas — ce qui pend, pend.
                  (let ((gp (the int (-> (-> obj khd-par) kp))))
                    (cond
                      ((and (!= gp 255) (< (+ gp 1) nbone))
                       (set! (-> dir x) (- (-> skel bones (+ kp 1) transform vector 3 x)
                                           (-> skel bones (+ gp 1) transform vector 3 x)))
                       (set! (-> dir y) (- (-> skel bones (+ kp 1) transform vector 3 y)
                                           (-> skel bones (+ gp 1) transform vector 3 y)))
                       (set! (-> dir z) (- (-> skel bones (+ kp 1) transform vector 3 z)
                                           (-> skel bones (+ gp 1) transform vector 3 z)))
                       (set! (-> dir w) 0.0))
                      (else (set-vector! dir 0.0 -1.0 0.0 0.0))))
                  (let ((dl (vector-length dir)))
                    (if (> dl 0.01)
                      (vector-float*! dir dir (/ rl dl))
                      (set-vector! dir 0.0 (- 0.0 rl) 0.0 0.0)))
                  (set! (-> seat x) (+ (-> skel bones (+ kp 1) transform vector 3 x) (-> dir x)))
                  (set! (-> seat y) (+ (-> skel bones (+ kp 1) transform vector 3 y) (-> dir y)))
                  (set! (-> seat z) (+ (-> skel bones (+ kp 1) transform vector 3 z) (-> dir z)))))
              (when report
                (format 0 "[HD-PHYS] reseat c=~D l=~D dist=~f rad=~f ratio=~f~%"
                        (mod sc PHYS-CHAINS) l d rl (/ d rl))
                ;; LA PREUVE QUE LA PLACE A CHANGE, et de combien : la distance au porteur que le
                ;; rig donne, contre celle que l'ancienne heuristique donnait (le rayon `rl`).
                (format 0 "[HD-PHYS] reseat-at c=~D l=~D bind=~f oldheur=~f~%"
                        (mod sc PHYS-CHAINS) l
                        (vector-vector-distance
                          seat (the-as vector (-> skel bones (+ kp 1) transform vector 3)))
                        rl))
              (set! *phys-reseat-n* (+ *phys-reseat-n* 1))
              (set! (-> skel bones (+ kk 1) transform vector 3 x) (-> seat x))
              (set! (-> skel bones (+ kk 1) transform vector 3 y) (-> seat y))
              (set! (-> skel bones (+ kk 1) transform vector 3 z) (-> seat z))
              (set! (-> skel bones (+ kk 1) transform vector 3 w) 1.0)))))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; LE PAS — appele depuis do-joint-math! de jak-hd, APRES fill-jak-hd-bones!. A cet instant le
;; squelette porte la pose retargetee complete en espace MONDE (jak-hd.gc:551-556), et rien ne l'a
;; encore lue : bones-mtx-calc-execute (drawable.gc:895) vient bien plus tard dans la frame.
;; ------------------------------------------------------------------------------------------------
(defun jak-hd-physics-step ((obj jak-hd))
  (let ((slot (phys-slot-for-pid (the int (-> obj pid)))))
    (when (and (>= slot 0)
               (nonzero? (pc-physics-enabled))
               (nonzero? (-> obj draw))
               (nonzero? (-> obj draw skeleton))
               (nonzero? (-> obj draw jgeo)))
      (let* ((skel   (-> obj draw skeleton))
             (nbone  (-> skel length))
             (njoint (min (-> obj draw jgeo length) PHYS-JOINTS))
             (nch    (-> *phys-slot-nch* slot))
             (nco    (-> *phys-slot-nco* slot))
             (dt     0.0166667)
             ;; 9.81 m/s^2 dans les unites de l'integrateur : 9.81 * 4096 u/m / 3600 frames^2/s^2
             ;; = 11.16 u/frame^2. L'ancienne valeur (-160, ENCORE multipliee par dt^2) donnait
             ;; 0.044 u/frame^2, 250 fois trop faible : la famille B ne pendait pas du tout. C'est
             ;; une erreur d'unites, pas un reglage.
             (gy     -11.16))
        (dotimes (k njoint) (set! (-> *phys-dhas* k) 0))
        ;; LA POSE D'AUTEUR DES VOLUMES, AVANT QUE LA PREMIERE CHAINE N'ECRIVE. Les chaines sont
        ;; resolues l'une apres l'autre et chacune ecrit son joint dans le squelette : passe ce
        ;; point, `skel bones` ne porte plus la pose d'auteur pour les joints deja traites.
        (phys-snapshot-colliders! skel slot nco nbone)
        (let ((w2l  (new 'stack-no-clear 'matrix))
              (pre  (new 'stack-no-clear 'matrix))
              (inv  (new 'stack-no-clear 'matrix))
              (rot  (new 'stack-no-clear 'matrix))
              (tmp  (new 'stack-no-clear 'matrix))
              (dfa  (new 'stack-no-clear 'matrix))
              (dfb  (new 'stack-no-clear 'matrix))
              (dfc  (new 'stack-no-clear 'matrix))
              (anc  (new 'stack-no-clear 'vector))
              (tw   (new 'stack-no-clear 'vector))
              (acc  (new 'stack-no-clear 'vector))
              (fl   (new 'stack-no-clear 'vector))
              (gl   (new 'stack-no-clear 'vector))
              (gla  (new 'stack-no-clear 'vector))
              (gdw  (new 'stack-no-clear 'vector))
              (ov   (new 'stack-no-clear 'vector))
              (uv   (new 'stack-no-clear 'vector))
              (uv2  (new 'stack-no-clear 'vector))
              (sv   (new 'stack-no-clear 'vector))
              (sep  (new 'stack-no-clear 'vector))
              (pt   (new 'stack-no-clear 'vector))
              (rest (new 'stack-no-clear 'vector))
              (nrm  (new 'stack-no-clear 'vector)))
          (dotimes (c nch)
            (let* ((sc  (+ (* slot PHYS-CHAINS) c))
                   (an  (-> *phys-anchor* sc)))
              ;; LA POSE DU MODELE EST-ELLE PLAUSIBLE ? Une fois par chaine, a sa premiere frame, ou
              ;; le squelette porte enfin la pose retargetee. Une chaine ecartee passe a zero lien et
              ;; tout ce qui suit la saute — y compris son bloc de mesure, sinon elle publierait des
              ;; chiffres pris sur le joint d'a cote.
              (when (and (> (-> *phys-nlink* sc) 0) (>= an 0) (< (+ an 1) nbone))
                (phys-pose-repair obj skel sc (-> *phys-nlink* sc) an nbone
                                  (zero? (-> *phys-warm* sc))))
              ;; DEUX JEUX D'INDICES LA OU IL N'Y EN AVAIT QU'UN. `rootlock` portait DEUX roles :
              ;;   (1) « quels maillons sont epingles » — ce que toutes les gardes `(>= l rlk)`
              ;;       lisent (contrainte de longueur, collision, recul, angles, mesures) ;
              ;;   (2) « quel maillon les DONNEES declarent epingle », qui doit rester lisible meme
              ;;       quand une racine graduee met `rlk` a 0 — sinon le diagnostic `rootrot`
              ;;       disparait au lieu de publier l'angle reellement ecrit dans sa 3x3.
              ;; `rlk0` porte le role (2), `rlk` le role (1) et lui seul.
              (let* ((n    (-> *phys-nlink* sc))
                     (rlk0 (max 0 (min (-> *phys-rootlk* sc) (max 0 (- n 1)))))
                     (rgr  (-> *phys-rootgr* sc))
                     (rlk  (if (> rgr 0.0) 0 rlk0)))
              (when (and (> n 0) (>= an 0) (< (+ an 1) nbone))
                (let ((am (the-as matrix (-> skel bones (+ an 1) transform))))
                  (vector-copy! anc (the-as vector (-> am vector 3)))
                  (matrix-4x4-inverse! w2l am)
                  ;; [NOTE-33] --------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
                  (set-vector! gl 0.0 gy 0.0 0.0)
                  (vector-rotate*! gl gl w2l)
                  (let ((gn (vector-length gl)))
                    (when (> gn 0.0001) (vector-float*! gl gl (/ (fabs gy) gn))))
                  ;; [NOTE-34] --------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
                  (when (and (zero? (-> *phys-axok* sc)) (= (-> *phys-fam* sc) 1) (> n 0))
                    (let ((k0 (-> *phys-joint* (+ (* sc PHYS-LINKS) rlk))))
                      (when (and (>= k0 0) (< (+ k0 1) nbone))
                        (set-vector! sv
                                     (- (-> skel bones (+ k0 1) transform vector 3 x) (-> anc x))
                                     (- (-> skel bones (+ k0 1) transform vector 3 y) (-> anc y))
                                     (- (-> skel bones (+ k0 1) transform vector 3 z) (-> anc z))
                                     0.0)
                        (vector-rotate*! sv sv w2l)
                        ;; L'INVARIANT EXTERNE QUI NOMME LE LATERAL — voir la note de `*phys-axsep*`.
                        ;; On cherche l'AUTRE chaine de famille A pendue a la MEME ancre : c'est le
                        ;; sein oppose, et le segment qui va de l'un a l'autre est lateral par
                        ;; anatomie, pas par convention de rig. Rien ici ne suppose une orientation
                        ;; de modele, un nom d'os ni un ordre d'axes.
                        (set-vector! sep 0.0 0.0 0.0 0.0)
                        (set! (-> *phys-axsrc* sc) 0)
                        (dotimes (c2 nch)
                          (let ((sc2 (+ (* slot PHYS-CHAINS) c2)))
                            (when (and (zero? (-> *phys-axsrc* sc)) (!= c2 c)
                                       (= (-> *phys-fam* sc2) 1)
                                       (= (-> *phys-anchor* sc2) an)
                                       (> (-> *phys-nlink* sc2) 0))
                              (let ((k2 (-> *phys-joint* (* sc2 PHYS-LINKS))))
                                (when (and (>= k2 0) (< (+ k2 1) nbone))
                                  (set-vector! sep
                                               (- (-> skel bones (+ k0 1) transform vector 3 x)
                                                  (-> skel bones (+ k2 1) transform vector 3 x))
                                               (- (-> skel bones (+ k0 1) transform vector 3 y)
                                                  (-> skel bones (+ k2 1) transform vector 3 y))
                                               (- (-> skel bones (+ k0 1) transform vector 3 z)
                                                  (-> skel bones (+ k2 1) transform vector 3 z))
                                               0.0)
                                  (vector-rotate*! sep sep w2l)
                                  (set! (-> *phys-axsrc* sc) 1))))))
                        (let* ((gax (fabs (-> gl x)))
                               (gay (fabs (-> gl y)))
                               (gaz (fabs (-> gl z)))
                               (iv  (if (and (>= gax gay) (>= gax gaz)) 0 (if (>= gay gaz) 1 2)))
                               ;; les deux lignes restantes, sans branche cachee :
                               ;;   iv=0 -> (1,2)   iv=1 -> (0,2)   iv=2 -> (0,1)
                               (ja  (if (= iv 0) 1 0))
                               (jb  (if (= iv 2) 1 2))
                               ;; LATERAL D'ABORD, et c'est le renversement du cycle 10 : c'est le
                               ;; segment INTER-SEINS qui designe une ligne, et l'avant-arriere est
                               ;; « celle qui reste ». Le repli (chaine seule, pas de partenaire) lit
                               ;; la protrusion propre de l'organe et la nomme LATERALE elle aussi :
                               ;; la racine d'un sein est decalee lateralement par rapport au sternum,
                               ;; mesure sur le rig a (+356, -898, -146) u en repere `chest`, donc
                               ;; parmi les deux lignes non verticales c'est bien le lateral qui
                               ;; domine (13.3 % contre 2.2 %). Les deux regles rendent donc le meme
                               ;; verdict ici, et `*phys-axsrc*` dit laquelle a tranche.
                               (il  (if (nonzero? (-> *phys-axsrc* sc))
                                      (if (>= (fabs (-> sep data ja)) (fabs (-> sep data jb))) ja jb)
                                      (if (>= (fabs (-> sv data ja)) (fabs (-> sv data jb))) ja jb)))
                               (ia  (if (= il ja) jb ja)))
                          ;; CE QUE LA DECISION A COMPARE, publie tel quel : sans ces deux nombres,
                          ;; « le lateral est la ligne 0 » resterait une affirmation de source.
                          (set! (-> *phys-axsep* (+ (* sc 3) 0)) (-> sep data ja))
                          (set! (-> *phys-axsep* (+ (* sc 3) 1)) (-> sep data jb))
                          (set! (-> *phys-axsep* (+ (* sc 3) 2)) (vector-length sep))
                          (set! (-> *phys-axv* sc) iv)
                          (set! (-> *phys-axa* sc) ia)
                          (set! (-> *phys-axl* sc) il)
                          (set! (-> *phys-axok* sc) 1)
                          ;; [NOTE-77] LA DIRECTION MONDE DE CHACUNE DES TROIS LIGNES DU TRIEDRE, normalisee. -> jak-hd-physics-NOTES.md
                          (dotimes (rr 3)
                            (let* ((lr (sqrtf (+ (* (-> am vector rr x) (-> am vector rr x))
                                                 (+ (* (-> am vector rr y) (-> am vector rr y))
                                                    (* (-> am vector rr z) (-> am vector rr z))))))
                                   (ir (if (> lr 0.0001) (/ 1.0 lr) 0.0))
                                   (bb (+ (* sc 9) (* rr 3))))
                              (set! (-> *phys-axw* (+ bb 0)) (* (-> am vector rr x) ir))
                              (set! (-> *phys-axw* (+ bb 1)) (* (-> am vector rr y) ir))
                              (set! (-> *phys-axw* (+ bb 2)) (* (-> am vector rr z) ir))))
                          ;; ARMEE DES QU'IL Y A UN MAILLON LIBRE. Ce verrou exigeait DEUX
                          ;; articulations, et sa raison n'etait pas physique — une masse ponctuelle
                          ;; sur un ressort anisotrope a bien trois frequences propres. C'etait un
                          ;; INTERVERROUILLAGE : §29 armee avait ete mesuree a `meshpen` 0.0022 m
                          ;; contre le plafond de 0.0005. Le correctif de B0 (SPEC 6) ayant reduit
                          ;; l'excursion de 30-36 %, l'interverrouillage se re-mesure au lieu d'etre
                          ;; suppose — et il se retire si `meshpen` remonte au-dessus de 0.0005.
                          (when (> (- n rlk) 0)
                            (set! (-> *phys-axs* (+ (* sc 3) iv)) 1.0)
                            (set! (-> *phys-axs* (+ (* sc 3) ia)) (/ 1.0 PHYS-MOB-AP))
                            (set! (-> *phys-axs* (+ (* sc 3) il)) (/ 1.0 PHYS-MOB-LAT))
                            (set! (-> *phys-axan* sc) 1))))))
                  ;; [NOTE-35] LA GRAVITE ABSOLUE, VUE DE L'ANCRE, AVANT TOUTE SOUSTRACTION. C'est elle qui -> jak-hd-physics-NOTES.md
                  (vector-copy! gla gl)
                  (when (= (-> *phys-fam* sc) 1)
                    (let ((gb (* sc 3)))
                      ;; RELEVE une fois, premiere frame de la chaine : la pose debout d'auteur.
                      (when (zero? (-> *phys-warm* sc))
                        (set! (-> *phys-gref* (+ gb 0)) (-> gl x))
                        (set! (-> *phys-gref* (+ gb 1)) (-> gl y))
                        (set! (-> *phys-gref* (+ gb 2)) (-> gl z)))
                      (set! (-> gl x) (- (-> gl x) (-> *phys-gref* (+ gb 0))))
                      (set! (-> gl y) (- (-> gl y) (-> *phys-gref* (+ gb 1))))
                      (set! (-> gl z) (- (-> gl z) (-> *phys-gref* (+ gb 2))))))
                  ;; [NOTE-36] --------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
                  (set-vector! gdw 0.0 gy 0.0 0.0)
                  (when (= (-> *phys-fam* sc) 1)
                    (let ((gn (vector-length gl)))
                      (cond
                        ((> gn 0.0001)
                         (vector-rotate*! gdw gl am)
                         (let ((gw (vector-length gdw)))
                           (if (> gw 0.0001)
                             (vector-float*! gdw gdw (/ gn gw))
                             (set-vector! gdw 0.0 0.0 0.0 0.0))))
                        (else (set-vector! gdw 0.0 0.0 0.0 0.0)))))
                  (let* ((warm (-> *phys-warm* sc))
                         (w    (/ (* 6.2831853 (-> *phys-stiff* sc))
                                  (sqrtf (fmax 0.01 (-> *phys-mass* sc)))))
                         (k2   (* w w dt dt))
                         (dmp  (-> *phys-damp* sc))
                         (gsc  (-> *phys-grav* sc))
                         (cpl  (-> *phys-couple* sc)))
                    (set! (-> *phys-warm* sc) (min 3 (+ warm 1)))
                    ;; [NOTE-83] SPEC 37 — LE REBASE DE TRANSLATION, ET LA MESURE QUI JUGE SON SEUIL. -> jak-hd-physics-NOTES.md
                    (let ((rbd (if (> warm 1) (vector-vector-distance anc (-> *phys-anp* sc)) 0.0))
                          (dgr (* sc PHYS-DG)))
                      (when (> rbd (-> *phys-dg* (+ dgr 30))) (set! (-> *phys-dg* (+ dgr 30)) rbd))
                      (when (> rbd (* 7.00 (fmax 1.0 (-> *phys-b0* sc))))
                        (set! (-> *phys-dg* (+ dgr 29)) (+ 1.0 (-> *phys-dg* (+ dgr 29))))
                        (let ((dx (- (-> anc x) (-> *phys-anp* sc x)))
                              (dy (- (-> anc y) (-> *phys-anp* sc y)))
                              (dz (- (-> anc z) (-> *phys-anp* sc z))))
                          (dotimes (l n)
                            (let ((s2 (+ (* sc PHYS-LINKS) l)))
                              (+! (-> *phys-px* s2) dx) (+! (-> *phys-py* s2) dy) (+! (-> *phys-pz* s2) dz)
                              (+! (-> *phys-qx* s2) dx) (+! (-> *phys-qy* s2) dy) (+! (-> *phys-qz* s2) dz)
                              (+! (-> *phys-cpx* s2) dx) (+! (-> *phys-cpy* s2) dy) (+! (-> *phys-cpz* s2) dz)
                              (+! (-> *phys-cqx* s2) dx) (+! (-> *phys-cqy* s2) dy) (+! (-> *phys-cqz* s2) dz)))))
                      (vector-copy! (-> *phys-anp* sc) anc))
                    ;; LE STIMULUS GRAVITAIRE LUI-MEME, avant toute reponse. Sans ce nombre, un
                    ;; affaissement nul est indiscernable entre « la gravite n'arrive pas jusqu'a
                    ;; cette chaine » et « la chaine n'y repond pas », et c'est cette ambiguite qui
                    ;; a laisse quatre passes de l'owner sans reponse. 0 debout, 1.0 a 60 degres.
                    (let* ((stb (* sc PHYS-ST))
                           (gm  (/ (vector-length gl) (fabs gy))))
                      (when (> gm (-> *phys-st* (+ stb 18))) (set! (-> *phys-st* (+ stb 18)) gm)))
                    ;; ---- 0bis. SPEC 33/34 — CE QUI RESTE DE LA RESTITUTION, MESURE ET NON DEDUIT.
                    ;; La vitesse sortante `e*|vn|` est vraie A L'INSTANT OU on l'ecrit ; ce qui
                    ;; compte est ce qu'il en RESTE apres que la frame se soit terminee (longueur,
                    ;; balayages, attenuation). On relit donc `v = p - q` ICI, avant que cette
                    ;; frame-ci n'integre quoi que ce soit : c'est exactement l'etat laisse par la
                    ;; frame precedente. Sans ca, `out` serait `e * in` par construction — un nombre
                    ;; qui se compare a lui-meme, le faux vert le plus facile de ce dossier.
                    (dotimes (l n)
                      (let ((scl (+ (* sc PHYS-LINKS) l)))
                        (when (> (-> *phys-rstp* scl w) 0.5)
                          (let ((vn (+ (* (- (-> *phys-px* scl) (-> *phys-qx* scl)) (-> *phys-rstp* scl x))
                                       (+ (* (- (-> *phys-py* scl) (-> *phys-qy* scl)) (-> *phys-rstp* scl y))
                                          (* (- (-> *phys-pz* scl) (-> *phys-qz* scl)) (-> *phys-rstp* scl z))))))
                            (set! *phys-rstout* (+ *phys-rstout* vn))
                            (set! *phys-rstm* (+ *phys-rstm* 1)))
                          (set! (-> *phys-rstp* scl w) 0.0))))
                    ;; ---- 0. LES LONGUEURS D'OS, avant d'integrer quoi que ce soit. -------------
                    ;; Relevees sur la pose ANIMEE a chaque frame : elles sont quasi constantes,
                    ;; mais les lire evite de supposer que le retarget n'a pas change une longueur.
                    (dotimes (l n)
                      (let* ((scl (+ (* sc PHYS-LINKS) l))
                             (kk  (-> *phys-joint* scl))
                             (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
                        (set! (-> *phys-blen* scl) 0.0)
                        (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
                          (set! (-> *phys-blen* scl)
                                (vector-vector-distance
                                  (the-as vector (-> skel bones (+ kk 1) transform vector 3))
                                  (the-as vector (-> skel bones (+ kp 1) transform vector 3)))))))
                    ;; [NOTE-37] ---- 1. UNE PARTICULE PAR MAILLON, INTEGREE EN POSITION MONDE. ------------- -> jak-hd-physics-NOTES.md
                    (let* ((ela (if (= (-> *phys-fam* sc) 1) 1 0))
                           ;; PORTEE DE SPEC 21/22, RELEVEE SUR LA COURSE ET PAS SUR UN NOM :
                           ;; `PHYSCHAIN` publie `fam=` et `links=` pour les 22 chaines, et le couple
                           ;; (famille A, UN maillon) ne selectionne que `c=7 lBoob` et `c=8 rBoob`.
                           ;; Sens mecanique : une chaine a un maillon n'a aucune articulation
                           ;; interne, donc toute son excursion EST la rotation d'un bloc autour de
                           ;; son ancre — la grandeur meme que SPEC 22 borne. Les 13 chaines de
                           ;; famille B (lunettes, sangles, languettes) sont hors perimetre par
                           ;; construction, donc `goggles-tunnel` et `knee-tabs`, que l'owner a
                           ;; FERMES, ne peuvent pas etre payes ici.
                           ;; [NOTE-56] `(= n 1)` RETIRE le 2026-08-17 : c'etait la garde qui aurait -> jak-hd-physics-NOTES.md
                           ;; DESARME SPEC 21 et SPEC 22 a l'injection du second os. Famille A ne
                           ;; selectionne que chestL/chestR (les seules chaines simulees, ordre du
                           ;; 2026-08-14 07:30), donc le `n` etait un doublon de selecteur — et un
                           ;; zero produit par un bloc qui ne s'execute plus n'est pas un zero gagne.
                           ;; [NOTE-38] `gmean` et sa normalisation RETIREES le 2026-08-19 : voir NOTE-74. -> jak-hd-physics-NOTES.md
                           (sat (if (nonzero? ela) 1 0)))
                      (dotimes (l n)
                        (let* ((scl (+ (* sc PHYS-LINKS) l))
                               (k   (-> *phys-joint* scl)))
                          (when (and (>= k 0) (< (+ k 1) nbone))
                            (vector-copy! tw (the-as vector (-> skel bones (+ k 1) transform vector 3)))
                            ;; --- MESURE SEULEMENT. Acceleration MONDE de la pose d'auteur de ce
                            ;; lien : elle ne produit plus aucune force, elle definit le stimulus.
                            (set-vector! acc 0.0 0.0 0.0 0.0)
                            (when (> warm 1)
                              (set! (-> acc x) (+ (- (-> tw x) (* 2.0 (-> *phys-t1x* scl))) (-> *phys-t2x* scl)))
                              (set! (-> acc y) (+ (- (-> tw y) (* 2.0 (-> *phys-t1y* scl))) (-> *phys-t2y* scl)))
                              (set! (-> acc z) (+ (- (-> tw z) (* 2.0 (-> *phys-t1z* scl))) (-> *phys-t2z* scl))))
                            (set! (-> *phys-t2x* scl) (-> *phys-t1x* scl))
                            (set! (-> *phys-t2y* scl) (-> *phys-t1y* scl))
                            (set! (-> *phys-t2z* scl) (-> *phys-t1z* scl))
                            ;; LE STIMULUS REELLEMENT RECU PAR LA POINTE, quelle qu'en soit la
                            ;; source (pilotage de la salle, rotation du porteur, animation).
                            (when (and (> warm 1) (= l (- n 1)))
                              (let ((aa (sqrtf (+ (* (-> acc x) (-> acc x))
                                                  (+ (* (-> acc y) (-> acc y))
                                                     (* (-> acc z) (-> acc z))))))
                                    (stb (* sc PHYS-ST)))
                                (when (> aa (-> *phys-st* (+ stb 16)))
                                  (set! (-> *phys-st* (+ stb 16)) aa))))
                            (when (and (> warm 0) (= l (- n 1)))
                              ;; deplacement monde de la pose d'auteur de la POINTE, cumule
                              (let ((mx (- (-> tw x) (-> *phys-t1x* scl)))
                                    (my (- (-> tw y) (-> *phys-t1y* scl)))
                                    (mz (- (-> tw z) (-> *phys-t1z* scl))))
                                (set! (-> *phys-tmov* sc)
                                      (+ (-> *phys-tmov* sc)
                                         (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz))))))))
                            (set! (-> *phys-t1x* scl) (-> tw x))
                            (set! (-> *phys-t1y* scl) (-> tw y))
                            (set! (-> *phys-t1z* scl) (-> tw z))
                            (cond
                              ((or (< warm 1) (< l rlk))
                               ;; L'ANCRE — LE SEUL POINT PAR LEQUEL L'ANIMATION ENTRE. Maillon
                               ;; `rootlock` (SPEC 2 : la racine suit rigidement l'os porteur), ou
                               ;; premiere frame : la pose d'auteur EST la position, sans etat.
                               (set! (-> *phys-px* scl) (-> tw x))
                               (set! (-> *phys-py* scl) (-> tw y))
                               (set! (-> *phys-pz* scl) (-> tw z))
                               (set! (-> *phys-qx* scl) (-> tw x))
                               (set! (-> *phys-qy* scl) (-> tw y))
                               (set! (-> *phys-qz* scl) (-> tw z))
                               (set! (-> *phys-ox* scl) 0.0)
                               (set! (-> *phys-oy* scl) 0.0)
                               (set! (-> *phys-oz* scl) 0.0))
                              (else
                               ;; ET LA PART DE CETTE GRAVITE QUE LA GEOMETRIE AUTORISE. La
                               ;; contrainte de longueur n'admet qu'une ROTATION autour de
                               ;; l'attache : la composante de la gravite dirigee dans l'axe de l'os
                               ;; ne peut produire aucun deplacement. Une chaine dont la gravite est
                               ;; presque radiale ne s'affaissera JAMAIS, quel que soit le reglage —
                               ;; c'est une propriete du rig, pas un bug, et sans ce nombre publie
                               ;; les deux sont indiscernables. (Instrument inchange : il se lit sur
                               ;; `gl`, le meme vecteur qu'avant.)
                               (when (= l (- n 1))
                                 (let* ((stb (* sc PHYS-ST))
                                        (kpg (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
                                   (when (and (>= kpg 0) (< (+ kpg 1) nbone))
                                     (let* ((qx (- (-> tw x) (-> skel bones (+ kpg 1) transform vector 3 x)))
                                            (qy (- (-> tw y) (-> skel bones (+ kpg 1) transform vector 3 y)))
                                            (qz (- (-> tw z) (-> skel bones (+ kpg 1) transform vector 3 z)))
                                            (ql (sqrtf (+ (* qx qx) (+ (* qy qy) (* qz qz)))))
                                            (gn (vector-length gl)))
                                       (when (and (> ql 0.01) (> gn 0.0001))
                                         (set-vector! sv qx qy qz 0.0)
                                         (vector-rotate*! sv sv w2l)
                                         (let* ((sl (vector-length sv))
                                                (cs (if (> sl 0.0001)
                                                      (/ (+ (* (-> sv x) (-> gl x))
                                                            (+ (* (-> sv y) (-> gl y))
                                                               (* (-> sv z) (-> gl z))))
                                                         (* sl gn))
                                                      0.0))
                                                (tf (sqrtf (fmax 0.0 (- 1.0 (* cs cs))))))
                                           (when (> tf (-> *phys-st* (+ stb 19)))
                                             (set! (-> *phys-st* (+ stb 19)) tf))))))))
                               ;; L'ATTACHE : le maillon precedent DEJA SIMULE, ou l'ancre pour le
                               ;; premier maillon libre. C'est par elle, et par elle seule, que le
                               ;; mouvement du crane atteint la particule — par la contrainte, pas
                               ;; par un ressort.
                               (let* ((ax (if (> l 0) (-> *phys-px* (- scl 1)) (-> anc x)))
                                      (ay (if (> l 0) (-> *phys-py* (- scl 1)) (-> anc y)))
                                      (az (if (> l 0) (-> *phys-pz* (- scl 1)) (-> anc z)))
                                      (bl (-> *phys-blen* scl))
                                      ;; SPEC 6 — LE METRE DES BORNES DE SPEC 22, ET CE N'EST PAS
                                      ;; `bl` : `bl` est l'OS (la contrainte de longueur porte bien
                                      ;; sur lui), `b0e` est la CHAIR. Voir PHYS-P-B0.
                                      (b0e (if (> (-> *phys-b0* sc) 0.0) (-> *phys-b0* sc) bl))
                                      ;; [NOTE-74] SPEC 24 CONTRE SPEC 31 : LE GRADIENT NE VIT PLUS DANS LA FREQUENCE. -> jak-hd-physics-NOTES.md
                                      (k2l k2)
                                      ;; LA CIBLE du ressort de materiau, pas sa force : elle ne
                                      ;; depend pas de `p`, donc elle se calcule UNE FOIS PAR FRAME
                                      ;; pendant que la force, elle, se recalcule a chaque SOUS-PAS.
                                      ;; C'est exactement la separation que SPEC 37 impose.
                                      (tgx 0.0)
                                      (tgy 0.0)
                                      (tgz 0.0)
                                      (hasf 0))
                                 ;; ---- LA CHAIR : direction de repos du MATERIAU, relevee UNE fois
                                 ;; ---- et constante ensuite. Elle ne suit pas l'animation.
                                 (when (and (nonzero? ela) (zero? (-> *phys-ucap* scl))
                                            (> bl 0.01) (> k2 0.000001))
                                   (set-vector! sv (- (-> tw x) ax) (- (-> tw y) ay) (- (-> tw z) az) 0.0)
                                   (vector-rotate*! sv sv w2l)
                                   ;; [NOTE-39] LA PRE-COMPENSATION A ETE RETIREE ICI, ET C'EST LA MEME PIECE -> jak-hd-physics-NOTES.md
                                   (let ((sl (vector-length sv)))
                                     (when (> sl 0.0001)
                                       (set! (-> *phys-ux* scl) (/ (-> sv x) sl))
                                       (set! (-> *phys-uy* scl) (/ (-> sv y) sl))
                                       (set! (-> *phys-uz* scl) (/ (-> sv z) sl))
                                       (set! (-> *phys-ucap* scl) 1))))
                                 ;; ---- LA CIBLE DE LA FORCE ELASTIQUE DU MATERIAU. Elle est portee
                                 ;; ---- rigidement par l'ancre ; elle ne connait pas l'animation du
                                 ;; ---- maillon, donc elle ne peut pas la « suivre ».
                                 (when (and (nonzero? ela) (nonzero? (-> *phys-ucap* scl)) (> bl 0.01))
                                   (set-vector! uv (-> *phys-ux* scl) (-> *phys-uy* scl) (-> *phys-uz* scl) 0.0)
                                   (vector-rotate*! uv uv am)
                                   (let ((ul (vector-length uv)))
                                     (when (> ul 0.0001)
                                       (vector-float*! uv uv (/ bl ul))
                                       (set! tgx (+ ax (-> uv x)))
                                       (set! tgy (+ ay (-> uv y)))
                                       (set! tgz (+ az (-> uv z)))
                                       (set! hasf 1))))
                                 ;; [NOTE-73] SPEC 9 — LA CIBLE DE REPOS DU RESSORT EST-ELLE LA POSE D'AUTEUR ? -> jak-hd-physics-NOTES.md
                                 ;; [NOTE-99] NATURE deux longueurs / B0, maximum et somme sur la fenetre. -> jak-hd-physics-NOTES.md
                                 (when (and (nonzero? hasf) (> warm 1) (= l rlk))
                                   (let* ((dgb (* sc PHYS-DG))
                                          (rgx (- tgx (-> tw x)))
                                          (rgy (- tgy (-> tw y)))
                                          (rgz (- tgz (-> tw z)))
                                          (rg  (/ (sqrtf (+ (* rgx rgx) (+ (* rgy rgy) (* rgz rgz))))
                                                  (fmax 1.0 b0e)))
                                          (pex (- (-> *phys-px* scl) tgx))
                                          (pey (- (-> *phys-py* scl) tgy))
                                          (pez (- (-> *phys-pz* scl) tgz))
                                          (pe  (/ (sqrtf (+ (* pex pex) (+ (* pey pey) (* pez pez))))
                                                  (fmax 1.0 b0e))))
                                     (when (> rg (-> *phys-dg* (+ dgb 24)))
                                       (set! (-> *phys-dg* (+ dgb 24)) rg))
                                     (when (> pe (-> *phys-dg* (+ dgb 26)))
                                       (set! (-> *phys-dg* (+ dgb 26)) pe))
                                     ;; 28 = la SOMME de `perr`. Le maximum seul ne separe pas « un
                                     ;; seul instant » de « toutes les frames », et c'est
                                     ;; exactement la question : un champ de contact permanent
                                     ;; deplace la particule a CHAQUE frame, un saut de fenetre une
                                     ;; seule fois. `28/27` rend la moyenne.
                                     (set! (-> *phys-dg* (+ dgb 28))
                                           (+ pe (-> *phys-dg* (+ dgb 28))))
                                     (set! (-> *phys-dg* (+ dgb 25))
                                           (+ rg (-> *phys-dg* (+ dgb 25))))
                                     (set! (-> *phys-dg* (+ dgb 27))
                                           (+ 1.0 (-> *phys-dg* (+ dgb 27))))))
                                 ;; SPEC 23 — AMORCAGE DU POINT LIBRE, une seule fois par MAILLON.
                                 ;; Il part exactement de l'etat de l'apex : meme position, meme
                                 ;; vitesse verlet. Donc a la premiere frame l'elongation radiale
                                 ;; qu'il produit vaut ZERO, et §9 (« retour EXACT a la pose
                                 ;; d'auteur ») est preservee par construction et non par reglage.
                                 (when (and (nonzero? (-> *phys-axan* sc)) (>= l rlk)
                                            (zero? (-> *phys-rok* scl)))
                                   (set! (-> *phys-cpx* scl) (-> *phys-px* scl))
                                   (set! (-> *phys-cpy* scl) (-> *phys-py* scl))
                                   (set! (-> *phys-cpz* scl) (-> *phys-pz* scl))
                                   (set! (-> *phys-cqx* scl) (-> *phys-qx* scl))
                                   (set! (-> *phys-cqy* scl) (-> *phys-qy* scl))
                                   (set! (-> *phys-cqz* scl) (-> *phys-qz* scl))
                                   (set! (-> *phys-rok* scl) 1))
                                 ;; [NOTE-40] ---- INTEGRATION EN POSITION MONDE. Trois termes, et c'est TOUT : -> jak-hd-physics-NOTES.md
                                 ;; `rate` = le TAUX (2 zeta omega dt), `kd` la RETENTION qu'il
                                 ;; produit sur une frame. Voir NOTE-50 : c'est `e^-rate`, pas
                                 ;; `1 - rate`, et l'ecart valait +8.3 % sur le zeta de SPEC 25.
                                 (let* ((rate (if (and (nonzero? ela) (> k2 0.000001))
                                                (* dmp (sqrtf (/ k2l k2)))
                                                dmp))
                                        (kd  (phys-decay rate))
                                        (kn  (* 0.42 b0e))
                                        (cpp (* 0.08 b0e))
                                        (ex0 (- tgx (-> *phys-px* scl)))
                                        (ey0 (- tgy (-> *phys-py* scl)))
                                        (ez0 (- tgz (-> *phys-pz* scl)))
                                        ;; L'ARMEMENT, pas la classification : une chaine classee
                                        ;; mais non armee (1 seule articulation) doit integrer
                                        ;; EXACTEMENT ce qu'elle integrait avant ce bloc, sans
                                        ;; meme passer par l'aller-retour de projection — dont
                                        ;; l'erreur d'arrondi suffirait a bouger un dernier chiffre
                                        ;; et a rendre la non-regression indemontrable.
                                        (axo (-> *phys-axan* sc))
                                        ;; [NOTE-41] SPEC 37 — LE PAS DE TEMPS SUIT LE MODE LE PLUS RAPIDE, -> jak-hd-physics-NOTES.md
                                        (ns  (if (or (nonzero? axo)
                                                     (and (nonzero? sat) (nonzero? hasf)
                                                          (> (+ (* ex0 ex0) (+ (* ey0 ey0) (* ez0 ez0)))
                                                             (* kn kn))))
                                               4 2))
                                        (fns (the float ns))
                                        (k2s (/ k2l (* fns fns)))
                                        (ggx (/ (* gsc (-> gdw x)) (* fns fns)))
                                        (ggy (/ (* gsc (-> gdw y)) (* fns fns)))
                                        (ggz (/ (* gsc (-> gdw z)) (* fns fns)))
                                        (kds (if (= ns 2) (sqrtf kd) (sqrtf (sqrtf kd))))
                                        ;; ---- SPEC 24 / SPEC 29 : LE TRIEDRE DE L'ANCRE ---------
                                        ;; Les trois lignes de `am`, RENORMALISEES — la matrice d'un
                                        ;; os retargete n'est pas garantie orthonormale, et une base
                                        ;; non unitaire ferait entrer l'echelle de l'os dans la
                                        ;; raideur (exactement le piege deja paye sur `gl`).
                                        ;; Elles sont relues sur la matrice COURANTE a chaque frame :
                                        ;; le triedre tourne donc avec le torse sans etre reclasse,
                                        ;; ce que SPEC 7 impose (« relative to the torso/root
                                        ;; transform rather than directly in world space »).
                                        (l0  (sqrtf (+ (* (-> am vector 0 x) (-> am vector 0 x))
                                                       (+ (* (-> am vector 0 y) (-> am vector 0 y))
                                                          (* (-> am vector 0 z) (-> am vector 0 z))))))
                                        (l1  (sqrtf (+ (* (-> am vector 1 x) (-> am vector 1 x))
                                                       (+ (* (-> am vector 1 y) (-> am vector 1 y))
                                                          (* (-> am vector 1 z) (-> am vector 1 z))))))
                                        (l2  (sqrtf (+ (* (-> am vector 2 x) (-> am vector 2 x))
                                                       (+ (* (-> am vector 2 y) (-> am vector 2 y))
                                                          (* (-> am vector 2 z) (-> am vector 2 z))))))
                                        (i0  (if (> l0 0.0001) (/ 1.0 l0) 0.0))
                                        (i1  (if (> l1 0.0001) (/ 1.0 l1) 0.0))
                                        (i2  (if (> l2 0.0001) (/ 1.0 l2) 0.0))
                                        (n0x (* (-> am vector 0 x) i0))
                                        (n0y (* (-> am vector 0 y) i0))
                                        (n0z (* (-> am vector 0 z) i0))
                                        (n1x (* (-> am vector 1 x) i1))
                                        (n1y (* (-> am vector 1 y) i1))
                                        (n1z (* (-> am vector 1 z) i1))
                                        (n2x (* (-> am vector 2 x) i2))
                                        (n2y (* (-> am vector 2 y) i2))
                                        (n2z (* (-> am vector 2 z) i2))
                                        ;; le facteur de raideur de chaque LIGNE (1.0 partout tant
                                        ;; que la chaine n'est pas classee : isotropie stricte)
                                        (s0  (-> *phys-axs* (+ (* sc 3) 0)))
                                        (s1  (-> *phys-axs* (+ (* sc 3) 1)))
                                        (s2  (-> *phys-axs* (+ (* sc 3) 2)))
                                        ;; ET LA TRAINEE SUIT LA RAIDEUR, AXE PAR AXE : sur un axe
                                        ;; le TAUX doit aller comme `sqrt(k)` pour que
                                        ;; `zeta = taux/(2 sqrt(k))` reste la constante de MATERIAU
                                        ;; que SPEC 25 fixe a 0.35. Sans ca, l'anisotropie de
                                        ;; raideur ferait deriver `zeta` a 0.332 (AP) et 0.317
                                        ;; (lateral) — ce dernier SOUS le plancher 0.32 de sa plage.
                                        ;; La mise a l'echelle porte sur le TAUX, pas sur `1 - kd` :
                                        ;; c'est le taux qui est proportionnel a `sqrt(k)`, et la
                                        ;; retention en est l'exponentielle (NOTE-50).
                                        (kd0 (phys-decay (* rate (sqrtf s0))))
                                        (kd1 (phys-decay (* rate (sqrtf s1))))
                                        (kd2 (phys-decay (* rate (sqrtf s2))))
                                        (kds0 (if (= ns 2) (sqrtf kd0) (sqrtf (sqrtf kd0))))
                                        (kds1 (if (= ns 2) (sqrtf kd1) (sqrtf (sqrtf kd1))))
                                        (kds2 (if (= ns 2) (sqrtf kd2) (sqrtf (sqrtf kd2))))
                                        (vx  (/ (- (-> *phys-px* scl) (-> *phys-qx* scl)) fns))
                                        (vy  (/ (- (-> *phys-py* scl) (-> *phys-qy* scl)) fns))
                                        (vz  (/ (- (-> *phys-pz* scl) (-> *phys-qz* scl)) fns))
                                        ;; [NOTE-59] ---- SPEC 23 : LE TROISIEME DEGRE DE LIBERTE ---------- -> jak-hd-physics-NOTES.md
                                        ;; `(>= l rlk)` DEPUIS LE CYCLE 32, et c'etait `(= l rlk)` :
                                        ;; sa §23 donne un troisieme degre de liberte au TISSU, pas
                                        ;; au premier maillon. Le distal en etait prive, et sa serie
                                        ;; radiale etait identiquement nulle (0 sur 150, 6 canaux).
                                        (rlo (if (and (nonzero? axo) (>= l rlk) (nonzero? hasf)) 1 0))
                                        ;; §22 SUR LE COM, ET C'EST UNE AUTRE BANDE QUE CELLE DE
                                        ;; L'APEX : « Breast COM: normal <= 35 % B0, hard transient
                                        ;; <= 40 % B0 » contre « distal/apex: 42 % / 50 % ». Meme
                                        ;; construction que `kn`/`cpp`, deux bandes parce que sa
                                        ;; spec en donne deux.
                                        (ckn (* 0.35 b0e))
                                        (ccp (* 0.05 b0e))
                                        (cpx (-> *phys-cpx* scl))
                                        (cpy (-> *phys-cpy* scl))
                                        (cpz (-> *phys-cpz* scl))
                                        (cvx (/ (- cpx (-> *phys-cqx* scl)) fns))
                                        (cvy (/ (- cpy (-> *phys-cqy* scl)) fns))
                                        (cvz (/ (- cpz (-> *phys-cqz* scl)) fns)))
                                   (dotimes (ss ns)
                                     (let ((fx 0.0) (fy 0.0) (fz 0.0))
                                       (when (nonzero? hasf)
                                         (let* ((ex (- tgx (-> *phys-px* scl)))
                                                (ey (- tgy (-> *phys-py* scl)))
                                                (ez (- tgz (-> *phys-pz* scl)))
                                                (dd (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez)))))
                                                ;; [NOTE-42] SPEC 21 SOUS LA SEULE FORME QUI NE RETIRE RIEN : -> jak-hd-physics-NOTES.md
                                                (mu (if (and (nonzero? sat) (> dd kn)
                                                             (> cpp 0.0001) (> dd 0.0001))
                                                      (let ((xr (fmin 0.99 (/ (- dd kn) cpp))))
                                                        (fmin (/ (+ kn (* cpp (/ xr (- 1.0 xr)))) dd)
                                                              (/ 1.0 (fmax 0.000001 k2s))))
                                                      1.0)))
                                           (when (> mu 1.000001)
                                             (set! *phys-stif-n* (+ *phys-stif-n* 1)))
                                           ;; [NOTE-86] SPEC 24/29 — LA FORCE EST PROJETEE SUR LE TRIEDRE, UNE RAIDEUR PAR AXE. -> jak-hd-physics-NOTES.md
                                           (if (nonzero? axo)
                                             (let* ((p0 (+ (* ex n0x) (+ (* ey n0y) (* ez n0z))))
                                                    (p1 (+ (* ex n1x) (+ (* ey n1y) (* ez n1z))))
                                                    (p2 (+ (* ex n2x) (+ (* ey n2y) (* ez n2z))))
                                                    (c0 (* s0 p0))
                                                    (c1 (* s1 p1))
                                                    (c2 (* s2 p2)))
                                               (set! fx (* k2s (* mu (+ (* c0 n0x) (+ (* c1 n1x) (* c2 n2x))))))
                                               (set! fy (* k2s (* mu (+ (* c0 n0y) (+ (* c1 n1y) (* c2 n2y))))))
                                               (set! fz (* k2s (* mu (+ (* c0 n0z) (+ (* c1 n1z) (* c2 n2z)))))))
                                             (begin
                                               (set! fx (* k2s (* mu ex)))
                                               (set! fy (* k2s (* mu ey)))
                                               (set! fz (* k2s (* mu ez)))))))
                                       ;; LA MEME PROJECTION POUR LA TRAINEE (SPEC 25) : `zeta` est
                                       ;; une constante du materiau, donc l'amortissement doit
                                       ;; suivre la raideur AXE PAR AXE, pas rester scalaire.
                                       (if (nonzero? axo)
                                         (let* ((wa (* (+ (* vx n0x) (+ (* vy n0y) (* vz n0z))) kds0))
                                                (wb (* (+ (* vx n1x) (+ (* vy n1y) (* vz n1z))) kds1))
                                                (wc (* (+ (* vx n2x) (+ (* vy n2y) (* vz n2z))) kds2))
                                                (zx (+ (* wa n0x) (+ (* wb n1x) (* wc n2x))))
                                                (zy (+ (* wa n0y) (+ (* wb n1y) (* wc n2y))))
                                                (zz (+ (* wa n0z) (+ (* wb n1z) (* wc n2z)))))
                                           (set! vx (+ zx (+ fx ggx)))
                                           (set! vy (+ zy (+ fy ggy)))
                                           (set! vz (+ zz (+ fz ggz))))
                                         (begin
                                           (set! vx (+ (* vx kds) (+ fx ggx)))
                                           (set! vy (+ (* vy kds) (+ fy ggy)))
                                           (set! vz (+ (* vz kds) (+ fz ggz)))))
                                       (set! (-> *phys-px* scl) (+ (-> *phys-px* scl) vx))
                                       (set! (-> *phys-py* scl) (+ (-> *phys-py* scl) vy))
                                       (set! (-> *phys-pz* scl) (+ (-> *phys-pz* scl) vz))
                                       ;; ---- SPEC 23, LE MEME SOUS-PAS, LE POINT LIBRE -----------
                                       ;; Il s'integre DANS la boucle de sous-pas, donc a la meme
                                       ;; frequence effective que l'apex (§37 : `ns` = 4 sur cette
                                       ;; chaine, soit 240 Hz). L'integrer dehors lui donnerait
                                       ;; 60 Hz et sa §37 serait fausse pour lui seul.
                                       ;; MEME CIBLE, MEME RAIDEUR ANISOTROPE, MEME TRAINEE, MEME
                                       ;; PILOTAGE que l'apex : le seul terme qui differe est la
                                       ;; bande de saturation (§22 donne 0.35/0.40 B0 au COM et
                                       ;; 0.42/0.50 B0 a l'apex), et l'absence de projection.
                                       (when (nonzero? rlo)
                                         (let* ((cex (- tgx cpx))
                                                (cey (- tgy cpy))
                                                (cez (- tgz cpz))
                                                (cdd (sqrtf (+ (* cex cex) (+ (* cey cey) (* cez cez)))))
                                                (cmu (if (and (nonzero? sat) (> cdd ckn)
                                                              (> ccp 0.0001) (> cdd 0.0001))
                                                       (let ((xr (fmin 0.99 (/ (- cdd ckn) ccp))))
                                                         (fmin (/ (+ ckn (* ccp (/ xr (- 1.0 xr)))) cdd)
                                                               (/ 1.0 (fmax 0.000001 k2s))))
                                                       1.0))
                                                (q0 (+ (* cex n0x) (+ (* cey n0y) (* cez n0z))))
                                                (q1 (+ (* cex n1x) (+ (* cey n1y) (* cez n1z))))
                                                (q2 (+ (* cex n2x) (+ (* cey n2y) (* cez n2z))))
                                                (d0 (* s0 q0))
                                                (d1 (* s1 q1))
                                                (d2 (* s2 q2))
                                                (cfx (* k2s (* cmu (+ (* d0 n0x) (+ (* d1 n1x) (* d2 n2x))))))
                                                (cfy (* k2s (* cmu (+ (* d0 n0y) (+ (* d1 n1y) (* d2 n2y))))))
                                                (cfz (* k2s (* cmu (+ (* d0 n0z) (+ (* d1 n1z) (* d2 n2z))))))
                                                (ea (* (+ (* cvx n0x) (+ (* cvy n0y) (* cvz n0z))) kds0))
                                                (eb (* (+ (* cvx n1x) (+ (* cvy n1y) (* cvz n1z))) kds1))
                                                (ec (* (+ (* cvx n2x) (+ (* cvy n2y) (* cvz n2z))) kds2)))
                                           (set! cvx (+ (+ (* ea n0x) (+ (* eb n1x) (* ec n2x)))
                                                        (+ cfx ggx)))
                                           (set! cvy (+ (+ (* ea n0y) (+ (* eb n1y) (* ec n2y)))
                                                        (+ cfy ggy)))
                                           (set! cvz (+ (+ (* ea n0z) (+ (* eb n1z) (* ec n2z)))
                                                        (+ cfz ggz)))
                                           (set! cpx (+ cpx cvx))
                                           (set! cpy (+ cpy cvy))
                                           (set! cpz (+ cpz cvz))))))
                                   ;; [NOTE-62] L'ELONGATION RADIALE : LA COMPOSANTE DU POINT LIBRE LE LONG DE -> jak-hd-physics-NOTES.md
                                   (when (nonzero? rlo)
                                     ;; [NOTE-87] SPEC 21 BORNE LE DEPLACEMENT, PAS LA FORCE. -> jak-hd-physics-NOTES.md
                                     ;; IDENTITE STRICTE sous 0.84*(ckn+ccp) = 0.336 B0 : rien n'est
                                     ;; retire au mouvement subtil. `cq` etant ecrit `cp - fns*cv`
                                     ;; APRES, `cp - cq` est inchange -> AUCUNE vitesse creee.
                                     (let* ((wex (- cpx tgx))
                                            (wey (- cpy tgy))
                                            (wez (- cpz tgz))
                                            (wed (sqrtf (+ (* wex wex) (+ (* wey wey) (* wez wez)))))
                                            (wsm (if (zero? *phys-rr-off*)
                                                   (phys-softmin wed (+ ckn ccp))
                                                   wed)))
                                       (when (and (> wed 0.0001) (< wsm (- wed 0.000001)))
                                         (let ((ws (/ wsm wed)))
                                           (set! cpx (+ tgx (* wex ws)))
                                           (set! cpy (+ tgy (* wey ws)))
                                           (set! cpz (+ tgz (* wez ws))))
                                         (set! *phys-cwn* (+ *phys-cwn* 1))
                                         (set! *phys-cwsum* (+ *phys-cwsum* (- wed wsm)))))
                                     (set! (-> *phys-cpx* scl) cpx)
                                     (set! (-> *phys-cpy* scl) cpy)
                                     (set! (-> *phys-cpz* scl) cpz)
                                     (set! (-> *phys-cqx* scl) (- cpx (* fns cvx)))
                                     (set! (-> *phys-cqy* scl) (- cpy (* fns cvy)))
                                     (set! (-> *phys-cqz* scl) (- cpz (* fns cvz)))
                                     (let* ((mx  (- (-> *phys-px* scl) ax))
                                            (my  (- (-> *phys-py* scl) ay))
                                            (mz  (- (-> *phys-pz* scl) az))
                                            (ml  (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz)))))
                                            (dr0 (if (and (> bl 0.01) (> ml 0.01))
                                                   (- (/ (+ (* (- cpx ax) mx)
                                                            (+ (* (- cpy ay) my)
                                                               (* (- cpz az) mz)))
                                                         ml)
                                                      bl)
                                                   0.0))
                                            ;; [NOTE-81] LA BORNE DE §22 SUR LE CANAL RADIAL. -> jak-hd-physics-NOTES.md
                                            (rcap (if (zero? *phys-rr-off*) (* 0.40 b0e) (* 1000000.0 b0e)))
                                            ;; [NOTE-84] LA BORNE EST APPELEE SUR LA VALEUR LIVREE, JAMAIS SUR L'ETAT. -> jak-hd-physics-NOTES.md
                                            (drr (if (>= dr0 0.0)
                                                   (phys-softmin dr0 rcap)
                                                   (- 0.0 (phys-softmin (- 0.0 dr0) rcap)))))
                                       ;; [NOTE-84] `*phys-rr*` GARDE LA RACINE ; LES AGREGATS PORTENT TOUTE LA CHAINE. -> jak-hd-physics-NOTES.md
                                       (when (= l rlk)
                                         (set! (-> *phys-rr* sc) drr))
                                       (set! (-> *phys-rrl* scl) drr)
                                       (when (> (fabs (- dr0 drr)) 0.000001)
                                         (set! *phys-rrsat* (+ *phys-rrsat* 1))
                                         (set! (-> *phys-rrsl* scl) (+ 1.0 (-> *phys-rrsl* scl))))
                                       (let ((a0 (/ (fabs dr0) (fmax 1.0 b0e))))
                                         (when (> a0 (-> *phys-rrr* sc))
                                           (set! (-> *phys-rrr* sc) a0))
                                         (when (> a0 (-> *phys-rrrl* scl))
                                           (set! (-> *phys-rrrl* scl) a0)
                                           (set! (-> *phys-rrol* scl) (/ (- ml bl) (fmax 1.0 b0e)))
                                           (set! (-> *phys-rrcl* scl)
                                                 (/ (/ (+ (* (- cpx (-> *phys-px* scl)) mx)
                                                          (+ (* (- cpy (-> *phys-py* scl)) my)
                                                             (* (- cpz (-> *phys-pz* scl)) mz)))
                                                       ml)
                                                    (fmax 1.0 b0e)))
                                           (let* ((ftx (- cpx tgx)) (fty (- cpy tgy)) (ftz (- cpz tgz))
                                                  (fb  (fmax 1.0 b0e)))
                                             (set! (-> *phys-rrtl* scl)
                                                   (/ (/ (+ (* ftx mx) (+ (* fty my) (* ftz mz))) ml) fb))
                                             (set! (-> *phys-cddl* scl)
                                                   (/ (sqrtf (+ (* ftx ftx) (+ (* fty fty) (* ftz ftz)))) fb)))))
                                       (let ((ar (/ (fabs drr) (fmax 1.0 b0e))))
                                         (when (> ar (-> *phys-rrm* sc))
                                           (set! (-> *phys-rrm* sc) ar))
                                         (when (> ar (-> *phys-rrml* scl))
                                           (set! (-> *phys-rrml* scl) ar)))))
                                   (set! (-> *phys-qx* scl) (- (-> *phys-px* scl) (* fns vx)))
                                   (set! (-> *phys-qy* scl) (- (-> *phys-py* scl) (* fns vy)))
                                   (set! (-> *phys-qz* scl) (- (-> *phys-pz* scl) (* fns vz)))))))))))

                    ;; ---- 2. LES CONTRAINTES. Gauss-Seidel : longueur puis collision, puis des
                    ;; ---- balayages de collision seuls pour finir — la collision est la contrainte
                    ;; ---- dure de la SPEC 3, c'est donc elle qui doit etre exacte a la fin.
                    ;; ETAGE 0 du gradient : l'angle tel que L'INTEGRATION SEULE le produit, avant
                    ;; qu'aucune contrainte n'ait touche le maillon. Voir la note de `*phys-la0*`.
                    (phys-cap-ang! skel sc n rlk an nbone 0)
                    ;; [NOTE-43] ------------------------------------------------------------------------ -> jak-hd-physics-NOTES.md
                    ;; `(= n 1)` RETIRE le 2026-08-17 — meme raison qu'a `sat` : cette garde aurait
                    ;; fait disparaitre le mur d'apex de SPEC 22 des l'injection du second os, et
                    ;; `*phys-sat-n*` aurait publie 0 parce que le bloc ne tourne plus. La borne
                    ;; porte sur l'ecart de CHAQUE maillon a SA propre pose d'auteur, donc elle
                    ;; s'applique telle quelle a l'apex quand il y en a deux.
                    (when (= (-> *phys-fam* sc) 1)
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (k   (-> *phys-joint* scl)))
                            (when (and (>= k 0) (< (+ k 1) nbone))
                              (let* ((tx (-> skel bones (+ k 1) transform vector 3 x))
                                     (ty (-> skel bones (+ k 1) transform vector 3 y))
                                     (tz (-> skel bones (+ k 1) transform vector 3 z))
                                     (dx (- (-> *phys-px* scl) tx))
                                     (dy (- (-> *phys-py* scl) ty))
                                     (dz (- (-> *phys-pz* scl) tz))
                                     (dd (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz)))))
                                     ;; SPEC 22 : plafond NORMAL (genou) et marge jusqu'au plafond
                                     ;; DUR, en unites de `B0` — la CHAIR (SPEC 6), pas l'os.
                                     (b0f (if (> (-> *phys-b0* sc) 0.0) (-> *phys-b0* sc)
                                            (-> *phys-blen* scl)))
                                     ;; [NOTE-66] [NOTE-C28] CE `b0f` N'EST PAS LE RAYON DU MAILLON, ET C'EST -> jak-hd-physics-NOTES.md
                                     (kn (* 0.42 b0f))
                                     (cp (* 0.08 b0f)))
                                (when (and (> dd kn) (> cp 0.0001))
                                  (let* ((xr (/ (- dd kn) cp))
                                         (th (if (>= xr 3.0)
                                               1.0
                                               (/ (* xr (+ 27.0 (* xr xr)))
                                                  (+ 27.0 (* 9.0 (* xr xr))))))
                                         (ds (+ kn (* cp th)))
                                         (sf (/ ds dd)))
                                    (when (< sf 0.999999)
                                      (set! *phys-sat-n* (+ *phys-sat-n* 1))
                                      (set! *phys-sat-sum* (+ *phys-sat-sum* (- dd ds)))
                                      (set! (-> *phys-px* scl) (+ tx (* dx sf)))
                                      (set! (-> *phys-py* scl) (+ ty (* dy sf)))
                                      (set! (-> *phys-pz* scl) (+ tz (* dz sf))))))))))))
                    ;; SPEC 33/34 — la poussee de contact de CETTE frame, remise a zero avant les
                    ;; balayages : elle n'est pas un etat, elle est l'integrale d'une frame.
                    (dotimes (l n)
                      (let ((scl (+ (* sc PHYS-LINKS) l)))
                        (set-vector! (-> *phys-cpu* scl) 0.0 0.0 0.0 0.0)
                        (set! (-> *phys-cpe* scl) 0.0)
                        ;; [NOTE-97] les quatre grandeurs de l'instrument vivent EXACTEMENT le meme
                        ;; cycle de vie que `*phys-cpu*` : une frame, pas un etat.
                        (dotimes (k 7) (set! (-> *phys-cpa* (+ (* 7 scl) k)) 0.0))))
                    (set! *phys-swc* 0)
                    (dotimes (it 8)
                      (phys-length-chain skel sc n rlk an nbone)
                      (phys-collide-chain skel sc n rlk nbone nco PHYS-COL-MARGIN 3))
                    ;; [NOTE-44] L'ATTENUATION D'ANGLE DES CHEVEUX, UNE SEULE FOIS. Elle reste : c'est le -> jak-hd-physics-NOTES.md
                    (phys-bend-chain skel sc n rlk an nbone)
                    ;; ETAGE 1 : apres la boucle de contraintes ET l'attenuation d'angle, avant la
                    ;; finition. L'ecart entre l'etage 0 et celui-ci est ce que longueur, collision
                    ;; et attenuation retirent.
                    (phys-cap-ang! skel sc n rlk an nbone 1)
                    ;; [NOTE-93] PIERRE TOMBALE — `phys-retreat-chain`, A NE PAS REMETTRE. -> jak-hd-physics-NOTES.md
                    (dotimes (it 3)
                      (phys-length-chain skel sc n rlk an nbone)
                      (phys-collide-chain skel sc n rlk nbone nco PHYS-COL-MARGIN 3))
                    ;; [NOTE-45] ------------------------------------------------------------------------ -> jak-hd-physics-NOTES.md
                    (dotimes (it 4)
                      (phys-collide-chain skel sc n rlk nbone nco PHYS-COL-MARGIN 3))
                    ;; [NOTE-63] SPEC 33/34 — LA RESTITUTION, UNE FOIS PAR FRAME, SUR LA VITESSE SEULE. -> jak-hd-physics-NOTES.md
                    (when (zero? *phys-rst-off*)
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (dx (-> *phys-cpu* scl x))
                                 (dy (-> *phys-cpu* scl y))
                                 (dz (-> *phys-cpu* scl z))
                                 (dl (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))
                            (when (> dl 0.0001)
                              (let* ((nx (/ dx dl))
                                     (ny (/ dy dl))
                                     (nz (/ dz dl))
                                     (vx (- (- (-> *phys-px* scl) dx) (-> *phys-qx* scl)))
                                     (vy (- (- (-> *phys-py* scl) dy) (-> *phys-qy* scl)))
                                     (vz (- (- (-> *phys-pz* scl) dz) (-> *phys-qz* scl)))
                                     (vn (+ (* vx nx) (+ (* vy ny) (* vz nz))))
                                     (e  (* *phys-rst-k* (-> *phys-cpe* scl))))
                                (set! (-> *phys-qx* scl) (+ (-> *phys-qx* scl) dx))
                                (set! (-> *phys-qy* scl) (+ (-> *phys-qy* scl) dy))
                                (set! (-> *phys-qz* scl) (+ (-> *phys-qz* scl) dz))
                                (when (< vn 0.0)
                                  (let ((c (* (+ 1.0 e) vn)))
                                    (set! (-> *phys-qx* scl) (+ (-> *phys-qx* scl) (* c nx)))
                                    (set! (-> *phys-qy* scl) (+ (-> *phys-qy* scl) (* c ny)))
                                    (set! (-> *phys-qz* scl) (+ (-> *phys-qz* scl) (* c nz)))
                                    (set! *phys-rstn* (+ *phys-rstn* 1))
                                    (set! *phys-rstin* (+ *phys-rstin* (- vn)))
                                    (set! *phys-rstsum* (+ *phys-rstsum* e))
                                    ;; on ARME la mesure de sortie pour la frame suivante (0bis)
                                    (set-vector! (-> *phys-rstp* scl) nx ny nz 1.0)))))))))
                    ;; [NOTE-46] ------------------------------------------------------------------------ -> jak-hd-physics-NOTES.md
                    (phys-flip-count skel sc n rlk nbone nco)

                    ;; ---- 3bis. CONTROLE POSITIF DES INVERSIONS. Arme, chaque lien libre est
                    ;; ---- MIROITE a travers son attache : c'est exactement le defaut que l'owner a
                    ;; ---- vu deux fois. Le compteur d'inversions doit alors monter — la correction
                    ;; ---- s'applique a la frame suivante, quand la contrainte revoit le cote.
                    (when (nonzero? *phys-inv-inject*)
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let ((scl (+ (* sc PHYS-LINKS) l)))
                            (set! (-> *phys-px* scl) (- (* 2.0 (-> anc x)) (-> *phys-px* scl)))
                            (set! (-> *phys-py* scl) (- (* 2.0 (-> anc y)) (-> *phys-py* scl)))
                            (set! (-> *phys-pz* scl) (- (* 2.0 (-> anc z)) (-> *phys-pz* scl)))))))

                    ;; ---- 3. INJECTION DE DEFAUT (controle positif). Desarmee = 0.0. ----
                    (when (> *phys-inject* 0.01)
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (dx (- (-> anc x) (-> *phys-px* scl)))
                                 (dy (- (-> anc y) (-> *phys-py* scl)))
                                 (dz (- (-> anc z) (-> *phys-pz* scl)))
                                 (d  (sqrtf (+ (* dx dx) (* dy dy) (* dz dz)))))
                            (when (> d 0.01)
                              (let ((s (/ *phys-inject* d)))
                                (set! *phys-injn* (+ *phys-injn* 1))
                                (set! (-> *phys-px* scl) (+ (-> *phys-px* scl) (* dx s)))
                                (set! (-> *phys-py* scl) (+ (-> *phys-py* scl) (* dy s)))
                                (set! (-> *phys-pz* scl) (+ (-> *phys-pz* scl) (* dz s)))))))))

                    ;; ---- 4. LES CONTRAINTES ONT BOUGE LA POSITION : on remet cet effet dans
                    ;; ---- l'ecart, sinon la frame suivante repartirait d'un etat que rien ne
                    ;; ---- soutient (et la vitesse verlet perdrait la perte d'energie du choc).
                    (dotimes (l n)
                      (when (>= l rlk)
                        (let* ((scl (+ (* sc PHYS-LINKS) l))
                               (k   (-> *phys-joint* scl)))
                          (when (and (>= k 0) (< (+ k 1) nbone))
                            (set-vector! ov
                              (- (-> *phys-px* scl) (-> skel bones (+ k 1) transform vector 3 x))
                              (- (-> *phys-py* scl) (-> skel bones (+ k 1) transform vector 3 y))
                              (- (-> *phys-pz* scl) (-> skel bones (+ k 1) transform vector 3 z))
                              0.0)
                            (vector-rotate*! ov ov w2l)
                            (set! (-> *phys-ox* scl) (-> ov x))
                            (set! (-> *phys-oy* scl) (-> ov y))
                            (set! (-> *phys-oz* scl) (-> ov z))))))

                    ;; ---- 4bis. CONTROLE POSITIF DU CANAL D'AUTEUR. Arme, la position ecrite est
                    ;; ---- batie sur la pose d'auteur de la frame PRECEDENTE : l'animation est
                    ;; ---- retardee d'une frame, ce que la SPEC 5 interdit. Applique APRES le
                    ;; ---- report dans l'ecart, sinon l'ecart absorberait le defaut et le compteur
                    ;; ---- d'identite ne verrait rien — c'est le piege qui rendrait le controle
                    ;; ---- muet.
                    (when (nonzero? *phys-auth-lag*)
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (k   (-> *phys-joint* scl)))
                            (when (and (>= k 0) (< (+ k 1) nbone))
                              ;; t2 porte la pose d'auteur de la frame PRECEDENTE : le bloc
                              ;; d'integration vient d'y decaler l'ancienne valeur de t1.
                              (set! (-> *phys-px* scl)
                                    (+ (-> *phys-px* scl)
                                       (- (-> *phys-t2x* scl) (-> skel bones (+ k 1) transform vector 3 x))))
                              (set! (-> *phys-py* scl)
                                    (+ (-> *phys-py* scl)
                                       (- (-> *phys-t2y* scl) (-> skel bones (+ k 1) transform vector 3 y))))
                              (set! (-> *phys-pz* scl)
                                    (+ (-> *phys-pz* scl)
                                       (- (-> *phys-t2z* scl) (-> skel bones (+ k 1) transform vector 3 z)))))))))

                    ;; ------------------------------------------------------------------------
                    ;; 5. MESURE (SPEC 7). ELLE SE FAIT ICI, AVANT L'ECRITURE, et c'est structurel :
                    ;; une fois le squelette ecrit, `skel bones` porte la pose SIMULEE et la pose
                    ;; d'auteur a disparu. Ce qui est compare : *phys-p** = la pose COMMITEE (elle
                    ;; sera ecrite telle quelle au bloc suivant), `skel bones` = le RETARGET.
                    ;; ------------------------------------------------------------------------
                    (let ((stb (* sc PHYS-ST)))
                      ;; --- LE GRADIENT : la boite englobante de l'ecart POUR CHAQUE MAILLON.
                      ;; Un maillon rootlock a un ecart identiquement nul et mesure donc zero, ce
                      ;; qui est exactement ce que SPEC 2 demande de la racine.
                      (dotimes (l n)
                        (let* ((scl (+ (* sc PHYS-LINKS) l))
                               (lb  (* scl PHYS-LB))
                               (ox  (-> *phys-ox* scl))
                               (oy  (-> *phys-oy* scl))
                               (oz  (-> *phys-oz* scl)))
                          (when (< ox (-> *phys-lb* (+ lb 0))) (set! (-> *phys-lb* (+ lb 0)) ox))
                          (when (> ox (-> *phys-lb* (+ lb 1))) (set! (-> *phys-lb* (+ lb 1)) ox))
                          (when (< oy (-> *phys-lb* (+ lb 2))) (set! (-> *phys-lb* (+ lb 2)) oy))
                          (when (> oy (-> *phys-lb* (+ lb 3))) (set! (-> *phys-lb* (+ lb 3)) oy))
                          (when (< oz (-> *phys-lb* (+ lb 4))) (set! (-> *phys-lb* (+ lb 4)) oz))
                          (when (> oz (-> *phys-lb* (+ lb 5))) (set! (-> *phys-lb* (+ lb 5)) oz))))
                      ;; --- ecart a la pose du modele, par lien libre (SPEC 4, lu au repos) ---
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (k   (-> *phys-joint* scl)))
                            (when (and (>= k 0) (< (+ k 1) nbone))
                              (set! (-> pt x) (-> *phys-px* scl))
                              (set! (-> pt y) (-> *phys-py* scl))
                              (set! (-> pt z) (-> *phys-pz* scl))
                              (set! (-> pt w) 1.0)
                              (let ((dv (vector-vector-distance
                                          pt (the-as vector (-> skel bones (+ k 1) transform vector 3)))))
                                (when (> dv (-> *phys-st* (+ stb 5)))
                                  (set! (-> *phys-st* (+ stb 5)) dv)))))))
                      ;; --- residu SIGNE de penetration (SPEC 3). > 0 = ca traverse, <= 0 = la
                      ;; --- marge qui reste avant de traverser. Le maximum de la fenetre part donc
                      ;; --- de -1e9 (voir phys-stats-reset!) et non de zero : un maximum plafonne a
                      ;; --- zero aurait rendu la colonne constante et donc inverifiable.
                      (let ((pen (phys-pen-chain skel sc n rlk nbone nco)))
                        (when (> pen PHYS-NOCONTACT-LIMIT)
                          ;; frame ou au moins une paire (lien, volume) etait en contact : c'est la
                          ;; seule sorte de frame ou « penetration nulle » veut dire quelque chose.
                          (set! (-> *phys-conf* sc) (+ 1.0 (-> *phys-conf* sc)))
                          (when (> pen (-> *phys-st* (+ stb 4)))
                            (set! (-> *phys-st* (+ stb 4)) pen))))
                      ;; --- ancrage de la racine (SPEC 2). Deux residus, on garde le pire :
                      ;;      a) de combien la RACINE ecrite s'ecarte de la racine du modele
                      ;;         (identiquement nul sur un lien rootlock : il n'est pas ecrit) ;
                      ;;      b) de combien le PREMIER LIEN LIBRE s'ecarte de la longueur que le
                      ;;         modele donne a son os — son attache est l'ancre quand il est seul.
                      (let ((rd 0.0))
                        (let ((k0 (-> *phys-joint* (* sc PHYS-LINKS))))
                          (when (and (>= k0 0) (< (+ k0 1) nbone))
                            (set! (-> pt x) (-> *phys-px* (* sc PHYS-LINKS)))
                            (set! (-> pt y) (-> *phys-py* (* sc PHYS-LINKS)))
                            (set! (-> pt z) (-> *phys-pz* (* sc PHYS-LINKS)))
                            (set! (-> pt w) 1.0)
                            (set! rd (vector-vector-distance
                                       pt (the-as vector (-> skel bones (+ k0 1) transform vector 3))))))
                        (let* ((l0   rlk)
                               (scl  (+ (* sc PHYS-LINKS) l0))
                               (kk   (-> *phys-joint* scl))
                               (kp   (if (> l0 0) (-> *phys-joint* (- scl 1)) an)))
                          (when (and (< l0 n) (>= kk 0) (>= kp 0)
                                     (< (+ kk 1) nbone) (< (+ kp 1) nbone))
                            (let* ((want (vector-vector-distance
                                           (the-as vector (-> skel bones (+ kk 1) transform vector 3))
                                           (the-as vector (-> skel bones (+ kp 1) transform vector 3))))
                                   (bx (if (> l0 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                                   (by (if (> l0 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                                   (bz (if (> l0 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                                   (dx (- (-> *phys-px* scl) bx))
                                   (dy (- (-> *phys-py* scl) by))
                                   (dz (- (-> *phys-pz* scl) bz))
                                   (got (sqrtf (+ (* dx dx) (* dy dy) (* dz dz))))
                                   (res (fabs (- got want))))
                              (when (> res rd) (set! rd res)))))
                        (when (> rd (-> *phys-st* (+ stb 3)))
                          (set! (-> *phys-st* (+ stb 3)) rd)))
                      ;; --- ALLONGEMENT RELATIF et INVERSION RESIDUELLE, sur la position ECRITE et
                      ;; --- APRES tout le solveur. Ce sont les deux nombres que la 5e et la 2e/3e/4e
                      ;; --- passe de l'owner exigent : « ils s'allongent, c'est un peu debile » et
                      ;; --- « un de ses seins retourne vers l'interieur ». Meme attache, meme
                      ;; --- direction de modele que la contrainte : l'instrument de mesure est
                      ;; --- l'instrument de decision.
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (kk  (-> *phys-joint* scl))
                                 (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
                            (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
                              (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                                     (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                                     (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                                     (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                                            (-> skel bones (+ kp 1) transform vector 3 x)))
                                     (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                                            (-> skel bones (+ kp 1) transform vector 3 y)))
                                     (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                                            (-> skel bones (+ kp 1) transform vector 3 z)))
                                     (ux (- (-> *phys-px* scl) bx))
                                     (uy (- (-> *phys-py* scl) by))
                                     (uz (- (-> *phys-pz* scl) bz))
                                     (m2 (+ (* mx mx) (+ (* my my) (* mz mz))))
                                     (u2 (+ (* ux ux) (+ (* uy uy) (* uz uz))))
                                     (dot (+ (* ux mx) (+ (* uy my) (* uz mz)))))
                                (when (> m2 0.0001)
                                  ;; [NOTE-100] LA DEFORMATION QUE LA CHAIR SUBIT, et ce n'est ni tipvar ni elong. -> jak-hd-physics-NOTES.md
                                  (let* ((wx (- (-> *phys-px* scl)
                                                (-> skel bones (+ kk 1) transform vector 3 x)))
                                         (wy (- (-> *phys-py* scl)
                                                (-> skel bones (+ kk 1) transform vector 3 y)))
                                         (wz (- (-> *phys-pz* scl)
                                                (-> skel bones (+ kk 1) transform vector 3 z)))
                                         (sh (/ (sqrtf (+ (* wx wx) (+ (* wy wy) (* wz wz))))
                                                (sqrtf m2))))
                                    (when (> sh (-> *phys-dg* (+ (* sc PHYS-DG) 8)))
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 8)) sh)))
                                  (let ((el (fabs (- (/ (sqrtf u2) (sqrtf m2)) 1.0))))
                                    (when (> el (-> *phys-dg* (+ (* sc PHYS-DG) 5)))
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 5)) el))
                                    ;; LE MEME ALLONGEMENT, MAIS PAR FENETRE : « ils s'allongent sur
                                    ;; les mouvements BRUSQUES » est une phrase sur un PILOTAGE, et
                                    ;; le compteur par course ne peut pas la verifier.
                                    (when (> el (-> *phys-st* (+ stb 17)))
                                      (set! (-> *phys-st* (+ stb 17)) el)))
                                  ;; LE MOUVEMENT PROPRE DU MAILLON : l'angle entre sa direction
                                  ;; courante et la direction que le MODELE donne au meme os, tous
                                  ;; deux mesures depuis LA MEME ATTACHE. Un maillon qui suit
                                  ;; rigidement son parent vaut zero ici quelle que soit l'agitation
                                  ;; du parent — c'est ce que la boite englobante ne pouvait pas
                                  ;; voir, et c'est la suite que SPEC 2 exige croissante.
                                  (when (> u2 0.0001)
                                    (let* ((cx (- (* uy mz) (* uz my)))
                                           (cy (- (* uz mx) (* ux mz)))
                                           (cz (- (* ux my) (* uy mx)))
                                           (sn (sqrtf (+ (* cx cx) (+ (* cy cy) (* cz cz)))))
                                           ;; 360 / 65536 : `atan` rend des unites de rotation, on
                                           ;; publie des degres.
                                           (ang (* 0.0054931641 (atan sn dot))))
                                      (when (> ang (-> *phys-la* scl))
                                        (set! (-> *phys-la* scl) ang))))
                                  ;; LA MEME DEVIATION, MAIS SIGNEE ET VECTORIELLE (voir la note de
                                  ;; `*phys-lsv*`). Ecrasee, jamais accumulee : c'est l'etat de
                                  ;; CETTE frame, la seule forme qui puisse porter une phase.
                                  (when (> u2 0.0001)
                                    (let ((iu (/ 1.0 (sqrtf u2)))
                                          (im (/ 1.0 (sqrtf m2)))
                                          (sv3 (* scl 3)))
                                      (set! (-> *phys-lsv* (+ sv3 0)) (- (* ux iu) (* mx im)))
                                      (set! (-> *phys-lsv* (+ sv3 1)) (- (* uy iu) (* my im)))
                                      (set! (-> *phys-lsv* (+ sv3 2)) (- (* uz iu) (* mz im)))
                                      ;; LA MEME DEVIATION, PROJETEE SUR LE TRIEDRE DE L'ANCRE
                                      ;; (SPEC 24, voir la note de `*phys-lda*`). Meme instant,
                                      ;; meme grandeur, meme ligne de base : c'est le MEME vecteur
                                      ;; lu dans une autre base, pas une seconde mesure qui
                                      ;; pourrait contredire la premiere. L'ordre publie est
                                      ;; (v, ap, lat) — celui de SPEC 24 — et non l'ordre des
                                      ;; lignes de la matrice, qui ne veut rien dire hors du rig.
                                      ;; Chaine non classee : la serie reste a 0 et l'outil ecrit
                                      ;; `insufficient-excitation`, jamais un repli.
                                      (when (nonzero? (-> *phys-axok* sc))
                                        (let ((dvx (- (* ux iu) (* mx im)))
                                              (dvy (- (* uy iu) (* my im)))
                                              (dvz (- (* uz iu) (* mz im)))
                                              ;; LA MEME DIFFERENCE, SANS NORMALISER (voir la note
                                              ;; de `*phys-ldb*`). `u` et `m` partent de LA MEME
                                              ;; ATTACHE, donc `u - m` EST le deplacement du
                                              ;; maillon par rapport a sa pose d'auteur — les trois
                                              ;; degres de liberte, dont le RADIAL que la version
                                              ;; normalisee annule par construction.
                                              (bvx (- ux mx))
                                              (bvy (- uy my))
                                              (bvz (- uz mz)))
                                          (dotimes (ii 3)
                                            (let* ((row (cond ((= ii 0) (-> *phys-axv* sc))
                                                              ((= ii 1) (-> *phys-axa* sc))
                                                              (else     (-> *phys-axl* sc))))
                                                   (rx (-> am vector row x))
                                                   (ry (-> am vector row y))
                                                   (rz (-> am vector row z))
                                                   (rl (sqrtf (+ (* rx rx) (+ (* ry ry) (* rz rz))))))
                                              (set! (-> *phys-lda* (+ sv3 ii))
                                                    (if (> rl 0.0001)
                                                      (/ (+ (* dvx rx) (+ (* dvy ry) (* dvz rz))) rl)
                                                      0.0))
                                              ;; MEME LIGNE, MEME NORMALISATION DE LIGNE, MEME
                                              ;; INSTANT : seule la grandeur projetee change.
                                              (set! (-> *phys-ldb* (+ sv3 ii))
                                                    (if (> rl 0.0001)
                                                      (/ (+ (* bvx rx) (+ (* bvy ry) (* bvz rz))) rl)
                                                      0.0))))))))
                                  ;; L'INSTRUMENT DE MESURE EST L'INSTRUMENT DE DECISION : le
                                  ;; solveur ne corrige le cote QUE sur le PREMIER LIEN LIBRE, celui
                                  ;; dont l'attache est rigide, donc la mesure ne le compte que la.
                                  ;; Compter les liens profonds donnait 24 117 « inversions
                                  ;; residuelles » que rien ne corrigeait et que rien n'avait
                                  ;; demande de corriger — un chiffre sans decision derriere.
                                  ;; Le predicat suit celui du solveur (`l = rlk`, corrige le
                                  ;; 2026-08-12) : sur les chaines rootlockees `l = 0` n'etait
                                  ;; jamais visite, donc les deux lisaient zero par construction.
                                  (when (and (= l rlk) (< dot 0.0)
                                             (> (* dot dot) (* PHYS-SIDE-COS2 (* u2 m2))))
                                    (set! *phys-invres* (+ *phys-invres* 1))
                                    (set! (-> *phys-dg* (+ (* sc PHYS-DG) 4))
                                          (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 4)))))))))))
                      ;; --- la pointe : amplitude de l'ecart (physique seule) et intention
                      ;; --- d'auteur sur CETTE chaine, la meme frame (SPEC 5).
                      (let* ((sclt (+ (* sc PHYS-LINKS) (- n 1)))
                             (kt   (-> *phys-joint* sclt)))
                        (when (and (>= kt 0) (< (+ kt 1) nbone))
                          (let ((ox (-> *phys-ox* sclt))
                                (oy (-> *phys-oy* sclt))
                                (oz (-> *phys-oz* sclt)))
                            ;; pointe d'AUTEUR dans le repere de l'ancre (transformation de POINT :
                            ;; w = 1, la translation compte)
                            (set-vector! uv (-> skel bones (+ kt 1) transform vector 3 x)
                                            (-> skel bones (+ kt 1) transform vector 3 y)
                                            (-> skel bones (+ kt 1) transform vector 3 z)
                                            1.0)
                            (vector-matrix*! uv uv w2l)
                            ;; boite englobante de l'ecart de pointe
                            (when (< ox (-> *phys-st* (+ stb 6)))  (set! (-> *phys-st* (+ stb 6)) ox))
                            (when (> ox (-> *phys-st* (+ stb 7)))  (set! (-> *phys-st* (+ stb 7)) ox))
                            (when (< oy (-> *phys-st* (+ stb 8)))  (set! (-> *phys-st* (+ stb 8)) oy))
                            (when (> oy (-> *phys-st* (+ stb 9)))  (set! (-> *phys-st* (+ stb 9)) oy))
                            (when (< oz (-> *phys-st* (+ stb 10))) (set! (-> *phys-st* (+ stb 10)) oz))
                            (when (> oz (-> *phys-st* (+ stb 11))) (set! (-> *phys-st* (+ stb 11)) oz))
                            ;; POSITION MOYENNE de la pointe dans le repere de l'ancre. La boite
                            ;; ci-dessus ne retient que la VARIANCE : sous une inclinaison TENUE la
                            ;; chaine se pose sur un nouvel equilibre et ne bouge plus, donc la
                            ;; boite y mesure zero et l'a toujours mesure (PHYSTILT amp=0.0000 sur
                            ;; 19 chaines sur 22). La gravite ne se lit que dans le DEPLACEMENT
                            ;; SOUTENU, c'est-a-dire ici.
                            (set! (-> *phys-st* (+ stb 12)) (+ ox (-> *phys-st* (+ stb 12))))
                            (set! (-> *phys-st* (+ stb 13)) (+ oy (-> *phys-st* (+ stb 13))))
                            (set! (-> *phys-st* (+ stb 14)) (+ oz (-> *phys-st* (+ stb 14))))
                            (set! (-> *phys-st* (+ stb 15)) (+ 1.0 (-> *phys-st* (+ stb 15))))
                            ;; [NOTE-94] L'IDENTITE DU CANAL D'AUTEUR, EN REPERE MONDE. -> jak-hd-physics-NOTES.md
                            (set-vector! sv
                              (- (-> *phys-px* sclt) (-> skel bones (+ kt 1) transform vector 3 x))
                              (- (-> *phys-py* sclt) (-> skel bones (+ kt 1) transform vector 3 y))
                              (- (-> *phys-pz* sclt) (-> skel bones (+ kt 1) transform vector 3 z))
                              0.0)
                            (set-vector! uv2 ox oy oz 0.0)
                            (vector-rotate*! uv2 uv2 am)
                            (when (nonzero? (-> *phys-thas* sc))
                              (let* ((cdx (- ox (-> *phys-tx* sc)))
                                     (cdy (- oy (-> *phys-ty* sc)))
                                     (cdz (- oz (-> *phys-tz* sc)))
                                     (d   (sqrtf (+ (* cdx cdx) (* cdy cdy) (* cdz cdz)))))
                                (set! (-> *phys-st* (+ stb 0)) (+ 1.0 (-> *phys-st* (+ stb 0))))
                                (set! (-> *phys-st* (+ stb 1)) (+ d (-> *phys-st* (+ stb 1))))
                                (when (> d (-> *phys-st* (+ stb 2))) (set! (-> *phys-st* (+ stb 2)) d))
                                (when (nonzero? (-> *phys-rhas* sc))
                                  (let* ((adx (- (-> uv x) (-> *phys-rtx* sc)))
                                         (ady (- (-> uv y) (-> *phys-rty* sc)))
                                         (adz (- (-> uv z) (-> *phys-rtz* sc)))
                                         (am2 (+ (* adx adx) (* ady ady) (* adz adz)))
                                         (amg (sqrtf am2)))
                                    (when (> amg PHYS-AUTH-EPS)
                                      ;; L'ANIMATION EST-ELLE PASSEE INTACTE ? La position ecrite
                                      ;; doit valoir la pose d'AUTEUR + l'ecart simule, sans que le
                                      ;; second n'ampute le premier : dans le repere de l'ancre cela
                                      ;; s'ecrit s == u + o, et l'ecart mesure ici est
                                      ;; |s - u - o|. Il vaut zero quand l'animation traverse a
                                      ;; coefficient 1 et NE PEUT PAS valoir zero si quoi que ce
                                      ;; soit la met a l'echelle, la mixe ou la retarde — c'est ce
                                      ;; que le controle positif (*phys-auth-lag*) verifie en
                                      ;; retardant l'animation d'une frame.
                                      (let* ((ex (- (-> sv x) (-> uv2 x)))
                                             (ey (- (-> sv y) (-> uv2 y)))
                                             (ez (- (-> sv z) (-> uv2 z)))
                                             (er (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez)))))
                                             (sdx (+ adx cdx)) (sdy (+ ady cdy)) (sdz (+ adz cdz)))
                                        (set! (-> *phys-ahit* sc) (+ 1.0 (-> *phys-ahit* sc)))
                                        (when (<= er PHYS-AUTH-TOL)
                                          (set! (-> *phys-aok* sc) (+ 1.0 (-> *phys-aok* sc))))
                                        ;; publies mais NON gates : la correlation du deplacement
                                        ;; ecrit avec celui d'auteur, et les deux amplitudes qui
                                        ;; disent pourquoi cette correlation est bruitee des que le
                                        ;; pilotage domine l'animation.
                                        (set! (-> *phys-adot* sc)
                                              (+ (-> *phys-adot* sc)
                                                 (+ (* sdx adx) (+ (* sdy ady) (* sdz adz)))))
                                        (set! (-> *phys-anrm* sc) (+ (-> *phys-anrm* sc) am2))
                                        (set! (-> *phys-dsum* sc) (+ (-> *phys-dsum* sc) d))
                                        (set! (-> *phys-usum* sc) (+ (-> *phys-usum* sc) amg))))))))
                            (set! (-> *phys-tx* sc) ox)
                            (set! (-> *phys-ty* sc) oy)
                            (set! (-> *phys-tz* sc) oz)
                            (set! (-> *phys-thas* sc) 1)
                            (set! (-> *phys-rtx* sc) (-> uv x))
                            (set! (-> *phys-rty* sc) (-> uv y))
                            (set! (-> *phys-rtz* sc) (-> uv z))
                            (set! (-> *phys-rhas* sc) 1)))))

                    ;; [NOTE-78] ---- 5bis. SPEC 8 / 10-13 / 29-torsion / 36 — L'ETAT DE FORME ET DE TORSION. -> jak-hd-physics-NOTES.md
                    (when (and (= (-> *phys-fam* sc) 1) (> n 0))
                      (let* ((tl  (+ (* sc PHYS-LINKS) (- n 1)))
                             (gb  (* sc 3))
                             (b0f (fmax 1.0 (if (> (-> *phys-b0* sc) 0.0)
                                              (-> *phys-b0* sc) (-> *phys-blen* tl)))))
                        ;; (a) LE TRIEDRE DE SA SPEC 7 (+X lateral, +Y haut, +Z avant), releve UNE
                        ;; fois, a la MEME frame que `g_ref` et `*phys-ux*`. Il ne se lit sur aucun
                        ;; nom d'os : +Y est l'oppose de la gravite de la pose d'auteur, +Z la
                        ;; protrusion racine->apex orthogonalisee, +X leur produit vectoriel.
                        (when (and (zero? (-> *phys-fok* sc)) (nonzero? (-> *phys-ucap* tl)))
                          (let ((gn (sqrtf (+ (* (-> *phys-gref* gb) (-> *phys-gref* gb))
                                              (+ (* (-> *phys-gref* (+ gb 1)) (-> *phys-gref* (+ gb 1)))
                                                 (* (-> *phys-gref* (+ gb 2)) (-> *phys-gref* (+ gb 2))))))))
                            (when (> gn 0.0001)
                              (set-vector! (-> *phys-fy* sc)
                                           (/ (- 0.0 (-> *phys-gref* gb)) gn)
                                           (/ (- 0.0 (-> *phys-gref* (+ gb 1))) gn)
                                           (/ (- 0.0 (-> *phys-gref* (+ gb 2))) gn) 0.0)
                              ;; [NOTE-67] +Z = L'AXE AVANT-ARRIERE DE L'ANCRE, ET C'EST UNE CORRECTION MESUREE. -> jak-hd-physics-NOTES.md
                              (let* ((ia (-> *phys-axa* sc))
                                     (e0 (if (= ia 0) 1.0 0.0))
                                     (e1 (if (= ia 1) 1.0 0.0))
                                     (e2 (if (= ia 2) 1.0 0.0))
                                     (d  (+ (* e0 (-> *phys-fy* sc x))
                                            (+ (* e1 (-> *phys-fy* sc y))
                                               (* e2 (-> *phys-fy* sc z)))))
                                     (zx0 (- e0 (* d (-> *phys-fy* sc x))))
                                     (zy0 (- e1 (* d (-> *phys-fy* sc y))))
                                     (zz0 (- e2 (* d (-> *phys-fy* sc z))))
                                     ;; [NOTE-68] LE SIGNE : `+ligne[axa]`, ET IL EST MESURE, PAS SUPPOSE. -> jak-hd-physics-NOTES.md
                                     (zx zx0) (zy zy0) (zz zz0)
                                     (zl (sqrtf (+ (* zx zx) (+ (* zy zy) (* zz zz))))))
                                (when (> zl 0.05)
                                  (set-vector! (-> *phys-fz* sc) (/ zx zl) (/ zy zl) (/ zz zl) 0.0)
                                  (vector-cross! (-> *phys-fx* sc) (-> *phys-fy* sc) (-> *phys-fz* sc))
                                  (set! (-> *phys-fx* sc w) 0.0)
                                  (set! (-> *phys-fok* sc) 1))))))
                        (when (nonzero? (-> *phys-fok* sc))
                          ;; [NOTE-69] (b) SPEC 10-13 — L'EQUILIBRE DE FORME, CONTINU EN LA DIRECTION DE LA -> jak-hd-physics-NOTES.md
                          (let* ((gnn (vector-length gla))
                                 (ivg (if (> gnn 0.0001) (/ 1.0 gnn) 0.0))
                                 (gxc (* ivg (+ (* (-> gla x) (-> *phys-fx* sc x))
                                                (+ (* (-> gla y) (-> *phys-fx* sc y))
                                                   (* (-> gla z) (-> *phys-fx* sc z))))))
                                 (gyc (* ivg (+ (* (-> gla x) (-> *phys-fy* sc x))
                                                (+ (* (-> gla y) (-> *phys-fy* sc y))
                                                   (* (-> gla z) (-> *phys-fy* sc z))))))
                                 (gzc (* ivg (+ (* (-> gla x) (-> *phys-fz* sc x))
                                                (+ (* (-> gla y) (-> *phys-fz* sc y))
                                                   (* (-> gla z) (-> *phys-fz* sc z))))))
                                 (wdn (fmax 0.0 (- 0.0 gyc)))
                                 (wup (fmax 0.0 gyc))
                                 (wbk (fmax 0.0 (- 0.0 gzc)))
                                 (wfw (fmax 0.0 gzc))
                                 (wlt (fabs gxc))
                                 (wsm (fmax 0.0001 (+ wdn (+ wup (+ wbk (+ wfw wlt))))))
                                 ;; [NOTE-52] SPEC 10 ET SPEC 11 ETAIENT INTERVERTIES (`wbk`/`wfw`, signe de `gzc`). -> jak-hd-physics-NOTES.md
                                 (sx0 (/ (+ (* wdn 1.000) (+ (* wup 0.900)
                                            (+ (* wbk 0.900) (+ (* wfw 1.230) (* wlt 0.800))))) wsm))
                                 (sy0 (/ (+ (* wdn 1.000) (+ (* wup 1.230)
                                            (+ (* wbk 0.910) (+ (* wfw 1.090) (* wlt 1.118))))) wsm))
                                 (sz0 (/ (+ (* wdn 1.000) (+ (* wup 0.910)
                                            (+ (* wbk 1.230) (+ (* wfw 0.700) (* wlt 1.118))))) wsm))
                                 ;; (c) SPEC 8 — `Sx.Sy.Sz = 1`. Les triplets de sa spec sont des
                                 ;; BOITES ENGLOBANTES et elle le dit (« the volume constraint
                                 ;; applies to the actual deformable volume, NOT merely to the
                                 ;; bounding-box dimensions quoted below ») : celui de §10 vaut
                                 ;; 0.938. On garde donc ses RAPPORTS de forme et on ramene le
                                 ;; determinant a 1 — les trois valeurs restent dans ses bandes
                                 ;; (supine 0.715 / 1.256 / 1.113 contre -25..-35 %, +18..+28 %,
                                 ;; +5..+12 %). Racine cubique par deux pas de Newton, l'entree
                                 ;; etant toujours proche de 1.
                                 (det (* sx0 (* sy0 sz0)))
                                 (y1  (- 1.0 (/ (- 1.0 det) 3.0)))
                                 (y2  (- y1 (/ (- (* y1 (* y1 y1)) det) (fmax 0.0001 (* 3.0 (* y1 y1))))))
                                 (cvn (/ 1.0 (fmax 0.0001 y2)))
                                 ;; (d) SPEC 36 — LE MODE SECONDAIRE. Oscillateur propre a 5.2 Hz,
                                 ;; zeta 0.65, EXCITE PAR UN CHANGEMENT DE DIRECTION de la masse
                                 ;; globale (« this response should mainly appear after a change in
                                 ;; direction of the global breast mass ») : l'entree est donc la
                                 ;; VARIATION de la vitesse de pointe d'une frame a l'autre, rapportee
                                 ;; a B0. Meme recurrence que le mode principal (Euler symplectique),
                                 ;; meme forme d'amortissement `2 zeta w dt`.
                                 (vtx (- (-> *phys-px* tl) (-> *phys-qx* tl)))
                                 (vty (- (-> *phys-py* tl) (-> *phys-qy* tl)))
                                 (vtz (- (-> *phys-pz* tl) (-> *phys-qz* tl)))
                                 (dvx (- vtx (-> *phys-vp* sc x)))
                                 (dvy (- vty (-> *phys-vp* sc y)))
                                 (dvz (- vtz (-> *phys-vp* sc z)))
                                 (dvn (/ (sqrtf (+ (* dvx dvx) (+ (* dvy dvy) (* dvz dvz)))) b0f))
                                 ;; OSCILLATEUR SCALAIRE, SANS ANISOTROPIE : la forme EXACTE de
                                 ;; NOTE-50 s'y pose directement. Elle n'est pas un raffinement
                                 ;; ici — `omega dt` vaut 0.545, et l'ancienne ecriture livrait
                                 ;; zeta 0.838 a 7.01 Hz la ou sa SPEC 36 demande 0.65 a 5.20.
                                 (w2  (* 6.2831853 PHYS-SEC-F))
                                 (wh2 (* w2 dt))
                                 (k2s (phys-osc-k2 PHYS-SEC-Z wh2))
                                 (kd2 (phys-decay (* 2.0 (* PHYS-SEC-Z wh2))))
                                 ;; MEME FORME QUE LE MODE PRINCIPAL, a la lettre : la trainee ne
                                 ;; porte que l'ANCIENNE vitesse, la force et l'excitation
                                 ;; s'ajoutent apres. Ecrire `kd2 * (v - k2 m)` amortirait aussi la
                                 ;; force et le mode secondaire ne serait plus le meme oscillateur
                                 ;; que celui dont sa §36 donne zeta.
                                 (sv2 (+ (* kd2 (-> *phys-secv* sc))
                                         (+ (* (- 0.0 k2s) (-> *phys-sec* sc)) (* PHYS-SEC-K dvn))))
                                 (sm0 (+ (-> *phys-sec* sc) sv2))
                                 ;; [NOTE-70] SPEC 37 : « soft displacement clamps should be preferred to -> jak-hd-physics-NOTES.md
                                 (smc (if (>= sm0 0.0)
                                        (phys-softmin sm0 PHYS-SEC-MAX)
                                        (- 0.0 (phys-softmin (- 0.0 sm0) PHYS-SEC-MAX))))
                                 ;; SPEC 36 s'applique a l'EPAISSEUR locale et conserve le volume :
                                 ;; l'epaisseur (axe +Z) module, les deux perpendiculaires prennent
                                 ;; l'inverse de sa racine.
                                 (sqz (sqrtf (fmax 0.0001 (+ 1.0 smc))))
                                 (sx1 (* cvn (/ sx0 sqz)))
                                 (sy1 (* cvn (/ sy0 sqz)))
                                 (sz1 (* cvn (* sz0 (+ 1.0 smc)))))
                            (set! (-> *phys-secv* sc) sv2)
                            (set! (-> *phys-sec* sc) smc)
                            (when (> (fabs smc) (-> *phys-secm* sc))
                              (set! (-> *phys-secm* sc) (fabs smc)))
                            (when (> (fabs sm0) (-> *phys-secr* sc))
                              (set! (-> *phys-secr* sc) (fabs sm0)))
                            (set-vector! (-> *phys-vp* sc) vtx vty vtz 0.0)
                            (set! (-> *phys-gr* gb) (* ivg (-> gla x)))
                            (set! (-> *phys-gr* (+ gb 1)) (* ivg (-> gla y)))
                            (set! (-> *phys-gr* (+ gb 2)) (* ivg (-> gla z)))
                            (set! (-> *phys-gc* gb) gxc)
                            (set! (-> *phys-gc* (+ gb 1)) gyc)
                            (set! (-> *phys-gc* (+ gb 2)) gzc)
                            (set! (-> *phys-dfs* gb) sx1)
                            (set! (-> *phys-dfs* (+ gb 1)) sy1)
                            (set! (-> *phys-dfs* (+ gb 2)) sz1)
                            (set! (-> *phys-dfdet* sc) (* sx1 (* sy1 sz1)))
                            (set! (-> *phys-dfon* sc) 1))
                          ;; [NOTE-71] (e) SPEC 29 — LE DEGRE DE LIBERTE EN TORSION, `TorsionalCompliance 0.72`. -> jak-hd-physics-NOTES.md
                          (let* ((k   (-> *phys-joint* tl)))
                            (when (and (>= k 0) (< (+ k 1) nbone))
                              ;; [NOTE-72] LE ROULIS DE L'ANCRE, PAR DECOMPOSITION SWING/TWIST — ET C'EST LA -> jak-hd-physics-NOTES.md
                              (let* ((ux (-> *phys-ux* tl)) (uy (-> *phys-uy* tl)) (uz (-> *phys-uz* tl))
                                     (al (sqrtf (+ (* ux ux) (+ (* uy uy) (* uz uz))))))
                                (when (> al 0.0001)
                                  (begin
                                    (begin
                                      (begin
                                        (cond
                                          ((zero? (-> *phys-twok* sc))
                                           (matrix-copy! (-> *phys-a0m* sc) am)
                                           (set! (-> *phys-twok* sc) 1))
                                          (else
                                           (let* ((r21 (+ (* (-> *phys-a0m* sc vector 0 z) (-> am vector 0 y))
                                                          (+ (* (-> *phys-a0m* sc vector 1 z) (-> am vector 1 y))
                                                             (* (-> *phys-a0m* sc vector 2 z) (-> am vector 2 y)))))
                                                  (r12 (+ (* (-> *phys-a0m* sc vector 0 y) (-> am vector 0 z))
                                                          (+ (* (-> *phys-a0m* sc vector 1 y) (-> am vector 1 z))
                                                             (* (-> *phys-a0m* sc vector 2 y) (-> am vector 2 z)))))
                                                  (r02 (+ (* (-> *phys-a0m* sc vector 0 x) (-> am vector 0 z))
                                                          (+ (* (-> *phys-a0m* sc vector 1 x) (-> am vector 1 z))
                                                             (* (-> *phys-a0m* sc vector 2 x) (-> am vector 2 z)))))
                                                  (r20 (+ (* (-> *phys-a0m* sc vector 0 z) (-> am vector 0 x))
                                                          (+ (* (-> *phys-a0m* sc vector 1 z) (-> am vector 1 x))
                                                             (* (-> *phys-a0m* sc vector 2 z) (-> am vector 2 x)))))
                                                  (r10 (+ (* (-> *phys-a0m* sc vector 0 y) (-> am vector 0 x))
                                                          (+ (* (-> *phys-a0m* sc vector 1 y) (-> am vector 1 x))
                                                             (* (-> *phys-a0m* sc vector 2 y) (-> am vector 2 x)))))
                                                  (r01 (+ (* (-> *phys-a0m* sc vector 0 x) (-> am vector 0 y))
                                                          (+ (* (-> *phys-a0m* sc vector 1 x) (-> am vector 1 y))
                                                             (* (-> *phys-a0m* sc vector 2 x) (-> am vector 2 y)))))
                                                  (omx (* 0.5 (- r21 r12)))
                                                  (omy (* 0.5 (- r02 r20)))
                                                  (omz (* 0.5 (- r10 r01)))
                                                  (dphi (/ (+ (* omx ux) (+ (* omy uy) (* omz uz)))
                                                           (fmax 0.0001 al))))
                                             (matrix-copy! (-> *phys-a0m* sc) am)
                                             ;; SPEC 37 — « artificial transforms must not generate
                                             ;; physical impulses » : au-dela d'un demi-radian en une
                                             ;; frame ce n'est plus une rotation du buste, c'est un
                                             ;; teleport ou une coupe. On REBASE (la reference suit)
                                             ;; au lieu d'injecter le saut.
                                             (when (< (fabs dphi) 0.5)
                                               (set! (-> *phys-twa* sc) (+ (-> *phys-twa* sc) dphi)))
                                             ;; OSCILLATEUR SCALAIRE : forme EXACTE de NOTE-50.
                                             ;; `zt` n'introduit AUCUNE constante neuve — c'est le
                                             ;; zeta que la donnee livree porte deja, relu comme
                                             ;; `taux / (2 omega h)` au lieu d'etre suppose.
                                             (let* ((w   (/ (* 6.2831853 (-> *phys-stiff* sc))
                                                            (sqrtf (fmax 0.01 (-> *phys-mass* sc)))))
                                                    (mbt (sqrtf (/ 1.0 PHYS-MOB-TOR)))
                                                    (wht (* w (* dt mbt)))
                                                    (zt  (/ (* (-> *phys-damp* sc) mbt)
                                                            (* 2.0 (fmax 0.000001 wht))))
                                                    (k2t (phys-osc-k2 zt wht))
                                                    (kdt (phys-decay (* 2.0 (* zt wht))))
                                                    (tv  (+ (* kdt (-> *phys-twv* sc))
                                                            (* k2t (- (-> *phys-twa* sc) (-> *phys-tw* sc)))))
                                                    (twn (+ (-> *phys-tw* sc) tv))
                                                    (rw  (fmax 1.0 (-> *phys-lcr* tl)))
                                                    ;; SPEC 38 — la torsion deplace un point de la
                                                    ;; chair situe a `rw` du centre de `rw * theta`.
                                                    ;; Sa borne est donc CELLE DE L'APEX, pas un
                                                    ;; chiffre invente : `HardMaxApexDisplacement
                                                    ;; 0.50 B0`, et le genou de `phys-softmin`
                                                    ;; (0.84 x cap) tombe exactement sur son
                                                    ;; `NormalMaxApexDisplacement 0.42 B0`.
                                                    (tcap (/ (* 0.50 b0f) rw))
                                                    (rel0 (- twn (-> *phys-twa* sc)))
                                                    (rel  (if (>= rel0 0.0)
                                                            (phys-softmin rel0 tcap)
                                                            (- 0.0 (phys-softmin (- 0.0 rel0) tcap)))))
                                               (when (> (fabs (- rel0 rel)) 0.000001)
                                                 (set! *phys-twsat* (+ *phys-twsat* 1)))
                                               (set! (-> *phys-twv* sc) tv)
                                               (set! (-> *phys-tw* sc) twn)
                                               (set! (-> *phys-twr* sc) rel)
                                               (when (> (fabs rel) (-> *phys-twm* sc))
                                                 (set! (-> *phys-twm* sc) (fabs rel))))))))))))))
                          ;; [NOTE-60] (f) LA MATRICE, BATIE UNE FOIS PAR CHAINE ET PAR FRAME. -> jak-hd-physics-NOTES.md
                          (let* ((gb  (* sc 3))
                                 ;; PAR MAILLON depuis le cycle 32 : `*phys-rr*` (par chaine) donnait
                                 ;; au distal l'elongation de la RACINE. C'est le seul terme du
                                 ;; solveur qui lit le degre de liberte de §23.
                                 (rdr (* PHYS-DYN-K (/ (-> *phys-rrl* tl) b0f)))
                                 (dx  (+ (* PHYS-DYN-K (/ (-> *phys-ox* tl) b0f))
                                         (* rdr (-> *phys-ux* tl))))
                                 (dy  (+ (* PHYS-DYN-K (/ (-> *phys-oy* tl) b0f))
                                         (* rdr (-> *phys-uy* tl))))
                                 (dz  (+ (* PHYS-DYN-K (/ (-> *phys-oz* tl) b0f))
                                         (* rdr (-> *phys-uz* tl))))
                                 (dl  (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz)))))
                                 (sdy (fmin PHYS-DYN-MAX dl))
                                 (ee  (+ 1.0 sdy))
                                 (tt  (/ 1.0 (sqrtf ee))))
                            (when (> sdy (-> *phys-dynm* sc)) (set! (-> *phys-dynm* sc) sdy))
                            (when (> dl (-> *phys-dynr* sc)) (set! (-> *phys-dynr* sc) dl))
                            (set! (-> *phys-dyna* sc) (+ 1.0 (-> *phys-dyna* sc)))
                            (when (> dl PHYS-DYN-MAX)
                              (set! (-> *phys-dynn* sc) (+ 1.0 (-> *phys-dynn* sc))))
                            (cond
                              ((and (> dl 0.000001) (> sdy 0.000001))
                               (let ((ux (/ dx dl)) (uy (/ dy dl)) (uz (/ dz dl)))
                                 (dotimes (i 3)
                                   (dotimes (j 3)
                                     (set! (-> dfb vector i data j)
                                           (* (- ee tt)
                                              (* (cond ((= i 0) ux) ((= i 1) uy) (else uz))
                                                 (cond ((= j 0) ux) ((= j 1) uy) (else uz))))))
                                   (set! (-> dfb vector i data i) (+ tt (-> dfb vector i data i)))
                                   (set! (-> dfb vector i data 3) 0.0))
                                 (set-vector! (-> dfb vector 3) 0.0 0.0 0.0 1.0)))
                              (else (matrix-identity! dfb)))
                            ;; §23 — LA PRESSION DE CONTACT, CINQUIEME ET DERNIER TERME DE SA LISTE.
                            ;; La poussee cumulee de la frame est deja calculee pour §33/34 : on la
                            ;; reutilise, aucune grandeur nouvelle n'est inventee. Le tissu s'aplatit
                            ;; LE LONG DE LA NORMALE et se redistribue sur les deux perpendiculaires,
                            ;; determinant exactement 1. Un contact nul ne change rien au bit pres.
                            (let* ((cx (-> *phys-cpu* tl x))
                                   (cy (-> *phys-cpu* tl y))
                                   (cz (-> *phys-cpu* tl z))
                                   (cl (sqrtf (+ (* cx cx) (+ (* cy cy) (* cz cz)))))
                                   ;; [NOTE-101] CYCLE 36 ETAPE 2 — L'INTENSITE, PAS LE CHEMIN.
                                   ;; [NOTE-106] Sa §23 demande « local collision PRESSURE » : une INTENSITE. -> jak-hd-physics-NOTES.md
                                   (pmx (-> *phys-cpa* (+ (* 7 tl) 1)))
                                   (pr0 (* PHYS-PRS-K (/ pmx b0f)))
                                   (prs (fmin PHYS-PRS-MAX pr0))
                                   (pe  (- 1.0 prs))
                                   (pt2 (/ 1.0 (sqrtf (fmax 0.0001 pe)))))
                              ;; [NOTE-97] RELEVE A L'ARGMAX DE `cl`, PAS EN MAXIMA INDEPENDANTS.
                              ;; C'est la lecon N3/N4 du cycle 35 : deux maxima de fenetre pris sur
                              ;; des grandeurs differentes ne se comparent pas, parce que l'argmax
                              ;; n'est pas la meme frame. `tl` est deja un index PAR MAILLON.
                              (when (> pr0 (-> *phys-prsr* sc))
                                (set! (-> *phys-prsr* sc) pr0)
                                (dotimes (k 7)
                                  (set! (-> *phys-cpi* (+ (* 7 sc) k))
                                        (-> *phys-cpa* (+ (* 7 tl) k)))))
                              ;; LE DOMAINE : sans lui, un zero serait un zero de domaine vide.
                              (when (> (-> *phys-cpa* (* 7 tl)) 0.0)
                                (set! (-> *phys-cpd* sc) (+ 1.0 (-> *phys-cpd* sc))))
                              (when (> pr0 PHYS-PRS-MAX)
                                (set! (-> *phys-prsn* sc) (+ 1.0 (-> *phys-prsn* sc))))
                              (when (> prs (-> *phys-prsm* sc)) (set! (-> *phys-prsm* sc) prs))
                              (when (> prs 0.000001)
                                ;; la normale est celle de la poussee, exprimee en MONDE ; le tenseur
                                ;; de deformation vit en espace ANCRE, on y ramene donc la normale.
                                (let* ((nx (/ cx cl)) (ny (/ cy cl)) (nz (/ cz cl))
                                       (ax2 (+ (* nx (-> w2l vector 0 x))
                                               (+ (* ny (-> w2l vector 1 x)) (* nz (-> w2l vector 2 x)))))
                                       (ay2 (+ (* nx (-> w2l vector 0 y))
                                               (+ (* ny (-> w2l vector 1 y)) (* nz (-> w2l vector 2 y)))))
                                       (az2 (+ (* nx (-> w2l vector 0 z))
                                               (+ (* ny (-> w2l vector 1 z)) (* nz (-> w2l vector 2 z)))))
                                       (al2 (sqrtf (+ (* ax2 ax2) (+ (* ay2 ay2) (* az2 az2))))))
                                  (when (> al2 0.0001)
                                    (let ((ux2 (/ ax2 al2)) (uy2 (/ ay2 al2)) (uz2 (/ az2 al2)))
                                      (dotimes (i 3)
                                        (dotimes (j 3)
                                          (set! (-> dfc vector i data j)
                                                (* (- pe pt2)
                                                   (* (cond ((= i 0) ux2) ((= i 1) uy2) (else uz2))
                                                      (cond ((= j 0) ux2) ((= j 1) uy2) (else uz2))))))
                                        (set! (-> dfc vector i data i) (+ pt2 (-> dfc vector i data i)))
                                        (set! (-> dfc vector i data 3) 0.0))
                                      (set-vector! (-> dfc vector 3) 0.0 0.0 0.0 1.0)
                                      (matrix*! tmp dfb dfc)
                                      (matrix-copy! dfb tmp))))))
                            (dotimes (i 3)
                              (dotimes (j 3)
                                (set! (-> dfa vector i data j)
                                      (+ (* (-> *phys-dfs* gb) (* (-> *phys-fx* sc data i) (-> *phys-fx* sc data j)))
                                         (+ (* (-> *phys-dfs* (+ gb 1)) (* (-> *phys-fy* sc data i) (-> *phys-fy* sc data j)))
                                            (* (-> *phys-dfs* (+ gb 2)) (* (-> *phys-fz* sc data i) (-> *phys-fz* sc data j)))))))
                              (set! (-> dfa vector i data 3) 0.0))
                            (set-vector! (-> dfa vector 3) 0.0 0.0 0.0 1.0)
                            ;; forme d'equilibre PUIS etirement dynamique, les deux en espace ANCRE
                            (matrix*! tmp dfa dfb)
                            ;; `A` en espace ancre, retenue pour la MESURE (voir `*phys-dfa*`).
                            (matrix-copy! (-> *phys-dfa* sc) tmp)
                            (matrix*! (-> *phys-dfm* sc) w2l tmp)
                            (matrix-copy! tmp (-> *phys-dfm* sc))
                            (matrix*! (-> *phys-dfm* sc) tmp am)
                            ;; SPEC 29 — la torsion est une ROTATION propre autour de l'axe
                            ;; racine->apex, appliquee AVANT l'echelle (l'axe est un axe propre de
                            ;; l'echelle a 10^-3 pres, les deux commutent en pratique).
                            (when (> (fabs (-> *phys-twr* sc)) 0.00001)
                              (let* ((ax (+ (* (-> *phys-ux* tl) (-> am vector 0 x))
                                            (+ (* (-> *phys-uy* tl) (-> am vector 1 x))
                                               (* (-> *phys-uz* tl) (-> am vector 2 x)))))
                                     (ay (+ (* (-> *phys-ux* tl) (-> am vector 0 y))
                                            (+ (* (-> *phys-uy* tl) (-> am vector 1 y))
                                               (* (-> *phys-uz* tl) (-> am vector 2 y)))))
                                     (az (+ (* (-> *phys-ux* tl) (-> am vector 0 z))
                                            (+ (* (-> *phys-uy* tl) (-> am vector 1 z))
                                               (* (-> *phys-uz* tl) (-> am vector 2 z)))))
                                     (al (sqrtf (+ (* ax ax) (+ (* ay ay) (* az az))))))
                                (when (> al 0.0001)
                                  (set-vector! nrm (/ ax al) (/ ay al) (/ az al) 0.0)
                                  (matrix-axis-angle! rot nrm (-> *phys-twr* sc))
                                  (matrix*! tmp rot (-> *phys-dfm* sc))
                                  (matrix-copy! (-> *phys-dfm* sc) tmp))))))))
                    ;; [NOTE-47] ---- 6. ECRITURE DANS LE SQUELETTE (SPEC 7 : c'est ca qui fait foi) ---- -> jak-hd-physics-NOTES.md
                    (dotimes (l n)
                      (when (>= l 0)
                        (let* ((scl (+ (* sc PHYS-LINKS) l))
                               (k   (-> *phys-joint* scl)))
                          (when (and (>= k 0) (< (+ k 1) nbone))
                            (let ((bm (the-as matrix (-> skel bones (+ k 1) transform))))
                              (matrix-copy! pre bm)
                              ;; [NOTE-48] ------------------------------------------------------------ -> jak-hd-physics-NOTES.md
                              (let ((have #f))
                                ;; [NOTE-95] LE LEVIER DE ROTATION EST CELUI DE L'ANCRE, PAS DE L'OS LOCAL. -> jak-hd-physics-NOTES.md
                                (when (and (>= an 0) (< (+ an 1) nbone))
                                  (let ((ax (-> skel bones (+ an 1) transform vector 3 x))
                                        (ay (-> skel bones (+ an 1) transform vector 3 y))
                                        (az (-> skel bones (+ an 1) transform vector 3 z)))
                                    (set! (-> rest x) (- (-> bm vector 3 x) ax))
                                    (set! (-> rest y) (- (-> bm vector 3 y) ay))
                                    (set! (-> rest z) (- (-> bm vector 3 z) az))
                                    (set! (-> pt x) (- (-> *phys-px* scl) ax))
                                    (set! (-> pt y) (- (-> *phys-py* scl) ay))
                                    (set! (-> pt z) (- (-> *phys-pz* scl) az))
                                    (set! have #t)))
                                (when have
                                  (set! (-> rest w) 1.0)
                                  (set! (-> pt w) 1.0)
                                  (begin
                                    (let ((la (vector-length rest)) (lb (vector-length pt)))
                                      (when (and (> la 0.01) (> lb 0.01))
                                        (vector-float*! rest rest (/ 1.0 la))
                                        (vector-float*! pt pt (/ 1.0 lb))
                                        (vector-cross! nrm rest pt)
                                        (let ((sn (vector-length nrm))
                                              (cs (vector-dot rest pt)))
                                          (when (> sn 0.0001)
                                            (vector-float*! nrm nrm (/ 1.0 sn))
                                            ;; [NOTE-49] `atan` de GOAL rend des UNITES DE ROTATION (65536 = -> jak-hd-physics-NOTES.md
                                            (when (>= (+ l 1) n)
                                              (let ((ad (* 0.0054931641 (atan sn cs))))
                                                (when (> ad (-> *phys-dg* (+ (* sc PHYS-DG) 10)))
                                                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 10)) ad))))
                                            ;; [NOTE-88] PREUVE D'EXECUTION DU MAILLON ROOTLOCK. -> jak-hd-physics-NOTES.md
                                            (when (< l rlk0)
                                              (let ((ad (* 0.0054931641 (atan sn cs))))
                                                (when (> ad (-> *phys-dg* (+ (* sc PHYS-DG) 14)))
                                                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 14)) ad))))
                                            ;; [NOTE-89] L'ANGLE DU MAILLON 0, SUR TOUTE CHAINE. -> jak-hd-physics-NOTES.md
                                            (when (= l 0)
                                              (let ((ad (* 0.0054931641 (atan sn cs))))
                                                (when (> ad (-> *phys-dg* (+ (* sc PHYS-DG) 13)))
                                                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 13)) ad))))
                                            (matrix-axis-angle! rot nrm (atan sn cs))
                                            (set! (-> bm vector 3 x) 0.0)
                                            (set! (-> bm vector 3 y) 0.0)
                                            (set! (-> bm vector 3 z) 0.0)
                                            (matrix*! tmp bm rot)
                                            (matrix-copy! bm tmp))))))))
                              ;; translation : la position simulee, telle quelle
                              ;; SPEC 8/10-13/29/36 — LA DEFORMATION ENTRE ICI, ET NULLE PART
                              ;; AILLEURS. La 3x3 est post-multipliee : un sommet de peau va
                              ;; d'abord la ou l'os d'auteur le mettait, puis subit l'echelle et la
                              ;; torsion, puis est pose a la position simulee. La ligne 3 est mise a
                              ;; zero avant, sinon la deformation s'appliquerait aussi a une
                              ;; translation qu'on va de toute facon remplacer.
                              ;; [NOTE-92] `c1` = R_auteur . rot . lc, LE TERME CHARNIERE DE L'IDENTITE. -> jak-hd-physics-NOTES.md
                              (set! (-> *phys-c1* 0) (+ (* (-> *phys-lcx* scl) (-> bm vector 0 x)) (+ (* (-> *phys-lcy* scl) (-> bm vector 1 x)) (* (-> *phys-lcz* scl) (-> bm vector 2 x)))))
                              (set! (-> *phys-c1* 1) (+ (* (-> *phys-lcx* scl) (-> bm vector 0 y)) (+ (* (-> *phys-lcy* scl) (-> bm vector 1 y)) (* (-> *phys-lcz* scl) (-> bm vector 2 y)))))
                              (set! (-> *phys-c1* 2) (+ (* (-> *phys-lcx* scl) (-> bm vector 0 z)) (+ (* (-> *phys-lcy* scl) (-> bm vector 1 z)) (* (-> *phys-lcz* scl) (-> bm vector 2 z)))))
                              (when (nonzero? (-> *phys-dfon* sc))
                                (set! (-> bm vector 3 x) 0.0)
                                (set! (-> bm vector 3 y) 0.0)
                                (set! (-> bm vector 3 z) 0.0)
                                (set! (-> bm vector 3 w) 1.0)
                                (matrix*! tmp bm (-> *phys-dfm* sc))
                                (matrix-copy! bm tmp))
                              (set! (-> bm vector 3 x) (-> *phys-px* scl))
                              (set! (-> bm vector 3 y) (-> *phys-py* scl))
                              (set! (-> bm vector 3 z) (-> *phys-pz* scl))
                              (set! (-> bm vector 3 w) 1.0)
                              ;; [NOTE-85] SPEC 22 — L'EXCURSION DU CENTRE DE CHAIR, EN B0, DEFORMATION COMPRISE. -> jak-hd-physics-NOTES.md
                              (let ((lcx (-> *phys-lcx* scl))
                                    (lcy (-> *phys-lcy* scl))
                                    (lcz (-> *phys-lcz* scl)))
                                (when (or (!= lcx 0.0) (!= lcy 0.0) (!= lcz 0.0))
                                  (let* ((ex (- (+ (-> bm vector 3 x)
                                                   (+ (* lcx (-> bm vector 0 x))
                                                      (+ (* lcy (-> bm vector 1 x))
                                                         (* lcz (-> bm vector 2 x)))))
                                                (+ (-> pre vector 3 x)
                                                   (+ (* lcx (-> pre vector 0 x))
                                                      (+ (* lcy (-> pre vector 1 x))
                                                         (* lcz (-> pre vector 2 x)))))))
                                         (ey (- (+ (-> bm vector 3 y)
                                                   (+ (* lcx (-> bm vector 0 y))
                                                      (+ (* lcy (-> bm vector 1 y))
                                                         (* lcz (-> bm vector 2 y)))))
                                                (+ (-> pre vector 3 y)
                                                   (+ (* lcx (-> pre vector 0 y))
                                                      (+ (* lcy (-> pre vector 1 y))
                                                         (* lcz (-> pre vector 2 y)))))))
                                         (ez (- (+ (-> bm vector 3 z)
                                                   (+ (* lcx (-> bm vector 0 z))
                                                      (+ (* lcy (-> bm vector 1 z))
                                                         (* lcz (-> bm vector 2 z)))))
                                                (+ (-> pre vector 3 z)
                                                   (+ (* lcx (-> pre vector 0 z))
                                                      (+ (* lcy (-> pre vector 1 z))
                                                         (* lcz (-> pre vector 2 z)))))))
                                         (b0c (if (> (-> *phys-b0* sc) 0.0)
                                                (-> *phys-b0* sc)
                                                (-> *phys-blen* scl)))
                                         (ee (/ (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez))))
                                                (fmax 1.0 b0c))))
                                    (when (> ee (-> *phys-dg* (+ (* sc PHYS-DG) 19)))
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 19)) ee))
                                    ;; [NOTE-90] 23 = LE MEME MAXIMUM QUE 19, MAIS PAR FENETRE DE PUBLICATION. -> jak-hd-physics-NOTES.md
                                    (when (> ee (-> *phys-dg* (+ (* sc PHYS-DG) 23)))
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 23)) ee)
                                      ;; [NOTE-92] L'ATTRIBUTION DE `comex` A SES TROIS TERMES. -> jak-hd-physics-NOTES.md
                                      (let* ((el (fmax 0.0001 (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez))))))
                                             (ux (/ ex el)) (uy (/ ey el)) (uz (/ ez el))
                                             (a0x (+ (* lcx (-> pre vector 0 x)) (+ (* lcy (-> pre vector 1 x)) (* lcz (-> pre vector 2 x)))))
                                             (a0y (+ (* lcx (-> pre vector 0 y)) (+ (* lcy (-> pre vector 1 y)) (* lcz (-> pre vector 2 y)))))
                                             (a0z (+ (* lcx (-> pre vector 0 z)) (+ (* lcy (-> pre vector 1 z)) (* lcz (-> pre vector 2 z)))))
                                             (c2x (+ (* lcx (-> bm vector 0 x)) (+ (* lcy (-> bm vector 1 x)) (* lcz (-> bm vector 2 x)))))
                                             (c2y (+ (* lcx (-> bm vector 0 y)) (+ (* lcy (-> bm vector 1 y)) (* lcz (-> bm vector 2 y)))))
                                             (c2z (+ (* lcx (-> bm vector 0 z)) (+ (* lcy (-> bm vector 1 z)) (* lcz (-> bm vector 2 z))))))
                                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 31))
                                              (+ (* (- (-> bm vector 3 x) (-> pre vector 3 x)) ux)
                                                 (+ (* (- (-> bm vector 3 y) (-> pre vector 3 y)) uy)
                                                    (* (- (-> bm vector 3 z) (-> pre vector 3 z)) uz))))
                                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 32))
                                              (+ (* (- (-> *phys-c1* 0) a0x) ux)
                                                 (+ (* (- (-> *phys-c1* 1) a0y) uy)
                                                    (* (- (-> *phys-c1* 2) a0z) uz))))
                                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 33))
                                              (+ (* (- c2x (-> *phys-c1* 0)) ux)
                                                 (+ (* (- c2y (-> *phys-c1* 1)) uy)
                                                    (* (- c2z (-> *phys-c1* 2)) uz))))
                                        ;; QUEL MAILLON porte ce maximum. Les deux ecrivent le MEME
                                        ;; emplacement 23, et leurs bras de levier n'ont rien de
                                        ;; comparable (1.08 B0 contre 0.86 B0 pour des os de 1.73 et
                                        ;; 0.23 B0) : sans cette colonne l'attribution ne designe
                                        ;; aucune piece, et le correctif de l'etape 2 non plus.
                                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 34)) (the float l))))
                                    ;; [NOTE-91] UN MAXIMUM NE DIT PAS SI UNE BORNE CLIPERAIT UN EXTREME. -> jak-hd-physics-NOTES.md
                                    (set! (-> *phys-dg* (+ (* sc PHYS-DG) 20))
                                          (+ ee (-> *phys-dg* (+ (* sc PHYS-DG) 20))))
                                    (set! (-> *phys-dg* (+ (* sc PHYS-DG) 21))
                                          (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 21))))
                                    (when (> ee 0.40)
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 22))
                                            (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 22))))))))
                              ;; delta pour les descendants non simules
                              (when (< k PHYS-JOINTS)
                                (matrix-4x4-inverse! inv pre)
                                (matrix*! (-> *phys-dmat* k) inv bm)
                                (set! (-> *phys-dhas* k) 1)))))))
                    ))))))
          ;; ---- propagation aux descendants non simules (verres de lunettes, etc.) ----
          (dotimes (k njoint)
            (when (zero? (-> *phys-dhas* k))
              (let ((p (the int (-> (-> obj khd-par) k))))
                (when (and (!= p 255) (< p PHYS-JOINTS) (nonzero? (-> *phys-dhas* p))
                           (< (+ k 1) nbone))
                  (let ((bm (the-as matrix (-> skel bones (+ k 1) transform))))
                    (matrix*! tmp bm (-> *phys-dmat* p))
                    (matrix-copy! bm tmp)
                    (matrix-copy! (-> *phys-dmat* k) (-> *phys-dmat* p))
                    (set! (-> *phys-dhas* k) 1))))))
          ;; ---- L'INSTANTANE QUE LA FRAME SUIVANTE LIRA -------------------------------------
          ;; Ici, et nulle part ailleurs : toutes les chaines ont ecrit, la propagation aux
          ;; descendants non simules est faite, donc le squelette porte l'etat FINAL de la frame.
          ;; C'est cet etat-la que les 22 chaines liront toutes ensemble la frame prochaine, au
          ;; lieu de lire chacune un etat different selon son rang.
          (phys-snapshot-sim! skel slot nco nbone)))))
  (none))

;; ------------------------------------------------------------------------------------------------
;; les deux prises restantes attendues par le reste du jeu.
;; ------------------------------------------------------------------------------------------------
(defun phys-note-covered! ((n int)) (none))

;; process-drawable.gc:287 appelle ceci sur TOUT process-drawable — y compris les compagnons HD,
;; AVANT fill-jak-hd-bones! (jak-hd.gc:552-553). Le rider stock n'est pas dans le perimetre de
;; cette phase (KEIRA SEULE, via son compagnon HD) : il ne fait rien, et surtout pas sur un
;; compagnon dont la pose n'est pas encore retargetee.
(defun phys-rider-post! ((obj process-drawable)) (none))

;; ------------------------------------------------------------------------------------------------
;; ACCES POUR LA SALLE DE TEST (phys-room.gc). Les accumulateurs vivent ici parce que c'est ici que
;; la position ecrite est connue ; la salle ne fait que fenetrer et publier.
;; ------------------------------------------------------------------------------------------------
(defun phys-stats-reset! ()
  (dotimes (sc PHYS-SC)
    (let ((stb (* sc PHYS-ST)))
      (dotimes (i 6) (set! (-> *phys-st* (+ stb i)) 0.0))
      ;; somme et compte de la position moyenne de la pointe (12..15), pire stimulus recu (16),
      ;; pire allongement relatif (17), stimulus gravitaire (18) et sa part tangentielle (19).
      (dotimes (i 8) (set! (-> *phys-st* (+ stb (+ 12 i))) 0.0))
      ;; le residu signe de penetration est un maximum qui a le droit d'etre negatif
      (set! (-> *phys-st* (+ stb 4)) PHYS-NOCONTACT)
      ;; la boite englobante part vide : un min a 0 la forcerait a contenir l'origine et
      ;; gonflerait l'amplitude mesuree.
      (set! (-> *phys-st* (+ stb 6))   1000000000.0)
      (set! (-> *phys-st* (+ stb 7))  -1000000000.0)
      (set! (-> *phys-st* (+ stb 8))   1000000000.0)
      (set! (-> *phys-st* (+ stb 9))  -1000000000.0)
      (set! (-> *phys-st* (+ stb 10))  1000000000.0)
      (set! (-> *phys-st* (+ stb 11)) -1000000000.0))
    ;; la boite de CHAQUE maillon part vide, comme celle de la pointe.
    (dotimes (l PHYS-LINKS)
      (let ((lb (* (+ (* sc PHYS-LINKS) l) PHYS-LB)))
        (dotimes (i 3)
          (set! (-> *phys-lb* (+ lb (* 2 i)))        1000000000.0)
          (set! (-> *phys-lb* (+ lb (+ (* 2 i) 1))) -1000000000.0)))
      ;; la deviation angulaire propre de CHAQUE maillon part de zero : c'est un maximum, et un
      ;; maillon qui suit rigidement son parent doit pouvoir lire exactement zero.
      (set! (-> *phys-la* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-la0* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-la1* (+ (* sc PHYS-LINKS) l)) 0.0)
      ;; [NOTE-81] les trois miroirs par maillon sont des maximums et un compte DE FENETRE, comme
      ;; leurs equivalents par chaine juste en dessous : meme portee, meme remise a zero.
      (set! (-> *phys-rrml* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-rrrl* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-rrol* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-rrcl* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-rrtl* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-cddl* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-rrsl* (+ (* sc PHYS-LINKS) l)) 0.0))
    ;; SPEC 29/36 — les deux maximums de FENETRE. Ce sont des compteurs de mesure, pas des etats
    ;; du solveur : `*phys-sec*`, `*phys-tw*` et leurs vitesses ne sont PAS remis a zero ici, sans
    ;; quoi chaque fenetre relancerait le mode secondaire et la torsion depuis rien.
    (set! (-> *phys-secm* sc) 0.0)
    (set! (-> *phys-secr* sc) 0.0)
    (set! (-> *phys-dynm* sc) 0.0)
    (set! (-> *phys-prsm* sc) 0.0)
    (set! (-> *phys-prsr* sc) 0.0)
    (set! (-> *phys-cpd* sc) 0.0)
    (dotimes (k 7) (set! (-> *phys-cpi* (+ (* 7 sc) k)) 0.0))
    ;; §23 : maximum de FENETRE, donc remis a zero ici. `*phys-rr*` et `*phys-rq*` — l'etat — ne le
    ;; sont PAS, pour la meme raison que le mode secondaire et la torsion : chaque fenetre
    ;; relancerait sinon l'oscillateur radial depuis rien.
    (set! (-> *phys-rrm* sc) 0.0)
    (set! (-> *phys-rrr* sc) 0.0)
    (set! (-> *phys-twm* sc) 0.0)
    (set! (-> *phys-thas* sc) 0))
  ;; SPEC 33/34 — les compteurs de restitution, par fenetre eux aussi.
  (set! *phys-rstn* 0)
  (set! *phys-twsat* 0)
  (set! *phys-rrsat* 0)
  (set! *phys-rstm* 0)
  (set! *phys-rstin* 0.0)
  (set! *phys-rstout* 0.0)
  (set! *phys-rstsum* 0.0)
  (none))
(defun phys-ang-reset! () (dotimes (i PHYS-SCL) (set! (-> *phys-la* i) 0.0) (set! (-> *phys-la0* i) 0.0) (set! (-> *phys-la1* i) 0.0)) (none))  ;; RESET ETROIT — LES TROIS ETAGES DE L'ANGLE, ET RIEN D'AUTRE. `*phys-la0*`/`*phys-la1*` y sont entres le 2026-08-14 : sans remise a zero par frame ce sont des maximums de COURSE, donc inutilisables pour attribuer a un etage ce qu'une frame retire. Leur seul autre lecteur est `PHYSGRADS`, emis par `physroom-emit-window` (phys-room.gc:583) appelee UNIQUEMENT depuis PHYSROOM-PH-MEAS (phys-room.gc:992), phase 1 — soit AVANT la fenetre de repos (phase 3) qui appelle ce reset : aucune fenetre PHYSGRADS ne le subit. *phys-la* SEUL auparavant. Ce n'est ni un clamp, ni une hysteresis, ni un gel : il ne retire pas un micron de mouvement, il remet a zero un COMPTEUR DE MESURE (le maximum courant de la deviation angulaire propre, accumule en :4046). Il ne touche NI `stat 0` NI `*phys-thas*`, et c'est tout l'interet : la garde de `phys-link-ang` (:4497) reste passante. `phys-stats-reset!` appele a chaque frame la maintiendrait au contraire baissee en permanence — `stat 0` (:4116) n'est ecrit que sous `(nonzero? *phys-thas*)` (:4111) et `thas` ne passe a 1 qu'ensuite (:4156), or le solveur ne passe qu'une fois par frame (jak-hd.gc:564) — et rendrait un mur de ang=0.0. Sur le plafond de lignes : il vise l'empilement de SUPPRESSEURS (ancien moteur : 6000 lignes, 84 clamps, 42 % des mesures a zero) et c'est la COMPOSITION qui decide, jamais le nombre ; la mesure par frame est nommement exigee par le contrat (DIRECTIVES lignes 29-31, `ROOM-RINGDOWN`).

(defun phys-stat ((slot int) (chain int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= which 0) (< which PHYS-ST))
    (-> *phys-st* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-ST) which))
    0.0))

;; la colonne du tableau : le residu signe de la fenetre, ou 0 si aucune frame de la fenetre n'a eu
;; le moindre contact. Le nombre de frames en contact est publie a part (phys-auth which=7).
(defun phys-pen-col ((slot int) (chain int))
  (let ((v (phys-stat slot chain 4)))
    (if (< v PHYS-NOCONTACT-LIMIT) 0.0 v)))

;; AMPLITUDE de mouvement de la pointe due a la PHYSIQUE seule, sur la fenetre : la diagonale de la
;; boite englobante de l'ecart. Zero si la fenetre n'a pas de frame.
(defun phys-tip-amp ((slot int) (chain int))
  (if (< (phys-stat slot chain 0) 0.5)
    0.0
    (let ((dx (- (phys-stat slot chain 7) (phys-stat slot chain 6)))
          (dy (- (phys-stat slot chain 9) (phys-stat slot chain 8)))
          (dz (- (phys-stat slot chain 11) (phys-stat slot chain 10))))
      (if (or (< dx 0.0) (< dy 0.0) (< dz 0.0))
        0.0
        (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))))

;; POSITION MOYENNE de la pointe sur la fenetre, dans le repere de l'ancre, axe par axe (0=x 1=y
;; 2=z). C'est le DEPLACEMENT SOUTENU dont la salle fait ROOM-GRAVSAG : la difference entre la
;; moyenne debout et la moyenne penchee a 60 degres EST la reponse a la gravite. Zero si la fenetre
;; n'a pas de frame — jamais une valeur inventee.
(defun phys-tip-mean ((slot int) (chain int) (axis int))
  (let ((n (phys-stat slot chain 15)))
    (if (or (< n 0.5) (< axis 0) (> axis 2))
      0.0
      (/ (phys-stat slot chain (+ 12 axis)) n))))

;; LE STIMULUS QUE LA POINTE A REELLEMENT RECU sur la fenetre, en u/frame^2 : le pire module de
;; l'acceleration de sa pose d'auteur. C'est le denominateur honnete du gain — celui que la salle
;; COMMANDE ne vaut que si rien d'autre ne le domine, et c'est ce chiffre-la qui le dit.
(defun phys-tip-stim ((slot int) (chain int))
  (phys-stat slot chain 16))

;; AMPLITUDE DE MOUVEMENT D'UN MAILLON DONNE, meme instrument que `phys-tip-amp` mais pris sur le
;; maillon `link` au lieu de la pointe. C'est la suite que SPEC 2 exige croissante de la racine vers
;; la pointe, et la seule mesure capable de voir « le milieu part en vrille et la pointe ne bouge
;; pas » — que `tipvar`, qui ne regarde que la pointe, rendait indistinguable d'une chaine saine.
(defun phys-link-amp ((slot int) (chain int) (link int))
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (let* ((lb (* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link) PHYS-LB))
           (dx (- (-> *phys-lb* (+ lb 1)) (-> *phys-lb* (+ lb 0))))
           (dy (- (-> *phys-lb* (+ lb 3)) (-> *phys-lb* (+ lb 2))))
           (dz (- (-> *phys-lb* (+ lb 5)) (-> *phys-lb* (+ lb 4)))))
      (if (or (< dx 0.0) (< dy 0.0) (< dz 0.0))
        0.0
        (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))))

;; LE MOUVEMENT PROPRE D'UN MAILLON, en DEGRES : sa deviation angulaire par rapport a SON ATTACHE.
;; 10e passe de l'owner : « le milieu est plus hysterique (bouge beaucoup plus) que les pointes,
;; c'est pas cense ! » — pendant que `phys-link-amp` publiait une suite croissante. Les deux ne
;; mesurent pas la meme chose : `phys-link-amp` est un ecart a la pose d'auteur, donc il CUMULE le
;; long de la chaine et une pointe soudee a son parent y affiche le chiffre de son parent. Celle-ci
;; est relative au parent par construction et vaut zero pour un maillon qui ne bouge pas tout seul.
;; Les deux sont publiees cote a cote : leur ecart EST la mesure de l'erreur de l'ancienne.
(defun phys-link-ang ((slot int) (chain int) (link int))
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (-> *phys-la* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link))))

(defun phys-link-ang-stage ((slot int) (chain int) (link int) (stage int))
  "Le meme angle qu'au-dessus, releve a un ETAGE du solveur : 0 = apres l'integration seule,
   1 = apres contraintes + attenuation. La valeur finale reste `phys-link-ang`."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (let ((i (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link)))
      (if (zero? stage) (-> *phys-la0* i) (-> *phys-la1* i)))))

(defun phys-link-dev ((slot int) (chain int) (link int) (axis int))
  "UNE composante de la deviation SIGNEE de ce maillon (voir la note de `*phys-lsv*`).
   axis 0/1/2 = x/y/z, repere MONDE, instantanee, nulle a la pose du modele."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS) (< axis 0) (> axis 2)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (-> *phys-lsv* (+ (* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link) 3) axis))))

(defun phys-link-dev-anc ((slot int) (chain int) (link int) (axis int))
  "LA MEME DEVIATION QUE `phys-link-dev`, DANS LE TRIEDRE DE L'ANCRE (voir `*phys-lda*`).
   axis 0/1/2 = vertical / avant-arriere / lateral — l'ordre de SPEC 24, pas celui des lignes de la
   matrice. REPERE : le triedre de l'ANCRE, que SPEC 7 impose ; le repere monde ne peut pas separer
   les trois axes de SPEC 24. Instantanee, nulle a la pose du modele. Rend 0.0 sur une chaine que le
   solveur n'a pas classee — l'outil de lecture le declare, il ne le comble pas."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS) (< axis 0) (> axis 2)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (-> *phys-lda* (+ (* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link) 3) axis))))

(defun phys-dfm-anc ((slot int) (chain int) (i int) (j int))
  "SPEC 8/10-13/23/38 — L'ELEMENT (i,j) DE LA DEFORMATION EN ESPACE ANCRE, telle que le solveur
   l'applique : `dfa` (equilibre d'orientation) x `dfb` (etirement dynamique) x `dfc` (pression de
   contact). NATURE : une matrice sans dimension, rapport a la forme d'auteur ; l'identite quand
   rien ne deforme. REPERE : la base de l'ANCRE, la meme que `phys-link-dev-anc-abs` — donc un
   deplacement de peau se compose directement avec un ecart de joint, ce qui etait impossible tant
   que seule la version conjuguee en monde existait. LECTURE HORS DEFAUT : diag(1,1,1).
   CE QUE CE N'EST PAS : la deformation VUE sur le mesh. C'est ce que le solveur COMMANDE ; la peau
   n'en recoit qu'une part graduee en r^1.63 (SPEC 31)."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< i 0) (> i 2) (< j 0) (> j 2))
    0.0
    (-> *phys-dfa* (+ (* slot PHYS-CHAINS) chain) vector i data j)))

(defun phys-link-rest-dir ((slot int) (chain int) (link int) (axis int))
  "L'AXE D'OS AU REPOS, PAR MAILLON, TEL QUE LE SOLVEUR L'A RELEVE — `*phys-ux*/uy/uz`, releve une
   fois a la meme frame que `g_ref`. Il existait dans le moteur et n'etait publie nulle part, si
   bien que le tableau l'AJUSTAIT par ACP sur la dispersion de neuf deplacements : ajustement
   declare « NON PLAN — le reste du bloc est invalide » sur les deux chaines, et pourtant consomme
   par SPEC 10/11/12 et par l'anisotropie de SPEC 29. NATURE : un vecteur UNITAIRE, sans dimension.
   REPERE : la base de l'ANCRE, ordre (x, y, z) de ses lignes. LECTURE HORS DEFAUT : rend 0.0 tant
   que la direction de repos n'est pas relevee (`*phys-ucap*` = 0), ce qui se distingue d'un axe
   nul."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS) (< axis 0) (> axis 2))
    0.0
    (let ((scl (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link)))
      (if (zero? (-> *phys-ucap* scl))
        0.0
        (cond ((= axis 0) (-> *phys-ux* scl))
              ((= axis 1) (-> *phys-uy* scl))
              (else       (-> *phys-uz* scl)))))))

(defun phys-link-dev-anc-abs ((slot int) (chain int) (link int) (axis int))
  "LA MEME DEVIATION QUE `phys-link-dev-anc`, MAIS NON NORMALISEE (voir la note de `*phys-ldb*`).
   `phys-link-dev-anc` projette une difference de vecteurs UNITAIRES : sa composante radiale est
   nulle par construction, et la PCA des fenetres d'impulsion du cycle 8 le montre (serie plane a
   1 %, direction nulle a 92 % verticale). Celle-ci porte les TROIS degres de liberte, en unites de
   jeu. Meme triedre d'ancre, meme ordre (v, ap, lat), meme instant, meme garde de classification —
   l'ecart entre les deux series EST la mesure de l'aveuglement, pas une seconde opinion."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS) (< axis 0) (> axis 2)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (-> *phys-ldb* (+ (* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link) 3) axis))))

(defun phys-chain-axis ((slot int) (chain int) (which int))
  "LA CLASSIFICATION DU TRIEDRE, TELLE QUE LE SOLVEUR L'A FAITE — pour que la salle la publie et
   qu'elle soit RELISIBLE dans la trace au lieu d'etre supposee.
   which 0 = classee (0/1), 1/2/3 = index de ligne vertical / avant-arriere / lateral,
   4 = raideur par axe ARMEE (0/1) — voir la note de `*phys-axan*` : classee et armee ne sont pas
   la meme chose, et c'est precisement l'ecart entre les deux qu'il faut pouvoir lire."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS))
    -1
    (let ((sc (+ (* slot PHYS-CHAINS) chain)))
      (cond ((= which 0) (-> *phys-axok* sc))
            ((= which 1) (-> *phys-axv* sc))
            ((= which 2) (-> *phys-axa* sc))
            ((= which 3) (-> *phys-axl* sc))
            ((= which 4) (-> *phys-axan* sc))
            ;; 5 = QUELLE REGLE A NOMME LES AXES (0 = protrusion propre, faute de partenaire ;
            ;; 1 = segment inter-seins, l'invariant externe). Sans ce champ, une course ne dirait
            ;; pas si le verdict vient de l'anatomie ou du repli.
            ((= which 5) (-> *phys-axsrc* sc))
            (else -1)))))

(defun phys-chain-radial ((slot int) (chain int) (which int))
  "SPEC 23 — LE TROISIEME DEGRE DE LIBERTE, LU A L'EXECUTION. Voir la note de `*phys-rr*`.
   which 0 = elongation radiale du MAILLON RACINE en unites de jeu (signee) — le distal se lit par
             `phys-chain-radial-link` ;
         1 = la meme, rapportee a B0 (SPEC 6) — c'est la grandeur que borne sa SPEC 22
             (« local tissue elongation: common 5-15 %, large 15-21 %, exceptional 21-25 % ») ;
         2 = son maximum absolu sur la fenetre, SUR TOUS LES MAILLONS ARMES (cycle 32) ;
         3 = LE MEME MAXIMUM, MAIS AVANT LA BORNE §22 — sans lui, un canal colle a sa borne est
             indiscernable d'un canal qui l'effleure, et c'est exactement la confusion qui a laisse
             passer un plafond de deformation atteint sur les dix fenetres ;
         4 = le nombre de frames ou la borne §22 a mordu (compteur global, rendu en float).
   NATURE : une DEFORMATION signee (sans unite pour 1 et 2), pas une amplitude agregee : c'est une
   serie temporelle, et c'est ce qui permet d'en ajuster la frequence propre.
   REPERE : l'axe de l'OS, dans le triedre de l'ANCRE (SPEC 7) — le degre de liberte que la
   projection de longueur confisquait, a 84.5 % l'axe VERTICAL de sa SPEC 24.
   LIGNE DE BASE : 0.0 exactement a la pose debout d'auteur (SPEC 9) — un tissu au repos ne
   s'allonge pas, donc un zero ici n'est pas un trou de mesure, c'est l'etat neutre."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< which 0) (> which 4))
    0.0
    (let* ((sc (+ (* slot PHYS-CHAINS) chain))
           (b0 (fmax 1.0 (-> *phys-b0* sc))))
      (cond ((= which 0) (-> *phys-rr* sc))
            ((= which 1) (/ (-> *phys-rr* sc) b0))
            ((= which 2) (-> *phys-rrm* sc))
            ((= which 3) (-> *phys-rrr* sc))
            (else        (the float *phys-rrsat*))))))

(defun phys-chain-radial-link ((slot int) (chain int) (link int) (which int))
  "SPEC 23 — l'elongation radiale du MAILLON `link`. which 0 = unites de jeu · 1 = rapportee a B0 ·
   2 = maximum de FENETRE apres la borne de §22 · 3 = le meme AVANT la borne · 4 = frames ou la
   borne a mordu SUR CE MAILLON · 5 = (ml-bl)/B0 et 6 = dot(cp-px,m^)/B0, les DEUX TERMES de `dr0`
   releves a l'ARGMAX de 3, somme = 3 au signe pres ([NOTE-82]) · 7 = dot(cp-tg,m^)/B0 et
   8 = |cp-tg|/B0, MEME frame : 6 se scinde en 7 + dot(tg-px,m^)/B0, et |7| <= 8 est un controle
   d'integrite non tautologique ([NOTE-84]).
   Version RESOLUE PAR MAILLON de `phys-chain-radial`, qui ne rend que la RACINE. C'est aussi l'etat
   que le solveur lit. NATURE deformation signee · REPERE axe de l'os dans le triedre de l'ANCRE
   (SPEC 7) · LIGNE DE BASE 0.0 a la pose d'auteur (SPEC 9). [NOTE-79] -> jak-hd-physics-NOTES.md"
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS) (< which 0) (> which 8))
    0.0
    (let* ((sc  (+ (* slot PHYS-CHAINS) chain))
           (b0  (fmax 1.0 (-> *phys-b0* sc)))
           (scl (+ (* sc PHYS-LINKS) link))
           (v   (-> *phys-rrl* scl)))
      (cond ((= which 0) v)
            ((= which 1) (/ v b0))
            ((= which 2) (-> *phys-rrml* scl))
            ((= which 3) (-> *phys-rrrl* scl))
            ((= which 4) (-> *phys-rrsl* scl))
            ((= which 5) (-> *phys-rrol* scl))
            ((= which 6) (-> *phys-rrcl* scl))
            ((= which 7) (-> *phys-rrtl* scl))
            (else        (-> *phys-cddl* scl))))))

(defun phys-chain-axsep ((slot int) (chain int) (which int))
  "LES DEUX PROJECTIONS QUE LA DECISION DE NOMMAGE A COMPARE, et la norme du segment inter-seins.
   which 0 = projection sur la premiere ligne candidate, 1 = sur la seconde, 2 = |separation|.
   REPERE : le triedre de l'ANCRE (SPEC 7). NATURE : une longueur signee, en unites de jeu.
   LIGNE DE BASE : 0 quand il n'y a pas de chaine partenaire — et `phys-chain-axis … 5` le dit."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< which 0) (> which 2))
    0.0
    (-> *phys-axsep* (+ (* (+ (* slot PHYS-CHAINS) chain) 3) which))))

(defun phys-chain-axis-stiff ((slot int) (chain int) (which int))
  "LE FACTEUR DE RAIDEUR EFFECTIVEMENT APPLIQUE sur l'axe `which` (0 = vertical, 1 = avant-arriere,
   2 = lateral), c'est-a-dire `1/mobilite` de SPEC 29. Publie pour que le rapport cite ce que le
   solveur a fait, pas ce que la constante dit."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< which 0) (> which 2))
    0.0
    (let* ((sc  (+ (* slot PHYS-CHAINS) chain))
           (row (cond ((= which 0) (-> *phys-axv* sc))
                      ((= which 1) (-> *phys-axa* sc))
                      (else        (-> *phys-axl* sc)))))
      (if (and (>= row 0) (< row 3)) (-> *phys-axs* (+ (* sc 3) row)) 0.0))))

(defun phys-slot-chains ((slot int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS)) (-> *phys-slot-nch* slot) 0))

(defun phys-chain-links ((slot int) (chain int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-nlink* (+ (* slot PHYS-CHAINS) chain))
    0))

(defun phys-chain-family ((slot int) (chain int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-fam* (+ (* slot PHYS-CHAINS) chain))
    0))

;; SPEC 4, l'exception : `hang` > 0 = « ce qui doit pendre » (les lunettes), qui ne retourne PAS a
;; la pose du modele. La salle s'en sert pour compter ces chaines a part au repos, au lieu de
;; devenir complice d'un ecart residuel qu'elle ne saurait pas expliquer.
(defun phys-chain-hang ((slot int) (chain int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-hang* (+ (* slot PHYS-CHAINS) chain))
    0.0))

(defun phys-chain-joint ((slot int) (chain int) (link int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= link 0) (< link PHYS-LINKS))
    (-> *phys-joint* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link))
    -1))

;; la longueur que LE MODELE donne a l'os d'un lien (son attache est l'ancre pour le lien 0). C'est
;; le plafond geometrique de l'amplitude de ce lien : la salle le publie pour que personne n'ait a
;; deviner si une chaine « ne bouge pas assez » ou « ne peut pas bouger plus ».
(defun phys-chain-bone ((obj jak-hd) (slot int) (chain int) (link int))
  (let ((r 0.0))
    (when (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
               (>= link 0) (< link PHYS-LINKS)
               (nonzero? (-> obj draw)) (nonzero? (-> obj draw skeleton)))
      (let* ((skel (-> obj draw skeleton))
             (nbone (-> skel length))
             (sc  (+ (* slot PHYS-CHAINS) chain))
             (scl (+ (* sc PHYS-LINKS) link))
             (kk  (-> *phys-joint* scl))
             (kp  (if (> link 0) (-> *phys-joint* (- scl 1)) (-> *phys-anchor* sc))))
        (when (and (< link (-> *phys-nlink* sc)) (>= kk 0) (>= kp 0)
                   (< (+ kk 1) nbone) (< (+ kp 1) nbone))
          (set! r (vector-vector-distance
                    (the-as vector (-> skel bones (+ kk 1) transform vector 3))
                    (the-as vector (-> skel bones (+ kp 1) transform vector 3)))))))
    r))

(defun phys-inject-set! ((v float))
  (set! *phys-inject* v)
  (none))

(defun phys-inject-count () *phys-injn*)

(defun phys-tan-count () *phys-tan-n*)

(defun phys-tan-depth () *phys-tan-d*)

(defun phys-tan-eff () *phys-tan-e*)

(defun phys-tan-reset! ()
  (set! *phys-tan-n* 0)
  (set! *phys-tan-d* 0.0)
  (set! *phys-tan-e* 0.0)
  (none))

(defun phys-inject-count-reset! ()
  (set! *phys-injn* 0)
  (none))

;; CONTROLE POSITIF DU CANAL D'AUTEUR : 1 = l'animation est retardee d'une frame dans la position
;; ecrite. Le compteur d'identite doit s'effondrer ; s'il ne bouge pas, il ne mesure rien.
(defun phys-auth-lag-set! ((v int))
  (set! *phys-auth-lag* v)
  (none))

;; CE QUE LES LIMITEURS ONT RETIRE, en unites de jeu (SPEC 7 : un suppresseur se chiffre).
;; 11/12 = le MUR du point libre de §21/§22 (identite stricte sous 0.336 B0, donc un zero ici veut
;; dire que le tissu n'est jamais sorti de sa bande, pas que le mecanisme est absent).
;; which 0 = recul vers la pose du modele : nombre de fois / total retire
;;       2 = plafond de taille d'un lien seul : nombre de fois / total retire
(defun phys-limiter ((which int))
  (case which
    ((2) (the float *phys-raddrop-n*))
    ((3) *phys-raddrop-sum*)
    ;; SPEC 21/22 : 6 = sous-pas integres avec le RESSORT QUI RAIDIT actif (pas un suppresseur, il
    ;; ne retire rien) ; 9 = fois ou le FILET positionnel a mordu, 10 = ce que LUI a retire (unites).
    ((6) (the float *phys-stif-n*))
    ((9) (the float *phys-sat-n*))
    ((10) *phys-sat-sum*)
    ;; 11/12 = LE MUR DU POINT LIBRE de §21/§22 : fois ou il a mordu, et ce qu'il a retire.
    ((11) (the float *phys-cwn*))
    ((12) *phys-cwsum*)
    (else (the float *phys-buried-n*))))

;; INVERSIONS (SPEC 5 / verdict owner) : which 0 = bascules corrigees, 1 = cas degeneres rattrapes.
(defun phys-inversions ((which int))
  (case which
    ((0) (the float *phys-invn*))
    ((1) (the float *phys-invfix*))
    ((2) (the float *phys-reseat-n*))
    ;; 4 = re-assises retombees sur l'ancienne heuristique. Doit valoir ZERO.
    ((4) (the float *phys-reseat-fb*))
    (else (the float *phys-invres*))))

(defun phys-inv-inject-set! ((v int))
  (set! *phys-inv-inject* v)
  (none))

;; ------------------------------------------------------------------------------------------------
;; DIAGNOSTIC PAR CHAINE — les quatre defauts de la 6e passe se lisent ici, chaine par chaine.
;; which : 0 selfcol  1 retreat  2 flip  3 inv  4 invres  5 elong (allongement relatif max)
;; ------------------------------------------------------------------------------------------------
(defun phys-diag ((slot int) (chain int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= which 0) (< which PHYS-DG))
    (-> *phys-dg* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-DG) which))
    0.0))

(defun phys-comexw-reset! ()
  "REMET A ZERO LE SEUL EMPLACEMENT 23 — le maximum de `comex` de LA FENETRE COURANTE — sur toutes
   les chaines. Les emplacements 19 (maximum de COURSE) et 20/21/22 (la distribution cumulee) ne
   sont PAS touches : ils portent des grandeurs de portee differente, deja publiees, et les
   confondre rendrait le maximum de course egal a celui de la derniere fenetre."
  (dotimes (i PHYS-SC)
    (set! (-> *phys-dg* (+ (* i PHYS-DG) 23)) 0.0)
    ;; 24/25/26/27 = `rgap` max, `rgap` somme, `perr` max, nombre d'echantillons — MEME PORTEE
    ;; (chaine, animation, pilotage), donc meme remise a zero. Les mettre ailleurs ferait publier
    ;; a chaque fenetre le maximum de la course, exactement le defaut que 19 vs 23 evite deja.
    (set! (-> *phys-dg* (+ (* i PHYS-DG) 24)) 0.0)
    (set! (-> *phys-dg* (+ (* i PHYS-DG) 25)) 0.0)
    (set! (-> *phys-dg* (+ (* i PHYS-DG) 26)) 0.0)
    (set! (-> *phys-dg* (+ (* i PHYS-DG) 27)) 0.0)
    (set! (-> *phys-dg* (+ (* i PHYS-DG) 28)) 0.0)
    ;; 29/30 = SPEC 37 : frames rebasees, et |delta ancre| max. MEME PORTEE (chaine, animation,
    ;; pilotage) : un compte de rebases valable pour la course entiere ne dirait pas QUELLE fenetre
    ;; porte la discontinuite, et c'est precisement la question.
    (set! (-> *phys-dg* (+ (* i PHYS-DG) 29)) 0.0)
    (set! (-> *phys-dg* (+ (* i PHYS-DG) 30)) 0.0)
    ;; 31/32/33 = l'attribution de `comex`, RELEVEE A L'ARGMAX DE 23. Meme portee que 23, donc
    ;; meme remise a zero : les garder plus longtemps ferait publier trois termes releves dans une
    ;; fenetre et un maximum releve dans une autre — exactement le defaut `RAD-FLESH-IPAIR`.
    (set! (-> *phys-dg* (+ (* i PHYS-DG) 31)) 0.0)
    (set! (-> *phys-dg* (+ (* i PHYS-DG) 32)) 0.0)
    (set! (-> *phys-dg* (+ (* i PHYS-DG) 33)) 0.0)
    (set! (-> *phys-dg* (+ (* i PHYS-DG) 34)) 0.0))
  (none))

(defun phys-diag-reset! ()
  (dotimes (i (* PHYS-SC PHYS-DG)) (set! (-> *phys-dg* i) 0.0))
  ;; l'etat de contrainte de la frame precedente est oublie aussi : sinon la premiere frame de la
  ;; fenetre suivante compterait une bascule qui n'a pas eu lieu dans cette fenetre.
  (dotimes (i PHYS-SCL) (set! (-> *phys-flhas* i) 0))
  ;; [NOTE-109] le cumul par branche vit le meme cycle que le reste du diagnostic : c'est ce qui
  ;; rend les deux jambes d'un controle comparables sans qu'aucune ne herite de l'autre.
  (dotimes (i (* 3 PHYS-SC)) (set! (-> *phys-cpc* i) 0.0))
  (none))

;; CONTROLE POSITIF DE L'AUTO-COLLISION : 1 = l'exclusion chaine <-> ses propres volumes est LEVEE.
;; Le compteur `selfcol` doit alors monter. Un zero structurel que rien ne peut faire monter ne
;; prouve rien — c'est la regle « tout zero exige un controle positif qui a tire ».
(defun phys-cpc ((slot int) (chain int) (which int))
  "LE CUMUL DE POUSSEES DE CONTACT DEPUIS LA DERNIERE REMISE A ZERO DE DIAGNOSTIC.
   0 = NOMBRE de poussees (un compte, sans unite) ; 1 = somme de leurs MODULES (unites de jeu,
   4096 = 1 m) ; 2 = la meme somme restreinte aux balayages 34 a 45, c'est-a-dire au groupe de
   COLLISION SEULE (sans contrainte de longueur pour ramener le lien en arriere).
   NATURE : un compte et deux longueurs, AGREGES sur toutes les frames de la jambe — pas des maxima
   de fenetre. REPERE : le monde. LECTURE QUAND RIEN NE TOUCHE : les trois a zero, et le 0 sert de
   DOMAINE aux deux autres."
  (let ((sc (+ (* slot PHYS-CHAINS) chain)))
    (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
            (< which 0) (>= which 3))
      0.0
      (-> *phys-cpc* (+ (* 3 sc) which)))))

(defun phys-prox-off-set! ((v int))
  "ABLATION DE MESURE, 0 EN LIVRAISON : 1 retire les SPHERES PROXIMALES de la liste des obstacles.
   Le cycle 35 a mesure qu'elles ne couvrent aucun sommet que la sphere distale ne couvre deja ;
   cet interrupteur repond a la question a l'execution, sans toucher aux rayons — qui sont une
   SURCHARGE DE L'OWNER que la gate TUNING protege."
  (set! *phys-prox-off* v)
  (none))

(defun phys-self-inject-set! ((v int))
  (set! *phys-self-inject* v)
  (none))

(defun phys-side-off-set! ((v int))
  (set! *phys-side-off* v)
  (none))

;; CONTROLE DU CYCLE 8 : 1 = la contrainte de longueur est DESARMEE. Voir la note de
;; `*phys-len-off*`. La salle l'arme sur les trois fenetres AXZ et le REND A 0 juste apres — un
;; controle qui resterait arme changerait toutes les mesures suivantes.
(defun phys-len-off-set! ((v int))
  (set! *phys-len-off* v)
  (none))

;; `phys-jacobi-off-set!` et `phys-prio-off-set!` retirees : ZERO site d'appel dans tout `goal_src`,
;; leurs interrupteurs restaient donc a leur valeur livree (1 et 1, la priorite de volume que le
;; superviseur a retiree sur mesure). Pas un controle perdu — il etait deja injoignable.
(defun phys-prio-meas-set! ((v int))
  "1 = la passe de selection tourne POUR COMPTER, sans jamais ecarter un volume. C'est ce qui rend
   `ROOM-VOLPRIO` non vide pendant que la priorite reste desarmee. Le controle de cette mesure est
   son propre desarmement : a 0, la passe ne tourne pas et les trois compteurs doivent retomber a
   zero exactement — un compteur qui resterait non nul mesurerait autre chose que cette passe."
  (set! *phys-prio-meas* v)
  (none))

(defun phys-col-off-set! ((v int))
  "1 = le MUR DE COLLISION est desarme (voir [NOTE-53]). La salle l'arme sur la passe k=4 du
   balayage d'orientation et le REND A 0 en sortant."
  (set! *phys-col-off* v)
  (none))

(defun phys-rr-off-set! ((v int))
  "1 = la borne §22 du canal RADIAL est desarmee (`rcap` -> +inf), sur la fenetre d'orientation
   seule. La salle l'arme sur la passe k=5 du balayage et le REND A 0 en sortant. Arme, le canal
   radial doit REMONTER vers son brut `rrr` (jusqu'a 0.6843 B0 mesures contre 0.3900 bornes) : si
   le pole medial de sa §12 remonte avec lui, l'ecretage est le mecanisme ; s'il ne bouge pas, la
   borne est exoneree et la cause est ailleurs dans la confiscation de longueur."
  (set! *phys-rr-off* v)
  (none))

(defun phys-cone-off-set! ((v int))
  "1 = le rayon redevient interpole sur le parametre de PROJECTION, c'est-a-dire le predicat faux
   d'avant. La penetration residuelle mesuree contre les 24 capsules — toutes coniques — doit alors
   REMONTER : desarme, le moteur teste le solide que la donnee designe ; arme, il teste un ensemble
   plus PETIT, donc il laisse entrer ce qu'il devrait refuser."
  (set! *phys-cone-off* v)
  (none))

(defun phys-prio ((which int))
  "0 = paires (lien, volume) ecartees par la priorite ; 1 = liens contraints par plus d'un volume.
   NATURE : un COMPTE d'evenements sur la fenetre, pas une amplitude. REPERE : sans objet.
   LECTURE QUAND LE DEFAUT EST ABSENT : 0 pour les deux — aucun lien n'est en conflit."
  (the float (cond ((= which 0) *phys-prio-n*) (else *phys-prio-multi*))))

(defun phys-prio-reset! ()
  (set! *phys-prio-n* 0)
  (set! *phys-prio-multi* 0)
  (none))

(defun phys-inversions-reset! ()
  (set! *phys-invn* 0)
  (set! *phys-invres* 0)
  (set! *phys-invfix* 0)
  (none))

;; le collider resolu numero ci : son joint, son second joint (-1 = sphere), ses deux rayons. Publie
;; par la salle pour que le tableau puisse dire QUELLES PARTIES DU CORPS sont couvertes — un zero de
;; penetration contre un ensemble qui ne couvre pas le corps ne prouve rien.
(defun phys-collider-field ((slot int) (ci int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= ci 0) (< ci (-> *phys-slot-nco* slot)))
    (let ((sco (+ (* slot PHYS-COLS) ci)))
      (case which
        ((0) (-> *phys-cj* sco))
        (else (-> *phys-cj2* sco))))
    -1))

(defun phys-slot-colliders ((slot int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS)) (-> *phys-slot-nco* slot) 0))

;; COMBIEN DE FOIS LE VOLUME `ci` A CONTRAINT LE MAILLON `link` DE `chain` — le compte est
;; desormais PAR MAILLON, plus par chaine : c'est la dimension qui manquait pour dire LEQUEL viole.
(defun phys-chain-vol ((slot int) (chain int) (link int) (ci int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= link 0) (< link PHYS-LINKS) (>= ci 0) (< ci PHYS-COLS))
    (-> *phys-cvh* (+ (* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link) PHYS-COLS) ci))
    0))

;; COMBIEN DE FOIS LE VOLUME `ci` S'EST DISPUTE UN LIEN DE `chain` AVEC UN AUTRE VOLUME.
(defun phys-chain-conf ((slot int) (chain int) (ci int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= ci 0) (< ci PHYS-COLS))
    (-> *phys-cfh* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-COLS) ci))
    0))

;; LA DIRECTION MONDE DE L'AXE `axis` DU SOLVEUR : 0 = vertical, 1 = avant-arriere, 2 = lateral —
;; les ROLES de SPEC 7, pas les lignes de la matrice. La traduction role -> ligne se fait ici, par
;; `*phys-axv*` / `*phys-axa*` / `*phys-axl*`, exactement comme le solveur la fait pour la raideur.
;; NATURE : composante d'un vecteur unitaire. REPERE : monde.
;; REND 0.0 TANT QUE LA CHAINE N'EST PAS CLASSEE (`axok` = 0) — l'appelant doit le voir, sinon une
;; impulsion nulle passerait pour une impulsion sans reponse. C'est pour ca que la salle publie la
;; direction qu'elle a REELLEMENT utilisee au lieu de la supposer.
(defun phys-axis-world ((slot int) (chain int) (axis int) (comp int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= axis 0) (< axis 3) (>= comp 0) (< comp 3))
    (let ((sc (+ (* slot PHYS-CHAINS) chain)))
      (if (zero? (-> *phys-axok* sc))
        0.0
        (let ((row (cond ((zero? axis) (-> *phys-axv* sc))
                         ((= axis 1)   (-> *phys-axa* sc))
                         (else         (-> *phys-axl* sc)))))
          (-> *phys-axw* (+ (* sc 9) (+ (* row 3) comp))))))
    0.0))

;; [NOTE-51] LE TRIEDRE DE SPEC 7 ET POURQUOI IL LUI FALLAIT UN ACCESSEUR -> jak-hd-physics-NOTES.md
(defun phys-tri-world ((slot int) (chain int) (axis int) (comp int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= axis 0) (< axis 3) (>= comp 0) (< comp 3))
    (let ((sc (+ (* slot PHYS-CHAINS) chain)))
      (if (zero? (-> *phys-fok* sc))
        0.0
        (let ((v (cond ((zero? axis) (-> *phys-fx* sc))
                       ((= axis 1)   (-> *phys-fy* sc))
                       (else         (-> *phys-fz* sc)))))
          (cond ((zero? comp) (-> v x)) ((= comp 1) (-> v y)) (else (-> v z))))))
    0.0))

;; [NOTE-104] SPEC 33 — LE DOMAINE DE LA PAIRE (chaine, volume), pas son compte de contact -> jak-hd-physics-NOTES.md
(defun phys-chain-vol-dom ((slot int) (chain int) (ci int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= ci 0) (< ci PHYS-COLS))
    (let ((h (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-COLS) ci)))
      (cond
        ((= which 0) (-> *phys-cdm* h))
        ((= which 1) (-> *phys-cfl* h))
        (else (the float (-> *phys-cdmok* h)))))
    0.0))

(defun phys-limiter-reset! ()
  (set! *phys-raddrop-n* 0)
  (set! *phys-raddrop-sum* 0.0)
  (set! *phys-buried-n* 0)
  (set! *phys-sat-n* 0)
  (set! *phys-sat-sum* 0.0)
  (set! *phys-stif-n* 0)
  (set! *phys-cwn* 0)
  (set! *phys-cwsum* 0.0)
  (dotimes (i (* PHYS-SCL PHYS-COLS)) (set! (-> *phys-cvh* i) 0))
  (dotimes (i (* PHYS-SC PHYS-COLS)) (set! (-> *phys-cfh* i) 0))
  (none))

;; SPEC 5. which 0 = frames ou l'anim pilotait cette chaine, 1 = celles ou la pose ecrite est partie
;; du meme cote, 2/3 = somme(ecrit . auteur) et somme(auteur . auteur), dont le rapport est la
;; TRANSMISSION. Ces quatre-la survivent aux fenetres : c'est le bilan de la course.
(defun phys-auth ((slot int) (chain int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (let ((sc (+ (* slot PHYS-CHAINS) chain)))
      (case which
        ((0) (-> *phys-ahit* sc))
        ((1) (-> *phys-aok* sc))
        ((2) (-> *phys-adot* sc))
        ((3) (-> *phys-anrm* sc))
        ((4) (-> *phys-dsum* sc))
        ((5) (-> *phys-usum* sc))
        ((6) (-> *phys-tmov* sc))
        (else (-> *phys-conf* sc))))
    0.0))

(defun phys-auth-reset! ()
  (dotimes (sc PHYS-SC)
    (set! (-> *phys-ahit* sc) 0.0)
    (set! (-> *phys-aok* sc) 0.0)
    (set! (-> *phys-adot* sc) 0.0)
    (set! (-> *phys-anrm* sc) 0.0)
    (set! (-> *phys-dsum* sc) 0.0)
    (set! (-> *phys-usum* sc) 0.0)
    (set! (-> *phys-tmov* sc) 0.0)
    (set! (-> *phys-conf* sc) 0.0)
    (set! (-> *phys-rhas* sc) 0))
  (none))

;; le slot de simulation d'un compagnon, pour que la salle sache ou lire ses chiffres.
(defun phys-shape ((slot int) (chain int) (which int))
  "SPEC 8/10-13/29/36 — L'ETAT DE FORME ET DE TORSION, LU SUR LE MECANISME ARME.
   NATURE : `which` 0/1/2 = les trois ECHELLES appliquees (lateral, vertical, projection), sans
   dimension, rapport a la forme d'auteur ; 3 = leur determinant (le volume de sa §8) ; 4 = la
   modulation courante du mode secondaire de §36 (fraction d'epaisseur) ; 5 = son maximum sur la
   FENETRE ; 6 = la torsion RELATIVE ecrite dans la 3x3 (radians) ; 7 = son maximum sur la fenetre ;
   8 = 1.0 si le canal est ARME sur cette chaine, 0.0 sinon ; 9/10/11 = la direction de la GRAVITE
   vue par le solveur dans ce meme triedre (l'ENTREE de §10-13, unitaire, (0,-1,0) debout) ;
   12 = le maximum de fenetre du mode secondaire AVANT le plafond de §38 (c'est lui qui dit si le
   `0.0700` publie est une saturation ou une valeur) ; 13 = le maximum de fenetre de l'etirement
   dynamique de §22/38 ; 18 = le nombre de frames ou la saturation douce de la torsion a mordu ;
   19 = l'aplatissement de PRESSION DE CONTACT de §23 (max de fenetre), 20 = le meme AVANT plafond ;
   21 = `dl`, l'entree d'ETIREMENT, AVANT son `fmin` (max de fenetre) ; 22 = le NOMBRE de frames
   ou elle a mordu son plafond ; 23 = le meme compte pour la PRESSION ; 24 = le nombre de frames
   comptees, denominateur COMMUN aux deux — sans lui, 22 et 23 ne sont pas des parts.
   REPERE : le triedre de sa SPEC 7 (+X lateral, +Y haut, +Z avant), releve a la pose debout
   d'auteur. LECTURE HORS DEFAUT : 1.000 / 1.000 / 1.000 / 1.000 / 0 / 0 / 0 / 0 debout et immobile.
   CE QUE CE N'EST PAS : la deformation VUE sur le mesh. Un sommet partage avec le buste ne recoit
   qu'une part de cette echelle (champ de poids gradue en r^1.63, §31) ; ce nombre est ce que le
   solveur COMMANDE a la racine, et le rapport doit le dire a chaque fois qu'il le cite."
  (let ((sc (+ (* slot PHYS-CHAINS) chain)))
    (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS))
      0.0
      (cond
        ((< which 3) (-> *phys-dfs* (+ (* sc 3) which)))
        ((= which 3) (-> *phys-dfdet* sc))
        ((= which 4) (-> *phys-sec* sc))
        ((= which 5) (-> *phys-secm* sc))
        ((= which 6) (-> *phys-twr* sc))
        ((= which 7) (-> *phys-twm* sc))
        ((= which 8) (the float (-> *phys-dfon* sc)))
        ((< which 12) (-> *phys-gc* (+ (* sc 3) (- which 9))))
        ((= which 12) (-> *phys-secr* sc))
        ((= which 13) (-> *phys-dynm* sc))
        ((< which 18) (-> *phys-gr* (+ (* sc 3) (- which 15))))
        ((= which 18) (the float *phys-twsat*))
        ((= which 19) (-> *phys-prsm* sc))
        ((= which 20) (-> *phys-prsr* sc))
        ;; [NOTE-96] 21/22/23/24 : LES DEUX ENTREES DU TENSEUR AVANT LEUR PLAFOND. -> jak-hd-physics-NOTES.md
        ((= which 21) (-> *phys-dynr* sc))
        ((= which 22) (-> *phys-dynn* sc))
        ((= which 23) (-> *phys-prsn* sc))
        ((= which 24) (-> *phys-dyna* sc))
        ;; [NOTE-97] 25-29 : LA NATURE DE L'ENTREE DE PRESSION (cycle 36 etape 1).
        ;; 25-31 : les sept emplacements de `*phys-cpa*` releves a l'argmax de `cl`
        ;; (npf, pmax, psum, lastsw, slast, nlast, p1) ; 32 : leur DOMAINE.
        ((< which 32) (-> *phys-cpi* (+ (* 7 sc) (- which 25))))
        ((= which 32) (-> *phys-cpd* sc))
        (else 0.0)))))

(defun phys-rest ((which int))
  "SPEC 33/34 — LA RESTITUTION DE CONTACT, SUR LA FENETRE.
   0 = nombre de contacts ou elle a ete appliquee (un entier rendu en float) ; 1 = somme des
   vitesses normales ENTRANTES (u/frame, positives) ; 2 = somme des vitesses normales SORTANTES
   RELUES A LA FRAME SUIVANTE (donc mesurees, pas deduites de `e`) ; 3 = somme des coefficients
   appliques, qui lit le melange 0.06 (sein<->sein, §33) / 0.02 (buste, §34) ; 4 = nombre de
   sorties effectivement relues.
   NATURE : des vitesses en unites de jeu par frame. REPERE : le MONDE, projete sur la normale de
   contact. LECTURE HORS DEFAUT : tout a zero quand rien ne touche — et un zero ici ne vaut que
   s'il est accompagne du domaine (nombre de contacts), sans quoi c'est un zero de domaine vide."
  (cond
    ((= which 0) (the float *phys-rstn*))
    ((= which 1) *phys-rstin*)
    ((= which 2) *phys-rstout*)
    ((= which 3) *phys-rstsum*)
    ((= which 4) (the float *phys-rstm*))
    (else 0.0)))

(defun phys-rest-off-set! ((v int))
  "CONTROLE NEGATIF de SPEC 33/34 : arme = 1, `q` n'est plus corrige du tout et le solveur retrouve
   EXACTEMENT son comportement d'avant le cycle 7 (restitution effective +1)."
  (set! *phys-rst-off* v)
  (none))

(defun phys-rest-k-set! ((v float))
  "CONTROLE POSITIF de SPEC 33/34 : multiplie le coefficient de la spec. 15.0 porte le sein<->sein
   a 0.90, ce qui doit faire MONTER la vitesse sortante relue. 1.0 = la spec."
  (set! *phys-rst-k* v)
  (none))

(defun phys-slot-of ((pid int)) (phys-slot-for-pid pid))

)
