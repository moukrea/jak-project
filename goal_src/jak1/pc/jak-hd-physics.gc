(define *phys-e22-d* 0.0)
(define *phys-e21-off* 0) (define *phys-e21-n* 0) (define *phys-e21-d* 0.0)  ;; [NOTE-518] SPEC 21 sur la valeur LIVREE : 1 = borne DESARMEE (controle negatif, bit-identique a l'etat d'avant le cycle 118) ; `n` = son compteur de corrections, `d` = le module cumule retranche en B0

(defconstant PHYS-DG 100)          ;; [NOTE-510] 97/98/99 = les TROIS COMPOSANTES SIGNEES du meme deplacement d integration que 96, unites de jeu : la NORME ne dit pas quel axe a bouge, et le quantum d un flottant 32 bits depend de la MAGNITUDE de CHAQUE coordonnee, donc il faut les separer. · [NOTE-508] 94 = `pe` = |p - cible du ressort| / B0 INSTANTANE (pas un max : la case est reecrite a chaque frame, maillon `rlk`) · 95 = la NORME de la force elastique de la frame, |f|.fns^2, unites de jeu · 96 = |p_apres_sous-pas - p_avant_sous-pas|, le DEPLACEMENT QUE L INTEGRATION PRODUIT, unites de jeu. Les trois sont hors de la tranche 23-49 remise a zero par fenetre : ecrites a chaque frame, elles portent TOUJOURS la frame courante. Elles existent parce que le cycle 116 a mesure que les sept etages ne deplacent le joint de rien au point de parcage alors que |p - cible| y vaut au moins 0.271 u : il faut donc lire la force ET le deplacement qu elle produit, au meme endroit et a la meme frame. · 87-93 = [NOTE-501] le MEME septuplet en INSTANTANE (pas un latch, pas un argmax) : la DERNIERE frame ecrite, lue par la salle a la fermeture de la fenetre PH-AXC, la ou `ROOM-AXC-SETTLE` mesure sigma30 = 0 · 86 = [NOTE-472] la part RADIALE de l'excursion d'apex (projection signee sur le levier de chair, ponderee, en B0, AU MEME ARGMAX que 53-56) · 79-85 = [NOTE-466] le MEME septuplet a portee de FENETRE, cle sur l'etage 0 · 65-71 = [NOTE-340] les SEPT etages de |p_rlk - pose auteur| / B0 DANS LA FRAME COURANTE, 72-78 le meme septuplet LATCHE a la frame qui maximise l'etage 6 · 59-61 = [NOTE-338] la part TRANSLATION de l'apex, 62-64 sa part TENSEUR, AU MEME ARGMAX que 53-56 · 31-34 = [NOTE-92] l'attribution de `comex` · 35-42 = [NOTE-112] le COM PAR MAILLON · 43-46 = [NOTE-126] le COM PONDERE · 47-49 = [NOTE-136] son VECTEUR · 50-52 = [NOTE-137] la POSITION MONDE de l'ancre · 53-56 = [NOTE-139] l'APEX et son vecteur · 57/58 = [NOTE-139] les deux extremes verticaux du COM (SPEC 15)
(define *phys-dg* (new 'global 'array 'float (* PHYS-SC PHYS-DG)))
;; [NOTE-92] LE CENTRE DE CHAIR APRES ROTATION ET AVANT DEFORMATION. -> jak-hd-physics-NOTES.md
(define *phys-c1* (new 'global 'array 'float 3))
;; [NOTE-486] etat de contrainte de la frame precedente, par (lien, volume), pour compter les bascules -> jak-hd-physics-NOTES.md
(defconstant PHYS-FLIPW 3)
(define *phys-fl* (new 'global 'array 'int32 (* PHYS-SCL PHYS-FLIPW)))
(define *phys-flhas* (new 'global 'array 'int32 PHYS-SCL))
;; [NOTE-521] LA DIRECTION DE POUSSEE DE LA FRAME PRECEDENTE, ET LE COMPTE DE SES RENVERSEMENTS — instrument PUR, aucun etat du solveur ne le lit. -> jak-hd-physics-NOTES.md
(define *phys-sdnp* (new 'global 'inline-array 'vector PHYS-SCL))
(define *phys-nflip* (new 'global 'array 'float (* PHYS-SCL 2)))
;; [NOTE-487] CONTROLE POSITIF de l'auto-collision : arme, l'exclusion chaine<->ses propres volumes es -> jak-hd-physics-NOTES.md
(define *phys-self-inject* 0)
;; [NOTE-488] ARME, LA CONTRAINTE DE COTE EST LEVEE et son compteur doit MONTER. Un compteur tombe a z -> jak-hd-physics-NOTES.md
(define *phys-side-off* 0)
;; [NOTE-54] CONTROLE DE LA CONTRAINTE DE LONGUEUR — 1 = DESARMEE. RESTE A 0 EN LIVRAISON. -> jak-hd-physics-NOTES.md
(define *phys-len-off* 0)
;; [NOTE-489] [NOTE-53] CONTROLE k=4 — 1 = LE MUR DE COLLISION EST DESARME (`feff` -> PHYS-VOL-FREE),  -> jak-hd-physics-NOTES.md
(define *phys-col-off* 0)
;; [NOTE-65] CONTROLE k=5 — 1 = LA BORNE §22 DU CANAL RADIAL EST DESARMEE (`rcap` -> +inf), -> jak-hd-physics-NOTES.md
(define *phys-rr-off* 0)
;; [NOTE-181] CONTROLE DU CYCLE 44 — 1 = LA BORNE D'ANGLE `phys-bend-chain` EST ENTIEREMENT DESARMEE. -> jak-hd-physics-NOTES.md
(define *phys-bend-off* 0)
(define *phys-fwall* 1)   ;; [NOTE-330] 1 = MUR DE FORCE §21 ARME (etat d'avant le cycle 72) -> jak-hd-physics-NOTES.md

;; `*phys-njoint*` retiree : ecrite chaque step, RELUE PAR PERSONNE. Classe de `*phys-lmean*`.

;; [NOTE-490] deltas de propagation aux descendants non simules (les verres de lunettes pendent sous -> jak-hd-physics-NOTES.md
(define *phys-dmat* (new 'global 'inline-array 'matrix PHYS-JOINTS))
(define *phys-dhas* (new 'global 'array 'int32 PHYS-JOINTS))

;; [NOTE-279] petits utilitaires -> jak-hd-physics-NOTES.md
(defun phys-mi->f ((v int))
  "milli-unites du magasin C++ -> flottant."
  (/ (the float v) 1000.0))

(defun phys-slot-for-pid ((pid int))
  "slot deja alloue a ce pid, -1 sinon."
  (let ((r -1))
    (dotimes (i PHYS-SLOTS)
      (when (and (< r 0) (= (-> *phys-slot-pid* i) pid)) (set! r i)))
    r))

(defun phys-slot-alloc ((pid int))
  "premier slot libre, -1 si plein."
  (let ((r -1))
    (dotimes (i PHYS-SLOTS)
      (when (and (< r 0) (zero? (-> *phys-slot-pid* i))) (set! r i)))
    (when (>= r 0) (set! (-> *phys-slot-pid* r) pid))
    r))

;; [NOTE-238] INIT — resolution des chaines DEPUIS LE RIG. Le moteur ne porte aucun nom de joint : il  -> jak-hd-physics-NOTES.md
(defun jak-hd-physics-init ((obj jak-hd))
  (when (and (nonzero? (-> obj draw)) (nonzero? (-> obj draw jgeo)))
    (let* ((agname (-> *hd-ag-names* (-> obj entry)))
           (nch    (pc-physics-num-chains agname)))
      (cond
        ((<= nch 0)
         (format 0 "[HD-PHYS] no chain data for ~S — physics inert for this model~%" agname))
        (else
         (let ((slot (phys-slot-alloc (the int (-> obj pid)))))
           (cond
             ((< slot 0)
              (format 0 "[HD-PHYS] no free sim slot — physics inert for ~S~%" agname))
             (else
              (let ((njoint (-> obj draw jgeo length))
                    (nc     (min nch PHYS-CHAINS)))
                (set! (-> *phys-slot-nch* slot) nc)
                ;; remise a zero de la topologie du slot
                (dotimes (c PHYS-CHAINS)
                  (let ((sc (+ (* slot PHYS-CHAINS) c)))
                    (set! (-> *phys-nlink* sc) 0)
                    (set! (-> *phys-anchor* sc) -1)
                    (set! (-> *phys-warm* sc) 0)
                    (set! (-> *phys-thas* sc) 0)
                    (set! (-> *phys-rhas* sc) 0)
                    ;; [NOTE-237] le triedre de SPEC 24/29 se classe lui aussi a la premiere frame utile, sur -> jak-hd-physics-NOTES.md
                    (set! (-> *phys-axok* sc) 0)
                    (set! (-> *phys-axan* sc) 0)
                    (set! (-> *phys-axsrc* sc) 0)
                    (dotimes (ii 3)
                      (set! (-> *phys-axs* (+ (* sc 3) ii)) 1.0)
                      (set! (-> *phys-axsep* (+ (* sc 3) ii)) 0.0))
                    (set-vector! (-> *phys-sepv* sc) 0.0 0.0 0.0 0.0)
                    ;; [NOTE-278] SPEC 37 — « rebase on teleportation / level transition ». Un slot reutilise -> jak-hd-physics-NOTES.md
                    (set! (-> *phys-fok* sc) 0)
                    (set! (-> *phys-dfon* sc) 0)
                    (set! (-> *phys-dfdet* sc) 1.0)
                    (set! (-> *phys-twok* sc) 0)
                    (set! (-> *phys-tw* sc) 0.0)
                    (set! (-> *phys-twv* sc) 0.0)
                    (set! (-> *phys-twa* sc) 0.0)
                    (set! (-> *phys-twm* sc) 0.0)
                    (set! (-> *phys-sec* sc) 0.0)
                    (set! (-> *phys-secv* sc) 0.0)
                    (set! (-> *phys-secm* sc) 0.0)
                    (set! (-> *phys-secr* sc) 0.0)
                    (set! (-> *phys-dynm* sc) 0.0)
                    (set! (-> *phys-prsm* sc) 0.0)
                    (set! (-> *phys-prsr* sc) 0.0)
    (set! (-> *phys-dynr* sc) 0.0)
    (set! (-> *phys-cpd* sc) 0.0)
    (dotimes (k 7) (set! (-> *phys-cpi* (+ (* 7 sc) k)) 0.0))
    (set! (-> *phys-dynn* sc) 0.0)
    (set! (-> *phys-prsn* sc) 0.0)
    (set! (-> *phys-dyna* sc) 0.0)
                    ;; [NOTE-248] SPEC 37 « rebase on teleportation / level transition » : le degre de liberte -> jak-hd-physics-NOTES.md
                    (set! (-> *phys-rr* sc) 0.0)
                    (dotimes (ll PHYS-LINKS)
                      (set! (-> *phys-rrl* (+ (* sc PHYS-LINKS) ll)) 0.0)
                      (set! (-> *phys-rrml* (+ (* sc PHYS-LINKS) ll)) 0.0)
                      (set! (-> *phys-rrrl* (+ (* sc PHYS-LINKS) ll)) 0.0)
                      (set! (-> *phys-rrsl* (+ (* sc PHYS-LINKS) ll)) 0.0)
                      (set! (-> *phys-rrtl* (+ (* sc PHYS-LINKS) ll)) 0.0)
                      (set! (-> *phys-cddl* (+ (* sc PHYS-LINKS) ll)) 0.0)
                      (set! (-> *phys-rok* (+ (* sc PHYS-LINKS) ll)) 0))
                    (set! (-> *phys-rrm* sc) 0.0)
                    (set-vector! (-> *phys-vp* sc) 0.0 0.0 0.0 0.0)
                    (dotimes (ii 3)
                      (set! (-> *phys-dfs* (+ (* sc 3) ii)) 1.0) (set! (-> *phys-dyb* (+ (* sc 3) ii)) 0.0) (set! (-> *phys-sds* (+ (* sc 3) ii)) 1.0) (set! (-> *phys-sdv* (+ (* sc 3) ii)) 0.0))
                    ;; [NOTE-277] la direction de repos du materiau se releve a la premiere frame utile, sur la -> jak-hd-physics-NOTES.md
                    (dotimes (l PHYS-LINKS)
                      (set! (-> *phys-ucap* (+ (* sc PHYS-LINKS) l)) 0))))
                ;; --- 1. les joints portent les chaines : on lit le rig, pas une liste en dur ---
                (dotimes (k njoint)
                  (let* ((jn   (-> obj draw jgeo data k name))
                         (role (if jn (pc-physics-joint-role agname jn) -1)))
                    (when (>= role 0)
                      (let ((c    (shr role 8))
                            (link (logand role 255)))
                        ;; [NOTE-166] UNE TRONCATURE SILENCIEUSE EST UN DE-SCOPE (2026-08-13). Un maillon -> jak-hd-physics-NOTES.md
                        (when (and (< c nc) (>= link PHYS-LINKS))
                          (format 0 "PHYSTRUNC c=~D link=~D cap=~D joint=~S~%"
                                  c link PHYS-LINKS jn))
                        (when (and (< c nc) (< link PHYS-LINKS))
                          (let ((sc (+ (* slot PHYS-CHAINS) c)))
                            (set! (-> *phys-joint* (+ (* sc PHYS-LINKS) link)) k)
                            (when (>= (+ link 1) (-> *phys-nlink* sc))
                              (set! (-> *phys-nlink* sc) (+ link 1)))
                            ;; l'ancre est le parent RIG du lien 0 (255 = racine -> pas d'ancre)
                            (when (zero? link)
                              (let ((p (the int (-> (-> obj khd-par) k))))
                                (set! (-> *phys-anchor* sc) (if (= p 255) -1 p))))))))))
                ;; --- 2. les parametres, une fois, depuis le fichier de donnees ---
                (let ((armed 0) (links 0))
                  (dotimes (c nc)
                    (let ((sc (+ (* slot PHYS-CHAINS) c)))
                      (set! (-> *phys-stiff* sc)  (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-STIFF)))
                      (set! (-> *phys-damp* sc)   (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-DAMP)))
                      (set! (-> *phys-grav* sc)   (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-GRAV)))
                      (set! (-> *phys-couple* sc) (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-COUPLE)))
                      (set! (-> *phys-hang* sc)   (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-HANG)))
                      (let ((m (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-MASS))))
                        (set! (-> *phys-mass* sc) (if (< m 0.01) 1.0 m)))
                      (set! (-> *phys-fam* sc)    (the int (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-FAMILY))))
                      (set! (-> *phys-rootlk* sc) (the int (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-ROOTLK))))
                      (set! (-> *phys-rootgr* sc) (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-GRADIENT)))
                      (set! (-> *phys-b0* sc) (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-B0)))
                      ;; [NOTE-236] PREUVE D'EXECUTION (regle 0) : un zero silencieux au parseur C++ ou a la -> jak-hd-physics-NOTES.md
                      (when (> (-> *phys-b0* sc) 0.0)
                        (format 0 "[HD-PHYS] b0 c=~D flesh=~f anc=~D~%" c (-> *phys-b0* sc) (-> *phys-anchor* sc)))
                      ;; [NOTE-180] PREUVE D'EXECUTION (regle 0) : `gradient=` traverse le fichier de donnees, -> jak-hd-physics-NOTES.md
                      (when (> (-> *phys-rootgr* sc) 0.0)
                        (format 0 "[HD-PHYS] rootgrade c=~D g=~f~%" c (-> *phys-rootgr* sc)))
                      (set! (-> *phys-maxang* sc) (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-MAXANG)))
                      ;; rayons par lien : `radii=` s'il existe, sinon le `radius=` de la chaine
                      (let ((base (phys-mi->f (pc-physics-chain-param-mi agname c PHYS-P-RADIUS))))
                        (dotimes (l PHYS-LINKS)
                          (let ((r (phys-mi->f (pc-physics-chain-link-radius-mi agname c l))))
                            (set! (-> *phys-rad* (+ (* sc PHYS-LINKS) l)) (if (< r 0.01) base r)))))
                      ;; [NOTE-247] [NOTE-161] LES SOMMETS DE PEAU DU MAILLON. Meme cycle de vie que les -> jak-hd-physics-NOTES.md
                      (dotimes (l PHYS-LINKS)
                        (let* ((scl (+ (* sc PHYS-LINKS) l))
                               (nk (pc-physics-chain-msample-count agname c l)))
                          (set! (-> *phys-msn* scl) (min nk PHYS-MS-MAX))
                          (dotimes (q (-> *phys-msn* scl))
                            (set-vector! (-> *phys-msp* (+ (* scl PHYS-MS-MAX) q))
                              (phys-mi->f (pc-physics-chain-msample-mi agname c (+ (* l 8) q) 0))
                              (phys-mi->f (pc-physics-chain-msample-mi agname c (+ (* l 8) q) 1))
                              (phys-mi->f (pc-physics-chain-msample-mi agname c (+ (* l 8) q) 2)) 0.0))))
                      ;; [NOTE-491] [NOTE-126] la part de masse de peau de CHAQUE maillon. 0 = non declaree, -> jak-hd-physics-NOTES.md
                      (dotimes (l PHYS-LINKS)
                        (set! (-> *phys-comw* (+ (* sc PHYS-LINKS) l))
                              (phys-mi->f (pc-physics-chain-link-comw-mi agname c l)))
                        (set! (-> *phys-apw* (+ (* sc PHYS-LINKS) l)) (phys-mi->f (pc-physics-chain-link-apex-mi agname c l 0)))
                        (set! (-> *phys-apx* (+ (* sc PHYS-LINKS) l)) (phys-mi->f (pc-physics-chain-link-apex-mi agname c l 1)))
                        (set! (-> *phys-apy* (+ (* sc PHYS-LINKS) l)) (phys-mi->f (pc-physics-chain-link-apex-mi agname c l 2)))
                        (set! (-> *phys-apz* (+ (* sc PHYS-LINKS) l)) (phys-mi->f (pc-physics-chain-link-apex-mi agname c l 3))))
                      (let ((pb (* sc PHYS-PSET-N)))
                        (dotimes (pki PHYS-PSET-N)
                          (let ((mi (pc-physics-chain-preset-mi agname c pki)))
                            (set! (-> *phys-pset* (+ pb pki)) (if (>= mi 0) (phys-mi->f mi) (if (or (< pki 6) (and (>= pki 10) (< pki 13)) (and (>= pki 22) (< pki 26))) 1.0 0.0)))))
                        (format 0 "[HD-PHYS] PHYSPSET c=~D keys=~D absent=~D~%" c (pc-physics-chain-preset-count agname c) (pc-physics-chain-preset-absent agname c))
                        (format 0 "[HD-PHYS] PHYSPSETA c=~D sp=~f sw=~f sh=~f hl=~f hw=~f~%" c (-> *phys-pset* (+ pb 0)) (-> *phys-pset* (+ pb 1)) (-> *phys-pset* (+ pb 2)) (-> *phys-pset* (+ pb 3)) (-> *phys-pset* (+ pb 4)))
                        (format 0 "[HD-PHYS] PHYSPSETB c=~D ht=~f lbc=~f secf=~f secz=~f secmax=~f~%" c (-> *phys-pset* (+ pb 5)) (-> *phys-pset* (+ pb 6)) (-> *phys-pset* (+ pb 7)) (-> *phys-pset* (+ pb 8)) (-> *phys-pset* (+ pb 9)))
                        (format 0 "[HD-PHYS] PHYSPSETC c=~D ap=~f lat=~f tor=~f asc=~f rbb=~f~%" c (-> *phys-pset* (+ pb 10)) (-> *phys-pset* (+ pb 11)) (-> *phys-pset* (+ pb 12)) (-> *phys-pset* (+ pb 13)) (-> *phys-pset* (+ pb 14)))
                        (format 0 "[HD-PHYS] PHYSPSETD c=~D rbc=~f akn=~f acp=~f ckn=~f ccp=~f~%" c (-> *phys-pset* (+ pb 15)) (-> *phys-pset* (+ pb 16)) (-> *phys-pset* (+ pb 17)) (-> *phys-pset* (+ pb 18)) (-> *phys-pset* (+ pb 19)))
                        (format 0 "[HD-PHYS] PHYSPSETE c=~D chard=~f syld=~f ahard=~f~%" c (-> *phys-pset* (+ pb 20)) (-> *phys-pset* (+ pb 21)) (-> *phys-pset* (+ pb 22)))
                        (format 0 "[HD-PHYS] PHYSPSETF c=~D vcomp=~f nshi=~f nslo=~f ndyn=~f~%" c (-> *phys-pset* (+ pb 23)) (-> *phys-pset* (+ pb 24)) (-> *phys-pset* (+ pb 25)) (-> *phys-pset* (+ pb 26))))
                      (when (> (-> *phys-nlink* sc) 0)
                        (+! armed 1)
                        (+! links (-> *phys-nlink* sc)))))
                  ;; [NOTE-235] --- 2 ter. SPEC 18 : les echantillons de surface, resolus vers des joints --- -> jak-hd-physics-NOTES.md
                  (set! (-> *phys-slot-nbsurf* slot) 0)
                  (let ((nbs (pc-physics-num-bsurf agname))
                        (nb 0)
                        (unbound 0)
                        (sb (* slot PHYS-BSURF-SETS)))
                    ;; [NOTE-319] les deux populations de la famille `bs`, et pourquoi la passe 0 est bi -> jak-hd-physics-NOTES.md
                    (dotimes (pass (+ 1 nc))
                     (when (> pass 0)
                       (set! (-> *phys-bslo* (+ (* slot PHYS-CHAINS) (- pass 1))) nb)
                       (set! (-> *phys-bscn* (+ (* slot PHYS-CHAINS) (- pass 1))) 0))
                     (dotimes (i (min nbs PHYS-BSURF-SETS))
                      (let ((found -1)
                            (cch -1)
                            (csl -1))
                        (dotimes (k njoint)
                          (let ((jn (-> obj draw jgeo data k name)))
                            (when (and jn (< found 0)
                                       (nonzero? (pc-physics-bsurf-is-joint agname i jn)))
                              (set! found k))))
                        (when (>= found 0)
                          (dotimes (cc nc)
                            (dotimes (ll PHYS-LINKS)
                              (when (and (< ll (-> *phys-nlink* (+ (* slot PHYS-CHAINS) cc)))
                                         (= found (-> *phys-joint*
                                                      (+ (* (+ (* slot PHYS-CHAINS) cc) PHYS-LINKS) ll))))
                                (set! cch cc)
                                (set! csl (+ (* (+ (* slot PHYS-CHAINS) cc) PHYS-LINKS) ll))))))
                        (cond
                          ((< found 0) (when (zero? pass) (+! unbound 1)))
                          ((!= cch (- pass 1)) 0)
                          (else
                           (let ((nk (min (pc-physics-bsurf-count agname i) PHYS-BSURF-MAX))
                                 (br 0.0))
                             (when (> nk 0)
                               (set! (-> *phys-bsk* (+ sb nb)) found)
                               (set! (-> *phys-bssl* (+ sb nb)) (if (zero? pass) -1 csl))
                               (set! (-> *phys-bsn* (+ sb nb)) nk)
                               (dotimes (q nk)
                                 (let ((qi (+ (* (+ sb nb) PHYS-BSURF-MAX) q))
                                       (pv (-> *phys-bsp* (+ (* (+ sb nb) PHYS-BSURF-MAX) q)))
                                       (nv (-> *phys-bsnm* (+ (* (+ sb nb) PHYS-BSURF-MAX) q))))
                                   (set-vector! pv
                                     (phys-mi->f (pc-physics-bsurf-mi agname i q 0))
                                     (phys-mi->f (pc-physics-bsurf-mi agname i q 1))
                                     (phys-mi->f (pc-physics-bsurf-mi agname i q 2)) 0.0)
                                   (set-vector! nv
                                     (phys-mi->f (pc-physics-bsurf-mi agname i q 3))
                                     (phys-mi->f (pc-physics-bsurf-mi agname i q 4))
                                     (phys-mi->f (pc-physics-bsurf-mi agname i q 5)) 0.0)
                                   (let ((l (vector-length pv)))
                                     (when (> l br) (set! br l)))
                                   qi))
                               ;; [NOTE-276] le rayon englobant vient des echantillons RETENUS, jamais du -> jak-hd-physics-NOTES.md
                               (set! (-> *phys-bsr* (+ sb nb)) br)
                               (+! nb 1)
                               (when (> pass 0)
                                 (+! (-> *phys-bscn* (+ (* slot PHYS-CHAINS) (- pass 1))) 1))))))))
                     (when (zero? pass) (set! (-> *phys-slot-nbsurf* slot) nb)))
                    (set! (-> *phys-slot-nbsurf-decl* slot) nbs)
                    ;; [NOTE-275] PREUVE D'EXECUTION (regle 0) : sans cette ligne, un fichier absent, un -> jak-hd-physics-NOTES.md
                    (format 0 "[HD-PHYS] bsurf ag=~S sets=~D/~D lies=~D non-lies=~D chaine=~D~%"
                            agname (-> *phys-slot-nbsurf* slot) nbs (-> *phys-slot-nbsurf* slot)
                            unbound (- nb (-> *phys-slot-nbsurf* slot)))
                    ;; [NOTE-320] l'espacement du nuage, mesure sur la donnee livree -> jak-hd-physics-NOTES.md
                    (dotimes (cc nc)
                      (let ((occ (+ (* slot PHYS-CHAINS) cc)))
                        (set! (-> *phys-bssp* occ) 0.0)
                        (dotimes (ss (-> *phys-bscn* occ))
                          (let ((si (+ sb (+ (-> *phys-bslo* occ) ss)))
                                (acc 0.0)
                                (cnt 0))
                            (dotimes (q (-> *phys-bsn* si))
                              (let ((bestd 1000000000.0))
                                (dotimes (r (-> *phys-bsn* si))
                                  (when (!= r q)
                                    (let ((dd (vector-vector-distance
                                                (-> *phys-bsp* (+ (* si PHYS-BSURF-MAX) q))
                                                (-> *phys-bsp* (+ (* si PHYS-BSURF-MAX) r)))))
                                      (when (< dd bestd) (set! bestd dd)))))
                                (when (< bestd 1000000.0)
                                  (set! acc (+ acc bestd))
                                  (+! cnt 1))))
                            (when (> cnt 0)
                              (let ((mn (/ acc (the float cnt))))
                                (when (> mn (-> *phys-bssp* occ))
                                  (set! (-> *phys-bssp* occ) mn))))))))
                    (dotimes (cc nc)
                      (when (> (-> *phys-bscn* (+ (* slot PHYS-CHAINS) cc)) 0)
                        (format 0 "[HD-PHYS] bsurf-space c=~D mean-nn=~f~%" cc
                                (-> *phys-bssp* (+ (* slot PHYS-CHAINS) cc)))
                        (format 0 "[HD-PHYS] bsurf-chain c=~D lo=~D n=~D~%" cc
                                (-> *phys-bslo* (+ (* slot PHYS-CHAINS) cc))
                                (-> *phys-bscn* (+ (* slot PHYS-CHAINS) cc))))))
                  ;; --- 3. les colliders, ajustes sur le mesh, resolus vers des index de joint ---
                  (let ((nco (min (pc-physics-num-colliders agname) PHYS-COLS)))
                    (set! (-> *phys-slot-nco* slot) nco)
                    (dotimes (ci nco)
                      (let ((sco (+ (* slot PHYS-COLS) ci)))
                        (set! (-> *phys-cj* sco) -1)
                        (set! (-> *phys-cj2* sco) -1)
                        (set! (-> *phys-cr* sco)  (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-RADIUS)))
                        (let ((r2 (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-RADIUS2))))
                          (set! (-> *phys-cr2* sco) (if (< r2 0.01) (-> *phys-cr* sco) r2)))
                        (set! (-> *phys-cox* sco) (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-OFFX)))
                        (set! (-> *phys-coy* sco) (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-OFFY)))
                        (set! (-> *phys-coz* sco) (phys-mi->f (pc-physics-collider-param-mi agname ci PHYS-C-OFFZ)))
                        (dotimes (k njoint)
                          (let ((jn (-> obj draw jgeo data k name)))
                            (when jn
                              (when (and (< (-> *phys-cj* sco) 0)
                                         (nonzero? (pc-physics-collider-is-joint agname ci jn)))
                                (set! (-> *phys-cj* sco) k))
                              (when (and (< (-> *phys-cj2* sco) 0)
                                         (nonzero? (pc-physics-collider-is-joint2 agname ci jn)))
                                (set! (-> *phys-cj2* sco) k)))))))
                    ;; [NOTE-234] --- 3a bis. CE QUE CHAQUE VOLUME EST, pour l'instantane de Jacobi et pour la -> jak-hd-physics-NOTES.md
                    (dotimes (ci nco)
                      (let ((sco (+ (* slot PHYS-COLS) ci)))
                        (set! (-> *phys-csim* sco) 0)
                        (set! (-> *phys-csok* sco) 0)
                        (set! (-> *phys-cdep* sco) 999)
                        (let ((cj  (-> *phys-cj* sco))
                              (cj2 (-> *phys-cj2* sco)))
                          ;; porte par un joint simule ?
                          (dotimes (c2 nc)
                            (let ((sc2 (+ (* slot PHYS-CHAINS) c2)))
                              (dotimes (l2 (-> *phys-nlink* sc2))
                                (let ((kj (-> *phys-joint* (+ (* sc2 PHYS-LINKS) l2))))
                                  (when (and (>= kj 0) (or (= cj kj) (= cj2 kj)))
                                    (set! (-> *phys-csim* sco) 1))))))
                          ;; profondeur rig : on remonte `khd-par` jusqu'a la racine (255)
                          (dotimes (which 2)
                            (let ((k0 (if (zero? which) cj cj2)))
                              (when (and (>= k0 0) (< k0 njoint))
                                (let ((d 0) (k k0) (guard 0))
                                  (while (and (>= k 0) (< k PHYS-JOINTS) (< guard 128))
                                    (let ((p (the int (-> (-> obj khd-par) k))))
                                      (cond
                                        ((or (= p 255) (>= p PHYS-JOINTS)) (set! k -1))
                                        (else (set! k p) (+! d 1))))
                                    (+! guard 1))
                                  (when (< d (-> *phys-cdep* sco))
                                    (set! (-> *phys-cdep* sco) d)))))))))
                    ;; [NOTE-246] --- 3b. LE VOLUME QUE CHAQUE LIEN PORTE. Par defaut sa demi-epaisseur, -> jak-hd-physics-NOTES.md
                    (dotimes (c nc)
                      (let ((sc (+ (* slot PHYS-CHAINS) c)))
                        (dotimes (l PHYS-LINKS)
                          (let ((scl (+ (* sc PHYS-LINKS) l)))
                            (set! (-> *phys-lcr* scl) (-> *phys-rad* scl))
                            (set! (-> *phys-lcx* scl) 0.0)
                            (set! (-> *phys-lcy* scl) 0.0)
                            (set! (-> *phys-lcz* scl) 0.0)
                            (let ((kk (-> *phys-joint* scl)))
                              (when (>= kk 0)
                                (dotimes (ci nco)
                                  (let ((sco (+ (* slot PHYS-COLS) ci)))
                                    (when (and (= (-> *phys-cj* sco) kk) (< (-> *phys-cj2* sco) 0))
                                      (set! (-> *phys-lcr* scl) (-> *phys-cr* sco))
                                      (set! (-> *phys-lcx* scl) (-> *phys-cox* sco))
                                      (set! (-> *phys-lcy* scl) (-> *phys-coy* sco))
                                      (set! (-> *phys-lcz* scl) (-> *phys-coz* sco))
                                      (format 0 "[HD-PHYS] vol c=~D l=~D joint=~D r=~f -> r=~f off=~f~%"
                                              c l kk (-> *phys-rad* scl) (-> *phys-cr* sco)
                                              (sqrtf (+ (* (-> *phys-cox* sco) (-> *phys-cox* sco))
                                                        (+ (* (-> *phys-coy* sco) (-> *phys-coy* sco))
                                                           (* (-> *phys-coz* sco) (-> *phys-coz* sco)))))))))))))))
                    ;; [NOTE-492] PREUVE D'EXECUTION (regle 0) : ce que le moteur a REELLEMENT resolu, pas ce -> jak-hd-physics-NOTES.md
                    (format 0 "[HD-PHYS] init ~S slot=~D chains=~D links=~D colliders=~D joints=~D~%"
                            agname slot armed links nco njoint)))))))))))
  (none))

(defun jak-hd-physics-release ((obj jak-hd))
  (let ((slot (phys-slot-for-pid (the int (-> obj pid)))))
    (when (>= slot 0)
      (set! (-> *phys-slot-pid* slot) 0)
      (set! (-> *phys-slot-nch* slot) 0)
      (set! (-> *phys-slot-nco* slot) 0)))
  (none))

;; [NOTE-20] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defconstant PHYS-VOL-FREE 1000000000.0)

;; [NOTE-21] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-softmin ((v float) (cap float))
  "min DOUX de v et cap A ZONE MORTE. Docstring integrale : [NOTE-527] de jak-hd-physics-NOTES.md."
  (let ((kn (* 0.84 cap)))
    (if (or (<= cap 0.0) (<= v kn))
      v
      (let* ((cp (- cap kn))
             (x  (/ (- v kn) cp)))
        (+ kn (* cp (/ x (+ 1.0 x))))))))

;; [NOTE-50] UN TAUX D'AMORTISSEMENT N'EST PAS UN FACTEUR DE RETENTION. -> jak-hd-physics-NOTES.md
(defun phys-decay ((x float))
  "e^-x pour x >= 0 : le facteur de RETENTION qu'un taux `x` produit sur UN pas. Pade(3,3),
   erreur relative < 1e-6 sur [0, 0.8] — la plage reellement utilisee ici est [0.021, 0.708].
   Ne depend pas de `exp` de trigonometry.gc, routine PS2 decompilee non verifiee."
  (let* ((a (fmax 0.0 x))
         (h (* 0.5 a))
         (q (* 0.1 (* a a)))
         (c (* 0.00833333 (* a (* a a)))))
    (/ (+ (- 1.0 h) (- q c)) (+ (+ 1.0 h) (+ q c)))))

(defun phys-osc-k2 ((z float) (wh float))
  "Raideur par pas telle que la recurrence symplectique rende EXACTEMENT `z` et la pulsation dont `wh` = omega * pas ; retention associee `(phys-decay (* 2.0 z wh))`. Pourquoi `4 r sin^2(theta/2)` et jamais `1 - cos` : [NOTE-521] de jak-hd-physics-NOTES.md."
  (let* ((r (phys-decay (* z wh)))
         (u (* 0.5 (* wh (sqrtf (fmax 0.0 (- 1.0 (* z z)))))))
         (s (* u (+ (- 1.0 (* 0.16666667 (* u u))) (* 0.00833333 (* (* u u) (* u u)))))))
    (+ (* (- 1.0 r) (- 1.0 r)) (* 4.0 (* r (* s s))))))

;; [NOTE-508] SPEC 11 — UN PAS DU SECOND ORDRE SUR UNE ECHELLE DE FORME. -> jak-hd-physics-NOTES.md
(defun phys-sdyn ((sc int) (i int) (tgt float) (k2 float) (kd float))
  "Avance l'echelle `i` de la chaine `sc` d'un pas vers `tgt` et rend sa valeur. Recurrence symplectique IDENTIQUE a §29/§36 : `v <- kd.v + k2.(cible - etat)` puis `etat <- etat + v`. NATURE : sans dimension. LECTURE HORS DEFAUT : `tgt` constant et etat = `tgt` => v = 0, rendu = `tgt` AU BIT."
  (let* ((g (+ (* sc 3) i)) (v (+ (* kd (-> *phys-sdv* g)) (* k2 (- tgt (-> *phys-sds* g))))))
    (set! (-> *phys-sdv* g) v) (set! (-> *phys-sds* g) (+ (-> *phys-sds* g) v))
    (-> *phys-sds* g)))

(defun phys-vol-floor ((sc int) (floor0 float) (b0 float))
  "Profondeur maximale que cette paire (lien, volume) tolere. Docstring integrale : [NOTE-528] de jak-hd-physics-NOTES.md."
  (if (nonzero? *phys-col-off*)
    PHYS-VOL-FREE
    (+ floor0 (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 21)) b0))))

(defun phys-vol-yield ((sc int) (cj int) (cj2 int))
  "La bande de SPEC 10 est la compression de la chair CONTRE SON PROPRE BUSTE, jamais une licence de traverser un bras (regle 6). Critere STRUCTUREL et liste des volumes concernes : [NOTE-522] et [NOTE-55] de jak-hd-physics-NOTES.md."
  (let ((a (-> *phys-anchor* sc)))
    (if (and (>= a 0) (or (= cj a) (= cj2 a))) (-> *phys-b0* sc) 0.0)))

;; [NOTE-179] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-axis-dir ((pt vector) (ca vector) (cb vector) (out vector))
  "Direction unitaire allant du point le plus proche de l'AXE du volume vers `pt`, dedans comme dehors ; rend #f sur l'axe. Pourquoi `phys-collide-depth` ne peut pas servir a ca : [NOTE-523] de jak-hd-physics-NOTES.md."
  (let ((cx (-> ca x)) (cy (-> ca y)) (cz (-> ca z)))
    (let* ((ax (- (-> cb x) (-> ca x)))
           (ay (- (-> cb y) (-> ca y)))
           (az (- (-> cb z) (-> ca z)))
           (dd (+ (* ax ax) (+ (* ay ay) (* az az)))))
      (when (>= dd 0.000001)
        (let ((t0 (/ (+ (* (- (-> pt x) (-> ca x)) ax)
                        (+ (* (- (-> pt y) (-> ca y)) ay)
                           (* (- (-> pt z) (-> ca z)) az)))
                     dd)))
          (when (< t0 0.0) (set! t0 0.0))
          (when (> t0 1.0) (set! t0 1.0))
          (set! cx (+ (-> ca x) (* ax t0)))
          (set! cy (+ (-> ca y) (* ay t0)))
          (set! cz (+ (-> ca z) (* az t0))))))
    (let* ((dx (- (-> pt x) cx))
           (dy (- (-> pt y) cy))
           (dz (- (-> pt z) cz))
           (d  (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))
      (cond
        ((< d 0.001) #f)
        (else
         ;; [NOTE-274] `w` porte la DISTANCE a l'axe. Elle est deja calculee ici ; la jeter obligeait -> jak-hd-physics-NOTES.md
         (set-vector! out (/ dx d) (/ dy d) (/ dz d) d)
         #t)))))

;; [NOTE-273] CONTROLE POSITIF DU PREDICAT CONIQUE : 1 = on REMET le rayon interpole sur le parametre  -> jak-hd-physics-NOTES.md
(define *phys-cone-off* 0)

(defun phys-collide-depth ((pt vector) (rlink float) (ca vector) (cb vector)
                           (ra float) (rb float) (capsule? symbol) (nrm vector))
  "DISTANCE AU SOLIDE QUE LA LIGNE DE DONNEES DESIGNE. Docstring integrale : [NOTE-529] de jak-hd-physics-NOTES.md."
  (let ((cx 0.0) (cy 0.0) (cz 0.0) (rr ra))
    (cond
      ((not capsule?)
       (set! cx (-> ca x)) (set! cy (-> ca y)) (set! cz (-> ca z)))
      (else
       (let* ((ax (- (-> cb x) (-> ca x)))
              (ay (- (-> cb y) (-> ca y)))
              (az (- (-> cb z) (-> ca z)))
              (dd (+ (* ax ax) (* ay ay) (* az az)))
              (dr (- rb ra))
              (a2 (- dd (* dr dr))))
         (cond
           ((< dd 0.000001)
            ;; segment degenere : les deux spheres sont concentriques, la plus grosse les contient
            (set! cx (-> ca x)) (set! cy (-> ca y)) (set! cz (-> ca z))
            (set! rr (if (> rb ra) rb ra)))
           ((and (<= a2 0.000001) (zero? *phys-cone-off*))
            ;; UNE SPHERE CONTIENT L'AUTRE : aucun tronc de cone n'existe, le solide est la grosse
            (cond
              ((>= ra rb) (set! cx (-> ca x)) (set! cy (-> ca y)) (set! cz (-> ca z)) (set! rr ra))
              (else       (set! cx (-> cb x)) (set! cy (-> cb y)) (set! cz (-> cb z)) (set! rr rb))))
           (else
            (let* ((px (- (-> pt x) (-> ca x)))
                   (py (- (-> pt y) (-> ca y)))
                   (pz (- (-> pt z) (-> ca z)))
                   (dot (+ (* px ax) (* py ay) (* pz az)))
                   (t0  (/ dot dd)))
              ;; [NOTE-272] part radiale prise sur le VECTEUR perpendiculaire, pas par |p|^2 - x^2 : la -> jak-hd-physics-NOTES.md
              (when (and (> a2 0.000001) (zero? *phys-cone-off*) (!= dr 0.0))
                (let* ((qx (- px (* ax t0)))
                       (qy (- py (* ay t0)))
                       (qz (- pz (* az t0)))
                       (yy (sqrtf (+ (* qx qx) (+ (* qy qy) (* qz qz))))))
                  (set! t0 (+ t0 (/ (* dr yy) (* (sqrtf dd) (sqrtf a2)))))))
              (when (< t0 0.0) (set! t0 0.0))
              (when (> t0 1.0) (set! t0 1.0))
              (set! cx (+ (-> ca x) (* ax t0)))
              (set! cy (+ (-> ca y) (* ay t0)))
              (set! cz (+ (-> ca z) (* az t0)))
              (set! rr (+ ra (* dr t0)))))))))
    (let* ((dx (- (-> pt x) cx))
           (dy (- (-> pt y) cy))
           (dz (- (-> pt z) cz))
           (d2 (+ (* dx dx) (* dy dy) (* dz dz)))
           (d  (sqrtf d2))
           (want (+ rr rlink)))
      ;; [NOTE-178] LA PROFONDEUR NON BORNEE, POUR LA MESURE SEULE. La valeur RENDUE est bornee a 0 par le b -> jak-hd-physics-NOTES.md
      (set! *phys-depsigned* (- want d))
      (cond
        ((>= d want)
         (set! (-> nrm x) 0.0) (set! (-> nrm y) 1.0) (set! (-> nrm z) 0.0)
         0.0)
        ((< d 0.001)
         ;; centre exactement sur l'axe : direction arbitraire mais stable
         (set! (-> nrm x) 0.0) (set! (-> nrm y) 1.0) (set! (-> nrm z) 0.0)
         want)
        (else
         (set! (-> nrm x) (/ dx d)) (set! (-> nrm y) (/ dy d)) (set! (-> nrm z) (/ dz d))
         (- want d))))))

;; [NOTE-340] `PHYSSTG` — LES SEPT ETAGES DE |p_rlk - pose auteur| / B0 DANS UNE MEME FRAME. NATURE : une LONGUEUR rapportee a `B0` (SPEC 6, la CHAIR). REPERE : le monde, contre la pose d'AUTEUR de la MEME frame — c'est la grandeur `jt` de `PHYSCOMWL` (emplacement 39+l), relevee a SEPT instants au lieu d'un seul. LECTURE QUAND LE DEFAUT EST ABSENT : 0.0000 aux sept etages. INSTRUMENT PUR : n'ecrit AUCUNE position. -> jak-hd-physics-NOTES.md
(defun phys-stage-jt! ((skel skeleton) (sc int) (rlk int) (nbone int) (st int))
  (let* ((scl (+ (* sc PHYS-LINKS) rlk)) (k (-> *phys-joint* scl)) (bb (* sc PHYS-DG))
         (b0f (if (> (-> *phys-b0* sc) 0.0) (-> *phys-b0* sc) (-> *phys-blen* scl))))
    (when (and (>= k 0) (< (+ k 1) nbone) (> b0f 0.01))
      (let ((dx (- (-> *phys-px* scl) (-> skel bones (+ k 1) transform vector 3 x)))
            (dy (- (-> *phys-py* scl) (-> skel bones (+ k 1) transform vector 3 y)))
            (dz (- (-> *phys-pz* scl) (-> skel bones (+ k 1) transform vector 3 z))))
        (set! (-> *phys-dg* (+ bb (+ 65 st))) (/ (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz)))) b0f)))
      ;; LATCH : les sept valeurs publiees sont celles d'UNE SEULE frame, celle qui maximise l'etage 6. Sept maximums independants viendraient de sept frames differentes (piege `RAD-FLESH-IPAIR`, cycle 34) et ne pourraient soutenir aucun modele reliant deux etages.
      (when (and (= st 6) (> (-> *phys-dg* (+ bb 71)) (-> *phys-dg* (+ bb 78))))
        (dotimes (i 7) (set! (-> *phys-dg* (+ bb (+ 72 i))) (-> *phys-dg* (+ bb (+ 65 i))))))
      ;; [NOTE-466] LE MEME SEPTUPLET, MAIS A PORTEE DE FENETRE ET SUR UNE CLE QUI NE PEUT PAS SATURER. Le latch ci-dessus est cle sur l'etage 6, qui est BORNE a 0.50 B0 par `phys-cap-e22!` : des que la borne mord, tous les candidats sont ex aequo et l'argmax designe une frame arbitraire. L'etage 0 est releve AVANT le filet, donc rien ne le borne. Et cette tranche-la est remise a zero par `phys-comexw-reset!`, c'est-a-dire A CHAQUE FENETRE — 72-78 ne l'est pas et ne doit pas l'etre : `PHYSSTGT` le lit par JAMBE.
      (when (and (= st 6) (> (-> *phys-dg* (+ bb 65)) (-> *phys-dg* (+ bb 79))))
        (dotimes (i 7) (set! (-> *phys-dg* (+ bb (+ 79 i))) (-> *phys-dg* (+ bb (+ 65 i))))))
      ;; [NOTE-501] INSTANTANE, ET C'EST LA DIFFERENCE QUI COMPTE : ni cle, ni argmax, ni reset. -> jak-hd-physics-NOTES.md
      (when (= st 6) (dotimes (i 7) (set! (-> *phys-dg* (+ bb (+ 87 i))) (-> *phys-dg* (+ bb (+ 65 i))))))))
  (none))

;; [NOTE-22] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-length-chain ((skel skeleton) (sc int) (n int) (rlk int) (an int) (nbone int))
  "LA CONTRAINTE DE LONGUEUR, DURE, LA MEME POUR LES DEUX FORMES DE LIEN. Docstring integrale : [NOTE-530] de jak-hd-physics-NOTES.md."
  (dotimes (l n)
    (when (and (>= l rlk) (zero? *phys-len-off*))
      (let* ((scl (+ (* sc PHYS-LINKS) l))
             (kk  (-> *phys-joint* scl))
             (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
        (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
          (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                 (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                 (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                 (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                        (-> skel bones (+ kp 1) transform vector 3 x)))
                 (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                        (-> skel bones (+ kp 1) transform vector 3 y)))
                 (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                        (-> skel bones (+ kp 1) transform vector 3 z)))
                 (want (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz)))))
                 (dx (- (-> *phys-px* scl) bx))
                 (dy (- (-> *phys-py* scl) by))
                 (dz (- (-> *phys-pz* scl) bz))
                 (d  (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))
            (cond
              ((< want 0.01)
               ;; [NOTE-233] L'OS N'EXISTE PAS DANS LE MODELE : le joint est confondu avec son attache, donc -> jak-hd-physics-NOTES.md
               (let* ((rmax (-> *phys-rad* scl))
                      (tx (-> skel bones (+ kk 1) transform vector 3 x))
                      (ty (-> skel bones (+ kk 1) transform vector 3 y))
                      (tz (-> skel bones (+ kk 1) transform vector 3 z))
                      (ex (- (-> *phys-px* scl) tx))
                      (ey (- (-> *phys-py* scl) ty))
                      (ez (- (-> *phys-pz* scl) tz))
                      (e  (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez)))))
                      ;; [NOTE-493] PLAFOND DUR, ET IL DOIT LE RESTER : voir la note d'IDEMPOTENCE au-dessus -> jak-hd-physics-NOTES.md
                      (e2 rmax))
                 (when (and (> e rmax) (> e 0.0001))
                   (let ((s (/ e2 e)))
                     (set! *phys-raddrop-n* (+ *phys-raddrop-n* 1))
                     (set! *phys-raddrop-sum* (+ *phys-raddrop-sum* (- e e2)))
                     ;; [NOTE-232] LE PRIX DU SUPPRESSEUR, PAR CHAINE. SPEC 7 : « on en ajoute un uniquement -> jak-hd-physics-NOTES.md
                     (set! (-> *phys-dg* (+ (* sc PHYS-DG) 15))
                           (+ (- e e2) (-> *phys-dg* (+ (* sc PHYS-DG) 15))))
                     (set! (-> *phys-dg* (+ (* sc PHYS-DG) 6))
                           (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 6))))
                     (set! (-> *phys-px* scl) (+ tx (* ex s)))
                     (set! (-> *phys-py* scl) (+ ty (* ey s)))
                     (set! (-> *phys-pz* scl) (+ tz (* ez s)))))))
              (else
               ;; [NOTE-271] CAS DEGENERE : le lien s'est confondu avec son attache, la direction n'existe -> jak-hd-physics-NOTES.md
               (when (<= d 0.0001)
                 (set! *phys-invfix* (+ *phys-invfix* 1))
                 (set! dx mx) (set! dy my) (set! dz mz) (set! d want))
               ;; [NOTE-23] LE COTE, ET SEULEMENT SUR LE PREMIER LIEN LIBRE — celui dont l'attache est RIGIDE. -> jak-hd-physics-NOTES.md
               (let* ((m2  (+ (* mx mx) (+ (* my my) (* mz mz))))
                      (u2  (+ (* dx dx) (+ (* dy dy) (* dz dz))))
                      (dot (+ (* dx mx) (+ (* dy my) (* dz mz)))))
                 (when (and (= l rlk) (< dot 0.0) (> m2 0.0)
                            (> (* dot dot) (* PHYS-SIDE-COS2 (* u2 m2))))
                   (set! *phys-invn* (+ *phys-invn* 1))
                   (set! (-> *phys-dg* (+ (* sc PHYS-DG) 3))
                         (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 3))))
                   (let ((kr (/ (* 2.0 dot) m2)))
                     (set! dx (- dx (* kr mx)))
                     (set! dy (- dy (* kr my)))
                     (set! dz (- dz (* kr mz))))))
               ;; [NOTE-494] LONGUEUR INVARIANTE : projection sur la sphere de rayon `want` centree sur -> jak-hd-physics-NOTES.md
               (let ((dd (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))
                 (when (> dd 0.0001)
                   (let ((s (/ want dd)))
                     (set! (-> *phys-px* scl) (+ bx (* dx s)))
                     (set! (-> *phys-py* scl) (+ by (* dy s)))
                     (set! (-> *phys-pz* scl) (+ bz (* dz s))))))
               ;; [NOTE-24] PIERRE TOMBALE — LE MUR D'EXCURSION EST RETIRE DE CETTE BRANCHE, A NE PAS -> jak-hd-physics-NOTES.md
               )))))))
  (none))

;; [NOTE-25] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-cap-ang! ((skel skeleton) (sc int) (n int) (rlk int) (an int) (nbone int) (stage int))
  "RELEVE L ANGLE DE CHAQUE MAILLON A UN ETAGE DU SOLVEUR. Docstring integrale : [NOTE-531] de jak-hd-physics-NOTES.md."
  (dotimes (l n)
    (when (>= l rlk)
      (let* ((scl (+ (* sc PHYS-LINKS) l))
             (kk  (-> *phys-joint* scl))
             (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
        (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
          (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                 (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                 (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                 (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                        (-> skel bones (+ kp 1) transform vector 3 x)))
                 (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                        (-> skel bones (+ kp 1) transform vector 3 y)))
                 (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                        (-> skel bones (+ kp 1) transform vector 3 z)))
                 (ux (- (-> *phys-px* scl) bx))
                 (uy (- (-> *phys-py* scl) by))
                 (uz (- (-> *phys-pz* scl) bz))
                 (m2 (+ (* mx mx) (+ (* my my) (* mz mz))))
                 (u2 (+ (* ux ux) (+ (* uy uy) (* uz uz))))
                 (dot (+ (* ux mx) (+ (* uy my) (* uz mz)))))
            (when (and (> m2 0.0001) (> u2 0.0001))
              (let* ((cx (- (* uy mz) (* uz my)))
                     (cy (- (* uz mx) (* ux mz)))
                     (cz (- (* ux my) (* uy mx)))
                     (sn (sqrtf (+ (* cx cx) (+ (* cy cy) (* cz cz)))))
                     (ang (* 0.0054931641 (atan sn dot))))
                (cond
                  ((zero? stage)
                   (when (> ang (-> *phys-la0* scl)) (set! (-> *phys-la0* scl) ang)))
                  (else
                   (when (> ang (-> *phys-la1* scl)) (set! (-> *phys-la1* scl) ang)))))))))))
  (none))

(defun phys-apex-scale ((skel skeleton) (sc int) (n int) (nbone int) (hard? symbol))
  "Facteur COMMUN qui met la POINTE dans le budget d'apex de SPEC 22 (SPEC 21 sature la COMBINAISON).
   NATURE rapport sans dimension ; REPERE deviation ABSOLUE de la pointe a sa pose d'auteur, monde
   (SPEC 2/9) ; ABSENT = 1.0 exact dans le budget. [NOTE-120] -> jak-hd-physics-NOTES.md"
  (let* ((tl (+ (* sc PHYS-LINKS) (- n 1)))
         (kt (if (> n 0) (-> *phys-joint* tl) -1)))
    (if (or (< kt 0) (>= (+ kt 1) nbone))
      1.0
      (let* ((ex (- (-> *phys-px* tl) (-> skel bones (+ kt 1) transform vector 3 x)))
             (ey (- (-> *phys-py* tl) (-> skel bones (+ kt 1) transform vector 3 y)))
             (ez (- (-> *phys-pz* tl) (-> skel bones (+ kt 1) transform vector 3 z)))
             (dd (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez)))))
             (cap (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 22)) (if (> (-> *phys-b0* sc) 0.0) (-> *phys-b0* sc) (-> *phys-blen* tl))))
             (ds (if hard? (fmin dd cap) (phys-softmin dd cap))))
        (if (or (<= cap 0.0) (< dd 0.0001) (>= ds dd)) 1.0 (/ ds dd))))))

(defun phys-bend-chain ((skel skeleton) (sc int) (n int) (rlk int) (an int) (nbone int) (hard? symbol))
  ;; [NOTE-119] `hard?` = LA BORNE EST-ELLE DANS UNE BOUCLE ? SI OUI, ELLE DOIT ETRE IDEMPOTENTE. -> jak-hd-physics-NOTES.md
  ;; [NOTE-116] [NOTE-120] SA 22 BORNE L'APEX ET SA 21 SATURE LA COMBINAISON, PAS LE MAILLON. -> jak-hd-physics-NOTES.md
  (let* ((amax (-> *phys-maxang* sc))
         (apx? (and (= (-> *phys-fam* sc) 1) (<= amax 0.0)))
         (asc  (if apx? (phys-apex-scale skel sc n nbone hard?) 1.0)))
    (when (and (zero? *phys-bend-off*) (if apx? (< asc 1.0) (> amax 0.0)))
      (dotimes (l n)
        (when (>= l rlk)
          (let* ((scl (+ (* sc PHYS-LINKS) l))
                 (kk  (-> *phys-joint* scl))
                 (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
            (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
              (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                     (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                     (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                     (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                            (-> skel bones (+ kp 1) transform vector 3 x)))
                     (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                            (-> skel bones (+ kp 1) transform vector 3 y)))
                     (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                            (-> skel bones (+ kp 1) transform vector 3 z)))
                     (dx (- (-> *phys-px* scl) bx))
                     (dy (- (-> *phys-py* scl) by))
                     (dz (- (-> *phys-pz* scl) bz))
                     (m2 (+ (* mx mx) (+ (* my my) (* mz mz))))
                     (d2 (+ (* dx dx) (+ (* dy dy) (* dz dz)))))
                (when (and (> m2 0.000001) (> d2 0.000001))
                  (let* ((ml (sqrtf m2))
                         (dl (sqrtf d2))
                         (ux (/ mx ml)) (uy (/ my ml)) (uz (/ mz ml))
                         (vx (/ dx dl)) (vy (/ dy dl)) (vz (/ dz dl))
                         (cs (+ (* ux vx) (+ (* uy vy) (* uz vz))))
                         (px (- vx (* cs ux))) (py (- vy (* cs uy))) (pz (- vz (* cs uz)))
                         (pl (sqrtf (+ (* px px) (+ (* py py) (* pz pz)))))
                         ;; [NOTE-270] `atan` de GOAL rend des UNITES DE ROTATION (65536 = un tour) ; -> jak-hd-physics-NOTES.md
                         (adeg (* 0.0054931641 (atan pl cs)))
                         ;; SPEC 21 : `2*ml*sin(a/2)` x `asc` s'ecrit `sin(a'/2) = asc*sin(a/2)`.
                         (sh (if apx? (* asc (sin (* 91.02222 adeg))) 0.0))
                         ;; [NOTE-121] PIERRE TOMBALE — LA MONOTONIE DE SPEC 31, POSEE ET RETIREE SUR MESURE. -> jak-hd-physics-NOTES.md
                         (adg2 (cond
                                 ((not apx?) (if hard? (fmin adeg amax) (phys-softmin adeg amax)))
                                 ((>= sh 0.9999) adeg)
                                 (else (* 2.0 (* 0.0054931641 (atan sh (sqrtf (- 1.0 (* sh sh))))))))))
                    (when (and (> pl 0.0001) (< adg2 (- adeg 0.01)))
                      (let* ((au (* 182.04444 adg2))
                             (cc (cos au))
                             (ss (sin au))
                             (qx (/ px pl)) (qy (/ py pl)) (qz (/ pz pl)))
                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 7))
                              (+ (- adeg adg2) (-> *phys-dg* (+ (* sc PHYS-DG) 7))))
                        ;; [NOTE-118] LONGUEUR INVARIANTE : `ml` (le modele), jamais `dl` (le courant). -> jak-hd-physics-NOTES.md
                        (set! (-> *phys-px* scl) (+ bx (* ml (+ (* cc ux) (* ss qx)))))
                        (set! (-> *phys-py* scl) (+ by (* ml (+ (* cc uy) (* ss qy)))))
                        (set! (-> *phys-pz* scl) (+ bz (* ml (+ (* cc uz) (* ss qz))))))))))))))))
  (none))

;; [NOTE-102] ---------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-link-off! ((skel skeleton) (scl int) (kk int) (out vector))
  (let ((ox (-> *phys-lcx* scl))
        (oy (-> *phys-lcy* scl))
        (oz (-> *phys-lcz* scl)))
    (cond
      ((and (= ox 0.0) (= oy 0.0) (= oz 0.0))
       (set-vector! out 0.0 0.0 0.0 0.0))
      (else
       (set-vector! out ox oy oz 0.0)
       (vector-rotate*! out out (the-as matrix (-> skel bones (+ kk 1) transform))))))
  (none))

;; [NOTE-26] LE MEME DECALAGE, MAIS PORTE PAR L'ORIENTATION *SIMULEE* DU LIEN. -> jak-hd-physics-NOTES.md
(defun phys-link-off-sim! ((skel skeleton) (scl int) (kk int) (kp int) (nbone int)
                           (b vector) (p vector) (out vector))
  (phys-link-off! skel scl kk out)
  (when (and (>= kp 0) (< (+ kp 1) nbone)
             (or (!= (-> out x) 0.0) (!= (-> out y) 0.0) (!= (-> out z) 0.0)))
    (let* ((mx (- (-> skel bones (+ kk 1) transform vector 3 x) (-> skel bones (+ kp 1) transform vector 3 x)))
           (my (- (-> skel bones (+ kk 1) transform vector 3 y) (-> skel bones (+ kp 1) transform vector 3 y)))
           (mz (- (-> skel bones (+ kk 1) transform vector 3 z) (-> skel bones (+ kp 1) transform vector 3 z)))
           (ml (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz)))))
           (ux (- (-> p x) (-> b x))) (uy (- (-> p y) (-> b y))) (uz (- (-> p z) (-> b z)))
           (ul (sqrtf (+ (* ux ux) (+ (* uy uy) (* uz uz))))))
      (when (and (> ml 0.01) (> ul 0.01))
        (set! mx (/ mx ml)) (set! my (/ my ml)) (set! mz (/ mz ml))
        (set! ux (/ ux ul)) (set! uy (/ uy ul)) (set! uz (/ uz ul))
        (let ((d (* 2.0 (+ (* mx (-> out x)) (+ (* my (-> out y)) (* mz (-> out z)))))))
          (set! (-> out x) (- (-> out x) (* d mx)))
          (set! (-> out y) (- (-> out y) (* d my)))
          (set! (-> out z) (- (-> out z) (* d mz))))
        (let* ((hx (+ mx ux)) (hy (+ my uy)) (hz (+ mz uz))
               (hh (+ (* hx hx) (+ (* hy hy) (* hz hz)))))
          (when (> hh 0.000001)
            (let ((d (/ (* 2.0 (+ (* hx (-> out x)) (+ (* hy (-> out y)) (* hz (-> out z))))) hh)))
              (set! (-> out x) (- (-> out x) (* d hx)))
              (set! (-> out y) (- (-> out y) (* d hy)))
              (set! (-> out z) (- (-> out z) (* d hz)))))))))
  (when (nonzero? *phys-off-hold*) (vector-copy! out (-> *phys-pcof* scl)))
  (none))

(defun phys-col-centre ((skel skeleton) (sco int) (cj int) (out vector))
  (let ((ox (-> *phys-cox* sco))
        (oy (-> *phys-coy* sco))
        (oz (-> *phys-coz* sco)))
    (cond
      ((and (= ox 0.0) (= oy 0.0) (= oz 0.0))
       (vector-copy! out (the-as vector (-> skel bones (+ cj 1) transform vector 3))))
      (else
       (set-vector! out ox oy oz 1.0)
       (vector-matrix*! out out (the-as matrix (-> skel bones (+ cj 1) transform))))))
  (none))

(defun phys-snapshot-colliders! ((skel skeleton) (slot int) (nco int) (nbone int))
  "Releve la position d'auteur des deux extremites de chaque volume, AVANT que la premiere chaine
   n'ecrive quoi que ce soit dans le squelette. Appele une fois par frame, en tete du pas."
  (let ((ca (new 'stack-no-clear 'vector)))
    (dotimes (ci nco)
      (let* ((sco (+ (* slot PHYS-COLS) ci))
             (cj  (-> *phys-cj* sco))
             (cj2 (-> *phys-cj2* sco)))
        (cond
          ((and (>= cj 0) (< (+ cj 1) nbone))
           (phys-col-centre skel sco cj ca)
           (set! (-> *phys-crax* sco) (-> ca x))
           (set! (-> *phys-cray* sco) (-> ca y))
           (set! (-> *phys-craz* sco) (-> ca z))
           (cond
             ((and (>= cj2 0) (< (+ cj2 1) nbone))
              (set! (-> *phys-crbx* sco) (-> skel bones (+ cj2 1) transform vector 3 x))
              (set! (-> *phys-crby* sco) (-> skel bones (+ cj2 1) transform vector 3 y))
              (set! (-> *phys-crbz* sco) (-> skel bones (+ cj2 1) transform vector 3 z)))
             (else
              (set! (-> *phys-crbx* sco) (-> ca x))
              (set! (-> *phys-crby* sco) (-> ca y))
              (set! (-> *phys-crbz* sco) (-> ca z))))
           (set! (-> *phys-crok* sco) 1))
          (else (set! (-> *phys-crok* sco) 0))))))
  (none))

(defun phys-col-rest! ((sco int) (ra vector) (rb vector))
  "Les deux extremites du volume `sco` a leur pose d'auteur de cette frame (instantane ci-dessus).
   Rend #f quand aucun instantane n'a ete pris : l'appelant retombe alors sur le squelette."
  (cond
    ((zero? (-> *phys-crok* sco)) #f)
    (else
     (set-vector! ra (-> *phys-crax* sco) (-> *phys-cray* sco) (-> *phys-craz* sco) 1.0)
     (set-vector! rb (-> *phys-crbx* sco) (-> *phys-crby* sco) (-> *phys-crbz* sco) 1.0)
     #t)))

(defun phys-col-now! ((skel skeleton) (sco int) (cj int) (cj2 int) (nbone int)
                      (ca vector) (cb vector))
  "LES DEUX EXTREMITES DU VOLUME TELLES QUE TOUTES LES CHAINES DOIVENT LES VOIR CETTE FRAME.
   Justification complete : [NOTE-317] de jak-hd-physics-NOTES.md."
  (cond
    ((and (zero? *phys-jacobi-off*)
          (nonzero? (-> *phys-csim* sco))
          (nonzero? (-> *phys-csok* sco)))
     (set-vector! ca (-> *phys-csax* sco) (-> *phys-csay* sco) (-> *phys-csaz* sco) 1.0)
     (set-vector! cb (-> *phys-csbx* sco) (-> *phys-csby* sco) (-> *phys-csbz* sco) 1.0))
    (else
     (phys-col-centre skel sco cj ca)
     (if (and (>= cj2 0) (< (+ cj2 1) nbone))
       (vector-copy! cb (the-as vector (-> skel bones (+ cj2 1) transform vector 3)))
       (vector-copy! cb ca))))
  (none))

(defun phys-snapshot-sim! ((skel skeleton) (slot int) (nco int) (nbone int))
  "L'instantane de JACOBI : la position de FIN DE FRAME de tout volume porte par un joint simule.
   Appelee une seule fois, apres que toutes les chaines ont ecrit. C'est ce que la frame SUIVANTE
   lira, pour toutes les chaines a la fois."
  (let ((ca (new 'stack-no-clear 'vector)))
    (dotimes (ci nco)
      (let* ((sco (+ (* slot PHYS-COLS) ci))
             (cj  (-> *phys-cj* sco))
             (cj2 (-> *phys-cj2* sco)))
        (when (and (nonzero? (-> *phys-csim* sco)) (>= cj 0) (< (+ cj 1) nbone))
          (phys-col-centre skel sco cj ca)
          (set! (-> *phys-csax* sco) (-> ca x))
          (set! (-> *phys-csay* sco) (-> ca y))
          (set! (-> *phys-csaz* sco) (-> ca z))
          (cond
            ((and (>= cj2 0) (< (+ cj2 1) nbone))
             (set! (-> *phys-csbx* sco) (-> skel bones (+ cj2 1) transform vector 3 x))
             (set! (-> *phys-csby* sco) (-> skel bones (+ cj2 1) transform vector 3 y))
             (set! (-> *phys-csbz* sco) (-> skel bones (+ cj2 1) transform vector 3 z)))
            (else
             (set! (-> *phys-csbx* sco) (-> ca x))
             (set! (-> *phys-csby* sco) (-> ca y))
             (set! (-> *phys-csbz* sco) (-> ca z))))
          (set! (-> *phys-csok* sco) 1)))))
  (none))

(defun phys-col-key ((sco int) (cj int))
  "LA CLE DE PRIORITE D'UN VOLUME — depuis le 2026-08-18, DEPARTAGE SEULEMENT (le decideur est le
   Justification complete : [NOTE-309] de jak-hd-physics-NOTES.md."
  (+ (* 1000000 (-> *phys-csim* sco)) (+ (* 1000 (-> *phys-cdep* sco)) cj)))

;; [NOTE-103] ---------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-col-prox? ((slot int) (cj int) (cj2 int))
  "UN VOLUME EST UNE SPHERE PROXIMALE si son joint porteur est le joint du MAILLON 0 d'une chaine
   Justification complete : [NOTE-316] de jak-hd-physics-NOTES.md."
  (let ((p #f))
    (when (< cj2 0)
      (dotimes (c PHYS-CHAINS)
        (let ((k0 (-> *phys-joint* (* (+ (* slot PHYS-CHAINS) c) PHYS-LINKS))))
          (when (and (>= k0 0) (= cj k0)) (set! p #t)))))
    p))

(defun phys-col-own? ((sc int) (n int) (cj int) (cj2 int))
  (let ((own #f))
    (dotimes (l2 n)
      (let ((k2j (-> *phys-joint* (+ (* sc PHYS-LINKS) l2))))
        (when (and (>= k2j 0) (or (= cj k2j) (= cj2 k2j))) (set! own #t))))
    own))

;; [NOTE-27] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-len-project! ((skel skeleton) (scl int) (l int) (kk int) (kp int) (nbone int)
                          (pt vector))
  "RAMENE LE LIEN SUR LA SPHERE DE SON ATTACHE — ROTATION, PAS TRANSLATION. `want` est la longueur
   Justification complete : [NOTE-315] de jak-hd-physics-NOTES.md."
  (when (and (zero? *phys-len-off*) (>= kp 0) (< (+ kp 1) nbone))
    (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
           (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
           (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
           (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                  (-> skel bones (+ kp 1) transform vector 3 x)))
           (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                  (-> skel bones (+ kp 1) transform vector 3 y)))
           (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                  (-> skel bones (+ kp 1) transform vector 3 z)))
           (want (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz)))))
           (ux (- (-> pt x) bx))
           (uy (- (-> pt y) by))
           (uz (- (-> pt z) bz))
           (ul (sqrtf (+ (* ux ux) (+ (* uy uy) (* uz uz))))))
      (when (and (> want 0.01) (> ul 0.0001))
        (let ((s (/ want ul)))
          (set! (-> pt x) (+ bx (* ux s)))
          (set! (-> pt y) (+ by (* uy s)))
          (set! (-> pt z) (+ bz (* uz s)))))))
  (none))

(defun phys-collide-chain ((skel skeleton) (sc int) (n int) (rlk int) (nbone int)
                           (nco int) (margin float) (sweeps int))
  (set! *phys-swc* (+ 1 *phys-swc*))
  (let ((slot (/ sc PHYS-CHAINS))
        (pt   (new 'stack-no-clear 'vector))
        (rest (new 'stack-no-clear 'vector))
        (off  (new 'stack-no-clear 'vector))
        (offs (new 'stack-no-clear 'vector))
        (bv   (new 'stack-no-clear 'vector))
        (pv   (new 'stack-no-clear 'vector))
        (ca   (new 'stack-no-clear 'vector))
        (cb   (new 'stack-no-clear 'vector))
        (ra   (new 'stack-no-clear 'vector))
        (rb   (new 'stack-no-clear 'vector))
        ;; [NOTE-269] les deux azimuts du veto de cote : celui de la pose d'auteur et celui du lien simule. -> jak-hd-physics-NOTES.md
        (ua   (new 'stack-no-clear 'vector))
        (ub   (new 'stack-no-clear 'vector))
        (nrm  (new 'stack-no-clear 'vector)))
    (dotimes (l n)
      (when (>= l rlk)
        (let* ((scl (+ (* sc PHYS-LINKS) l))
               (kk  (-> *phys-joint* scl))
               (rl  (-> *phys-lcr* scl))
               (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) (-> *phys-anchor* sc))))
          (when (and (>= kk 0) (< (+ kk 1) nbone))
            ;; [NOTE-147] LE CENTRE DU VOLUME, ET CE QUE « RIGIDE » VEUT DIRE ICI -> jak-hd-physics-NOTES.md
            (phys-link-off! skel scl kk off)
            (if (> l 0)
              (set-vector! bv (-> *phys-px* (- scl 1)) (-> *phys-py* (- scl 1))
                              (-> *phys-pz* (- scl 1)) 1.0)
              (if (and (>= kp 0) (< (+ kp 1) nbone))
                (vector-copy! bv (the-as vector (-> skel bones (+ kp 1) transform vector 3)))
                (set-vector! bv 0.0 0.0 0.0 1.0)))
            (set-vector! pv (-> *phys-px* scl) (-> *phys-py* scl) (-> *phys-pz* scl) 1.0)
            (phys-link-off-sim! skel scl kk kp nbone bv pv offs)
            (vector-copy! rest (the-as vector (-> skel bones (+ kk 1) transform vector 3)))
            (set! (-> rest x) (+ (-> rest x) (-> off x)))
            (set! (-> rest y) (+ (-> rest y) (-> off y)))
            (set! (-> rest z) (+ (-> rest z) (-> off z)))
            (set! (-> pt x) (+ (-> *phys-px* scl) (-> offs x)))
            (set! (-> pt y) (+ (-> *phys-py* scl) (-> offs y)))
            (set! (-> pt z) (+ (-> *phys-pz* scl) (-> offs z)))
            (set! (-> pt w) 1.0)
            ;; [NOTE-231] ---- DECISION 1 : QUI DECIDE POUR CE LIEN, CETTE FRAME ---------------------------- -> jak-hd-physics-NOTES.md
            (set! (-> *phys-lwin* scl) -1)
            ;; [NOTE-268] ARMEE (prio-off = 0) elle DESIGNE et ses compteurs comptent ; en mesure seule -> jak-hd-physics-NOTES.md
            (when (or (zero? *phys-prio-off*) (nonzero? *phys-prio-meas*))
              (let ((best 2000000000) (bres 0.0) (nviol 0) (lastci 0))
                (dotimes (ci nco)
                  (let* ((sco (+ (* slot PHYS-COLS) ci))
                         (cj  (-> *phys-cj* sco))
                         (cj2 (-> *phys-cj2* sco))
                         (own (phys-col-own? sc n cj cj2))
                         (selfpair (and own (nonzero? *phys-self-inject*))))
                    (when selfpair (set! own #f))
                    (when (and (not own) (>= cj 0) (< (+ cj 1) nbone))
                      (phys-col-now! skel sco cj cj2 nbone ca cb)
                      (when (not (phys-col-rest! sco ra rb))
                        (vector-copy! ra ca) (vector-copy! rb cb))
                      (let* ((cap?   (and (>= cj2 0) (< (+ cj2 1) nbone)))
                             (floors (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                         (-> *phys-cr2* sco) cap? nrm))
                             (floorc (phys-collide-depth rest rl ca cb (-> *phys-cr* sco)
                                                         (-> *phys-cr2* sco) cap? nrm))
                             (floor0 (if (> floorc floors) floorc floors))
                             (feff   (if selfpair 0.0 (phys-vol-floor sc floor0 (phys-vol-yield sc cj cj2))))
                             (dep    (phys-collide-depth pt rl ca cb (-> *phys-cr* sco)
                                                         (-> *phys-cr2* sco) cap? nrm)))
                        (when (> dep feff)
                          (+! nviol 1)
                          ;; [NOTE-245] ATTRIBUTION PAR VOLUME. On incremente d'abord tout violeur, et si le -> jak-hd-physics-NOTES.md
                          (set! lastci ci)
                          ;; [NOTE-267] `sc` PORTE DEJA LE SLOT (`sc = slot*PHYS-CHAINS + c`, cf. :922) : le -> jak-hd-physics-NOTES.md
                          (let ((h (+ (* sc PHYS-COLS) ci)))
                            (set! (-> *phys-cfh* h) (+ 1 (-> *phys-cfh* h))))
                          ;; [NOTE-110] [DECISION 1, critere revise 2026-08-18] Le decideur est LE PLUS PROFOND -> jak-hd-physics-NOTES.md
                          (let ((key (phys-col-key sco cj))
                                (rv  (- dep feff)))
                            (when (or (> rv bres)
                                      (and (= rv bres) (< key best)))
                              (set! bres rv)
                              (set! best key)
                              (set! (-> *phys-lwin* scl) sco))))))))
                (when (= nviol 1)
                  (let ((h (+ (* sc PHYS-COLS) lastci)))
                    (set! (-> *phys-cfh* h) (- (-> *phys-cfh* h) 1))))
                (when (> nviol 1)
                  (set! *phys-prio-multi* (+ *phys-prio-multi* 1))
                  (set! *phys-prio-n* (+ *phys-prio-n* (- nviol 1)))
                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 12))
                        (+ (the float (- nviol 1)) (-> *phys-dg* (+ (* sc PHYS-DG) 12)))))
                ;; [NOTE-177] MESURE SEULE : on a compte, on ne decide pas. Rendre `*phys-lwin*` a -1 remet le -> jak-hd-physics-NOTES.md
                (when (nonzero? *phys-prio-off*)
                  (set! (-> *phys-lwin* scl) -1))))
            (dotimes (sub sweeps)
              (dotimes (ci nco)
                (let* ((sco (+ (* slot PHYS-COLS) ci))
                       (cj  (-> *phys-cj* sco))
                       (cj2 (-> *phys-cj2* sco))
                       (own (phys-col-own? sc n cj cj2))
                       ;; [NOTE-244] DECISION 1 : les volumes que la priorite a ecartes sont IGNORES, pas -> jak-hd-physics-NOTES.md
                       (skip (and (zero? *phys-prio-off*)
                                  (>= (-> *phys-lwin* scl) 0)
                                  (!= sco (-> *phys-lwin* scl)))))
                  ;; [NOTE-98] ARME, le controle positif LEVE l'exclusion : le compteur `selfcol` doit alor -> jak-hd-physics-NOTES.md
                  (let ((selfpair (and own (nonzero? *phys-self-inject*))))
                  (when selfpair (set! own #f))
                  ;; [NOTE-109] L'ABLATION DU CYCLE 37 ETAPE 2, a zero en livraison.
                  (when (and (nonzero? *phys-prox-off*) (phys-col-prox? slot cj cj2))
                    (set! skip #t))
                  (when (and (not own) (not skip) (>= cj 0) (< (+ cj 1) nbone))
                    (phys-col-now! skel sco cj cj2 nbone ca cb)
                    ;; [NOTE-266] `floor0` contre le volume A SA POSE D'AUTEUR, `dep` contre sa position -> jak-hd-physics-NOTES.md
                    (when (not (phys-col-rest! sco ra rb))
                      (vector-copy! ra ca) (vector-copy! rb cb))
                    ;; [NOTE-28] LE PLANCHER SE MESURE CONTRE LES DEUX POSES DU VOLUME, ET ON GARDE LA PLUS -> jak-hd-physics-NOTES.md
                    (let* ((cap?   (and (>= cj2 0) (< (+ cj2 1) nbone))))
                      (let* ((floors (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                         (-> *phys-cr2* sco) cap? nrm))
                             (floorc (phys-collide-depth rest rl ca cb (-> *phys-cr* sco)
                                                         (-> *phys-cr2* sco) cap? nrm))
                             (floor0 (if (> floorc floors) floorc floors))
                             (feff   (if selfpair 0.0 (phys-vol-floor sc floor0 (phys-vol-yield sc cj cj2))))
                             (dep    (phys-collide-depth pt rl ca cb (-> *phys-cr* sco)
                                                         (-> *phys-cr2* sco) cap? nrm)))
                        ;; [NOTE-128] SPEC 33 — LE DOMAINE DE LA PAIRE -> jak-hd-physics-NOTES.md
                        ;; [NOTE-110] CYCLE 38 — `feff` ETAIT UNE DERNIERE VALEUR, `cdm` UN MAXIMUM -> jak-hd-physics-NOTES.md
                        (when (and (= sub 0) (zero? *phys-col-off*))
                          (let ((h (+ (* sc PHYS-COLS) ci)))
                            (cond
                              ((zero? (-> *phys-cdmok* h))
                               (set! (-> *phys-cfl* h) feff)
                               (set! (-> *phys-cdm* h) *phys-depsigned*)
                               (set! (-> *phys-cdmok* h) 1))
                              (else
                               (when (> feff (-> *phys-cfl* h))
                                 (set! (-> *phys-cfl* h) feff))
                               (when (> *phys-depsigned* (-> *phys-cdm* h))
                                 (set! (-> *phys-cdm* h) *phys-depsigned*))))))
                        (when (> dep feff)
                          (let ((push (+ (- dep feff) margin)))
                            ;; [NOTE-495] une correction issue d'un volume PROPRE a la chaine : elle ne peut -> jak-hd-physics-NOTES.md
                            (when (nonzero? *phys-self-inject*)
                              (when (phys-col-own? sc n cj cj2)
                                (set! (-> *phys-dg* (* sc PHYS-DG))
                                      (+ 1.0 (-> *phys-dg* (* sc PHYS-DG))))))
                            (set! (-> pt x) (+ (-> pt x) (* (-> nrm x) push)))
                            (set! (-> pt y) (+ (-> pt y) (* (-> nrm y) push)))
                            (set! (-> pt z) (+ (-> pt z) (* (-> nrm z) push)))
                            ;; [NOTE-143] SPEC 33/34 — ON NE FAIT QUE CUMULER ICI -> jak-hd-physics-NOTES.md
                            (set! (-> *phys-cpu* scl x) (+ (-> *phys-cpu* scl x) (* (-> nrm x) push)))
                            (set! (-> *phys-cpu* scl y) (+ (-> *phys-cpu* scl y) (* (-> nrm y) push)))
                            (set! (-> *phys-cpu* scl z) (+ (-> *phys-cpu* scl z) (* (-> nrm z) push)))
                            ;; [NOTE-230] [NOTE-97] L'INSTRUMENT DU CYCLE 36 : `cl` est le module de la somme -> jak-hd-physics-NOTES.md
                            (let* ((pb (* 7 scl))
                                   (swo (+ (* 3 (- *phys-swc* 1)) (+ sub 1))))
                              (set! (-> *phys-cpa* pb) (+ 1.0 (-> *phys-cpa* pb)))
                              (when (> push (-> *phys-cpa* (+ pb 1)))
                                (set! (-> *phys-cpa* (+ pb 1)) push))
                              (set! (-> *phys-cpa* (+ pb 2)) (+ push (-> *phys-cpa* (+ pb 2))))
                              (set! (-> *phys-cpa* (+ pb 3)) (the float swo))
                              ;; [NOTE-105] CYCLE 37 : LE GROUPE DE COLLISION SEULE (appels 12 a 15). -> jak-hd-physics-NOTES.md
                              (when (>= swo 34)
                                (set! (-> *phys-cpa* (+ pb 4)) (+ push (-> *phys-cpa* (+ pb 4))))
                                (set! (-> *phys-cpa* (+ pb 5)) (+ 1.0 (-> *phys-cpa* (+ pb 5)))))
                              (when (= (-> *phys-cpa* pb) 1.0)
                                (set! (-> *phys-cpa* (+ pb 6)) push))
                              ;; [NOTE-109] LE CUMUL PAR BRANCHE — un AGREGAT, pas un maximum.
                              (let ((qb (* 3 sc)))
                                (set! (-> *phys-cpc* qb) (+ 1.0 (-> *phys-cpc* qb)))
                                (set! (-> *phys-cpc* (+ qb 1)) (+ push (-> *phys-cpc* (+ qb 1))))
                                (when (>= swo 34)
                                  (set! (-> *phys-cpc* (+ qb 2))
                                        (+ push (-> *phys-cpc* (+ qb 2)))))))
                            (set! (-> *phys-cpe* scl)
                                  (if (nonzero? (-> *phys-csim* sco)) (-> *phys-pset* (+ (* sc PHYS-PSET-N) 14)) (-> *phys-pset* (+ (* sc PHYS-PSET-N) 15))))))
                        ;; [NOTE-29] ---------------------------------------------------------------- -> jak-hd-physics-NOTES.md
                        (when (and (zero? *phys-side-off*)
                                   (> floor0 0.0)
                                   (> dep 0.0)
                                   (phys-axis-dir rest ca cb ua)
                                   (phys-axis-dir pt ca cb ub))
                          (let ((dt0 (+ (* (-> ua x) (-> ub x))
                                        (+ (* (-> ua y) (-> ub y))
                                           (* (-> ua z) (-> ub z))))))
                            (when (< dt0 0.0)
                              (let ((cc (* dt0 (-> ub w))))
                                (set! (-> pt x) (- (-> pt x) (* cc (-> ua x))))
                                (set! (-> pt y) (- (-> pt y) (* cc (-> ua y))))
                                (set! (-> pt z) (- (-> pt z) (* cc (-> ua z))))))))))))))
              ;; [NOTE-149] LA LONGUEUR, A CHAQUE BALAYAGE -> jak-hd-physics-NOTES.md
              (set! (-> pt x) (- (-> pt x) (-> offs x)))
              (set! (-> pt y) (- (-> pt y) (-> offs y)))
              (set! (-> pt z) (- (-> pt z) (-> offs z)))
              (phys-len-project! skel scl l kk kp nbone pt)
              (set! (-> pt x) (+ (-> pt x) (-> offs x)))
              (set! (-> pt y) (+ (-> pt y) (-> offs y)))
              (set! (-> pt z) (+ (-> pt z) (-> offs z))))
            ;; [NOTE-496] retour aux coordonnees du JOINT : le solveur, la contrainte de longueur et l'ecriture -> jak-hd-physics-NOTES.md
            (set! (-> pt x) (- (-> pt x) (-> offs x)))
            (set! (-> pt y) (- (-> pt y) (-> offs y)))
            (set! (-> pt z) (- (-> pt z) (-> offs z)))
            ;; [NOTE-30] ------------------------------------------------------------------------------ -> jak-hd-physics-NOTES.md
            (dotimes (fin PHYS-FIN-ITERS)
              ;; [NOTE-142] UNE SEULE PASSE SUR LES VOLUMES, DEUX CORRECTIONS -> jak-hd-physics-NOTES.md
              (let ((qx (+ (-> pt x) (-> offs x)))
                    (qy (+ (-> pt y) (-> offs y)))
                    (qz (+ (-> pt z) (-> offs z))))
                (dotimes (ci nco)
                  (let* ((sco (+ (* slot PHYS-COLS) ci))
                         (cj  (-> *phys-cj* sco))
                         (cj2 (-> *phys-cj2* sco))
                         (ownr (phys-col-own? sc n cj cj2))
                         (selfp (and ownr (nonzero? *phys-self-inject*))))
                    (when (and (or (not ownr) selfp) (>= cj 0) (< (+ cj 1) nbone))
                      (phys-col-now! skel sco cj cj2 nbone ca cb)
                      (when (not (phys-col-rest! sco ra rb))
                        (vector-copy! ra ca) (vector-copy! rb cb))
                      (let* ((cap? (and (>= cj2 0) (< (+ cj2 1) nbone)))
                             (fs (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                     (-> *phys-cr2* sco) cap? nrm))
                             (fc (phys-collide-depth rest rl ca cb (-> *phys-cr* sco)
                                                     (-> *phys-cr2* sco) cap? nrm))
                             (fe (if selfp 0.0
                                   (phys-vol-floor sc (if (> fc fs) fc fs)
                                                   (phys-vol-yield sc cj cj2)))))
                        (set-vector! pv qx qy qz 1.0)
                        (let ((fq (phys-collide-depth pv rl ca cb (-> *phys-cr* sco)
                                                      (-> *phys-cr2* sco) cap? nrm)))
                          ;; --- (a1) LA PROFONDEUR, POUSSEE **TANGENTIELLEMENT** A LA SPHERE
                          ;; --- DE L'ATTACHE. [NOTE-61] -> jak-hd-physics-NOTES.md
                          (when (> fq fe)
                            (let* ((ex (- (- qx (-> offs x)) (-> bv x)))
                                   (ey (- (- qy (-> offs y)) (-> bv y)))
                                   (ez (- (- qz (-> offs z)) (-> bv z)))
                                   (en (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez))))))
                              (when (> en 0.0001)
                                (let* ((iv (/ 1.0 en))
                                       (ux (* ex iv)) (uy (* ey iv)) (uz (* ez iv))
                                       (dd (- fq fe))
                                       (cn (+ (* (-> nrm x) ux)
                                              (+ (* (-> nrm y) uy) (* (-> nrm z) uz))))
                                       ;; [NOTE-125] LE PAS CORRIGE A ETE ESSAYE PUIS RETIRE SUR MESURE (cycle 47). -> jak-hd-physics-NOTES.md
                                       (s2 (- 1.0 (* cn cn)))
                                       (s  (sqrtf (if (> s2 0.0) s2 0.0))))
                                  (set! qx (+ qx (* dd (- (-> nrm x) (* cn ux)))))
                                  (set! qy (+ qy (* dd (- (-> nrm y) (* cn uy)))))
                                  (set! qz (+ qz (* dd (- (-> nrm z) (* cn uz)))))
                                  (set! *phys-tan-n* (+ *phys-tan-n* 1))
                                  (set! *phys-tan-d* (+ *phys-tan-d* dd))
                                  ;; [NOTE-497] `dd * s^2` = ce que le pas retire REELLEMENT. Le rapport -> jak-hd-physics-NOTES.md
                                  (set! *phys-tan-e* (+ *phys-tan-e* (* dd s2)))
                                  ;; [NOTE-125] LES TROIS SONDES, INERTES SUR LA TRAJECTOIRE. -> jak-hd-physics-NOTES.md
                                  (when (> s 0.0001)
                                    (let ((stp (let ((v (/ dd s))) (if (> v en) en v))))
                                      (set! *phys-tan-o* (+ *phys-tan-o* (* stp s)))))
                                  (when (> dd (* en (- 1.0 cn)))
                                    (set! *phys-tan-c* (+ *phys-tan-c* 1))
                                    (set! *phys-tan-cs* (+ *phys-tan-cs* dd))
                                    (let ((rg (- (+ cn (/ dd en)) 1.0)))
                                      (when (> rg *phys-tan-cg*) (set! *phys-tan-cg* rg))))))))
                          ;; [NOTE-265] --- (a2) LE FRANCHISSEMENT D'AXE. Deux conditions, pas une : la pose -> jak-hd-physics-NOTES.md
                          (when (and (zero? *phys-side-off*) (not ownr)
                                     (> (if (> fc fs) fc fs) 0.0) (> fq 0.0))
                            (set-vector! pv qx qy qz 1.0)
                            (when (and (phys-axis-dir rest ca cb ua)
                                       (phys-axis-dir pv ca cb ub))
                              (let ((dt1 (+ (* (-> ua x) (-> ub x))
                                            (+ (* (-> ua y) (-> ub y))
                                               (* (-> ua z) (-> ub z))))))
                                (when (< dt1 0.0)
                                  (let ((cc (* dt1 (-> ub w))))
                                    (set! qx (- qx (* cc (-> ua x))))
                                    (set! qy (- qy (* cc (-> ua y))))
                                    (set! qz (- qz (* cc (-> ua z))))))))))))))
                (set! (-> pt x) (- qx (-> offs x)))
                (set! (-> pt y) (- qy (-> offs y)))
                (set! (-> pt z) (- qz (-> offs z))))
              ;; [NOTE-498] --- (b) LA LONGUEUR, et c'est la DERNIERE operation de la boucle, donc du -> jak-hd-physics-NOTES.md
              (phys-len-project! skel scl l kk kp nbone pt))
            (phys-link-off-sim! skel scl kk kp nbone bv pt ra)   ;; [NOTE-147] MESURE SEULE
            (let* ((ox (- (-> ra x) (-> offs x))) (oy (- (-> ra y) (-> offs y)))
                   (oz (- (-> ra z) (-> offs z)))
                   (mo (sqrtf (+ (* ox ox) (+ (* oy oy) (* oz oz))))))
              (when (> mo (-> *phys-dg* (+ (* sc PHYS-DG) 16)))
                (set! (-> *phys-dg* (+ (* sc PHYS-DG) 16)) mo)))
            (set! (-> *phys-px* scl) (-> pt x))
            (set! (-> *phys-py* scl) (-> pt y))
            (set! (-> *phys-pz* scl) (-> pt z)))))))
  (none))

;; [NOTE-165] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defun phys-popcount ((v int))
  "nombre de bits a 1 dans les 32 bits bas de v."
  (let ((c 0) (x (logand v #xffffffff)))
    (while (nonzero? x)
      (+! c (the int (logand x 1)))
      (set! x (shr x 1)))
    c))

(defun phys-flip-count ((skel skeleton) (sc int) (n int) (rlk int) (nbone int) (nco int))
  (let ((slot (/ sc PHYS-CHAINS))
        (rest (new 'stack-no-clear 'vector))
        (cur  (new 'stack-no-clear 'vector))
        (off  (new 'stack-no-clear 'vector))
        (ca   (new 'stack-no-clear 'vector))
        (cb   (new 'stack-no-clear 'vector))
        (ra   (new 'stack-no-clear 'vector))
        (rb   (new 'stack-no-clear 'vector))
        (nrm  (new 'stack-no-clear 'vector)))
    (dotimes (l n)
      (when (>= l rlk)
        (let* ((scl (+ (* sc PHYS-LINKS) l))
               (kk  (-> *phys-joint* scl))
               (rl  (-> *phys-lcr* scl)))
          (when (and (>= kk 0) (< (+ kk 1) nbone))
            (phys-link-off! skel scl kk off)
            (vector-copy! rest (the-as vector (-> skel bones (+ kk 1) transform vector 3)))
            (set! (-> rest x) (+ (-> rest x) (-> off x)))
            (set! (-> rest y) (+ (-> rest y) (-> off y)))
            (set! (-> rest z) (+ (-> rest z) (-> off z)))
            (set! (-> cur x) (+ (-> *phys-px* scl) (-> off x)))
            (set! (-> cur y) (+ (-> *phys-py* scl) (-> off y)))
            (set! (-> cur z) (+ (-> *phys-pz* scl) (-> off z)))
            (set! (-> cur w) 1.0)
            (let ((w0 0) (w1 0) (w2 0))
              (dotimes (ci (min nco (* 32 PHYS-FLIPW)))
                (let* ((sco (+ (* slot PHYS-COLS) ci))
                       (cj  (-> *phys-cj* sco))
                       (cj2 (-> *phys-cj2* sco))
                       (bit 0))
                  (when (and (not (phys-col-own? sc n cj cj2)) (>= cj 0) (< (+ cj 1) nbone))
                    (phys-col-now! skel sco cj cj2 nbone ca cb)
                    (when (not (phys-col-rest! sco ra rb))
                      (vector-copy! ra ca) (vector-copy! rb cb))
                    ;; [NOTE-176] L'ETAT SUIVI EST « EN CONTACT », plus « contraint ou libre ». Depuis que la -> jak-hd-physics-NOTES.md
                    (let* ((cap?   (and (>= cj2 0) (< (+ cj2 1) nbone)))
                           (floor0 (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                       (-> *phys-cr2* sco) cap? nrm))
                           (dep    (phys-collide-depth cur rl ca cb (-> *phys-cr* sco)
                                                       (-> *phys-cr2* sco) cap? nrm)))
                      (when (or (> floor0 0.0) (> dep 0.0)) (set! bit 1))))
                  (when (nonzero? bit)
                    (cond
                      ((< ci 32)  (set! w0 (logior w0 (ash 1 ci))))
                      ((< ci 64)  (set! w1 (logior w1 (ash 1 (- ci 32)))))
                      (else       (set! w2 (logior w2 (ash 1 (- ci 64)))))))))
              (let ((fb (* scl PHYS-FLIPW)))
                (when (nonzero? (-> *phys-flhas* scl))
                  (let ((ch (+ (phys-popcount (logxor w0 (-> *phys-fl* fb)))
                               (+ (phys-popcount (logxor w1 (-> *phys-fl* (+ fb 1))))
                                  (phys-popcount (logxor w2 (-> *phys-fl* (+ fb 2))))))))
                    (when (> ch 0)
                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 2))
                            (+ (the float ch) (-> *phys-dg* (+ (* sc PHYS-DG) 2)))))))
                (set! (-> *phys-fl* fb) w0)
                (set! (-> *phys-fl* (+ fb 1)) w1)
                (set! (-> *phys-fl* (+ fb 2)) w2)
                (set! (-> *phys-flhas* scl) 1))))))))
  (none))

;; [NOTE-175] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
(defconstant PHYS-SD-K 8)    ;; [NOTE-242] combien de plans entrent dans l'estimateur
(define *phys-sdk-d* (new 'global 'array 'float PHYS-SD-K))   ;; d^2 des K plus proches, croissant
(define *phys-sdk-v* (new 'global 'array 'float PHYS-SD-K))   ;; leur distance au plan, meme ordre
(define *phys-sdk-n* (new 'global 'inline-array 'vector PHYS-SD-K))  ;; leur normale monde

(defun phys-surf-sd ((skel skeleton) (slot int) (p vector) (nbone int))
  "(SPEC 18) distance SIGNEE a la vraie surface skinnee. Docstring integrale : [NOTE-509] de jak-hd-physics-NOTES.md."
  (let ((qw (new 'stack-no-clear 'vector))
        (nw (new 'stack-no-clear 'vector))
        (dv (new 'stack-no-clear 'vector))
        (nm (new 'stack-no-clear 'vector))
        (og (new 'stack-no-clear 'vector))
        (m  0)
        (sb (* slot PHYS-BSURF-SETS)))
    (dotimes (i PHYS-SD-K) (set! (-> *phys-sdk-d* i) 1000000000000.0))
    (set-vector! *phys-sdq* 0.0 0.0 0.0 1.0)
    ;; [NOTE-499] [NOTE-293] LA FENETRE DE LECTURE. lo=0 / hi=-1 (les valeurs par defaut, jamais modifiees -> jak-hd-physics-NOTES.md
    (dotimes (sq (- (if (< *phys-sd-hi* 0) (-> *phys-slot-nbsurf* slot) *phys-sd-hi*)
                    *phys-sd-lo*))
      (let* ((s (+ sq *phys-sd-lo*))
             (k (-> *phys-bsk* (+ sb s))))
        (when (and (>= k 0) (< (+ k 1) nbone))
          (let ((bm (the-as matrix (-> skel bones (+ k 1) transform)))
                (sl (-> *phys-bssl* (+ sb s))))
            (if (and (>= sl 0) (zero? *phys-sd-auth*))
              (set-vector! og (-> *phys-px* sl) (-> *phys-py* sl) (-> *phys-pz* sl) 1.0)
              (vector-copy! og (the-as vector (-> bm vector 3))))
            (vector-! dv p og)
            (set! (-> dv w) 0.0)
            ;; [NOTE-413] PHASE LARGE EXACTE : on n'ecarte un ensemble que s'il ne peut contenir AUCUN -> jak-hd-physics-NOTES.md
            (when (< (- (vector-length dv) (-> *phys-bsr* (+ sb s)))
                     (sqrtf (-> *phys-sdk-d* (- PHYS-SD-K 1))))
              (dotimes (q (-> *phys-bsn* (+ sb s)))
                (let ((qi (+ (* (+ sb s) PHYS-BSURF-MAX) q)))
                  (vector-rotate*! qw (-> *phys-bsp* qi) bm)
                  (set! (-> qw w) 0.0)
                  (vector+! qw qw og)
                  (vector-! dv p qw)
                  (set! (-> dv w) 0.0)
                  (when (zero? *phys-sd-quiet*) (+! *phys-skintest* 1))
                  (let ((d2 (vector-dot dv dv)))
                    (when (< d2 (-> *phys-sdk-d* (- PHYS-SD-K 1)))
                      (vector-rotate*! nw (-> *phys-bsnm* qi) bm)
                      (set! (-> nw w) 0.0)
                      (let ((nl (vector-length nw)))
                        (when (> nl 0.000001)
                          (vector-float*! nw nw (/ 1.0 nl))
                          ;; [NOTE-500] insertion triee : le K-voisinage reste ordonne par distance, donc le -> jak-hd-physics-NOTES.md
                          (when (< d2 (-> *phys-sdk-d* 0)) (vector-copy! *phys-sdq* qw))
                          (let ((pos (- PHYS-SD-K 1)))
                            (while (and (> pos 0) (> (-> *phys-sdk-d* (- pos 1)) d2))
                              (set! (-> *phys-sdk-d* pos) (-> *phys-sdk-d* (- pos 1)))
                              (set! (-> *phys-sdk-v* pos) (-> *phys-sdk-v* (- pos 1)))
                              (vector-copy! (-> *phys-sdk-n* pos) (-> *phys-sdk-n* (- pos 1)))
                              (set! pos (- pos 1)))
                            (set! (-> *phys-sdk-d* pos) d2)
                            (set! (-> *phys-sdk-v* pos) (vector-dot dv nw))
                            (vector-copy! (-> *phys-sdk-n* pos) nw))
                          (when (< m PHYS-SD-K) (set! m (+ m 1))))))))))))))
    (set! *phys-sd-d1* (if (zero? m) 1000000.0 (sqrtf (-> *phys-sdk-d* 0))))
    (cond
      ((zero? m) 1000000.0)
      ((= m 1) (vector-copy! *phys-sdn* (-> *phys-sdk-n* 0)) (-> *phys-sdk-v* 0))
      (else
        ;; le rayon du noyau EST la distance au dernier voisin retenu : il s'adapte a la densite
        ;; locale, et le poids qui s'y annule est ce qui rend la fonction continue.
        (let ((h2 (-> *phys-sdk-d* (- m 1)))
              (sw 0.0)
              (sv 0.0))
          (set-vector! nm 0.0 0.0 0.0 0.0)
          (dotimes (i m)
            (let* ((t (if (> h2 0.0) (- 1.0 (/ (-> *phys-sdk-d* i) h2)) 1.0))
                   (w (* t t)))
              (set! sw (+ sw w))
              (set! sv (+ sv (* w (-> *phys-sdk-v* i))))
              (set! (-> nm x) (+ (-> nm x) (* w (-> *phys-sdk-n* i x))))
              (set! (-> nm y) (+ (-> nm y) (* w (-> *phys-sdk-n* i y))))
              (set! (-> nm z) (+ (-> nm z) (* w (-> *phys-sdk-n* i z))))))
          (cond
            ((< sw 0.000001)
             ;; les m voisins sont a la MEME distance : le noyau s'annule partout et la moyenne
             ;; ponderee n'est pas definie. On rend le plus proche, sans inventer de poids.
             (vector-copy! *phys-sdn* (-> *phys-sdk-n* 0))
             (-> *phys-sdk-v* 0))
            (else
              (let ((ln (vector-length nm)))
                (if (> ln 0.000001)
                  (vector-float*! *phys-sdn* nm (/ 1.0 ln))
                  (vector-copy! *phys-sdn* (-> *phys-sdk-n* 0))))
              (/ sv sw))))))))

(defun phys-skin-chain ((skel skeleton) (sc int) (n int) (rlk int) (nbone int))
  "SPEC 33/34 — la peau ne rentre pas dans le corps. Docstring integrale : [NOTE-520] de jak-hd-physics-NOTES.md."
  (when (zero? *phys-skin-off*)
    (set! *phys-sd-quiet* 1)
    (let ((ap  (new 'stack-no-clear 'vector))
          (sp  (new 'stack-no-clear 'vector))
          (nb  (new 'stack-no-clear 'vector)))
      (dotimes (l n)
        (when (>= l rlk)
          (let* ((scl (+ (* sc PHYS-LINKS) l))
                 (kk  (-> *phys-joint* scl))
                 (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) (-> *phys-anchor* sc))))
            (when (and (>= kk 0) (< (+ kk 1) nbone) (> (-> *phys-msn* scl) 0)
                       (or (> l 0) (and (>= kp 0) (< (+ kp 1) nbone))))
              (let ((bx (if (> l 0) (-> *phys-px* (- scl 1))
                          (-> skel bones (+ kp 1) transform vector 3 x)))
                    (by (if (> l 0) (-> *phys-py* (- scl 1))
                          (-> skel bones (+ kp 1) transform vector 3 y)))
                    (bz (if (> l 0) (-> *phys-pz* (- scl 1))
                          (-> skel bones (+ kp 1) transform vector 3 z)))
                    (ox (-> *phys-px* scl)) (oy (-> *phys-py* scl)) (oz (-> *phys-pz* scl)))
                (dotimes (q (-> *phys-msn* scl))
                  (vector-rotate*! ap (-> *phys-msp* (+ (* scl PHYS-MS-MAX) q))
                                   (the-as matrix (-> skel bones (+ kk 1) transform)))
                  (set! (-> ap w) 0.0)
                  (set-vector! sp (+ (-> skel bones (+ kk 1) transform vector 3 x) (-> ap x))
                                  (+ (-> skel bones (+ kk 1) transform vector 3 y) (-> ap y))
                                  (+ (-> skel bones (+ kk 1) transform vector 3 z) (-> ap z)) 1.0)
                  (set! (-> *phys-saq* q) (phys-surf-sd skel (/ sc PHYS-CHAINS) sp nbone)))
                (dotimes (it 7)
                  (let ((bv 0.0) (bq -1))
                    (dotimes (q (-> *phys-msn* scl))
                      (let ((sa (-> *phys-saq* q)))
                        (when (< (fabs sa) 100000.0)
                          (vector-rotate*! ap (-> *phys-msp* (+ (* scl PHYS-MS-MAX) q))
                                           (the-as matrix (-> skel bones (+ kk 1) transform)))
                          (set! (-> ap w) 0.0)
                          (set-vector! sp (+ (-> *phys-px* scl) (-> ap x))
                                          (+ (-> *phys-py* scl) (-> ap y))
                                          (+ (-> *phys-pz* scl) (-> ap z)) 1.0)
                          (let ((sd (phys-surf-sd skel (/ sc PHYS-CHAINS) sp nbone)))
                            (when (< (fabs sd) 100000.0)
                              ;; [NOTE-291] [NOTE-483] LE PLAFOND DE DEPLACEMENT : SON MODULE, PLUS SA COMPOSANTE NORMALE (cycle 106, mesure co-localisee) -> jak-hd-physics-NOTES.md
                              (let* ((dx (- ox (-> skel bones (+ kk 1) transform vector 3 x)))
                                     (dy (- oy (-> skel bones (+ kk 1) transform vector 3 y)))
                                     (dz (- oz (-> skel bones (+ kk 1) transform vector 3 z)))
                                     (dn (+ (* dx (-> *phys-sdn* x))
                                            (+ (* dy (-> *phys-sdn* y)) (* dz (-> *phys-sdn* z)))))
                                     (v  (fmin (- (fmin 0.0 sa) sd) (- 0.0 dn))))
                                (when (> v bv)
                                  (set! bv v)
                                  (set! bq q)
                                  (vector-copy! nb *phys-sdn*)) (when (and (= it 6) (> (- (fmin 0.0 sa) sd) (-> *phys-skl* (+ (* sc 20) 15)))) (set! (-> *phys-skl* (+ (* sc 20) 15)) (- (fmin 0.0 sa) sd)) (set! (-> *phys-skl* (+ (* sc 20) 16)) (- 0.0 dn)) (set! (-> *phys-skl* (+ (* sc 20) 17)) (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))) (set! (-> *phys-skl* (+ (* sc 20) 18)) (the float l)) (set! (-> *phys-skl* (+ (* sc 20) 19)) v))))))))
                    ;; [NOTE-414] LA 7e PASSE NE CORRIGE PAS, ELLE MESURE : `*phys-skc-r*` est la pire -> jak-hd-physics-NOTES.md
                    (when (= it 6) (when (> bv *phys-skc-r*) (set! *phys-skc-r* bv)) (let ((sk (* sc 20))) (when (> bv (-> *phys-skl* (+ sk 10))) (set! (-> *phys-skl* (+ sk 10)) bv) (set! (-> *phys-skl* (+ sk 11)) (the float l)))))
                    ;; [NOTE-521] instrument PUR : renversements de la DIRECTION de poussee entre deux appels consecutifs. -> jak-hd-physics-NOTES.md
                    (when (and (= it 0) (>= bq 0)) (let ((pv (-> *phys-sdnp* scl)) (ci (* 2 scl))) (when (> (+ (* (-> pv x) (-> pv x)) (+ (* (-> pv y) (-> pv y)) (* (-> pv z) (-> pv z)))) 0.5) (+! (-> *phys-nflip* (+ ci 1)) 1.0) (when (< (+ (* (-> nb x) (-> pv x)) (+ (* (-> nb y) (-> pv y)) (* (-> nb z) (-> pv z)))) 0.0) (+! (-> *phys-nflip* ci) 1.0))) (vector-copy! pv nb)))
                    (when (and (>= bq 0) (< it 6))
                      (let* ((ux (- (-> *phys-px* scl) bx))
                             (uy (- (-> *phys-py* scl) by))
                             (uz (- (-> *phys-pz* scl) bz))
                             (ln (sqrtf (+ (* ux ux) (+ (* uy uy) (* uz uz))))))
                        (when (> ln 0.0001)
                          (let* ((iv (/ 1.0 ln))
                                 (hx (* ux iv)) (hy (* uy iv)) (hz (* uz iv))
                                 (cn (+ (* (-> nb x) hx) (+ (* (-> nb y) hy) (* (-> nb z) hz))))
                                 (s2 (- 1.0 (* cn cn)))
                                 (pp (sqrtf (fmax 0.0 s2))))
                            ;; [NOTE-482] LE LEVIER, LU LA OU LA CORRECTION SE DECIDE — instrument pur, il n'ecrit aucun etat du solveur. -> jak-hd-physics-NOTES.md
                            (let ((sk (* sc 20))) (when (> bv (-> *phys-skl* sk)) (set! (-> *phys-skl* sk) bv) (set! (-> *phys-skl* (+ sk 1)) (the float l)) (set! (-> *phys-skl* (+ sk 2)) pp) (set! (-> *phys-skl* (+ sk 3)) ln) (set! (-> *phys-skl* (+ sk 4)) (/ bv (fmax 0.0001 (* pp ln))))) (+! (-> *phys-skl* (+ sk 9)) 1.0) (when (<= pp 0.05) (+! (-> *phys-skl* (+ sk 5)) 1.0) (+! (-> *phys-skl* (+ sk 6)) bv) (when (> bv (-> *phys-skl* (+ sk 7))) (set! (-> *phys-skl* (+ sk 7)) bv) (set! (-> *phys-skl* (+ sk 8)) (the float l)))))
                            (when (> pp 0.05)
                              (let* ((tx (/ (- (-> nb x) (* cn hx)) pp))
                                     (ty (/ (- (-> nb y) (* cn hy)) pp))
                                     (tz (/ (- (-> nb z) (* cn hz)) pp))
                                     (kr (fmin 0.5 (/ bv (* pp ln))))
                                     (rn (/ ln (sqrtf (+ 1.0 (* kr kr))))))
                                (set! (-> *phys-px* scl) (+ bx (* rn (+ hx (* kr tx)))))
                                (set! (-> *phys-py* scl) (+ by (* rn (+ hy (* kr ty)))))
                                (set! (-> *phys-pz* scl) (+ bz (* rn (+ hz (* kr tz)))))
                                (set! *phys-skc-n* (+ *phys-skc-n* 1))
                                (set! *phys-skc-d* (+ *phys-skc-d* bv))
                                (when (> bv *phys-skc-w*) (set! *phys-skc-w* bv))))))))))
                (let ((ddx (- (-> *phys-px* scl) ox))
                      (ddy (- (-> *phys-py* scl) oy))
                      (ddz (- (-> *phys-pz* scl) oz)))
                  (when (> (+ (* ddx ddx) (+ (* ddy ddy) (* ddz ddz))) 0.0000001)
                    (set! (-> *phys-cpu* scl x) (+ (-> *phys-cpu* scl x) ddx))
                    (set! (-> *phys-cpu* scl y) (+ (-> *phys-cpu* scl y) ddy))
                    (set! (-> *phys-cpu* scl z) (+ (-> *phys-cpu* scl z) ddz))
                    (when (= (-> *phys-cpe* scl) 0.0)
                      (set! (-> *phys-cpe* scl) (-> *phys-pset* (+ (* sc PHYS-PSET-N) 15)))))))))))
      (set! *phys-sd-quiet* 0)))
  (none))

(defun phys-cap-e22! ((skel skeleton) (sc int) (n int) (rlk int) (an int) (nbone int))
  "SPEC 22, ALTERNEE AVEC LA PEAU (cycle 104). Docstring integrale : [NOTE-506] de jak-hd-physics-NOTES.md."
  (when (zero? *phys-e22-off*)
    (dotimes (l n)
      (when (>= l rlk)
        (let* ((scl (+ (* sc PHYS-LINKS) l))
               (kk  (-> *phys-joint* scl))
               (kp  (if (> l rlk) (-> *phys-joint* (- scl 1)) an))
               (b0f (if (> (-> *phys-b0* sc) 0.0) (-> *phys-b0* sc) (-> *phys-blen* scl))))
          (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone) (> b0f 0.01))
            (let* ((bx (if (> l rlk) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                   (by (if (> l rlk) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                   (bz (if (> l rlk) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                   (tx (+ (-> skel bones (+ kk 1) transform vector 3 x)
                          (if (> l rlk) (- bx (-> skel bones (+ kp 1) transform vector 3 x)) 0.0)))
                   (ty (+ (-> skel bones (+ kk 1) transform vector 3 y)
                          (if (> l rlk) (- by (-> skel bones (+ kp 1) transform vector 3 y)) 0.0)))
                   (tz (+ (-> skel bones (+ kk 1) transform vector 3 z)
                          (if (> l rlk) (- bz (-> skel bones (+ kp 1) transform vector 3 z)) 0.0)))
                   (rlb (-> *phys-blen* (+ (* sc PHYS-LINKS) rlk)))
                   (rl  (if (> rlb 0.01) (fmin 1.0 (/ (-> *phys-blen* scl) rlb)) 1.0))
                   (kn  (* (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 16)) b0f) rl))
                   (cp  (* (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 17)) b0f) rl))
                   (ex  (- (-> *phys-px* scl) tx))
                   (ey  (- (-> *phys-py* scl) ty))
                   (ez  (- (-> *phys-pz* scl) tz))
                   (dd  (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez))))))
              ;; MEME GENOU, MEME ASYMPTOTE, MEME TANH DE PADE QUE LE FILET AMONT. Le duplicat est
              ;; assume : factoriser ferait bouger la course DESARMEE et detruirait son controle.
              (when (and (> dd kn) (> cp 0.0001))
                (let* ((xr (/ (- dd kn) cp))
                       (th (if (>= xr 3.0)
                             1.0
                             (/ (* xr (+ 27.0 (* xr xr))) (+ 27.0 (* 9.0 (* xr xr))))))
                       (ds (+ kn (* cp th)))
                       (ux (- (-> *phys-px* scl) bx))
                       (uy (- (-> *phys-py* scl) by))
                       (uz (- (-> *phys-pz* scl) bz))
                       (ln (sqrtf (+ (* ux ux) (+ (* uy uy) (* uz uz)))))
                       (cx (- tx bx)) (cy (- ty by)) (cz (- tz bz))
                       (cl (sqrtf (+ (* cx cx) (+ (* cy cy) (* cz cz))))))
                  (when (and (> ln 0.0001) (> cl 0.0001))
                    ;; [NOTE-465] `p` vit sur la sphere de rayon `ln` centree sur l'attache ; `|p - t|` n'y -> jak-hd-physics-NOTES.md
                    (let* ((gx (/ cx cl)) (gy (/ cy cl)) (gz (/ cz cl))
                           (hx (/ ux ln)) (hy (/ uy ln)) (hz (/ uz ln))
                           (ca (+ (* hx gx) (+ (* hy gy) (* hz gz))))
                           (cb (fmin 1.0 (/ (- (+ (* ln ln) (* cl cl)) (* ds ds)) (* 2.0 (* ln cl)))))
                           (wx (- hx (* ca gx))) (wy (- hy (* ca gy))) (wz (- hz (* ca gz)))
                           (wl (sqrtf (+ (* wx wx) (+ (* wy wy) (* wz wz))))))
                      (when (and (> cb ca) (> wl 0.0001))
                        (let ((sb (/ (sqrtf (fmax 0.0 (- 1.0 (* cb cb)))) wl)))
                          (set! (-> *phys-px* scl) (+ bx (* ln (+ (* cb gx) (* sb wx)))))
                          (set! (-> *phys-py* scl) (+ by (* ln (+ (* cb gy) (* sb wy)))))
                          (set! (-> *phys-pz* scl) (+ bz (* ln (+ (* cb gz) (* sb wz)))))
                          (set! *phys-e22-n* (+ *phys-e22-n* 1))
                          (set! *phys-e22-d* (+ *phys-e22-d* (/ (- dd ds) b0f)))))))))))))))
  (none))

(defun phys-skinpen-worst ((slot int) (chain int))
  "La pire entree SOUS la peau vue sur la fenetre, en unites de jeu, ou 0 si le lien est reste
   dehors. A lire A COTE de `meshpen` : celui-ci mesure contre les VOLUMES (29.7 % de la
   geometrie), celui-la contre la PEAU."
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-skinpen* (+ (* slot PHYS-CHAINS) chain))
    0.0))

(defun phys-skinpen-reset! ()
  (set! *phys-skintest* 0)
  (set! *phys-skinout* 0)
  (dotimes (i PHYS-SC)
    (set! (-> *phys-skinpen* i) 0.0)
    (set! (-> *phys-skinadd* i) 0.0)
    (set! (-> *phys-skinrest* i) 0.0)
    (set! (-> *phys-skinmiss* i) 0.0)
    ;; la mesure mediale partage la fenetre de la peau : un seul reset, donc jamais deux
    ;; populations sous un meme rapport (`ratio-of-two-statistics`, deja paye au cycle 61).
    (set! (-> *phys-medgap* i) 1000000.0)
    (set! (-> *phys-medgapa* i) 1000000.0)
    (set! (-> *phys-medpen* i) 0.0)
    (set! (-> *phys-medrest* i) 0.0)
    (set! (-> *phys-medn* i) 0.0)
    (set! (-> *phys-medfar* i) 0.0)
    (set! (-> *phys-medgapi* i) 1000000.0))
  (none))

(defun phys-med-inject-set! ((v float))
  "L'INJECTION DU CONTROLE POSITIF DE SPEC 33, en FRACTION SANS DIMENSION de l'approche (0 < v < 1).
   Reponse attendue `gapi = (1 - v) x gap` : une PREDICTION quantitative, evaluable sur TOUTE
   fenetre. Voir [NOTE-321]."
  (set! *phys-med-inj* v)
  (none))

(defun phys-med-inject-get () *phys-med-inj*)

(defun phys-other-surf-chain ((sc int))
  "L'index `sc` de l'AUTRE chaine du meme slot qui porte une surface, ou -1 s'il n'y en a pas.
   C'est ce qui rend l'exclusion de SOI structurelle : une chaine n'interroge jamais ses propres
   ensembles, et le fichier de donnees n'a aucun drapeau a porter."
  (let ((slot (/ sc PHYS-CHAINS))
        (r -1))
    (dotimes (cc PHYS-CHAINS)
      (let ((o (+ (* slot PHYS-CHAINS) cc)))
        (when (and (!= o sc) (> (-> *phys-bscn* o) 0) (< r 0)) (set! r o))))
    r))

(defun phys-medial ((slot int) (chain int) (which int))
  "SPEC 33, par chaine. 0 = ecart minimal SIMULE, 1 = ecart minimal AUTEUR, 2 = penetration
   SIMULEE, 3 = penetration AUTEUR, 4 = lectures valides. La sentinelle 1000000.0 sur 0/1 veut
   dire « aucune lecture », ce qui n'est PAS « ecart nul »."
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (let ((i (+ (* slot PHYS-CHAINS) chain)))
      (cond ((= which 0) (-> *phys-medgap* i))
            ((= which 1) (-> *phys-medgapa* i))
            ((= which 2) (-> *phys-medpen* i))
            ((= which 3) (-> *phys-medrest* i))
            ((= which 4) (-> *phys-medn* i))
            ((= which 5) (-> *phys-medfar* i))
            ((= which 6) (-> *phys-bssp* i))
            (else (-> *phys-medgapi* i))))
    0.0))

(defun phys-skinrest-worst ((slot int) (chain int))
  "LA LIGNE DE BASE AU REPOS de SPEC 33/34 : la profondeur sous la peau du point que L'AUTEUR a
   dessine, MEME frame, MEME surface, MEME lien. « Physique desarmee » au sens exact du terme —
   la pose d'auteur EST la pose sans physique. Voir [NOTE-154]."
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-skinrest* (+ (* slot PHYS-CHAINS) chain))
    0.0))

(defun phys-skinout-count () *phys-skinout*)

(defun phys-skinmiss-count ((slot int) (chain int))
  "[NOTE-157] Combien d'evaluations n'ont trouve AUCUN echantillon a portee. Un `skinpen` de 0
   accompagne d'un compte non nul n'est pas une mesure, c'est un trou — et se lit comme tel."
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-skinmiss* (+ (* slot PHYS-CHAINS) chain))
    0.0))

(defun phys-skinadd-worst ((slot int) (chain int))
  "La pire profondeur AJOUTEE sous la peau par la physique sur la fenetre, en unites de jeu :
   `sd(point d'auteur) - sd(point simule)`, MEME frame, MEME surface, MEME chaine. LECTURE QUAND LE
   DEFAUT EST ABSENT : 0. NATURE : une longueur. REPERE : le monde. Voir [NOTE-150]."
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-skinadd* (+ (* slot PHYS-CHAINS) chain))
    0.0))

(defun phys-skin-meas-set! ((v int))
  "Arme la mesure SPEC 18. La salle l'arme, le jeu ne l'arme jamais."
  (set! *phys-skin-meas* v)
  (none))

(defun phys-skintest-count () *phys-skintest*)

(defun phys-link-pen ((skel skeleton) (sc int) (n int) (nbone int) (nco int) (l int) (pt vector)
                      (prio int))
  "LA PENETRATION DU LIEN `l` SI SON JOINT ETAIT EN `pt`.
   NATURE : une profondeur, en metres. REPERE : monde. LECTURE HORS DEFAUT : PHYS-NOCONTACT.
   Justification complete : [NOTE-307] de jak-hd-physics-NOTES.md."
  (let ((slot (/ sc PHYS-CHAINS))
        (worst PHYS-NOCONTACT)
        (rest (new 'stack-no-clear 'vector))
        (off  (new 'stack-no-clear 'vector))
        (offs (new 'stack-no-clear 'vector))
        (bv   (new 'stack-no-clear 'vector))
        (q    (new 'stack-no-clear 'vector))
        (ca   (new 'stack-no-clear 'vector))
        (cb   (new 'stack-no-clear 'vector))
        (ra   (new 'stack-no-clear 'vector))
        (rb   (new 'stack-no-clear 'vector))
        (ua   (new 'stack-no-clear 'vector))
        (ub   (new 'stack-no-clear 'vector))
        (nrm  (new 'stack-no-clear 'vector)))
    (let* ((scl (+ (* sc PHYS-LINKS) l))
           (kk  (-> *phys-joint* scl))
           (rl  (-> *phys-lcr* scl))
           (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) (-> *phys-anchor* sc))))
      (when (and (>= kk 0) (< (+ kk 1) nbone))
        ;; [NOTE-243] `pt` arrive en coordonnees de JOINT (c'est ce que manipulent le solveur et le recul) : -> jak-hd-physics-NOTES.md
        (phys-link-off! skel scl kk off)
        (if (> l 0)
          (set-vector! bv (-> *phys-px* (- scl 1)) (-> *phys-py* (- scl 1)) (-> *phys-pz* (- scl 1)) 1.0)
          (if (and (>= kp 0) (< (+ kp 1) nbone))
            (vector-copy! bv (the-as vector (-> skel bones (+ kp 1) transform vector 3)))
            (set-vector! bv 0.0 0.0 0.0 1.0)))
        (phys-link-off-sim! skel scl kk kp nbone bv pt offs)
        (vector-copy! rest (the-as vector (-> skel bones (+ kk 1) transform vector 3)))
        (set! (-> rest x) (+ (-> rest x) (-> off x)))
        (set! (-> rest y) (+ (-> rest y) (-> off y)))
        (set! (-> rest z) (+ (-> rest z) (-> off z)))
        (set! (-> q x) (+ (-> pt x) (-> offs x)))
        (set! (-> q y) (+ (-> pt y) (-> offs y)))
        (set! (-> q z) (+ (-> pt z) (-> offs z)))
        (set! (-> q w) 1.0)
        (dotimes (ci nco)
          (let* ((sco (+ (* slot PHYS-COLS) ci))
                 (cj  (-> *phys-cj* sco))
                 (cj2 (-> *phys-cj2* sco))
                 (own (phys-col-own? sc n cj cj2))
                 ;; DECISION 1, cote SOLVEUR uniquement : la profondeur du volume ecarte ne
                 ;; participe pas au recul. La MESURE (`prio` = 0) continue de la voir.
                 (skip (and (nonzero? prio)
                            (zero? *phys-prio-off*)
                            (>= (-> *phys-lwin* scl) 0)
                            (!= sco (-> *phys-lwin* scl)))))
            (when (and own (nonzero? *phys-self-inject*)) (set! own #f))
            (when (and (not own) (>= cj 0) (< (+ cj 1) nbone))
              (phys-col-now! skel sco cj cj2 nbone ca cb)
              (when (not (phys-col-rest! sco ra rb))
                (vector-copy! ra ca) (vector-copy! rb cb))
              (let* ((cap?   (and (>= cj2 0) (< (+ cj2 1) nbone)))
                     (floors (phys-collide-depth rest rl ra rb (-> *phys-cr* sco)
                                                 (-> *phys-cr2* sco) cap? nrm))
                     (floorc (phys-collide-depth rest rl ca cb (-> *phys-cr* sco)
                                                 (-> *phys-cr2* sco) cap? nrm))
                     (floor0 (if (> floorc floors) floorc floors))
                     ;; [NOTE-242] MEME PLANCHER QUE LE SOLVEUR, IMPOSE PAR UNE MESURE : ancre a la pose d'AUTEUR -> jak-hd-physics-NOTES.md
                     (feff   (phys-vol-floor sc floor0 (phys-vol-yield sc cj cj2)))
                     (dep    (phys-collide-depth q rl ca cb (-> *phys-cr* sco)
                                                 (-> *phys-cr2* sco) cap? nrm))
                     (res    (- dep feff)))
                ;; [NOTE-31] CHANGER DE COTE EST UNE PENETRATION, ET C'EST LA SEULE QUE LA PROFONDEUR NE PEUT -> jak-hd-physics-NOTES.md
                (when (and (> floor0 0.0)
                           (phys-axis-dir rest ca cb ua) (phys-axis-dir q ca cb ub)
                           (< (+ (* (-> ua x) (-> ub x))
                                 (+ (* (-> ua y) (-> ub y)) (* (-> ua z) (-> ub z))))
                              0.0))
                  ;; [NOTE-263] compte une fois par frame (le meme drapeau que `buried` : `phys-pen-chain` -> jak-hd-physics-NOTES.md
                  (when (nonzero? *phys-buried-tally*)
                    (set! (-> *phys-dg* (+ (* sc PHYS-DG) 11))
                          (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 11)))))
                  (when (zero? *phys-side-off*)
                    (let ((wv (-> ub w)))
                      (when (> wv worst) (set! worst wv)))))
                ;; [NOTE-229] `buried` = le lien est entierement dans ce volume A SA POSE DE MODELE. Depuis le -> jak-hd-physics-NOTES.md
                (when (>= floor0 (* 2.0 rl))
                  (set! *phys-buried-n* (+ *phys-buried-n* 1))
                  (when (nonzero? *phys-buried-tally*)
                    (set! (-> *phys-dg* (+ (* sc PHYS-DG) 9))
                          (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 9))))))
                ;; [NOTE-174] EN CONTACT = dedans a sa pose de modele, ou dedans maintenant. Une paire dont -> jak-hd-physics-NOTES.md
                (when (and (not skip) (or (> floor0 0.0) (> dep 0.0)) (> res worst))
                  (set! worst res))
                ;; [NOTE-228] QUEL VOLUME PORTE LE PIRE RESIDU. `meshpen` ne publiait qu'un MAXIMUM, donc le -> jak-hd-physics-NOTES.md
                (when (and (nonzero? *phys-buried-tally*)
                           (not skip) (or (> floor0 0.0) (> dep 0.0))
                           (> res (-> *phys-dg* (+ (* sc PHYS-DG) 17))))
                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 17)) res)
                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 18)) (the float ci)))
                ;; [NOTE-262] QUEL VOLUME CONTRAINT QUEL MAILLON. Compte les paires (lien, volume) en -> jak-hd-physics-NOTES.md
                (when (and (nonzero? *phys-buried-tally*) (> res 0.0))
                  (let ((h (+ (* (+ (* sc PHYS-LINKS) l) PHYS-COLS) ci)))
                    (set! (-> *phys-cvh* h) (+ 1 (-> *phys-cvh* h)))
                    (when (> res (-> *phys-cvm* h)) (set! (-> *phys-cvm* h) res))))))))))
    worst))

(defun phys-inject-probe! ((skel skeleton) (sc int) (n int) (rlk int) (nbone int) (nco int)
                           (base float))
  "[NOTE-155] CONTROLE POSITIF DE `meshpen`, EN PAIRE ET SUR LA MEME FRAME.
   Justification complete : [NOTE-314] de jak-hd-physics-NOTES.md."
  (let ((slot (/ sc PHYS-CHAINS))
        (amt  *phys-inject*)
        (worst PHYS-NOCONTACT)
        ;; [NOTE-261] `phys-link-pen` incremente `*phys-buried-n*` SANS passer par `*phys-buried-tally*` : la -> jak-hd-physics-NOTES.md
        (bur0 *phys-buried-n*)
        (pt   (new 'stack-no-clear 'vector))
        (off  (new 'stack-no-clear 'vector))
        (offs (new 'stack-no-clear 'vector))
        (bv   (new 'stack-no-clear 'vector))
        (ca   (new 'stack-no-clear 'vector))
        (cb   (new 'stack-no-clear 'vector))
        (nrm  (new 'stack-no-clear 'vector))
        (bn   (new 'stack-no-clear 'vector)))
    (dotimes (l n)
      (let ((scl (+ (* sc PHYS-LINKS) l)))
        (set! (-> *phys-sx* scl) (-> *phys-px* scl))
        (set! (-> *phys-sy* scl) (-> *phys-py* scl))
        (set! (-> *phys-sz* scl) (-> *phys-pz* scl))))
    (dotimes (l n)
      (when (>= l rlk)
        (let* ((scl (+ (* sc PHYS-LINKS) l))
               (kk  (-> *phys-joint* scl))
               (rl  (-> *phys-lcr* scl))
               (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) (-> *phys-anchor* sc))))
          (when (and (>= kk 0) (< (+ kk 1) nbone))
            (phys-link-off! skel scl kk off)
            (if (> l 0)
              (set-vector! bv (-> *phys-px* (- scl 1)) (-> *phys-py* (- scl 1))
                              (-> *phys-pz* (- scl 1)) 1.0)
              (if (and (>= kp 0) (< (+ kp 1) nbone))
                (vector-copy! bv (the-as vector (-> skel bones (+ kp 1) transform vector 3)))
                (set-vector! bv 0.0 0.0 0.0 1.0)))
            (set-vector! pt (-> *phys-px* scl) (-> *phys-py* scl) (-> *phys-pz* scl) 1.0)
            (phys-link-off-sim! skel scl kk kp nbone bv pt offs)
            (vector-copy! (-> *phys-pcof* scl) offs)
            (set! (-> pt x) (+ (-> pt x) (-> offs x)))
            (set! (-> pt y) (+ (-> pt y) (-> offs y)))
            (set! (-> pt z) (+ (-> pt z) (-> offs z)))
            (let ((bd 0.0))
              (dotimes (ci nco)
                (let* ((sco (+ (* slot PHYS-COLS) ci))
                       (cj  (-> *phys-cj* sco))
                       (cj2 (-> *phys-cj2* sco)))
                  (when (and (not (phys-col-own? sc n cj cj2)) (>= cj 0) (< (+ cj 1) nbone))
                    (phys-col-now! skel sco cj cj2 nbone ca cb)
                    (let* ((cap? (and (>= cj2 0) (< (+ cj2 1) nbone)))
                           (d (phys-collide-depth pt rl ca cb (-> *phys-cr* sco)
                                                  (-> *phys-cr2* sco) cap? nrm)))
                      (when (> d bd) (set! bd d) (vector-copy! bn nrm))))))
              (when (> bd 0.0)
                (set! *phys-injn* (+ *phys-injn* 1))
                (set! (-> *phys-px* scl) (- (-> *phys-px* scl) (* amt (-> bn x))))
                (set! (-> *phys-py* scl) (- (-> *phys-py* scl) (* amt (-> bn y))))
                (set! (-> *phys-pz* scl) (- (-> *phys-pz* scl) (* amt (-> bn z))))))))))
    (set! *phys-off-hold* 1)
    (dotimes (l n)
      (when (>= l rlk)
        (let ((scl (+ (* sc PHYS-LINKS) l)))
          (set-vector! pt (-> *phys-px* scl) (-> *phys-py* scl) (-> *phys-pz* scl) 1.0)
          (let ((r (phys-link-pen skel sc n nbone nco l pt 0)))
            (when (> r worst) (set! worst r))
            ;; [NOTE-459] LA PAIRE : `b` relu sur la position SAUVEGARDEE du MEME lien, MEME regime d'offset (`off-hold`=1), MEME fonction -> jak-hd-physics-NOTES.md
            (set-vector! pt (-> *phys-sx* scl) (-> *phys-sy* scl) (-> *phys-sz* scl) 1.0)
            (let ((b (phys-link-pen skel sc n nbone nco l pt 0)))
              ;; DOMAINE : les DEUX termes reellement EN CONTACT. Le tableau rabote a zero un
              ;; residu negatif ; un couple dont un terme est rabote ne mesure aucune reponse.
              (when (and (>= b 0.0) (>= r 0.0) (> (- r b) (-> *phys-pcr* sc)))
                (set! (-> *phys-pcr* sc) (- r b))
                (set! (-> *phys-pcra* sc) r)
                (set! (-> *phys-pcrb* sc) b)))))))
    (set! *phys-off-hold* 0)
    (dotimes (l n)
      (let ((scl (+ (* sc PHYS-LINKS) l)))
        (set! (-> *phys-px* scl) (-> *phys-sx* scl))
        (set! (-> *phys-py* scl) (-> *phys-sy* scl))
        (set! (-> *phys-pz* scl) (-> *phys-sz* scl))))
    (set! *phys-buried-n* bur0)
    (when (and (> base PHYS-NOCONTACT-LIMIT) (> base (-> *phys-pcb* sc)))
      (set! (-> *phys-pcb* sc) base))
    (when (and (> worst PHYS-NOCONTACT-LIMIT) (> worst (-> *phys-pci* sc)))
      (set! (-> *phys-pci* sc) worst)))
  (none))

(defun phys-pen-chain ((skel skeleton) (sc int) (n int) (rlk int) (nbone int) (nco int))
  "L'INSTRUMENT MESURE TOUJOURS CONTRE LE SOLIDE QUE LA DONNEE DESIGNE, quel que soit le predicat
   Justification complete : [NOTE-313] de jak-hd-physics-NOTES.md."
  (let ((worst PHYS-NOCONTACT)
        (coneprev *phys-cone-off*)
        (ap (new 'stack-no-clear 'vector))
        (ai (new 'stack-no-clear 'vector))
        (pt (new 'stack-no-clear 'vector)))
    (set! *phys-cone-off* 0)
    (set! (-> *phys-saf* sc) 0.0)
    ;; SEULE passe de la frame ou l'enfouissement est compte par chaine (voir *phys-buried-tally*).
    (set! *phys-buried-tally* 1)
    (dotimes (l n)
      (when (>= l rlk)
        (let ((scl (+ (* sc PHYS-LINKS) l)))
          (set! (-> pt x) (-> *phys-px* scl))
          (set! (-> pt y) (-> *phys-py* scl))
          (set! (-> pt z) (-> *phys-pz* scl))
          (set! (-> pt w) 1.0)
          (let ((r (phys-link-pen skel sc n nbone nco l pt 0)))
            (when (> r worst) (set! worst r)))
          ;; [NOTE-161] SPEC 33/34 — LA MESURE PORTE SUR LA PEAU DE LA CHAINE, PLUS SUR SON JOINT.
          ;; [NOTE-202] Le joint est INTERIEUR par construction du rig : il ne peut pas repondre a une questio -> jak-hd-physics-NOTES.md
          (when (and (nonzero? *phys-skin-meas*) (> (-> *phys-msn* scl) 0))
            (let ((kk (-> *phys-joint* scl)))
              (when (and (>= kk 0) (< (+ kk 1) nbone))
                (dotimes (q (-> *phys-msn* scl))
                  (vector-rotate*! ap (-> *phys-msp* (+ (* scl PHYS-MS-MAX) q))
                                   (the-as matrix (-> skel bones (+ kk 1) transform)))
                  (set! (-> ap w) 0.0)
                  (let ((sx (+ (-> pt x) (-> ap x)))
                        (sy (+ (-> pt y) (-> ap y)))
                        (sz (+ (-> pt z) (-> ap z)))
                        (bx (+ (-> skel bones (+ kk 1) transform vector 3 x) (-> ap x)))
                        (by (+ (-> skel bones (+ kk 1) transform vector 3 y) (-> ap y)))
                        (bz (+ (-> skel bones (+ kk 1) transform vector 3 z) (-> ap z))))
                    (set-vector! ap sx sy sz 1.0)
                    (let ((sd (phys-surf-sd skel (/ sc PHYS-CHAINS) ap nbone)))
                      (when (> sd 900000.0)
                        (set! (-> *phys-skinmiss* sc) (+ 1.0 (-> *phys-skinmiss* sc))))
                      (when (and (< sd 0.0) (> sd -100000.0)
                                 (> (- 0.0 sd) (-> *phys-skinpen* sc)))
                        (set! (-> *phys-skinpen* sc) (- 0.0 sd)) (set! (-> *phys-skl* (+ (* sc 20) 12)) (the float l)))
                      (when (and (> sd -100000.0) (< sd 900000.0))
                        ;; [NOTE-328] LA COLONNE D'AUTEUR EST ENTIEREMENT D'AUTEUR — 2e SITE, manquant depuis le cycle 63 (cycle 121). -> jak-hd-physics-NOTES.md
                        (set-vector! ap bx by bz 1.0) (set! *phys-sd-auth* 1)
                        (let ((sa (phys-surf-sd skel (/ sc PHYS-CHAINS) ap nbone)))
                          (set! *phys-sd-auth* 0)
                          (when (and (> sa -100000.0) (< sa 900000.0))
                            (let ((add (- (fmin 0.0 sa) sd)))
                              (when (> add (-> *phys-saf* sc)) (set! (-> *phys-saf* sc) add)) (when (> add (-> *phys-skl* (+ (* sc 20) 13))) (set! (-> *phys-skl* (+ (* sc 20) 13)) add) (set! (-> *phys-skl* (+ (* sc 20) 14)) (the float l))))
                            (when (> (- 0.0 sa) (-> *phys-skinrest* sc))
                              (set! (-> *phys-skinrest* sc) (- 0.0 sa)))
                            ;; [NOTE-227] [NOTE-161] CONTROLE D'INTEGRITE, REDEFINI AVEC LA GRANDEUR. Un sommet -> jak-hd-physics-NOTES.md
                            (when (> sa 0.0) (set! *phys-skinout* (+ *phys-skinout* 1)))))))
                    ;; [NOTE-332] SPEC 33 : LE MEME SOMMET, CONTRE LA SURFACE DE L'AUTRE SEIN -> jak-hd-physics-NOTES.md
                    (let ((oc (phys-other-surf-chain sc)))
                      (when (>= oc 0)
                        (set! *phys-sd-lo* (-> *phys-bslo* oc))
                        (set! *phys-sd-hi* (+ (-> *phys-bslo* oc) (-> *phys-bscn* oc)))
                        (set-vector! ap sx sy sz 1.0)
                        (let* ((md (phys-surf-sd skel (/ sc PHYS-CHAINS) ap nbone))
                               (d1 *phys-sd-d1*)
                               (sup (* 2.0 (-> *phys-bssp* oc))))
                          ;; [NOTE-333] LE RAYON DE SUPPORT DECIDE SI LA LECTURE EST UNE MESURE -> jak-hd-physics-NOTES.md
                          (when (and (> md -100000.0) (< md 900000.0))
                            (+! (-> *phys-medn* sc) 1.0)
                            (when (< d1 (-> *phys-medgap* sc)) (set! (-> *phys-medgap* sc) d1))
                            (if (> d1 sup)
                              (+! (-> *phys-medfar* sc) 1.0)
                              (when (and (< md 0.0) (> (- 0.0 md) (-> *phys-medpen* sc)))
                                (set! (-> *phys-medpen* sc) (- 0.0 md)))))
                          ;; [NOTE-321] CONTROLE POSITIF APPAIRE : le MEME point, dans la MEME fram -> jak-hd-physics-NOTES.md
                          ;; `f < 1` => le point injecte ne traverse JAMAIS la surface, donc la
                          ;; prediction `d1 -> (1 - f) x d1` est bien posee sur TOUTE fenetre.
                          (when (and (> *phys-med-inj* 0.0) (< *phys-med-inj* 1.0)
                                     (< d1 900000.0))
                            (vector-! ai *phys-sdq* ap)
                            (set! (-> ai w) 0.0)
                            (let ((il (vector-length ai)))
                              (when (> il 0.0001)
                                (vector-float*! ai ai *phys-med-inj*)
                                (set-vector! ap (+ sx (-> ai x)) (+ sy (-> ai y))
                                                (+ sz (-> ai z)) 1.0)
                                (phys-surf-sd skel (/ sc PHYS-CHAINS) ap nbone)
                                (when (< *phys-sd-d1* (-> *phys-medgapi* sc))
                                  (set! (-> *phys-medgapi* sc) *phys-sd-d1*)))))
                          ;; [NOTE-415] LA COLONNE D'AUTEUR EST ENTIEREMENT D'AUTEUR : le point sonde ET la -> jak-hd-physics-NOTES.md
                          (set-vector! ap bx by bz 1.0)
                          (set! *phys-sd-auth* 1)
                          (let* ((ma (phys-surf-sd skel (/ sc PHYS-CHAINS) ap nbone))
                                 (a1 *phys-sd-d1*))
                            (set! *phys-sd-auth* 0)
                            (set! *phys-sd-lo* 0)
                            (set! *phys-sd-hi* -1)
                            (when (and (> ma -100000.0) (< ma 900000.0))
                              (when (< a1 (-> *phys-medgapa* sc))
                                (set! (-> *phys-medgapa* sc) a1))
                              (when (and (< ma 0.0) (< a1 sup)
                                         (> (- 0.0 ma) (-> *phys-medrest* sc)))
                                (set! (-> *phys-medrest* sc) (- 0.0 ma)))))))))
                  (when (> (-> *phys-saf* sc) (-> *phys-skinadd* sc))
                    (set! (-> *phys-skinadd* sc) (-> *phys-saf* sc))))))))))
    (set! *phys-buried-tally* 0)
    (set! *phys-cone-off* coneprev)
    ;; [NOTE-260] la sentinelle est RENDUE TELLE QUELLE : « aucun contact » n'est pas « penetration nulle  -> jak-hd-physics-NOTES.md
    worst))
;; [NOTE-173] ---------------------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md

(defconstant PHYS-POSE-RATIO 50.0)

(defun phys-pose-repair ((obj jak-hd) (skel skeleton) (sc int) (n int) (an int) (nbone int)
                        (report symbol))
  "RE-ASSEOIR un lien que le retarget a envoye ailleurs, au lieu de le simuler autour d'une position
   Justification complete : [NOTE-312] de jak-hd-physics-NOTES.md."
  (let ((seat (new 'stack-no-clear 'vector))
        (dir  (new 'stack-no-clear 'vector))
        (ib   (new 'stack-no-clear 'matrix))
        (lk   (new 'stack-no-clear 'matrix)))
    (dotimes (l n)
      (let* ((scl (+ (* sc PHYS-LINKS) l))
             (kk  (-> *phys-joint* scl))
             (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an))
             (rl  (-> *phys-rad* scl)))
        (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone) (> rl 0.01))
          (let ((d (vector-vector-distance
                     (the-as vector (-> skel bones (+ kk 1) transform vector 3))
                     (the-as vector (-> skel bones (+ kp 1) transform vector 3)))))
            (when report
              (format 0 "[HD-PHYS] pose c=~D l=~D dist=~f rad=~f ratio=~f~%"
                      (mod sc PHYS-CHAINS) l d rl (/ d rl)))
            (when (> d (* PHYS-POSE-RATIO rl))
              ;; [NOTE-32] ------------------------------------------------------------------------------ -> jak-hd-physics-NOTES.md
              (let ((done #f))
                (when (and (nonzero? (-> obj draw jgeo))
                           (< kk (-> obj draw jgeo length))
                           (< kp (-> obj draw jgeo length)))
                  (matrix-4x4-inverse! ib (-> obj draw jgeo data kk bind-pose))
                  (matrix*! lk ib (-> obj draw jgeo data kp bind-pose))
                  (set-vector! seat (-> lk vector 3 x) (-> lk vector 3 y) (-> lk vector 3 z) 1.0)
                  (when (> (+ (fabs (-> seat x)) (+ (fabs (-> seat y)) (fabs (-> seat z)))) 0.01)
                    (vector-matrix*! seat seat (the-as matrix (-> skel bones (+ kp 1) transform)))
                    (set! done #t)))
                (when (not done)
                  (set! *phys-reseat-fb* (+ *phys-reseat-fb* 1))
                  ;; direction de l'os du porteur : de SON parent vers lui. A defaut (porteur
                  ;; racine), la verticale du monde vers le bas — ce qui pend, pend.
                  (let ((gp (the int (-> (-> obj khd-par) kp))))
                    (cond
                      ((and (!= gp 255) (< (+ gp 1) nbone))
                       (set! (-> dir x) (- (-> skel bones (+ kp 1) transform vector 3 x)
                                           (-> skel bones (+ gp 1) transform vector 3 x)))
                       (set! (-> dir y) (- (-> skel bones (+ kp 1) transform vector 3 y)
                                           (-> skel bones (+ gp 1) transform vector 3 y)))
                       (set! (-> dir z) (- (-> skel bones (+ kp 1) transform vector 3 z)
                                           (-> skel bones (+ gp 1) transform vector 3 z)))
                       (set! (-> dir w) 0.0))
                      (else (set-vector! dir 0.0 -1.0 0.0 0.0))))
                  (let ((dl (vector-length dir)))
                    (if (> dl 0.01)
                      (vector-float*! dir dir (/ rl dl))
                      (set-vector! dir 0.0 (- 0.0 rl) 0.0 0.0)))
                  (set! (-> seat x) (+ (-> skel bones (+ kp 1) transform vector 3 x) (-> dir x)))
                  (set! (-> seat y) (+ (-> skel bones (+ kp 1) transform vector 3 y) (-> dir y)))
                  (set! (-> seat z) (+ (-> skel bones (+ kp 1) transform vector 3 z) (-> dir z)))))
              (when report
                (format 0 "[HD-PHYS] reseat c=~D l=~D dist=~f rad=~f ratio=~f~%"
                        (mod sc PHYS-CHAINS) l d rl (/ d rl))
                ;; LA PREUVE QUE LA PLACE A CHANGE, et de combien : la distance au porteur que le
                ;; rig donne, contre celle que l'ancienne heuristique donnait (le rayon `rl`).
                (format 0 "[HD-PHYS] reseat-at c=~D l=~D bind=~f oldheur=~f~%"
                        (mod sc PHYS-CHAINS) l
                        (vector-vector-distance
                          seat (the-as vector (-> skel bones (+ kp 1) transform vector 3)))
                        rl))
              (set! *phys-reseat-n* (+ *phys-reseat-n* 1))
              (set! (-> skel bones (+ kk 1) transform vector 3 x) (-> seat x))
              (set! (-> skel bones (+ kk 1) transform vector 3 y) (-> seat y))
              (set! (-> skel bones (+ kk 1) transform vector 3 z) (-> seat z))
              (set! (-> skel bones (+ kk 1) transform vector 3 w) 1.0)))))))
  (none))

;; [NOTE-478] SPEC 37 — LA MOITIE ROTATION DU REBASE : `p' = R.p + t`, R = a0m^T.am, t = anc - R.anp. -> jak-hd-physics-NOTES.md
(defun phys-rebase-pt! ((ax (pointer float)) (ay (pointer float)) (az (pointer float)) (i int) (mt matrix) (mn matrix) (t0 vector) (v vector))
  (set-vector! v (-> ax i) (-> ay i) (-> az i) 1.0)
  (vector-rotate*! v v mt) (vector-rotate*! v v mn)
  (set! (-> ax i) (+ (-> t0 x) (-> v x))) (set! (-> ay i) (+ (-> t0 y) (-> v y))) (set! (-> az i) (+ (-> t0 z) (-> v z))) (none))

;; [NOTE-226] LE PAS — appele depuis do-joint-math! de jak-hd, APRES fill-jak-hd-bones!. A cet instant -> jak-hd-physics-NOTES.md
(defun jak-hd-physics-step ((obj jak-hd))
  (let ((slot (phys-slot-for-pid (the int (-> obj pid)))))
    (when (and (>= slot 0)
               (nonzero? (pc-physics-enabled))
               (nonzero? (-> obj draw))
               (nonzero? (-> obj draw skeleton))
               (nonzero? (-> obj draw jgeo)))
      (let* ((skel   (-> obj draw skeleton))
             (nbone  (-> skel length))
             (njoint (min (-> obj draw jgeo length) PHYS-JOINTS))
             (nch    (-> *phys-slot-nch* slot))
             (nco    (-> *phys-slot-nco* slot))
             (dt     0.0166667)
             ;; [NOTE-259] 9.81 m/s^2 dans les unites de l'integrateur : 9.81 * 4096 u/m / 3600 frames^2/s^2 -> jak-hd-physics-NOTES.md
             (gy     -11.16))
        (dotimes (k njoint) (set! (-> *phys-dhas* k) 0))
        ;; [NOTE-258] LA POSE D'AUTEUR DES VOLUMES, AVANT QUE LA PREMIERE CHAINE N'ECRIVE. Les chaines sont -> jak-hd-physics-NOTES.md
        (phys-snapshot-colliders! skel slot nco nbone)
        (let ((w2l  (new 'stack-no-clear 'matrix))
              (pre  (new 'stack-no-clear 'matrix))
              (inv  (new 'stack-no-clear 'matrix))
              (rot  (new 'stack-no-clear 'matrix))
              (tmp  (new 'stack-no-clear 'matrix))
              (dfa  (new 'stack-no-clear 'matrix))
              (dfb  (new 'stack-no-clear 'matrix))
              (dfc  (new 'stack-no-clear 'matrix))
              (anc  (new 'stack-no-clear 'vector))
              (tw   (new 'stack-no-clear 'vector))
              (acc  (new 'stack-no-clear 'vector))
              (fl   (new 'stack-no-clear 'vector))
              (gl   (new 'stack-no-clear 'vector))
              (gla  (new 'stack-no-clear 'vector))
              (gdw  (new 'stack-no-clear 'vector))
              (ov   (new 'stack-no-clear 'vector))
              (uv   (new 'stack-no-clear 'vector))
              (uv2  (new 'stack-no-clear 'vector))
              (sv   (new 'stack-no-clear 'vector))
              (sep  (new 'stack-no-clear 'vector))
              (pt   (new 'stack-no-clear 'vector))
              (rest (new 'stack-no-clear 'vector))
              (nrm  (new 'stack-no-clear 'vector)))
          (dotimes (c nch)
            (let* ((sc  (+ (* slot PHYS-CHAINS) c))
                   (an  (-> *phys-anchor* sc)))
              ;; [NOTE-257] LA POSE DU MODELE EST-ELLE PLAUSIBLE ? Une fois par chaine, a sa premiere frame, ou -> jak-hd-physics-NOTES.md
              (when (and (> (-> *phys-nlink* sc) 0) (>= an 0) (< (+ an 1) nbone))
                (phys-pose-repair obj skel sc (-> *phys-nlink* sc) an nbone
                                  (zero? (-> *phys-warm* sc))))
              ;; [NOTE-164] DEUX JEUX D'INDICES LA OU IL N'Y EN AVAIT QU'UN. `rootlock` portait DEUX roles : -> jak-hd-physics-NOTES.md
              (let* ((n    (-> *phys-nlink* sc))
                     (rlk0 (max 0 (min (-> *phys-rootlk* sc) (max 0 (- n 1)))))
                     (rgr  (-> *phys-rootgr* sc))
                     (rlk  (if (> rgr 0.0) 0 rlk0)))
              (when (and (> n 0) (>= an 0) (< (+ an 1) nbone))
                (let ((am (the-as matrix (-> skel bones (+ an 1) transform))))
                  (vector-copy! anc (the-as vector (-> am vector 3)))
                  (matrix-4x4-inverse! w2l am)
                  ;; [NOTE-33] --------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
                  (set-vector! gl 0.0 gy 0.0 0.0)
                  (vector-rotate*! gl gl w2l)
                  (let ((gn (vector-length gl)))
                    (when (> gn 0.0001) (vector-float*! gl gl (/ (fabs gy) gn))))
                  ;; [NOTE-34] --------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
                  (when (and (zero? (-> *phys-axok* sc)) (= (-> *phys-fam* sc) 1) (> n 0))
                    (let ((k0 (-> *phys-joint* (+ (* sc PHYS-LINKS) rlk))))
                      (when (and (>= k0 0) (< (+ k0 1) nbone))
                        (set-vector! sv
                                     (- (-> skel bones (+ k0 1) transform vector 3 x) (-> anc x))
                                     (- (-> skel bones (+ k0 1) transform vector 3 y) (-> anc y))
                                     (- (-> skel bones (+ k0 1) transform vector 3 z) (-> anc z))
                                     0.0)
                        (vector-rotate*! sv sv w2l)
                        ;; [NOTE-225] L'INVARIANT EXTERNE QUI NOMME LE LATERAL — voir la note de `*phys-axsep*`. -> jak-hd-physics-NOTES.md
                        (set-vector! sep 0.0 0.0 0.0 0.0)
                        (set! (-> *phys-axsrc* sc) 0)
                        (dotimes (c2 nch)
                          (let ((sc2 (+ (* slot PHYS-CHAINS) c2)))
                            (when (and (zero? (-> *phys-axsrc* sc)) (!= c2 c)
                                       (= (-> *phys-fam* sc2) 1)
                                       (= (-> *phys-anchor* sc2) an)
                                       (> (-> *phys-nlink* sc2) 0))
                              (let ((k2 (-> *phys-joint* (* sc2 PHYS-LINKS))))
                                (when (and (>= k2 0) (< (+ k2 1) nbone))
                                  (set-vector! sep
                                               (- (-> skel bones (+ k0 1) transform vector 3 x)
                                                  (-> skel bones (+ k2 1) transform vector 3 x))
                                               (- (-> skel bones (+ k0 1) transform vector 3 y)
                                                  (-> skel bones (+ k2 1) transform vector 3 y))
                                               (- (-> skel bones (+ k0 1) transform vector 3 z)
                                                  (-> skel bones (+ k2 1) transform vector 3 z))
                                               0.0)
                                  (vector-rotate*! sep sep w2l)
                                  (set! (-> *phys-axsrc* sc) 1))))))
                        (let* ((gax (fabs (-> gl x)))
                               (gay (fabs (-> gl y)))
                               (gaz (fabs (-> gl z)))
                               (iv  (if (and (>= gax gay) (>= gax gaz)) 0 (if (>= gay gaz) 1 2)))
                               ;; les deux lignes restantes, sans branche cachee :
                               ;;   iv=0 -> (1,2)   iv=1 -> (0,2)   iv=2 -> (0,1)
                               (ja  (if (= iv 0) 1 0))
                               (jb  (if (= iv 2) 1 2))
                               ;; [NOTE-135] LATERAL D'ABORD (cycle 10) -> jak-hd-physics-NOTES.md
                               (il  (if (nonzero? (-> *phys-axsrc* sc))
                                      (if (>= (fabs (-> sep data ja)) (fabs (-> sep data jb))) ja jb)
                                      (if (>= (fabs (-> sv data ja)) (fabs (-> sv data jb))) ja jb)))
                               (ia  (if (= il ja) jb ja)))
                          ;; CE QUE LA DECISION A COMPARE, publie tel quel : sans ces deux nombres,
                          ;; « le lateral est la ligne 0 » resterait une affirmation de source.
                          (set! (-> *phys-axsep* (+ (* sc 3) 0)) (-> sep data ja))
                          (set! (-> *phys-axsep* (+ (* sc 3) 1)) (-> sep data jb))
                          (set! (-> *phys-axsep* (+ (* sc 3) 2)) (vector-length sep))
                          (vector-copy! (-> *phys-sepv* sc) sep)
                          (set! (-> *phys-axv* sc) iv)
                          (set! (-> *phys-axa* sc) ia)
                          (set! (-> *phys-axl* sc) il)
                          (set! (-> *phys-axok* sc) 1)
                          ;; [NOTE-77] LA DIRECTION MONDE DE CHACUNE DES TROIS LIGNES DU TRIEDRE, normalisee. -> jak-hd-physics-NOTES.md
                          (dotimes (rr 3)
                            (let* ((lr (sqrtf (+ (* (-> am vector rr x) (-> am vector rr x))
                                                 (+ (* (-> am vector rr y) (-> am vector rr y))
                                                    (* (-> am vector rr z) (-> am vector rr z))))))
                                   (ir (if (> lr 0.0001) (/ 1.0 lr) 0.0))
                                   (bb (+ (* sc 9) (* rr 3))))
                              (set! (-> *phys-axw* (+ bb 0)) (* (-> am vector rr x) ir))
                              (set! (-> *phys-axw* (+ bb 1)) (* (-> am vector rr y) ir))
                              (set! (-> *phys-axw* (+ bb 2)) (* (-> am vector rr z) ir))))
                          ;; [NOTE-163] ARMEE DES QU'IL Y A UN MAILLON LIBRE. Ce verrou exigeait DEUX -> jak-hd-physics-NOTES.md
                          (when (> (- n rlk) 0)
                            (set! (-> *phys-axs* (+ (* sc 3) iv)) (/ 1.0 (-> *phys-pset* (+ (* sc PHYS-PSET-N) 23))))
                            (set! (-> *phys-axs* (+ (* sc 3) ia)) (/ 1.0 (-> *phys-pset* (+ (* sc PHYS-PSET-N) 10))))
                            (set! (-> *phys-axs* (+ (* sc 3) il)) (/ 1.0 (-> *phys-pset* (+ (* sc PHYS-PSET-N) 11))))
                            (set! (-> *phys-axan* sc) 1))))))
                  ;; [NOTE-35] LA GRAVITE ABSOLUE, VUE DE L'ANCRE, AVANT TOUTE SOUSTRACTION. C'est elle qui -> jak-hd-physics-NOTES.md
                  (vector-copy! gla gl)
                  (when (= (-> *phys-fam* sc) 1)
                    (let ((gb (* sc 3)))
                      ;; RELEVE une fois, premiere frame de la chaine : la pose debout d'auteur.
                      (when (zero? (-> *phys-warm* sc))
                        (set! (-> *phys-gref* (+ gb 0)) (-> gl x))
                        (set! (-> *phys-gref* (+ gb 1)) (-> gl y))
                        (set! (-> *phys-gref* (+ gb 2)) (-> gl z)))
                      (set! (-> gl x) (- (-> gl x) (-> *phys-gref* (+ gb 0))))
                      (set! (-> gl y) (- (-> gl y) (-> *phys-gref* (+ gb 1))))
                      (set! (-> gl z) (- (-> gl z) (-> *phys-gref* (+ gb 2))))))
                  ;; [NOTE-36] --------------------------------------------------------------------------- -> jak-hd-physics-NOTES.md
                  (set-vector! gdw 0.0 gy 0.0 0.0)
                  (when (= (-> *phys-fam* sc) 1)
                    (let ((gn (vector-length gl)))
                      (cond
                        ((> gn 0.0001)
                         (vector-rotate*! gdw gl am)
                         (let ((gw (vector-length gdw)))
                           (if (> gw 0.0001)
                             (vector-float*! gdw gdw (/ gn gw))
                             (set-vector! gdw 0.0 0.0 0.0 0.0))))
                        (else (set-vector! gdw 0.0 0.0 0.0 0.0)))))
                  (let* ((warm (-> *phys-warm* sc))
                         (w    (/ (* 6.2831853 (-> *phys-stiff* sc))
                                  (sqrtf (fmax 0.01 (-> *phys-mass* sc)))))
                         (k2   (* w w dt dt))
                         (dmp  (-> *phys-damp* sc))
                         (gsc  (-> *phys-grav* sc))
                         (cpl  (-> *phys-couple* sc)))
                    (set! (-> *phys-warm* sc) (min 3 (+ warm 1)))
                    ;; [NOTE-83] SPEC 37 — LE REBASE RIGIDE (translation ET rotation), ET LA MESURE QUI JUGE SON SEUIL. -> jak-hd-physics-NOTES.md
                    (let ((rbd (if (> warm 1) (vector-vector-distance anc (-> *phys-anp* sc)) 0.0))
                          (dgr (* sc PHYS-DG)))
                      (when (> rbd (-> *phys-dg* (+ dgr 30))) (set! (-> *phys-dg* (+ dgr 30)) rbd))
                      (when (> rbd (* 7.00 (fmax 1.0 (-> *phys-b0* sc))))
                        (set! (-> *phys-dg* (+ dgr 29)) (+ 1.0 (-> *phys-dg* (+ dgr 29))))
                        (matrix-transpose! rot (-> *phys-a0m* sc)) (matrix-copy! tmp am) (when (zero? (-> *phys-twok* sc)) (matrix-identity! rot) (matrix-identity! tmp))
                        (vector-rotate*! ov (-> *phys-anp* sc) rot) (vector-rotate*! ov ov tmp) (vector-! ov anc ov)
                        (dotimes (l n)
                          (let ((s2 (+ (* sc PHYS-LINKS) l)))
                            (phys-rebase-pt! *phys-px* *phys-py* *phys-pz* s2 rot tmp ov pt) (phys-rebase-pt! *phys-qx* *phys-qy* *phys-qz* s2 rot tmp ov pt)
                            (phys-rebase-pt! *phys-cpx* *phys-cpy* *phys-cpz* s2 rot tmp ov pt) (phys-rebase-pt! *phys-cqx* *phys-cqy* *phys-cqz* s2 rot tmp ov pt) (set! (-> *phys-kx* s2) 0.0) (set! (-> *phys-ky* s2) 0.0) (set! (-> *phys-kz* s2) 0.0))))
                      ;; [NOTE-416] LA POSITION MONDE DE L'ANCRE, POUR QUE LA SALLE MESURE SON BRAS DE LEVIER. -> jak-hd-physics-NOTES.md
                      (set! (-> *phys-dg* (+ dgr 50)) (-> anc x))
                      (set! (-> *phys-dg* (+ dgr 51)) (-> anc y))
                      (set! (-> *phys-dg* (+ dgr 52)) (-> anc z))
                      (vector-copy! (-> *phys-anp* sc) anc))
                    ;; [NOTE-334] LE STIMULUS GRAVITAIRE LUI-MEME, AVANT TOUTE REPONSE -> jak-hd-physics-NOTES.md
                    (let* ((stb (* sc PHYS-ST))
                           (gm  (/ (vector-length gl) (fabs gy))))
                      (when (> gm (-> *phys-st* (+ stb 18))) (set! (-> *phys-st* (+ stb 18)) gm)))
                    ;; [NOTE-162] ---- 0bis. SPEC 33/34 — CE QUI RESTE DE LA RESTITUTION, MESURE ET NON DEDUIT. -> jak-hd-physics-NOTES.md
                    (dotimes (l n)
                      (let ((scl (+ (* sc PHYS-LINKS) l)))
                        (when (> (-> *phys-rstp* scl w) 0.5)
                          (let ((vn (+ (* (- (-> *phys-px* scl) (-> *phys-qx* scl)) (-> *phys-rstp* scl x))
                                       (+ (* (- (-> *phys-py* scl) (-> *phys-qy* scl)) (-> *phys-rstp* scl y))
                                          (* (- (-> *phys-pz* scl) (-> *phys-qz* scl)) (-> *phys-rstp* scl z))))))
                            (set! *phys-rstout* (+ *phys-rstout* vn))
                            (set! *phys-rstm* (+ *phys-rstm* 1)))
                          (set! (-> *phys-rstp* scl w) 0.0))))
                    ;; [NOTE-417] ---- 0. LES LONGUEURS D'OS, avant d'integrer quoi que ce soit. ------------- -> jak-hd-physics-NOTES.md
                    (dotimes (l n)
                      (let* ((scl (+ (* sc PHYS-LINKS) l))
                             (kk  (-> *phys-joint* scl))
                             (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
                        (set! (-> *phys-blen* scl) 0.0)
                        (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
                          (set! (-> *phys-blen* scl)
                                (vector-vector-distance
                                  (the-as vector (-> skel bones (+ kk 1) transform vector 3))
                                  (the-as vector (-> skel bones (+ kp 1) transform vector 3)))))))
                    ;; [NOTE-37] ---- 1. UNE PARTICULE PAR MAILLON, INTEGREE EN POSITION MONDE. ------------- -> jak-hd-physics-NOTES.md
                    (let* ((ela (if (= (-> *phys-fam* sc) 1) 1 0))
                           ;; [NOTE-115] PORTEE DE SPEC 21/22, RELEVEE SUR LA COURSE ET PAS SUR UN NOM. -> jak-hd-physics-NOTES.md
                           (sat (if (nonzero? ela) 1 0)))
                      (dotimes (l n)
                        (let* ((scl (+ (* sc PHYS-LINKS) l))
                               (k   (-> *phys-joint* scl)))
                          (when (and (>= k 0) (< (+ k 1) nbone))
                            (vector-copy! tw (the-as vector (-> skel bones (+ k 1) transform vector 3)))
                            ;; --- MESURE SEULEMENT. Acceleration MONDE de la pose d'auteur de ce
                            ;; lien : elle ne produit plus aucune force, elle definit le stimulus.
                            (set-vector! acc 0.0 0.0 0.0 0.0)
                            (when (> warm 1)
                              (set! (-> acc x) (+ (- (-> tw x) (* 2.0 (-> *phys-t1x* scl))) (-> *phys-t2x* scl)))
                              (set! (-> acc y) (+ (- (-> tw y) (* 2.0 (-> *phys-t1y* scl))) (-> *phys-t2y* scl)))
                              (set! (-> acc z) (+ (- (-> tw z) (* 2.0 (-> *phys-t1z* scl))) (-> *phys-t2z* scl))))
                            (set! (-> *phys-t2x* scl) (-> *phys-t1x* scl))
                            (set! (-> *phys-t2y* scl) (-> *phys-t1y* scl))
                            (set! (-> *phys-t2z* scl) (-> *phys-t1z* scl))
                            ;; LE STIMULUS REELLEMENT RECU PAR LA POINTE, quelle qu'en soit la
                            ;; source (pilotage de la salle, rotation du porteur, animation).
                            (when (and (> warm 1) (= l (- n 1)))
                              (let ((aa (sqrtf (+ (* (-> acc x) (-> acc x))
                                                  (+ (* (-> acc y) (-> acc y))
                                                     (* (-> acc z) (-> acc z))))))
                                    (stb (* sc PHYS-ST)))
                                (when (> aa (-> *phys-st* (+ stb 16)))
                                  (set! (-> *phys-st* (+ stb 16)) aa))))
                            (when (and (> warm 0) (= l (- n 1)))
                              ;; deplacement monde de la pose d'auteur de la POINTE, cumule
                              (let ((mx (- (-> tw x) (-> *phys-t1x* scl)))
                                    (my (- (-> tw y) (-> *phys-t1y* scl)))
                                    (mz (- (-> tw z) (-> *phys-t1z* scl))))
                                (set! (-> *phys-tmov* sc)
                                      (+ (-> *phys-tmov* sc)
                                         (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz))))))))
                            (set! (-> *phys-t1x* scl) (-> tw x))
                            (set! (-> *phys-t1y* scl) (-> tw y))
                            (set! (-> *phys-t1z* scl) (-> tw z))
                            (cond
                              ((or (< warm 1) (< l rlk))
                               ;; [NOTE-418] L'ANCRE — LE SEUL POINT PAR LEQUEL L'ANIMATION ENTRE. Maillon -> jak-hd-physics-NOTES.md
                               (set! (-> *phys-px* scl) (-> tw x))
                               (set! (-> *phys-py* scl) (-> tw y))
                               (set! (-> *phys-pz* scl) (-> tw z))
                               (set! (-> *phys-qx* scl) (-> tw x))
                               (set! (-> *phys-qy* scl) (-> tw y))
                               (set! (-> *phys-qz* scl) (-> tw z))
                               (set! (-> *phys-ox* scl) 0.0)
                               (set! (-> *phys-oy* scl) 0.0)
                               (set! (-> *phys-oz* scl) 0.0))
                              (else
                               ;; [NOTE-141] LA PART DE LA GRAVITE QUE LA GEOMETRIE AUTORISE -> jak-hd-physics-NOTES.md
                               (when (= l (- n 1))
                                 (let* ((stb (* sc PHYS-ST))
                                        (kpg (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
                                   (when (and (>= kpg 0) (< (+ kpg 1) nbone))
                                     (let* ((qx (- (-> tw x) (-> skel bones (+ kpg 1) transform vector 3 x)))
                                            (qy (- (-> tw y) (-> skel bones (+ kpg 1) transform vector 3 y)))
                                            (qz (- (-> tw z) (-> skel bones (+ kpg 1) transform vector 3 z)))
                                            (ql (sqrtf (+ (* qx qx) (+ (* qy qy) (* qz qz)))))
                                            (gn (vector-length gl)))
                                       (when (and (> ql 0.01) (> gn 0.0001))
                                         (set-vector! sv qx qy qz 0.0)
                                         (vector-rotate*! sv sv w2l)
                                         (let* ((sl (vector-length sv))
                                                (cs (if (> sl 0.0001)
                                                      (/ (+ (* (-> sv x) (-> gl x))
                                                            (+ (* (-> sv y) (-> gl y))
                                                               (* (-> sv z) (-> gl z))))
                                                         (* sl gn))
                                                      0.0))
                                                (tf (sqrtf (fmax 0.0 (- 1.0 (* cs cs))))))
                                           (when (> tf (-> *phys-st* (+ stb 19)))
                                             (set! (-> *phys-st* (+ stb 19)) tf))))))))
                               ;; [NOTE-419] L'ATTACHE : le maillon precedent DEJA SIMULE, ou l'ancre pour le -> jak-hd-physics-NOTES.md
                               (let* ((ax (if (> l 0) (-> *phys-px* (- scl 1)) (-> anc x)))
                                      (ay (if (> l 0) (-> *phys-py* (- scl 1)) (-> anc y)))
                                      (az (if (> l 0) (-> *phys-pz* (- scl 1)) (-> anc z)))
                                      (bl (-> *phys-blen* scl))
                                      ;; [NOTE-420] SPEC 6 — LE METRE DES BORNES DE SPEC 22, ET CE N'EST PAS -> jak-hd-physics-NOTES.md
                                      (b0e (if (> (-> *phys-b0* sc) 0.0) (-> *phys-b0* sc) bl))
                                      ;; [NOTE-74] SPEC 24 CONTRE SPEC 31 : LE GRADIENT NE VIT PLUS DANS LA FREQUENCE. -> jak-hd-physics-NOTES.md
                                      (k2l k2)
                                      ;; [NOTE-421] LA CIBLE du ressort de materiau, pas sa force : elle ne -> jak-hd-physics-NOTES.md
                                      (tgx 0.0)
                                      (tgy 0.0)
                                      (tgz 0.0)
                                      (hasf 0))
                                 ;; ---- LA CHAIR : direction de repos du MATERIAU, relevee UNE fois
                                 ;; ---- et constante ensuite. Elle ne suit pas l'animation.
                                 (when (and (nonzero? ela) (zero? (-> *phys-ucap* scl))
                                            (> bl 0.01) (> k2 0.000001))
                                   (set-vector! sv (- (-> tw x) ax) (- (-> tw y) ay) (- (-> tw z) az) 0.0)
                                   (vector-rotate*! sv sv w2l)
                                   ;; [NOTE-39] LA PRE-COMPENSATION A ETE RETIREE ICI, ET C'EST LA MEME PIECE -> jak-hd-physics-NOTES.md
                                   (let ((sl (vector-length sv)))
                                     (when (> sl 0.0001)
                                       (set! (-> *phys-ux* scl) (/ (-> sv x) sl))
                                       (set! (-> *phys-uy* scl) (/ (-> sv y) sl))
                                       (set! (-> *phys-uz* scl) (/ (-> sv z) sl))
                                       (set! (-> *phys-ucap* scl) 1))))
                                 ;; [NOTE-422] ---- LA CIBLE DE LA FORCE ELASTIQUE DU MATERIAU. Elle est portee -> jak-hd-physics-NOTES.md
                                 (when (and (nonzero? ela) (nonzero? (-> *phys-ucap* scl)) (> bl 0.01))
                                   (set-vector! uv (-> *phys-ux* scl) (-> *phys-uy* scl) (-> *phys-uz* scl) 0.0)
                                   (vector-rotate*! uv uv am)
                                   (let ((ul (vector-length uv)))
                                     (when (> ul 0.0001)
                                       (vector-float*! uv uv (/ bl ul))
                                       (set! tgx (+ ax (-> uv x)))
                                       (set! tgy (+ ay (-> uv y)))
                                       (set! tgz (+ az (-> uv z)))
                                       (set! hasf 1))))
                                 ;; [NOTE-73] SPEC 9 — LA CIBLE DE REPOS DU RESSORT EST-ELLE LA POSE D'AUTEUR ? -> jak-hd-physics-NOTES.md
                                 ;; [NOTE-99] NATURE deux longueurs / B0, maximum et somme sur la fenetre. -> jak-hd-physics-NOTES.md
                                 (when (and (nonzero? hasf) (> warm 1) (= l rlk))
                                   (let* ((dgb (* sc PHYS-DG))
                                          (rgx (- tgx (-> tw x)))
                                          (rgy (- tgy (-> tw y)))
                                          (rgz (- tgz (-> tw z)))
                                          (rg  (/ (sqrtf (+ (* rgx rgx) (+ (* rgy rgy) (* rgz rgz))))
                                                  (fmax 1.0 b0e)))
                                          (pex (- (-> *phys-px* scl) tgx))
                                          (pey (- (-> *phys-py* scl) tgy))
                                          (pez (- (-> *phys-pz* scl) tgz))
                                          (pe  (/ (sqrtf (+ (* pex pex) (+ (* pey pey) (* pez pez))))
                                                  (fmax 1.0 b0e))))
                                     (when (> rg (-> *phys-dg* (+ dgb 24)))
                                       (set! (-> *phys-dg* (+ dgb 24)) rg))
                                     (when (> pe (-> *phys-dg* (+ dgb 26)))
                                       (set! (-> *phys-dg* (+ dgb 26)) pe))
                                     ;; [NOTE-224] 28 = la SOMME de `perr`. Le maximum seul ne separe pas « un -> jak-hd-physics-NOTES.md
                                     (set! (-> *phys-dg* (+ dgb 28))
                                           (+ pe (-> *phys-dg* (+ dgb 28)))) (set! (-> *phys-dg* (+ dgb 94)) pe)
                                     (set! (-> *phys-dg* (+ dgb 25))
                                           (+ rg (-> *phys-dg* (+ dgb 25))))
                                     (set! (-> *phys-dg* (+ dgb 27))
                                           (+ 1.0 (-> *phys-dg* (+ dgb 27))))))
                                 ;; [NOTE-223] SPEC 23 — AMORCAGE DU POINT LIBRE, une seule fois par MAILLON. -> jak-hd-physics-NOTES.md
                                 (when (and (nonzero? (-> *phys-axan* sc)) (>= l rlk)
                                            (zero? (-> *phys-rok* scl)))
                                   (set! (-> *phys-cpx* scl) (-> *phys-px* scl))
                                   (set! (-> *phys-cpy* scl) (-> *phys-py* scl))
                                   (set! (-> *phys-cpz* scl) (-> *phys-pz* scl))
                                   (set! (-> *phys-cqx* scl) (-> *phys-qx* scl))
                                   (set! (-> *phys-cqy* scl) (-> *phys-qy* scl))
                                   (set! (-> *phys-cqz* scl) (-> *phys-qz* scl))
                                   (set! (-> *phys-rok* scl) 1))
                                 ;; [NOTE-40] ---- INTEGRATION EN POSITION MONDE. Trois termes, et c'est TOUT : -> jak-hd-physics-NOTES.md
                                 ;; [NOTE-423] `rate` = le TAUX (2 zeta omega dt), `kd` la RETENTION qu'il -> jak-hd-physics-NOTES.md
                                 (let* ((rate (if (and (nonzero? ela) (> k2 0.000001))
                                                (* dmp (sqrtf (/ k2l k2)))
                                                dmp))
                                        (kd  (phys-decay rate))
                                        (kn  (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 16)) b0e))
                                        (cpp (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 17)) b0e))
                                        (ex0 (- tgx (-> *phys-px* scl)))
                                        (ey0 (- tgy (-> *phys-py* scl)))
                                        (ez0 (- tgz (-> *phys-pz* scl)))
                                        ;; [NOTE-172] L'ARMEMENT, pas la classification : une chaine classee -> jak-hd-physics-NOTES.md
                                        (axo (-> *phys-axan* sc))
                                        ;; [NOTE-41] SPEC 37 — LE PAS DE TEMPS SUIT LE MODE LE PLUS RAPIDE, -> jak-hd-physics-NOTES.md
                                        (ns  (if (or (nonzero? axo)
                                                     (and (nonzero? sat) (nonzero? hasf)
                                                          (> (+ (* ex0 ex0) (+ (* ey0 ey0) (* ez0 ez0)))
                                                             (* kn kn))))
                                               (the int (-> *phys-pset* (+ (* sc PHYS-PSET-N) 24))) (the int (-> *phys-pset* (+ (* sc PHYS-PSET-N) 25)))))
                                        (fns (the float ns))
                                        (k2s (/ k2l (* fns fns)))
                                        (ggx (/ (* gsc (-> gdw x)) (* fns fns)))
                                        (ggy (/ (* gsc (-> gdw y)) (* fns fns)))
                                        (ggz (/ (* gsc (-> gdw z)) (* fns fns)))
                                        (kds (if (= ns 2) (sqrtf kd) (sqrtf (sqrtf kd))))
                                        ;; [NOTE-134] TRIEDRE DE L'ANCRE -> jak-hd-physics-NOTES.md
                                        (l0  (sqrtf (+ (* (-> am vector 0 x) (-> am vector 0 x))
                                                       (+ (* (-> am vector 0 y) (-> am vector 0 y))
                                                          (* (-> am vector 0 z) (-> am vector 0 z))))))
                                        (l1  (sqrtf (+ (* (-> am vector 1 x) (-> am vector 1 x))
                                                       (+ (* (-> am vector 1 y) (-> am vector 1 y))
                                                          (* (-> am vector 1 z) (-> am vector 1 z))))))
                                        (l2  (sqrtf (+ (* (-> am vector 2 x) (-> am vector 2 x))
                                                       (+ (* (-> am vector 2 y) (-> am vector 2 y))
                                                          (* (-> am vector 2 z) (-> am vector 2 z))))))
                                        (i0  (if (> l0 0.0001) (/ 1.0 l0) 0.0))
                                        (i1  (if (> l1 0.0001) (/ 1.0 l1) 0.0))
                                        (i2  (if (> l2 0.0001) (/ 1.0 l2) 0.0))
                                        (n0x (* (-> am vector 0 x) i0))
                                        (n0y (* (-> am vector 0 y) i0))
                                        (n0z (* (-> am vector 0 z) i0))
                                        (n1x (* (-> am vector 1 x) i1))
                                        (n1y (* (-> am vector 1 y) i1))
                                        (n1z (* (-> am vector 1 z) i1))
                                        (n2x (* (-> am vector 2 x) i2))
                                        (n2y (* (-> am vector 2 y) i2))
                                        (n2z (* (-> am vector 2 z) i2))
                                        ;; le facteur de raideur de chaque LIGNE (1.0 partout tant
                                        ;; que la chaine n'est pas classee : isotropie stricte)
                                        (s0  (-> *phys-axs* (+ (* sc 3) 0)))
                                        (s1  (-> *phys-axs* (+ (* sc 3) 1)))
                                        (s2  (-> *phys-axs* (+ (* sc 3) 2)))
                                        ;; [NOTE-133] TRAINEE ~ RAIDEUR -> jak-hd-physics-NOTES.md
                                        (kd0 (phys-decay (* rate (sqrtf s0))))
                                        (kd1 (phys-decay (* rate (sqrtf s1))))
                                        (kd2 (phys-decay (* rate (sqrtf s2))))
                                        (kds0 (if (= ns 2) (sqrtf kd0) (sqrtf (sqrtf kd0))))
                                        (kds1 (if (= ns 2) (sqrtf kd1) (sqrtf (sqrtf kd1))))
                                        (kds2 (if (= ns 2) (sqrtf kd2) (sqrtf (sqrtf kd2))))
                                        (vx  (/ (- (-> *phys-px* scl) (-> *phys-qx* scl)) fns))
                                        (vy  (/ (- (-> *phys-py* scl) (-> *phys-qy* scl)) fns))
                                        (vz  (/ (- (-> *phys-pz* scl) (-> *phys-qz* scl)) fns))
                                        ;; [NOTE-345] SPEC 23 — le troisieme degre de liberte est celui du TISSU, pas du premier maillon -> jak-hd-physics-NOTES.md
                                        (rlo (if (and (nonzero? axo) (>= l rlk) (nonzero? hasf)) 1 0))
                                        ;; [NOTE-222] §22 SUR LE COM, ET C'EST UNE AUTRE BANDE QUE CELLE DE -> jak-hd-physics-NOTES.md
                                        (ckn (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 18)) b0e))
                                        (ccp (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 19)) b0e))
                                        (cpx (-> *phys-cpx* scl))
                                        (cpy (-> *phys-cpy* scl))
                                        (cpz (-> *phys-cpz* scl))
                                        (cvx (/ (- cpx (-> *phys-cqx* scl)) fns))
                                        (cvy (/ (- cpy (-> *phys-cqy* scl)) fns))
                                        (cvz (/ (- cpz (-> *phys-cqz* scl)) fns))
                                   (px0 (-> *phys-px* scl)) (py0 (-> *phys-py* scl)) (pz0 (-> *phys-pz* scl)))
                                   (dotimes (ss ns)
                                     (let ((fx 0.0) (fy 0.0) (fz 0.0))
                                       (when (nonzero? hasf)
                                         (let* ((ex (- tgx (-> *phys-px* scl)))
                                                (ey (- tgy (-> *phys-py* scl)))
                                                (ez (- tgz (-> *phys-pz* scl)))
                                                (dd (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez)))))
                                                ;; [NOTE-42] SPEC 21 SOUS LA SEULE FORME QUI NE RETIRE RIEN : -> jak-hd-physics-NOTES.md
                                                (mu (if (and (nonzero? *phys-fwall*) (nonzero? sat)
                                                             (> dd kn) (> cpp 0.0001) (> dd 0.0001))
                                                      (let ((xr (fmin 0.99 (/ (- dd kn) cpp))))
                                                        (fmin (/ (+ kn (* cpp (/ xr (- 1.0 xr)))) dd)
                                                              (/ 1.0 (fmax 0.000001 k2s))))
                                                      1.0)))
                                           (when (> mu 1.000001)
                                             (set! *phys-stif-n* (+ *phys-stif-n* 1)))
                                           ;; [NOTE-86] SPEC 24/29 — LA FORCE EST PROJETEE SUR LE TRIEDRE, UNE RAIDEUR PAR AXE. -> jak-hd-physics-NOTES.md
                                           (if (nonzero? axo)
                                             (let* ((p0 (+ (* ex n0x) (+ (* ey n0y) (* ez n0z))))
                                                    (p1 (+ (* ex n1x) (+ (* ey n1y) (* ez n1z))))
                                                    (p2 (+ (* ex n2x) (+ (* ey n2y) (* ez n2z))))
                                                    (c0 (* s0 p0))
                                                    (c1 (* s1 p1))
                                                    (c2 (* s2 p2)))
                                               (set! fx (* k2s (* mu (+ (* c0 n0x) (+ (* c1 n1x) (* c2 n2x))))))
                                               (set! fy (* k2s (* mu (+ (* c0 n0y) (+ (* c1 n1y) (* c2 n2y))))))
                                               (set! fz (* k2s (* mu (+ (* c0 n0z) (+ (* c1 n1z) (* c2 n2z)))))))
                                             (begin
                                               (set! fx (* k2s (* mu ex)))
                                               (set! fy (* k2s (* mu ey)))
                                               (set! fz (* k2s (* mu ez)))))))
                                       ;; [NOTE-424] LA MEME PROJECTION POUR LA TRAINEE (SPEC 25) : `zeta` est -> jak-hd-physics-NOTES.md
                                       (if (nonzero? axo)
                                         (let* ((wa (* (+ (* vx n0x) (+ (* vy n0y) (* vz n0z))) kds0))
                                                (wb (* (+ (* vx n1x) (+ (* vy n1y) (* vz n1z))) kds1))
                                                (wc (* (+ (* vx n2x) (+ (* vy n2y) (* vz n2z))) kds2))
                                                (zx (+ (* wa n0x) (+ (* wb n1x) (* wc n2x))))
                                                (zy (+ (* wa n0y) (+ (* wb n1y) (* wc n2y))))
                                                (zz (+ (* wa n0z) (+ (* wb n1z) (* wc n2z)))))
                                           (set! vx (+ zx (+ fx ggx)))
                                           (set! vy (+ zy (+ fy ggy)))
                                           (set! vz (+ zz (+ fz ggz))))
                                         (begin
                                           (set! vx (+ (* vx kds) (+ fx ggx)))
                                           (set! vy (+ (* vy kds) (+ fy ggy)))
                                           (set! vz (+ (* vz kds) (+ fz ggz)))))
                                       (let* ((ky (- vx (-> *phys-kx* scl))) (kt (+ (-> *phys-px* scl) ky))) (set! (-> *phys-kx* scl) (if (zero? *phys-kah-off*) (- (- kt (-> *phys-px* scl)) ky) 0.0)) (set! (-> *phys-px* scl) kt))
                                       (let* ((ky (- vy (-> *phys-ky* scl))) (kt (+ (-> *phys-py* scl) ky))) (set! (-> *phys-ky* scl) (if (zero? *phys-kah-off*) (- (- kt (-> *phys-py* scl)) ky) 0.0)) (set! (-> *phys-py* scl) kt))
                                       (let* ((ky (- vz (-> *phys-kz* scl))) (kt (+ (-> *phys-pz* scl) ky))) (set! (-> *phys-kz* scl) (if (zero? *phys-kah-off*) (- (- kt (-> *phys-pz* scl)) ky) 0.0)) (set! (-> *phys-pz* scl) kt)) (when (= l rlk) (set! (-> *phys-dg* (+ (* sc PHYS-DG) 95)) (* (sqrtf (+ (* fx fx) (+ (* fy fy) (* fz fz)))) (* fns fns))))
                                       ;; [NOTE-132] SPEC 23 POINT LIBRE -> jak-hd-physics-NOTES.md
                                       (when (nonzero? rlo)
                                         (let* ((cex (- tgx cpx))
                                                (cey (- tgy cpy))
                                                (cez (- tgz cpz))
                                                (cdd (sqrtf (+ (* cex cex) (+ (* cey cey) (* cez cez)))))
                                                (cmu (if (and (nonzero? sat) (> cdd ckn)
                                                              (> ccp 0.0001) (> cdd 0.0001))
                                                       (let ((xr (fmin 0.99 (/ (- cdd ckn) ccp))))
                                                         (fmin (/ (+ ckn (* ccp (/ xr (- 1.0 xr)))) cdd)
                                                               (/ 1.0 (fmax 0.000001 k2s))))
                                                       1.0))
                                                (q0 (+ (* cex n0x) (+ (* cey n0y) (* cez n0z))))
                                                (q1 (+ (* cex n1x) (+ (* cey n1y) (* cez n1z))))
                                                (q2 (+ (* cex n2x) (+ (* cey n2y) (* cez n2z))))
                                                (d0 (* s0 q0))
                                                (d1 (* s1 q1))
                                                (d2 (* s2 q2))
                                                (cfx (* k2s (* cmu (+ (* d0 n0x) (+ (* d1 n1x) (* d2 n2x))))))
                                                (cfy (* k2s (* cmu (+ (* d0 n0y) (+ (* d1 n1y) (* d2 n2y))))))
                                                (cfz (* k2s (* cmu (+ (* d0 n0z) (+ (* d1 n1z) (* d2 n2z))))))
                                                (ea (* (+ (* cvx n0x) (+ (* cvy n0y) (* cvz n0z))) kds0))
                                                (eb (* (+ (* cvx n1x) (+ (* cvy n1y) (* cvz n1z))) kds1))
                                                (ec (* (+ (* cvx n2x) (+ (* cvy n2y) (* cvz n2z))) kds2)))
                                           (set! cvx (+ (+ (* ea n0x) (+ (* eb n1x) (* ec n2x)))
                                                        (+ cfx ggx)))
                                           (set! cvy (+ (+ (* ea n0y) (+ (* eb n1y) (* ec n2y)))
                                                        (+ cfy ggy)))
                                           (set! cvz (+ (+ (* ea n0z) (+ (* eb n1z) (* ec n2z)))
                                                        (+ cfz ggz)))
                                           (set! cpx (+ cpx cvx))
                                           (set! cpy (+ cpy cvy))
                                           (set! cpz (+ cpz cvz))))))
                                   ;; [NOTE-62] L'ELONGATION RADIALE : LA COMPOSANTE DU POINT LIBRE LE LONG DE -> jak-hd-physics-NOTES.md
                                   (when (nonzero? rlo)
                                     ;; [NOTE-87] SPEC 21 BORNE LE DEPLACEMENT, PAS LA FORCE. -> jak-hd-physics-NOTES.md
                                     ;; [NOTE-425] IDENTITE STRICTE sous 0.84*(ckn+ccp) = 0.336 B0 : rien n'est -> jak-hd-physics-NOTES.md
                                     (let* ((wex (- cpx tgx))
                                            (wey (- cpy tgy))
                                            (wez (- cpz tgz))
                                            (wed (sqrtf (+ (* wex wex) (+ (* wey wey) (* wez wez)))))
                                            (wsm (if (zero? *phys-rr-off*)
                                                   (phys-softmin wed (+ ckn ccp))
                                                   wed)))
                                       (when (and (> wed 0.0001) (< wsm (- wed 0.000001)))
                                         (let ((ws (/ wsm wed)))
                                           (set! cpx (+ tgx (* wex ws)))
                                           (set! cpy (+ tgy (* wey ws)))
                                           (set! cpz (+ tgz (* wez ws))))
                                         (set! *phys-cwn* (+ *phys-cwn* 1))
                                         (set! *phys-cwsum* (+ *phys-cwsum* (- wed wsm)))))
                                     (set! (-> *phys-cpx* scl) cpx)
                                     (set! (-> *phys-cpy* scl) cpy)
                                     (set! (-> *phys-cpz* scl) cpz)
                                     (set! (-> *phys-cqx* scl) (- cpx (* fns cvx)))
                                     (set! (-> *phys-cqy* scl) (- cpy (* fns cvy)))
                                     (set! (-> *phys-cqz* scl) (- cpz (* fns cvz)))
                                     (let* ((mx  (- (-> *phys-px* scl) ax))
                                            (my  (- (-> *phys-py* scl) ay))
                                            (mz  (- (-> *phys-pz* scl) az))
                                            (ml  (sqrtf (+ (* mx mx) (+ (* my my) (* mz mz)))))
                                            (dr0 (if (and (> bl 0.01) (> ml 0.01))
                                                   (- (/ (+ (* (- cpx ax) mx)
                                                            (+ (* (- cpy ay) my)
                                                               (* (- cpz az) mz)))
                                                         ml)
                                                      bl)
                                                   0.0))
                                            ;; [NOTE-81] LA BORNE DE §22 SUR LE CANAL RADIAL. -> jak-hd-physics-NOTES.md
                                            (rcap (if (zero? *phys-rr-off*) (fmin (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 20)) b0e) (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 13)) bl)) (* 1000000.0 b0e)))
                                            ;; [NOTE-84] LA BORNE EST APPELEE SUR LA VALEUR LIVREE, JAMAIS SUR L'ETAT. -> jak-hd-physics-NOTES.md
                                            (drr (if (>= dr0 0.0)
                                                   (phys-softmin dr0 rcap)
                                                   (- 0.0 (phys-softmin (- 0.0 dr0) rcap)))))
                                       ;; [NOTE-84] `*phys-rr*` GARDE LA RACINE ; LES AGREGATS PORTENT TOUTE LA CHAINE. -> jak-hd-physics-NOTES.md
                                       (when (= l rlk)
                                         (set! (-> *phys-rr* sc) drr))
                                       (set! (-> *phys-rrl* scl) drr)
                                       (when (> (fabs (- dr0 drr)) 0.000001)
                                         (set! *phys-rrsat* (+ *phys-rrsat* 1))
                                         (set! (-> *phys-rrsl* scl) (+ 1.0 (-> *phys-rrsl* scl))))
                                       (let ((a0 (/ (fabs dr0) (fmax 1.0 b0e))))
                                         (when (> a0 (-> *phys-rrr* sc))
                                           (set! (-> *phys-rrr* sc) a0))
                                         (when (> a0 (-> *phys-rrrl* scl))
                                           (set! (-> *phys-rrrl* scl) a0)
                                           (set! (-> *phys-rrol* scl) (/ (- ml bl) (fmax 1.0 b0e)))
                                           (set! (-> *phys-rrcl* scl)
                                                 (/ (/ (+ (* (- cpx (-> *phys-px* scl)) mx)
                                                          (+ (* (- cpy (-> *phys-py* scl)) my)
                                                             (* (- cpz (-> *phys-pz* scl)) mz)))
                                                       ml)
                                                    (fmax 1.0 b0e)))
                                           (let* ((ftx (- cpx tgx)) (fty (- cpy tgy)) (ftz (- cpz tgz))
                                                  (fb  (fmax 1.0 b0e)))
                                             (set! (-> *phys-rrtl* scl)
                                                   (/ (/ (+ (* ftx mx) (+ (* fty my) (* ftz mz))) ml) fb))
                                             (set! (-> *phys-cddl* scl)
                                                   (/ (sqrtf (+ (* ftx ftx) (+ (* fty fty) (* ftz ftz)))) fb)))))
                                       (let ((ar (/ (fabs drr) (fmax 1.0 b0e))))
                                         (when (> ar (-> *phys-rrm* sc))
                                           (set! (-> *phys-rrm* sc) ar))
                                         (when (> ar (-> *phys-rrml* scl))
                                           (set! (-> *phys-rrml* scl) ar)))))
                                   (set! (-> *phys-qx* scl) (- (-> *phys-px* scl) (* fns vx)))
                                   (set! (-> *phys-qy* scl) (- (-> *phys-py* scl) (* fns vy)))
                                   (set! (-> *phys-qz* scl) (- (-> *phys-pz* scl) (* fns vz))) (when (= l rlk) (set! (-> *phys-dg* (+ (* sc PHYS-DG) 97)) (- (-> *phys-px* scl) px0)) (set! (-> *phys-dg* (+ (* sc PHYS-DG) 98)) (- (-> *phys-py* scl) py0)) (set! (-> *phys-dg* (+ (* sc PHYS-DG) 99)) (- (-> *phys-pz* scl) pz0)) (set! (-> *phys-dg* (+ (* sc PHYS-DG) 96)) (sqrtf (+ (* (- (-> *phys-px* scl) px0) (- (-> *phys-px* scl) px0)) (+ (* (- (-> *phys-py* scl) py0) (- (-> *phys-py* scl) py0)) (* (- (-> *phys-pz* scl) pz0) (- (-> *phys-pz* scl) pz0)))))))))))))))

                    ;; [NOTE-221] ---- 2. LES CONTRAINTES. Gauss-Seidel : longueur puis collision, puis des -> jak-hd-physics-NOTES.md
                    (phys-cap-ang! skel sc n rlk an nbone 0)
                    (phys-stage-jt! skel sc rlk nbone 0)
                    ;; [NOTE-43] ------------------------------------------------------------------------ -> jak-hd-physics-NOTES.md
                    ;; [NOTE-331] POURQUOI LA GARDE `(= n 1)` A ETE RETIREE DU MUR D'APEX DE SPEC 22 -> jak-hd-physics-NOTES.md
                    (when (= (-> *phys-fam* sc) 1)
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (k   (-> *phys-joint* scl)))
                            (when (and (>= k 0) (< (+ k 1) nbone))
                              (let* ((kp  (if (> l rlk) (-> *phys-joint* (- scl 1)) -1))
                                     (kpo (and (>= kp 0) (< (+ kp 1) nbone)))
                                     ;; [NOTE-113] SPEC 22 EST UNE BORNE DE REPLI, PAS UNE LAISSE VERS LA POSE D'AUTEUR. -> jak-hd-physics-NOTES.md
                                     (tx (+ (-> skel bones (+ k 1) transform vector 3 x)
                                            (if kpo (- (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)) 0.0)))
                                     (ty (+ (-> skel bones (+ k 1) transform vector 3 y)
                                            (if kpo (- (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)) 0.0)))
                                     (tz (+ (-> skel bones (+ k 1) transform vector 3 z)
                                            (if kpo (- (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)) 0.0)))
                                     (dx (- (-> *phys-px* scl) tx))
                                     (dy (- (-> *phys-py* scl) ty))
                                     (dz (- (-> *phys-pz* scl) tz))
                                     (dd (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz)))))
                                     ;; SPEC 22 : plafond NORMAL (genou) et marge jusqu'au plafond
                                     ;; DUR, en unites de `B0` — la CHAIR (SPEC 6), pas l'os.
                                     (b0f (if (> (-> *phys-b0* sc) 0.0) (-> *phys-b0* sc)
                                            (-> *phys-blen* scl)))
                                     ;; [NOTE-66] [NOTE-C28] CE `b0f` N'EST PAS LE RAYON DU MAILLON, ET C'EST -> jak-hd-physics-NOTES.md
                                     ;; [NOTE-114] LA MEME LONGUEUR ABSOLUE SUR DEUX OS DE 1040.5 ET 140.4 u -> jak-hd-physics-NOTES.md
                                     (rlb (-> *phys-blen* (+ (* sc PHYS-LINKS) rlk)))
                                     (rl  (if (> rlb 0.01) (fmin 1.0 (/ (-> *phys-blen* scl) rlb)) 1.0))
                                     (kn (* (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 16)) b0f) rl))
                                     (cp (* (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 17)) b0f) rl)))
                                (when (and (> dd kn) (> cp 0.0001))
                                  (let* ((xr (/ (- dd kn) cp))
                                         (th (if (>= xr 3.0)
                                               1.0
                                               (/ (* xr (+ 27.0 (* xr xr)))
                                                  (+ 27.0 (* 9.0 (* xr xr))))))
                                         (ds (+ kn (* cp th)))
                                         (sf (/ ds dd)))
                                    (when (< sf 0.999999)
                                      (set! *phys-sat-n* (+ *phys-sat-n* 1))
                                      (set! *phys-sat-sum* (+ *phys-sat-sum* (- dd ds)))
                                      (set! (-> *phys-px* scl) (+ tx (* dx sf)))
                                      (set! (-> *phys-py* scl) (+ ty (* dy sf)))
                                      (set! (-> *phys-pz* scl) (+ tz (* dz sf))))))))))))
                    ;; SPEC 33/34 — la poussee de contact de CETTE frame, remise a zero avant les
                    ;; balayages : elle n'est pas un etat, elle est l'integrale d'une frame.
                    (dotimes (l n)
                      (let ((scl (+ (* sc PHYS-LINKS) l)))
                        (set-vector! (-> *phys-cpu* scl) 0.0 0.0 0.0 0.0)
                        (set! (-> *phys-cpe* scl) 0.0)
                        ;; [NOTE-97] les quatre grandeurs de l'instrument vivent EXACTEMENT le meme
                        ;; cycle de vie que `*phys-cpu*` : une frame, pas un etat.
                        (dotimes (k 7) (set! (-> *phys-cpa* (+ (* 7 scl) k)) 0.0))))
                    (set! *phys-swc* 0)
                    (phys-stage-jt! skel sc rlk nbone 1)
                    (dotimes (it 8)
                      (phys-length-chain skel sc n rlk an nbone)
                      (when (zero? it) (phys-stage-jt! skel sc rlk nbone 2))
                      (phys-collide-chain skel sc n rlk nbone nco PHYS-COL-MARGIN 3)
                      (when (zero? it) (phys-stage-jt! skel sc rlk nbone 3)))
                    (phys-stage-jt! skel sc rlk nbone 4)
                    ;; [NOTE-44] L'ATTENUATION D'ANGLE DES CHEVEUX, UNE SEULE FOIS. Elle reste : c'est le -> jak-hd-physics-NOTES.md
                    (phys-bend-chain skel sc n rlk an nbone #f)
                    ;; [NOTE-347] les deux ETAGES de `phys-cap-ang!` : ce que longueur, collision et attenuation retirent -> jak-hd-physics-NOTES.md
                    (phys-cap-ang! skel sc n rlk an nbone 1)
                    ;; [NOTE-93] PIERRE TOMBALE — `phys-retreat-chain`, A NE PAS REMETTRE. -> jak-hd-physics-NOTES.md
                    ;; [NOTE-117] L'ATTENUATION D'ANGLE ENTRE DANS LA RELAXATION DE QUEUE. -> jak-hd-physics-NOTES.md
                    (dotimes (it 3)
                      (phys-length-chain skel sc n rlk an nbone)
                      (phys-collide-chain skel sc n rlk nbone nco PHYS-COL-MARGIN 3)
                      (phys-bend-chain skel sc n rlk an nbone #t))
                    ;; [NOTE-45] ------------------------------------------------------------------------ -> jak-hd-physics-NOTES.md
                    (dotimes (it 4)
                      (phys-collide-chain skel sc n rlk nbone nco PHYS-COL-MARGIN 3)
                      (phys-bend-chain skel sc n rlk an nbone #t))
                    (phys-stage-jt! skel sc rlk nbone 5)
                    ;; [NOTE-323] SPEC 33/34 — la peau ferme la frame -> jak-hd-physics-NOTES.md
                    ;; [NOTE-470] cycle 104 : ALTERNEES, PAS ENCHAINEES — la peau ferme VRAIMENT -> jak-hd-physics-NOTES.md
                    (dotimes (it 2) (phys-cap-e22! skel sc n rlk an nbone) (phys-skin-chain skel sc n rlk nbone))
                    (phys-stage-jt! skel sc rlk nbone 6)
                    ;; [NOTE-63] SPEC 33/34 — LA RESTITUTION, UNE FOIS PAR FRAME, SUR LA VITESSE SEULE. -> jak-hd-physics-NOTES.md
                    (when (zero? *phys-rst-off*)
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (dx (-> *phys-cpu* scl x))
                                 (dy (-> *phys-cpu* scl y))
                                 (dz (-> *phys-cpu* scl z))
                                 (dl (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))
                            (when (> dl 0.0001)
                              (let* ((nx (/ dx dl))
                                     (ny (/ dy dl))
                                     (nz (/ dz dl))
                                     (vx (- (- (-> *phys-px* scl) dx) (-> *phys-qx* scl)))
                                     (vy (- (- (-> *phys-py* scl) dy) (-> *phys-qy* scl)))
                                     (vz (- (- (-> *phys-pz* scl) dz) (-> *phys-qz* scl)))
                                     (vn (+ (* vx nx) (+ (* vy ny) (* vz nz))))
                                     (e  (* *phys-rst-k* (-> *phys-cpe* scl))))
                                (set! (-> *phys-qx* scl) (+ (-> *phys-qx* scl) dx))
                                (set! (-> *phys-qy* scl) (+ (-> *phys-qy* scl) dy))
                                (set! (-> *phys-qz* scl) (+ (-> *phys-qz* scl) dz))
                                (when (< vn 0.0)
                                  (let ((c (* (+ 1.0 e) vn)))
                                    (set! (-> *phys-qx* scl) (+ (-> *phys-qx* scl) (* c nx)))
                                    (set! (-> *phys-qy* scl) (+ (-> *phys-qy* scl) (* c ny)))
                                    (set! (-> *phys-qz* scl) (+ (-> *phys-qz* scl) (* c nz)))
                                    (set! *phys-rstn* (+ *phys-rstn* 1))
                                    (set! *phys-rstin* (+ *phys-rstin* (- vn)))
                                    (set! *phys-rstsum* (+ *phys-rstsum* e))
                                    ;; on ARME la mesure de sortie pour la frame suivante (0bis)
                                    (set-vector! (-> *phys-rstp* scl) nx ny nz 1.0)))))))))
                    ;; [NOTE-46] ------------------------------------------------------------------------ -> jak-hd-physics-NOTES.md
                    (phys-flip-count skel sc n rlk nbone nco)

                    ;; [NOTE-426] ---- 3bis. CONTROLE POSITIF DES INVERSIONS. Arme, chaque lien libre est -> jak-hd-physics-NOTES.md
                    (when (nonzero? *phys-inv-inject*)
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let ((scl (+ (* sc PHYS-LINKS) l)))
                            (set! (-> *phys-px* scl) (- (* 2.0 (-> anc x)) (-> *phys-px* scl)))
                            (set! (-> *phys-py* scl) (- (* 2.0 (-> anc y)) (-> *phys-py* scl)))
                            (set! (-> *phys-pz* scl) (- (* 2.0 (-> anc z)) (-> *phys-pz* scl)))))))

                    ;; [NOTE-220] ---- 3. L'INJECTION DE DEFAUT A DEMENAGE — [NOTE-155]. Elle etait ICI, EN -> jak-hd-physics-NOTES.md

                    ;; [NOTE-427] ---- 4. LES CONTRAINTES ONT BOUGE LA POSITION : on remet cet effet dans -> jak-hd-physics-NOTES.md
                    (dotimes (l n)
                      (when (>= l rlk)
                        (let* ((scl (+ (* sc PHYS-LINKS) l))
                               (k   (-> *phys-joint* scl)))
                          (when (and (>= k 0) (< (+ k 1) nbone))
                            (set-vector! ov
                              (- (-> *phys-px* scl) (-> skel bones (+ k 1) transform vector 3 x))
                              (- (-> *phys-py* scl) (-> skel bones (+ k 1) transform vector 3 y))
                              (- (-> *phys-pz* scl) (-> skel bones (+ k 1) transform vector 3 z))
                              0.0)
                            (vector-rotate*! ov ov w2l)
                            (set! (-> *phys-ox* scl) (-> ov x))
                            (set! (-> *phys-oy* scl) (-> ov y))
                            (set! (-> *phys-oz* scl) (-> ov z))))))

                    ;; [NOTE-193] ---- 4bis. CONTROLE POSITIF DU CANAL D'AUTEUR. Arme, la position ecrite est -> jak-hd-physics-NOTES.md
                    (when (nonzero? *phys-auth-lag*)
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (k   (-> *phys-joint* scl)))
                            (when (and (>= k 0) (< (+ k 1) nbone))
                              ;; t2 porte la pose d'auteur de la frame PRECEDENTE : le bloc
                              ;; d'integration vient d'y decaler l'ancienne valeur de t1.
                              (set! (-> *phys-px* scl)
                                    (+ (-> *phys-px* scl)
                                       (- (-> *phys-t2x* scl) (-> skel bones (+ k 1) transform vector 3 x))))
                              (set! (-> *phys-py* scl)
                                    (+ (-> *phys-py* scl)
                                       (- (-> *phys-t2y* scl) (-> skel bones (+ k 1) transform vector 3 y))))
                              (set! (-> *phys-pz* scl)
                                    (+ (-> *phys-pz* scl)
                                       (- (-> *phys-t2z* scl) (-> skel bones (+ k 1) transform vector 3 z)))))))))

                    ;; [NOTE-192] ------------------------------------------------------------------------ -> jak-hd-physics-NOTES.md
                    (let ((stb (* sc PHYS-ST)))
                      ;; [NOTE-428] --- LE GRADIENT : la boite englobante de l'ecart POUR CHAQUE MAILLON. -> jak-hd-physics-NOTES.md
                      (dotimes (l n)
                        (let* ((scl (+ (* sc PHYS-LINKS) l))
                               (lb  (* scl PHYS-LB))
                               (ox  (-> *phys-ox* scl))
                               (oy  (-> *phys-oy* scl))
                               (oz  (-> *phys-oz* scl)))
                          (when (< ox (-> *phys-lb* (+ lb 0))) (set! (-> *phys-lb* (+ lb 0)) ox))
                          (when (> ox (-> *phys-lb* (+ lb 1))) (set! (-> *phys-lb* (+ lb 1)) ox))
                          (when (< oy (-> *phys-lb* (+ lb 2))) (set! (-> *phys-lb* (+ lb 2)) oy))
                          (when (> oy (-> *phys-lb* (+ lb 3))) (set! (-> *phys-lb* (+ lb 3)) oy))
                          (when (< oz (-> *phys-lb* (+ lb 4))) (set! (-> *phys-lb* (+ lb 4)) oz))
                          (when (> oz (-> *phys-lb* (+ lb 5))) (set! (-> *phys-lb* (+ lb 5)) oz))))
                      ;; --- ecart a la pose du modele, par lien libre (SPEC 4, lu au repos) ---
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (k   (-> *phys-joint* scl)))
                            (when (and (>= k 0) (< (+ k 1) nbone))
                              (set! (-> pt x) (-> *phys-px* scl))
                              (set! (-> pt y) (-> *phys-py* scl))
                              (set! (-> pt z) (-> *phys-pz* scl))
                              (set! (-> pt w) 1.0)
                              (let ((dv (vector-vector-distance
                                          pt (the-as vector (-> skel bones (+ k 1) transform vector 3)))))
                                (when (> dv (-> *phys-st* (+ stb 5)))
                                  (set! (-> *phys-st* (+ stb 5)) dv)))))))
                      ;; [NOTE-335] LE RESIDU SIGNE DE PENETRATION PART DE -1e9, PAS DE ZERO -> jak-hd-physics-NOTES.md
                      (let ((pen (phys-pen-chain skel sc n rlk nbone nco)))
                        (when (> pen PHYS-NOCONTACT-LIMIT)
                          ;; frame ou au moins une paire (lien, volume) etait en contact : c'est la
                          ;; seule sorte de frame ou « penetration nulle » veut dire quelque chose.
                          (set! (-> *phys-conf* sc) (+ 1.0 (-> *phys-conf* sc)))
                          (when (> pen (-> *phys-st* (+ stb 4)))
                            (set! (-> *phys-st* (+ stb 4)) pen)))
                        ;; [NOTE-429] LE CONTROLE POSITIF, APPARIE SUR CETTE FRAME. Il ne tourne que -> jak-hd-physics-NOTES.md
                        (when (> *phys-inject* 0.01)
                          (phys-inject-probe! skel sc n rlk nbone nco pen)))
                      ;; [NOTE-150] la profondeur AJOUTEE sous la peau, MAXIMUM DE LA FENETRE.
                      (when (> (-> *phys-saf* sc) (-> *phys-st* (+ stb 20)))
                        (set! (-> *phys-st* (+ stb 20)) (-> *phys-saf* sc)))
                      ;; [NOTE-219] --- ancrage de la racine (SPEC 2). Deux residus, on garde le pire : -> jak-hd-physics-NOTES.md
                      (let ((rd 0.0))
                        (let ((k0 (-> *phys-joint* (* sc PHYS-LINKS))))
                          (when (and (>= k0 0) (< (+ k0 1) nbone))
                            (set! (-> pt x) (-> *phys-px* (* sc PHYS-LINKS)))
                            (set! (-> pt y) (-> *phys-py* (* sc PHYS-LINKS)))
                            (set! (-> pt z) (-> *phys-pz* (* sc PHYS-LINKS)))
                            (set! (-> pt w) 1.0)
                            (set! rd (vector-vector-distance
                                       pt (the-as vector (-> skel bones (+ k0 1) transform vector 3))))))
                        (let* ((l0   rlk)
                               (scl  (+ (* sc PHYS-LINKS) l0))
                               (kk   (-> *phys-joint* scl))
                               (kp   (if (> l0 0) (-> *phys-joint* (- scl 1)) an)))
                          (when (and (< l0 n) (>= kk 0) (>= kp 0)
                                     (< (+ kk 1) nbone) (< (+ kp 1) nbone))
                            (let* ((want (vector-vector-distance
                                           (the-as vector (-> skel bones (+ kk 1) transform vector 3))
                                           (the-as vector (-> skel bones (+ kp 1) transform vector 3))))
                                   (bx (if (> l0 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                                   (by (if (> l0 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                                   (bz (if (> l0 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                                   (dx (- (-> *phys-px* scl) bx))
                                   (dy (- (-> *phys-py* scl) by))
                                   (dz (- (-> *phys-pz* scl) bz))
                                   (got (sqrtf (+ (* dx dx) (* dy dy) (* dz dz))))
                                   (res (fabs (- got want))))
                              (when (> res rd) (set! rd res)))))
                        (when (> rd (-> *phys-st* (+ stb 3)))
                          (set! (-> *phys-st* (+ stb 3)) rd)))
                      ;; [NOTE-191] --- ALLONGEMENT RELATIF et INVERSION RESIDUELLE, sur la position ECRITE et -> jak-hd-physics-NOTES.md
                      (dotimes (l n)
                        (when (>= l rlk)
                          (let* ((scl (+ (* sc PHYS-LINKS) l))
                                 (kk  (-> *phys-joint* scl))
                                 (kp  (if (> l 0) (-> *phys-joint* (- scl 1)) an)))
                            (when (and (>= kk 0) (>= kp 0) (< (+ kk 1) nbone) (< (+ kp 1) nbone))
                              (let* ((bx (if (> l 0) (-> *phys-px* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 x)))
                                     (by (if (> l 0) (-> *phys-py* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 y)))
                                     (bz (if (> l 0) (-> *phys-pz* (- scl 1)) (-> skel bones (+ kp 1) transform vector 3 z)))
                                     (mx (- (-> skel bones (+ kk 1) transform vector 3 x)
                                            (-> skel bones (+ kp 1) transform vector 3 x)))
                                     (my (- (-> skel bones (+ kk 1) transform vector 3 y)
                                            (-> skel bones (+ kp 1) transform vector 3 y)))
                                     (mz (- (-> skel bones (+ kk 1) transform vector 3 z)
                                            (-> skel bones (+ kp 1) transform vector 3 z)))
                                     (ux (- (-> *phys-px* scl) bx))
                                     (uy (- (-> *phys-py* scl) by))
                                     (uz (- (-> *phys-pz* scl) bz))
                                     (m2 (+ (* mx mx) (+ (* my my) (* mz mz))))
                                     (u2 (+ (* ux ux) (+ (* uy uy) (* uz uz))))
                                     (dot (+ (* ux mx) (+ (* uy my) (* uz mz)))))
                                (when (> m2 0.0001)
                                  ;; [NOTE-100] LA DEFORMATION QUE LA CHAIR SUBIT, et ce n'est ni tipvar ni elong. -> jak-hd-physics-NOTES.md
                                  (let* ((wx (- (-> *phys-px* scl)
                                                (-> skel bones (+ kk 1) transform vector 3 x)))
                                         (wy (- (-> *phys-py* scl)
                                                (-> skel bones (+ kk 1) transform vector 3 y)))
                                         (wz (- (-> *phys-pz* scl)
                                                (-> skel bones (+ kk 1) transform vector 3 z)))
                                         (sh (/ (sqrtf (+ (* wx wx) (+ (* wy wy) (* wz wz))))
                                                (sqrtf m2))))
                                    (when (> sh (-> *phys-dg* (+ (* sc PHYS-DG) 8)))
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 8)) sh)))
                                  (let ((el (fabs (- (/ (sqrtf u2) (sqrtf m2)) 1.0))))
                                    (when (> el (-> *phys-dg* (+ (* sc PHYS-DG) 5)))
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 5)) el))
                                    ;; [NOTE-430] LE MEME ALLONGEMENT, MAIS PAR FENETRE : « ils s'allongent sur -> jak-hd-physics-NOTES.md
                                    (when (> el (-> *phys-st* (+ stb 17)))
                                      (set! (-> *phys-st* (+ stb 17)) el)))
                                  ;; [NOTE-190] LE MOUVEMENT PROPRE DU MAILLON : l'angle entre sa direction -> jak-hd-physics-NOTES.md
                                  (when (> u2 0.0001)
                                    (let* ((cx (- (* uy mz) (* uz my)))
                                           (cy (- (* uz mx) (* ux mz)))
                                           (cz (- (* ux my) (* uy mx)))
                                           (sn (sqrtf (+ (* cx cx) (+ (* cy cy) (* cz cz)))))
                                           ;; 360 / 65536 : `atan` rend des unites de rotation, on
                                           ;; publie des degres.
                                           (ang (* 0.0054931641 (atan sn dot))))
                                      (when (> ang (-> *phys-la* scl))
                                        (set! (-> *phys-la* scl) ang))))
                                  ;; [NOTE-431] LA MEME DEVIATION, MAIS SIGNEE ET VECTORIELLE (voir la note de -> jak-hd-physics-NOTES.md
                                  (when (> u2 0.0001)
                                    (let ((iu (/ 1.0 (sqrtf u2)))
                                          (im (/ 1.0 (sqrtf m2)))
                                          (sv3 (* scl 3)))
                                      (set! (-> *phys-lsv* (+ sv3 0)) (- (* ux iu) (* mx im)))
                                      (set! (-> *phys-lsv* (+ sv3 1)) (- (* uy iu) (* my im)))
                                      (set! (-> *phys-lsv* (+ sv3 2)) (- (* uz iu) (* mz im)))
                                      ;; [NOTE-129] DEVIATION SUR TRIEDRE -> jak-hd-physics-NOTES.md
                                      (when (nonzero? (-> *phys-axok* sc))
                                        (let ((dvx (- (* ux iu) (* mx im)))
                                              (dvy (- (* uy iu) (* my im)))
                                              (dvz (- (* uz iu) (* mz im)))
                                              ;; [NOTE-201] LA MEME DIFFERENCE, SANS NORMALISER (voir la note -> jak-hd-physics-NOTES.md
                                              (bvx (- ux mx))
                                              (bvy (- uy my))
                                              (bvz (- uz mz)))
                                          (dotimes (ii 3)
                                            (let* ((row (cond ((= ii 0) (-> *phys-axv* sc))
                                                              ((= ii 1) (-> *phys-axa* sc))
                                                              (else     (-> *phys-axl* sc))))
                                                   (rx (-> am vector row x))
                                                   (ry (-> am vector row y))
                                                   (rz (-> am vector row z))
                                                   (rl (sqrtf (+ (* rx rx) (+ (* ry ry) (* rz rz))))))
                                              (set! (-> *phys-lda* (+ sv3 ii))
                                                    (if (> rl 0.0001)
                                                      (/ (+ (* dvx rx) (+ (* dvy ry) (* dvz rz))) rl)
                                                      0.0))
                                              ;; MEME LIGNE, MEME NORMALISATION DE LIGNE, MEME
                                              ;; INSTANT : seule la grandeur projetee change.
                                              (set! (-> *phys-ldb* (+ sv3 ii))
                                                    (if (> rl 0.0001)
                                                      (/ (+ (* bvx rx) (+ (* bvy ry) (* bvz rz))) rl)
                                                      0.0))))))))
                                  ;; [NOTE-130] INSTRUMENT = DECISION -> jak-hd-physics-NOTES.md
                                  (when (and (= l rlk) (< dot 0.0)
                                             (> (* dot dot) (* PHYS-SIDE-COS2 (* u2 m2))))
                                    (set! *phys-invres* (+ *phys-invres* 1))
                                    (set! (-> *phys-dg* (+ (* sc PHYS-DG) 4))
                                          (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 4)))))))))))
                      ;; --- la pointe : amplitude de l'ecart (physique seule) et intention
                      ;; --- d'auteur sur CETTE chaine, la meme frame (SPEC 5).
                      (let* ((sclt (+ (* sc PHYS-LINKS) (- n 1)))
                             (kt   (-> *phys-joint* sclt)))
                        (when (and (>= kt 0) (< (+ kt 1) nbone))
                          (let ((ox (-> *phys-ox* sclt))
                                (oy (-> *phys-oy* sclt))
                                (oz (-> *phys-oz* sclt)))
                            ;; pointe d'AUTEUR dans le repere de l'ancre (transformation de POINT :
                            ;; w = 1, la translation compte)
                            (set-vector! uv (-> skel bones (+ kt 1) transform vector 3 x)
                                            (-> skel bones (+ kt 1) transform vector 3 y)
                                            (-> skel bones (+ kt 1) transform vector 3 z)
                                            1.0)
                            (vector-matrix*! uv uv w2l)
                            ;; boite englobante de l'ecart de pointe
                            (when (< ox (-> *phys-st* (+ stb 6)))  (set! (-> *phys-st* (+ stb 6)) ox))
                            (when (> ox (-> *phys-st* (+ stb 7)))  (set! (-> *phys-st* (+ stb 7)) ox))
                            (when (< oy (-> *phys-st* (+ stb 8)))  (set! (-> *phys-st* (+ stb 8)) oy))
                            (when (> oy (-> *phys-st* (+ stb 9)))  (set! (-> *phys-st* (+ stb 9)) oy))
                            (when (< oz (-> *phys-st* (+ stb 10))) (set! (-> *phys-st* (+ stb 10)) oz))
                            (when (> oz (-> *phys-st* (+ stb 11))) (set! (-> *phys-st* (+ stb 11)) oz))
                            ;; [NOTE-200] POSITION MOYENNE de la pointe dans le repere de l'ancre. La boite -> jak-hd-physics-NOTES.md
                            (set! (-> *phys-st* (+ stb 12)) (+ ox (-> *phys-st* (+ stb 12))))
                            (set! (-> *phys-st* (+ stb 13)) (+ oy (-> *phys-st* (+ stb 13))))
                            (set! (-> *phys-st* (+ stb 14)) (+ oz (-> *phys-st* (+ stb 14))))
                            (set! (-> *phys-st* (+ stb 15)) (+ 1.0 (-> *phys-st* (+ stb 15))))
                            ;; [NOTE-94] L'IDENTITE DU CANAL D'AUTEUR, EN REPERE MONDE. -> jak-hd-physics-NOTES.md
                            (set-vector! sv
                              (- (-> *phys-px* sclt) (-> skel bones (+ kt 1) transform vector 3 x))
                              (- (-> *phys-py* sclt) (-> skel bones (+ kt 1) transform vector 3 y))
                              (- (-> *phys-pz* sclt) (-> skel bones (+ kt 1) transform vector 3 z))
                              0.0)
                            (set-vector! uv2 ox oy oz 0.0)
                            (vector-rotate*! uv2 uv2 am)
                            (when (nonzero? (-> *phys-thas* sc))
                              (let* ((cdx (- ox (-> *phys-tx* sc)))
                                     (cdy (- oy (-> *phys-ty* sc)))
                                     (cdz (- oz (-> *phys-tz* sc)))
                                     (d   (sqrtf (+ (* cdx cdx) (* cdy cdy) (* cdz cdz)))))
                                (set! (-> *phys-st* (+ stb 0)) (+ 1.0 (-> *phys-st* (+ stb 0))))
                                (set! (-> *phys-st* (+ stb 1)) (+ d (-> *phys-st* (+ stb 1))))
                                (when (> d (-> *phys-st* (+ stb 2))) (set! (-> *phys-st* (+ stb 2)) d))
                                (when (nonzero? (-> *phys-rhas* sc))
                                  (let* ((adx (- (-> uv x) (-> *phys-rtx* sc)))
                                         (ady (- (-> uv y) (-> *phys-rty* sc)))
                                         (adz (- (-> uv z) (-> *phys-rtz* sc)))
                                         (am2 (+ (* adx adx) (* ady ady) (* adz adz)))
                                         (amg (sqrtf am2)))
                                    (when (> amg PHYS-AUTH-EPS)
                                      ;; [NOTE-131] ANIMATION INTACTE ? -> jak-hd-physics-NOTES.md
                                      (let* ((ex (- (-> sv x) (-> uv2 x)))
                                             (ey (- (-> sv y) (-> uv2 y)))
                                             (ez (- (-> sv z) (-> uv2 z)))
                                             (er (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez)))))
                                             (sdx (+ adx cdx)) (sdy (+ ady cdy)) (sdz (+ adz cdz)))
                                        (set! (-> *phys-ahit* sc) (+ 1.0 (-> *phys-ahit* sc)))
                                        (when (<= er PHYS-AUTH-TOL)
                                          (set! (-> *phys-aok* sc) (+ 1.0 (-> *phys-aok* sc))))
                                        ;; [NOTE-336] LES DEUX CORRELATIONS PUBLIEES MAIS NON GATEES -> jak-hd-physics-NOTES.md
                                        (set! (-> *phys-adot* sc)
                                              (+ (-> *phys-adot* sc)
                                                 (+ (* sdx adx) (+ (* sdy ady) (* sdz adz)))))
                                        (set! (-> *phys-anrm* sc) (+ (-> *phys-anrm* sc) am2))
                                        (set! (-> *phys-dsum* sc) (+ (-> *phys-dsum* sc) d))
                                        (set! (-> *phys-usum* sc) (+ (-> *phys-usum* sc) amg))))))))
                            (set! (-> *phys-tx* sc) ox)
                            (set! (-> *phys-ty* sc) oy)
                            (set! (-> *phys-tz* sc) oz)
                            (set! (-> *phys-thas* sc) 1)
                            (set! (-> *phys-rtx* sc) (-> uv x))
                            (set! (-> *phys-rty* sc) (-> uv y))
                            (set! (-> *phys-rtz* sc) (-> uv z))
                            (set! (-> *phys-rhas* sc) 1)))))

                    ;; [NOTE-78] ---- 5bis. SPEC 8 / 10-13 / 29-torsion / 36 — L'ETAT DE FORME ET DE TORSION. -> jak-hd-physics-NOTES.md
                    (when (and (= (-> *phys-fam* sc) 1) (> n 0))
                      (let* ((tl  (+ (* sc PHYS-LINKS) (- n 1)))
                             (gb  (* sc 3))
                             (b0f (fmax 1.0 (if (> (-> *phys-b0* sc) 0.0)
                                              (-> *phys-b0* sc) (-> *phys-blen* tl)))))
                        ;; [NOTE-337] LE TRIEDRE DE SPEC 7, RELEVE UNE SEULE FOIS -> jak-hd-physics-NOTES.md
                        (when (and (zero? (-> *phys-fok* sc)) (nonzero? (-> *phys-ucap* tl)))
                          (let ((gn (sqrtf (+ (* (-> *phys-gref* gb) (-> *phys-gref* gb))
                                              (+ (* (-> *phys-gref* (+ gb 1)) (-> *phys-gref* (+ gb 1)))
                                                 (* (-> *phys-gref* (+ gb 2)) (-> *phys-gref* (+ gb 2))))))))
                            (when (> gn 0.0001)
                              (set-vector! (-> *phys-fy* sc)
                                           (/ (- 0.0 (-> *phys-gref* gb)) gn)
                                           (/ (- 0.0 (-> *phys-gref* (+ gb 1))) gn)
                                           (/ (- 0.0 (-> *phys-gref* (+ gb 2))) gn) 0.0)
                              ;; [NOTE-67] +Z = L'AXE AVANT-ARRIERE DE L'ANCRE, ET C'EST UNE CORRECTION MESUREE. -> jak-hd-physics-NOTES.md
                              (let* ((ia (-> *phys-axa* sc))
                                     (e0 (if (= ia 0) 1.0 0.0))
                                     (e1 (if (= ia 1) 1.0 0.0))
                                     (e2 (if (= ia 2) 1.0 0.0))
                                     (d  (+ (* e0 (-> *phys-fy* sc x))
                                            (+ (* e1 (-> *phys-fy* sc y))
                                               (* e2 (-> *phys-fy* sc z)))))
                                     (zx0 (- e0 (* d (-> *phys-fy* sc x))))
                                     (zy0 (- e1 (* d (-> *phys-fy* sc y))))
                                     (zz0 (- e2 (* d (-> *phys-fy* sc z))))
                                     ;; [NOTE-68] LE SIGNE : `+ligne[axa]`, ET IL EST MESURE, PAS SUPPOSE. -> jak-hd-physics-NOTES.md
                                     (zx zx0) (zy zy0) (zz zz0)
                                     (zl (sqrtf (+ (* zx zx) (+ (* zy zy) (* zz zz))))))
                                (when (> zl 0.05)
                                  (set-vector! (-> *phys-fz* sc) (/ zx zl) (/ zy zl) (/ zz zl) 0.0)
                                  (vector-cross! (-> *phys-fx* sc) (-> *phys-fy* sc) (-> *phys-fz* sc))
                                  ;; [NOTE-324] SPEC 7 — LE MIROIR DU LATERAL SORTANT, ET IL EST PAR CHAINE. -> jak-hd-physics-NOTES.md
                                  (when (< (vector-dot (-> *phys-fx* sc) (-> *phys-sepv* sc)) 0.0)
                                    (vector-negate! (-> *phys-fx* sc) (-> *phys-fx* sc)))
                                  (set! (-> *phys-fx* sc w) 0.0)
                                  (set! (-> *phys-fok* sc) 1))))))
                        (when (nonzero? (-> *phys-fok* sc))
                          ;; [NOTE-69] (b) SPEC 10-13 — L'EQUILIBRE DE FORME, CONTINU EN LA DIRECTION DE LA -> jak-hd-physics-NOTES.md
                          (let* ((gnn (vector-length gla))
                                 (ivg (if (> gnn 0.0001) (/ 1.0 gnn) 0.0))
                                 (gxc (* ivg (+ (* (-> gla x) (-> *phys-fx* sc x))
                                                (+ (* (-> gla y) (-> *phys-fx* sc y))
                                                   (* (-> gla z) (-> *phys-fx* sc z))))))
                                 (gyc (* ivg (+ (* (-> gla x) (-> *phys-fy* sc x))
                                                (+ (* (-> gla y) (-> *phys-fy* sc y))
                                                   (* (-> gla z) (-> *phys-fy* sc z))))))
                                 (gzc (* ivg (+ (* (-> gla x) (-> *phys-fz* sc x))
                                                (+ (* (-> gla y) (-> *phys-fz* sc y))
                                                   (* (-> gla z) (-> *phys-fz* sc z))))))
                                 (wdn (fmax 0.0 (- 0.0 gyc)))
                                 (wup (fmax 0.0 gyc))
                                 (wbk (fmax 0.0 (- 0.0 gzc)))
                                 (wfw (fmax 0.0 gzc))
                                 ;; [NOTE-138] SPEC 12 — LE COTE EST DESORMAIS PORTE PAR LE TRIEDRE LUI-MEME. -> jak-hd-physics-NOTES.md
                                 (wlt (fmax 0.0 gxc))
                                 (wne (fmax 0.0 (- 0.0 gxc)))
                                 (wsm (fmax 0.0001 (+ wdn (+ wup (+ wbk (+ wfw (+ wlt wne)))))))
                                 ;; [NOTE-52] SPEC 10 ET SPEC 11 ETAIENT INTERVERTIES (`wbk`/`wfw`, signe de `gzc`). -> jak-hd-physics-NOTES.md
                                 (pb  (* sc PHYS-PSET-N))
                                 (psp (-> *phys-pset* (+ pb 0))) (psw (-> *phys-pset* (+ pb 1))) (psh (-> *phys-pset* (+ pb 2)))
                                 (phl (-> *phys-pset* (+ pb 3))) (phw (-> *phys-pset* (+ pb 4))) (pht (-> *phys-pset* (+ pb 5)))
                                 (plc (- 1.0 (-> *phys-pset* (+ pb 6))))
                                 (sx0 (/ (+ (* wdn 1.000) (+ (* wup phw)
                                            (+ (* wbk phw) (+ (* wfw psw) (+ (* wlt plc) (* wne 1.000)))))) wsm))
                                 (sy0 (/ (+ (* wdn 1.000) (+ (* wup phl)
                                            (+ (* wbk pht) (+ (* wfw psh) (+ (* wlt 1.118) (* wne 1.000)))))) wsm))
                                 (sz0 (/ (+ (* wdn 1.000) (+ (* wup pht)
                                            (+ (* wbk phl) (+ (* wfw psp) (+ (* wlt 1.118) (* wne 1.000)))))) wsm))
                                 ;; [NOTE-508] SPEC 11 — LE SECOND ORDRE DU CANAL DE FORME, entre la cible de gravite et `cvn`. -> jak-hd-physics-NOTES.md
                                 (whs (* dt (/ (* 6.2831853 (-> *phys-stiff* sc)) (sqrtf (fmax 0.01 (-> *phys-mass* sc))))))
                                 (zsh (/ (-> *phys-damp* sc) (* 2.0 (fmax 0.000001 whs)))) (k2u (phys-osc-k2 zsh whs)) (kdu (phys-decay (* 2.0 (* zsh whs))))
                                 (sxd (phys-sdyn sc 0 sx0 k2u kdu)) (syd (phys-sdyn sc 1 sy0 k2u kdu)) (szd (phys-sdyn sc 2 sz0 k2u kdu))
                                 ;; [NOTE-140] SPEC 8 — LE DETERMINANT DES TROIS ECHELLES -> jak-hd-physics-NOTES.md
                                 (det (* sxd (* syd szd)))
                                 (y1  (- 1.0 (/ (- 1.0 det) 3.0)))
                                 (y2  (- y1 (/ (- (* y1 (* y1 y1)) det) (fmax 0.0001 (* 3.0 (* y1 y1))))))
                                 (cvn (/ 1.0 (fmax 0.0001 y2)))
                                 ;; [NOTE-161] (d) SPEC 36 — LE MODE SECONDAIRE. Oscillateur propre a 5.2 Hz, -> jak-hd-physics-NOTES.md
                                 (vtx (- (-> *phys-px* tl) (-> *phys-qx* tl)))
                                 (vty (- (-> *phys-py* tl) (-> *phys-qy* tl)))
                                 (vtz (- (-> *phys-pz* tl) (-> *phys-qz* tl)))
                                 (dvx (- vtx (-> *phys-vp* sc x)))
                                 (dvy (- vty (-> *phys-vp* sc y)))
                                 (dvz (- vtz (-> *phys-vp* sc z)))
                                 (dvn (/ (sqrtf (+ (* dvx dvx) (+ (* dvy dvy) (* dvz dvz)))) b0f))
                                 ;; [NOTE-432] OSCILLATEUR SCALAIRE, SANS ANISOTROPIE : la forme EXACTE de -> jak-hd-physics-NOTES.md
                                 (w2  (* 6.2831853 (-> *phys-pset* (+ pb 7))))
                                 (wh2 (* w2 dt))
                                 (k2s (phys-osc-k2 (-> *phys-pset* (+ pb 8)) wh2))
                                 (kd2 (phys-decay (* 2.0 (* (-> *phys-pset* (+ pb 8)) wh2))))
                                 ;; [NOTE-218] MEME FORME QUE LE MODE PRINCIPAL, a la lettre : la trainee ne -> jak-hd-physics-NOTES.md
                                 (sv2 (+ (* kd2 (-> *phys-secv* sc))
                                         (+ (* (- 0.0 k2s) (-> *phys-sec* sc)) (* PHYS-SEC-K dvn))))
                                 (sm0 (+ (-> *phys-sec* sc) sv2))
                                 ;; [NOTE-70] SPEC 37 : « soft displacement clamps should be preferred to -> jak-hd-physics-NOTES.md
                                 (smc (if (>= sm0 0.0)
                                        (phys-softmin sm0 (-> *phys-pset* (+ pb 9)))
                                        (- 0.0 (phys-softmin (- 0.0 sm0) (-> *phys-pset* (+ pb 9))))))
                                 ;; [NOTE-433] SPEC 36 s'applique a l'EPAISSEUR locale et conserve le volume : -> jak-hd-physics-NOTES.md
                                 (sqz (sqrtf (fmax 0.0001 (+ 1.0 smc))))
                                 (sx1 (* cvn (/ sxd sqz)))
                                 (sy1 (* cvn (/ syd sqz)))
                                 (sz1 (* cvn (* szd (+ 1.0 smc)))))
                            (set! (-> *phys-secv* sc) sv2)
                            (set! (-> *phys-sec* sc) smc)
                            (when (> (fabs smc) (-> *phys-secm* sc))
                              (set! (-> *phys-secm* sc) (fabs smc)))
                            (when (> (fabs sm0) (-> *phys-secr* sc))
                              (set! (-> *phys-secr* sc) (fabs sm0)))
                            (set-vector! (-> *phys-vp* sc) vtx vty vtz 0.0)
                            (set! (-> *phys-gr* gb) (* ivg (-> gla x)))
                            (set! (-> *phys-gr* (+ gb 1)) (* ivg (-> gla y)))
                            (set! (-> *phys-gr* (+ gb 2)) (* ivg (-> gla z)))
                            (set! (-> *phys-gc* gb) gxc)
                            (set! (-> *phys-gc* (+ gb 1)) gyc)
                            (set! (-> *phys-gc* (+ gb 2)) gzc)
                            (set! (-> *phys-dfs* gb) sx1)
                            (set! (-> *phys-dfs* (+ gb 1)) sy1)
                            (set! (-> *phys-dfs* (+ gb 2)) sz1)
                            (when (> sx1 (-> *phys-dfsm* gb)) (set! (-> *phys-dfsm* gb) sx1))
                            (when (> sy1 (-> *phys-dfsm* (+ gb 1))) (set! (-> *phys-dfsm* (+ gb 1)) sy1))
                            (when (> sz1 (-> *phys-dfsm* (+ gb 2))) (set! (-> *phys-dfsm* (+ gb 2)) sz1))
                            (set! (-> *phys-dfdet* sc) (* sx1 (* sy1 sz1)))
                            (set! (-> *phys-dfon* sc) 1))
                          ;; [NOTE-71] (e) SPEC 29 — LE DEGRE DE LIBERTE EN TORSION, `TorsionalCompliance 0.72`. -> jak-hd-physics-NOTES.md
                          (let* ((k   (-> *phys-joint* tl)))
                            (when (and (>= k 0) (< (+ k 1) nbone))
                              ;; [NOTE-72] LE ROULIS DE L'ANCRE, PAR DECOMPOSITION SWING/TWIST — ET C'EST LA -> jak-hd-physics-NOTES.md
                              (let* ((ux (-> *phys-ux* tl)) (uy (-> *phys-uy* tl)) (uz (-> *phys-uz* tl))
                                     (al (sqrtf (+ (* ux ux) (+ (* uy uy) (* uz uz))))))
                                (when (> al 0.0001)
                                  (begin
                                    (begin
                                      (begin
                                        (cond
                                          ((zero? (-> *phys-twok* sc))
                                           (matrix-copy! (-> *phys-a0m* sc) am)
                                           (set! (-> *phys-twok* sc) 1))
                                          (else
                                           (let* ((r21 (+ (* (-> *phys-a0m* sc vector 0 z) (-> am vector 0 y))
                                                          (+ (* (-> *phys-a0m* sc vector 1 z) (-> am vector 1 y))
                                                             (* (-> *phys-a0m* sc vector 2 z) (-> am vector 2 y)))))
                                                  (r12 (+ (* (-> *phys-a0m* sc vector 0 y) (-> am vector 0 z))
                                                          (+ (* (-> *phys-a0m* sc vector 1 y) (-> am vector 1 z))
                                                             (* (-> *phys-a0m* sc vector 2 y) (-> am vector 2 z)))))
                                                  (r02 (+ (* (-> *phys-a0m* sc vector 0 x) (-> am vector 0 z))
                                                          (+ (* (-> *phys-a0m* sc vector 1 x) (-> am vector 1 z))
                                                             (* (-> *phys-a0m* sc vector 2 x) (-> am vector 2 z)))))
                                                  (r20 (+ (* (-> *phys-a0m* sc vector 0 z) (-> am vector 0 x))
                                                          (+ (* (-> *phys-a0m* sc vector 1 z) (-> am vector 1 x))
                                                             (* (-> *phys-a0m* sc vector 2 z) (-> am vector 2 x)))))
                                                  (r10 (+ (* (-> *phys-a0m* sc vector 0 y) (-> am vector 0 x))
                                                          (+ (* (-> *phys-a0m* sc vector 1 y) (-> am vector 1 x))
                                                             (* (-> *phys-a0m* sc vector 2 y) (-> am vector 2 x)))))
                                                  (r01 (+ (* (-> *phys-a0m* sc vector 0 x) (-> am vector 0 y))
                                                          (+ (* (-> *phys-a0m* sc vector 1 x) (-> am vector 1 y))
                                                             (* (-> *phys-a0m* sc vector 2 x) (-> am vector 2 y)))))
                                                  (omx (* 0.5 (- r21 r12)))
                                                  (omy (* 0.5 (- r02 r20)))
                                                  (omz (* 0.5 (- r10 r01)))
                                                  (dphi (/ (+ (* omx ux) (+ (* omy uy) (* omz uz)))
                                                           (fmax 0.0001 al))))
                                             (matrix-copy! (-> *phys-a0m* sc) am)
                                             ;; [NOTE-217] SPEC 37 — « artificial transforms must not generate -> jak-hd-physics-NOTES.md
                                             (when (< (fabs dphi) 0.5)
                                               (set! (-> *phys-twa* sc) (+ (-> *phys-twa* sc) dphi)))
                                             ;; [NOTE-434] OSCILLATEUR SCALAIRE : forme EXACTE de NOTE-50. -> jak-hd-physics-NOTES.md
                                             (let* ((w   (/ (* 6.2831853 (-> *phys-stiff* sc))
                                                            (sqrtf (fmax 0.01 (-> *phys-mass* sc)))))
                                                    (mbt (sqrtf (/ 1.0 (-> *phys-pset* (+ (* sc PHYS-PSET-N) 12)))))
                                                    (wht (* w (* dt mbt)))
                                                    (zt  (/ (* (-> *phys-damp* sc) mbt)
                                                            (* 2.0 (fmax 0.000001 wht))))
                                                    (k2t (phys-osc-k2 zt wht))
                                                    (kdt (phys-decay (* 2.0 (* zt wht))))
                                                    (tv  (+ (* kdt (-> *phys-twv* sc))
                                                            (* k2t (- (-> *phys-twa* sc) (-> *phys-tw* sc)))))
                                                    (twn (+ (-> *phys-tw* sc) tv))
                                                    (rw  (fmax 1.0 (-> *phys-lcr* tl)))
                                                    ;; [NOTE-160] SPEC 38 — la torsion deplace un point de la -> jak-hd-physics-NOTES.md
                                                    (tcap (/ (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 22)) b0f) rw))
                                                    (rel0 (- twn (-> *phys-twa* sc)))
                                                    (rel  (if (>= rel0 0.0)
                                                            (phys-softmin rel0 tcap)
                                                            (- 0.0 (phys-softmin (- 0.0 rel0) tcap)))))
                                               (when (> (fabs (- rel0 rel)) 0.000001)
                                                 (set! *phys-twsat* (+ *phys-twsat* 1)))
                                               (set! (-> *phys-twv* sc) tv)
                                               (set! (-> *phys-tw* sc) twn)
                                               (set! (-> *phys-twr* sc) rel)
                                               (when (> (fabs rel) (-> *phys-twm* sc))
                                                 (set! (-> *phys-twm* sc) (fabs rel))))))))))))))
                          ;; [NOTE-60] (f) LA MATRICE, BATIE UNE FOIS PAR CHAINE ET PAR FRAME. -> jak-hd-physics-NOTES.md
                          (let* ((gb  (* sc 3))
                                 ;; [NOTE-435] PAR MAILLON depuis le cycle 32 : `*phys-rr*` (par chaine) donnait -> jak-hd-physics-NOTES.md
                                 (dnk (let ((ckn (-> *phys-pset* (+ (* sc PHYS-PSET-N) 18)))) (if (> ckn 0.000001) (/ (-> *phys-pset* (+ (* sc PHYS-PSET-N) 26)) ckn) 0.0))) ;; [NOTE-503] `PHYS-DYN-K` ETAIT 0.15/0.35 RECOPIE : un litteral ajuste sur un RAPPORT de deux cles est invisible a un balayage par valeur -> jak-hd-physics-NOTES.md
                                 (rdr (* dnk (/ (-> *phys-rrl* tl) b0f)))
                                 (rx  (+ (* dnk (/ (-> *phys-ox* tl) b0f)) (* rdr (-> *phys-ux* tl))))
                                 (ry  (+ (* dnk (/ (-> *phys-oy* tl) b0f)) (* rdr (-> *phys-uy* tl))))
                                 (rz  (+ (* dnk (/ (-> *phys-oz* tl) b0f)) (* rdr (-> *phys-uz* tl))))
                                 (ka  (if (zero? *phys-dyb-off*) (fmin 1.0 (/ dt PHYS-DYN-TAU)) 0.0)) ;; [NOTE-477] §22 EST UNE LIMITE *DYNAMIQUE* : CE QUI EST TENU EST DEJA L'EQUILIBRE DE §10-§13 -> jak-hd-physics-NOTES.md
                                 (dx  (- rx (-> *phys-dyb* gb))) (dy (- ry (-> *phys-dyb* (+ gb 1)))) (dz (- rz (-> *phys-dyb* (+ gb 2))))
                                 (dl  (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz)))))
                                 (sdy (fmin (-> *phys-pset* (+ (* sc PHYS-PSET-N) 13)) dl))
                                 (ee  (+ 1.0 sdy))
                                 (tt  (/ 1.0 (sqrtf ee))))
                            (set! (-> *phys-dyb* gb) (+ (-> *phys-dyb* gb) (* ka dx))) (set! (-> *phys-dyb* (+ gb 1)) (+ (-> *phys-dyb* (+ gb 1)) (* ka dy))) (set! (-> *phys-dyb* (+ gb 2)) (+ (-> *phys-dyb* (+ gb 2)) (* ka dz)))
                            (when (> sdy (-> *phys-dynm* sc)) (set! (-> *phys-dynm* sc) sdy))
                            (when (> dl (-> *phys-dynr* sc)) (set! (-> *phys-dynr* sc) dl))
                            (set! (-> *phys-dyna* sc) (+ 1.0 (-> *phys-dyna* sc)))
                            (when (> dl (-> *phys-pset* (+ (* sc PHYS-PSET-N) 13)))
                              (set! (-> *phys-dynn* sc) (+ 1.0 (-> *phys-dynn* sc))))
                            (cond
                              ((and (> dl 0.000001) (> sdy 0.000001))
                               (let ((ux (/ dx dl)) (uy (/ dy dl)) (uz (/ dz dl)))
                                 (dotimes (i 3)
                                   (dotimes (j 3)
                                     (set! (-> dfb vector i data j)
                                           (* (- ee tt)
                                              (* (cond ((= i 0) ux) ((= i 1) uy) (else uz))
                                                 (cond ((= j 0) ux) ((= j 1) uy) (else uz))))))
                                   (set! (-> dfb vector i data i) (+ tt (-> dfb vector i data i)))
                                   (set! (-> dfb vector i data 3) 0.0))
                                 (set-vector! (-> dfb vector 3) 0.0 0.0 0.0 1.0)))
                              (else (matrix-identity! dfb)))
                            ;; [NOTE-216] §23 — LA PRESSION DE CONTACT, CINQUIEME ET DERNIER TERME DE SA LISTE. -> jak-hd-physics-NOTES.md
                            (let* ((cx (-> *phys-cpu* tl x))
                                   (cy (-> *phys-cpu* tl y))
                                   (cz (-> *phys-cpu* tl z))
                                   (cl (sqrtf (+ (* cx cx) (+ (* cy cy) (* cz cz)))))
                                   ;; [NOTE-101] CYCLE 36 ETAPE 2 — L'INTENSITE, PAS LE CHEMIN.
                                   ;; [NOTE-106] Sa §23 demande « local collision PRESSURE » : une INTENSITE. -> jak-hd-physics-NOTES.md
                                   (pmx (-> *phys-cpa* (+ (* 7 tl) 1)))
                                   (pr0 (* PHYS-PRS-K (/ pmx b0f)))
                                   (prs (fmin PHYS-PRS-MAX pr0))
                                   (pe  (- 1.0 prs))
                                   (pt2 (/ 1.0 (sqrtf (fmax 0.0001 pe)))))
                              ;; [NOTE-436] RELEVE A L'ARGMAX DE `cl`, PAS EN MAXIMA INDEPENDANTS. -> jak-hd-physics-NOTES.md
                              (when (> pr0 (-> *phys-prsr* sc))
                                (set! (-> *phys-prsr* sc) pr0)
                                (dotimes (k 7)
                                  (set! (-> *phys-cpi* (+ (* 7 sc) k))
                                        (-> *phys-cpa* (+ (* 7 tl) k)))))
                              ;; LE DOMAINE : sans lui, un zero serait un zero de domaine vide.
                              (when (> (-> *phys-cpa* (* 7 tl)) 0.0)
                                (set! (-> *phys-cpd* sc) (+ 1.0 (-> *phys-cpd* sc))))
                              (when (> pr0 PHYS-PRS-MAX)
                                (set! (-> *phys-prsn* sc) (+ 1.0 (-> *phys-prsn* sc))))
                              (when (> prs (-> *phys-prsm* sc)) (set! (-> *phys-prsm* sc) prs))
                              (when (> prs 0.000001)
                                ;; la normale est celle de la poussee, exprimee en MONDE ; le tenseur
                                ;; de deformation vit en espace ANCRE, on y ramene donc la normale.
                                (let* ((nx (/ cx cl)) (ny (/ cy cl)) (nz (/ cz cl))
                                       (ax2 (+ (* nx (-> w2l vector 0 x))
                                               (+ (* ny (-> w2l vector 1 x)) (* nz (-> w2l vector 2 x)))))
                                       (ay2 (+ (* nx (-> w2l vector 0 y))
                                               (+ (* ny (-> w2l vector 1 y)) (* nz (-> w2l vector 2 y)))))
                                       (az2 (+ (* nx (-> w2l vector 0 z))
                                               (+ (* ny (-> w2l vector 1 z)) (* nz (-> w2l vector 2 z)))))
                                       (al2 (sqrtf (+ (* ax2 ax2) (+ (* ay2 ay2) (* az2 az2))))))
                                  (when (> al2 0.0001)
                                    (let ((ux2 (/ ax2 al2)) (uy2 (/ ay2 al2)) (uz2 (/ az2 al2)))
                                      (dotimes (i 3)
                                        (dotimes (j 3)
                                          (set! (-> dfc vector i data j)
                                                (* (- pe pt2)
                                                   (* (cond ((= i 0) ux2) ((= i 1) uy2) (else uz2))
                                                      (cond ((= j 0) ux2) ((= j 1) uy2) (else uz2))))))
                                        (set! (-> dfc vector i data i) (+ pt2 (-> dfc vector i data i)))
                                        (set! (-> dfc vector i data 3) 0.0))
                                      (set-vector! (-> dfc vector 3) 0.0 0.0 0.0 1.0)
                                      (matrix*! tmp dfb dfc)
                                      (matrix-copy! dfb tmp))))))
                            (dotimes (i 3)
                              (dotimes (j 3)
                                (set! (-> dfa vector i data j)
                                      (+ (* (-> *phys-dfs* gb) (* (-> *phys-fx* sc data i) (-> *phys-fx* sc data j)))
                                         (+ (* (-> *phys-dfs* (+ gb 1)) (* (-> *phys-fy* sc data i) (-> *phys-fy* sc data j)))
                                            (* (-> *phys-dfs* (+ gb 2)) (* (-> *phys-fz* sc data i) (-> *phys-fz* sc data j)))))))
                              (set! (-> dfa vector i data 3) 0.0))
                            (set-vector! (-> dfa vector 3) 0.0 0.0 0.0 1.0)
                            ;; forme d'equilibre PUIS etirement dynamique, les deux en espace ANCRE
                            (matrix*! tmp dfa dfb)
                            ;; `A` en espace ancre, retenue pour la MESURE (voir `*phys-dfa*`).
                            (matrix-copy! (-> *phys-dfa* sc) tmp)
                            (matrix*! (-> *phys-dfm* sc) w2l tmp)
                            (matrix-copy! tmp (-> *phys-dfm* sc))
                            (matrix*! (-> *phys-dfm* sc) tmp am)
                            ;; [NOTE-437] SPEC 29 — la torsion est une ROTATION propre autour de l'axe -> jak-hd-physics-NOTES.md
                            (when (> (fabs (-> *phys-twr* sc)) 0.00001)
                              (let* ((ax (+ (* (-> *phys-ux* tl) (-> am vector 0 x))
                                            (+ (* (-> *phys-uy* tl) (-> am vector 1 x))
                                               (* (-> *phys-uz* tl) (-> am vector 2 x)))))
                                     (ay (+ (* (-> *phys-ux* tl) (-> am vector 0 y))
                                            (+ (* (-> *phys-uy* tl) (-> am vector 1 y))
                                               (* (-> *phys-uz* tl) (-> am vector 2 y)))))
                                     (az (+ (* (-> *phys-ux* tl) (-> am vector 0 z))
                                            (+ (* (-> *phys-uy* tl) (-> am vector 1 z))
                                               (* (-> *phys-uz* tl) (-> am vector 2 z)))))
                                     (al (sqrtf (+ (* ax ax) (+ (* ay ay) (* az az))))))
                                (when (> al 0.0001)
                                  (set-vector! nrm (/ ax al) (/ ay al) (/ az al) 0.0)
                                  (matrix-axis-angle! rot nrm (-> *phys-twr* sc))
                                  (matrix*! tmp rot (-> *phys-dfm* sc))
                                  (matrix-copy! (-> *phys-dfm* sc) tmp))))))))
                    ;; [NOTE-47] ---- 6. ECRITURE DANS LE SQUELETTE (SPEC 7 : c'est ca qui fait foi) ---- -> jak-hd-physics-NOTES.md
                    ;; [NOTE-127] LE COM DE SA §22 EST UNE MOYENNE PONDEREE, ACCUMULEE SUR LA FRAME. -> jak-hd-physics-NOTES.md
                    ;; [NOTE-338] LES TROIS TERMES DE L'APEX, MESURES LA OU ILS EXISTENT. -> jak-hd-physics-NOTES.md
                    (let ((cwx 0.0) (cwy 0.0) (cwz 0.0) (cwn 0) (awx 0.0) (awy 0.0) (awz 0.0) (awn 0) (arw 0.0)
                          (twx 0.0) (twy 0.0) (twz 0.0) (dwx 0.0) (dwy 0.0) (dwz 0.0) (aws 0.0) (cws 0.0))
                    (dotimes (l n)
                      (when (>= l 0)
                        (let* ((scl (+ (* sc PHYS-LINKS) l))
                               (k   (-> *phys-joint* scl)))
                          (when (and (>= k 0) (< (+ k 1) nbone))
                            (let ((bm (the-as matrix (-> skel bones (+ k 1) transform))))
                              (matrix-copy! pre bm)
                              ;; [NOTE-48] ------------------------------------------------------------ -> jak-hd-physics-NOTES.md
                              (let ((have #f))
                                ;; [NOTE-95] LE LEVIER DE ROTATION EST CELUI DE L'ANCRE, PAS DE L'OS LOCAL. -> jak-hd-physics-NOTES.md
                                (when (and (>= an 0) (< (+ an 1) nbone))
                                  (let ((ax (-> skel bones (+ an 1) transform vector 3 x))
                                        (ay (-> skel bones (+ an 1) transform vector 3 y))
                                        (az (-> skel bones (+ an 1) transform vector 3 z)))
                                    (set! (-> rest x) (- (-> bm vector 3 x) ax))
                                    (set! (-> rest y) (- (-> bm vector 3 y) ay))
                                    (set! (-> rest z) (- (-> bm vector 3 z) az))
                                    (set! (-> pt x) (- (-> *phys-px* scl) ax))
                                    (set! (-> pt y) (- (-> *phys-py* scl) ay))
                                    (set! (-> pt z) (- (-> *phys-pz* scl) az))
                                    (set! have #t)))
                                (when have
                                  (set! (-> rest w) 1.0)
                                  (set! (-> pt w) 1.0)
                                  (begin
                                    (let ((la (vector-length rest)) (lb (vector-length pt)))
                                      (when (and (> la 0.01) (> lb 0.01))
                                        (vector-float*! rest rest (/ 1.0 la))
                                        (vector-float*! pt pt (/ 1.0 lb))
                                        (vector-cross! nrm rest pt)
                                        (let ((sn (vector-length nrm))
                                              (cs (vector-dot rest pt)))
                                          (when (> sn 0.0001)
                                            (vector-float*! nrm nrm (/ 1.0 sn))
                                            ;; [NOTE-49] `atan` de GOAL rend des UNITES DE ROTATION (65536 = -> jak-hd-physics-NOTES.md
                                            (when (>= (+ l 1) n)
                                              (let ((ad (* 0.0054931641 (atan sn cs))))
                                                (when (> ad (-> *phys-dg* (+ (* sc PHYS-DG) 10)))
                                                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 10)) ad))))
                                            ;; [NOTE-88] PREUVE D'EXECUTION DU MAILLON ROOTLOCK. -> jak-hd-physics-NOTES.md
                                            (when (< l rlk0)
                                              (let ((ad (* 0.0054931641 (atan sn cs))))
                                                (when (> ad (-> *phys-dg* (+ (* sc PHYS-DG) 14)))
                                                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 14)) ad))))
                                            ;; [NOTE-89] L'ANGLE DU MAILLON 0, SUR TOUTE CHAINE. -> jak-hd-physics-NOTES.md
                                            (when (= l 0)
                                              (let ((ad (* 0.0054931641 (atan sn cs))))
                                                (when (> ad (-> *phys-dg* (+ (* sc PHYS-DG) 13)))
                                                  (set! (-> *phys-dg* (+ (* sc PHYS-DG) 13)) ad))))
                                            (matrix-axis-angle! rot nrm (atan sn cs))
                                            (set! (-> bm vector 3 x) 0.0)
                                            (set! (-> bm vector 3 y) 0.0)
                                            (set! (-> bm vector 3 z) 0.0)
                                            (matrix*! tmp bm rot)
                                            (matrix-copy! bm tmp))))))))
                              ;; [NOTE-151] SPEC 8/10-13/29/36 — LA DEFORMATION ENTRE ICI, ET NULLE PART AILLEURS. -> jak-hd-physics-NOTES.md
                              ;; [NOTE-92] `c1` = R_auteur . rot . lc, LE TERME CHARNIERE DE L'IDENTITE. -> jak-hd-physics-NOTES.md
                              (set! (-> *phys-c1* 0) (+ (* (-> *phys-lcx* scl) (-> bm vector 0 x)) (+ (* (-> *phys-lcy* scl) (-> bm vector 1 x)) (* (-> *phys-lcz* scl) (-> bm vector 2 x)))))
                              (set! (-> *phys-c1* 1) (+ (* (-> *phys-lcx* scl) (-> bm vector 0 y)) (+ (* (-> *phys-lcy* scl) (-> bm vector 1 y)) (* (-> *phys-lcz* scl) (-> bm vector 2 y)))))
                              (set! (-> *phys-c1* 2) (+ (* (-> *phys-lcx* scl) (-> bm vector 0 z)) (+ (* (-> *phys-lcy* scl) (-> bm vector 1 z)) (* (-> *phys-lcz* scl) (-> bm vector 2 z)))))
                              (when (nonzero? (-> *phys-dfon* sc))
                                (set! (-> bm vector 3 x) 0.0)
                                (set! (-> bm vector 3 y) 0.0)
                                (set! (-> bm vector 3 z) 0.0)
                                (set! (-> bm vector 3 w) 1.0)
                                (matrix*! tmp bm (-> *phys-dfm* sc))
                                (let ((aw (-> *phys-apw* scl)))
                                  (when (> aw 0.0)
                                    ;; [NOTE-339] `tmp` HERITE LA TRANSLATION DE L'ANCRE VIA LE TENSEUR : on la met a zero AVANT de lire. -> jak-hd-physics-NOTES.md
                                    (set-vector! (-> tmp vector 3) 0.0 0.0 0.0 1.0)
                                    (phys-pt-exc! tmp bm (-> *phys-apx* scl) (-> *phys-apy* scl) (-> *phys-apz* scl))
                                    (set! dwx (+ dwx (* aw (-> *phys-c2* 0))))
                                    (set! dwy (+ dwy (* aw (-> *phys-c2* 1))))
                                    (set! dwz (+ dwz (* aw (-> *phys-c2* 2))))))
                                (matrix-copy! bm tmp))
                              (set! (-> bm vector 3 x) (-> *phys-px* scl))
                              (set! (-> bm vector 3 y) (-> *phys-py* scl))
                              (set! (-> bm vector 3 z) (-> *phys-pz* scl))
                              (set! (-> bm vector 3 w) 1.0)
                              ;; [NOTE-139] L'APEX — accumule sur le MEME `bm` que l'ecriture livre. -> jak-hd-physics-NOTES.md
                              (let ((aw (-> *phys-apw* scl)))
                                (when (> aw 0.0)
                                  (phys-pt-exc! bm pre (-> *phys-apx* scl) (-> *phys-apy* scl) (-> *phys-apz* scl))
                                  (set! awx (+ awx (* aw (-> *phys-c2* 0))))
                                  (set! awy (+ awy (* aw (-> *phys-c2* 1))))
                                  (set! awz (+ awz (* aw (-> *phys-c2* 2)))) (let* ((rx (+ (* (-> *phys-apx* scl) (-> bm vector 0 x)) (+ (* (-> *phys-apy* scl) (-> bm vector 1 x)) (* (-> *phys-apz* scl) (-> bm vector 2 x))))) (ry (+ (* (-> *phys-apx* scl) (-> bm vector 0 y)) (+ (* (-> *phys-apy* scl) (-> bm vector 1 y)) (* (-> *phys-apz* scl) (-> bm vector 2 y))))) (rz (+ (* (-> *phys-apx* scl) (-> bm vector 0 z)) (+ (* (-> *phys-apy* scl) (-> bm vector 1 z)) (* (-> *phys-apz* scl) (-> bm vector 2 z))))) (rl (sqrtf (+ (* rx rx) (+ (* ry ry) (* rz rz)))))) (when (> rl 0.0001) (set! arw (+ arw (* aw (/ (+ (* (-> *phys-c2* 0) rx) (+ (* (-> *phys-c2* 1) ry) (* (-> *phys-c2* 2) rz))) rl))))))
                                  (set! twx (+ twx (* aw (- (-> bm vector 3 x) (-> pre vector 3 x)))))
                                  (set! twy (+ twy (* aw (- (-> bm vector 3 y) (-> pre vector 3 y)))))
                                  (set! twz (+ twz (* aw (- (-> bm vector 3 z) (-> pre vector 3 z)))))
                                  (set! awn (+ awn 1)) (set! aws (+ aws aw)) (set! cws (+ cws (-> *phys-comw* scl)))))
                              ;; [NOTE-85] SPEC 22 — L'EXCURSION DU CENTRE DE CHAIR, EN B0, DEFORMATION COMPRISE. -> jak-hd-physics-NOTES.md
                              (let ((lcx (-> *phys-lcx* scl))
                                    (lcy (-> *phys-lcy* scl))
                                    (lcz (-> *phys-lcz* scl)))
                                (when (or (!= lcx 0.0) (!= lcy 0.0) (!= lcz 0.0))
                                  (let* ((ex (- (+ (-> bm vector 3 x)
                                                   (+ (* lcx (-> bm vector 0 x))
                                                      (+ (* lcy (-> bm vector 1 x))
                                                         (* lcz (-> bm vector 2 x)))))
                                                (+ (-> pre vector 3 x)
                                                   (+ (* lcx (-> pre vector 0 x))
                                                      (+ (* lcy (-> pre vector 1 x))
                                                         (* lcz (-> pre vector 2 x)))))))
                                         (ey (- (+ (-> bm vector 3 y)
                                                   (+ (* lcx (-> bm vector 0 y))
                                                      (+ (* lcy (-> bm vector 1 y))
                                                         (* lcz (-> bm vector 2 y)))))
                                                (+ (-> pre vector 3 y)
                                                   (+ (* lcx (-> pre vector 0 y))
                                                      (+ (* lcy (-> pre vector 1 y))
                                                         (* lcz (-> pre vector 2 y)))))))
                                         (ez (- (+ (-> bm vector 3 z)
                                                   (+ (* lcx (-> bm vector 0 z))
                                                      (+ (* lcy (-> bm vector 1 z))
                                                         (* lcz (-> bm vector 2 z)))))
                                                (+ (-> pre vector 3 z)
                                                   (+ (* lcx (-> pre vector 0 z))
                                                      (+ (* lcy (-> pre vector 1 z))
                                                         (* lcz (-> pre vector 2 z)))))))
                                         (b0c (if (> (-> *phys-b0* sc) 0.0)
                                                (-> *phys-b0* sc)
                                                (-> *phys-blen* scl)))
                                         (ee (/ (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez))))
                                                (fmax 1.0 b0c))))
                                    (when (> ee (-> *phys-dg* (+ (* sc PHYS-DG) 19)))
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 19)) ee))
                                    ;; [NOTE-438] la MEME frame, le MEME vecteur, pondere par la masse -> jak-hd-physics-NOTES.md
                                    (let ((wl (-> *phys-comw* scl)))
                                      (when (> wl 0.0)
                                        (set! cwx (+ cwx (* wl ex)))
                                        (set! cwy (+ cwy (* wl ey)))
                                        (set! cwz (+ cwz (* wl ez)))
                                        (set! cwn (+ cwn 1))))
                                    ;; [NOTE-112] UN CENTRE DE MASSE EST UNE MOYENNE PONDEREE, PAS UN MAXIMUM. -> jak-hd-physics-NOTES.md
                                    (when (> ee (-> *phys-dg* (+ (* sc PHYS-DG) (+ 35 l))))
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) (+ 35 l))) ee)
                                      (let ((jx (- (-> bm vector 3 x) (-> pre vector 3 x))) (jy (- (-> bm vector 3 y) (-> pre vector 3 y))) (jz (- (-> bm vector 3 z) (-> pre vector 3 z))))
                                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) (+ 39 l)))
                                              (/ (sqrtf (+ (* jx jx) (+ (* jy jy) (* jz jz)))) (fmax 1.0 b0c)))))
                                    ;; [NOTE-90] 23 = LE MEME MAXIMUM QUE 19, MAIS PAR FENETRE DE PUBLICATION. -> jak-hd-physics-NOTES.md
                                    (when (> ee (-> *phys-dg* (+ (* sc PHYS-DG) 23)))
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 23)) ee)
                                      ;; [NOTE-92] L'ATTRIBUTION DE `comex` A SES TROIS TERMES. -> jak-hd-physics-NOTES.md
                                      (let* ((el (fmax 0.0001 (sqrtf (+ (* ex ex) (+ (* ey ey) (* ez ez))))))
                                             (ux (/ ex el)) (uy (/ ey el)) (uz (/ ez el))
                                             (a0x (+ (* lcx (-> pre vector 0 x)) (+ (* lcy (-> pre vector 1 x)) (* lcz (-> pre vector 2 x)))))
                                             (a0y (+ (* lcx (-> pre vector 0 y)) (+ (* lcy (-> pre vector 1 y)) (* lcz (-> pre vector 2 y)))))
                                             (a0z (+ (* lcx (-> pre vector 0 z)) (+ (* lcy (-> pre vector 1 z)) (* lcz (-> pre vector 2 z)))))
                                             (c2x (+ (* lcx (-> bm vector 0 x)) (+ (* lcy (-> bm vector 1 x)) (* lcz (-> bm vector 2 x)))))
                                             (c2y (+ (* lcx (-> bm vector 0 y)) (+ (* lcy (-> bm vector 1 y)) (* lcz (-> bm vector 2 y)))))
                                             (c2z (+ (* lcx (-> bm vector 0 z)) (+ (* lcy (-> bm vector 1 z)) (* lcz (-> bm vector 2 z))))))
                                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 31))
                                              (+ (* (- (-> bm vector 3 x) (-> pre vector 3 x)) ux)
                                                 (+ (* (- (-> bm vector 3 y) (-> pre vector 3 y)) uy)
                                                    (* (- (-> bm vector 3 z) (-> pre vector 3 z)) uz))))
                                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 32))
                                              (+ (* (- (-> *phys-c1* 0) a0x) ux)
                                                 (+ (* (- (-> *phys-c1* 1) a0y) uy)
                                                    (* (- (-> *phys-c1* 2) a0z) uz))))
                                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 33))
                                              (+ (* (- c2x (-> *phys-c1* 0)) ux)
                                                 (+ (* (- c2y (-> *phys-c1* 1)) uy)
                                                    (* (- c2z (-> *phys-c1* 2)) uz))))
                                        ;; [NOTE-215] QUEL MAILLON porte ce maximum. Les deux ecrivent le MEME -> jak-hd-physics-NOTES.md
                                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 34)) (the float l))))
                                    ;; [NOTE-91] UN MAXIMUM NE DIT PAS SI UNE BORNE CLIPERAIT UN EXTREME. -> jak-hd-physics-NOTES.md
                                    (set! (-> *phys-dg* (+ (* sc PHYS-DG) 20))
                                          (+ ee (-> *phys-dg* (+ (* sc PHYS-DG) 20))))
                                    (set! (-> *phys-dg* (+ (* sc PHYS-DG) 21))
                                          (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 21))))
                                    (when (> ee (-> *phys-pset* (+ (* sc PHYS-PSET-N) 20)))
                                      (set! (-> *phys-dg* (+ (* sc PHYS-DG) 22))
                                            (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 22))))))))
                              ;; delta pour les descendants non simules
                              (when (< k PHYS-JOINTS)
                                (matrix-4x4-inverse! inv pre)
                                (matrix*! (-> *phys-dmat* k) inv bm)
                                (set! (-> *phys-dhas* k) 1)))))))
                    ;; [NOTE-518] SPEC 21 — LA COMBINAISON EST SATUREE, ET C'EST LA VALEUR LIVREE QUI L'EST. -> jak-hd-physics-NOTES.md
                    (when (and (zero? *phys-e21-off*) (> awn 0) (> aws 0.0001))
                      (let* ((sx (- awx dwx)) (sy (- awy dwy)) (sz (- awz dwz))
                             (sd (sqrtf (+ (* sx sx) (+ (* sy sy) (* sz sz)))))
                             (b0a (if (> (-> *phys-b0* sc) 0.0) (-> *phys-b0* sc) (-> *phys-blen* (* sc PHYS-LINKS))))
                             (kn (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 16)) b0a)) (cp (* (-> *phys-pset* (+ (* sc PHYS-PSET-N) 17)) b0a))
                             ;; MEME GENOU, MEME ASYMPTOTE, MEME TANH DE PADE QUE LES DEUX AUTRES FILETS (`:2039`, `:3160`) : `tanh` est la fonction que la section ECRIT, et le duplicat est assume pour la meme raison qu'a `phys-cap-e22!` — factoriser ferait bouger les courses desarmees et detruirait leur controle.
                             (xr (if (and (> sd kn) (> cp 0.0001)) (/ (- sd kn) cp) 0.0))
                             (th (if (>= xr 3.0) 1.0 (/ (* xr (+ 27.0 (* xr xr))) (+ 27.0 (* 9.0 (* xr xr))))))
                             (g  (if (and (> sd 0.0001) (> xr 0.0)) (/ (+ kn (* cp th)) sd) 1.0)))
                        (when (< g 0.999999)
                          (set! *phys-e21-n* (+ *phys-e21-n* 1))
                          (set! *phys-e21-d* (+ *phys-e21-d* (/ (* sd (- 1.0 g)) (fmax 1.0 b0a))))
                          ;; la correction est une TRANSLATION RIGIDE de l'organe : `dl` la repartit sur les
                          ;; maillons de sorte que la somme PONDEREE recoive exactement `-(1-g) s`.
                          (let ((dl (/ (- 1.0 g) aws)))
                            (dotimes (l n)
                              (let* ((scl (+ (* sc PHYS-LINKS) l)) (k (-> *phys-joint* scl)))
                                (when (and (>= k 0) (< (+ k 1) nbone) (> (-> *phys-apw* scl) 0.0))
                                  (let ((bm (the-as matrix (-> skel bones (+ k 1) transform))))
                                    (set! (-> bm vector 3 x) (- (-> bm vector 3 x) (* dl sx)))
                                    (set! (-> bm vector 3 y) (- (-> bm vector 3 y) (* dl sy)))
                                    (set! (-> bm vector 3 z) (- (-> bm vector 3 z) (* dl sz))))))))
                          ;; les accumulateurs suivent EXACTEMENT la correction : une translation entre dans
                          ;; `tp`, `rp` et `dp` sont inchanges, et l'identite e = tp + rp + dp referme.
                          (set! awx (- awx (* (- 1.0 g) sx))) (set! awy (- awy (* (- 1.0 g) sy))) (set! awz (- awz (* (- 1.0 g) sz)))
                          (set! twx (- twx (* (- 1.0 g) sx))) (set! twy (- twy (* (- 1.0 g) sy))) (set! twz (- twz (* (- 1.0 g) sz)))
                          ;; ET LE COM SUIT : les maillons deplaces portent `cws` de la masse de COM, donc le
                          ;; centre publie bouge de `cws * dl * s`. Laisser `comex` sur la valeur d'avant
                          ;; publierait un COM qui ne decrit plus le squelette livre (regle du 2026-08-19 23:50).
                          (let ((cd (* cws (/ (- 1.0 g) aws))))
                            (set! cwx (- cwx (* cd sx))) (set! cwy (- cwy (* cd sy))) (set! cwz (- cwz (* cd sz)))))))
                    ;; [NOTE-127] TOUS les maillons ont contribue, ou AUCUN chiffre n'est publie : un
                    ;; poids manquant ne doit jamais se lire comme un COM de zero.
                    (when (and (> cwn 0) (= cwn n))
                      (let* ((b0w (if (> (-> *phys-b0* sc) 0.0)
                                    (-> *phys-b0* sc)
                                    (-> *phys-blen* (* sc PHYS-LINKS))))
                             (cw (/ (sqrtf (+ (* cwx cwx) (+ (* cwy cwy) (* cwz cwz))))
                                    (fmax 1.0 b0w))))
                        ;; [NOTE-136] LE VECTEUR DU COM, ET POURQUOI UNE NORME NE SUFFIT PAS. -> jak-hd-physics-NOTES.md
                        ;; [NOTE-439] NATURE trois longueurs SIGNEES / B0 · REPERE MONDE, meme frame, contre la -> jak-hd-physics-NOTES.md
                        (when (> cw (-> *phys-dg* (+ (* sc PHYS-DG) 43)))
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 43)) cw)
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 47)) (/ cwx (fmax 1.0 b0w)))
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 48)) (/ cwy (fmax 1.0 b0w)))
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 49)) (/ cwz (fmax 1.0 b0w))))
                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 44))
                              (+ cw (-> *phys-dg* (+ (* sc PHYS-DG) 44))))
                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 45))
                              (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 45))))
                        ;; [NOTE-139] SPEC 15 — DEUX MAXIMA (57 = le plus bas, en positif ; 58 = le plus haut), jamais un min. -> jak-hd-physics-NOTES.md
                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 57)) (fmax (-> *phys-dg* (+ (* sc PHYS-DG) 57)) (/ (- 0.0 cwy) (fmax 1.0 b0w))))
                        (set! (-> *phys-dg* (+ (* sc PHYS-DG) 58)) (fmax (-> *phys-dg* (+ (* sc PHYS-DG) 58)) (/ cwy (fmax 1.0 b0w))))
                        (when (> cw (-> *phys-pset* (+ (* sc PHYS-PSET-N) 20)))
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 46))
                                (+ 1.0 (-> *phys-dg* (+ (* sc PHYS-DG) 46)))))))
                    ;; [NOTE-139] L'APEX, PUBLIE. Garde `awn > 0` et NON `awn = n`. -> jak-hd-physics-NOTES.md
                    (when (> awn 0)
                      (let* ((b0a (if (> (-> *phys-b0* sc) 0.0) (-> *phys-b0* sc) (-> *phys-blen* (* sc PHYS-LINKS))))
                             (ap (/ (sqrtf (+ (* awx awx) (+ (* awy awy) (* awz awz)))) (fmax 1.0 b0a))))
                        (when (> ap (-> *phys-dg* (+ (* sc PHYS-DG) 53)))
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 53)) ap)
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 54)) (/ awx (fmax 1.0 b0a)))
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 55)) (/ awy (fmax 1.0 b0a)))
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 56)) (/ awz (fmax 1.0 b0a)))
                          ;; [NOTE-440] AU MEME ARGMAX, DONC SUR LA MEME FRAME QUE 53-56 : c'est ce qui rend -> jak-hd-physics-NOTES.md
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 59)) (/ twx (fmax 1.0 b0a)))
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 60)) (/ twy (fmax 1.0 b0a)))
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 61)) (/ twz (fmax 1.0 b0a)))
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 62)) (/ dwx (fmax 1.0 b0a)))
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 63)) (/ dwy (fmax 1.0 b0a)))
                          (set! (-> *phys-dg* (+ (* sc PHYS-DG) 64)) (/ dwz (fmax 1.0 b0a))) (set! (-> *phys-dg* (+ (* sc PHYS-DG) 86)) (/ arw (fmax 1.0 b0a)))))))
                    ))))))
          ;; ---- propagation aux descendants non simules (verres de lunettes, etc.) ----
          (dotimes (k njoint)
            (when (zero? (-> *phys-dhas* k))
              (let ((p (the int (-> (-> obj khd-par) k))))
                (when (and (!= p 255) (< p PHYS-JOINTS) (nonzero? (-> *phys-dhas* p))
                           (< (+ k 1) nbone))
                  (let ((bm (the-as matrix (-> skel bones (+ k 1) transform))))
                    (matrix*! tmp bm (-> *phys-dmat* p))
                    (matrix-copy! bm tmp)
                    (matrix-copy! (-> *phys-dmat* k) (-> *phys-dmat* p))
                    (set! (-> *phys-dhas* k) 1))))))
          ;; [NOTE-214] ---- L'INSTANTANE QUE LA FRAME SUIVANTE LIRA ------------------------------------- -> jak-hd-physics-NOTES.md
          (phys-snapshot-sim! skel slot nco nbone)))))
  (none))

;; [NOTE-443] suite -> jak-hd-physics-NOTES.md
(defun phys-note-covered! ((n int)) (none))

;; [NOTE-441] process-drawable.gc:287 appelle ceci sur TOUT process-drawable — y compris les compagnons HD, -> jak-hd-physics-NOTES.md
(defun phys-rider-post! ((obj process-drawable)) (none))

;; [NOTE-442] suite -> jak-hd-physics-NOTES.md
(defun phys-stats-reset! ()
  (dotimes (sc PHYS-SC)
    (let ((stb (* sc PHYS-ST)))
      (dotimes (i 6) (set! (-> *phys-st* (+ stb i)) 0.0))
      ;; [NOTE-344] ce que la remise a zero des statistiques de fenetre couvre, emplacement par emplacement -> jak-hd-physics-NOTES.md
      (dotimes (i 9) (set! (-> *phys-st* (+ stb (+ 12 i))) 0.0))
      ;; le residu signe de penetration est un maximum qui a le droit d'etre negatif
      (set! (-> *phys-st* (+ stb 4)) PHYS-NOCONTACT)
      ;; la boite englobante part vide : un min a 0 la forcerait a contenir l'origine et
      ;; gonflerait l'amplitude mesuree.
      (set! (-> *phys-st* (+ stb 6))   1000000000.0)
      (set! (-> *phys-st* (+ stb 7))  -1000000000.0)
      (set! (-> *phys-st* (+ stb 8))   1000000000.0)
      (set! (-> *phys-st* (+ stb 9))  -1000000000.0)
      (set! (-> *phys-st* (+ stb 10))  1000000000.0)
      (set! (-> *phys-st* (+ stb 11)) -1000000000.0))
    ;; la boite de CHAQUE maillon part vide, comme celle de la pointe.
    (dotimes (l PHYS-LINKS)
      (let ((lb (* (+ (* sc PHYS-LINKS) l) PHYS-LB)))
        (dotimes (i 3)
          (set! (-> *phys-lb* (+ lb (* 2 i)))        1000000000.0)
          (set! (-> *phys-lb* (+ lb (+ (* 2 i) 1))) -1000000000.0)))
      ;; la deviation angulaire propre de CHAQUE maillon part de zero : c'est un maximum, et un
      ;; maillon qui suit rigidement son parent doit pouvoir lire exactement zero.
      (set! (-> *phys-la* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-la0* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-la1* (+ (* sc PHYS-LINKS) l)) 0.0)
      ;; [NOTE-81] les trois miroirs par maillon sont des maximums et un compte DE FENETRE, comme
      ;; leurs equivalents par chaine juste en dessous : meme portee, meme remise a zero.
      (set! (-> *phys-rrml* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-rrrl* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-rrol* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-rrcl* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-rrtl* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-cddl* (+ (* sc PHYS-LINKS) l)) 0.0)
      (set! (-> *phys-rrsl* (+ (* sc PHYS-LINKS) l)) 0.0))
    (dotimes (i 3) (set! (-> *phys-dfsm* (+ (* sc 3) i)) 0.0))  ;; [NOTE-505] meme portee que *phys-rrml*
    ;; [NOTE-444] SPEC 29/36 — les deux maximums de FENETRE. Ce sont des compteurs de mesure, pas des etats -> jak-hd-physics-NOTES.md
    (set! (-> *phys-secm* sc) 0.0)
    (set! (-> *phys-secr* sc) 0.0)
    (set! (-> *phys-dynm* sc) 0.0)
    ;; [NOTE-445] MEME PORTEE QUE `dynm`, ET ILS NE L'AVAIENT PAS : `dynr`/`dynn`/`dyna`/`prsn` -> jak-hd-physics-NOTES.md
    (set! (-> *phys-dynr* sc) 0.0)
    (set! (-> *phys-dynn* sc) 0.0)
    (set! (-> *phys-dyna* sc) 0.0)
    (set! (-> *phys-prsm* sc) 0.0)
    (set! (-> *phys-prsr* sc) 0.0)
    (set! (-> *phys-prsn* sc) 0.0)
    (set! (-> *phys-cpd* sc) 0.0)
    (dotimes (k 7) (set! (-> *phys-cpi* (+ (* 7 sc) k)) 0.0))
    ;; [NOTE-446] §23 : maximum de FENETRE, donc remis a zero ici. `*phys-rr*` et `*phys-rq*` — l'etat — ne le -> jak-hd-physics-NOTES.md
    (set! (-> *phys-rrm* sc) 0.0)
    (set! (-> *phys-rrr* sc) 0.0)
    (set! (-> *phys-twm* sc) 0.0)
    (set! (-> *phys-thas* sc) 0))
  ;; SPEC 33/34 — les compteurs de restitution, par fenetre eux aussi.
  (set! *phys-rstn* 0)
  (set! *phys-twsat* 0)
  (set! *phys-rrsat* 0)
  (set! *phys-rstm* 0)
  (set! *phys-rstin* 0.0)
  (set! *phys-rstout* 0.0)
  (set! *phys-rstsum* 0.0)
  (none))
(defun phys-ang-reset! () (dotimes (i PHYS-SCL) (set! (-> *phys-la* i) 0.0) (set! (-> *phys-la0* i) 0.0) (set! (-> *phys-la1* i) 0.0)) (none))  ;; RESET ETROIT — LES TROIS ETAGES DE L'ANGLE, ET RIEN D'AUTRE. `*phys-la0*`/`*phys-la1*` y sont entres le 2026-08-14 : sans remise a zero par frame ce sont des maximums de COURSE, donc inutilisables pour attribuer a un etage ce qu'une frame retire. Leur seul autre lecteur est `PHYSGRADS`, emis par `physroom-emit-window` (phys-room.gc:583) appelee UNIQUEMENT depuis PHYSROOM-PH-MEAS (phys-room.gc:992), phase 1 — soit AVANT la fenetre de repos (phase 3) qui appelle ce reset : aucune fenetre PHYSGRADS ne le subit. *phys-la* SEUL auparavant. Ce n'est ni un clamp, ni une hysteresis, ni un gel : il ne retire pas un micron de mouvement, il remet a zero un COMPTEUR DE MESURE (le maximum courant de la deviation angulaire propre, accumule en :4046). Il ne touche NI `stat 0` NI `*phys-thas*`, et c'est tout l'interet : la garde de `phys-link-ang` (:4497) reste passante. `phys-stats-reset!` appele a chaque frame la maintiendrait au contraire baissee en permanence — `stat 0` (:4116) n'est ecrit que sous `(nonzero? *phys-thas*)` (:4111) et `thas` ne passe a 1 qu'ensuite (:4156), or le solveur ne passe qu'une fois par frame (jak-hd.gc:564) — et rendrait un mur de ang=0.0. Sur le plafond de lignes : il vise l'empilement de SUPPRESSEURS (ancien moteur : 6000 lignes, 84 clamps, 42 % des mesures a zero) et c'est la COMPOSITION qui decide, jamais le nombre ; la mesure par frame est nommement exigee par le contrat (DIRECTIVES lignes 29-31, `ROOM-RINGDOWN`).

(defun phys-stat ((slot int) (chain int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= which 0) (< which PHYS-ST))
    (-> *phys-st* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-ST) which))
    0.0))

;; la colonne du tableau : le residu signe de la fenetre, ou 0 si aucune frame de la fenetre n'a eu
;; le moindre contact. Le nombre de frames en contact est publie a part (phys-auth which=7).
(defun phys-pen-col ((slot int) (chain int))
  (let ((v (phys-stat slot chain 4)))
    (if (< v PHYS-NOCONTACT-LIMIT) 0.0 v)))

;; AMPLITUDE de mouvement de la pointe due a la PHYSIQUE seule, sur la fenetre : la diagonale de la
;; boite englobante de l'ecart. Zero si la fenetre n'a pas de frame.
(defun phys-tip-amp ((slot int) (chain int))
  (if (< (phys-stat slot chain 0) 0.5)
    0.0
    (let ((dx (- (phys-stat slot chain 7) (phys-stat slot chain 6)))
          (dy (- (phys-stat slot chain 9) (phys-stat slot chain 8)))
          (dz (- (phys-stat slot chain 11) (phys-stat slot chain 10))))
      (if (or (< dx 0.0) (< dy 0.0) (< dz 0.0))
        0.0
        (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))))

;; [NOTE-343] `phys-tip-mean` — un DEPLACEMENT SOUTENU, pas une variance (ROOM-GRAVSAG) -> jak-hd-physics-NOTES.md
(defun phys-tip-mean ((slot int) (chain int) (axis int))
  (let ((n (phys-stat slot chain 15)))
    (if (or (< n 0.5) (< axis 0) (> axis 2))
      0.0
      (/ (phys-stat slot chain (+ 12 axis)) n))))

;; [NOTE-448] LE STIMULUS QUE LA POINTE A REELLEMENT RECU sur la fenetre, en u/frame^2 : le pire module de -> jak-hd-physics-NOTES.md
(defun phys-tip-stim ((slot int) (chain int))
  (phys-stat slot chain 16))

;; [NOTE-342] `phys-link-amp` — l'amplitude PAR MAILLON, la seule qui voit le gradient inverse -> jak-hd-physics-NOTES.md
(defun phys-link-amp ((slot int) (chain int) (link int))
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (let* ((lb (* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link) PHYS-LB))
           (dx (- (-> *phys-lb* (+ lb 1)) (-> *phys-lb* (+ lb 0))))
           (dy (- (-> *phys-lb* (+ lb 3)) (-> *phys-lb* (+ lb 2))))
           (dz (- (-> *phys-lb* (+ lb 5)) (-> *phys-lb* (+ lb 4)))))
      (if (or (< dx 0.0) (< dy 0.0) (< dz 0.0))
        0.0
        (sqrtf (+ (* dx dx) (+ (* dy dy) (* dz dz))))))))

;; [NOTE-145] LE MOUVEMENT PROPRE D UN MAILLON, EN DEGRES -> jak-hd-physics-NOTES.md
(defun phys-link-ang ((slot int) (chain int) (link int))
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (-> *phys-la* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link))))

(defun phys-link-ang-stage ((slot int) (chain int) (link int) (stage int))
  "Le meme angle qu'au-dessus, releve a un ETAGE du solveur : 0 = apres l'integration seule,
   1 = apres contraintes + attenuation. La valeur finale reste `phys-link-ang`."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (let ((i (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link)))
      (if (zero? stage) (-> *phys-la0* i) (-> *phys-la1* i)))))

(defun phys-link-dev ((slot int) (chain int) (link int) (axis int))
  "UNE composante de la deviation SIGNEE de ce maillon (voir la note de `*phys-lsv*`).
   axis 0/1/2 = x/y/z, repere MONDE, instantanee, nulle a la pose du modele."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS) (< axis 0) (> axis 2)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (-> *phys-lsv* (+ (* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link) 3) axis))))

(defun phys-link-dev-anc ((slot int) (chain int) (link int) (axis int))
  "LA MEME DEVIATION QUE `phys-link-dev`, DANS LE TRIEDRE DE L'ANCRE (`*phys-lda*`) ; axis 0/1/2 = vertical / avant-arriere / lateral, l'ordre de SPEC 24. REPERE et lecture hors defaut : [NOTE-519] de jak-hd-physics-NOTES.md."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS) (< axis 0) (> axis 2)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (-> *phys-lda* (+ (* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link) 3) axis))))

(defun phys-dfm-anc ((slot int) (chain int) (i int) (j int))
  "SPEC 8/10-13/23/38 — L'ELEMENT (i,j) DE LA DEFORMATION EN ESPACE ANCRE, telle que le solveur
   Justification complete : [NOTE-306] de jak-hd-physics-NOTES.md."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< i 0) (> i 2) (< j 0) (> j 2))
    0.0
    (-> *phys-dfa* (+ (* slot PHYS-CHAINS) chain) vector i data j)))

(defun phys-link-rest-dir ((slot int) (chain int) (link int) (axis int))
  "L'AXE D'OS AU REPOS, PAR MAILLON, TEL QUE LE SOLVEUR L'A RELEVE — `*phys-ux*/uy/uz`, releve une
   Justification complete : [NOTE-305] de jak-hd-physics-NOTES.md."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS) (< axis 0) (> axis 2))
    0.0
    (let ((scl (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link)))
      (if (zero? (-> *phys-ucap* scl))
        0.0
        (cond ((= axis 0) (-> *phys-ux* scl))
              ((= axis 1) (-> *phys-uy* scl))
              (else       (-> *phys-uz* scl)))))))

(defun phys-link-dev-anc-abs ((slot int) (chain int) (link int) (axis int))
  "LA MEME DEVIATION QUE `phys-link-dev-anc`, MAIS NON NORMALISEE (voir la note de `*phys-ldb*`).
   Justification complete : [NOTE-311] de jak-hd-physics-NOTES.md."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS) (< axis 0) (> axis 2)
          (< (phys-stat slot chain 0) 0.5))
    0.0
    (-> *phys-ldb* (+ (* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link) 3) axis))))

(defun phys-chain-axis ((slot int) (chain int) (which int))
  "LA CLASSIFICATION DU TRIEDRE, TELLE QUE LE SOLVEUR L'A FAITE, pour qu'elle soit RELISIBLE dans la trace au lieu d'etre supposee. Table de `which` : [NOTE-520] de jak-hd-physics-NOTES.md."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS))
    -1
    (let ((sc (+ (* slot PHYS-CHAINS) chain)))
      (cond ((= which 0) (-> *phys-axok* sc))
            ((= which 1) (-> *phys-axv* sc))
            ((= which 2) (-> *phys-axa* sc))
            ((= which 3) (-> *phys-axl* sc))
            ((= which 4) (-> *phys-axan* sc))
            ;; [NOTE-449] 5 = QUELLE REGLE A NOMME LES AXES (0 = protrusion propre, faute de partenaire ; -> jak-hd-physics-NOTES.md
            ((= which 5) (-> *phys-axsrc* sc))
            (else -1)))))

(defun phys-chain-radial ((slot int) (chain int) (which int))
  "SPEC 23 — LE TROISIEME DEGRE DE LIBERTE, LU A L EXECUTION. Docstring integrale : [NOTE-532] de jak-hd-physics-NOTES.md."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< which 0) (> which 4))
    0.0
    (let* ((sc (+ (* slot PHYS-CHAINS) chain))
           (b0 (fmax 1.0 (-> *phys-b0* sc))))
      (cond ((= which 0) (-> *phys-rr* sc))
            ((= which 1) (/ (-> *phys-rr* sc) b0))
            ((= which 2) (-> *phys-rrm* sc))
            ((= which 3) (-> *phys-rrr* sc))
            (else        (the float *phys-rrsat*))))))

(defun phys-chain-radial-link ((slot int) (chain int) (link int) (which int))
  "SPEC 23 — l'elongation radiale du MAILLON `link`. which 0 = unites de jeu · 1 = rapportee a B0 ·
   Justification complete : [NOTE-304] de jak-hd-physics-NOTES.md."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< link 0) (>= link PHYS-LINKS) (< which 0) (> which 8))
    0.0
    (let* ((sc  (+ (* slot PHYS-CHAINS) chain))
           (b0  (fmax 1.0 (-> *phys-b0* sc)))
           (scl (+ (* sc PHYS-LINKS) link))
           (v   (-> *phys-rrl* scl)))
      (cond ((= which 0) v)
            ((= which 1) (/ v b0))
            ((= which 2) (-> *phys-rrml* scl))
            ((= which 3) (-> *phys-rrrl* scl))
            ((= which 4) (-> *phys-rrsl* scl))
            ((= which 5) (-> *phys-rrol* scl))
            ((= which 6) (-> *phys-rrcl* scl))
            ((= which 7) (-> *phys-rrtl* scl))
            (else        (-> *phys-cddl* scl))))))

(defun phys-chain-axsep ((slot int) (chain int) (which int))
  "LES DEUX PROJECTIONS QUE LA DECISION DE NOMMAGE A COMPARE. Docstring integrale : [NOTE-533] de jak-hd-physics-NOTES.md."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< which 0) (> which 5))
    0.0
    (if (< which 3)
      (-> *phys-axsep* (+ (* (+ (* slot PHYS-CHAINS) chain) 3) which))
      (-> *phys-sepv* (+ (* slot PHYS-CHAINS) chain) data (- which 3)))))

(defun phys-chain-axis-stiff ((slot int) (chain int) (which int))
  "LE FACTEUR DE RAIDEUR EFFECTIVEMENT APPLIQUE sur l'axe `which` (0 = vertical, 1 = avant-arriere,
   2 = lateral), c'est-a-dire `1/mobilite` de SPEC 29. Publie pour que le rapport cite ce que le
   solveur a fait, pas ce que la constante dit."
  (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
          (< which 0) (> which 2))
    0.0
    (let* ((sc  (+ (* slot PHYS-CHAINS) chain))
           (row (cond ((= which 0) (-> *phys-axv* sc))
                      ((= which 1) (-> *phys-axa* sc))
                      (else        (-> *phys-axl* sc)))))
      (if (and (>= row 0) (< row 3)) (-> *phys-axs* (+ (* sc 3) row)) 0.0))))

(defun phys-slot-chains ((slot int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS)) (-> *phys-slot-nch* slot) 0))

(defun phys-chain-links ((slot int) (chain int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-nlink* (+ (* slot PHYS-CHAINS) chain))
    0))

(defun phys-chain-family ((slot int) (chain int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-fam* (+ (* slot PHYS-CHAINS) chain))
    0))

;; [NOTE-450] SPEC 4, l'exception : `hang` > 0 = « ce qui doit pendre » (les lunettes), qui ne retourne PAS a -> jak-hd-physics-NOTES.md
(defun phys-chain-hang ((slot int) (chain int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-hang* (+ (* slot PHYS-CHAINS) chain))
    0.0))

(defun phys-chain-joint ((slot int) (chain int) (link int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= link 0) (< link PHYS-LINKS))
    (-> *phys-joint* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link))
    -1))

;; [NOTE-451] la longueur que LE MODELE donne a l'os d'un lien (son attache est l'ancre pour le lien 0). C'est -> jak-hd-physics-NOTES.md
(defun phys-chain-bone ((obj jak-hd) (slot int) (chain int) (link int) (comp int))
  ;; [NOTE-452] `comp` < 0 : LA LONGUEUR, exactement ce que cette fonction rendait. 0/1/2 : la COMPOSANTE -> jak-hd-physics-NOTES.md
  (let ((r 0.0))
    (when (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
               (>= link 0) (< link PHYS-LINKS)
               (nonzero? (-> obj draw)) (nonzero? (-> obj draw skeleton)))
      (let* ((skel (-> obj draw skeleton))
             (nbone (-> skel length))
             (sc  (+ (* slot PHYS-CHAINS) chain))
             (scl (+ (* sc PHYS-LINKS) link))
             (kk  (-> *phys-joint* scl))
             (kp  (if (> link 0) (-> *phys-joint* (- scl 1)) (-> *phys-anchor* sc))))
        (when (and (< link (-> *phys-nlink* sc)) (>= kk 0) (>= kp 0)
                   (< (+ kk 1) nbone) (< (+ kp 1) nbone))
          (let* ((pk (the-as vector (-> skel bones (+ kk 1) transform vector 3)))
                 (pp (the-as vector (-> skel bones (+ kp 1) transform vector 3)))
                 (d  (vector-vector-distance pk pp)))
            (set! r (cond ((< comp 0) d)
                          ((< d 0.0001) 0.0)
                          ((zero? comp) (/ (- (-> pk x) (-> pp x)) d))
                          ((= comp 1)   (/ (- (-> pk y) (-> pp y)) d))
                          (else         (/ (- (-> pk z) (-> pp z)) d))))))))
    r))

(defun phys-inject-set! ((v float))
  (set! *phys-inject* v)
  (none))

(defun phys-inject-count () *phys-injn*)

(defun phys-pc-pair ((slot int) (chain int) (which int))
  "LA REPONSE APPARIEE DU CONTROLE POSITIF : `max` sur (frame, lien) de `w - b`. 0 = la reponse,
   1 = `w` a son argmax, 2 = `b` a son argmax. NATURE : une profondeur, unites de jeu. REPERE : le
   monde. HORS INJECTION : PHYS-NOCONTACT. Justification : [NOTE-459] de jak-hd-physics-NOTES.md."
  (let ((sc (+ (* slot PHYS-CHAINS) chain)))
    (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS))
      PHYS-NOCONTACT
      (cond ((= which 0) (-> *phys-pcr* sc))
            ((= which 1) (-> *phys-pcra* sc))
            (else (-> *phys-pcrb* sc))))))

(defun phys-pc-base ((slot int) (chain int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-pcb* (+ (* slot PHYS-CHAINS) chain)) PHYS-NOCONTACT))

(defun phys-pc-inj ((slot int) (chain int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (-> *phys-pci* (+ (* slot PHYS-CHAINS) chain)) PHYS-NOCONTACT))

(defun phys-tan-count () *phys-tan-n*)

(defun phys-tan-depth () *phys-tan-d*)

(defun phys-tan-eff () *phys-tan-e*)

(defun phys-tan-old () *phys-tan-o*)
(defun phys-tan-cap () *phys-tan-c*)
(defun phys-tan-capd () *phys-tan-cs*)
(defun phys-tan-capg () *phys-tan-cg*)

(defun phys-tan-reset! ()
  (set! *phys-tan-n* 0)
  (set! *phys-tan-d* 0.0)
  (set! *phys-tan-e* 0.0)
  (set! *phys-tan-o* 0.0)
  (set! *phys-tan-c* 0)
  (set! *phys-tan-cs* 0.0)
  (set! *phys-tan-cg* 0.0)
  (none))

(defun phys-inject-count-reset! ()
  (set! *phys-injn* 0)
  ;; [NOTE-155] les deux maxima apparies partent de la sentinelle « aucun contact », comme
  ;; l'emplacement 4 de `*phys-st*` : un maximum plafonne a zero rendrait la colonne constante.
  (dotimes (i PHYS-SC)
    (set! (-> *phys-pcb* i) PHYS-NOCONTACT)
    (set! (-> *phys-pcr* i) PHYS-NOCONTACT)
    (set! (-> *phys-pcra* i) PHYS-NOCONTACT)
    (set! (-> *phys-pcrb* i) PHYS-NOCONTACT)
    (set! (-> *phys-pci* i) PHYS-NOCONTACT))
  (none))

;; CONTROLE POSITIF DU CANAL D'AUTEUR : 1 = l'animation est retardee d'une frame dans la position
;; ecrite. Le compteur d'identite doit s'effondrer ; s'il ne bouge pas, il ne mesure rien.
(defun phys-auth-lag-set! ((v int))
  (set! *phys-auth-lag* v)
  (none))

;; [NOTE-213] CE QUE LES LIMITEURS ONT RETIRE, en unites de jeu (SPEC 7 : un suppresseur se chiffre). -> jak-hd-physics-NOTES.md
(defun phys-limiter ((which int))
  (case which
    ((2) (the float *phys-raddrop-n*))
    ((3) *phys-raddrop-sum*)
    ;; SPEC 21/22 : 6 = sous-pas integres avec le RESSORT QUI RAIDIT actif (pas un suppresseur, il
    ;; ne retire rien) ; 9 = fois ou le FILET positionnel a mordu, 10 = ce que LUI a retire (unites).
    ((6) (the float *phys-stif-n*))
    ((9) (the float *phys-sat-n*))
    ((10) *phys-sat-sum*)
    ;; 11/12 = LE MUR DU POINT LIBRE de §21/§22 : fois ou il a mordu, et ce qu'il a retire.
    ((11) (the float *phys-cwn*))
    ((12) *phys-cwsum*)
    (else (the float *phys-buried-n*))))

;; INVERSIONS (SPEC 5 / verdict owner) : which 0 = bascules corrigees, 1 = cas degeneres rattrapes.
(defun phys-inversions ((which int))
  (case which
    ((0) (the float *phys-invn*))
    ((1) (the float *phys-invfix*))
    ((2) (the float *phys-reseat-n*))
    ;; 4 = re-assises retombees sur l'ancienne heuristique. Doit valoir ZERO.
    ((4) (the float *phys-reseat-fb*))
    (else (the float *phys-invres*))))

(defun phys-inv-inject-set! ((v int))
  (set! *phys-inv-inject* v)
  (none))

;; [NOTE-341] DIAGNOSTIC PAR CHAINE — la legende des emplacements de `*phys-dg*` -> jak-hd-physics-NOTES.md
(defun phys-diag ((slot int) (chain int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= which 0) (< which PHYS-DG))
    (-> *phys-dg* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-DG) which))
    0.0))

(defun phys-comexw-reset! ()
  "REMET A ZERO LA TRANCHE 23-42 — TOUT CE QUI A LA PORTEE D'UNE FENETRE (chaine, animation,
   Justification complete : [NOTE-303] de jak-hd-physics-NOTES.md."
  (dotimes (i PHYS-SC)
    (dotimes (q 27) (set! (-> *phys-dg* (+ (* i PHYS-DG) (+ 23 q))) 0.0))
    ;; 53-58 [NOTE-139] l'APEX + les extremes de SPEC 15. Tranche SEPAREE : 50-52 sont un ETAT qui doit survivre.
    (dotimes (q 6) (set! (-> *phys-dg* (+ (* i PHYS-DG) (+ 53 q))) 0.0))
    ;; [NOTE-466] 79-85 : le septuplet d'etages A PORTEE DE FENETRE. Il est remis a zero ICI et pas ailleurs, parce que c'est le seul point par lequel TOUTE fenetre passe, dans TOUTES les phases. 72-78 n'y entre pas : sa portee est la JAMBE, et `PHYSSTGT` en depend.
    (dotimes (q 7) (set! (-> *phys-dg* (+ (* i PHYS-DG) (+ 79 q))) 0.0)))
  (none))

(defun phys-diag-reset! ()
  (dotimes (i (* PHYS-SC PHYS-DG)) (set! (-> *phys-dg* i) 0.0))
  ;; l'etat de contrainte de la frame precedente est oublie aussi : sinon la premiere frame de la
  ;; fenetre suivante compterait une bascule qui n'a pas eu lieu dans cette fenetre.
  (dotimes (i PHYS-SCL) (set! (-> *phys-flhas* i) 0))
  ;; [NOTE-109] le cumul par branche vit le meme cycle que le reste du diagnostic : c'est ce qui
  ;; rend les deux jambes d'un controle comparables sans qu'aucune ne herite de l'autre.
  (dotimes (i (* 3 PHYS-SC)) (set! (-> *phys-cpc* i) 0.0))
  ;; [NOTE-241] ce que la contrainte de peau retire vit le meme cycle : deux jambes comparables.
  (set! *phys-skc-n* 0)
  (set! *phys-skc-d* 0.0)
  (set! *phys-skc-w* 0.0)
  (set! *phys-skc-r* 0.0) (dotimes (i (* PHYS-SC 20)) (set! (-> *phys-skl* i) 0.0)) (dotimes (i (* PHYS-SCL 2)) (set! (-> *phys-nflip* i) 0.0)) (dotimes (i PHYS-SCL) (set-vector! (-> *phys-sdnp* i) 0.0 0.0 0.0 0.0))
  (set! *phys-e22-n* 0)
  (set! *phys-e22-d* 0.0) (set! *phys-e21-n* 0) (set! *phys-e21-d* 0.0)
  (none))

;; [NOTE-453] CONTROLE POSITIF DE L'AUTO-COLLISION : 1 = l'exclusion chaine <-> ses propres volumes est LEVEE. -> jak-hd-physics-NOTES.md
(defun phys-cpc ((slot int) (chain int) (which int))
  "LE CUMUL DE POUSSEES DE CONTACT DEPUIS LA DERNIERE REMISE A ZERO DE DIAGNOSTIC.
   Justification complete : [NOTE-310] de jak-hd-physics-NOTES.md."
  (let ((sc (+ (* slot PHYS-CHAINS) chain)))
    (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS)
            (< which 0) (>= which 3))
      0.0
      (-> *phys-cpc* (+ (* 3 sc) which)))))

(defun phys-skin-off-set! ((v int))
  "ABLATION, 0 EN LIVRAISON : 1 DESARME la contrainte de peau de SPEC 33/34 ([NOTE-241]). Texte complet : [NOTE-513] de jak-hd-physics-NOTES.md."
  (set! *phys-skin-off* v)
  (none))

(defun phys-skc ((which int))
  "CE QUE LES CONTRAINTES RETIRENT, cumul de JAMBE et jamais un maximum de fenetre. Table des cases (0-2 peau, 3, 4-5 borne §22, 6-7 borne §21) et leur LECTURE HORS DEFAUT : [NOTE-514] de jak-hd-physics-NOTES.md."
  (cond ((= which 0) (the float *phys-skc-n*))
        ((= which 1) *phys-skc-d*)
        ((= which 2) *phys-skc-w*)
        ((= which 3) *phys-skc-r*)
        ((= which 4) (the float *phys-e22-n*)) ((= which 5) *phys-e22-d*)
        ((= which 6) (the float *phys-e21-n*)) (else *phys-e21-d*)))

(defun phys-skl ((slot int) (chain int) (w int)) "LE LEVIER DE LA CONTRAINTE DE PEAU AU POINT QUI DECIDE — instrument PUR (aucune case n'est lue par le solveur), 20 cases par chaine, meme fenetre que `phys-skc`. Table des cases : [NOTE-482] de jak-hd-physics-NOTES.md." (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS) (< w 0) (>= w 20)) 0.0 (-> *phys-skl* (+ (* 20 (+ (* slot PHYS-CHAINS) chain)) w))))

(defun phys-nflip ((slot int) (chain int) (link int) (w int)) "LES RENVERSEMENTS DE LA DIRECTION DE POUSSEE — instrument PUR. w=0 renversements (angle > 90 deg entre deux appels consecutifs), w=1 total compare. NATURE : un COMPTE, sans dimension. REPERE : le monde, deux appels consecutifs de `phys-skin-chain` (elle est appelee DEUX fois par frame). LECTURE HORS DEFAUT : w=0 nul. Justification : [NOTE-521]." (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS) (< link 0) (>= link PHYS-LINKS) (< w 0) (>= w 2)) 0.0 (-> *phys-nflip* (+ (* 2 (+ (* PHYS-LINKS (+ (* slot PHYS-CHAINS) chain)) link)) w))))
(defun phys-e22-off-set! ((v int))
  "ABLATION, 0 EN LIVRAISON : 1 DESARME `phys-cap-e22!`, la borne de SPEC 22 sur la valeur LIVREE.
   Desarmee, la course doit etre IDENTIQUE AU BIT a celle d'avant son ajout — c'est ce controle,
   et lui seul, qui autorise a attribuer a la borne ce que la jambe armee rend de different."
  (set! *phys-e22-off* v)
  (none))

(defun phys-prox-off-set! ((v int))
  "ABLATION DE MESURE, 0 EN LIVRAISON : 1 retire les SPHERES PROXIMALES de la liste des obstacles. Ce qu'elle discrimine et pourquoi elle ne touche pas aux rayons : [NOTE-524] de jak-hd-physics-NOTES.md."
  (set! *phys-prox-off* v)
  (none))

(defun phys-self-inject-set! ((v int))
  (set! *phys-self-inject* v)
  (none))

(defun phys-side-off-set! ((v int))
  (set! *phys-side-off* v)
  (none))

;; [NOTE-454] CONTROLE DU CYCLE 8 : 1 = la contrainte de longueur est DESARMEE. Voir la note de -> jak-hd-physics-NOTES.md
(defun phys-kah-off-set! ((v int)) "1 = la sommation compensee est DESARMEE (branche bit-identique a l'addition d'avant le cycle 116). Controle negatif de [NOTE-512]." (set! *phys-kah-off* v) (none))
(defun phys-len-off-set! ((v int))
  (set! *phys-len-off* v)
  (none))

;; [NOTE-455] `phys-jacobi-off-set!` et `phys-prio-off-set!` retirees : ZERO site d'appel dans tout `goal_src` -> jak-hd-physics-NOTES.md
(defun phys-prio-meas-set! ((v int))
  "1 = la passe de selection tourne POUR COMPTER, sans jamais ecarter un volume. Son controle est son propre desarmement : [NOTE-517] de jak-hd-physics-NOTES.md."
  (set! *phys-prio-meas* v)
  (none))

(defun phys-col-off-set! ((v int))
  "1 = le MUR DE COLLISION est desarme (voir [NOTE-53]). La salle l'arme sur la passe k=4 du
   balayage d'orientation et le REND A 0 en sortant."
  (set! *phys-col-off* v)
  (none))

(defun phys-rr-off-set! ((v int))
  "1 = la borne §22 du canal RADIAL est desarmee (`rcap` -> +inf), sur la fenetre d'orientation seule. Ce qu'elle discrimine : [NOTE-515] de jak-hd-physics-NOTES.md."
  (set! *phys-rr-off* v)
  (none))

(defun phys-cone-off-set! ((v int))
  "1 = le rayon redevient interpole sur le parametre de PROJECTION, c'est-a-dire le predicat faux d'avant. Ce qui doit REMONTER, et pourquoi : [NOTE-516] de jak-hd-physics-NOTES.md."
  (set! *phys-cone-off* v)
  (none))

(defun phys-prio ((which int))
  "0 = paires (lien, volume) ecartees par la priorite ; 1 = liens contraints par plus d'un volume.
   NATURE : un COMPTE d'evenements sur la fenetre, pas une amplitude. REPERE : sans objet.
   LECTURE QUAND LE DEFAUT EST ABSENT : 0 pour les deux — aucun lien n'est en conflit."
  (the float (cond ((= which 0) *phys-prio-n*) (else *phys-prio-multi*))))

(defun phys-prio-reset! ()
  (set! *phys-prio-n* 0)
  (set! *phys-prio-multi* 0)
  (none))

(defun phys-inversions-reset! ()
  (set! *phys-invn* 0)
  (set! *phys-invres* 0)
  (set! *phys-invfix* 0)
  (none))

;; [NOTE-456] le collider resolu numero ci : son joint, son second joint (-1 = sphere), ses deux rayons. Publi -> jak-hd-physics-NOTES.md
(defun phys-collider-field ((slot int) (ci int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= ci 0) (< ci (-> *phys-slot-nco* slot)))
    (let ((sco (+ (* slot PHYS-COLS) ci)))
      (case which
        ((0) (-> *phys-cj* sco))
        (else (-> *phys-cj2* sco))))
    -1))

(defun phys-slot-colliders ((slot int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS)) (-> *phys-slot-nco* slot) 0))

;; COMBIEN DE FOIS LE VOLUME `ci` A CONTRAINT LE MAILLON `link` DE `chain` — le compte est
;; desormais PAR MAILLON, plus par chaine : c'est la dimension qui manquait pour dire LEQUEL viole.
(defun phys-chain-vol ((slot int) (chain int) (link int) (ci int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= link 0) (< link PHYS-LINKS) (>= ci 0) (< ci PHYS-COLS))
    (-> *phys-cvh* (+ (* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link) PHYS-COLS) ci))
    0))

(defun phys-chain-volmax ((slot int) (chain int) (link int) (ci int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= link 0) (< link PHYS-LINKS) (>= ci 0) (< ci PHYS-COLS))
    (-> *phys-cvm* (+ (* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-LINKS) link) PHYS-COLS) ci)) 0.0))

;; COMBIEN DE FOIS LE VOLUME `ci` S'EST DISPUTE UN LIEN DE `chain` AVEC UN AUTRE VOLUME.
(defun phys-chain-conf ((slot int) (chain int) (ci int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= ci 0) (< ci PHYS-COLS))
    (-> *phys-cfh* (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-COLS) ci))
    0))

;; [NOTE-152] LA DIRECTION MONDE DE L'AXE `axis` DU SOLVEUR (roles de SPEC 7). -> jak-hd-physics-NOTES.md
(defun phys-axis-world ((slot int) (chain int) (axis int) (comp int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= axis 0) (< axis 3) (>= comp 0) (< comp 3))
    (let ((sc (+ (* slot PHYS-CHAINS) chain)))
      (if (zero? (-> *phys-axok* sc))
        0.0
        (let ((row (cond ((zero? axis) (-> *phys-axv* sc))
                         ((= axis 1)   (-> *phys-axa* sc))
                         (else         (-> *phys-axl* sc)))))
          (-> *phys-axw* (+ (* sc 9) (+ (* row 3) comp))))))
    0.0))

;; [NOTE-51] LE TRIEDRE DE SPEC 7 ET POURQUOI IL LUI FALLAIT UN ACCESSEUR -> jak-hd-physics-NOTES.md
(defun phys-tri-world ((slot int) (chain int) (axis int) (comp int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= axis 0) (< axis 3) (>= comp 0) (< comp 3))
    (let ((sc (+ (* slot PHYS-CHAINS) chain)))
      (if (zero? (-> *phys-fok* sc))
        0.0
        (let ((v (cond ((zero? axis) (-> *phys-fx* sc))
                       ((= axis 1)   (-> *phys-fy* sc))
                       (else         (-> *phys-fz* sc)))))
          (cond ((zero? comp) (-> v x)) ((= comp 1) (-> v y)) (else (-> v z))))))
    0.0))

;; [NOTE-104] SPEC 33 — LE DOMAINE DE LA PAIRE (chaine, volume), pas son compte de contact -> jak-hd-physics-NOTES.md
(defun phys-chain-vol-dom ((slot int) (chain int) (ci int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS)
           (>= ci 0) (< ci PHYS-COLS))
    (let ((h (+ (* (+ (* slot PHYS-CHAINS) chain) PHYS-COLS) ci)))
      (cond
        ((= which 0) (-> *phys-cdm* h))
        ((= which 1) (-> *phys-cfl* h))
        (else (the float (-> *phys-cdmok* h)))))
    0.0))

(defun phys-limiter-reset! ()
  (set! *phys-raddrop-n* 0)
  (set! *phys-raddrop-sum* 0.0)
  (set! *phys-buried-n* 0)
  (set! *phys-sat-n* 0)
  (set! *phys-sat-sum* 0.0)
  (set! *phys-stif-n* 0)
  (set! *phys-cwn* 0)
  (set! *phys-cwsum* 0.0)
  (dotimes (i (* PHYS-SCL PHYS-COLS)) (set! (-> *phys-cvh* i) 0) (set! (-> *phys-cvm* i) 0.0))
  (dotimes (i (* PHYS-SC PHYS-COLS)) (set! (-> *phys-cfh* i) 0))
  (none))

;; [NOTE-457] SPEC 5. which 0 = frames ou l'anim pilotait cette chaine, 1 = celles ou la pose ecrite est parti -> jak-hd-physics-NOTES.md
(defun phys-auth ((slot int) (chain int) (which int))
  (if (and (>= slot 0) (< slot PHYS-SLOTS) (>= chain 0) (< chain PHYS-CHAINS))
    (let ((sc (+ (* slot PHYS-CHAINS) chain)))
      (case which
        ((0) (-> *phys-ahit* sc))
        ((1) (-> *phys-aok* sc))
        ((2) (-> *phys-adot* sc))
        ((3) (-> *phys-anrm* sc))
        ((4) (-> *phys-dsum* sc))
        ((5) (-> *phys-usum* sc))
        ((6) (-> *phys-tmov* sc))
        (else (-> *phys-conf* sc))))
    0.0))

(defun phys-auth-reset! ()
  (dotimes (sc PHYS-SC)
    (set! (-> *phys-ahit* sc) 0.0)
    (set! (-> *phys-aok* sc) 0.0)
    (set! (-> *phys-adot* sc) 0.0)
    (set! (-> *phys-anrm* sc) 0.0)
    (set! (-> *phys-dsum* sc) 0.0)
    (set! (-> *phys-usum* sc) 0.0)
    (set! (-> *phys-tmov* sc) 0.0)
    (set! (-> *phys-conf* sc) 0.0)
    (set! (-> *phys-rhas* sc) 0))
  (none))

;; le slot de simulation d'un compagnon, pour que la salle sache ou lire ses chiffres.
(defun phys-shape ((slot int) (chain int) (which int))
  "SPEC 8/10-13/29/36 — l'etat de forme et de torsion. Docstring integrale : [NOTE-507] de jak-hd-physics-NOTES.md."
  (let ((sc (+ (* slot PHYS-CHAINS) chain)))
    (if (or (< slot 0) (>= slot PHYS-SLOTS) (< chain 0) (>= chain PHYS-CHAINS))
      0.0
      (cond
        ((< which 3) (-> *phys-dfs* (+ (* sc 3) which)))
        ((= which 3) (-> *phys-dfdet* sc))
        ((= which 4) (-> *phys-sec* sc))
        ((= which 5) (-> *phys-secm* sc))
        ((= which 6) (-> *phys-twr* sc))
        ((= which 7) (-> *phys-twm* sc))
        ((= which 8) (the float (-> *phys-dfon* sc)))
        ((< which 12) (-> *phys-gc* (+ (* sc 3) (- which 9))))
        ((= which 12) (-> *phys-secr* sc))
        ((= which 13) (-> *phys-dynm* sc))
        ((< which 18) (-> *phys-gr* (+ (* sc 3) (- which 15))))
        ((= which 18) (the float *phys-twsat*))
        ((= which 19) (-> *phys-prsm* sc))
        ((= which 20) (-> *phys-prsr* sc))
        ;; [NOTE-96] 21/22/23/24 : LES DEUX ENTREES DU TENSEUR AVANT LEUR PLAFOND. -> jak-hd-physics-NOTES.md
        ((= which 21) (-> *phys-dynr* sc))
        ((= which 22) (-> *phys-dynn* sc))
        ((= which 23) (-> *phys-prsn* sc))
        ((= which 24) (-> *phys-dyna* sc))
        ;; [NOTE-458] 25-29 : LA NATURE DE L'ENTREE DE PRESSION (cycle 36 etape 1). -> jak-hd-physics-NOTES.md
        ((< which 32) (-> *phys-cpi* (+ (* 7 sc) (- which 25))))
        ((= which 32) (-> *phys-cpd* sc))
        ((< which 36) (-> *phys-dfsm* (+ (* sc 3) (- which 33))))  ;; [NOTE-505] pic de FENETRE des echelles
        (else 0.0)))))

(defun phys-rest ((which int))
  "SPEC 33/34 — LA RESTITUTION DE CONTACT, SUR LA FENETRE.
   Justification complete : [NOTE-302] de jak-hd-physics-NOTES.md."
  (cond
    ((= which 0) (the float *phys-rstn*))
    ((= which 1) *phys-rstin*)
    ((= which 2) *phys-rstout*)
    ((= which 3) *phys-rstsum*)
    ((= which 4) (the float *phys-rstm*))
    (else 0.0)))

(defun phys-rest-off-set! ((v int))
  "CONTROLE NEGATIF de SPEC 33/34 : arme = 1, `q` n'est plus corrige du tout et le solveur retrouve
   EXACTEMENT son comportement d'avant le cycle 7 (restitution effective +1)."
  (set! *phys-rst-off* v)
  (none))

(defun phys-rest-k-set! ((v float))
  "CONTROLE POSITIF de SPEC 33/34 : multiplie le coefficient de la spec. 15.0 porte le sein<->sein
   a 0.90, ce qui doit faire MONTER la vitesse sortante relue. 1.0 = la spec."
  (set! *phys-rst-k* v)
  (none))

(defun phys-slot-of ((pid int)) (phys-slot-for-pid pid))

)
