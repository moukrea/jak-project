;; Glang-mixed: re-format the name-override label buffers from the loaded text bank so
;; they follow (-> *pc-settings* text-language). Runs on every menu open (init-game-options
;; re-canonicalizes there) and again right after a text-language change reloads the bank
;; (same-menu-session navigation must not read stale heap pointers — hence buffers + copy,
;; never bank pointers). A #f lookup (id absent AND fallback disabled) leaves the buffer as-is.
(defun refresh-runtime-option-labels! ()
  (when *common-text*
    (let ((s (lookup-text! *common-text* (the-as text-id #x1700) #t)))
      (if s (format (clear *fps-counter-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x1701) #t)))
      (if s (format (clear *render-scale-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x1702) #t)))
      (if s (format (clear *min-render-scale-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x1703) #t)))
      (if s (format (clear *dynamic-render-scale-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x1704) #t)))
      (if s (format (clear *min-target-fps-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x1705) #t)))
      (if s (format (clear *advanced-settings-label*) "~S" s)))
    ;; Grecharged-hud-jak1
    (let ((s (lookup-text! *common-text* (the-as text-id #x1706) #t)))
      (if s (format (clear *recharged-settings-label*) "~S" s)))
    (#when FLAG_RECHARGED_HUD
    (let ((s (lookup-text! *common-text* (the-as text-id #x1707) #t)))
      (if s (format (clear *recharged-hud-label*) "~S" s))))
    ;; Grecharged-ambient-occlusion
    (let ((s (lookup-text! *common-text* (the-as text-id #x170e) #t)))
      (if s (format (clear *ambient-occlusion-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x170f) #t)))
      (if s (format (clear *ao-quality-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x1713) #t)))
      (if s (format (clear *ao-strength-label*) "~S" s))))
  (none))

;; Goptions-reorder: stable pointers to the Min Target FPS row (physical index 4) in each graphics
;; array, captured at load time while the arrays are in their full static layout. Used to reinsert the
;; row when Dynamic Render Scale is toggled back ON (the objects are static; the pointers never move).
(define *graphic-options-mtf-pc* (-> *graphic-options-pc* 4))
(define *graphic-options-mtf-android* (-> *graphic-options-pc-android* 4))

;; Goptions-reorder: show/hide the Min Target FPS row (physical index 4) by mutating the live `length`
;; of a graphics-options array — the renderer + navigation key off (length arr), so shrinking the live
;; length truly REMOVES the row (not just greys it). Idempotent via length checks; `saved` is the stable
;; Min-Target-FPS object used to reinsert the row. `full-len` is the array's full (row-shown) length.
(defun graphic-options-set-mtf-visible! ((arr (array game-option)) (saved game-option) (full-len int) (show? symbol))
  (cond
    (show?
     ;; reinsert MTF at index 4 if currently hidden: shift the tail right one slot, restore full length
     (when (< (-> arr length) full-len)
       (dotimes (j (- full-len 5))
         (let ((i (- (+ full-len -1) j)))
           (set! (-> arr i) (-> arr (+ i -1)))))
       (set! (-> arr 4) saved)
       (set! (-> arr length) full-len)))
    (else
     ;; remove MTF at index 4 if currently shown: shift the tail left one slot, drop live length by 1
     (when (= (-> arr length) full-len)
       (dotimes (j (- full-len 5))
         (let ((i (+ 4 j)))
           (set! (-> arr i) (-> arr (+ i 1)))))
       (set! (-> arr length) (+ full-len -1)))))
  (none))

;; Re-point + relabel the RENDER SCALE slider row (physical index 3 in both arrays, above the Min Target
;; FPS row so it never shifts) per the Dynamic Render Scale toggle: OFF -> edits render-scale (manual %),
;; label "RENDER SCALE"; ON -> edits min-render-scale (auto-scaler floor), label "MIN RENDER SCALE".
;; Also shows/hides the Min Target FPS row (index 4): visible only when Dynamic Render Scale is ON.
(defun apply-dynamic-rs-menu-mode! ()
  (let ((dyn? (-> *pc-settings* dynamic-render-scale?)))
    (set! (-> *graphic-options-pc* 3 value-to-modify)
          (if dyn? (&-> *pc-settings* min-render-scale) (&-> *pc-settings* render-scale)))
    (set! (-> *graphic-options-pc* 3 name-override)
          (if dyn? *min-render-scale-label* *render-scale-label*))
    (set! (-> *graphic-options-pc-android* 3 value-to-modify)
          (if dyn? (&-> *pc-settings* min-render-scale) (&-> *pc-settings* render-scale)))
    (set! (-> *graphic-options-pc-android* 3 name-override)
          (if dyn? *min-render-scale-label* *render-scale-label*))
    ;; Gvulkan-option + Grecharged-hud-jak1: full lengths now 15 desktop / 12 android (VULKAN RENDERER
    ;; and RECHARGED SETTINGS rows both inserted after index 4, so the MTF stable pointers are unaffected).
    ;; Grecharged-menu-overhaul RECADRAGE: the vanilla graphics arrays are no longer displayed (the
    ;; unified GRAPHISMES page is). Keep them at FULL layout so build-graphics-unified! reads canonical
    ;; indices; the fused page handles Min-Target-FPS visibility itself (via `dyn?` below).
    (graphic-options-set-mtf-visible! *graphic-options-pc* *graphic-options-mtf-pc* GFX_OPTIONS_PC_FULL_LEN #t)
    (graphic-options-set-mtf-visible! *graphic-options-pc-android* *graphic-options-mtf-android* GFX_OPTIONS_ANDROID_FULL_LEN #t)
    ;; re-assemble the unified GRAPHISMES page (adds/removes the Min-Target-FPS row per Dynamic Render Scale)
    (build-graphics-unified! dyn?))
  (none))

;; label for the NATIVE (panel resolution) entry at the top of the Game Resolution
;; list (uppercase for the menu font; shown via name-override).
(define *resolution-native-label* "NATIVE")

(define *sound-options-pc*
  (new 'static
       'boxed-array
       :type
       game-option
       (new 'static
            'game-option
            :option-type (game-option-type slider)
            :name (text-id sfx-volume)
            :scale #t
            :param1 0.0
            :param2 100.0
            :slider-step-size 1.0
            :on-confirm
            (lambda ((val object))
              (set! (-> *setting-control* default sfx-volume) (-> *pc-settings* memcard-volume-sfx))
              (none)))
       (new 'static
            'game-option
            :option-type (game-option-type slider)
            :name (text-id music-volume)
            :scale #t
            :param1 0.0
            :param2 100.0
            :slider-step-size 1.0
            :on-confirm
            (lambda ((val object))
              (set! (-> *setting-control* default music-volume) (-> *pc-settings* memcard-volume-music))
              (none)))
       (new 'static
            'game-option
            :option-type (game-option-type slider)
            :name (text-id speech-volume)
            :scale #t
            :param1 0.0
            :param2 100.0
            :slider-step-size 1.0
            :on-confirm
            (lambda ((val object))
              (set! (-> *setting-control* default dialog-volume) (-> *pc-settings* memcard-volume-dialog))
              (none)))
       ;(new 'static 'game-option :option-type (game-option-type on-off) :name (text-id music-fadein) :scale #t)
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t)))

