;;-*-Lisp-*-
(in-package goal)
(require "engine/ui/progress/progress.gc")

#| Code for the progress menu in the PC port. The original code is still loaded, this just has some overriden functions. |#

;;---------------------------
;;---------------------------
;; pc menu extra stuff

(defconstant PROGRESS_PC_PAGE_HEIGHT 7)

(defconstant PROGRESS_SCROLL_DIR_UP -1)

(defconstant PROGRESS_SCROLL_DIR_DOWN 1)

(defconstant GAME_MIN_RES_MULT 0.5)

(deftype progress-scroll (structure)
  ((transition  float)
   (start-index int16)
   (real-index  int16)
   (direction   int8)
   (last-screen progress-screen)))

(define *progress-scroll* (new 'static 'progress-scroll))

(defmacro progress-scrolling? ()
  `(< (-> *progress-scroll* transition) 1.0))

(defmacro progress-scrolling-up? ()
  `(and (progress-scrolling?) (= (-> *progress-scroll* direction) PROGRESS_SCROLL_DIR_UP)))

(defmacro progress-scrolling-down? ()
  `(and (progress-scrolling?) (= (-> *progress-scroll* direction) PROGRESS_SCROLL_DIR_DOWN)))

(defconstant *progress-scroll-start* (-> *progress-scroll* start-index))

(defconstant *progress-scroll-end* (+ -1 PROGRESS_PC_PAGE_HEIGHT (-> *progress-scroll* start-index)))

(defmacro progress-scroll-reset ()
  "resets scroll. nothing will be scrolling, as if it had finished."
  `(begin
    (set! (-> *progress-scroll* transition) 1.0)
    (set! (-> *progress-scroll* direction) 0)
    (set! (-> *progress-scroll* start-index) 0)))

(defmacro progress-scroll-up! ()
  `(begin
    (set! (-> *progress-scroll* transition) 0.0)
    (set! (-> *progress-scroll* direction) PROGRESS_SCROLL_DIR_UP)
    (1-! (-> *progress-scroll* start-index))))

(defmacro progress-scroll-down! ()
  `(begin
    (set! (-> *progress-scroll* transition) 0.0)
    (set! (-> *progress-scroll* direction) PROGRESS_SCROLL_DIR_DOWN)
    (1+! (-> *progress-scroll* start-index))))

;; ============================================================================================
;; Grecharged-menu-overhaul V2 (owner 2026-08-02): the menu lives inside a Jak2-style bluish
;; vertical HOLOGRAM occupying the LEFT HALF of the screen, PROJECTED by the comm-ship drone.
;; Menu 2D units (confirmed from draw-sprite2d-xy / screen-gradient): x 0(left)..256(center)..512(right),
;; y 0(top)..112(center)..224(bottom). Half screen width = 256. All geometry below derives the layout
;; (frame, text box, hint line) from ONE set of constants so nothing is a magic origin-y again.
;; ============================================================================================
(defconstant HOLO_X       20)   ;; frame left edge (left margin 20)
(defconstant HOLO_W      224)   ;; frame width  (<= 256 = half screen); right edge = 244 (margin to center)
(defconstant HOLO_Y       16)   ;; frame top edge (top margin 16)
(defconstant HOLO_H      192)   ;; frame height; bottom edge = 208 (bottom margin 16)
(defconstant HOLO_TEXT_CX 132)  ;; frame horizontal center = HOLO_X + HOLO_W/2
(defconstant HOLO_TEXT_X   22)  ;; text box left; box center = 22 + HOLO_TEXT_W/2 = 132 = frame center
(defconstant HOLO_TEXT_W  220)  ;; text/wrap width inside the frame
(defconstant HOLO_HINT_Y  188)  ;; hint line Y = HOLO_Y + HOLO_H - 20; leaves room for a 2-line hint fully
                                ;; INSIDE the frame bottom (208) and on-screen (< 224). Derived from the
                                ;; container geometry, NOT a magic origin-y that grows with the row count.
(defconstant HOLO_SCALE  0.62)  ;; global text shrink so rows fit the half-width holo (owner-tunable)
;; Grecharged-menu-overhaul V3 (owner 2026-08-02): sections are SPATIALLY separated, not inline colored
;; rows. Options hang SECTION_INDENT px to the right of their section header, and a SECTION_GAP of blank
;; vertical space sits ABOVE each header — so a group READS as a group, not an item in a flat list.
(defconstant SECTION_INDENT 12)  ;; px the option rows are indented under their section header (holo only)
(defconstant SECTION_GAP    10)  ;; px of extra vertical space above each section header (holo only)

;; Per-frame render-thread counters (the objective proof the redesign renders; read via (menu-holo-stats)).
(define *menu-holo-draw-count*        0)   ;; frames the holo frame was drawn
(define *menu-holo-scan-offset*       0)   ;; V3-B: scrolling scanline offset (ADVANCES every frame)
(define *menu-holo-flicker*           0)   ;; V3-B: per-frame holo flicker alpha (JITTERS every frame)
(define *menu-projector-active?*     #f)   ;; is the projector overlay currently spawned?
(define *menu-projector-spawn-count*  0)   ;; ++ each time the projector spawns (menu open)
(define *menu-projector-despawn-count* 0)  ;; ++ each time the projector despawns (menu close)
(define *menu-projector-draw-count*   0)   ;; frames the drone was drawn
(define *menu-beam-draw-count*        0)   ;; frames the projection beam was drawn
(define *menu-projector-angle*      0.0)   ;; orbit phase in rotation units (65536 = full turn)
(define *menu-projector-ox*         0.0)   ;; last drone screen x (per-frame transform, for stats)
(define *menu-projector-oy*         0.0)   ;; last drone screen y
(define *menu-projector-face*       0.0)   ;; last orientation angle toward the holo center (deg-ish)

(defun menu-rgba-i ((r int) (g int) (b int) (a int))
  "Build a runtime rgba from 0..255 components (statics can't take runtime alpha for the beam fade)."
  (the-as rgba (logior (logand r #xff)
                       (logior (ash (logand g #xff) 8)
                               (logior (ash (logand b #xff) 16) (ash (logand a #xff) 24))))))

(defun draw-percent-bar-w ((x int) (y int) (w int) (pct float) (color rgba))
  "Grecharged V2: like draw-percent-bar but with an explicit track width (narrow holo slider layout)."
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id sprite))
    (draw-sprite2d-xy buf x y w 14 (new 'static 'rgba :a #x60))
    (draw-sprite2d-xy buf x (+ y 2) (the int (* (the float w) pct)) 10 color))
  0
  (none))

;; Grecharged-menu-overhaul V3-CRASH (owner 2026-08-02): progress-holo-screen? and the porthole-hidden test
;; MOVED to the engine (goal_src/jak1/engine/ui/progress/progress.gc, just above adjust-sprites). The engine
;; adjust-sprites — a per-frame path live from the first title/menu screen — used to call the porthole test
;; across the engine->PC boundary; an unbound symbol-function there is a fn-ptr=0 SIGILL native crash on
;; arm64 (the V3 build died at boot on device this way). progress-holo-screen? still resolves here as a
;; PC->engine call (safe: the engine links first). The pause-landing variant is engine-only now
;; (progress-porthole-hidden?), so there is nothing left to define in this file.

(defun draw-menu-holo-frame! ()
  "Grecharged V3 (owner 2026-08-02): the bluish vertical hologram that CONTAINS the menu, now an ANIMATED
   holo-comm panel ported from the Jak2 progress-menu scanline effect (goal_src/jak2/engine/ui/hud.gc
   `draw-scan-and-line`: a scroll offset advanced +N/frame mod box-height, a per-frame alpha, additive
   feel). What varies EVERY frame here (see (menu-holo-stats)): the SCANLINE scroll offset advances, and
   the body/border/scanline ALPHA flickers (with an occasional harder glitch). Translucent cyan body lets
   the frozen scene show through; a bright cyan RIM GLOW rings the edge. Left half, margins on every edge."
  (let* ((fc (the int (-> *display* real-frame-counter)))
         (scan (mod (* fc 2) 32))                     ;; scanline scroll — advances 2px/frame, wraps at 32
         (fl (mod (* fc 733) 1000))                   ;; per-frame pseudo-random 0..999 (frame-driven jitter)
         (glitch (< (mod fc 53) 2))                   ;; a harder flicker glitch now and then
         (fa (if glitch 44 (+ 66 (/ fl 12))))         ;; body alpha ~#x2c..#x7f (JITTERS every frame)
         (ba (if glitch 96 (+ 130 (/ fl 20)))))       ;; border alpha (JITTERS every frame)
    ;; publish the animated values so the report/stats can PROVE they change frame-to-frame
    (set! *menu-holo-scan-offset* scan)
    (set! *menu-holo-flicker* fa)
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id sprite))
      ;; translucent cyan/blue body (alpha flickers per frame; scene shows through)
      (draw-sprite2d-xy buf HOLO_X HOLO_Y HOLO_W HOLO_H (menu-rgba-i #x10 #x3c #x6e fa))
      ;; outer RIM GLOW — a soft brighter cyan halo just outside the border, alpha tied to the flicker
      (let ((gc (menu-rgba-i #x3c #x9c #xe0 (/ ba 3))))
        (draw-sprite2d-xy buf (- HOLO_X 2) (- HOLO_Y 2) (+ HOLO_W 4) 3 gc)
        (draw-sprite2d-xy buf (- HOLO_X 2) (+ HOLO_Y HOLO_H -1) (+ HOLO_W 4) 3 gc)
        (draw-sprite2d-xy buf (- HOLO_X 2) HOLO_Y 3 HOLO_H gc)
        (draw-sprite2d-xy buf (+ HOLO_X HOLO_W -1) HOLO_Y 3 HOLO_H gc))
      ;; bright cyan border (top / bottom / left / right — alpha flickers)
      (let ((bc (menu-rgba-i #x4c #xb4 #xff ba)))
        (draw-sprite2d-xy buf HOLO_X HOLO_Y HOLO_W 2 bc)
        (draw-sprite2d-xy buf HOLO_X (+ HOLO_Y HOLO_H -2) HOLO_W 2 bc)
        (draw-sprite2d-xy buf HOLO_X HOLO_Y 2 HOLO_H bc)
        (draw-sprite2d-xy buf (+ HOLO_X HOLO_W -2) HOLO_Y 2 HOLO_H bc))
      ;; SCROLLING horizontal scanlines — each line's Y is offset by `scan`, which advances every frame
      (let ((sc (menu-rgba-i #x50 #xb0 #xf0 (+ 10 (/ fl 40)))))
        (dotimes (i 12)
          (let ((ly (+ HOLO_Y (mod (+ scan (* i 16)) HOLO_H))))
            (draw-sprite2d-xy buf HOLO_X ly HOLO_W 1 sc))))))
  (set! *menu-holo-draw-count* (+ *menu-holo-draw-count* 1))
  (none))

(defun menu-projector-set-active! ((on? symbol))
  "Spawn (menu open) / despawn (menu close) the projector overlay, counting each transition. Idempotent."
  (cond
    ((and on? (not *menu-projector-active?*))
     (set! *menu-projector-active?* #t)
     (set! *menu-projector-angle* 0.0)
     (set! *menu-projector-spawn-count* (+ *menu-projector-spawn-count* 1)))
    ((and (not on?) *menu-projector-active?*)
     (set! *menu-projector-active?* #f)
     (set! *menu-projector-despawn-count* (+ *menu-projector-despawn-count* 1))))
  (none))

(defun update-and-draw-menu-projector! ()
  "Grecharged V3 (owner 2026-08-02): the comm-ship drone that PROJECTS the hologram — now a genuine
   WORLD-SPACE 3D entity, not a screen-space HUD element. The canonical jak1 comm-drone is `voicebox`
   (engine/common-obs/voicebox.gc, the `speaker` mesh, globally resident in GAME.CGO — the little
   communicator that spawns around Jak when Samos/Keira contact him remotely). Its full process is
   `*target*`/camera-slave coupled and would drive the camera / deref *target* on the frozen pause frame,
   so instead of spawning it we drive a lightweight stand-in AT A REAL WORLD TRANSFORM: a point orbiting a
   world ANCHOR placed in front of the frozen camera (position-in-front-of-camera!, shifted left toward the
   holo). Every frame we recompute that world transform, PROJECT it to the screen through the live game
   camera (*math-camera* / transform-point-qword!), FRUSTUM-test it (drawn only when the projection reports
   on-screen), PERSPECTIVE-scale the billboard by the 1/w factor, keep it ORIENTED toward the holo anchor,
   and draw a 3D light BEAM of world points from the drone toward the anchor. The hologram thus reads as a
   projection standing in the scene that the drone orbits. Spawn/despawn/draw/beam are all counted."
  (when *menu-projector-active?*
    ;; advance the orbit phase (per-frame world transform) — 65536 units = one full turn (~7.8s @60fps)
    (set! *menu-projector-angle* (+ *menu-projector-angle* (* 140.0 (-> *display* time-adjust-ratio))))
    (let ((anchor  (new 'stack-no-clear 'vector))
          (dpos    (new 'stack-no-clear 'vector))
          (bp      (new 'stack-no-clear 'vector))
          (scratch (new 'stack-no-clear 'vector))
          (q       (new 'stack-no-clear 'vector4w))
          (bq      (new 'stack-no-clear 'vector4w))
          (right   (-> *math-camera* inv-camera-rot vector 0))
          (up      (-> *math-camera* inv-camera-rot vector 1)))
      ;; world ANCHOR: a point in front of the (frozen) camera, shifted left toward the holo panel
      (position-in-front-of-camera! anchor (meters 11) (meters 0))
      (vector+float*! anchor anchor right (meters -2.5))
      ;; DRONE world position: orbits the anchor in the camera right/up plane (a real 3D ellipse)
      (let ((a *menu-projector-angle*))
        (vector+float*! dpos anchor right (* (meters 2.6) (cos a)))
        (vector+float*! dpos dpos   up    (* (meters 1.7) (sin a))))
      ;; project the DRONE through the game camera; only draw when on-screen (frustum test)
      (set! (-> q quad) (the-as uint128 0))
      (when (transform-point-qword! q dpos)
        (let* ((dsx (+ -1792 (/ (-> q x) 16)))         ;; GS 28.4 -> 0..512 menu space
               (dsy (- (/ (-> q y) 16) (-> *video-parms* screen-miny)))
               (scl (transform-point-vector-scale! scratch dpos))       ;; perspective 1/w factor
               (sz  (max 8 (min 22 (+ 11 (the int (* 260.0 scl))))))    ;; billboard size, perspective-nudged
               (asx dsx) (asy dsy))
          ;; project the ANCHOR (holo center) so the drone stays ORIENTED toward it and the beam aims at it
          (set! (-> bq quad) (the-as uint128 0))
          (when (transform-point-qword! bq anchor)
            (set! asx (+ -1792 (/ (-> bq x) 16)))
            (set! asy (- (/ (-> bq y) 16) (-> *video-parms* screen-miny))))
          (set! *menu-projector-ox* (the float dsx))
          (set! *menu-projector-oy* (the float dsy))
          (set! *menu-projector-face* (atan (the float (- asy dsy)) (the float (- asx dsx))))  ;; toward center
          (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id sprite))
            ;; --- 3D BEAM: world points from the drone toward the anchor, each projected, fading out ---
            (dotimes (i 8)
              (let ((tt (/ (the float (+ i 1)) 9.0)))
                (vector-! bp anchor dpos)
                (vector-float*! bp bp tt)
                (vector+! bp bp dpos)                    ;; bp = dpos + (anchor - dpos) * tt
                (set! (-> bq quad) (the-as uint128 0))
                (when (transform-point-qword! bq bp)
                  (let ((bx (+ -1792 (/ (-> bq x) 16)))
                        (by (- (/ (-> bq y) 16) (-> *video-parms* screen-miny)))
                        (bs (max 2 (the int (* (the float sz) (- 1.0 (* 0.7 tt)))))))
                    (draw-sprite2d-xy buf (- bx (/ bs 2)) (- by (/ bs 2)) bs bs
                                      (menu-rgba-i #x66 #xc0 #xff (the int (* 120.0 (- 1.0 (* 0.7 tt))))))))))
            (set! *menu-beam-draw-count* (+ *menu-beam-draw-count* 1))
            ;; --- drone body: dim halo, bright core, white emitter nub (perspective-scaled) ---
            (draw-sprite2d-xy buf (- dsx sz) (- dsy sz) (* 2 sz) (* 2 sz) (menu-rgba-i #x28 #x78 #xc0 #x50))
            (draw-sprite2d-xy buf (- dsx (/ sz 2)) (- dsy (/ sz 2)) sz sz (menu-rgba-i #x60 #xc8 #xff #xd0))
            (draw-sprite2d-xy buf (- dsx 2) (- dsy 2) 4 4 (menu-rgba-i #xff #xff #xff #xf0))
            (set! *menu-projector-draw-count* (+ *menu-projector-draw-count* 1)))))))
  (none))

(defun menu-resolve-hint ((row game-option))
  "Grecharged V3 (owner 2026-08-02): resolve a BESPOKE hint text-id for a row. The generic
   BY-CONTROL-TYPE fallback (toggle/slider/choice/bind/button — #x174b..#x174f) is DELETED: no row
   ever describes the control widget. Resolution order: (1) an explicit `hint` on the row (every
   GRAPHICS value row, stamped in build-graphics-unified!, plus the inert-Android and debug rows);
   (2) by the setting's specific NAME text-id (every named settings row in gameplay/audio/controls/
   camera/controller/mouse/reassign/misc/advanced); (3) a small by-SEMANTIC-option-type map for the
   value-LIST screens (cheats/music/binds/aspect) whose rows share a name — these still describe the
   SETTING, never the widget. Group headers and anything unmatched return 0 (no hint line drawn)."
  (cond
    ((nonzero? (-> row hint)) (-> row hint))
    (else
     (let ((nm (-> row name)))
       (cond
         ;; --- main-menu / quit-flow actions ---
         ((= nm (text-id new-game))          (text-id pc-text-hint-new-game))
         ((= nm (text-id load-game))         (text-id pc-text-hint-load))
         ((= nm (text-id save-game))         (text-id pc-text-hint-save))
         ((= nm (text-id options))           (text-id pc-text-hint-options))
         ((= nm (text-id secrets))           (text-id pc-text-hint-secrets))
         ((= nm (text-id quit-game))         (text-id pc-text-hint-quit))
         ((= nm (text-id back))              (text-id pc-text-hint-back))
         ((= nm (text-id pc-text-continue))  (text-id pc-text-hint-continue))
         ((= nm (text-id pc-text-return-title)) (text-id pc-text-hint-return-title))
         ((= nm (text-id pc-text-cancel))    (text-id pc-text-hint-cancel))
         ((= nm (text-id disable-auto-save)) (text-id pc-text-hint-disable-autosave))
         ((= nm (text-id checkpoint-select)) (text-id pc-text-hint-checkpoint))
         ;; --- graphics named rows (the placeholder-named value rows are hinted in build-graphics-unified!) ---
         ((= nm (text-id aspect-ratio))      (text-id pc-text-hint-aspect))
         ((= nm (text-id game-resolution))   (text-id pc-text-hint-resolution))
         ((= nm (text-id ps2-options))       (text-id pc-text-hint-advanced))
         ((= nm (text-id display-mode))      (text-id pc-text-hint-displaymode))
         ((= nm (text-id display))           (text-id pc-text-hint-monitor))
         ((= nm (text-id frame-rate))        (text-id pc-text-hint-framerate))
         ;; --- gameplay ---
         ((= nm (text-id play-hints))        (text-id pc-text-hint-playhints))
         ((= nm (text-id subtitles))         (text-id pc-text-hint-subtitles))
         ((= nm (text-id hinttitles))        (text-id pc-text-hint-hinttitles))
         ((= nm (text-id language))          (text-id pc-text-hint-spokenlang))
         ((= nm (text-id subtitles-language)) (text-id pc-text-hint-sublang))
         ((= nm (text-id text-language))     (text-id pc-text-hint-textlang))
         ((= nm (text-id subtitles-speaker)) (text-id pc-text-hint-speakername))
         ((= nm (text-id input-options))     (text-id pc-text-hint-opencontrols))
         ((= nm (text-id misc-options))      (text-id pc-text-hint-openmisc))
         ;; --- audio ---
         ((= nm (text-id sfx-volume))        (text-id pc-text-hint-sfx))
         ((= nm (text-id music-volume))      (text-id pc-text-hint-music))
         ((= nm (text-id speech-volume))     (text-id pc-text-hint-speech))
         ;; --- controls (top) ---
         ((= nm (text-id camera-options))    (text-id pc-text-hint-cameraopts))
         ((= nm (text-id input-opts-controller-opts)) (text-id pc-text-hint-controlleropts))
         ((= nm (text-id input-opts-enable-kb)) (text-id pc-text-hint-enablekb))
         ((= nm (text-id input-opts-enable-mouse)) (text-id pc-text-hint-enablemouse))
         ((= nm (text-id input-opts-mouse-opts)) (text-id pc-text-hint-mouseopts))
         ((= nm (text-id input-opts-auto-hide-cursor)) (text-id pc-text-hint-autohide))
         ((= nm (text-id input-opts-reassign-binds)) (text-id pc-text-hint-reassign))
         ((= nm (text-id restore-defaults))  (text-id pc-text-hint-restoredefaults))
         ;; --- camera invert (shared across the 4 axis rows) ---
         ((or (= nm (text-id camera-controls-first-horz))
              (= nm (text-id camera-controls-first-vert))
              (= nm (text-id camera-controls-third-horz))
              (= nm (text-id camera-controls-third-vert)))
          (text-id pc-text-hint-caminvert))
         ;; --- controller ---
         ((= nm (text-id input-opts-select-controller)) (text-id pc-text-hint-selectcontroller))
         ((= nm (text-id vibrations))        (text-id pc-text-hint-vibrations))
         ((= nm (text-id input-opts-analog-deadzone)) (text-id pc-text-hint-deadzone))
         ((= nm (text-id input-opts-analog-sensitivity)) (text-id pc-text-hint-sensitivity))
         ((= nm (text-id input-opts-ignore-controller-win-focus)) (text-id pc-text-hint-ignoreunfocused))
         ((= nm (text-id input-opts-controller-led-reflect-hp)) (text-id pc-text-hint-ledhp))
         ((= nm (text-id input-opts-controller-led-reflect-eco)) (text-id pc-text-hint-ledeco))
         ((= nm (text-id input-opts-controller-led-reflect-heat)) (text-id pc-text-hint-ledheat))
         ((= nm (text-id input-opts-controller-pressure-sensitivity)) (text-id pc-text-hint-pressure))
         ;; --- mouse ---
         ((= nm (text-id input-opts-mouse-enable-camera)) (text-id pc-text-hint-mousecam))
         ((= nm (text-id input-opts-mouse-horizontal-sens)) (text-id pc-text-hint-mousehsens))
         ((= nm (text-id input-opts-mouse-vertical-sens)) (text-id pc-text-hint-mousevsens))
         ((= nm (text-id input-opts-mouse-enable-movement)) (text-id pc-text-hint-mousemove))
         ;; --- reassign binds ---
         ((= nm (text-id input-opts-binds-controller)) (text-id pc-text-hint-bindscontroller))
         ((= nm (text-id input-opts-binds-keyboard)) (text-id pc-text-hint-bindskeyboard))
         ((= nm (text-id input-opts-binds-mouse)) (text-id pc-text-hint-bindsmouse))
         ;; --- misc ---
         ((= nm (text-id money-starburst))   (text-id pc-text-hint-moneystarburst))
         ((= nm (text-id discord-rpc))       (text-id pc-text-hint-discord))
         ((= nm (text-id cutscene-skips))    (text-id pc-text-hint-cutsceneskips))
         ((= nm (text-id speedrunner-mode))  (text-id pc-text-hint-speedrunnermode))
         ;; --- advanced (legacy PS2 gfx) ---
         ((= nm (text-id lod-bg))            (text-id pc-text-hint-lodbg))
         ((= nm (text-id lod-fg))            (text-id pc-text-hint-lodfg))
         ((= nm (text-id ps2-parts))         (text-id pc-text-hint-ps2parts))
         ((= nm (text-id force-envmap))      (text-id pc-text-hint-forceenvmap))
         ((= nm (text-id force-actors))      (text-id pc-text-hint-forceactors))
         (else
          ;; tier 3: value-LIST screens whose rows share one name — keyed by SEMANTIC option-type
          ;; (still names the setting, never the control widget). group-header => 0 (never focused).
          (case (-> row option-type)
            (((game-option-type group-header)) (the text-id 0))
            (((game-option-type cheat-toggle)) (text-id pc-text-hint-cheat))
            (((game-option-type button-music)) (text-id pc-text-hint-playmusic))
            (((game-option-type button-flava)) (text-id pc-text-hint-playflava))
            (((game-option-type binding-assignment)) (text-id pc-text-hint-rebind))
            (((game-option-type aspect-ratio)
              (game-option-type aspect-new)
              (game-option-type aspect-native))
             (text-id pc-text-hint-aspectchoice))
            (else (the text-id 0)))))))))

(defun menu-hint-coverage ()
  "Grecharged V3 proof: per-screen count of SELECTABLE rows vs rows that resolve a BESPOKE hint, over
   the SETTINGS screens (the option/réglage pages the owner navigates — NOT the value-LIST screens like
   the cheats/music/checkpoint pick-lists). Prints one line per screen + a total; returns #t iff every
   selectable settings row has a hint (100%). Run after init-game-options via the listener to capture the
   with-hint/total counter for the report. Every row here resolves via menu-resolve-hint's explicit or
   by-name tiers — the generic by-control-type fallback is gone, so a 0 here means a genuinely unhinted
   row (a real coverage hole), never a widget-type placeholder."
  (let ((total-sel 0) (total-hit 0) (screens 0) (all-ok #t))
    (dotimes (s (-> *options-remap* allocated-length))
      (when (case s
              ;; the SETTINGS screens (options that need explaining)
              (((progress-screen settings-title)      ;; the OPTIONS hub (5 categories)
                (progress-screen game-settings)
                (progress-screen graphic-settings)    ;; the unified GRAPHISMES page (*graphics-unified-pc*)
                (progress-screen sound-settings)
                (progress-screen input-options)
                (progress-screen camera-options)
                (progress-screen controller-options)
                (progress-screen mouse-options)
                (progress-screen reassign-binds-options)
                (progress-screen misc-options)
                (progress-screen gfx-ps2-options)
                (progress-screen aspect-ratio)
                (progress-screen debug-options)) #t)
              (else #f))
        (let ((arr (-> *options-remap* s)))
          ;; GOAL "0 is truthy": unset remap slots are either null (static 0) or the symbol #f — guard BOTH
          ;; before calling (length arr), which would otherwise deref null/#f and crash.
          (when (and (!= (the-as int arr) 0) (!= arr #f) (> (length arr) 0))
            (let ((sel 0) (hit 0))
              (dotimes (i (length arr))
                (let ((row (-> arr i)))
                  (when (!= (-> row option-type) (game-option-type group-header))
                    (+! sel 1)
                    (when (nonzero? (menu-resolve-hint row)) (+! hit 1)))))
              (when (> sel 0)
                (+! screens 1)
                (+! total-sel sel)
                (+! total-hit hit)
                (when (!= hit sel) (set! all-ok #f))
                (format 0 "[Gmenu] screen ~D: ~D/~D rows with hint~%" s hit sel)))))))
    (format 0 "[Gmenu] TOTAL: ~D/~D selectable settings rows have a bespoke hint across ~D screens (100%: ~A)~%"
            total-hit total-sel screens all-ok)
    all-ok))

(defun menu-holo-stats ()
  "Grecharged V2 proof: print the per-frame render-thread counters (holo frame draws, projector spawn/
   despawn, drone/beam draws, last drone transform). Read via the listener while the menu is open."
  (format 0 "[Gmenu] holo-draws=~D projector active=~A spawn=~D despawn=~D drone-draws=~D beam-draws=~D~%"
          *menu-holo-draw-count* *menu-projector-active?* *menu-projector-spawn-count*
          *menu-projector-despawn-count* *menu-projector-draw-count* *menu-beam-draw-count*)
  (format 0 "[Gmenu] last drone x=~f y=~f face=~f angle=~f~%"
          *menu-projector-ox* *menu-projector-oy* *menu-projector-face* *menu-projector-angle*)
  ;; V3-B: the holo animation values — call twice across frames to see them CHANGE (scanline scrolls,
  ;; flicker jitters). Proof the hologram is ANIMATED per-frame, not a static box.
  (format 0 "[Gmenu] holo scan-offset=~D flicker-alpha=~D (both advance/jitter every frame)~%"
          *menu-holo-scan-offset* *menu-holo-flicker*)
  (none))

(defun progress-fast-save-and-start-speedrun ((category speedrun-category))
  "saves to first slot, updates last-slot-saved for cursor, then starts speedrun"
  (set! (-> *progress-state* last-slot-saved) 0)
  (auto-save-command 'save 0 0 *default-pool*)
  (start-speedrun category))

;; used in title logo
(define *quit-to-title* #f)

;; ############################
;; Gtouch-menus: TOUCH-BROWSABLE MENUS  (owner 2026-07-02)
;; ############################
;; On Android the menus must be fully navigable by TAP (no d-pad needed): a tap
;; on a menu row focuses + activates it (enter a submenu / toggle / cycle a
;; carousel); a tap outside the list goes back. Purely ADDITIVE — the d-pad +
;; gamepad path is untouched, and the ENGINE menu source is untouched (all logic
;; lives here in pc/).
;;
;; Data flow: the android overlay (TouchOverlayView) forwards a NORMALIZED [0..1]
;; tap to C (NativeGk.onMenuTap); pc-get-touch-tap hands GOAL the tap + a "fresh"
;; flag. draw-options republishes each visible row's normalized on-screen rect
;; every frame (it already computes each row's font origin), and respond-common
;; hit-tests the tap to a row, then reproduces the EXACT d-pad interaction for
;; that row's type via a short synthetic-press sequence — so all existing
;; enter/toggle/cycle/commit logic is reused verbatim.
(define-extern pc-get-touch-tap (function (pointer int64) (pointer int64) (pointer int64) none))

;; Grecharged-mesh-browser: forward decl so the Recharged Settings "MESH BROWSER" button can open the
;; overlay (defined later in pc/mesh-browser-pc.gc). Plain function (not a method) to avoid needing
;; the mesh-browser type here.
(define-extern mesh-browser-open! (function none))

(defconstant MENU_TOUCH_MAX_ROWS 12)   ;; >= PROGRESS_PC_PAGE_HEIGHT (+ scroll extra)

;; synthetic-press sequence tokens
(defconstant MT_TOK_NONE       0)
(defconstant MT_TOK_CONFIRM    1)  ;; x / circle
(defconstant MT_TOK_LEFT       2)  ;; d-pad left, "pressed" edge (cycle prev)
(defconstant MT_TOK_RIGHT      3)  ;; d-pad right, "pressed" edge (cycle next)
(defconstant MT_TOK_BACK       4)  ;; square / triangle
(defconstant MT_TOK_HOLD_LEFT  5)  ;; d-pad left, "held" (slider step)
(defconstant MT_TOK_HOLD_RIGHT 6)  ;; d-pad right, "held" (slider step)
(defconstant MT_TOK_UP         7)  ;; d-pad up (Gtouch-fix: tap-scroll long lists)
(defconstant MT_TOK_DOWN       8)  ;; d-pad down (Gtouch-fix: tap-scroll long lists)

;; Virtual->screen calibration (CONFIRMED ON-DEVICE eae4df44, 2026-07-02).
;; A menu row's NORMALIZED [0..1] on-screen center maps LINEARLY from the font
;; origin the row is drawn at:
;;   cy = MENU_TOUCH_Y_A * oy + MENU_TOUCH_Y_B
;;   cx = MENU_TOUCH_X_A * (ox + 185)             ;; +185 = half of the 370-wide row box (centered text)
;; Measured: title-menu rows at oy=40..165 (step 25) land at screen fractions
;; 0.19..0.79 (step ~0.12) -> slope 0.00478, offset ~0. The font SCALE does NOT
;; affect row position (only glyph size), so there is no fscale term. Since every
;; draw-options row uses option-x=17 + a `middle` (horizontal-center) flag, cx is
;; ~0.50 for all rows: the name is left of center, the value/arrows are right of
;; center, so a tap's left/right half selects decrement/increment.
(defconstant MENU_TOUCH_Y_A 0.00478)
(defconstant MENU_TOUCH_Y_B 0.0)
(defconstant MENU_TOUCH_X_A 0.002475)

(deftype menu-touch-row (structure)
  ((abs-index int16)
   (oy        float)    ;; raw font origin y (for calibration logging)
   (cx        float)    ;; normalized screen x of row center
   (cy        float)    ;; normalized screen y of row center
   (half-h    float)))  ;; normalized half-height (row selection band)

(deftype menu-touch-state (basic)
  ((n-rows      int32)
   (screen      progress-screen)
   (rows        menu-touch-row MENU_TOUCH_MAX_ROWS :inline)
   (tap-x       int64)   ;; scratch out-params for pc-get-touch-tap
   (tap-y       int64)
   (tap-f       int64)
   (seq         uint8 8) ;; synthetic-press token queue
   (seq-len     int32)
   (seq-pos     int32)
   (seq-screen  progress-screen) ;; screen the queue was built for (Gtouch-fix: stale guard)
   (confirm?    symbol)  ;; per-frame synthetic-press flags (respond-common ORs these in)
   (back?       symbol)
   (left?       symbol)
   (right?      symbol)
   (hold-left?  symbol)
   (hold-right? symbol)
   (up?         symbol)  ;; Gtouch-fix: tap-scroll of long option lists
   (down?       symbol)))

(define *menu-touch* (new 'static 'menu-touch-state :screen (progress-screen invalid)))

(defun menu-touch-record! ((abs-index int) (ox float) (oy float) (fscale float))
  "Gtouch-menus: publish one visible menu row's NORMALIZED on-screen rect so a
   tap can be hit-tested to it. Called once per DRAWN row from draw-options."
  (let ((n (-> *menu-touch* n-rows)))
    (when (< n MENU_TOUCH_MAX_ROWS)
      (let ((row (-> *menu-touch* rows n)))
        (set! (-> row abs-index) abs-index)
        (set! (-> row oy) oy)
        (set! (-> row cx) (* MENU_TOUCH_X_A (+ ox 185.0)))
        (set! (-> row cy) (+ (* MENU_TOUCH_Y_A oy) MENU_TOUCH_Y_B))
        (set! (-> row half-h) (* MENU_TOUCH_Y_A 12.5))
        (set! (-> *menu-touch* n-rows) (+ n 1)))))
  (none))

(defun menu-touch-push-seq! ((tok int))
  "Gtouch-menus: append one token to the synthetic-press queue."
  (when (< (-> *menu-touch* seq-len) 8)
    (set! (-> *menu-touch* seq (-> *menu-touch* seq-len)) tok)
    (1+! (-> *menu-touch* seq-len)))
  (none))

(defun menu-touch-set-seq-1! ((tok int))
  "Gtouch-menus: reset the queue to a single token."
  (set! (-> *menu-touch* seq-len) 0)
  (set! (-> *menu-touch* seq-pos) 0)
  (menu-touch-push-seq! tok)
  (none))

(defun menu-touch-emit! ((tok int))
  "Gtouch-menus: raise THIS frame's synthetic-press flag for one queue token."
  (cond
    ((= tok MT_TOK_CONFIRM)    (set! (-> *menu-touch* confirm?) #t))
    ((= tok MT_TOK_LEFT)       (set! (-> *menu-touch* left?) #t))
    ((= tok MT_TOK_RIGHT)      (set! (-> *menu-touch* right?) #t))
    ((= tok MT_TOK_BACK)       (set! (-> *menu-touch* back?) #t))
    ((= tok MT_TOK_HOLD_LEFT)  (set! (-> *menu-touch* hold-left?) #t))
    ((= tok MT_TOK_HOLD_RIGHT) (set! (-> *menu-touch* hold-right?) #t))
    ((= tok MT_TOK_UP)         (set! (-> *menu-touch* up?) #t))
    ((= tok MT_TOK_DOWN)       (set! (-> *menu-touch* down?) #t)))
  (none))

(defun menu-touch-build-seq! ((obj progress) (idx int) (left? symbol))
  "Gtouch-menus/Gtouch-fix: fill the queue with the synthetic d-pad presses that
   reproduce a tap on option `idx`. `left?` = tapped left of the row center
   (step down / cycle prev / YES), else right (step up / next / NO). Reuses the
   row's real behavior by replaying the same enter/change/commit presses a d-pad
   user would make. Two-state toggles FLIP from their CURRENT value (a d-pad
   LEFT always means ON and RIGHT always means OFF, so a positional choice made
   half the taps no-ops — the owner's 'toggles not clickable')."
  (set! (-> *menu-touch* seq-len) 0)
  (set! (-> *menu-touch* seq-pos) 0)
  (let* ((options (-> *options-remap* (-> obj display-state)))
         (typ (-> options idx option-type))
         (dir (if left? MT_TOK_LEFT MT_TOK_RIGHT))
         (hdir (if left? MT_TOK_HOLD_LEFT MT_TOK_HOLD_RIGHT)))
    (cond
      ;; disabled row: a tap does nothing (mirrors the confirm early-out)
      ((and (nonzero? (-> options idx option-disabled-func))
            (!= (-> options idx option-disabled-func) #f)
            ((-> options idx option-disabled-func)))
       (set! (-> *menu-touch* seq-len) 0))
      ;; menus / buttons / action rows: a single confirm enters/activates
      ((or (= typ (game-option-type menu))
           (= typ (game-option-type button))
           (= typ (game-option-type button-music))
           (= typ (game-option-type button-flava))
           (= typ (game-option-type resolution))
           (= typ (game-option-type controller))
           (= typ (game-option-type monitor))
           (= typ (game-option-type aspect-new))
           (= typ (game-option-type binding-assignment)))
       (menu-touch-push-seq! MT_TOK_CONFIRM))
      ;; yes-no dialog row: pick YES (left half) / NO (right half), then confirm
      ;; so one tap both chooses AND activates (respond-memcard consumes the
      ;; confirm; before Gtouch-fix a tap only set the choice).
      ((= typ (game-option-type yes-no))
       (menu-touch-push-seq! dir)
       (menu-touch-push-seq! MT_TOK_CONFIRM))
      ;; on-off style toggles: one tap = FLIP. In respond-common LEFT sets the
      ;; value to #t/ON and RIGHT to #f/OFF, so derive the direction from the
      ;; CURRENT value instead of the tapped half.
      ((or (= typ (game-option-type on-off))
           (= typ (game-option-type normal-inverted))
           (= typ (game-option-type aspect-native)))
       (let ((flip-dir (if (and (nonzero? (-> options idx value-to-modify))
                                (-> (the-as (pointer symbol) (-> options idx value-to-modify))))
                         MT_TOK_RIGHT   ;; currently ON  -> set OFF
                         MT_TOK_LEFT))) ;; currently OFF -> set ON
         (menu-touch-push-seq! MT_TOK_CONFIRM)
         (menu-touch-push-seq! flip-dir)
         (menu-touch-push-seq! MT_TOK_CONFIRM)))
      ;; two-state aspect-ratio (4x3 <-> 16x9): same flip idea (LEFT=4x3, RIGHT=16x9)
      ((= typ (game-option-type aspect-ratio))
       (let ((flip-dir (if (and (nonzero? (-> options idx value-to-modify))
                                (= (-> (the-as (pointer symbol) (-> options idx value-to-modify))) 'aspect4x3))
                         MT_TOK_RIGHT   ;; currently 4x3 -> 16x9
                         MT_TOK_LEFT))) ;; currently 16x9 -> 4x3
         (menu-touch-push-seq! MT_TOK_CONFIRM)
         (menu-touch-push-seq! flip-dir)
         (menu-touch-push-seq! MT_TOK_CONFIRM)))
      ;; cheat toggles read their live state from the cheats bitfield
      ((= typ (game-option-type cheat-toggle))
       (let ((flip-dir (if (logtest? (-> *pc-settings* cheats) (ash 1 (the int (-> options idx param1))))
                         MT_TOK_RIGHT
                         MT_TOK_LEFT)))
         (menu-touch-push-seq! MT_TOK_CONFIRM)
         (menu-touch-push-seq! flip-dir)
         (menu-touch-push-seq! MT_TOK_CONFIRM)))
      ;; sliders: enter edit, ONE step by tapped half, commit. Repeated taps
      ;; keep stepping (one slider-step-size per tap).
      ((= typ (game-option-type slider))
       (menu-touch-push-seq! MT_TOK_CONFIRM)
       (menu-touch-push-seq! hdir)
       (menu-touch-push-seq! MT_TOK_CONFIRM))
      ;; everything else (carousels, language, confirmation, ...): enter edit,
      ;; cycle by tapped half, commit
      (else
       (menu-touch-push-seq! MT_TOK_CONFIRM)
       (menu-touch-push-seq! dir)
       (menu-touch-push-seq! MT_TOK_CONFIRM))))
  (none))

(defun menu-touch-poll! ((obj progress))
  "Gtouch-menus: read the newest tap; if new, hit-test it (nearest row by vertical
   center within the row band) and build the synthetic-press sequence for it, or
   go back if the tap was clearly outside the row list. No-op on desktop (the
   pc-get-touch-tap stub always reports flag=0)."
  (pc-get-touch-tap (&-> *menu-touch* tap-x) (&-> *menu-touch* tap-y) (&-> *menu-touch* tap-f))
  (when (and (nonzero? (-> *menu-touch* tap-f))
             (> (-> *menu-touch* n-rows) 0)
             (= (-> *menu-touch* screen) (-> obj display-state)))
    (let ((fx (/ (the float (-> *menu-touch* tap-x)) 10000.0))
          (fy (/ (the float (-> *menu-touch* tap-y)) 10000.0))
          (best -1)
          (best-d 999999.0)
          (best-band 0.05)
          (min-cy 999999.0)
          (max-cy -999999.0))
      ;; nearest row by vertical center (+ list extent for the scroll zones)
      (dotimes (i (-> *menu-touch* n-rows))
        (let* ((row (-> *menu-touch* rows i))
               (dy (fabs (- fy (-> row cy)))))
          (when (< (-> row cy) min-cy) (set! min-cy (-> row cy)))
          (when (> (-> row cy) max-cy) (set! max-cy (-> row cy)))
          (when (< dy best-d)
            (set! best-d dy)
            (set! best i)
            (set! best-band (-> row half-h)))))
      ;; concise per-tap diagnostic (one line, only when a tap lands on a menu)
      (format 0 "Gtm-tap fx=~f fy=~f n=~D best=~D d=~f~%"
              fx fy (-> *menu-touch* n-rows) best best-d)
      (cond
        ;; Gtouch-fix: on a SCROLLABLE list (more rows than the page shows), a tap
        ;; beyond the first/last visible row (by at least half a row) scrolls
        ;; instead of going back — rows past the fold (V-Sync/MSAA/Advanced/Back
        ;; on Graphic Options) were unreachable by touch. These zones must be
        ;; checked BEFORE the row hit-test: its 3x-band acceptance reaches ~1.8
        ;; row-pitches past the last row center, which swallowed the whole
        ;; below-list zone (a tap meant to scroll flipped the LAST row instead).
        ;; Back stays available via the Back row and on every non-scrollable
        ;; screen via tap-outside.
        ((and (> (length (-> *options-remap* (-> obj display-state))) PROGRESS_PC_PAGE_HEIGHT)
              (> fy (+ max-cy (* MENU_TOUCH_Y_A 12.5))))
         (format 0 "Gtm-tap scroll-down~%")
         (menu-touch-set-seq-1! MT_TOK_DOWN))
        ((and (> (length (-> *options-remap* (-> obj display-state))) PROGRESS_PC_PAGE_HEIGHT)
              (< fy (- min-cy (* MENU_TOUCH_Y_A 12.5))))
         (format 0 "Gtm-tap scroll-up~%")
         (menu-touch-set-seq-1! MT_TOK_UP))
        ((and (>= best 0) (< best-d (* 3.0 best-band)))
         ;; tap landed on (or near) a row -> focus it + reproduce its interaction
         (let* ((row (-> *menu-touch* rows best))
                (idx (the int (-> row abs-index)))
                (left? (< fx (-> row cx))))
           (set! (-> obj option-index) idx)
           (set! (-> obj last-option-index-change) (-> *display* real-frame-counter))
           (menu-touch-build-seq! obj idx left?)))
        (else
         ;; tapped clearly outside the row list -> go back
         (menu-touch-set-seq-1! MT_TOK_BACK)))
      ;; Gtouch-fix: remember which screen this sequence drives so a mid-sequence
      ;; screen change (submenu enter/exit) kills the leftover tokens instead of
      ;; replaying them as phantom presses on the new screen.
      (set! (-> *menu-touch* seq-screen) (-> obj display-state))
      ;; emit the first token of the freshly-built sequence THIS frame
      (when (> (-> *menu-touch* seq-len) 0)
        (menu-touch-emit! (the int (-> *menu-touch* seq 0)))
        (set! (-> *menu-touch* seq-pos) 1))))
  (none))

(defun menu-touch-drive! ((obj progress))
  "Gtouch-menus: per-frame touch driver. Clears this frame's synthetic-press
   flags, then either advances an in-flight press sequence or polls for a new
   tap. Called at the top of respond-common; its flags are ORed into the d-pad
   input guards so touch is additive."
  (set! (-> *menu-touch* confirm?) #f)
  (set! (-> *menu-touch* back?) #f)
  (set! (-> *menu-touch* left?) #f)
  (set! (-> *menu-touch* right?) #f)
  (set! (-> *menu-touch* hold-left?) #f)
  (set! (-> *menu-touch* hold-right?) #f)
  (set! (-> *menu-touch* up?) #f)
  (set! (-> *menu-touch* down?) #f)
  ;; Gtouch-fix: a screen change invalidates any in-flight sequence (its tokens
  ;; were built for the previous screen's focused row)
  (when (and (< (-> *menu-touch* seq-pos) (-> *menu-touch* seq-len))
             (!= (-> *menu-touch* seq-screen) (-> obj display-state)))
    (set! (-> *menu-touch* seq-len) 0)
    (set! (-> *menu-touch* seq-pos) 0))
  (cond
    ((< (-> *menu-touch* seq-pos) (-> *menu-touch* seq-len))
     ;; advance an in-flight synthetic sequence
     (menu-touch-emit! (the int (-> *menu-touch* seq (-> *menu-touch* seq-pos))))
     (1+! (-> *menu-touch* seq-pos)))
    (else
     ;; no sequence running -> poll for a fresh tap
     (menu-touch-poll! obj)))
  (none))

;; ############################
;; CAROUSELL STUFF
;; ############################

(deftype progress-carousell-state (structure)
  ((int-backup           int)
   (symbol-backup        symbol)
   (subtitle-backup      pc-language)
   (aspect-native-choice symbol)
   (current-carousell    (array text-id))
   (selection            int)
   (direction            symbol)
   (transition           symbol)
   (x-offset             int32)))

(define *progress-carousell* (new 'static 'progress-carousell-state))

(defmacro def-progress-carousell (name texts)
  `(define ,name (new 'static 'boxed-array :type text-id ,@(apply (lambda (x) `(text-id ,x)) texts))))

;; all carousells
(def-progress-carousell *carousell-display-mode* (windowed fullscreen borderless))

(def-progress-carousell *carousell-msaa* (off 2-times 4-times 8-times 16-times))

(def-progress-carousell *carousell-lod-bg* (lod-high lod-low))

(def-progress-carousell *carousell-lod-fg* (lod-high lod-low lod-ps2))

(def-progress-carousell *carousell-speaker* (speaker-always speaker-never speaker-auto))

(def-progress-carousell *carousell-frame-rate-150fps* (60fps 100fps 150fps))

(def-progress-carousell *carousell-frame-rate-100fps* (60fps 100fps))

(define *carousell-frame-rate* *carousell-frame-rate-150fps*)

;; Grecharged-ambient-occlusion: the AO mode carousell (Off/SSAO/HBAO/GTAO) and the AO quality carousell
;; (Low/Medium/High). The value strings live in game_custom_text_*.json (ids #x1708-#x170d) with matching
;; pc-text-* enum entries in text-h.gc (static arrays need compile-time text-id constants).
(def-progress-carousell *carousell-ambient-occlusion* (off pc-text-ssao pc-text-hbao pc-text-gtao))
(def-progress-carousell *carousell-ao-quality* (pc-text-ao-low pc-text-ao-medium pc-text-ao-high))
;; Grecharged-ambient-occlusion closing round: the AO strength carousell (Weaker/Default/Stronger),
;; a per-mode multiplier on the estimator intensity (ids #x1710-#x1712 + row label #x1713).
(def-progress-carousell *carousell-ao-strength* (pc-text-ao-weaker pc-text-ao-default pc-text-ao-stronger))
;; Grecharged-realtime-lighting: SHADOW QUALITY carousell (Low/Med/High = 1024/2048/4096 shadow-map res).
;; Reuses the AO low/med/high text-ids (they render LOW/MEDIUM/HIGH, which fits Shadow Quality).
(def-progress-carousell *carousell-shadow-quality* (pc-text-ao-very-low pc-text-ao-low pc-text-ao-medium pc-text-ao-high pc-text-ao-very-high))
;; Grecharged-directional-ambient ROUND 2: AMBIENT MODEL carousell (Hemisphere / SH / IBL).
(def-progress-carousell *carousell-rt-ambient-model* (pc-text-model-hemisphere pc-text-model-sh pc-text-model-ibl))
;; Gpbr-fusion REOPEN #3: DISPLACEMENT carousell (Off / Parallax / Tessellation). Off reuses the
;; generic off text-id like *carousell-ambient-occlusion*; Parallax/Tessellation are new ids.
(def-progress-carousell *carousell-pbr-displacement* (off pc-text-parallax pc-text-tessellation))
;; Grecharged-pbr-realtime-fusion: ENV PROBE (DYNAMIC FOLLOW-PROBE tier) carousell (Off / Low / Mid / High).
;; Off reuses the generic off text-id like *carousell-pbr-displacement*; Low/Mid/High are new ids.
(def-progress-carousell *carousell-follow-probe* (off pc-text-envprobe-low pc-text-envprobe-mid pc-text-envprobe-high))
;; Gpbr-fusion REOPEN #3 (DEBUG, removable later): PBR TEST PRESET carousell — one-click intended-config
;; presets. On confirm the write-back arm applies the whole config (booleans + sliders + carousells).
(def-progress-carousell *carousell-pbr-test-preset* (pc-text-preset-allin pc-text-preset-fused pc-text-preset-fused-flat pc-text-preset-pbr-only pc-text-preset-rt-only pc-text-preset-stock))
;; Gpbr-fusion REOPEN #10 (DEBUG, removable later): PBR ISOLATE carousell — in-menu term bisection so the
;; owner isolates the residual grass-facet source at his OWN vantage with no adb. Index -> u_pbr_bisect mask
;; in pc_set_pbr_isolate: BOTH 0, NORMAL-MAP ONLY 128 (POM off), PARALLAX ONLY 64 (normal-map off), NEITHER 192.
(def-progress-carousell *carousell-pbr-isolate* (pc-text-pbr-iso-both pc-text-pbr-iso-nm pc-text-pbr-iso-pom pc-text-pbr-iso-neither))

;; pad remap stuff
(define *progress-pad-timeout* (the-as time-frame 0)) ;; timeout for remap buttons

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  MENU OPTIONS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Gdynamic-renderscale: forward declaration so the menu :on-change lambdas below can
;; call the helper, which is defined later in this file.
(define-extern apply-dynamic-rs-menu-mode! (function none))

(define *main-options-pc*
  (new 'static
       'boxed-array
       :type
       game-option
       ;; Grecharged-menu-overhaul: the three scattered Game/Graphics/Sound entries are unified into a
       ;; single OPTIONS entry opening the 5-category hub (the same hub the title screen reaches).
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id options)
            :scale #t
            :param3 (game-option-menu settings-title))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id load-game)
            :scale #t
            :param3 (game-option-menu load-game))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id save-game)
            :scale #t
            :param3 (game-option-menu save-game))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id disable-auto-save)
            :scale #t
            :param3 (game-option-menu memcard-disable-auto-save))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id quit-game)
            :scale #t
            :param3 (game-option-menu quit))
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t)))

