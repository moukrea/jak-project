;; Grecharged-menu-overhaul: any save present? and which slot is the most recent (for 1-click Continue).
;; Composed from mc-get-slot-info + the per-slot `present` flag and date fields (there is no built-in
;; "newest" helper). Returns the slot index 0..3 of the newest present save, or -1 if none exists.
(defun progress-newest-save-slot ()
  (let ((info *progress-save-info*)
        (best -1)
        (best-key -1))
    (mc-get-slot-info 0 info)
    (dotimes (s 4)
      (when (nonzero? (-> info file s present))
        ;; comparable timestamp: (((year*12+month)*31+day)*24+hour)*60+minute (fields are uint8 -> int)
        (let ((k (+ (* (+ (* (+ (* (+ (* (the int (-> info file s year)) 12) (the int (-> info file s month))) 31)
                                 (the int (-> info file s day))) 24)
                          (the int (-> info file s hour))) 60)
                    (the int (-> info file s minute)))))
          (when (> k best-key)
            (set! best-key k)
            (set! best s)))))
    best))

(defun any-save-present? ()
  (>= (progress-newest-save-slot) 0))

;; ---------------- Grecharged-menu-overhaul: the unified OPTIONS hub ----------------
;; Runtime visibility of the DEBUG category, seeded ONCE from the compile-time FLAG_DEBUG_MENUS
;; (build.sh --debug). The DEBUG page and its rows are compiled into EVERY build (hidden, NOT removed);
;; this symbol conditions ONLY whether the hub shows the DEBUG category row. Final/release builds omit
;; --debug so it stays #f; test/checker builds pass --debug so it becomes #t.
(define *debug-menus-visible?* (#if FLAG_DEBUG_MENUS #t #f))

;; The DEBUG category page (developer/debug tooling; hidden in final builds). Holds the Mesh Browser
;; launcher (freecam / gizmos / checker-damier / mark tools) and the PBR test-preset & isolate carousells
;; (MOVED here out of the graphics zone — they are focus tools, not player-facing rendering options).
;; The preset/isolate rows are FRESH carousells wired in init-game-options (value = int-backup scratch,
;; write-back mapped 1:1 by option-type in respond-common, exactly like their old recharged-menu twins).
(define-options-array *opt-debug*
       game-option
       ;; Freecam / Mesh Browser launcher (the checker/damier + gizmos toggles live inside the overlay).
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id pc-text-mesh-browser) :scale #t
            :hint (text-id pc-text-hint-debug))
       ;; PBR TEST PRESET carousell (one-click intended-config presets). ALWAYS enabled — the STOCK preset
       ;; turns recharged-master? off, so this row must stay usable to switch back.
       (flag-row FLAG_PBR
       (new 'static 'game-option :option-type (game-option-type pbr-test-preset) :name (text-id msaa) :scale #t
            :hint (text-id pc-text-hint-pbrpreset)))
       ;; PBR ISOLATE carousell (in-menu term bisection). Disabled unless master + PBR materials are on.
       (flag-row FLAG_PBR
       (new 'static 'game-option :option-type (game-option-type pbr-isolate) :name (text-id msaa) :scale #t
            :hint (text-id pc-text-hint-pbrisolate)
            :option-disabled-func
            (lambda ()
              (or (not (-> *pc-settings* recharged-master?)) (not (-> *pc-settings* pbr-materials?))))))
       ;; Back
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t))

;; The 5-category OPTIONS hub (RECADRAGE owner 2026-08-01), reached from BOTH the title "Options" and the
;; pause "Options". Each row opens a category page. DEBUG is conditional (see init-game-options). Organized
;; BY FUNCTION, not by origin: the old "AFFICHAGE" (vanilla display) + "RENDU" (recharged) categories are
;; FUSED into ONE unified GRAPHISMES page (pc-text-cat-display, relabelled "GRAPHISMES") — the separate
;; Recharged/Rendering category NO LONGER EXISTS. Every row carries a contextual hint.
(define *options-hub*
  (new 'static
       'boxed-array
       :type
       game-option
       (new 'static 'game-option :option-type (game-option-type menu) :name (text-id pc-text-cat-gameplay) :scale #t
            :param3 (game-option-menu game-settings) :hint (text-id pc-text-hint-gameplay))
       ;; GRAPHISMES — the single unified graphics zone (label pc-text-cat-display now reads "GRAPHISMES").
       (new 'static 'game-option :option-type (game-option-type menu) :name (text-id pc-text-cat-display) :scale #t
            :param3 (game-option-menu graphic-settings) :hint (text-id pc-text-hint-display))
       (new 'static 'game-option :option-type (game-option-type menu) :name (text-id pc-text-cat-audio) :scale #t
            :param3 (game-option-menu sound-settings) :hint (text-id pc-text-hint-audio))
       (new 'static 'game-option :option-type (game-option-type menu) :name (text-id pc-text-cat-controls) :scale #t
            :param3 (game-option-menu input-options) :hint (text-id pc-text-hint-controls))
       (new 'static 'game-option :option-type (game-option-type menu) :name (text-id pc-text-cat-debug) :scale #t
            :param3 (game-option-menu debug-options) :hint (text-id pc-text-hint-debug))
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t)))

;; cached row objects so init-game-options can hide/restore the DEBUG row idempotently (length-mutation
;; pattern like graphic-options-set-mtf-visible!). After dropping the RENDU row: DEBUG is index 4, Back index 5.
(define *hub-debug-row* (-> *options-hub* 4))
(define *hub-back-row* (-> *options-hub* 5))

