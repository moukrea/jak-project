;; Glang-mixed: re-format the name-override label buffers from the loaded text bank so
;; they follow (-> *pc-settings* text-language). Runs on every menu open (init-game-options
;; re-canonicalizes there) and again right after a text-language change reloads the bank
;; (same-menu-session navigation must not read stale heap pointers — hence buffers + copy,
;; never bank pointers). A #f lookup (id absent AND fallback disabled) leaves the buffer as-is.
;; ─── Grecharged-settings-case-l10n — LA TABLE UNIQUE DES LIBELLES DU MENU RECHARGED ─────────
;; L'owner, 2026-09-04 : « tous les elements sont en majuscule dans les reglages rechargees, et
;; pas tous sont localises correctement. » 2026-09-05 : « Traduire celles qui restent en anglais
;; dans toutes les langues supportees par le jeu ! »
;;
;; LA CAUSE, MESUREE. `refresh-runtime-option-labels!` ne re-formatait que ONZE tampons depuis le
;; banc de texte. Des QUARANTE libelles des deux ecrans Recharged, vingt-neuf etaient des
;; litteraux anglais MAJUSCULES qu'aucun banc ne touchait jamais : ils ne pouvaient etre ni mis
;; en casse normale ni traduits, dans aucune langue. Les onze autres n'existaient que dans deux
;; bancs sur vingt-trois (en-US, fr-FR), donc les vingt et une autres langues retombaient sur
;; l'anglais (`lookup-text-impl!`, engine/ui/text.gc:73-111).
;;
;; LE REMEDE EST UNE TABLE, PAS UNE LISTE D'APPELS. Un identifiant de banc et son tampon sont
;; declares UNE fois ici. `refresh-runtime-option-labels!` la parcourt pour remplir les tampons ;
;; le recensement de la porte (`scl10n-census!`) la parcourt pour retrouver l'identifiant qui
;; alimente un `name-override`. Deux lecteurs, UN ecrivain : la derive entre « ce qui est
;; dessine » et « ce qui est mesure » n'a plus de deuxieme endroit ou naitre.
;;
;; Les valeurs des carrousels HD LOOK y sont aussi. Leurs identifiants #x17b0-#x17b6 / #x17bc
;; etaient des TAGS reserves que `carousell-option-string` resolvait vers un global anglais, pour
;; survivre a un banc Android perime. Ils restent des tags — meme resolution, meme immunite — mais
;; le tampon derriere est desormais rempli depuis le banc a cet identifiant-la : la robustesse est
;; conservee (le defaut anglais tient tant que le banc n'a rien) ET la traduction devient possible.
;; TAILLE DES TAMPONS : 128, pas 64. Un accent n'est pas un octet dans l'encodage de la police
;; jak1, c'est un GROUPE de composition `~Y~-14H~-1V<glyphe>~Z` de quatorze octets. Mesure du
;; 2026-09-05 sur les 23 bancs construits : le plus long libelle traduit fait 84 octets encodes
;; (`0x1728` en cs-CZ, « Prohlizec sit »), 83 en lt-LT et hu-HU. Les tampons de 64 debordaient.
(define *scl10n-label-ids* (new 'static 'boxed-array :type int32 :length 48))
(define *scl10n-label-bufs* (new 'static 'boxed-array :type string :length 48))
(define *scl10n-label-count* 0)
(define *scl10n-registered?* #f)

(defun scl10n-add-label! ((id int) (buf string))
  "Une entree de la table. Ignoree si la table est pleine : mieux vaut un recensement qui rapporte
   moins qu'une ecriture hors du tableau."
  (when (and buf (< *scl10n-label-count* 48))
    (set! (-> *scl10n-label-ids* *scl10n-label-count*) id)
    (set! (-> *scl10n-label-bufs* *scl10n-label-count*) buf)
    (set! *scl10n-label-count* (+ *scl10n-label-count* 1)))
  (none))

(defun scl10n-register-labels! ()
  "Remplit la table une seule fois. Les entrees gardees par un drapeau de compilation sont absentes
   du binaire ET de la table : le recensement ne juge jamais une rangee qui n'existe pas ici."
  (when (not *scl10n-registered?*)
    (set! *scl10n-registered?* #t)
    ;; --- ecran RECHARGED SETTINGS, dans l'ordre des rangees ---
    (scl10n-add-label! #x17bf *recharged-master-label*)
    (#when FLAG_RECHARGED_HUD (scl10n-add-label! #x1707 *recharged-hud-label*))
    (scl10n-add-label! #x17c0 *grass-settings-label*)
    (scl10n-add-label! #x17c1 *load-custom-assets-label*)
    (scl10n-add-label! #x17c2 *recharged-textures-label*)
    (#when FLAG_HD_MODELS
      (scl10n-add-label! #x17c5 *enhanced-models-label*)
      (scl10n-add-label! #x17c6 *hd-look-jak-label*)
      (scl10n-add-label! #x17c7 *hd-look-daxter-label*)
      (scl10n-add-label! #x17c8 *hd-look-keira-label*)
      (scl10n-add-label! #x17c9 *hd-look-samos-label*))
    (scl10n-add-label! #x17ca *foliage-wind-label*)
    (scl10n-add-label! #x170e *ambient-occlusion-label*)
    (scl10n-add-label! #x170f *ao-quality-label*)
    (scl10n-add-label! #x1713 *ao-strength-label*)
    (#when FLAG_PBR
      (scl10n-add-label! #x17cb *recharged-lighting-label*)
      ;; lighting-legacy-purge (2026-09-11) : les enregistrements l10n des rangees retirees partent
      ;; avec leurs libelles. Les text-ids #x17c4 et #x17cc..#x17d4 restent LIBRES dans le banc :
      ;; ce sont des donnees de langue, les retirer renumeroterait un banc.
      )
    ;; water-ocean-mesh : rangee INCONDITIONNELLE (le drapeau eau ne depend d'aucun FLAG_*), donc
    ;; son enregistrement l10n vit HORS du (#when FLAG_PBR ...) ci-dessus. Id #x17e5 : #x17db etait
    ;; pris (GRASS OVERHANG) et #x17dc..#x17e3 sont reserves (framerate-uncap).
    (scl10n-add-label! #x17e5 *recharged-water-label*)
    (scl10n-add-label! #x17d5 *crisp-title-logo-label*)
    (scl10n-add-label! #x17d6 *fixed-tick-label*)
    (#when FLAG_PHYSICS (scl10n-add-label! #x17b7 *physics-label*))
    (scl10n-add-label! #x17c3 *managed-assets-label*)
    ;; --- ecran GRASS SETTINGS ---
    (scl10n-add-label! #x17d7 *recharged-grass-label*)
    (scl10n-add-label! #x17d8 *recharged-near-dist-label*)
    (scl10n-add-label! #x17d9 *recharged-card-dist-label*)
    (scl10n-add-label! #x17da *recharged-density-label*)
    (#when FLAG_GRASS_OVERHANG (scl10n-add-label! #x17db *grass-overhang-label*))
    ;; --- valeurs des carrousels HD LOOK (tags #x17b0-#x17b6, #x17bc) ---
    (scl10n-add-label! #x17b0 *hd-look-original-label*)
    (scl10n-add-label! #x17b1 *hd-look-hd-label*)
    (scl10n-add-label! #x17b2 *hd-look-jak2-label*)
    (scl10n-add-label! #x17b3 *hd-look-jak3-label*)
    (scl10n-add-label! #x17b4 *hd-look-pants-label*)
    (scl10n-add-label! #x17b5 *hd-look-young-label*)
    (scl10n-add-label! #x17b6 *hd-look-jak3m-label*)
    (scl10n-add-label! #x17bc *hd-look-jak2p-label*))
  (none))

(defun scl10n-id-of-buffer ((buf string))
  "L'identifiant de banc qui alimente ce tampon, 0 si le tampon n'est dans aucune entree. Un 0 fait
   compter la rangee comme INTRADUISIBLE par le recensement — c'est exactement ce qu'elle est."
  (let ((found 0))
    (dotimes (i *scl10n-label-count*)
      (if (= (-> *scl10n-label-bufs* i) buf) (set! found (-> *scl10n-label-ids* i))))
    found))

;; Glang-mixed: re-format the name-override label buffers from the loaded text bank so
;; they follow (-> *pc-settings* text-language). Runs on every menu open (init-game-options
;; re-canonicalizes there) and again right after a text-language change reloads the bank
;; (same-menu-session navigation must not read stale heap pointers — hence buffers + copy,
;; never bank pointers). A #f lookup (id absent AND fallback disabled) leaves the buffer as-is.
(defun refresh-runtime-option-labels! ()
  (when *common-text*
    ;; les libelles de l'ecran GRAPHISMES (hors menu Recharged, hors porte de cet item)
    (let ((s (lookup-text! *common-text* (the-as text-id #x1700) #t)))
      (if s (format (clear *fps-counter-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x1701) #t)))
      (if s (format (clear *render-scale-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x1702) #t)))
      (if s (format (clear *min-render-scale-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x1703) #t)))
      (if s (format (clear *dynamic-render-scale-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x1704) #t)))
      (if s (format (clear *min-target-fps-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x1705) #t)))
      (if s (format (clear *advanced-settings-label*) "~S" s)))
    (let ((s (lookup-text! *common-text* (the-as text-id #x1706) #t)))
      (if s (format (clear *recharged-settings-label*) "~S" s)))
    ;; LE MENU RECHARGED : la table, et rien d'autre.
    (scl10n-register-labels!)
    (dotimes (i *scl10n-label-count*)
      (let ((s (lookup-text! *common-text* (the-as text-id (-> *scl10n-label-ids* i)) #t)))
        (if s (format (clear (-> *scl10n-label-bufs* i)) "~S" s)))))
  (none))

;; Goptions-reorder: stable pointers to the Min Target FPS row (physical index 4) in each graphics
;; array, captured at load time while the arrays are in their full static layout. Used to reinsert the
;; row when Dynamic Render Scale is toggled back ON (the objects are static; the pointers never move).
(define *graphic-options-mtf-pc* (-> *graphic-options-pc* 4))
(define *graphic-options-mtf-android* (-> *graphic-options-pc-android* 4))

;; Goptions-reorder: show/hide the Min Target FPS row (physical index 4) by mutating the live `length`
;; of a graphics-options array — the renderer + navigation key off (length arr), so shrinking the live
;; length truly REMOVES the row (not just greys it). Idempotent via length checks; `saved` is the stable
;; Min-Target-FPS object used to reinsert the row. `full-len` is the array's full (row-shown) length.
(defun graphic-options-set-mtf-visible! ((arr (array game-option)) (saved game-option) (full-len int) (show? symbol))
  (cond
    (show?
     ;; reinsert MTF at index 4 if currently hidden: shift the tail right one slot, restore full length
     (when (< (-> arr length) full-len)
       (dotimes (j (- full-len 5))
         (let ((i (- (+ full-len -1) j)))
           (set! (-> arr i) (-> arr (+ i -1)))))
       (set! (-> arr 4) saved)
       (set! (-> arr length) full-len)))
    (else
     ;; remove MTF at index 4 if currently shown: shift the tail left one slot, drop live length by 1
     (when (= (-> arr length) full-len)
       (dotimes (j (- full-len 5))
         (let ((i (+ 4 j)))
           (set! (-> arr i) (-> arr (+ i 1)))))
       (set! (-> arr length) (+ full-len -1)))))
  (none))

;; hdr-display-output (essai 3) : la rangee HDR OUTPUT vit dans *recharged-options-pc*, juste apres
;; SHADOW QUALITY (la derniere rangee du bloc RECHARGED LIGHTING), et se RETROUVE par son marqueur
;; `hint` (pc-text-hint-hdr-output), jamais par un index. Sans mode annonce par l'ecran
;; (pc-get-hdr-output-modes = 0) elle est RETIREE une fois pour toutes du tableau vivant : la queue
;; glisse d'un cran et la longueur vivante baisse de 1 (`*rch-hdr-row-hidden?*` en tient compte
;; dans la garde de longueur de init-game-options).
(define *rch-hdr-row-hidden?* #f)

;; ─── recharged-gating-real — LE SOUS-MENU « RECHARGED LIGHTING » ──────────────────────────────
;; Owner 2026-09-10 : « On devrait avoir tout un sous menu "Recharged Lighting" avec un toggle
;; global [...] et donc dans ce sous menu le Realtime Lighting, le HDR Output, l'Occlusion
;; Ambiante avec ses propres sous reglages et tout ce qui viendra en lien a la refonte de
;; l'eclairage. »
;;
;; LA PAGE N'EST PAS ECRITE A LA MAIN. Elle est CONSTRUITE a l'execution : on demande a la table
;; des portes, pour chaque rangee, dans quelle page elle doit vivre (`__pc-gating-page`). Ecrire
;; la liste ici la ferait deriver de la hierarchie des portes au premier ajout — c'est-a-dire
;; refaire, sur la PLACE des options, exactement la faute qu'on vient de corriger sur leur
;; EXTINCTION. Une option ajoutee sous l'eclairage atterrit ici sans que personne n'y pense, et
;; le recensement (`gating_menu_misplaced`) le verifie a chaque course.
;;
;; POURQUOI A L'EXECUTION ET PAS DANS LE TABLEAU STATIQUE. Retirer quinze rangees du tableau
;; statique changerait sa LONGUEUR, et c'est cette longueur que la garde `fw-idx` compare pour
;; decider si le bloc HD est « collapse » ; tous les bras relatifs a `fw-idx` seraient a
;; renumeroter a la main. C'est la classe de bug Gmenu-flag-off, la plus chere de ce fichier
;; (« on peindrait "PBR TEST PRESET" sur une autre ligne et on repointerait sa valeur »). Ici,
;; AUCUN index statique ne bouge et AUCUNE garde de longueur ne change.
(define *rlighting-options-pc*
  (new 'static 'boxed-array :type game-option :length 0 :allocated-length 24))

;; La rangee qui OUVRE la page, posee a la place de la premiere rangee deplacee. Allouee a part
;; pour la meme raison : ajouter une rangee au tableau statique changerait sa longueur.
(define *rlighting-launcher*
  (new 'static 'game-option
       :option-type (game-option-type menu)
       :name (text-id ps2-options)
       :scale #t
       ;; recharged-gating-real essai 2 : le lanceur disparait quand un ANCETRE de « lighting » est
       ;; eteint (le master), sinon il ouvrirait une page vide ; il RESTE quand c'est « Recharged
       ;; Lighting » elle-meme qui est eteinte — sans quoi on ne pourrait plus jamais la rallumer.
       ;; Une lambda et pas un `gating-id` : un `gating-id` ferait rapporter ce lanceur au
       ;; recensement comme une rangee de « lighting » dessinee dans la page « recharged », donc
       ;; `gating_menu_misplaced` monterait. La question posee est la MEME, et a la meme table.
       :option-disabled-func
       (lambda ()
         (nonzero? (__pc-gating-disabled? "lighting")))
       :param3 (game-option-menu lighting-settings)))

;; L'ORDRE D'ORIGINE DU TABLEAU RECHARGED. `init-game-options` tourne A CHAQUE OUVERTURE du menu
;; et son cablage se repere sur la LONGUEUR du tableau. Lui laisser un tableau deja compacte
;; ferait cabler la DEUXIEME ouverture completement de travers — le meme accident, un cran plus
;; loin. On rend donc l'ordre d'origine avant chaque cablage, et on recompacte apres.
(define *rch-page-backup*
  (new 'static 'boxed-array :type game-option :length 0 :allocated-length 48))
(define *rch-page-backup-done?* #f)

;; ================================================================================================
;; recharged-gating-real essai 2 — MASQUER, PAS GRISER (refus de l'owner du 2026-09-10).
;;
;; L'owner ne veut pas d'une rangee grise dont il faut deviner pourquoi elle ne repond pas : une
;; option dont le PARENT est eteint DISPARAIT de la page. « C'est plus simple a comprendre. » Et la
;; regle est GENERALE, pas taillee pour l'Occlusion Ambiante : TOUTE rangee qui depend d'une autre
;; s'en va avec elle, y compris celles que la table C++ ne connait pas (les quatre LOOK, les deux
;; lanceurs de sous-menu, PHYSIQUE, PAS FIXE) — leur dependance vit dans leur propre
;; `option-disabled-func`, et `option-locked?` est le seul juge des deux familles.
;;
;; Comment : la page dessinee est RECONSTRUITE, a chaque image passee dessus, depuis une PHOTO de
;; son contenu complet, sans les rangees verrouillees. La photo est prise juste apres
;; `gating-repage!`, c'est-a-dire sur le tableau tel qu'il est REELLEMENT livre — apres le cablage,
;; apres le retrait eventuel de HDR OUTPUT, apres la sortie du bloc eclairage vers sa page. Repartir
;; du tableau vivant ferait fondre la page : ce qui sort une fois ne reviendrait jamais quand le
;; parent se rallume.
;; ================================================================================================
(define *rch-mask-src-rch* (new 'static 'boxed-array :type game-option :length 0 :allocated-length 48))
(define *rch-mask-src-lgt* (new 'static 'boxed-array :type game-option :length 0 :allocated-length 24))
(define *rch-mask-src-grs* (new 'static 'boxed-array :type game-option :length 0 :allocated-length 16))
;; Tant que la photo n'a pas ete prise, on ne masque RIEN : masquer depuis une photo vide viderait
;; les trois pages a la premiere image passee sur le menu.
(define *rch-mask-snapped?* #f)
;; Combien de rangees la derniere reconstruction a retirees. C'est le temoin de NON-VACUITE du
;; compte de rangees verrouillees encore visibles : zero visible et zero retiree se lit aussi bien
;; sur un menu ou rien n'est eteint, ce qui ne prouverait rien.
(define *rch-mask-masked-n* 0)

(defun rch-mask-snapshot-one! ((src (array game-option)) (arr (array game-option)))
  "Photographie une page telle qu'elle vient d'etre livree."
  (dotimes (i (-> arr length))
    (set! (-> src i) (-> arr i)))
  (set! (-> src length) (-> arr length))
  (none))

(defun rch-mask-snapshot! ()
  "Les trois pages Recharged, photographiees a la fin de `gating-repage!`."
  (rch-mask-snapshot-one! *rch-mask-src-rch* *recharged-options-pc*)
  (rch-mask-snapshot-one! *rch-mask-src-lgt* *rlighting-options-pc*)
  (rch-mask-snapshot-one! *rch-mask-src-grs* *grass-options-pc*)
  (set! *rch-mask-snapped?* #t)
  (none))

(defun rch-mask-one! ((src (array game-option)) (arr (array game-option)))
  "Reconstruit `arr` depuis sa photo en sautant toute rangee verrouillee."
  (let ((w 0))
    (dotimes (i (-> src length))
      (let ((row (-> src i)))
        (cond
          ((option-locked? row) (set! *rch-mask-masked-n* (+ *rch-mask-masked-n* 1)))
          (else
           (set! (-> arr w) row)
           (set! w (+ w 1))))))
    (set! (-> arr length) w))
  (none))

(defun rch-page-mask! ()
  "Le geste, appele a chaque image passee sur une des trois pages Recharged : ce qui depend d'un
   parent eteint n'est pas dessine en gris, il n'est pas dessine du tout."
  (when *rch-mask-snapped?*
    (set! *rch-mask-masked-n* 0)
    (rch-mask-one! *rch-mask-src-rch* *recharged-options-pc*)
    (rch-mask-one! *rch-mask-src-lgt* *rlighting-options-pc*)
    (rch-mask-one! *rch-mask-src-grs* *grass-options-pc*))
  (none))

(defun rch-mask-count-shown-locked! ()
  "Combien de rangees VERROUILLEES sont encore presentes dans les trois tableaux VIVANTS. Doit
   valoir 0 : c'est la mesure de la regle generale, et elle ne regarde pas le `gating-id` — une
   rangee sans identifiant de porte (les quatre LOOK, les lanceurs, PHYSIQUE, PAS FIXE) est jugee
   par la MEME question que les autres, `option-locked?`. Interroger la table C++ a la place ne
   verrait aucune de celles-la."
  (let ((n 0))
    (dotimes (i (-> *recharged-options-pc* length))
      (if (option-locked? (-> *recharged-options-pc* i)) (set! n (+ n 1))))
    (dotimes (i (-> *rlighting-options-pc* length))
      (if (option-locked? (-> *rlighting-options-pc* i)) (set! n (+ n 1))))
    (dotimes (i (-> *grass-options-pc* length))
      (if (option-locked? (-> *grass-options-pc* i)) (set! n (+ n 1))))
    n))

(defun gating-unrepage! ()
  "Rend a *recharged-options-pc* l'ordre et la longueur qu'il avait avant tout deplacement.
   Sans effet tant qu'aucune sauvegarde n'a ete prise (premiere ouverture du menu)."
  (when *rch-page-backup-done?*
    (dotimes (i (-> *rch-page-backup* length))
      (set! (-> *recharged-options-pc* i) (-> *rch-page-backup* i)))
    (set! (-> *recharged-options-pc* length) (-> *rch-page-backup* length)))
  ;; recharged-gating-real essai 2 : LA PAGE HERBE AUSSI. `init-game-options` la cable PAR INDEX
  ;; (rangees 0..4). Si `rch-page-mask!` l'a raccourcie a l'image precedente, le cablage de la
  ;; prochaine ouverture poserait `value-to-modify` et `gating-id` sur les MAUVAISES rangees —
  ;; exactement la classe de bug que cette fonction existe pour eviter cote Recharged.
  ;; `*rlighting-options-pc*` n'en a pas besoin : `gating-repage!` le reconstruit integralement.
  (when *rch-mask-snapped?*
    (dotimes (i (-> *rch-mask-src-grs* length))
      (set! (-> *grass-options-pc* i) (-> *rch-mask-src-grs* i)))
    (set! (-> *grass-options-pc* length) (-> *rch-mask-src-grs* length)))
  (none))

(defun gating-repage! ()
  "Construit la page « Recharged Lighting » a partir de la table des portes, et retire du menu
   Recharged les rangees qui y sont parties. Appele a la FIN de `init-game-options`, donc apres
   `rch-hdr-row-hide-once!` : la sauvegarde capture le tableau tel qu'il est reellement livre."
  (let ((n (-> *recharged-options-pc* length)))
    (when (not *rch-page-backup-done?*)
      (dotimes (i n)
        (set! (-> *rch-page-backup* i) (-> *recharged-options-pc* i)))
      (set! (-> *rch-page-backup* length) n)
      (set! *rch-page-backup-done?* #t))
    ;; 1. LA PAGE. L'interrupteur global en tete — c'est le geste que l'owner decrit en premier —
    ;;    puis les dependantes dans l'ordre ou le menu les portait deja, puis Back.
    (let ((dst 0))
      (dotimes (i n)
        (let ((row (-> *recharged-options-pc* i)))
          (when (and (nonzero? (-> row gating-id)) (string= (-> row gating-id) "lighting"))
            (set! (-> *rlighting-options-pc* dst) row)
            (set! dst (+ dst 1)))))
      (dotimes (i n)
        (let ((row (-> *recharged-options-pc* i)))
          (when (and (nonzero? (-> row gating-id))
                     (= 2 (__pc-gating-page (-> row gating-id)))
                     (not (string= (-> row gating-id) "lighting")))
            (set! (-> *rlighting-options-pc* dst) row)
            (set! dst (+ dst 1)))))
      ;; La rangee BACK est la MEME que celle du menu Recharged : une rangee `button` ne porte
      ;; aucun etat, la partager entre deux pages ne peut rien decaler.
      (when (> n 0)
        (set! (-> *rlighting-options-pc* dst) (-> *recharged-options-pc* (+ n -1)))
        (set! dst (+ dst 1)))
      (set! (-> *rlighting-options-pc* length) dst))
    ;; 2. LE MENU RECHARGED, compacte. Le lanceur prend la place de la PREMIERE rangee partie :
    ;;    le sous-menu s'ouvre la ou le bloc eclairage commencait, l'ordre visuel est conserve.
    (set! (-> *rlighting-launcher* name-override) *recharged-lighting-label*)
    (let ((w 0)
          (placed #f))
      (dotimes (i n)
        (let* ((row (-> *recharged-options-pc* i))
               (pg (if (nonzero? (-> row gating-id)) (__pc-gating-page (-> row gating-id)) 0)))
          (cond
            ((= pg 2)
             (when (not placed)
               (set! placed #t)
               (set! (-> *recharged-options-pc* w) *rlighting-launcher*)
               (set! w (+ w 1))))
            (else
             (set! (-> *recharged-options-pc* w) row)
             (set! w (+ w 1))))))
      (set! (-> *recharged-options-pc* length) w)))
  ;; recharged-gating-real essai 2 : LA PHOTO, ici et nulle part ailleurs. Les trois pages sont
  ;; desormais dans l'etat ou elles sont livrees au joueur ; c'est cet etat-la que le masquage
  ;; reconstruit, image apres image, prive de ce qui est verrouille.
  (rch-mask-snapshot!)
  (none))

(defun rch-hdr-row-index ()
  "Index vivant de la rangee HDR OUTPUT dans *recharged-options-pc*, -1 si absente (retiree)."
  (let ((idx -1))
    (dotimes (i (-> *recharged-options-pc* length))
      (when (and (< idx 0)
                 (= (the int (-> *recharged-options-pc* i hint))
                    (the int (text-id pc-text-hint-hdr-output))))
        (set! idx i)))
    idx))
(defun rch-water-row-index ()
  "Index vivant de la rangee EAU RECHARGEE dans *recharged-options-pc*, -1 si absente."
  (let ((idx -1))
    (dotimes (i (-> *recharged-options-pc* length))
      (when (and (< idx 0)
                 (= (the int (-> *recharged-options-pc* i hint))
                    (the int (text-id pc-text-hint-recharged-water))))
        (set! idx i)))
    idx))
(defun rch-hdr-row-parent ()
  "1 si la rangee HDR OUTPUT est dans *recharged-options-pc* IMMEDIATEMENT apres la rangee
   RECHARGED LIGHTING et dans AUCUN tableau graphique ; 0 sinon. Lu sur les tableaux tels
   qu'ils sont, jamais suppose.
   lighting-legacy-purge (2026-09-11) : le repere etait l'option-type de la rangee SHADOW QUALITY,
   unique et STATIQUE. Elle est retiree ; le parent est desormais RECHARGED LIGHTING, retrouvee par
   son `:hint` pc-text-hint-rtlight — ecrit dans le TABLEAU STATIQUE, donc lisible par l'appel de
   niveau 0 qui tourne AVANT init-game-options. Un repere pose au cablage rendrait 0 a cet instant."
  (let ((h (rch-hdr-row-index))
        (rl -1)
        (in-gfx 0))
    (dotimes (i (-> *recharged-options-pc* length))
      (when (and (< rl 0)
                 (= (the int (-> *recharged-options-pc* i hint))
                    (the int (text-id pc-text-hint-rtlight))))
        (set! rl i)))
    (dotimes (i (-> *graphic-options-pc* length))
      (when (= (the int (-> *graphic-options-pc* i hint)) (the int (text-id pc-text-hint-hdr-output)))
        (set! in-gfx 1)))
    (dotimes (i (-> *graphic-options-pc-android* length))
      (when (= (the int (-> *graphic-options-pc-android* i hint)) (the int (text-id pc-text-hint-hdr-output)))
        (set! in-gfx 1)))
    (if (and (>= h 0) (>= rl 0) (= h (+ rl 1)) (zero? in-gfx)) 1 0)))
(defun rch-hdr-row-hide-once! ()
  "Retire la rangee HDR OUTPUT du tableau vivant si l'ecran n'annonce aucun mode. Idempotent."
  (when (and (not *rch-hdr-row-hidden?*) (= (pc-get-hdr-output-modes) 0))
    (let ((h (rch-hdr-row-index))
          (len (-> *recharged-options-pc* length)))
      (when (>= h 0)
        (let ((i h))
          (while (< (+ i 1) len)
            (set! (-> *recharged-options-pc* i) (-> *recharged-options-pc* (+ i 1)))
            (+! i 1)))
        (set! (-> *recharged-options-pc* length) (+ len -1))
        (set! *rch-hdr-row-hidden?* #t))))
  (none))
;; Au CHARGEMENT (avant toute ouverture du menu) : ou vit la rangee, lu sur les tableaux statiques.
;; L'auto-test de preuve n'ouvre pas le menu ; ce rapport est celui qu'il juge (verdict 7).
(pc-hdr-output-note! 2 (rch-hdr-row-parent))

;; Re-point + relabel the RENDER SCALE slider row (physical index 3 in both arrays, above the Min Target
;; FPS row so it never shifts) per the Dynamic Render Scale toggle: OFF -> edits render-scale (manual %),
;; label "RENDER SCALE"; ON -> edits min-render-scale (auto-scaler floor), label "MIN RENDER SCALE".
;; Also shows/hides the Min Target FPS row (index 4): visible only when Dynamic Render Scale is ON.
(defun apply-dynamic-rs-menu-mode! ()
  (let ((dyn? (-> *pc-settings* dynamic-render-scale?)))
    (set! (-> *graphic-options-pc* 3 value-to-modify)
          (if dyn? (&-> *pc-settings* min-render-scale) (&-> *pc-settings* render-scale)))
    (set! (-> *graphic-options-pc* 3 name-override)
          (if dyn? *min-render-scale-label* *render-scale-label*))
    (set! (-> *graphic-options-pc-android* 3 value-to-modify)
          (if dyn? (&-> *pc-settings* min-render-scale) (&-> *pc-settings* render-scale)))
    (set! (-> *graphic-options-pc-android* 3 name-override)
          (if dyn? *min-render-scale-label* *render-scale-label*))
    ;; Gvulkan-option + Grecharged-hud-jak1: full lengths now 15 desktop / 12 android (VULKAN RENDERER
    ;; and RECHARGED SETTINGS rows both inserted after index 4, so the MTF stable pointers are unaffected).
    (graphic-options-set-mtf-visible! *graphic-options-pc* *graphic-options-mtf-pc* GFX_OPTIONS_PC_FULL_LEN dyn?)
    (graphic-options-set-mtf-visible! *graphic-options-pc-android* *graphic-options-mtf-android* GFX_OPTIONS_ANDROID_FULL_LEN dyn?))
  (none))

(defun apply-frame-rate-menu-bounds! ()
  "framerate-uncap essai 2 (c) : LA CIBLE DE L'ECHELLE DE RENDU DYNAMIQUE SUIT LE PLAFOND.
   owner 2026-09-07 : « le FPS cible du Dynamic resolution scaling devrait ajuster les options
   de son slider en fonction du max fps [...] dommage de mettre la target a un max de 60 alors
   qu'on a defini le max fps a 240 ». La borne haute de cette rangee etait la constante 60
   (`:param2 60.0`) sur les DEUX tableaux. Elle vient maintenant de `dynscale-target-max`
   (pckernel-common.gc), qui est aussi la valeur poussee au C++ par `update-to-os` : un seul
   ecrivain de la regle, deux lecteurs, donc un verdict qui ne se juge pas lui-meme.
   Appelee depuis `init-game-options` et depuis la confirmation de la rangee de cadence -- une
   borne calculee UNE FOIS a l'ouverture du menu resterait a 60 apres un changement de plafond.
   Rafraichit aussi l'etiquette de la rangee : une rangee de LISTE non selectionnee n'affiche
   que son nom, alors que le curseur d'avant montrait sa valeur."
  (let ((mx (the float (dynscale-target-max *pc-settings*))))
    ;; Les POINTEURS STABLES, pas l'index 4 : `graphic-options-set-mtf-visible!` masque cette
    ;; rangee en decalant le tableau et en raccourcissant sa longueur, donc l'index 4 designe
    ;; une AUTRE rangee des que l'echelle dynamique est eteinte.
    (set! (-> *graphic-options-mtf-pc* param2) mx)
    (set! (-> *graphic-options-mtf-android* param2) mx)
    ;; le reglage courant peut etre AU-DESSUS de la nouvelle borne (on vient de baisser le
    ;; plafond) : on le ramene tout de suite, sinon le controleur viserait un inatteignable.
    (if (> (-> *pc-settings* dyn-target-fps) mx) (set! (-> *pc-settings* dyn-target-fps) mx))
    (let ((cap (-> *pc-settings* display-fps-cap)))
      (if (< cap 0.0)
          (format (clear *max-frame-rate-label*) "MAX FRAME RATE: UNLIMITED")
          (format (clear *max-frame-rate-label*) "MAX FRAME RATE: ~D" (the int cap)))))
  (none))
;; Goptions-reorder: "PS2 Options" is relabelled "ADVANCED SETTINGS" via name-override (the menu font
;; only maps uppercase ASCII; see the FPS-counter label note). Submenu (gfx-ps2-options) is unchanged.
(define *advanced-settings-label* (new 'global 'string 128 (the-as string #f)))
(format (clear *advanced-settings-label*) "ADVANCED SETTINGS")

;; label for the NATIVE (panel resolution) entry at the top of the Game Resolution
;; list (uppercase for the menu font; shown via name-override).
(define *resolution-native-label* "NATIVE")

