;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  DYNAMIC MENU THINGS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-perm *temp-options-alloced* symbol #f)

;; this is to avoid changing the value of *temp-options* or reallocating the options when reloading file
;; ================================================================================================
;; menu-back-label (owner 2026-09-11 : « dans les sous-menus, la string "Retour" n'est pas la, ca
;; prend une string random dans les sous menus des reglages realtime lighting »).
;;
;; LA CAUSE, ET ELLE N'EST PAS DANS LA RANGEE « RETOUR ». Ces 200 emplacements sont PARTAGES par
;; les huit ecrans construits a l'execution (resolution, moniteur, manette, les trois pages de
;; binds, le lecteur de flava, et la page de choix generique d'ou sortent AMBIENT OCCLUSION, AO
;; QUALITY, AO STRENGTH...). Chaque emplacement portait un tampon de libelle POSE UNE FOIS POUR
;; TOUTES dans son champ `name-override`. Or les quinze sites de dessin lisent ce champ ainsi :
;; « non nul => il y a un libelle explicite, l'afficher ; nul => traduire `name` ». Avec un tampon
;; accroche a demeure, la premiere branche etait prise TOUJOURS, pour toute rangee du tableau :
;; une rangee qui ne se donne pas de libelle affichait donc celui de l'occupant PRECEDENT du meme
;; emplacement. Ouvrir AMBIENT OCCLUSION (4 valeurs + en-tete) remplit les emplacements 0..4 ;
;; ouvrir ensuite AO QUALITY (3 valeurs + en-tete) n'en remplit que 0..3 et pose son « Retour »
;; en 4 — qui affiche la 4e valeur d'AO. C'est le « string random » du rapport, au geste pres.
;; Le banc de texte est HORS DE CAUSE : `(text-id back)` = #x13e est present dans les 23 bancs
;; livres (« Retour » en francais), et `lookup-text!` n'y est jamais arrive.
;;
;; LA CORRECTION EST AU POINT DE PRODUCTION. Le tampon quitte la rangee : il vit dans
;; `*temp-option-labels*`, a l'index de l'emplacement, et `name-override` part a ZERO. « Non nul »
;; redevient donc ce que les quinze lecteurs croient lire : un libelle que le constructeur de CETTE
;; rangee a pose, par `temp-option-label!`. Aucun site de dessin n'est touche.
;;
;; ET LE CHAMP N'EST PAS LE SEUL. Un emplacement reutilise rend TOUT ce que son constructeur
;; n'ecrit pas : `on-confirm` (la rangee « RESTORE DEFAULTS » des binds en laisse une, et le
;; `respond-common` de ce fichier lance `on-confirm` SANS regarder le type de rangee — un
;; « Retour » pouvait donc reinitialiser des touches), `on-change`, `value-to-modify`, `param2`,
;; `param3`, `hint`, `gating-id`, `slider-*`, `bind-info`. Deux commentaires de ce fichier
;; avouaient deja la classe, champ par champ, en la corrigeant un champ a la fois.
;; `temp-option-reset!` la ferme d'un coup : tout constructeur RAMENE d'abord son emplacement a
;; neuf, et ce qu'il ne pose pas vaut zero, jamais l'heritage du voisin.
;; ================================================================================================
(unless *temp-options-alloced*
  (define *temp-options* (new 'static 'boxed-array :type game-option :length 200 :allocated-length 200))
  ;; Les tampons de libelle, UN par emplacement, alloues ici comme avant — seule leur ADRESSE de
  ;; rangement change. Les accrocher a la rangee est precisement ce qui rendait « il y a un
  ;; libelle » indistinguable de « il y a un tampon ».
  (define *temp-option-labels* (new 'static 'boxed-array :type string :length 200 :allocated-length 200))
  (dotimes (i (-> *temp-options* length))
    (set! (-> *temp-options* i) (new 'global 'game-option))
    (set! (-> *temp-option-labels* i) (new 'global 'string 128 (the-as string #f)))
    (set! (-> *temp-options* i name-override) (the-as string 0)))
  (true! *temp-options-alloced*))

(defmacro temp-option-reset! (option)
  "RAMENE A NEUF l'emplacement de `*temp-options*` qu'un constructeur s'apprete a remplir.
   A appeler en PREMIER dans tout constructeur de rangee dynamique : ce qu'il n'ecrit pas ensuite
   vaut zero, au lieu de valoir ce que l'ecran precedent avait laisse la. Voir le pave ci-dessus."
  `(begin
     (set! (-> ,option option-type) (game-option-type button))
     (set! (-> ,option name) (text-id zero))
     ;; ZERO, PAS `#f`. En GOAL `#f` est le symbole s7, un pointeur NON NUL : un champ `basic`
     ;; qui le porte se lit « non nul » et le dessin prendrait ce non-libelle pour un libelle —
     ;; mesure du 2026-09-12, 12 rangees Back sorties en `src=override text=#f`. Les rangees
     ;; statiques, elles, portent un vrai 0 parce que le compilateur statique laisse le champ a
     ;; zero ; c'est cette valeur-la que les quinze lecteurs attendent.
     (set! (-> ,option name-override) (the-as string 0))
     (set! (-> ,option scale) #f)
     (set! (-> ,option param1) 0.0)
     (set! (-> ,option param2) 0.0)
     (set! (-> ,option param3) (game-option-menu invalid))
     (set! (-> ,option value-to-modify) (the-as pointer 0))
     (set! (-> ,option option-disabled-func) #f)
     (set! (-> ,option on-change) (the-as (function object none) 0))
     (set! (-> ,option on-confirm) (the-as (function none) 0))
     (set! (-> ,option slider-step-size) 0.0)
     (set! (-> ,option slider-show-decimal?) #f)
     (set! (-> ,option hint) (text-id zero))
     (set! (-> ,option gating-id) (the-as string 0))
     (set! (-> ,option bind-info port) 0)
     (set! (-> ,option bind-info device-type) 0)
     (set! (-> ,option bind-info for-buttons?) #f)
     (set! (-> ,option bind-info input-idx) 0)
     (set! (-> ,option bind-info analog-min-range?) #f)))

(defmacro temp-option-label! (option)
  "Accroche a `option` le tampon de libelle de SON emplacement, VIDE, et le rend. C'est le seul
   geste qui rend `name-override` non nul sur une rangee de `*temp-options*` : un emplacement dont
   le constructeur ne l'appelle pas affiche la traduction de son `name`, comme le fait la branche
   `menu`/`button`/`choice-value` de `draw-options` depuis toujours.
   L'index est `(length *temp-options*)` : le constructeur n'a pas encore incremente, c'est donc
   l'emplacement qu'il est en train de remplir."
  `(let ((buf (-> *temp-option-labels* (length *temp-options*))))
     (set! (-> ,option name-override) buf)
     (clear buf)))

(defmacro add-flava-player-option (text-id flava)
  "add a music player w/ flava button to *temp-options* with specified size"
  `(let ((option (-> *temp-options* (length *temp-options*))))
    ;; menu-back-label : l'emplacement est RAMENE A NEUF avant d'etre rempli. Ce qui suit est
    ;; tout ce que cette rangee porte ; le reste vaut zero, pas l'heritage de l'ecran precedent.
    (temp-option-reset! option)
    (set! (-> option option-type) (game-option-type button-flava))
    (set! (-> option name) ,text-id)
    (set! (-> option param1) (the float ,flava))
    (set! (-> option scale) #t)
    (1+! (-> *temp-options* length))))

(defmacro add-back-option ()
  "add *back-button* to *temp-options*"
  `(let ((option (-> *temp-options* (length *temp-options*))))
    ;; menu-back-label : LA RANGEE QUE L'OWNER A VUE MENTIR. Elle ne se donne aucun libelle —
    ;; son texte est la traduction de `(text-id back)`. Tant qu'un tampon vide restait accroche
    ;; a `name-override`, le dessin preferait ce tampon et affichait ce que l'ecran precedent y
    ;; avait laisse. `temp-option-reset!` remet `name-override` a ZERO : la traduction reprend.
    ;; recharged-gating-real essai 2 avait deja rencontre la classe sur `option-disabled-func` et
    ;; l'avait fermee un champ a la fois ; le reset les ferme tous, `on-confirm` compris — la
    ;; rangee « RESTORE DEFAULTS » des pages de binds en laissait une derriere elle.
    (temp-option-reset! option)
    (set! (-> option option-type) (game-option-type button))
    (set! (-> option name) (text-id back))
    (set! (-> option scale) #t)
    (1+! (-> *temp-options* length))))

(defmacro add-message-option (text)
  "adds an option that isn't selectable but displays some text"
  `(let ((option (-> *temp-options* (length *temp-options*))))
    ;; menu-back-label : meme defaut que `add-back-option` — cette rangee tire son texte de son
    ;; `name`, et un tampon accroche le masquait.
    (temp-option-reset! option)
    (set! (-> option option-type) (game-option-type button))
    (set! (-> option option-disabled-func) (lambda () #t))
    (set! (-> option name) ,text)
    (set! (-> option scale) #t)
    (1+! (-> *temp-options* length))))

(defmacro add-resolution-option (x y)
  "add a resolution button to *temp-options*, labelled cleanly via name-override
   ('W x H' in the menu font), avoiding the localized resolution-fmt glyphs."
  `(let ((option (-> *temp-options* (length *temp-options*))))
    (temp-option-reset! option)
    (set! (-> option option-type) (game-option-type resolution))
    (set! (-> option name) (text-id resolution-fmt))
    ;; format 'W x H' into this slot's label buffer, which `temp-option-label!` attaches (and
    ;; empties) for THIS row -- menu-back-label : c'est le seul geste qui rend `name-override`
    ;; non nul, donc « il y a un libelle » redevient une affirmation, pas un etat de l'allocateur.
    (format (temp-option-label! option) "~D X ~D" ,x ,y)
    (set! (-> option param1) (the float ,x))
    (set! (-> option param2) (the float ,y))
    (set! (-> option scale) #t)
    (1+! (-> *temp-options* length))))

(defmacro add-named-resolution-option (label x y)
  "add a resolution button labelled via name-override (e.g. NATIVE W x H)"
  `(let ((option (-> *temp-options* (length *temp-options*))))
    (temp-option-reset! option)
    (set! (-> option option-type) (game-option-type resolution))
    (set! (-> option name) (text-id resolution-fmt))
    (format (temp-option-label! option) "~S ~D X ~D" ,label ,x ,y)
    (set! (-> option param1) (the float ,x))
    (set! (-> option param2) (the float ,y))
    (set! (-> option scale) #t)
    (1+! (-> *temp-options* length))))

;; Standard resolution WIDTHS (the owner's table, by the constrained axis). The
;; ladder is generated by computing the height at the CURRENT aspect ratio for each
;; width — so for a standard aspect these reproduce the named resolutions (16:9:
;; 1280x720, 1920x1080, 2560x1440, 3840x2160 ... ; 4:3: 640x480, 800x600 ...),
;; and for a NON-standard aspect (e.g. the device's auto ~2.22) it still yields an
;; aspect-correct ladder. Each is clamped to [floor, native].
(define *resolution-ladder-widths*
  (new 'static 'boxed-array :type int32
       640 800 1024 1280 1600 1920 2048 2560 3440 3840 4096 5120 6144 7680 8192))
;; standard heights, used to ladder height-constrained (portrait / aspect < 1) cases.
(define *resolution-ladder-heights*
  (new 'static 'boxed-array :type int32
       480 600 720 768 900 1024 1050 1080 1152 1200 1440 1600 2160 2880 4320))

(defun build-resolution-options ()
  "Build the Game Resolution list for the CURRENT aspect ratio: a NATIVE entry (the
   largest resolution AT the chosen aspect that fits the physical panel — adapts as the
   aspect changes; e.g. 4:3 on a 2400x1080 panel = 1440x1080, NOT the raw 2400x1080) +
   a standard ladder generated AT the current aspect ratio and clamped to [floor, native].
   Floor = 640 wide for width-constrained aspects (the common case), else 480 tall. Works
   on x86 and Android (one shared path). Re-runs every frame in respond-common, so both the
   NATIVE entry and the ladder re-filter/recompute when the aspect changes."
  (set! (-> *temp-options* length) 0)
  (let ((panel-w 0)
        (panel-h 0)
        (added 0))
    (pc-get-active-display-size (& panel-w) (& panel-h))
    (when (or (<= panel-w 0) (<= panel-h 0))
      (set! panel-w 640)
      (set! panel-h 480))
    (let* ((aspect (-> *pc-settings* aspect-ratio))
           (aspect (if (< aspect 0.1) 1.0 aspect)) ;; guard against a bogus 0 aspect
           ;; physical panel aspect of the active display.
           (panel-aspect (/ (the float panel-w) (the float panel-h)))
           ;; NATIVE adapts to the CHOSEN aspect (owner 2026-06-30): the LARGEST
           ;; aspect-correct rectangle that fits inside the physical panel — NOT the
           ;; raw panel size. Chosen aspect WIDER than the panel -> bound by panel
           ;; WIDTH (compute height); NARROWER/taller -> bound by panel HEIGHT
           ;; (compute width); equal -> the real panel size. e.g. 4:3 on a 2400x1080
           ;; panel -> 1440x1080; 16:9 -> 1920x1080; the panel's own aspect -> 2400x1080.
           ;; Recomputes here every frame, so NATIVE follows the aspect selection live.
           (fit-width? (>= aspect panel-aspect))
           (native-w (if fit-width? panel-w (the int (+ 0.5 (* (the float panel-h) aspect)))))
           (native-h (if fit-width? (the int (+ 0.5 (/ (the float panel-w) aspect))) panel-h))
           (width-constrained? (>= aspect 1.0)))
      ;; NATIVE entry first (largest aspect-correct resolution fitting the panel).
      (add-named-resolution-option *resolution-native-label* native-w native-h)
      (1+! added)
      (cond
        (width-constrained?
         ;; ladder by standard WIDTH; height = round(width / aspect).
         (dotimes (i (-> *resolution-ladder-widths* length))
           (let* ((rw (-> *resolution-ladder-widths* i))
                  (rh (the int (+ 0.5 (/ (the float rw) aspect)))))
             (when (and (>= rw 640)          ;; floor
                        (<= rw native-w)      ;; ceiling = native width
                        (<= rh native-h)      ;; fits panel height
                        (not (and (= rw native-w) (= rh native-h)))) ;; NATIVE already covers
               (add-resolution-option rw rh)
               (1+! added)))))
        (else
         ;; height-constrained (aspect < 1): ladder by standard HEIGHT; width = round(height * aspect).
         (dotimes (i (-> *resolution-ladder-heights* length))
           (let* ((rh (-> *resolution-ladder-heights* i))
                  (rw (the int (+ 0.5 (* (the float rh) aspect)))))
             (when (and (>= rh 480)
                        (<= rh native-h)
                        (<= rw native-w)
                        (not (and (= rw native-w) (= rh native-h))))
               (add-resolution-option rw rh)
               (1+! added))))))
      ;; PS2-like extras only for 4:3 fullscreen (preserve prior behavior).
      (when (and (fullscreen?) (< (fabs (- aspect ASPECT_4X3)) 0.06))
        (add-resolution-option 512 448)
        (add-resolution-option 512 224))
      (when (zero? added)
        (add-message-option (text-id progress-no-other-resolution-options))))
    (add-back-option)))


;; ============================================================================================
;; res-menu-truth (owner 2026-09-10) — « On est jamais surs d'etre a la bonne resolution »
;; --------------------------------------------------------------------------------------------
;; Trois gestes, UNE source de verite (`resolve-game-base-size`, pckernel-common.gc) :
;;   1. la rangee « Resolution » du menu Graphismes porte la resolution EFFECTIVE, sans entrer
;;      dans le sous-menu ;
;;   2. le sous-menu s'ouvre SUR elle, curseur pose dessus ;
;;   3. l'audit ci-dessous verifie que chaque libelle de l'echelle rend bien ce qu'il annonce,
;;      dans CHAQUE aspect propose par le menu.
;; ============================================================================================

;; Tampon du libelle de la rangee « Resolution ». Reformate a chaque image passee sur l'ecran
;; Graphismes : la valeur suit un changement d'aspect ou de resolution sans rouvrir le menu.
(define *resolution-row-label* (new 'global 'string 96 (the-as string #f)))

(defun current-game-base-size ((w-out (pointer int64)) (h-out (pointer int64)))
  "La taille de base REELLEMENT rendue pour l'etat courant de *pc-settings*."
  (resolve-game-base-size *pc-settings*
                          (the int (-> *pc-settings* width))
                          (the int (-> *pc-settings* height))
                          (-> *pc-settings* game-size-picked?)
                          w-out
                          h-out)
  (none))

(defun graphic-options-array ()
  "Le tableau de rangees REELLEMENT cable sur l'ecran Graphismes de cette cible."
  (#if PLATFORM_ANDROID *graphic-options-pc-android* *graphic-options-pc*))

(defun refresh-resolution-row-label! ()
  "Ecrit « <libelle traduit> W X H » dans la rangee « Resolution » de l'ecran Graphismes.
   La rangee est RETROUVEE par son text-id, jamais par un index en dur : l'ecran Graphismes
   ajoute et retire des rangees a l'execution (MINIMUM TARGET FRAMERATE)."
  (let ((options (graphic-options-array))
        (w 0)
        (h 0))
    (current-game-base-size (& w) (& h))
    (format (clear *resolution-row-label*)
            "~S ~D X ~D"
            (lookup-text! *common-text* (text-id game-resolution) #f)
            w
            h)
    (dotimes (i (length options))
      (when (and (= (-> options i option-type) (game-option-type menu))
                 (= (-> options i name) (text-id game-resolution)))
        (set! (-> options i name-override) *resolution-row-label*))))
  (none))

(defun resolution-menu-initial-index ()
  "L'index de la rangee du sous-menu Resolution qui porte la resolution EFFECTIVE courante,
   -1 si aucune ne la porte. Reconstruit la liste d'abord : elle depend de l'aspect courant."
  (build-resolution-options)
  (let ((w 0)
        (h 0)
        (found -1))
    (current-game-base-size (& w) (& h))
    (dotimes (i (length *temp-options*))
      (when (and (< found 0)
                 (= (-> *temp-options* i option-type) (game-option-type resolution))
                 (= (the int (-> *temp-options* i param1)) w)
                 (= (the int (-> *temp-options* i param2)) h))
        (set! found i)))
    found))

;; --------------------------------------------------------------------------- l'audit -------
;; Il ne juge pas ses propres variables : pour CHAQUE rangee de CHAQUE aspect propose par
;; `*aspect-ratio-options*`, il passe par le chemin REEL (`set-window-size!` puis
;; `resolve-game-base-size`) et compare a ce que la rangee ANNONCE.
;;
;; LE TEMOIN QUI REND LE ZERO FALSIFIABLE. `legacy-game-base-size` est la regle telle qu'elle
;; etait AVANT cet item. `res_legacy_label_defects` compte les rangees qu'elle faisait mentir :
;; s'il vaut zero, l'audit ne regarde rien et `res_menu_defects = 0` ne vaut rien non plus.
(define *res-menu-audit-done* #f)
;; L'AUDIT ATTEND UNE SURFACE STABLE, PAS UN NUMERO D'IMAGE. Essai 1 : l'audit partait a la
;; 181e image, soit 22:49:56.671 sur le Honor — QUINZE MILLISECONDES avant la premiere creation
;; de FBO (`A35-RENDER FBO setup: ... window 2414x1080`). `pc-get-active-display-size` rendait
;; encore 2297x906, une taille transitoire d'avant l'application des encoches. L'echelle etait
;; donc batie sur un panneau qui n'a jamais rien dessine : les defauts comptes etaient bons,
;; mais ils ne parlaient pas de l'ecran de l'owner. Un compte d'images ne dit pas qu'une
;; surface a fini de bouger — seule son IMMOBILITE le dit.
(define *res-audit-last-panel-w* -1)
(define *res-audit-last-panel-h* -1)
(define *res-audit-stable-frames* 0)
(define *res-audit-eff-px* (new 'static 'boxed-array :type int32 :length 48 :allocated-length 48))
(define *res-audit-lbl-px* (new 'static 'boxed-array :type int32 :length 48 :allocated-length 48))
(define *res-audit-leg-px* (new 'static 'boxed-array :type int32 :length 48 :allocated-length 48))

(defun res-audit-aspect-of ((opt game-option) (panel-aspect float))
  "L'aspect que la rangee `opt` du menu Aspect Ratio installe REELLEMENT (-1.0 = pas une
   rangee d'aspect). Recopie du geste de respond-common, pas du libelle."
  (cond
    ((!= (-> opt option-type) (game-option-type aspect-new)) -1.0)
    ((= (-> opt name) (text-id fit-to-screen)) panel-aspect) ;; auto -> l'aspect du panneau
    ((= (-> opt param1) -1.0) ASPECT_4X3)                    ;; 4x3 PS2
    ((= (-> opt param1) -2.0) ASPECT_4X3)                    ;; 16x9 PS2 (rendu en 4x3)
    ((and (> (-> opt param1) 0.0) (> (-> opt param2) 0.0)) (/ (-> opt param1) (-> opt param2)))
    (else -1.0)))

(defun res-audit-store! ((w int) (h int))
  "Enregistre un choix de resolution comme le bouton du menu le fait.
   PLEIN ECRAN (le seul mode d'Android, et le seul ou le choix pilote la base) : la methode
   REELLE. FENETRE (x86 de bureau) : les deux memes champs, ecrits directement — passer par la
   methode y appellerait `pc-set-window-size!` cent trente fois et redimensionnerait une vraie
   fenetre SDL a chaque rangee auditee. Le mode fenetre ne fait de toute facon pas venir la
   base du choix (elle vient de framebuffer-scissor)."
  (cond
    ((= (pc-get-display-mode) 'windowed)
     (set! (-> *pc-settings* width) w)
     (set! (-> *pc-settings* height) h)
     (true! (-> *pc-settings* game-size-picked?)))
    (else (set-window-size! *pc-settings* w h)))
  (none))

(defun res-menu-audit! ()
  "Une fois par demarrage : verifie que chaque libelle de l'echelle de resolution rend ce
   qu'il annonce, dans chaque aspect, et que la rangee + la preselection disent la verite."
  (when (not *res-menu-audit-done*)
    (let ((poll-w 0)
          (poll-h 0))
      (pc-get-active-display-size (& poll-w) (& poll-h))
      (cond
        ((or (<= poll-w 0) (<= poll-h 0)) (set! *res-audit-stable-frames* 0))
        ((and (= poll-w *res-audit-last-panel-w*) (= poll-h *res-audit-last-panel-h*))
         (1+! *res-audit-stable-frames*))
        (else
         (set! *res-audit-last-panel-w* (the int poll-w))
         (set! *res-audit-last-panel-h* (the int poll-h))
         (set! *res-audit-stable-frames* 0)))))
  (when (and (not *res-menu-audit-done*)
             (>= *res-audit-stable-frames* 300)
             (> (the int (-> *display* real-frame-counter)) 600))
    (true! *res-menu-audit-done*)
    (let ((saved-w (-> *pc-settings* width))
          (saved-h (-> *pc-settings* height))
          (saved-ww (-> *pc-settings* window-width))
          (saved-wh (-> *pc-settings* window-height))
          (saved-pick (-> *pc-settings* game-size-picked?))
          (saved-aspect (-> *pc-settings* aspect-ratio))
          (panel-w 0)
          (panel-h 0)
          (aspects 0)
          (entries 0)
          (d-label 0)
          (d-mono 0)
          (d-presel 0)
          (d-row 0)
          (leg-label 0)
          (leg-mono 0)
          (px-640x480 0)
          (px-800x600 0)
          (leg-px-640x480 0))
      (pc-get-active-display-size (& panel-w) (& panel-h))
      (when (or (<= panel-w 0) (<= panel-h 0))
        (set! panel-w 640)
        (set! panel-h 480))
      ;; --- 1. la rangee « Resolution » PORTE-T-ELLE une valeur, et SUIT-ELLE la valeur ? ---
      ;; Deux etats distincts, deux libelles : un libelle qui ne bouge pas ne porte pas la
      ;; resolution, il porte un texte. C'est exactement le defaut rapporte.
      (res-audit-store! 800 600)
      (refresh-resolution-row-label!)
      (let ((label-a (new 'global 'string 96 (the-as string #f))))
        (copy-string<-string label-a *resolution-row-label*)
        (res-audit-store! 1024 768)
        (refresh-resolution-row-label!)
        (when (or (zero? (length *resolution-row-label*))
                  (string= label-a *resolution-row-label*))
          (set! d-row 1)))
      ;; --- 2. chaque aspect propose x chaque rangee de l'echelle ---------------------------
      (dotimes (ai (length *aspect-ratio-options*))
        (let ((asp (res-audit-aspect-of (-> *aspect-ratio-options* ai)
                                        (/ (the float panel-w) (the float panel-h)))))
          (when (> asp 0.0)
            (1+! aspects)
            (set! (-> *pc-settings* aspect-ratio) asp)
            (build-resolution-options)
            (let ((n (min 48 (length *temp-options*)))
                  (kept 0))
              (dotimes (i n)
                (when (= (-> *temp-options* i option-type) (game-option-type resolution))
                  (let ((lw (the int (-> *temp-options* i param1)))
                        (lh (the int (-> *temp-options* i param2)))
                        (ew 0)
                        (eh 0)
                        (gw 0)
                        (gh 0))
                    ;; le chemin REEL : ce que le bouton fait, puis ce que le moteur rend.
                    (res-audit-store! lw lh)
                    (current-game-base-size (& ew) (& eh))
                    (legacy-game-base-size *pc-settings* lw lh (& gw) (& gh))
                    (set! (-> *res-audit-lbl-px* i) (* lw lh))
                    (set! (-> *res-audit-eff-px* i) (* ew eh))
                    (set! (-> *res-audit-leg-px* i) (* gw gh))
                    (set! kept (+ kept 1))
                    (1+! entries)
                    (when (or (!= ew lw) (!= eh lh)) (1+! d-label))
                    (when (or (!= gw lw) (!= gh lh)) (1+! leg-label))
                    ;; la preselection doit retomber sur CETTE rangee.
                    (when (!= (resolution-menu-initial-index) i) (1+! d-presel))
                    ;; les deux chiffres que l'owner a nommes, en 4:3.
                    (when (< (fabs (- asp ASPECT_4X3)) 0.01)
                      (when (and (= lw 640) (= lh 480))
                        (set! px-640x480 (* ew eh))
                        (set! leg-px-640x480 (* gw gh)))
                      (when (and (= lw 800) (= lh 600))
                        (set! px-800x600 (* ew eh)))))))
              ;; MONOTONIE : un libelle plus grand doit rendre plus de pixels. Compte les
              ;; paires en ordre inverse, pour la regle livree et pour la regle d'avant.
              (when (> kept 0)
                (dotimes (i n)
                  (when (= (-> *temp-options* i option-type) (game-option-type resolution))
                    (dotimes (j n)
                      (when (and (= (-> *temp-options* j option-type) (game-option-type resolution))
                                 (< (-> *res-audit-lbl-px* i) (-> *res-audit-lbl-px* j)))
                        (when (>= (-> *res-audit-eff-px* i) (-> *res-audit-eff-px* j)) (1+! d-mono))
                        (when (>= (-> *res-audit-leg-px* i) (-> *res-audit-leg-px* j)) (1+! leg-mono)))))))))))
      ;; --- 3. remise en etat EXACTE ---------------------------------------------------------
      (set! (-> *pc-settings* aspect-ratio) saved-aspect)
      (set! (-> *pc-settings* width) saved-w)
      (set! (-> *pc-settings* height) saved-h)
      (set! (-> *pc-settings* window-width) saved-ww)
      (set! (-> *pc-settings* window-height) saved-wh)
      (set! (-> *pc-settings* game-size-picked?) saved-pick)
      (build-resolution-options)
      (refresh-resolution-row-label!)
      ;; --- 4. publication -------------------------------------------------------------------
      ;; Un audit qui n'a rien parcouru est un DEFAUT, pas un succes : sans cette ligne,
      ;; `res_menu_defects = 0` serait tenu par l'inaction.
      (when (zero? entries) (1+! d-label))
      (let ((base-w 0)
            (base-h 0))
        (current-game-base-size (& base-w) (& base-h))
        (__pc-autoport-publish "res_base_w" base-w)
        (__pc-autoport-publish "res_base_h" base-h))
      (__pc-autoport-publish "res_native_w" panel-w)
      (__pc-autoport-publish "res_native_h" panel-h)
      (__pc-autoport-publish "res_picked" (if saved-pick 1 0))
      (__pc-autoport-publish "res_aspects_audited" aspects)
      (__pc-autoport-publish "res_entries_audited" entries)
      (__pc-autoport-publish "res_defect_label" d-label)
      (__pc-autoport-publish "res_defect_mono" d-mono)
      (__pc-autoport-publish "res_defect_presel" d-presel)
      (__pc-autoport-publish "res_defect_row" d-row)
      (__pc-autoport-publish "res_legacy_label_defects" leg-label)
      (__pc-autoport-publish "res_legacy_mono_defects" leg-mono)
      (__pc-autoport-publish "res_4x3_640x480_px" px-640x480)
      (__pc-autoport-publish "res_4x3_800x600_px" px-800x600)
      (__pc-autoport-publish "res_4x3_legacy_640x480_px" leg-px-640x480)
      ;; Temoins de settle : l'image ou l'audit est parti et depuis combien d'images la
      ;; surface ne bougeait plus. Un audit parti tot ne se lit pas comme un audit parti tard.
      (__pc-autoport-publish "res_audit_frame" (the int (-> *display* real-frame-counter)))
      (__pc-autoport-publish "res_panel_stable_frames" *res-audit-stable-frames*)
      ;; La rangee sur laquelle le sous-menu s'ouvrirait POUR L'ETAT RESTAURE. -1 = la taille
      ;; enregistree n'est proposee par aucune rangee de l'aspect courant (curseur sur NATIVE).
      ;; Temoin publie, PAS un defaut : un settings.ini peut legitimement porter une taille
      ;; choisie sous un autre aspect, et rendre cette porte rouge serait juger l'owner.
      (__pc-autoport-publish "res_current_index" (+ 1 (resolution-menu-initial-index)))
      (__pc-autoport-publish "res_menu_defects" (+ d-label d-mono d-presel d-row))
      (__pc-autoport-hit 1)))
  (none))

(defun build-flava-player-options ((mus-idx int))
  (set! (-> *temp-options* length) 0)
  (dotimes (i (-> *music-flava-name-list* mus-idx length))
    (if (nonzero? (-> *music-flava-name-list* mus-idx i)) (add-flava-player-option (-> *music-flava-name-list* mus-idx i) i)))
  (add-back-option)
  *temp-options*)

(defmacro add-monitor-option (text-id display-id)
  "add a display button to *temp-options* with specified size"
  `(let ((option (-> *temp-options* (length *temp-options*)))
        (name (pc-get-display-name ,display-id *pc-cpp-temp-string*)))
    (temp-option-reset! option)
    (set! (-> option option-type) (game-option-type monitor))
    ;; Use the name of the display if it's available
    ;; menu-back-label : le libelle n'est accroche que dans la branche qui en POSE un. Sans nom
    ;; d'ecran, `name-override` reste nul et la rangee sort par son `name` — avant, elle sortait
    ;; par le tampon de l'occupant precedent, `name` pose ou non.
    (if name (copy-string<-string (temp-option-label! option) *pc-cpp-temp-string*) (set! (-> option name) ,text-id))
    (set! (-> option param1) (the float ,display-id))
    (set! (-> option scale) #t)
    (1+! (-> *temp-options* length))))

(defun build-monitor-options ()
  (set! (-> *temp-options* length) 0)
  (dotimes (i (pc-get-display-count))
    (add-monitor-option (text-id display-fmt) i))
  (add-back-option)
  *temp-options*)

(defmacro add-controller-option (text-id controller-id)
  "add a controller option to *temp-options* with specified size"
  `(let ((option (-> *temp-options* (length *temp-options*)))
        (name (pc-get-controller-name ,controller-id *pc-cpp-temp-string*)))
    (temp-option-reset! option)
    (set! (-> option option-type) (game-option-type controller))
    ;; Use the name of the controller if it's available
    ;; menu-back-label : meme regle que `add-monitor-option` juste au-dessus.
    (if name (copy-string<-string (temp-option-label! option) *pc-cpp-temp-string*) (set! (-> option name) ,text-id))
    (set! (-> option param1) (the float ,controller-id))
    (set! (-> option scale) #t)
    (1+! (-> *temp-options* length))))

(defun build-controller-options ()
  "Dynamically creates menu options for selecting your controller.
   Will attempt to use the name of the controller, but will fallback to a generic number otherwise"
  (set! (-> *temp-options* length) 0)
  (dotimes (i (pc-get-controller-count))
    (add-controller-option (text-id input-opts-generic-controller) i))
  (add-back-option)
  *temp-options*)

(define *analog-bind-names*
  (new 'static
       'boxed-array
       :type
       string
       "L ANALOG LEFT"
       "L ANALOG RIGHT"
       "L ANALOG UP"
       "L ANALOG DOWN"
       "R ANALOG LEFT"
       "R ANALOG RIGHT"
       "R ANALOG UP"
       "R ANALOG DOWN"))

(define *button-bind-names*
  (new 'static
       'boxed-array
       :type
       string
       "SELECT"
       "L3"
       "R3"
       "START"
       "DPAD UP"
       "DPAD RIGHT"
       "DPAD DOWN"
       "DPAD LEFT"
       "L2"
       "R2"
       "L1"
       "R1"
       "TRIANGLE"
       "CIRCLE"
       "CROSS"
       "SQUARE"))

;; TODO - make a common function for these dynamic menus instead of the duplication / macros
(defun build-binding-reassignment-options ((screen progress-screen))
  "Dynamically creates menu options for reassigning bindings for controllers/mice/keyboard"
  (set! (-> *temp-options* length) 0)
  ;; initialize binding options
  ;; for controllers and mice, dont allow analog rebindings
  ;; for keyboards, allow analog binding
  (when (= screen (progress-screen keyboard-binds))
    ;; Add analog bindings
    (dotimes (i 4)
      ;; two for each direction (low/high)
      (let ((option (-> *temp-options* (length *temp-options*))))
        (temp-option-reset! option)
        (set! (-> option bind-info port) 0)
        ;; only for keyboards
        (set! (-> option bind-info device-type) 1)
        (set! (-> option bind-info for-buttons?) #f)
        (set! (-> option bind-info input-idx) i)
        (set! (-> option bind-info analog-min-range?) #t)
        (set! (-> option option-type) (game-option-type binding-assignment))
        (copy-string<-string (temp-option-label! option) (-> *analog-bind-names* (* i 2)))
        (set! (-> option scale) #t)
        (1+! (-> *temp-options* length)))
      (let ((option (-> *temp-options* (length *temp-options*))))
        (temp-option-reset! option)
        (set! (-> option bind-info port) 0)
        ;; only for keyboards
        (set! (-> option bind-info device-type) 1)
        (set! (-> option bind-info for-buttons?) #f)
        (set! (-> option bind-info input-idx) i)
        (set! (-> option bind-info analog-min-range?) #f)
        (set! (-> option option-type) (game-option-type binding-assignment))
        (copy-string<-string (temp-option-label! option) (-> *analog-bind-names* (+ 1 (* i 2))))
        (set! (-> option scale) #t)
        (1+! (-> *temp-options* length)))))
  ;; Add Button bindings
  (dotimes (i 16)
    (let ((option (-> *temp-options* (length *temp-options*))))
      (temp-option-reset! option)
      (set! (-> option bind-info port) 0)
      (case screen
        (((progress-screen controller-binds)) (set! (-> option bind-info device-type) 0))
        (((progress-screen keyboard-binds)) (set! (-> option bind-info device-type) 1))
        (((progress-screen mouse-binds)) (set! (-> option bind-info device-type) 2)))
      (set! (-> option bind-info for-buttons?) #t)
      (set! (-> option bind-info input-idx) i)
      (set! (-> option bind-info analog-min-range?) #f)
      (set! (-> option option-type) (game-option-type binding-assignment))
      (copy-string<-string (temp-option-label! option) (-> *button-bind-names* i))
      (set! (-> option scale) #t)
      (1+! (-> *temp-options* length))))
  ;; We add a restore defaults button at the bottom of each binding menu
  (let ((option (-> *temp-options* (length *temp-options*))))
    (temp-option-reset! option)
    (set! (-> option option-type) (game-option-type confirmation))
    (set! (-> option name) (text-id restore-defaults))
    (set! (-> option scale) #t)
    ;; No closures :(
    (case screen
      ;; NOTE - assumes only port 0
      (((progress-screen controller-binds))
       (set! (-> option on-confirm) (lambda () (pc-reset-bindings-to-defaults! 0 0) (none))))
      (((progress-screen keyboard-binds))
       (set! (-> option on-confirm) (lambda () (pc-reset-bindings-to-defaults! 0 1) (none))))
      (((progress-screen mouse-binds)) (set! (-> option on-confirm) (lambda () (pc-reset-bindings-to-defaults! 0 2) (none)))))
    (1+! (-> *temp-options* length)))
  (add-back-option)
  *temp-options*)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  CAROUSELL FUNCTIONS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun get-language-name ((lang pc-language))
  "get the text-id from a lang"
  (dolist (item *language-remap-info-pc*)
    (when (= lang (the pc-language (/ (the int (cadr (car item))) 8)))
      (return (the text-id (/ (the int (car (car item))) 8)))))
  (text-id zero))

(defun carousell-option-string ((id text-id))
  "Resolve a carousell OPTION text-id to its display string. The reserved tag ids
   (#x17b0.., #x17b9.., #x17dc..) resolve to RUNTIME GLOBAL strings so they never render as
   'Unknown ID' when the Android COMMON.TXT bank is stale; every other id uses the normal text bank
   exactly as before."
  (cond
    ;; Grecharged-hd-models5: the eight HD LOOK option strings use the same runtime-global route, keyed
    ;; on the reserved tag ids #x17b0..#x17b6 + #x17bc (never present in any text bank).
    ((= id (the-as text-id #x17b0)) *hd-look-original-label*)
    ((= id (the-as text-id #x17b1)) *hd-look-hd-label*)
    ((= id (the-as text-id #x17b2)) *hd-look-jak2-label*)
    ((= id (the-as text-id #x17b3)) *hd-look-jak3-label*)
    ((= id (the-as text-id #x17b4)) *hd-look-pants-label*)
    ((= id (the-as text-id #x17b5)) *hd-look-young-label*)
    ((= id (the-as text-id #x17b6)) *hd-look-jak3m-label*)
    ;; cycle-5 item 3: the last cinematic Jak look (jakp-hd). #x17bd is free (owner rejected jakf).
    ((= id (the-as text-id #x17bc)) *hd-look-jak2p-label*)
    ;; Grecharged-secondary-motion: the three PHYSICS DETAIL option strings use the same runtime-global
    ;; route, keyed on the reserved tag ids #x17b9..#x17bb (never present in any text bank).
    ((= id (the-as text-id #x17b9)) *physics-light-label*)
    ((= id (the-as text-id #x17ba)) *physics-full-label*)
    ((= id (the-as text-id #x17bb)) *physics-max-label*)
    ;; framerate-uncap essai 2 : les huit libelles de la liste de cadence, tags #x17dc..#x17e3.
    ((= id (the-as text-id #x17dc)) *fps-choice-30-label*)
    ((= id (the-as text-id #x17dd)) *fps-choice-45-label*)
    ((= id (the-as text-id #x17de)) *fps-choice-60-label*)
    ((= id (the-as text-id #x17df)) *fps-choice-75-label*)
    ((= id (the-as text-id #x17e0)) *fps-choice-90-label*)
    ((= id (the-as text-id #x17e1)) *fps-choice-120-label*)
    ((= id (the-as text-id #x17e2)) *fps-choice-240-label*)
    ((= id (the-as text-id #x17e3)) *fps-choice-unlimited-label*)
    (else (lookup-text! *common-text* id #f))))


;; ================================================================================================
;; recharged-gating-real essai 2 — LE REGISTRE DES RANGEES A VALEURS (defauts 8 et 9 de l'owner).
;;
;; UNE seule liste de types decide de tout : quelles rangees portent leur valeur dans leur libelle
;; (« AMBIENT OCCLUSION: HBAO »), lesquelles ouvrent une PAGE de choix au lieu d'un carrousel serre
;; sous la ligne, quelle valeur y est preselectionnee, et ou la confirmation ecrit. Trois regles
;; ecrites a trois endroits finiraient par diverger — c'est exactement le defaut que l'owner a
;; refuse le 2026-09-10 sur le grisage.
;;
;; Ces fonctions sont posees ICI, apres `carousell-option-string` dont elles dependent, et non a
;; cote de `build-resolution-options` : GOAL ne connait pas une fonction avant sa definition.
;; ================================================================================================

(defun rch-choice-carousell-for ((ty game-option-type))
  "La liste de choix d'un type de rangee, #f si ce type n'en a pas. C'est ELLE qui route le bouton
   de confirmation vers la page de choix : un type absent d'ici garde le carrousel inline d'avant
   (MSAA, cadence, aspect, LOD, haut-parleur, langues...) et n'est touche par rien de cet item."
  (let ((lst (the (array text-id) #f)))
    (case ty
      (((game-option-type ambient-occlusion)) (set! lst *carousell-ambient-occlusion*))
      (((game-option-type ao-quality)) (set! lst *carousell-ao-quality*))
      (((game-option-type ao-strength)) (set! lst *carousell-ao-strength*))
      (((game-option-type grass-density)) (set! lst *carousell-grass-density*))
      (((game-option-type hd-look-jak)) (set! lst *carousell-hd-look-jak*))
      (((game-option-type hd-look-daxter)) (set! lst *carousell-hd-look-daxter*))
      (((game-option-type hd-look-keira)) (set! lst *carousell-hd-look-keira*))
      (((game-option-type hd-look-samos)) (set! lst *carousell-hd-look-samos*)))
    lst))

(defun rch-choice-current-index ((ty game-option-type))
  "L'indice de la valeur EN COURS, lu dans `*pc-settings*` — jamais dans `int-backup`, qui n'a de
   sens que pendant l'edition d'une rangee. Bras recopies du `case` de sauvegarde de
   `respond-common` : les huit types sont 1:1, aucune traduction de valeur."
  (let ((idx 0))
    (case ty
      (((game-option-type ambient-occlusion)) (set! idx (the int (-> *pc-settings* ambient-occlusion))))
      (((game-option-type ao-quality)) (set! idx (the int (-> *pc-settings* ao-quality))))
      (((game-option-type ao-strength)) (set! idx (the int (-> *pc-settings* ao-strength))))
      (((game-option-type grass-density)) (set! idx (the int (-> *pc-settings* recharged-grass-density-preset))))
      (((game-option-type hd-look-jak)) (set! idx (the int (-> *pc-settings* hd-look-jak))))
      (((game-option-type hd-look-daxter)) (set! idx (the int (-> *pc-settings* hd-look-daxter))))
      (((game-option-type hd-look-keira)) (set! idx (the int (-> *pc-settings* hd-look-keira))))
      (((game-option-type hd-look-samos)) (set! idx (the int (-> *pc-settings* hd-look-samos)))))
    idx))

(defun rch-choice-apply! ((ty game-option-type) (idx int))
  "L'ECRIVAIN UNIQUE des huit reglages a valeurs. Bras recopies du `case` d'ecriture arriere de
   `respond-common`, qui ne les porte plus : un seul ecrivain, sinon la valeur ecrite et la valeur
   affichee peuvent differer. Le `commit-to-file` final est celui que faisait l'ancien chemin."
  (case ty
    (((game-option-type ambient-occlusion)) (set! (-> *pc-settings* ambient-occlusion) idx))
    (((game-option-type ao-quality)) (set! (-> *pc-settings* ao-quality) idx))
    (((game-option-type ao-strength)) (set! (-> *pc-settings* ao-strength) idx))
    (((game-option-type grass-density)) (set! (-> *pc-settings* recharged-grass-density-preset) idx))
    (((game-option-type hd-look-jak)) (set! (-> *pc-settings* hd-look-jak) idx))
    (((game-option-type hd-look-daxter)) (set! (-> *pc-settings* hd-look-daxter) idx))
    (((game-option-type hd-look-keira)) (set! (-> *pc-settings* hd-look-keira) idx))
    (((game-option-type hd-look-samos)) (set! (-> *pc-settings* hd-look-samos) idx)))
  (commit-to-file *pc-settings*)
  (none))

(defun rch-row-value-string ((row game-option))
  "Le libelle de la valeur COURANTE d'une rangee, #f si la rangee ne porte pas de liste de choix.
   L'indice est BORNE : un `*pc-settings*` hors plage (fichier de reglages d'une autre version)
   ne doit pas faire lire hors du tableau de libelles."
  (let ((lst (rch-choice-carousell-for (-> row option-type))))
    (cond
      (lst
       (let ((idx (rch-choice-current-index (-> row option-type))))
         (when (or (< idx 0) (>= idx (length lst)))
           (set! idx (max 0 (min idx (+ (length lst) -1)))))
         (carousell-option-string (-> lst idx))))
      (else (the string #f)))))

;; ------------------------------------------------------------------------------------------------
;; LA PAGE DE CHOIX (defaut 9). Une seule page, `progress-screen option-choice`, reconstruite dans
;; `*temp-options*` a chaque image passee dessus, depuis la rangee d'ou l'on vient. Le type de cette
;; rangee est retenu ici : c'est lui qui dit quelle liste afficher et ou ecrire.
(define *rch-choice-type* (game-option-type on-off))
;; Le titre de la page : le libelle de la rangee parente, recopie au moment ou l'on entre (la rangee
;; peut disparaitre du tableau vivant pendant qu'on est dans la page — c'est tout l'objet du (7)).
(define *rch-choice-label* (new 'global 'string 128 (the-as string #f)))

(defun build-option-choice-options! ()
  "Batit la page de choix de `*rch-choice-type*` : un en-tete non selectionnable portant le nom de
   l'option, une rangee par valeur possible, puis Back."
  (set! (-> *temp-options* length) 0)
  ;; l'en-tete : meme motif que `add-message-option` (une rangee `button` que `option-locked?`
  ;; declare grisee, donc inerte au confirm).
  (let ((option (-> *temp-options* (length *temp-options*))))
    ;; menu-back-label : `temp-option-reset!` remplace les remises a zero champ par champ que cet
    ;; en-tete faisait a la main (`on-confirm`, `gating-id`) — meme geste, sans oubli possible.
    (temp-option-reset! option)
    (set! (-> option option-type) (game-option-type button))
    (set! (-> option option-disabled-func) (lambda () #t))
    (set! (-> option name) (text-id zero))
    (set! (-> option scale) #t)
    (format (temp-option-label! option) "~S" *rch-choice-label*)
    (1+! (-> *temp-options* length)))
  (let ((lst (rch-choice-carousell-for *rch-choice-type*)))
    (when lst
      (dotimes (i (length lst))
        (let ((option (-> *temp-options* (length *temp-options*))))
          (temp-option-reset! option)
          (set! (-> option option-type) (game-option-type choice-value))
          (set! (-> option name) (-> lst i))
          (set! (-> option scale) #t)
          (set! (-> option param1) (the float i))
          (format (temp-option-label! option) "~S" (carousell-option-string (-> lst i)))
          (1+! (-> *temp-options* length))))))
  (add-back-option)
  *temp-options*)

(defun rch-choice-initial-index ()
  "La rangee sur laquelle la page de choix s'OUVRE : celle de la valeur en cours. Pendant exact de
   `resolution-menu-initial-index` (res-menu-truth) — batir la liste d'abord, puis y retrouver la
   valeur effective. L'en-tete occupe la rangee 0, d'ou le +1. 0 si le type n'a pas de liste."
  (build-option-choice-options!)
  (let ((lst (rch-choice-carousell-for *rch-choice-type*)))
    (cond
      (lst
       (let ((idx (rch-choice-current-index *rch-choice-type*)))
         (when (or (< idx 0) (>= idx (length lst)))
           (set! idx (max 0 (min idx (+ (length lst) -1)))))
         (+ idx 1)))
      (else 0))))

(defun print-string-in-carousell ((arg0 text-id) (arg1 font-context) (arg2 int) (arg3 symbol))
  (let ((s5-0 (if arg3 arg2 (- arg2))))
    (+! (-> arg1 origin x) (the float s5-0))
    (let ((f30-0 (- 1.0 (* 0.0033333334 (the float arg2)))))
      (print-game-text-scaled (carousell-option-string arg0) f30-0 arg1 (the int (* 128.0 f30-0))))
    (set! (-> arg1 origin x) (- (-> arg1 origin x) (the float s5-0))))
  (set! (-> arg1 color) (font-color default))
  arg1)

(defun progress-draw-carousell-from-string-list ((options (array text-id)) (font font-context) (y-off int) (new-val int))
  "yep."
  (let ((old-lang (-> *progress-carousell* selection))
        (new-lang new-val)
        (max-lang (length options)))
    (if (-> *progress-carousell* transition)
      (seekl! (-> *progress-carousell* x-offset) 200 (the int (* 10.0 (-> *display* time-adjust-ratio)))))
    (when (>= (-> *progress-carousell* x-offset) 100)
      (set! (-> *progress-carousell* selection) new-lang)
      (set! old-lang new-lang)
      (set! (-> *progress-carousell* transition) #f)
      (set! (-> *progress-carousell* x-offset) 0))
    (set! (-> font origin y) (the float (+ y-off 3)))
    (set-color! font (font-color progress-blue))
    0
    (let ((next-lang (mod (+ old-lang 1) max-lang))
          (prev-lang (mod (+ max-lang -1 old-lang) max-lang))
          ;; these are used during the transition since it technically allows you to see 4 langs at once.
          (next2-lang (mod (+ old-lang 2) max-lang))
          (prev2-lang (mod (+ max-lang -2 old-lang) max-lang)))
      (cond
        ((-> *progress-carousell* direction)
         (let ((a2-22 (- 200 (+ (-> *progress-carousell* x-offset) 100))))
           (print-string-in-carousell (-> options prev-lang) font a2-22 #f))
         (set-color! font (font-color progress-blue))
         (let ((a2-23 (+ (-> *progress-carousell* x-offset) 100)))
           (cond
             ((< a2-23 150) (print-string-in-carousell (-> options next-lang) font a2-23 #t))
             (else
              (let ((a2-24 (- 200 (-> *progress-carousell* x-offset))))
                (print-string-in-carousell (-> options prev2-lang) font a2-24 #f))))))
        (else
         (let ((a2-25 (+ (-> *progress-carousell* x-offset) 100)))
           (cond
             ((< a2-25 150) (print-string-in-carousell (-> options prev-lang) font a2-25 #f))
             (else
              (let ((a2-26 (- 200 (-> *progress-carousell* x-offset))))
                (print-string-in-carousell (-> options next2-lang) font a2-26 #t)))))
         (set-color! font (font-color progress-blue))
         (let ((a2-27 (- 200 (+ (-> *progress-carousell* x-offset) 100))))
           (print-string-in-carousell (-> options next-lang) font a2-27 #t)))))
    (if (not (-> *progress-carousell* transition)) (set-color! font (font-color progress-selected)))
    (print-string-in-carousell (-> options old-lang)
                               font
                               (-> *progress-carousell* x-offset)
                               (-> *progress-carousell* direction))))

;;---------------------------
;;---------------------------
;; function overrides

;; NOTE - the following is generated from ./scripts/gsrc/jak1-sprite-adjust.py
;; They are polynomials fit with manually adjusted values for all common aspect ratios
;; so they can make a decent approximation interpolating between

(defun pc-sprite-adjust-left ((aspect-ratio float))
  (cond
    ((fequal-epsilon? aspect-ratio 1.0 0.01) 20.0)
    ((fequal-epsilon? aspect-ratio 1.25 0.01) 4.0)
    ((fequal-epsilon? aspect-ratio 1.33 0.01) 0.0)
    ((fequal-epsilon? aspect-ratio 1.5 0.01) -6.0)
    ((fequal-epsilon? aspect-ratio 1.6 0.01) -10.0)
    ((fequal-epsilon? aspect-ratio 1.78 0.01) -14.0)
    ((fequal-epsilon? aspect-ratio 1.85 0.01) -16.0)
    ((fequal-epsilon? aspect-ratio 2.33 0.01) -25.0)
    ((fequal-epsilon? aspect-ratio 2.35 0.01) -26.0)
    ((fequal-epsilon? aspect-ratio 3.56 0.01) -37.0)
    (else
     (+ 121.37227965381875
        (* -145.13874571806738 aspect-ratio)
        (* 48.695824268929236 aspect-ratio aspect-ratio)
        (* -5.737940185600177 aspect-ratio aspect-ratio aspect-ratio)))))

(defun pc-sprite-adjust-right ((aspect-ratio float))
  (cond
    ((fequal-epsilon? aspect-ratio 1.0 0.01) -33.0)
    ((fequal-epsilon? aspect-ratio 1.25 0.01) -6.0)
    ((fequal-epsilon? aspect-ratio 1.33 0.01) 0.0)
    ((fequal-epsilon? aspect-ratio 1.5 0.01) 12.0)
    ((fequal-epsilon? aspect-ratio 1.6 0.01) 18.0)
    ((fequal-epsilon? aspect-ratio 1.78 0.01) 26.0)
    ((fequal-epsilon? aspect-ratio 1.85 0.01) 29.0)
    ((fequal-epsilon? aspect-ratio 2.33 0.01) 45.0)
    ((fequal-epsilon? aspect-ratio 2.35 0.01) 46.0)
    ((fequal-epsilon? aspect-ratio 3.56 0.01) 65.0)
    (else
     (+ -205.4294994422315
        (* 245.07283711809043 aspect-ratio)
