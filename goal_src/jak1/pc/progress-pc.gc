;; hdr-display-output : libelle de la rangee HDR OUTPUT (name-override sur un text-id valide).
(define *hdr-output-label* (new 'global 'string 64 (the-as string #f)))
(format (clear *hdr-output-label*) "HDR Output")
;; hdr-output-regime : la ligne de sortie HDR DIT quel transport et quel regime sont utilises,
;; au lieu d'un simple Oui/Non. Owner 11/09 : « je vois aucune mention de HDR10/HLG in game ».
;; Le C++ empaquette les deux dans un entier (format_id * 16 + regime) ; on reformate ici et on
;; RAPPORTE ce qu'on a ecrit, pour que la preuve lise la ligne au lieu de la croire.
;; ASCII seul (la police n'a pas d'accent) et 18 caracteres au plus : « ~S: ON » replierait
;; au-dela de 22, et print-game-text replie, il ne rogne pas.
(defun rch-hdr-refresh-label! ()
  (let* ((st (pc-get-hdr-output-state))
         (tr (/ st 16))
         (rg (- st (* tr 16))))
    (cond
      ((zero? tr) (format (clear *hdr-output-label*) "HDR Output"))
      (else
        (format (clear *hdr-output-label*) "~S ~S"
                (cond ((= tr 1) "scRGB") ((= tr 4) "HLG") (else "HDR10"))
                (cond ((= rg 2) "display HDR") ((= rg 1) "headroom") (else "no headroom")))))
    (pc-hdr-output-label-note! tr rg (length *hdr-output-label*))
    (none)))

;; hdr-output-regime : l'etat empaquete de la derniere mise en forme. On ne reformate QUE s'il a
;; change : un `format` par image pour une chaine qui bouge une fois par heure serait du gaspillage,
;; et un libelle reformate sous le dessin du menu est une ligne qui scintille.
(define *hdr-output-state-last* -1)
(defun rch-hdr-refresh-label-if-changed! ()
  (let ((st (pc-get-hdr-output-state)))
    (when (!= st *hdr-output-state-last*)
      (set! *hdr-output-state-last* st)
      (rch-hdr-refresh-label!)))
  (none))
;; Le crochet est arme SEULEMENT ici, apres que la fonction et le libelle existent tous les deux.
(set! *hdr-label-hook-ready?* #t)
;; lighting-legacy-purge (2026-09-11) : *hemisphere-ambient-label* (« BAKED AMBIENT ») est
;; SUPPRIME. C'etait le libelle de la curiosite de projection de sonde de l'ancien monde ; il
;; ne portait plus AUCUNE rangee (aucun name-override ne le lisait) et occupait une chaine de
;; 64 octets dans le CGO. Sa rangee avait disparu avant lui.
;; Gmenu-census-cleanup : le libelle AMBIENT CONTRAST est SUPPRIME avec sa rangee (morte : ses
;; 4 lectures shader vivent dans un bloc que `u_rt_probe_on == 0` rend inatteignable). Le
;; supprimer, au lieu de le laisser orphelin, est ce qui rend le retrait verifiable sur
;; l'ARTEFACT : `strings GAME.CGO | grep "AMBIENT CONTRAST"` doit rendre ZERO.
;; lighting-legacy-purge (2026-09-11) : les libelles SHADOW DISTANCE, SHADOW QUALITY, TEXTURE
;; RELIEF, SPECULAR INTENSITY, DISPLACEMENT, MESH SUBDIVISION, AMBIENT STRENGTH, AMBIENT MODEL,
;; PBR MATERIALS et ADVANCED MATERIALS sont SUPPRIMES avec leurs rangees. Comme pour AMBIENT
;; CONTRAST plus haut, les supprimer (au lieu de les laisser orphelins) est ce qui rend le retrait
;; verifiable sur l'ARTEFACT : `strings GAME.CGO | grep "Shadow Quality"` doit rendre ZERO.
;; Gmenu-census-cleanup : le libelle ENV PROBE est SUPPRIME avec sa rangee (morte : le seul
;; ecrivain de `u_rt_probe_on` ecrit 0). Meme raison qu'AMBIENT CONTRAST — le retrait se prouve
;; sur l'artefact. Les libelles d'OPTIONS `pc-text-envprobe-low/-mid/-high` RESTENT : la rangee
;; MESH SUBDIVISION les reutilise tels quels pour afficher Off/Low/Mid/High.
;; lighting-legacy-purge (2026-09-11) : les libelles PBR TEST PRESET et PBR ISOLATE sont
;; SUPPRIMES avec leurs rangees de mise au point.
;; Grecharged-lightprobes OWNER #3 UNIFICATION (2026-07-21): the three BAKED AMBIENT labels
;; (*probe-enable-label*/*probe-reflections-label*/*probe-quality-label*) were removed with their
;; rows; the probe data now feeds the unified AMBIENT tiers (Hemisphere/SH/IBL).
)
;; lighting-legacy-purge (2026-09-11, essai 3) : les 4 libelles d'OPTION du carrousel PBR ISOLATE
;; (*pbr-iso-both/nm/pom/neither-label*) sont SUPPRIMES. La rangee PBR ISOLATE etait deja partie ;
;; ces globales restaient definies et FORMATEES au chargement du fichier, donc internees comme
;; symboles et presentes comme chaines dans le CGO, sans aucune rangee pour les afficher. Le
;; recensement ne les cherchait pas : elles auraient survecu a une porte verte. Verifiable sur
;; l'ARTEFACT : `strings GAME.CGO | grep "NORMAL-MAP ONLY"` doit rendre ZERO.
