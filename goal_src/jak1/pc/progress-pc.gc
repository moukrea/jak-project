(define *game-options-pc*
  (new 'static
       'boxed-array
       :type
       game-option
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id input-options)
            :scale #t
            :param3 (game-option-menu input-options))
       (new 'static
            'game-option
            :option-type (game-option-type on-off)
            :name (text-id play-hints)
            :scale #t
            :on-confirm
            (lambda ()
              (set! (-> *setting-control* default play-hints) (-> *pc-settings* memcard-play-hints?))))
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id subtitles) :scale #t)
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id hinttitles) :scale #t)
       (new 'static 'game-option :option-type (game-option-type language) :name (text-id language) :scale #t)
       (new 'static 'game-option :option-type (game-option-type language-subtitles) :name (text-id subtitles-language) :scale #t)
       (new 'static 'game-option :option-type (game-option-type language-text) :name (text-id text-language) :scale #t)
       (new 'static 'game-option :option-type (game-option-type speaker) :name (text-id subtitles-speaker) :scale #t)
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id misc-options)
            :scale #t
            :param3 (game-option-menu misc-options))
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t)))

;; Goptions-reorder (owner 2026-07-01): fixed desktop order —
;;   0 Aspect Ratio, 1 Game Resolution, 2 Dynamic Render Scale, 3 Render Scale/Min Render Scale,
;;   4 Min Target FPS (HIDDEN at runtime when Dynamic OFF), 5 FPS Counter, 6 V-Sync, 7 MSAA,
;;   8 Display mode, 9 Display, 10 Frame rate (desktop-only rows kept, grouped before Advanced),
;;   11 Advanced settings (renamed "PS2 Options" via name-override), 12 Back.
;; Row 4 (Min Target FPS) and row 3 (Render Scale) are position-locked: apply-dynamic-rs-menu-mode!
;; relabels/re-points row 3 and shows/hides row 4 by mutating the live `length` (see helper below).
;; Grecharged-buildsys-flags: build-time row exclusion. A (flag-row FLAG <row>) entry is
;; spliced into the static array ONLY when FLAG (a defglobalconstant from the generated
;; pc/recharged-flags.gc) is #t at compile time — off rows are truly absent from the CGO
;; (bare #when cannot drop elements inside a static boxed-array literal; the macro filters
;; at GOOS expansion time, before the static compiler counts elements).
(defmacro define-options-array (name elt-type &rest entries)
  `(define ,name
     (new 'static 'boxed-array :type ,elt-type
          ,@(apply (lambda (e) (if (eq? (car e) 'flag-row) (third e) e))
                   (filter (lambda (e) (if (eq? (car e) 'flag-row) (eval (second e)) #t))
                           entries)))))
;; full (Min-Target-FPS visible) lengths of the two graphics arrays; vulkan row is flagged.
;; Grecharged-menu-overhaul: -1 after removing the RECHARGED SETTINGS row from Graphics (dissolved).
(#if FLAG_VULKAN_SUPPORT
  (defglobalconstant GFX_OPTIONS_PC_FULL_LEN 14)
  (defglobalconstant GFX_OPTIONS_PC_FULL_LEN 13))
;; Grecharged-menu-overhaul: base android len, then -1 (RECHARGED SETTINGS removed / dissolved) and +4
;; for the restored Android desktop-only rows (group header + Display mode + Display/monitor + Frame
;; rate, appended inert before Back). They sit at the TAIL after the MTF region and after every index the
;; graphics wiring touches, so the MTF row stays at index 4 and no surviving wired index shifts unexpectedly.
(#if FLAG_VULKAN_SUPPORT
  (defglobalconstant GFX_OPTIONS_ANDROID_FULL_LEN 15)
  (defglobalconstant GFX_OPTIONS_ANDROID_FULL_LEN 14))
(define-options-array *graphic-options-pc*
       game-option
       ;; 0 Aspect Ratio
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id aspect-ratio)
            :scale #t
            :param3 (game-option-menu aspect-ratio))
       ;; 1 Game Resolution
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id game-resolution)
            :scale #t
            :param3 (game-option-menu resolution))
       ;; 2 DYNAMIC RENDER SCALE toggle. on-change writes the flag then re-points/relabels the
       ;; RENDER-SCALE slider row and shows/hides the Min Target FPS row.
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* dynamic-render-scale?) (the-as symbol val))
              (apply-dynamic-rs-menu-mode!)
              (none)))
       ;; 3 RENDER SCALE slider: edits render-scale (manual, OFF) OR min-render-scale (auto-scaler
       ;; FLOOR, ON). value-to-modify + label set by apply-dynamic-rs-menu-mode!. 10..100 step 10.
       (new 'static
            'game-option
            :option-type (game-option-type slider)
            :name (text-id vsync)
            :scale #t
            :param1 10.0
            :param2 100.0
            :slider-step-size 10.0
            :slider-show-decimal? #f)
       ;; 4 MINIMUM TARGET FRAMERATE slider: 25..60 step 5 -> *pc-settings* dyn-target-fps. label via
       ;; name-override. HIDDEN when Dynamic Render Scale is OFF (removed from the live list, not greyed).
       (new 'static
            'game-option
            :option-type (game-option-type slider)
            :name (text-id vsync)
            :scale #t
            :param1 25.0
            :param2 60.0
            :slider-step-size 5.0
            :slider-show-decimal? #f)
       ;; 5 FPS-counter overlay toggle. on-off; bound to *pc-settings* fps-counter? in init-game-options.
       ;; label provided at runtime via name-override (no engine text-id added).
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t)
       ;; 6 V-Sync
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t)
       ;; 7 MSAA
       (new 'static 'game-option :option-type (game-option-type msaa) :name (text-id msaa) :scale #t)
       ;; 8 Display mode (desktop only)
       (new 'static 'game-option :option-type (game-option-type display-mode) :name (text-id display-mode) :scale #t)
       ;; 9 Display / monitor (desktop only)
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id display)
            :scale #t
            :param3 (game-option-menu monitor)
            :option-disabled-func
            (lambda ()
              (= (pc-get-display-mode) 'windowed)))
       ;; 10 Frame rate (desktop only)
       (new 'static
            'game-option
            :option-type (game-option-type frame-rate)
            :name (text-id frame-rate)
            :scale #t
            :option-disabled-func
            (lambda ()
              (or (-> *pc-settings* speedrunner-mode?) (<= (pc-get-active-display-refresh-rate) 60))))
       ;; Grecharged-menu-overhaul: the "RECHARGED SETTINGS" submenu row is REMOVED from Graphics — the
       ;; Recharged screen is DISSOLVED from here and reached only via the top-level RENDU category of the
       ;; unified OPTIONS hub. Advanced now sits at index 11, Vulkan 12, Back 13 (rewired below; full-len -1).
       ;; 11 Advanced settings (was "PS2 Options"; relabelled via name-override in init-game-options,
       ;; submenu unchanged).
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id ps2-options)
            :scale #t
            :param3 (game-option-menu gfx-ps2-options))
       ;; 13 VULKAN RENDERER toggle (Gvulkan-option). OFF = OpenGL (default), ON = Vulkan. label via
       ;; name-override; value-to-modify = gfx-renderer-vulkan? (bound in init-game-options). on-change
       ;; maps the toggle to *pc-settings* gfx-renderer, persists it, and tells the C++ runtime, which
       ;; selects the backend at the next launch (surface recreation ⇒ restart to switch).
       ;; row present only with --vulkan-support (Back shifts to 13 otherwise).
       (flag-row FLAG_VULKAN_SUPPORT
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* gfx-renderer-vulkan?) (the-as symbol val))
              (set! (-> *pc-settings* gfx-renderer)
                    (if val (pc-gfx-renderer vulkan) (pc-gfx-renderer opengl)))
              (pc-set-gfx-renderer! (-> *pc-settings* gfx-renderer))
              (commit-to-file *pc-settings*)
              (none))))
       ;; 14 Back
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t))

;; Android-only graphics options. Same owner order as *graphic-options-pc* but with the menu
;; items that don't make sense on a single-display phone HIDDEN (truly omitted, since the progress
;; menu renderer has no per-item hide flag — only disable):
;;   - "Display mode" (windowed/fullscreen/borderless: Android is always fullscreen)
;;   - "Display" (monitor select: Android has exactly one display)
;;   - "Frame rate (experimental)" (permanently greyed on the 60Hz panel)
;; Goptions-reorder order: 0 Aspect Ratio, 1 Game Resolution, 2 Dynamic Render Scale,
;;   3 Render Scale/Min Render Scale, 4 Min Target FPS (HIDDEN when Dynamic OFF), 5 FPS Counter,
;;   6 V-Sync, 7 MSAA, 8 Advanced settings (renamed "PS2 Options"), 9 Back. Wired in init-game-options.
(define-options-array *graphic-options-pc-android*
       game-option
       ;; 0 Aspect Ratio
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id aspect-ratio)
            :scale #t
            :param3 (game-option-menu aspect-ratio))
       ;; 1 Game Resolution
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id game-resolution)
            :scale #t
            :param3 (game-option-menu resolution))
       ;; 2 DYNAMIC RENDER SCALE toggle.
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* dynamic-render-scale?) (the-as symbol val))
              (apply-dynamic-rs-menu-mode!)
              (none)))
       ;; 3 RENDER SCALE slider: render-scale (OFF) / min-render-scale (ON); wired by
       ;; apply-dynamic-rs-menu-mode!. 10..100 step 10. NO on-change.
       (new 'static
            'game-option
            :option-type (game-option-type slider)
            :name (text-id vsync)
            :scale #t
            :param1 10.0
            :param2 100.0
            :slider-step-size 10.0
            :slider-show-decimal? #f)
       ;; 4 MINIMUM TARGET FRAMERATE slider: 25..60 step 5 -> dyn-target-fps. HIDDEN when Dynamic OFF.
       (new 'static
            'game-option
            :option-type (game-option-type slider)
            :name (text-id vsync)
            :scale #t
            :param1 25.0
            :param2 60.0
            :slider-step-size 5.0
            :slider-show-decimal? #f)
       ;; 5 FPS Counter
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t)
       ;; 6 V-Sync
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t)
       ;; 7 MSAA
       (new 'static 'game-option :option-type (game-option-type msaa) :name (text-id msaa) :scale #t)
       ;; Grecharged-menu-overhaul: "RECHARGED SETTINGS" REMOVED from Android Graphics too (dissolved into
       ;; the RENDU category). Advanced now index 8, Vulkan 9, group header/restored rows/Back follow.
       ;; 8 Advanced settings (was "PS2 Options"; relabelled via name-override, submenu unchanged).
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id ps2-options)
            :scale #t
            :param3 (game-option-menu gfx-ps2-options))
       ;; 10 VULKAN RENDERER toggle (Gvulkan-option). OFF = OpenGL/GLES (default), ON = Vulkan. label via
       ;; name-override; value-to-modify = gfx-renderer-vulkan? (bound in init-game-options). on-change
       ;; maps the toggle to *pc-settings* gfx-renderer, persists it, and tells the C++ runtime (which
       ;; applies the new backend on the next launch). NOTE: on Android the Vulkan runtime is deferred —
       ;; the toggle persists the preference but the build keeps rendering with GLES for now.
       ;; row present only with --vulkan-support (Back shifts to 10 otherwise).
       (flag-row FLAG_VULKAN_SUPPORT
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* gfx-renderer-vulkan?) (the-as symbol val))
              (set! (-> *pc-settings* gfx-renderer)
                    (if val (pc-gfx-renderer vulkan) (pc-gfx-renderer opengl)))
              (pc-set-gfx-renderer! (-> *pc-settings* gfx-renderer))
              (commit-to-file *pc-settings*)
              (none))))
       ;; Grecharged-menu-overhaul: the 3 desktop-only rows RETURN on Android (owner decision: we no longer
       ;; hide menus on mobile). They are INERT here (option-disabled-func always #t => greyed, non-
       ;; activatable) and carry the hint "(SANS EFFET SUR MOBILE)". A non-selectable group header labels
       ;; them. Appended at the TAIL so no existing wired index shifts and the MTF row stays at index 4.
       (new 'static 'game-option :option-type (game-option-type group-header) :name (text-id pc-text-grp-screen) :scale #t)
       ;; Display mode (inert on mobile)
       (new 'static 'game-option :option-type (game-option-type display-mode) :name (text-id display-mode) :scale #t
            :hint (text-id pc-text-hint-no-mobile)
            :option-disabled-func (lambda () #t))
       ;; Display / monitor (inert on mobile)
       (new 'static 'game-option :option-type (game-option-type menu) :name (text-id display) :scale #t
            :param3 (game-option-menu monitor)
            :hint (text-id pc-text-hint-no-mobile)
            :option-disabled-func (lambda () #t))
       ;; Frame rate (inert on mobile)
       (new 'static 'game-option :option-type (game-option-type frame-rate) :name (text-id frame-rate) :scale #t
            :hint (text-id pc-text-hint-no-mobile)
            :option-disabled-func (lambda () #t))
       ;; Back
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t))

;; Grecharged-hud-jak1: the "Recharged Settings" submenu (reached from Graphics Options, row before
;; Advanced). One row for now: a "RECHARGED HUD" on-off toggle (label via name-override, value bound
;; to *pc-settings* recharged-hud? in init-game-options), then Back. The on-change persists the flag
;; immediately so the choice survives a relaunch even without a full menu commit.
(define-options-array *recharged-options-pc*
       game-option
       ;; 0 RECHARGED MASTER (Grecharged-master-toggle, owner 2026-07-21): the GLOBAL Recharged
       ;; ON/OFF. OFF forces the stock state of EVERY recharged feature at runtime (C++ composes
       ;; via the single Gfx::recharged_active helper; GOAL-side HUD gates AND with it) WITHOUT
       ;; resetting the individual toggles below — they grey out (option-disabled-func) and come
       ;; back exactly as configured when the master returns ON. Real label via
       ;; *recharged-master-label* (name-override; :name is the usual placeholder text-id => no
       ;; unknown-ID risk). All later rows shift +1 (see the init-game-options index arithmetic).
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-master?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none)))
       ;; 0 RECHARGED HUD toggle. :name is a placeholder (text-id vsync) like the other name-override
       ;; on-off rows; the real label comes from *recharged-hud-label*. row present only with --recharged-hud.
       (flag-row FLAG_RECHARGED_HUD
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            ;; Grecharged-master-toggle: greyed while the master is OFF (like the realtime-lighting block rows)
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?)))
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-hud?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none))))
       ;; 1 GRASS SETTINGS sub-submenu launcher (Grecharged-grass-poc POLISH#6). All grass settings
       ;; (toggle + near-dist + card-dist + density) moved into their OWN nested page (*grass-options-pc*)
       ;; so they reliably appear on device — owner: "les réglages n'apparaissent toujours pas ... ça
       ;; devrait être un sous-menu de ce sous-menu avec tous les settings pour l'herbe". A menu-type row:
       ;; :param3 opens the grass-settings screen; real label via *grass-settings-label* (name-override).
       (new 'static 'game-option :option-type (game-option-type menu) :name (text-id ps2-options) :scale #t
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?)))
            :param3 (game-option-menu grass-settings))
       ;; 2 LOAD CUSTOM ASSETS on-off toggle (Gload-custom-assets). Real label via *load-custom-assets-label*
       ;; (name-override); value bound to *pc-settings* load-custom-assets? in init-game-options. The
       ;; on-change pushes the 0/1 flag to the runtime and persists it immediately.
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?)))
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* load-custom-assets?) (the-as symbol val))
              (pc-set-load-custom-assets! (if val 1 0))
              (commit-to-file *pc-settings*)
              (none)))
       ;; 2c RECHARGED TEXTURES (Grecharged-bundled-textures) on-off toggle: the package-BUNDLED
       ;; first-party replacement textures (owner's Recharged set). ON => bundled base swaps;
       ;; OFF => stock (the user custom_assets dir keeps its own LOAD CUSTOM ASSETS gate and
       ;; always WINS over the bundle; the bundle's _height/_normal/_roughness PBR maps follow
       ;; the PBR toggle, not this row). Real label via *recharged-textures-label*
       ;; (name-override); value bound in init-game-options. on-change pushes 0/1 + persists;
       ;; applies on the next level load. All later indices shift +1 (see init-game-options).
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?)))
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-textures?) (the-as symbol val))
              (pc-set-recharged-textures! (if val 1 0))
              (commit-to-file *pc-settings*)
              (none)))
       ;; lighting-legacy-purge (2026-09-11) : PBR MATERIALS RETIREE — le rendu PBR est
       ;; INCONDITIONNEL sous RECHARGED LIGHTING.
       ;; 3 ENHANCED MODELS (Grecharged-hd-models) on-off toggle. Loads jak2 detailed character models
       ;; (Jak/Daxter/Samos/Keira, jak1-look) in place of the stock low-poly meshes. Real label via
       ;; *enhanced-models-label*; value bound to *pc-settings* recharged-enhanced-models? in
       ;; init-game-options, where the row is HIDDEN unless the build ships the enhanced FR3 set
       ;; (pc-enhanced-models-available?). on-change persists + pushes to the loader (relaunch to apply
       ;; to Jak/Daxter — they live in the always-loaded common FR3; village NPCs apply on level reload).
       ;; row present only with --hd-models.
       (flag-row FLAG_HD_MODELS
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?)))
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-enhanced-models?) (the-as symbol val))
              (pc-set-recharged-enhanced-models! (if val 1 0))
              (commit-to-file *pc-settings*)
              (none))))
       ;; 4 FOLIAGE WIND (Grecharged-foliage-wind) on-off toggle. Light wind sway on jak1 palms (TIE)
       ;; + shrubs so the foliage reacts to a light breeze. Top-level Recharged row (owner: "un toggle
       ;; supplémentaire dans les Recharged Settings"), NOT in the grass page — it isn't a grass
       ;; setting, and the grass page already sits at PROGRESS_PC_PAGE_HEIGHT (7 rows). Real label via
       ;; *foliage-wind-label*; value bound to *pc-settings* recharged-foliage-wind? in
       ;; init-game-options. OFF (default) = stock render. on-change persists + pushes live (the
       ;; per-frame update-to-os bridge also pushes it, so the effect applies without relaunch).
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?)))
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-foliage-wind?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none)))
       ;; 5 AMBIENT OCCLUSION (Grecharged-ambient-occlusion) carousell row: Off/SSAO/HBAO/GTAO. Multi-value
       ;; carousell like MSAA — :name is a placeholder (text-id msaa); the real label comes from
       ;; *ambient-occlusion-label* (name-override, wired in init-game-options). backup/select/write-back
       ;; mirror the msaa arms in respond-common (map 1:1 to *pc-settings* ambient-occlusion).
       (new 'static 'game-option :option-type (game-option-type ambient-occlusion) :name (text-id msaa) :scale #t
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?))))
       ;; 6 AO QUALITY carousell row: Low/Medium/High. Disabled (greyed) while AO is Off, mirroring the
       ;; display-mode disabled predicate. Real label via *ao-quality-label* (name-override).
       (new 'static
            'game-option
            :option-type (game-option-type ao-quality)
            :name (text-id msaa)
            :scale #t
            :option-disabled-func
            (lambda ()
              (or (not (-> *pc-settings* recharged-master?)) (zero? (-> *pc-settings* ambient-occlusion)))))
       ;; 7 AO STRENGTH carousell row (closing round): Weaker/Default/Stronger per-mode multiplier on the
       ;; estimator intensity. Disabled (greyed) while AO is Off, same conditional mechanism as AO QUALITY.
       ;; Real label via *ao-strength-label* (name-override).
       (new 'static
            'game-option
            :option-type (game-option-type ao-strength)
            :name (text-id msaa)
            :scale #t
            :option-disabled-func
            (lambda ()
              (or (not (-> *pc-settings* recharged-master?)) (zero? (-> *pc-settings* ambient-occlusion)))))
       ;; lighting-legacy-purge (2026-09-11) : les rangees REALTIME LIGHTING, AMBIENT MODEL,
       ;; AMBIENT STRENGTH, AMBIENT CONTRAST, SHADOW DISTANCE, SHADOW QUALITY, TEXTURE RELIEF,
       ;; SPECULAR INTENSITY, DISPLACEMENT, MESH SUBDIVISION, PBR TEST PRESET et PBR ISOLATE sont
       ;; RETIREES de ce corps GELE comme du corps livre : leurs champs pc-settings n'existent plus.
       ;; water-ocean-mesh (SPEC-refonte-eau 1.2 regle 1) : EAU RECHARGEE. Rangee AUTO-LOCALISEE
       ;; par son marqueur `hint`, jamais par un index : c'est le contrat des rangees HDR OUTPUT et
       ;; PHYSICS, et c'est ce qui la rend immune aux renumerotations du bloc PBR.
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :hint (text-id pc-text-hint-recharged-water)
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?)))
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-water?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none)))
       ;; Grecharged-lightprobes OWNER #3 UNIFICATION (2026-07-21): the three BAKED AMBIENT rows
       ;; (on/off, reflections, quality) were FOLDED into the unified AMBIENT group above — the
       ;; probe data now FEEDS the Ambient Model fidelity tiers (Hemisphere/SH/IBL), reflections
       ;; are a resource for PBR/water only. See menu-tree.md §11 [SUPPR] history.
       ;; Grecharged-secondary-motion: PHYSICS on-off toggle. Secondary-motion (chain) physics —
       ;; hair / cloth / straps swing with the animation instead of staying rigid. Real label via
       ;; *physics-label*; value bound to *pc-settings* physics? in init-game-options. Default ON
       ;; (the feature is opt-in at BUILD time, so a build that ships it wants it on). NOT tied to
       ;; the ENHANCED MODELS toggle — physics will also drive stock NPCs, so the only disable
       ;; predicate is the recharged master, exactly like FOLIAGE WIND. on-change persists + pushes
       ;; to the C++ solver (the per-frame update-to-os bridge pushes it too, so it applies live).
       ;; APPENDED AT THE TAIL, immediately before Back, so no existing row index
       ;; moves (the index-shift bug class fixed in Gmenu-flag-off; see init-game-options).
       ;; row present only with --physics.
       (flag-row FLAG_PHYSICS
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?)))
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* physics?) (the-as symbol val))
              (pc-set-physics! (if val 1 0) (-> *pc-settings* physics-quality))
              (commit-to-file *pc-settings*)
              (none))))
       ;; Grecharged-secondary-motion: PHYSICS DETAIL carousell row — LIGHT / FULL / MAXIMUM (the
       ;; data-driven chain levels). Meme motif de carrousel : :name is a placeholder, the
       ;; real label comes from the *physics-detail-label* name-override, there is no :on-change
       ;; (respond-common backs up / writes the value back), and the row is greyed while its feature
       ;; toggle is off — here PHYSICS, exactly as DISPLACEMENT is greyed unless PBR MATERIALS is on.
       ;; row present only with --physics.
       (flag-row FLAG_PHYSICS
       (new 'static 'game-option :option-type (game-option-type physics-quality) :name (text-id msaa) :scale #t
            :option-disabled-func
            (lambda ()
              (or (not (-> *pc-settings* recharged-master?)) (not (-> *pc-settings* physics?))))))
       ;; Grecharged-managed-assets: HD TEXTURE PACK on-off toggle — the DOWNLOADED
       ;; pack (managed_assets/<game>/, installed by the asset manager or
       ;; `gk --assets install`). ON => the compressed KTX2 pack replaces the baked
       ;; textures; OFF => bundled/stock instantly and with NO re-download, so it is a
       ;; real A/B switch. The user custom_assets dir still WINS over the pack (owner's
       ;; precedence rule), and WHICH preset to fetch is an install-time decision that
       ;; belongs to the downloader, not to a render toggle. Real label via
       ;; *managed-assets-label* (name-override); value bound in init-game-options from
       ;; mesh-browser-removal : la rangee de debug qui suivait celle-ci est SUPPRIMEE, donc
       ;; cette rangee est desormais l'avant-derniere (juste avant Back) ; aucun index anterieur
       ;; ne bouge, seules les constantes de longueur totale perdent 1.
       ;; the array LENGTH, and the row sits last-but-one (just before Back) so
       ;; no existing index shifts — only the total-length constants gain +1, exactly as
       ;; the tail PHYSICS rows did before it.
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?)))
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* managed-assets?) (the-as symbol val))
              (pc-set-managed-assets! (if val 1 0))
              (commit-to-file *pc-settings*)
              (none)))
       ;; Back
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t))

;; Grecharged-grass-poc POLISH#6: the dedicated NESTED "Grass Settings" page, reached from the Recharged
;; Settings submenu. Holds ALL grass settings on their own page (owner wanted a sub-submenu so they show
;; reliably): the RECHARGED GRASS on-off toggle, the near-blade + card view-distance sliders, the
;; DENSITY PRESET carousell, the GRASS OVERHANG toggle, then Back (6 rows, under
;; PROGRESS_PC_PAGE_HEIGHT (7) so all show — the scroll machinery only engages when length > 7).
;; Ggrass-density-presets : la rangee GRASS MODE (PRECOMPUTED/LIVE) est RETIREE — le placement en
;; direct etait le chemin de 1 207 Mo sur lequel les plantages ont ete reproduits ; il ne se propose
;; plus. La cle `recharged-grass-precomputed?` reste dans settings.ini comme interrupteur de mesure.
;; Values/labels are wired at runtime in init-game-options; on-change persists to *pc-settings*.
(define-options-array *grass-options-pc*
       game-option
       ;; 0 RECHARGED GRASS toggle (real label via *recharged-grass-label*).
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-grass?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none)))
       ;; 1 NEAR GRASS DISTANCE slider (near-blade view distance, m).
       (new 'static 'game-option :option-type (game-option-type slider) :name (text-id vsync) :scale #t
            :param1 15.0 :param2 45.0 :slider-step-size 5.0 :slider-show-decimal? #f
            :on-change
            (lambda ((val object))
              (commit-to-file *pc-settings*)
              (none)))
       ;; 2 GRASS CARD DISTANCE slider (grass-card view distance, m; pushed further out).
       (new 'static 'game-option :option-type (game-option-type slider) :name (text-id vsync) :scale #t
            :param1 50.0 :param2 140.0 :slider-step-size 10.0 :slider-show-decimal? #f
            :on-change
            (lambda ((val object))
              (commit-to-file *pc-settings*)
              (none)))
       ;; 3 GRASS DENSITY — cinq paliers nommes (Ggrass-density-presets, owner 2026-08-30 : « on
       ;; s'en fiche de changer la densite au poil de cul, on veut juste plus ou moins dense »).
       ;; Chaque palier a SON bake livre, donc la densite demandee est TOUJOURS celle du bake charge :
       ;; il n'existe plus de valeur intermediaire capable de faire basculer le placement EN DIRECT.
       ;; Pas de :on-change — les rangees carrousel ecrivent dans la branche de retour partagee.
       (new 'static 'game-option :option-type (game-option-type grass-density) :name (text-id vsync) :scale #t)
       ;; 4 GRASS OVERHANG: 3D drooping grass over platform edges (near); far keeps the stock alpha texture
       ;; row present only with --grass-overhang.
       (flag-row FLAG_GRASS_OVERHANG
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-grass-overhang?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none))))
       ;; 5 Back
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t))

;; ============================================================================================
;; Grecharged-menu-overhaul RECADRAGE (owner 2026-08-01): the ONE unified GRAPHISMES zone.
;; The old AFFICHAGE (vanilla display) + RENDU (recharged) split is DISSOLVED — there is now a
;; SINGLE graphics page organized BY FUNCTION (not by origin), with the Recharged MASTER at its
;; head and non-selectable group-header separators between the function subsections:
;;   MASTER · ÉCRAN · PERFORMANCE · MATÉRIAUX & DÉTAIL · ÉCLAIRAGE · VÉGÉTATION · INTERFACE.
;; It is ASSEMBLED AT RUNTIME by REFERENCE from the already-wired source rows (the vanilla
;; graphics array + *recharged-options-pc* + *grass-options-pc*): game-option is a `basic`, so a
;; shared row object carries its value-to-modify / name-override / on-change / option-disabled-func
;; / hint into the fused page — no per-row rewiring is duplicated and respond-common/draw-options
;; dispatch entirely on option-type, so reordering is safe. The source arrays are kept but are no
;; longer reached from the hub; they exist only as the wiring substrate for these shared rows.
;; ============================================================================================
;; The six FUNCTION group-header rows (non-selectable; nav skips them; drawn in the heading color).
;; Text-ids already localized in all 6 game languages (added in the menu-overhaul string batch).
(define *grp-ecran*      (new 'static 'game-option :option-type (game-option-type group-header) :name (text-id pc-text-grp-screen) :scale #t))
(define *grp-perf*       (new 'static 'game-option :option-type (game-option-type group-header) :name (text-id pc-text-grp-performance) :scale #t))
(define *grp-materials*  (new 'static 'game-option :option-type (game-option-type group-header) :name (text-id pc-text-grp-materials) :scale #t))
(define *grp-lighting*   (new 'static 'game-option :option-type (game-option-type group-header) :name (text-id pc-text-grp-lighting) :scale #t))
(define *grp-vegetation* (new 'static 'game-option :option-type (game-option-type group-header) :name (text-id pc-text-grp-vegetation) :scale #t))
(define *grp-interface*  (new 'static 'game-option :option-type (game-option-type group-header) :name (text-id pc-text-grp-hud) :scale #t))
;; the fused page's own Back row (the source arrays' Back rows are not referenced here)
(define *graphics-unified-back* (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t))
;; the unified GRAPHISMES page. Allocated with headroom (48 >= the ~42 rows ever shown); the real
;; live length is set by build-graphics-unified! each time it re-assembles.
(define *graphics-unified-pc* (new 'static 'boxed-array :type game-option :length 0 :allocated-length 48))

;; Re-assemble *graphics-unified-pc* in FUNCTION order by reference. `dyn?` = Dynamic Render Scale
;; state: the Min-Target-FPS row is present only when it is ON (mirrors the source MTF hide). MUST
;; run after init-game-options has wired the source rows (called from apply-dynamic-rs-menu-mode!,
;; itself called once at the end of init and on every Dynamic-Render-Scale toggle). Idempotent.
;; Source-row indices reuse the SAME flag-N arithmetic the init wiring uses, so they track flags
;; (FLAG_PBR / FLAG_RECHARGED_HUD) identically; apply-dynamic-rs-menu-mode! holds the source arrays
;; at FULL layout before calling this, so the vanilla indices below stay canonical.
(defun build-graphics-unified! ((dyn? symbol))
  (let ((dst *graphics-unified-pc*)
        (gfx (#if PLATFORM_ANDROID *graphic-options-pc-android* *graphic-options-pc*))
        (rch *recharged-options-pc*)
        (grs *grass-options-pc*)
        (n 0))
    ;; lighting-legacy-purge (2026-09-11) : PBR MATERIALS n'existe plus, le terme FLAG_PBR_N sort.
    (let ((fw (+ 4 FLAG_RECHARGED_HUD_N))   ;; foliage-wind base index in *recharged-options-pc*
          (hud FLAG_RECHARGED_HUD_N))
      ;; Grecharged-menu-overhaul V3 (owner 2026-08-02): while copying each source row by its
      ;; flag-aware index, also stamp its BESPOKE per-row hint on the shared row object (so it
      ;; travels into the fused page AND matches the exact flag config). The value rows below carry
      ;; a placeholder :name (real label via name-override), so menu-resolve-hint cannot key them by
      ;; name — the hint MUST be set here. The named rows (Aspect/Resolution/Advanced/Display/monitor/
      ;; Frame-rate) resolve BY NAME (or, on Android, by their static :hint), so they are left alone.
      ;; RENDU RECHARGED (MASTER) — the global coupe-circuit, at the very head.
      (set! (-> dst n) (-> rch 0)) (set! (-> dst n hint) (text-id pc-text-hint-master)) (set! n (+ n 1))
      ;; --- ÉCRAN ---
      (set! (-> dst n) *grp-ecran*) (set! n (+ n 1))
      (set! (-> dst n) (-> gfx 0)) (set! n (+ n 1))                    ;; Aspect Ratio (by-name)
      (set! (-> dst n) (-> gfx 1)) (set! n (+ n 1))                    ;; Game Resolution (by-name)
      (#if PLATFORM_ANDROID
        (begin (set! (-> dst n) (-> gfx 10)) (set! n (+ n 1))         ;; Display mode (inert, static mobile hint)
               (set! (-> dst n) (-> gfx 11)) (set! n (+ n 1)))         ;; Display / monitor (inert, static mobile hint)
        (begin (set! (-> dst n) (-> gfx 8)) (set! n (+ n 1))          ;; Display mode (desktop, by-name)
               (set! (-> dst n) (-> gfx 9)) (set! n (+ n 1))))         ;; Display / monitor (desktop, by-name)
      ;; --- PERFORMANCE ---
      (set! (-> dst n) *grp-perf*) (set! n (+ n 1))
      (set! (-> dst n) (-> gfx 2)) (set! (-> dst n hint) (text-id pc-text-hint-dynrs)) (set! n (+ n 1))        ;; Dynamic Render Scale
      (set! (-> dst n) (-> gfx 3)) (set! (-> dst n hint) (text-id pc-text-hint-renderscale)) (set! n (+ n 1)) ;; Render Scale / Min Render Scale
      (when dyn? (set! (-> dst n) (-> gfx 4)) (set! (-> dst n hint) (text-id pc-text-hint-mtf)) (set! n (+ n 1))) ;; Min Target FPS (Dynamic RS ON)
      (set! (-> dst n) (-> gfx 6)) (set! (-> dst n hint) (text-id pc-text-hint-vsync)) (set! n (+ n 1))       ;; V-Sync
      (set! (-> dst n) (-> gfx 7)) (set! (-> dst n hint) (text-id pc-text-hint-msaa)) (set! n (+ n 1))        ;; MSAA
      (#if PLATFORM_ANDROID
        (begin (set! (-> dst n) (-> gfx 12)) (set! n (+ n 1)))        ;; Frame rate (inert, static mobile hint)
        (begin (set! (-> dst n) (-> gfx 10)) (set! n (+ n 1))))        ;; Frame rate (desktop, by-name)
      ;; --- MATÉRIAUX & DÉTAIL ---
      (set! (-> dst n) *grp-materials*) (set! n (+ n 1))
      ;; lighting-legacy-purge (2026-09-11) : PBR MATERIALS, RELIEF, TEXTURE RELIEF et SPECULAR
      ;; INTENSITY sont RETIREES du tableau source ; leurs copies dans la page fusionnee aussi.
      (set! (-> dst n) (-> rch (+ 3 hud))) (set! (-> dst n hint) (text-id pc-text-hint-rtextures)) (set! n (+ n 1))   ;; Recharged Textures
      (set! (-> dst n) (-> rch (+ 2 hud))) (set! (-> dst n hint) (text-id pc-text-hint-customassets)) (set! n (+ n 1));; Load Custom Assets
      ;; --- ÉCLAIRAGE ---
      (set! (-> dst n) *grp-lighting*) (set! n (+ n 1))
      (set! (-> dst n) (-> rch (+ fw 1))) (set! (-> dst n hint) (text-id pc-text-hint-ao)) (set! n (+ n 1))           ;; Ambient Occlusion
      (set! (-> dst n) (-> rch (+ fw 2))) (set! (-> dst n hint) (text-id pc-text-hint-aoquality)) (set! n (+ n 1))    ;; AO Quality
      (set! (-> dst n) (-> rch (+ fw 3))) (set! (-> dst n hint) (text-id pc-text-hint-aostrength)) (set! n (+ n 1))   ;; AO Strength
      ;; lighting-legacy-purge (2026-09-11) : REALTIME LIGHTING, AMBIENT MODEL/STRENGTH/CONTRAST et
      ;; SHADOW DISTANCE/QUALITY sont RETIREES du tableau source ; leurs copies aussi.
      ;; --- VÉGÉTATION (the Grass sub-submenu is DISSOLVED inline here) ---
      (set! (-> dst n) *grp-vegetation*) (set! n (+ n 1))
      (set! (-> dst n) (-> grs 0)) (set! (-> dst n hint) (text-id pc-text-hint-grass)) (set! n (+ n 1))       ;; Recharged Grass
      (set! (-> dst n) (-> grs 1)) (set! (-> dst n hint) (text-id pc-text-hint-neardist)) (set! n (+ n 1))    ;; Near Grass Distance
      (set! (-> dst n) (-> grs 2)) (set! (-> dst n hint) (text-id pc-text-hint-carddist)) (set! n (+ n 1))    ;; Grass Card Distance
      (set! (-> dst n) (-> grs 3)) (set! (-> dst n hint) (text-id pc-text-hint-density)) (set! n (+ n 1))     ;; Grass Density
      ;; Ggrass-density-presets : la rangee GRASS MODE (PRECOMPUTED/LIVE) a ete RETIREE de
      ;; *grass-options-pc* — elle proposait au joueur le placement EN DIRECT, mesure a 1 207 Mo de
      ;; pointe et porteur des plantages appareil. L'indice 4 designe desormais une AUTRE rangee :
      ;; le laisser aurait insere OVERHANG (ou Back) sous le libelle « Grass Mode ».
      (set! (-> dst n) (-> rch fw)) (set! (-> dst n hint) (text-id pc-text-hint-foliagewind)) (set! n (+ n 1));; Foliage Wind
      ;; --- INTERFACE ---
      (set! (-> dst n) *grp-interface*) (set! n (+ n 1))
      (set! (-> dst n) (-> gfx 5)) (set! (-> dst n hint) (text-id pc-text-hint-fpscounter)) (set! n (+ n 1))  ;; FPS Counter
      (#when FLAG_RECHARGED_HUD (set! (-> dst n) (-> rch 1)) (set! (-> dst n hint) (text-id pc-text-hint-rhud)) (set! n (+ n 1)))  ;; Recharged HUD
      ;; Advanced (legacy PS2-era graphics submenu) — kept reachable at the tail so it is never orphaned. (by-name)
      (#if PLATFORM_ANDROID
        (begin (set! (-> dst n) (-> gfx 8)) (set! n (+ n 1)))        ;; Advanced (android index 8)
        (begin (set! (-> dst n) (-> gfx 11)) (set! n (+ n 1))))       ;; Advanced (desktop index 11)
      ;; Back
      (set! (-> dst n) *graphics-unified-back*) (set! n (+ n 1))
      (set! (-> dst length) n)))
  (none))

