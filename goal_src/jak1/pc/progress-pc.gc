(defun rch-water-row-index ()
  "Index vivant de la rangee EAU RECHARGEE dans *recharged-options-pc*, -1 si absente."
  (let ((idx -1))
    (dotimes (i (-> *recharged-options-pc* length))
      (when (and (< idx 0)
                 (= (the int (-> *recharged-options-pc* i hint))
                    (the int (text-id pc-text-hint-recharged-water))))
        (set! idx i)))
    idx))

(defun init-game-options ((obj progress))
  "Set the options for all of the menus."
  ;; Glang-mixed: menu labels shown via name-override follow the TEXT language.
  (refresh-runtime-option-labels!)
  ;; start off by making them all invalid
  (dotimes (i (progress-screen max))
    (set! (-> *options-remap* i) #f))
  ;; give cheats
  (when (task-closed? (game-task finalboss-movies) (task-status need-reminder))
    (logior! (-> *pc-settings* cheats-known) (pc-cheats sidekick-blue tunes sky big-head small-head big-fist big-head-npc))
    (when (>= (calculate-completion (the progress #f)) 100.0)
      (logior! (-> *pc-settings* cheats-known)
               (pc-cheats invinc eco-blue eco-red eco-green eco-yellow huge-head mirror no-tex))))
  ;; set up options for each screen
  (set! (-> *options-remap* (progress-screen settings))
        (if (or *cheat-mode* (nonzero? (-> *pc-settings* cheats-known))) *main-options-secrets* *main-options-pc*))
  (set! (-> *options-remap* (progress-screen game-settings)) *game-options-pc*)
  ;; Grecharged-menu-overhaul RECADRAGE: graphic-settings now routes to the ONE unified GRAPHISMES page,
  ;; assembled BY FUNCTION from the vanilla graphics rows + recharged rows + grass rows (built at the end
  ;; of this function by build-graphics-unified! once every source row is wired). The vanilla arrays
  ;; *graphic-options-pc(-android)* are still wired below (they hold the shared row objects) but are no
  ;; longer displayed directly.
  (set! (-> *options-remap* (progress-screen graphic-settings)) *graphics-unified-pc*)
  (let ((max-refresh-rate (pc-get-active-display-refresh-rate)))
    (cond
      ((> max-refresh-rate 100) (set! *carousell-frame-rate* *carousell-frame-rate-150fps*))
      ((> max-refresh-rate 60) (set! *carousell-frame-rate* *carousell-frame-rate-100fps*))))
  (set! (-> *options-remap* (progress-screen sound-settings)) *sound-options-pc*)
  (set! (-> *options-remap* (progress-screen memcard-no-space)) *ok-options*)
  (set! (-> *options-remap* (progress-screen memcard-not-inserted)) *ok-options*)
  (set! (-> *options-remap* (progress-screen memcard-not-formatted)) *ok-options*)
  (set! (-> *options-remap* (progress-screen memcard-format)) *yes-no-options*)
  (set! (-> *options-remap* (progress-screen memcard-data-exists)) *yes-no-options*)
  (set! (-> *options-remap* (progress-screen memcard-insert)) *ok-options*)
  (set! (-> *options-remap* (progress-screen load-game)) *load-options*)
  (set! (-> *options-remap* (progress-screen save-game)) *save-options*)
  (set! (-> *options-remap* (progress-screen save-game-title)) *save-options-title*)
  (set! (-> *options-remap* (progress-screen memcard-error-loading)) *ok-options*)
  (set! (-> *options-remap* (progress-screen memcard-error-saving)) *ok-options*)
  (set! (-> *options-remap* (progress-screen memcard-error-formatting)) *ok-options*)
  (set! (-> *options-remap* (progress-screen memcard-error-creating)) *ok-options*)
  (set! (-> *options-remap* (progress-screen memcard-auto-save-error)) *ok-options*)
  (set! (-> *options-remap* (progress-screen memcard-removed)) *ok-options*)
  (set! (-> *options-remap* (progress-screen memcard-no-data)) *yes-no-options*)
  ;; Grecharged-menu-overhaul: pick the title-screen menu by save presence (same mechanism as the
  ;; cheat-mode pause swap above). >=1 save -> Continue + Load shown; no save -> Load hidden, no Continue.
  (set! (-> *options-remap* (progress-screen title)) (if (any-save-present?) *title-pc-continue* *title-pc*))
  ;; Grecharged-menu-overhaul: settings-title is now the unified 5-category OPTIONS hub (reached from
  ;; both the title "Options" and the pause "Options"), replacing the stock Game/Graphics/Sound list.
  (set! (-> *options-remap* (progress-screen settings-title)) *options-hub*)
  (set! (-> *options-remap* (progress-screen debug-options)) *opt-debug*)
  ;; DEBUG category is hidden (not removed) unless the build seeded *debug-menus-visible?* via --debug.
  ;; Length-mutation hide (like graphic-options-set-mtf-visible!): show=6 rows, hide=Back into DEBUG's
  ;; slot (index 4) + length 5. Idempotent (cached row refs), because *debug-menus-visible?* never flips.
  (cond
    (*debug-menus-visible?*
     (set! (-> *options-hub* 4) *hub-debug-row*)
     (set! (-> *options-hub* 5) *hub-back-row*)
     (set! (-> *options-hub* length) 6))
    (else
     (set! (-> *options-hub* 4) *hub-back-row*)
     (set! (-> *options-hub* length) 5)))
  ;; lighting-legacy-purge (2026-09-11) : le cablage des deux carrousels de la page DEBUG part avec
  ;; leurs rangees.
  (set! (-> *options-remap* (progress-screen auto-save)) *ok-options*)
  (set! (-> *options-remap* (progress-screen pal-change-to-60hz)) *yes-no-options*)
  (set! (-> *options-remap* (progress-screen pal-now-60hz)) *yes-no-options*)
  (set! (-> *options-remap* (progress-screen no-disc)) *ok-options*)
  (set! (-> *options-remap* (progress-screen bad-disc)) *ok-options*)
  ;; Grecharged-menu-overhaul: quit flow is a button menu now (was a yes/no).
  (set! (-> *options-remap* (progress-screen quit)) *quit-pause-options*)
  ;; our screens!
  (set! (-> *options-remap* (progress-screen aspect-msg)) *yes-no-options*)
  (set! (-> *options-remap* (progress-screen input-options)) *input-options*)
  (set! (-> *options-remap* (progress-screen camera-options)) *camera-options*)
  (set! (-> *options-remap* (progress-screen controller-options)) *controller-options*)
  (set! (-> *options-remap* (progress-screen mouse-options)) *mouse-options*)
  (set! (-> *options-remap* (progress-screen reassign-binds-options)) *reassign-binds-options*)
  (set! (-> *options-remap* (progress-screen select-controller)) *temp-options*)
  (set! (-> *options-remap* (progress-screen controller-binds)) *temp-options*)
  (set! (-> *options-remap* (progress-screen keyboard-binds)) *temp-options*)
  (set! (-> *options-remap* (progress-screen mouse-binds)) *temp-options*)
  (set! (-> *options-remap* (progress-screen misc-options)) *misc-options*)
  (set! (-> *options-remap* (progress-screen gfx-ps2-options)) *gfx-ps2-options*)
  ;; Grecharged-hud-jak1: the new "Recharged Settings" submenu
  (set! (-> *options-remap* (progress-screen recharged-settings)) *recharged-options-pc*)
  ;; Grecharged-grass-poc POLISH#6: the nested "Grass Settings" page (sub-submenu of Recharged Settings)
  (set! (-> *options-remap* (progress-screen grass-settings)) *grass-options-pc*)
  (set! (-> *options-remap* (progress-screen resolution)) *temp-options*)
  (set! (-> *options-remap* (progress-screen aspect-ratio)) *aspect-ratio-options*)
  (set! (-> *options-remap* (progress-screen quit-title)) *quit-title-options*)
  (set! (-> *options-remap* (progress-screen secrets)) *secrets-title*)
  (set! (-> *options-remap* (progress-screen cheats)) *cheats*)
  (set! (-> *options-remap* (progress-screen checkpoint-select)) *checkpoint-select-options*)
  (set! (-> *options-remap* (progress-screen music-player)) *music-player-options*)
  (set! (-> *options-remap* (progress-screen flava-player)) *temp-options*)
  (set! (-> *options-remap* (progress-screen memcard-disable-auto-save)) *yes-no-options*)
  (set! (-> *options-remap* (progress-screen memcard-auto-save-disabled)) *ok-options*)
  (set! (-> *options-remap* (progress-screen monitor)) *temp-options*)
  (set! (-> *options-remap* (progress-screen speedrun-options)) *speedrun-options*)
  (set! (-> *options-remap* (progress-screen speedrun-il-options)) *speedrun-il-options*)
  (set! (-> *options-remap* (progress-screen speedrun-cat-ext-options)) *speedrun-cat-ext-options*)
  ;; set default params
  (set! (-> *progress-state* aspect-ratio-choice) (get-aspect-ratio))
  (set! (-> *progress-state* video-mode-choice) (get-video-mode))
  (set! (-> *progress-state* yes-no-choice) #f)
  ;; set variable pointers
  (set! (-> *game-options* 1 value-to-modify) (&-> *pc-settings* memcard-play-hints?))
  (set! (-> *game-options* 2 value-to-modify) (&-> *setting-control* default language))
  (set! (-> *game-options-japan* 0 value-to-modify) (&-> *pc-settings* memcard-vibration?))
  (set! (-> *game-options-japan* 1 value-to-modify) (&-> *pc-settings* memcard-play-hints?))
  (set! (-> *game-options-demo* 0 value-to-modify) (&-> *pc-settings* memcard-vibration?))
  (set! (-> *game-options-demo* 1 value-to-modify) (&-> *pc-settings* memcard-play-hints?))
  (set! (-> *graphic-options* 1 value-to-modify) (&-> *progress-state* aspect-ratio-choice))
  (set! (-> *sound-options* 0 value-to-modify) (&-> *setting-control* default sfx-volume))
  (set! (-> *sound-options* 1 value-to-modify) (&-> *setting-control* default music-volume))
  (set! (-> *sound-options* 2 value-to-modify) (&-> *setting-control* default dialog-volume))
  (set! (-> *yes-no-options* 0 value-to-modify) (&-> *progress-state* yes-no-choice))
  ;; our options!
  (set! (-> *game-options-pc* 1 value-to-modify) (&-> *pc-settings* memcard-play-hints?))
  (set! (-> *game-options-pc* 2 value-to-modify) (&-> *pc-settings* subtitles?))
  (set! (-> *game-options-pc* 3 value-to-modify) (&-> *pc-settings* hinttitles?))
  (set! (-> *game-options-pc* 4 value-to-modify) (&-> *setting-control* default language))
  (set! (-> *game-options-pc* 5 value-to-modify) (&-> *progress-carousell* int-backup))
  (set! (-> *game-options-pc* 6 value-to-modify) (&-> *progress-carousell* int-backup))
  (set! (-> *game-options-pc* 7 value-to-modify) (&-> *progress-carousell* int-backup))
  ;; Goptions-reorder: canonicalize both graphics arrays to their full (Min Target FPS shown) layout
  ;; before index-wiring — a prior menu session with Dynamic OFF may have left them compacted (row 4
  ;; removed), which would shift the indices below. apply-dynamic-rs-menu-mode! re-hides row 4 at the end.
  ;; Grecharged-hud-jak1: full lengths bumped to 15 desktop / 12 android for the inserted RECHARGED
  ;; SETTINGS row (see the reindexed Advanced / Vulkan / new-submenu wiring below).
  (graphic-options-set-mtf-visible! *graphic-options-pc* *graphic-options-mtf-pc* GFX_OPTIONS_PC_FULL_LEN #t)
  (graphic-options-set-mtf-visible! *graphic-options-pc-android* *graphic-options-mtf-android* GFX_OPTIONS_ANDROID_FULL_LEN #t)
  ;; desktop graphics-options (Goptions-reorder + Grecharged-hud-jak1 order): 0 Aspect, 1 GameRes,
  ;; 2 Dynamic, 3 RenderScale, 4 MinTargetFPS, 5 FPSCounter, 6 VSync, 7 MSAA, 8 DisplayMode, 9 Display,
  ;; 10 FrameRate, 11 RechargedSettings, 12 Advanced(=PS2 Options renamed), 13 Vulkan, 14 Back.
  (set! (-> *graphic-options-pc* 2 value-to-modify) (&-> *pc-settings* dynamic-render-scale?))
  (set! (-> *graphic-options-pc* 2 name-override) *dynamic-render-scale-label*)
  ;; index 3 (RENDER SCALE / MIN RENDER SCALE slider) wired by apply-dynamic-rs-menu-mode!
  (set! (-> *graphic-options-pc* 4 value-to-modify) (&-> *pc-settings* dyn-target-fps))
  (set! (-> *graphic-options-pc* 4 name-override) *min-target-fps-label*)
  (set! (-> *graphic-options-pc* 5 value-to-modify) (&-> *pc-settings* fps-counter?))
  (set! (-> *graphic-options-pc* 5 name-override) *fps-counter-label*)
  (set! (-> *graphic-options-pc* 6 value-to-modify) (&-> *pc-settings* vsync?))
  (set! (-> *graphic-options-pc* 7 value-to-modify) (&-> *progress-carousell* int-backup))
  (set! (-> *graphic-options-pc* 8 value-to-modify) (&-> *progress-carousell* int-backup))
  (set! (-> *graphic-options-pc* 10 value-to-modify) (&-> *progress-carousell* int-backup))
  ;; Grecharged-menu-overhaul: RECHARGED SETTINGS row removed from Graphics (dissolved into the RENDU
  ;; category), so Advanced shifts to index 11 and Vulkan to index 12.
  (set! (-> *graphic-options-pc* 11 name-override) *advanced-settings-label*)
  ;; Gvulkan-option: derive the VULKAN RENDERER toggle from the persisted backend choice, then wire the
  ;; desktop row (now index 12, after Advanced, before Back). Bound here at FULL menu length (MTF forced
  ;; visible just above), so index 12 is the Renderer object regardless of MTF hiding.
  (#when FLAG_VULKAN_SUPPORT
  (set! (-> *pc-settings* gfx-renderer-vulkan?)
        (= (-> *pc-settings* gfx-renderer) (pc-gfx-renderer vulkan)))
  (set! (-> *graphic-options-pc* 12 value-to-modify) (&-> *pc-settings* gfx-renderer-vulkan?))
  (set! (-> *graphic-options-pc* 12 name-override) *vulkan-renderer-label*))
  ;; android graphics-options (Goptions-reorder + Grecharged-hud-jak1 order): 0 Aspect, 1 GameRes,
  ;; 2 Dynamic, 3 RenderScale, 4 MinTargetFPS, 5 FPSCounter, 6 VSync, 7 MSAA, 8 RechargedSettings,
  ;; 9 Advanced, 10 Vulkan, 11 Back.
  (set! (-> *graphic-options-pc-android* 2 value-to-modify) (&-> *pc-settings* dynamic-render-scale?))
  (set! (-> *graphic-options-pc-android* 2 name-override) *dynamic-render-scale-label*)
  ;; index 3 (RENDER SCALE / MIN RENDER SCALE slider) wired by apply-dynamic-rs-menu-mode!
  (set! (-> *graphic-options-pc-android* 4 value-to-modify) (&-> *pc-settings* dyn-target-fps))
  (set! (-> *graphic-options-pc-android* 4 name-override) *min-target-fps-label*)
  (set! (-> *graphic-options-pc-android* 5 value-to-modify) (&-> *pc-settings* fps-counter?))
  (set! (-> *graphic-options-pc-android* 5 name-override) *fps-counter-label*)
  (set! (-> *graphic-options-pc-android* 6 value-to-modify) (&-> *pc-settings* vsync?))
  (set! (-> *graphic-options-pc-android* 7 value-to-modify) (&-> *progress-carousell* int-backup))
  ;; Grecharged-menu-overhaul: RECHARGED SETTINGS removed from Android Graphics (dissolved into RENDU);
  ;; Advanced shifts to index 8 and Vulkan to index 9.
  (set! (-> *graphic-options-pc-android* 8 name-override) *advanced-settings-label*)
  ;; Gvulkan-option: wire the VULKAN RENDERER row on Android (now index 9, after Advanced, before the
  ;; restored desktop-only rows + Back). Same gfx-renderer-vulkan? mirror field (derived above for
  ;; desktop). On Android the Vulkan runtime is deferred; the toggle persists the preference, keeps GLES.
  (#when FLAG_VULKAN_SUPPORT
  (set! (-> *graphic-options-pc-android* 9 value-to-modify) (&-> *pc-settings* gfx-renderer-vulkan?))
  (set! (-> *graphic-options-pc-android* 9 name-override) *vulkan-renderer-label*))
  ;; Grecharged-master-toggle: row 0 = the GLOBAL RECHARGED MASTER on/off (every later
  ;; *recharged-options-pc* index below shifted +1 for it).
  (set! (-> *recharged-options-pc* 0 value-to-modify) (&-> *pc-settings* recharged-master?))
  (set! (-> *recharged-options-pc* 0 name-override) *recharged-master-label*)
  ;; Grecharged-hud-jak1: wire the "RECHARGED HUD" toggle (row 1) inside the Recharged submenu.
  (#when FLAG_RECHARGED_HUD
  (set! (-> *recharged-options-pc* 1 value-to-modify) (&-> *pc-settings* recharged-hud?))
  (set! (-> *recharged-options-pc* 1 name-override) *recharged-hud-label*))
  ;; Grecharged-grass-poc POLISH#6: row 2 (+1 for the master row) is now the "GRASS SETTINGS"
  ;; sub-submenu launcher (label only; its param3 opens *grass-options-pc*). All grass rows moved
  ;; into that nested page (wired below).
  (set! (-> *recharged-options-pc* (+ 1 FLAG_RECHARGED_HUD_N) name-override) *grass-settings-label*)
  ;; Gload-custom-assets: wire the "LOAD CUSTOM ASSETS" on-off toggle (row 3, +1 for the master row).
  (set! (-> *recharged-options-pc* (+ 2 FLAG_RECHARGED_HUD_N) value-to-modify) (&-> *pc-settings* load-custom-assets?))
  (set! (-> *recharged-options-pc* (+ 2 FLAG_RECHARGED_HUD_N) name-override) *load-custom-assets-label*)
  ;; Grecharged-bundled-textures: wire the "RECHARGED TEXTURES" on-off toggle right after LOAD
  ;; CUSTOM ASSETS (every later *recharged-options-pc* index below shifts +1 for this row).
  (set! (-> *recharged-options-pc* (+ 3 FLAG_RECHARGED_HUD_N) value-to-modify) (&-> *pc-settings* recharged-textures?))
  (set! (-> *recharged-options-pc* (+ 3 FLAG_RECHARGED_HUD_N) name-override) *recharged-textures-label*)
  ;; Grecharged-managed-assets: HD TEXTURE PACK. Addressed from the END (…, this row,
  ;; Back) instead of the flag arithmetic every other row uses: the row was
  ;; appended at the tail precisely so it needs no index bookkeeping, and length-2 stays
  ;; right after the HD-missing collapse shrinks the array too.
  ;; mesh-browser-removal : la rangee de debug qui suivait celle-ci est retiree, la queue perd 1 :
  ;; l'adressage depuis la fin passe de -3 a -2.
  (let ((mp-idx (+ -2 (-> *recharged-options-pc* length))))
    (set! (-> *recharged-options-pc* mp-idx value-to-modify) (&-> *pc-settings* managed-assets?))
    (set! (-> *recharged-options-pc* mp-idx name-override) *managed-assets-label*))
  ;; lighting-legacy-purge (2026-09-11) : la rangee PBR MATERIALS est RETIREE, son bras aussi ; le
  ;; terme `FLAG_PBR_N` isole qui decalait toute la suite disparait avec elle.
  ;; Grecharged-foliage-wind: wire the FOLIAGE WIND toggle (+1 for the master row throughout). It sits
  ;; at index 5 while the ENHANCED MODELS row is present (static length 10) and at index 4 after that
  ;; row collapsed (length 9) — wire by live length so re-inits stay correct in both states. Must run
  ;; BEFORE the collapse below (the collapse moves this very row object; wiring rides along with it).
  ;; Grecharged-ambient-occlusion: the three AO carousell rows sit right after FOLIAGE WIND (indices
  ;; 6,7,8 full / 5,6,7 collapsed). They also ride along with the collapse (wired here, pre-collapse).
  ;; Grecharged-buildsys-flags: fw-idx = first FOLIAGE WIND slot. HD-MODELS present => static length is
  ;; (+ 9 hud-N hd-N) and FOLIAGE WIND sits at (+ 4 hud-N hd-N); collapsed (enhanced FR3 absent) it drops
  ;; to (+ 4 hud-N). When FLAG_HD_MODELS is off both branches equal (+ 4 FLAG_RECHARGED_HUD_N) — the static
  ;; length is then (+ 9 hud-N) and no collapse ever fires.
  ;; mesh-browser-removal : la rangee de debug posee juste avant Back est SUPPRIMEE, la queue perd 1 ;
  ;; elle etait apres tout ce que le cablage et le collapse touchent, donc SEULES les constantes de
  ;; longueur totale ci-dessous perdent 1 (base fw-idx et indices du collapse inchanges).
  ;; Gprecompute-deterministic-bake: +1 on the PBR-block term (9 -> 10) for the new MESH SUBDIVISION
  ;; row, which is FLAG_PBR-gated like DISPLACEMENT. NOTE for whoever revives this frozen body: the
  ;; term was ALREADY stale before this change — the array carries 12 PBR rows after PBR MATERIALS
  ;; while the guard said 9 (DISPLACEMENT / PBR TEST PRESET / PBR ISOLATE were added here without
  ;; bumping it). Only the +1 DELTA of this change is claimed correct; the pre-existing -3 is not
  ;; ours to silently "fix". The shipped body (#unless FLAG_MENU_OVERHAUL) is exact.
  ;; The HD-collapse guard below needs NO change: it is deliberately kept for the NO-PBR case only
  ;; (see its own comment), and with --pbr off this row does not exist.
  ;; lighting-legacy-purge (2026-09-11) : plus AUCUNE rangee de ce tableau GELE n'est gatee par
  ;; FLAG_PBR — tous les termes FLAG_PBR_N disparaissent. Recompte a la main sur le tableau :
  ;; 12 rangees inconditionnelles + hud + hd + 2 physique.
  ;; mesh-browser-removal : la rangee de debug est retiree, la queue perd 1 (12 -> 11).
  (let ((fw-idx (if (= (-> *recharged-options-pc* length) (+ 11 FLAG_RECHARGED_HUD_N FLAG_HD_MODELS_N (* 2 FLAG_PHYSICS_N)))
                    (+ 4 FLAG_RECHARGED_HUD_N FLAG_HD_MODELS_N)
                    (+ 4 FLAG_RECHARGED_HUD_N))))
    (set! (-> *recharged-options-pc* fw-idx value-to-modify) (&-> *pc-settings* recharged-foliage-wind?))
    (set! (-> *recharged-options-pc* fw-idx name-override) *foliage-wind-label*)
    ;; Grecharged-ambient-occlusion: AO mode + quality + strength carousell rows follow FOLIAGE WIND. All
    ;; point value-to-modify at the shared *progress-carousell* int-backup scratch (the MSAA carousell
    ;; pattern); backup/write-back in respond-common map them 1:1 to *pc-settings* ambient-occlusion /
    ;; ao-quality / ao-strength.
    (set! (-> *recharged-options-pc* (+ fw-idx 1) value-to-modify) (&-> *progress-carousell* int-backup))
    (set! (-> *recharged-options-pc* (+ fw-idx 1) name-override) *ambient-occlusion-label*)
    (set! (-> *recharged-options-pc* (+ fw-idx 2) value-to-modify) (&-> *progress-carousell* int-backup))
    (set! (-> *recharged-options-pc* (+ fw-idx 2) name-override) *ao-quality-label*)
    (set! (-> *recharged-options-pc* (+ fw-idx 3) value-to-modify) (&-> *progress-carousell* int-backup))
    (set! (-> *recharged-options-pc* (+ fw-idx 3) name-override) *ao-strength-label*)
    ;; lighting-legacy-purge (2026-09-11) : tout le bras d'eclairage de l'ancien monde
    ;; (REALTIME LIGHTING, AMBIENT MODEL/STRENGTH/CONTRAST, SHADOW DISTANCE/QUALITY, TEXTURE
    ;; RELIEF, SPECULAR INTENSITY, DISPLACEMENT, MESH SUBDIVISION, PBR TEST PRESET, PBR
    ;; ISOLATE) est RETIRE de ce corps GELE avec ses rangees et ses champs pc-settings.
    )
  ;; water-ocean-mesh : la rangee EAU RECHARGEE, AUTO-LOCALISEE par son `hint` (meme contrat que
  ;; HDR OUTPUT et PHYSICS). La ligne est publiee a CHAQUE ouverture du menu : idx<0 = rangee
  ;; absente du CGO, et personne ne peut le croire cable sans le lire.
  (let ((w (rch-water-row-index)))
    (cond
      ((< w 0)
       (format 0 "[WATER-MENU] FATAL: row not found — Eau Rechargee left UNWIRED (len=~D)~%"
               (-> *recharged-options-pc* length)))
      (else
       (set! (-> *recharged-options-pc* w value-to-modify) (&-> *pc-settings* recharged-water?))
       (set! (-> *recharged-options-pc* w name-override) *recharged-water-label*)
       (format 0 "[WATER-MENU] row wired: idx=~D len=~D (self-located)~%"
               w (-> *recharged-options-pc* length)))))
  ;; Grecharged-secondary-motion: wire the two PHYSICS rows. (The same invariant is audited at BOOT
  ;; by physics-menu-static-audit! — init-game-options only runs when the menu is actually opened,
  ;; so a boot-only proof leg would never see this line.)
  ;; CYCLE-2 REGRESSION FIX (owner 16:40 "l'option Physics Detail ouvre le mauvais outil"). The old
  ;; wiring addressed the tail by hand as `length-3 = PHYSICS, length-2 = PHYSICS DETAIL,
  ;; length-1 = Back` — it FORGOT the debug launcher row (since removed), so the tail was FOUR deep
  ;; and every write landed one slot late: the PHYSICS DETAIL *label* was painted onto the debug
  ;; button, and respond-common dispatches buttons on the STATIC `name`, never on name-override —
  ;; so the row reading "PHYSICS DETAIL" ran the debug tool. Born wrong.
  ;; The fix is NOT `-4`: hand-counted tail offsets are the bug class (same class as Gmenu-flag-off).
  ;; The rows are now SELF-LOCATING — `physics-quality` is the option-type of exactly ONE row in the
  ;; whole array, so we FIND it and take the on-off row immediately before it. Any future row
  ;; inserted anywhere (incl. at the tail) is now harmless, and a mis-order fails LOUDLY instead of
  ;; silently stealing another row's action. The [PHYS-MENU] line is the permanent artifact gate:
  ;; it prints both resolved indices and the live length.
  ;; The DETAIL carousell points value-to-modify at the shared *progress-carousell* int-backup
  ;; scratch (le motif de carrousel partage); respond-common maps it 1:1 to physics-quality.
  (#when FLAG_PHYSICS
  (let ((det-idx -1))
    (dotimes (i (-> *recharged-options-pc* length))
      (when (and (< det-idx 0)
                 (= (the int (-> *recharged-options-pc* i option-type))
                    (the int (game-option-type physics-quality))))
        (set! det-idx i)))
    (cond
      ((or (< det-idx 1)
           (!= (the int (-> *recharged-options-pc* (+ det-idx -1) option-type))
               (the int (game-option-type on-off))))
       (format 0 "[PHYS-MENU] FATAL: physics rows not found or mis-ordered (det-idx=~D len=~D) — rows left UNWIRED~%"
               det-idx (-> *recharged-options-pc* length)))
      (else
       (set! (-> *recharged-options-pc* (+ det-idx -1) value-to-modify) (&-> *pc-settings* physics?))
       (set! (-> *recharged-options-pc* (+ det-idx -1) name-override) *physics-label*)
       (set! (-> *recharged-options-pc* det-idx value-to-modify) (&-> *progress-carousell* int-backup))
       (set! (-> *recharged-options-pc* det-idx name-override) *physics-detail-label*)
       (format 0 "[PHYS-MENU] rows wired: toggle=~D detail=~D len=~D (self-located)~%"
               (+ det-idx -1)
               det-idx
               (-> *recharged-options-pc* length))))))
  ;; Grecharged-hd-models: wire the ENHANCED MODELS toggle (row (+ 4 hud-N), +1 for the master row) only when the build ships the
  ;; enhanced FR3 set; otherwise collapse the row (shift FOLIAGE WIND, the three AO rows and Back up one
  ;; slot and drop the live length by one, so it disappears — renderer + nav key off (length arr)).
  ;; Idempotent across re-inits (only fires while the full static length is intact). The whole block is
  ;; compiled only with --hd-models; without it the ENHANCED MODELS row is absent from the static array.
  (#when FLAG_HD_MODELS
  (if (zero? (pc-enhanced-models-available?))
      ;; mesh-browser-removal : -1 sur les DEUX constantes de longueur, la rangee de debug de queue
      ;; est supprimee. (Avec FLAG_PBR cette garde est morte — la longueur reelle inclut les rangees
      ;; PBR — mais l'arithmetique sans PBR doit rester juste.)
      ;; Grecharged-secondary-motion: +2 on both length constants for the two tail PHYSICS rows
      ;; (same treatment as the tail debug row above — they sit after everything the
      ;; collapse loop touches, so only the total-length terms change).
      ;; lighting-legacy-purge (2026-09-11) : plus aucune rangee FLAG_PBR dans ce tableau GELE —
      ;; les termes FLAG_PBR_N sortent, ici comme dans la garde fw-idx ci-dessus (12 rangees
      ;; inconditionnelles + hud + hd + 2 physique).
      ;; mesh-browser-removal : MEME terme que la garde fw-idx ci-dessus, MEME -1 (12 -> 11, 11 -> 10).
      (when (= (-> *recharged-options-pc* length) (+ 11 FLAG_RECHARGED_HUD_N (* 2 FLAG_PHYSICS_N)))
        (let ((i (+ 4 FLAG_RECHARGED_HUD_N)))
          (while (< i (+ 9 FLAG_RECHARGED_HUD_N))
            (set! (-> *recharged-options-pc* i) (-> *recharged-options-pc* (+ i 1)))
            (+! i 1)))
        (set! (-> *recharged-options-pc* length) (+ 10 FLAG_RECHARGED_HUD_N (* 2 FLAG_PHYSICS_N))))
      (begin
        (set! (-> *recharged-options-pc* (+ 4 FLAG_RECHARGED_HUD_N) value-to-modify)
              (&-> *pc-settings* recharged-enhanced-models?))
        (set! (-> *recharged-options-pc* (+ 4 FLAG_RECHARGED_HUD_N) name-override) *enhanced-models-label*))))
  ;; Grecharged-grass-poc POLISH#6: wire the grass rows inside the nested *grass-options-pc* page.
  (set! (-> *grass-options-pc* 0 value-to-modify) (&-> *pc-settings* recharged-grass?))
  (set! (-> *grass-options-pc* 0 name-override) *recharged-grass-label*)
  (set! (-> *grass-options-pc* 1 value-to-modify) (&-> *pc-settings* recharged-grass-near-dist))
  (set! (-> *grass-options-pc* 1 name-override) *recharged-near-dist-label*)
  (set! (-> *grass-options-pc* 2 value-to-modify) (&-> *pc-settings* recharged-grass-card-dist))
  (set! (-> *grass-options-pc* 2 name-override) *recharged-card-dist-label*)
  ;; Ggrass-density-presets: row 3 is now a CAROUSELL (five named density presets), so it points at the
  ;; shared *progress-carousell* int-backup scratch exactly like physics-quality / shadow-quality do —
  ;; a carousell row NEVER points at the setting field itself; the write-back clause does that on confirm.
  (set! (-> *grass-options-pc* 3 value-to-modify) (&-> *progress-carousell* int-backup))
  (set! (-> *grass-options-pc* 3 name-override) *recharged-density-label*)
  ;; Grecharged-grass-overhang: row 4 GRASS OVERHANG on-off toggle (present only with --grass-overhang)
  (#when FLAG_GRASS_OVERHANG
  (set! (-> *grass-options-pc* 4 value-to-modify) (&-> *pc-settings* recharged-grass-overhang?))
  (set! (-> *grass-options-pc* 4 name-override) *grass-overhang-label*))
  (apply-dynamic-rs-menu-mode!)
  (set! (-> *misc-options* 0 value-to-modify) (&-> *pc-settings* money-starburst?))
  (set! (-> *misc-options* 1 value-to-modify) (&-> *pc-settings* discord-rpc?))
  (set! (-> *misc-options* 2 value-to-modify) (&-> *pc-settings* skip-movies?))
  (set! (-> *misc-options* 3 value-to-modify) (&-> *pc-settings* speedrunner-mode?))
  (set! (-> *camera-options* 0 value-to-modify) (&-> *pc-settings* first-camera-h-inverted?))
  (set! (-> *camera-options* 1 value-to-modify) (&-> *pc-settings* first-camera-v-inverted?))
  (set! (-> *camera-options* 2 value-to-modify) (&-> *pc-settings* third-camera-h-inverted?))
  (set! (-> *camera-options* 3 value-to-modify) (&-> *pc-settings* third-camera-v-inverted?))
  ;; input options
  (set! (-> *controller-options* 1 value-to-modify) (&-> *pc-settings* memcard-vibration?))
  (set! (-> *controller-options* 2 value-to-modify) (&-> *pc-settings* stick-deadzone))
  (set! (-> *controller-options* 3 value-to-modify) (&-> *pc-settings* stick-sensitivity))
  (set! (-> *controller-options* 4 value-to-modify) (&-> *pc-settings* ignore-controller-win-unfocused?))
  (set! (-> *controller-options* 5 value-to-modify) (&-> *pc-settings* controller-led-hp?))
  (set! (-> *controller-options* 6 value-to-modify) (&-> *pc-settings* controller-led-eco?))
  (set! (-> *controller-options* 7 value-to-modify) (&-> *pc-settings* controller-led-heat?))
  (set! (-> *controller-options* 8 value-to-modify) (&-> *pc-settings* pressure-sensitivity-enabled?))
  (set! (-> *mouse-options* 0 value-to-modify) (&-> *pc-settings* mouse-camera?))
  (set! (-> *mouse-options* 1 value-to-modify) (&-> *pc-settings* mouse-xsens))
  (set! (-> *mouse-options* 2 value-to-modify) (&-> *pc-settings* mouse-ysens))
  (set! (-> *mouse-options* 3 value-to-modify) (&-> *pc-settings* mouse-movement?))
  (set! (-> *input-options* 2 value-to-modify) (&-> *pc-settings* keyboard-enabled?))
  (set! (-> *input-options* 3 value-to-modify) (&-> *pc-settings* mouse-enabled?))
  (set! (-> *input-options* 5 value-to-modify) (&-> *pc-settings* auto-hide-cursor?))
  (set! (-> *gfx-ps2-options* 0 value-to-modify) (&-> *progress-carousell* int-backup))
  (set! (-> *gfx-ps2-options* 1 value-to-modify) (&-> *progress-carousell* int-backup))
  (set! (-> *gfx-ps2-options* 2 value-to-modify) (&-> *pc-settings* ps2-parts?))
  (set! (-> *gfx-ps2-options* 3 value-to-modify) (&-> *pc-settings* force-envmap?))
  (set! (-> *gfx-ps2-options* 4 value-to-modify) (&-> *pc-settings* ps2-actor-vis?))
  (set! (-> *sound-options-pc* 0 value-to-modify) (&-> *pc-settings* memcard-volume-sfx))
  (set! (-> *sound-options-pc* 1 value-to-modify) (&-> *pc-settings* memcard-volume-music))
  (set! (-> *sound-options-pc* 2 value-to-modify) (&-> *pc-settings* memcard-volume-dialog))
  (dotimes (i (1- (-> *cheats* length)))
    (set! (-> *cheats* i value-to-modify) (&-> *progress-carousell* symbol-backup)))
  ;(set! (-> *sound-options-pc* 3 value-to-modify) (&-> *pc-settings* music-fadein?))
  (set! (-> *progress-carousell* aspect-native-choice) (-> *pc-settings* use-vis?))
  ;; scroll stuff!
  (progress-scroll-reset)
  (none))

(defmethod respond-common ((obj progress))
  "common logic for navigating the progress menu.
   this is the overriden version, purged of no longer necessary code and with additional new code."
  ;; read memcard
  (mc-get-slot-info 0 *progress-save-info*)
  (set! (-> obj card-info) *progress-save-info*)
  ;; build custom dynamic menus
  (case (-> obj display-state)
    (((progress-screen resolution))
     ;; TODO infinite scrolling
     (build-resolution-options))
    (((progress-screen flava-player)) (build-flava-player-options *progress-music*))
    (((progress-screen secrets))
     (if (= (-> obj display-state-stack 0) (progress-screen title))
       (set! (-> *options-remap* (-> obj display-state)) *secrets-title*)
       (set! (-> *options-remap* (-> obj display-state)) *secrets*)))
    (((progress-screen monitor)) (build-monitor-options))
    (((progress-screen select-controller)) (build-controller-options))
    (((progress-screen controller-binds) (progress-screen keyboard-binds) (progress-screen mouse-binds))
     (build-binding-reassignment-options (-> obj display-state))))
  ;; run nav code
  (let ((options (-> *options-remap* (-> obj display-state))))
    ;; snap scroll if oob
    (when (> (length options) PROGRESS_PC_PAGE_HEIGHT)
      (set! (-> *progress-scroll* start-index)
            (max (-> *progress-scroll* start-index) (- (-> obj option-index) (+ PROGRESS_PC_PAGE_HEIGHT -2)))))
    ;; Grecharged-menu-overhaul MECHANISM 1: focus must never REST on a non-selectable group-header
    ;; (e.g. on page entry when row 0 is a header). Advance forward to the first selectable row. Runs
    ;; every frame (cheap); the direction-aware up/down skips below keep it a no-op during navigation.
    (when (and options (> (length options) 0))
      (let ((g 0))
        (while (and (< g (length options))
                    (>= (-> obj option-index) 0)
                    (< (-> obj option-index) (length options))
                    (= (-> options (-> obj option-index) option-type) (game-option-type group-header)))
          (if (< (-> obj option-index) (+ (length options) -1))
            (1+! (-> obj option-index))
            (set! (-> obj option-index) 0))
          (+! g 1))))
    (when (and options (not (or (progress-scrolling?) (-> obj in-transition))))
      ;; only respond to inputs when transition is done (and also there's options at all)
      ;; Gtouch-menus: fold any pending touch tap into this frame's input (additive
      ;; to the d-pad). Sets the *menu-touch* *? flags the guards below OR in.
      (menu-touch-drive! obj)
      (cond
        ((or (cpad-pressed? 0 up) (-> *menu-touch* up?))
         ;; pressed up (Gtouch-fix: tap-scroll above the visible list too)
         ;; original code checked hold and then press, because hold can be used during center screen option. which we don't use.
         (when (not (-> obj selected-option))
           (if (!= (length options) 1) (sound-play "cursor-up-down"))
           (set! (-> obj last-option-index-change) (-> *display* real-frame-counter))
           ;; Grecharged-menu-overhaul MECHANISM 1: step UP, then keep stepping past any group-header
           ;; (bounded by row count to avoid an all-header infinite loop). Scroll rides each step.
           (let ((g 0) (more #t))
             (while more
               (cond
                 ((> (-> obj option-index) 0)
                  (1-! (-> obj option-index))
                  (when (and (> (length options) PROGRESS_PC_PAGE_HEIGHT) (< (-> obj option-index) *progress-scroll-start*))
                    (progress-scroll-up!)))
                 (else
                  (set! (-> obj option-index) (1- (length options)))
                  (set! (-> *progress-scroll* start-index) (max 0 (- (length options) PROGRESS_PC_PAGE_HEIGHT -1)))))
               (+! g 1)
               (set! more (and (< g (length options))
                               (= (-> options (-> obj option-index) option-type) (game-option-type group-header))))))))
        ((or (cpad-pressed? 0 down) (-> *menu-touch* down?))
         ;; pressed down. (Gtouch-fix: tap-scroll below the visible list too)
         (when (not (-> obj selected-option))
           (if (!= (length options) 1) (sound-play "cursor-up-down"))
           (set! (-> obj last-option-index-change) (-> *display* real-frame-counter))
           ;; Grecharged-menu-overhaul MECHANISM 1: step DOWN, then keep stepping past any group-header
           ;; (bounded by row count). Scroll rides each step.
           (let ((g 0) (more #t))
             (while more
               (cond
                 ((< (-> obj option-index) (1- (length options)))
                  (1+! (-> obj option-index))
                  (when (and (> (length options) PROGRESS_PC_PAGE_HEIGHT) (>= (-> obj option-index) *progress-scroll-end*))
                    (progress-scroll-down!)))
                 (else (set! (-> obj option-index) 0) (set! (-> *progress-scroll* start-index) 0)))
               (+! g 1)
               (set! more (and (< g (length options))
                               (= (-> options (-> obj option-index) option-type) (game-option-type group-header))))))))
        ((or (cpad-hold? 0 left) (-> *menu-touch* left?) (-> *menu-touch* hold-left?))
         ;; holding left. sliders use hold. (Gtouch-menus: touch left/hold-left too.)
         (cond
           ((or (cpad-pressed? 0 left) (-> *menu-touch* left?))
            ;; navigate left.
            (when (or (-> obj selected-option) (= (-> options (-> obj option-index) option-type) (game-option-type yes-no)))
              (let ((sound? #f))
                (case (-> options (-> obj option-index) option-type)
                  (((game-option-type on-off)
                    (game-option-type yes-no)
                    (game-option-type normal-inverted)
                    (game-option-type aspect-native)
                    (game-option-type cheat-toggle))
                   ;; pressed left on an on/off yes/no option
                   (when (not (-> (the-as (pointer uint32) (-> options (-> obj option-index) value-to-modify))))
                     ;; it was on 'off' or 'no'
                     (set! sound? #t)
                     ;; vibrate if this toggles vibration.
                     ;; TODO - get this working
                     (when (= (-> options (-> obj option-index) name) (text-id vibrations))
                       (cpad-set-buzz! (-> *cpad-list* cpads 0) 1 255 (seconds 0.3))))
                   ;; if the option has an explicit on-change function, call it
                   (if (nonzero? (-> options (-> obj option-index) on-change))
                     ((-> options (-> obj option-index) on-change) #t)
                     ;; set to yes
                     (set! (-> (the-as (pointer symbol) (-> options (-> obj option-index) value-to-modify))) #t)))
                  (((game-option-type aspect-ratio))
                   (set! sound? (= (-> (the-as (pointer symbol) (-> options (-> obj option-index) value-to-modify))) 'aspect16x9))
                   (set! (-> (the-as (pointer symbol) (-> options (-> obj option-index) value-to-modify))) 'aspect4x3))
                  (((game-option-type language))
                   ;; language selection. if not on first language, go back. if on first language, go to last.
                   (if (> (the-as int (-> (the-as (pointer uint64) (-> options (-> obj option-index) value-to-modify)))) 0)
                     (+! (-> (the-as (pointer uint64) (-> options (-> obj option-index) value-to-modify))) -1)
                     (set! (-> (the-as (pointer int64) (-> options (-> obj option-index) value-to-modify))) 5))
                   ;; language was updated.
                   (set! (-> obj language-transition) #t)
                   (set! (-> obj language-direction) #t)
                   (set! sound? #t))
                  (((game-option-type confirmation))
                   (set! sound? (!= (-> *progress-state* on-off-backup) #t))
                   (set! (-> *progress-state* on-off-backup) #t))
                  (((game-option-type display-mode)
                    (game-option-type msaa)
                    (game-option-type ambient-occlusion)
                    (game-option-type ao-quality)
                    (game-option-type ao-strength)
                    (game-option-type grass-density)
                    (game-option-type physics-quality)
                    (game-option-type lod-bg)
                    (game-option-type lod-fg)
                    (game-option-type speaker)
                    (game-option-type frame-rate)
                    (game-option-type language-subtitles)
                    (game-option-type language-text))
                   ;; a carousell like language
                   (if (> (-> (the-as (pointer int) (-> options (-> obj option-index) value-to-modify))) 0)
                     (+! (-> (the-as (pointer int) (-> options (-> obj option-index) value-to-modify))) -1)
                     (set! (-> (the-as (pointer int) (-> options (-> obj option-index) value-to-modify)))
                           (1- (length (-> *progress-carousell* current-carousell)))))
                   ;; updated.
                   (set! (-> *progress-carousell* transition) #t)
                   (set! (-> *progress-carousell* direction) #t)
                   (set! sound? #t)))
                (if sound? (sound-play "cursor-l-r")))))
           (else
            ;; holding left
            (when (-> obj selected-option)
              (let ((sound? #f))
                (case (-> options (-> obj option-index) option-type)
                  (((game-option-type slider))
                   ;; slider is selected
                   (cond
                     ((>= (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify)))
                          (+ (* (-> options (-> obj option-index) slider-step-size) DISPLAY_FPS_RATIO) (-> options (-> obj option-index) param1)))
                      ;; we're 1 above minimum, so reduce by 1
                      (set! (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify)))
                            (- (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify)))
                               (* (-> options (-> obj option-index) slider-step-size) DISPLAY_FPS_RATIO)))
                      (set! sound? #t))
                     ((< (-> options (-> obj option-index) param1)
                         ;; not at least 1 above minimum, just set to minimum (why not just use max or something!!)
                         (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify))))
                      (set! (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify)))
                            (-> options (-> obj option-index) param1))
                      (set! sound? #t)))))
                ;; play sound
                (when sound?
                  ;; if the option has an explicit on-change function, call it
                  (when (nonzero? (-> options (-> obj option-index) on-change))
                    ((-> options (-> obj option-index) on-change) (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify)))))
                  (let ((vol 100.0))
                    (case (-> options (-> obj option-index) name)
                      (((text-id music-volume) (text-id speech-volume))
                       (set! vol (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify))))))
                    (when (< (seconds 0.3) (- (-> *display* real-frame-counter) (-> *progress-state* last-slider-sound)))
                      (set! (-> *progress-state* last-slider-sound) (-> *display* real-frame-counter))
                      (sound-play "slider2001" :vol vol)))))))))
        ((or (cpad-hold? 0 right) (-> *menu-touch* right?) (-> *menu-touch* hold-right?))
         ;; holding right (Gtouch-menus: touch right/hold-right too.)
         (cond
           ((or (cpad-pressed? 0 right) (-> *menu-touch* right?))
            ;; pressed right
            (when (or (-> obj selected-option) (= (-> options (-> obj option-index) option-type) (game-option-type yes-no)))
              (let ((sound? #f))
                (case (-> options (-> obj option-index) option-type)
                  (((game-option-type on-off)
                    (game-option-type yes-no)
                    (game-option-type normal-inverted)
                    (game-option-type aspect-native)
                    (game-option-type cheat-toggle))
                   ;; play sound if it was on 'yes' because we're going to 'no' now
                   (set! sound? (-> (the-as (pointer symbol) (-> options (-> obj option-index) value-to-modify))))
                   ;; if the option has an explicit on-change function, call it
                   (if (nonzero? (-> options (-> obj option-index) on-change))
                     ((-> options (-> obj option-index) on-change) #f)
                     ;; set to no
                     (set! (-> (the-as (pointer symbol) (-> options (-> obj option-index) value-to-modify))) #f)))
                  (((game-option-type aspect-ratio))
                   ;; same shit different toilet
                   (set! sound? (= (-> (the-as (pointer symbol) (-> options (-> obj option-index) value-to-modify))) 'aspect4x3))
                   (set! (-> (the-as (pointer symbol) (-> options (-> obj option-index) value-to-modify))) 'aspect16x9))
                  (((game-option-type language))
                   ;; same thing as before. if at last, go to first. otherwise, keep going forward.
                   (if (< (the-as int (-> (the-as (pointer uint64) (-> options (-> obj option-index) value-to-modify)))) 5)
                     (1+! (-> (the-as (pointer uint64) (-> options (-> obj option-index) value-to-modify))))
                     (set! (-> (the-as (pointer int64) (-> options (-> obj option-index) value-to-modify))) 0))
                   (set! (-> obj language-transition) #t)
                   (set! (-> obj language-direction) #f)
                   (set! sound? #t))
                  (((game-option-type confirmation))
                   (set! sound? (!= (-> *progress-state* on-off-backup) #f))
                   (set! (-> *progress-state* on-off-backup) #f))
                  (((game-option-type display-mode)
                    (game-option-type msaa)
                    (game-option-type ambient-occlusion)
                    (game-option-type ao-quality)
                    (game-option-type ao-strength)
                    (game-option-type grass-density)
                    (game-option-type physics-quality)
                    (game-option-type lod-bg)
                    (game-option-type lod-fg)
                    (game-option-type speaker)
                    (game-option-type frame-rate)
                    (game-option-type language-subtitles)
                    (game-option-type language-text))
                   ;; same thing as before. if at last, go to first. otherwise, keep going forward.
                   (if (< (-> (the-as (pointer int) (-> options (-> obj option-index) value-to-modify)))
                          (1- (length (-> *progress-carousell* current-carousell))))
                     (1+! (-> (the-as (pointer int) (-> options (-> obj option-index) value-to-modify))))
                     (set! (-> (the-as (pointer int) (-> options (-> obj option-index) value-to-modify))) 0))
                   (set! (-> *progress-carousell* transition) #t)
                   (set! (-> *progress-carousell* direction) #f)
                   (set! sound? #t)))
                ;; play sound if desired
                (if sound? (sound-play "cursor-l-r")))))
           (else
            ;; holding right, but didnt just press it. same slider stuff as before
            (when (-> obj selected-option)
              (let ((sound? #f))
                (case (-> options (-> obj option-index) option-type)
                  (((game-option-type slider))
                   (cond
                     ((>= (- (-> options (-> obj option-index) param2) (* (-> options (-> obj option-index) slider-step-size) DISPLAY_FPS_RATIO))
                          (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify))))
                      (set! (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify)))
                            (+ (* (-> options (-> obj option-index) slider-step-size) DISPLAY_FPS_RATIO)
                               (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify)))))
                      (set! sound? #t))
                     ((< (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify)))
                         (-> options (-> obj option-index) param2))
                      (set! (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify)))
                            (-> options (-> obj option-index) param2))
                      (set! sound? #t)))))
                (when sound?
                  ;; if the option has an explicit on-change function, call it
                  (when (nonzero? (-> options (-> obj option-index) on-change))
                    ((-> options (-> obj option-index) on-change) (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify)))))
                  (let ((vol 100.0))
                    (case (-> options (-> obj option-index) name)
                      (((text-id music-volume) (text-id speech-volume))
                       (set! vol (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify))))))
                    (when (< (seconds 0.3) (- (-> *display* real-frame-counter) (-> *progress-state* last-slider-sound)))
                      (set! (-> *progress-state* last-slider-sound) (-> *display* real-frame-counter))
                      (sound-play "slider2001" :vol vol)))))))))
        ((or (cpad-pressed? 0 square) (cpad-pressed? 0 triangle) (-> *menu-touch* back?))
         ;; pressed square or triangle, cancel out! (Gtouch-menus: tap-outside/back too.)
         (cond
           ((-> obj selected-option)
            ;; an option is selected. AHHH!!! just restore to whatever was on the backup
            (case (-> options (-> obj option-index) option-type)
              (((game-option-type slider))
               (set! (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify)))
                     (-> *progress-state* slider-backup)))
              (((game-option-type language))
               (set! (-> (the-as (pointer language-enum) (-> options (-> obj option-index) value-to-modify)))
                     (-> *progress-state* language-backup)))
              (((game-option-type on-off) (game-option-type normal-inverted))
               (set! (-> (the-as (pointer symbol) (-> options (-> obj option-index) value-to-modify)))
                     (-> *progress-state* on-off-backup))))
            ;; ding
            (sound-play "cursor-options")
            (set! (-> obj selected-option) #f))
           ((or (can-go-back? obj)
                (= (-> obj display-state) (progress-screen load-game))
                (= (-> obj display-state) (progress-screen save-game))
                (= (-> obj display-state) (progress-screen save-game-title)))
            ;; no option selected, go back
            (cpad-clear! 0 square)
            (cpad-clear! 0 triangle)
            (if (= (-> obj display-state) (progress-screen settings)) (sound-play "menu-stats") (sound-play "cursor-options"))
            (when (= (-> obj display-state) (progress-screen music-player))
              (sound-group-pause (sound-group music))
              (progress-reset-music-parms))
            (load-level-text-files (-> *level-task-data* (-> obj display-level-index) text-group-index))
            (set! (-> obj next-display-state) (progress-screen invalid)))))
        ((or (cpad-pressed? 0 x) (cpad-pressed? 0 circle) (-> *menu-touch* confirm?))
         ;; pressed x or circle. advance! (Gtouch-menus: touch confirm too.)
         ;; Grecharged-menu-overhaul MECHANISM 1: a group-header is never activatable (e.g. a direct
         ;; touch-tap on the header text) — swallow the confirm and do nothing.
         (when (= (-> options (-> obj option-index) option-type) (game-option-type group-header))
           (return #f))
         ;; first check if the option is disabled, if so leave early and do nothing
         (when (and (nonzero? (-> options (-> obj option-index) option-disabled-func))
                    (!= (-> options (-> obj option-index) option-disabled-func) #f)
                    ((-> options (-> obj option-index) option-disabled-func)))
           (sound-play "cursor-options")
           (return #f))
         (cond
           ((not (-> obj selected-option))
            ;; no option already selected.
            (cond
              ((= (-> options (-> obj option-index) option-type) (game-option-type menu))
               ;; go to a menu
               (cpad-clear! 0 x)
               (cpad-clear! 0 circle)
               (cond
                 ((and (not (-> *setting-control* default auto-save))
                       (= (text-id disable-auto-save) (-> options (-> obj option-index) name)))
                  (sound-play "cursor-options"))
                 (else
                  (push! obj)
                  (sound-play "select-option")
                  (set! (-> obj next-display-state) (the-as progress-screen (-> options (-> obj option-index) param3)))
                  (case (-> obj next-display-state)
                    (((progress-screen load-game) (progress-screen save-game) (progress-screen save-game-title))
                     (set! (-> obj next-display-state) (set-memcard-screen obj (-> obj next-display-state))))))))
              ((= (-> options (-> obj option-index) option-type) (game-option-type button))
               ;; a button. what?
               (case (-> options (-> obj option-index) name)
                 ;; Grecharged-menu-overhaul: title CONTINUE = 1-click load of the most recent save.
                 (((text-id pc-text-continue))
                  (let ((slot (progress-newest-save-slot)))
                    (when (>= slot 0)
                      (cpad-clear! 0 x)
                      (cpad-clear! 0 circle)
                      (sound-play "start-options")
                      (set! (-> *progress-state* which) slot)
                      (set! (-> obj next-display-state) (progress-screen memcard-loading)))))
                 ;; Grecharged-menu-overhaul: quit-flow buttons. RETURN TO TITLE restarts the engine to
                 ;; the title (pause quit only); QUIT GAME as a BUTTON quits the app (the quit-game MENU
                 ;; rows are option-type menu, handled above, so this only fires for the quit sub-menu);
                 ;; CANCEL backs out of the quit prompt.
                 (((text-id pc-text-return-title))
                  (set! *quit-to-title* #t)
                  (sound-play "start-options")
                  (sound-volume-off)
                  (set! (-> *game-info* mode) 'play)
                  (initialize! *game-info* 'game (the-as game-save #f) "title-start"))
                 (((text-id quit-game))
                  (sound-play "start-options")
                  (commit-to-file *pc-settings*)
                  (sound-volume-off)
                  (kernel-shutdown))
                 (((text-id pc-text-cancel))
                  (sound-play "cursor-options")
                  (set! (-> obj next-display-state) (progress-screen invalid)))
                 (((text-id exit-demo))
                  ;; exit demo!
                  (set! *master-exit* 'force)
                  (set-master-mode 'game))
                 (((text-id back))
                  ;; go back!
                  (if (= (-> obj display-state) (progress-screen settings)) (sound-play "menu-stats") (sound-play "cursor-options"))
                  (when (= (-> obj display-state) (progress-screen music-player))
                    (sound-group-pause (sound-group music))
                    (progress-reset-music-parms))
                  (load-level-text-files (-> *level-task-data* (-> obj display-level-index) text-group-index))
                  (set! (-> obj next-display-state) (progress-screen invalid)))
                 ;; LEVEL SELECT
                 (((text-id training-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "game-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id village1-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "village1-warp"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id beach-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "beach-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id jungle-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "jungle-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id misty-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "misty-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id firecanyon-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "firecanyon-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id village2-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "village2-warp"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id sunken-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "sunken-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id swamp-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "swamp-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id rolling-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "rolling-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id ogre-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "ogre-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id village3-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "village3-warp"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id snow-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "snow-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id cave-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "maincave-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id lavatube-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "lavatube-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id citadel-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "citadel-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 (((text-id finalboss-level-name))
                  (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "finalboss-start"))
                  (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))
                 ;; SPEEDRUNS
                 ;; Restart current run
                 (((text-id speedrun-reset-current-run)) (progress-fast-save-and-start-speedrun (the-as speedrun-category #f)))
                 ;; Full game runs
                 (((text-id speedrun-new-full-game)) (progress-fast-save-and-start-speedrun (speedrun-category full-game)))
                 ;; Individual Levels
                 (((text-id speedrun-il-training)) (progress-fast-save-and-start-speedrun (speedrun-category il-training)))
                 (((text-id speedrun-il-village1)) (progress-fast-save-and-start-speedrun (speedrun-category il-village1)))
                 (((text-id speedrun-il-beach)) (progress-fast-save-and-start-speedrun (speedrun-category il-beach)))
                 (((text-id speedrun-il-jungle)) (progress-fast-save-and-start-speedrun (speedrun-category il-jungle)))
                 (((text-id speedrun-il-misty)) (progress-fast-save-and-start-speedrun (speedrun-category il-misty)))
                 (((text-id speedrun-il-firecanyon)) (progress-fast-save-and-start-speedrun (speedrun-category il-firecanyon)))
                 (((text-id speedrun-il-village2)) (progress-fast-save-and-start-speedrun (speedrun-category il-village2)))
                 (((text-id speedrun-il-sunken)) (progress-fast-save-and-start-speedrun (speedrun-category il-sunken)))
                 (((text-id speedrun-il-swamp)) (progress-fast-save-and-start-speedrun (speedrun-category il-swamp)))
                 (((text-id speedrun-il-rolling)) (progress-fast-save-and-start-speedrun (speedrun-category il-rolling)))
                 (((text-id speedrun-il-ogre)) (progress-fast-save-and-start-speedrun (speedrun-category il-ogre)))
                 (((text-id speedrun-il-village3)) (progress-fast-save-and-start-speedrun (speedrun-category il-village3)))
                 (((text-id speedrun-il-snow)) (progress-fast-save-and-start-speedrun (speedrun-category il-snow)))
                 (((text-id speedrun-il-cave)) (progress-fast-save-and-start-speedrun (speedrun-category il-cave)))
                 (((text-id speedrun-il-lavatube)) (progress-fast-save-and-start-speedrun (speedrun-category il-lavatube)))
                 (((text-id speedrun-il-citadel)) (progress-fast-save-and-start-speedrun (speedrun-category il-citadel)))
                 (((text-id speedrun-new-game-plus)) (progress-fast-save-and-start-speedrun (speedrun-category new-game-plus)))
                 (((text-id speedrun-hub1-100)) (progress-fast-save-and-start-speedrun (speedrun-category hub1-100)))
                 (((text-id speedrun-hub2-100)) (progress-fast-save-and-start-speedrun (speedrun-category hub2-100)))
                 (((text-id speedrun-hub3-100)) (progress-fast-save-and-start-speedrun (speedrun-category hub3-100)))
                 (((text-id speedrun-all-cutscenes)) (progress-fast-save-and-start-speedrun (speedrun-category all-cutscenes))))
               (commit-to-file *pc-settings*)
               ;; other behaviors are hardcoded elsewhere because screw you.
               )
              ((= (-> options (-> obj option-index) option-type) (game-option-type button-music))
               ;; go to the music+flava player
               (when (find-music-log (progress-get-music-by-index (-> obj option-index)))
                 (cpad-clear! 0 x)
                 (cpad-clear! 0 circle)
                 (set! *progress-music* (-> obj option-index))
                 (push! obj)
                 (sound-play "select-option")
                 (set! (-> obj next-display-state) (progress-screen flava-player))))
              ((= (-> options (-> obj option-index) option-type) (game-option-type button-flava))
               ;; set flava
               (when (find-flava-log (progress-get-music-by-index *progress-music*) (the int (-> options (-> obj option-index) param1)))
                 (cpad-clear! 0 x)
                 (cpad-clear! 0 circle)
                 (set-setting *setting-control* obj 'music (progress-get-music-by-index *progress-music*) 0.0 0)
                 (set! *progress-flava* (the int (-> options (-> obj option-index) param1)))
                 (sound-group-continue (sound-group music))
                 (sound-play "select-option")))
              ((= (-> options (-> obj option-index) option-type) (game-option-type resolution))
               ;; resolution button. change resolution!
               (let ((newx (the int (-> options (-> obj option-index) param1)))
                     (newy (the int (-> options (-> obj option-index) param2))))
                 (set-window-size! *pc-settings* newx newy))
               (cpad-clear! 0 x)
               (cpad-clear! 0 circle)
               (sound-play "cursor-options")
               (set! (-> obj next-display-state) (progress-screen invalid))
               (commit-to-file *pc-settings*))
              ;; TODO - might be able to simplify this with the new on-change func
              ((= (-> options (-> obj option-index) option-type) (game-option-type controller))
               (let ((controller-id (the int (-> options (-> obj option-index) param1))))
                 ;; NOTE - for now, we only manage port 0 in the progress menu
                 (pc-set-controller! controller-id 0))
               (cpad-clear! 0 x)
               (cpad-clear! 0 circle)
               (sound-play "cursor-options")
               (set! (-> obj next-display-state) (progress-screen invalid))
               (commit-to-file *pc-settings*))
              ((= (-> options (-> obj option-index) option-type) (game-option-type monitor))
               ;; monitor button
               (let ((monitor (the int (-> options (-> obj option-index) param1)))) (pc-set-display-id! monitor))
               (cpad-clear! 0 x)
               (cpad-clear! 0 circle)
               (sound-play "cursor-options")
               (set! (-> obj next-display-state) (progress-screen invalid))
               (commit-to-file *pc-settings*))
              ((= (-> options (-> obj option-index) option-type) (game-option-type aspect-new))
               ;; aspect ratio button.
               (let ((newx (the int (-> options (-> obj option-index) param1)))
                     (newy (the int (-> options (-> obj option-index) param2))))
                 (cond
                   ((= (-> options (-> obj option-index) name) (text-id fit-to-screen))
                    (set-aspect! *pc-settings* 4 3)
                    (false! (-> *pc-settings* use-vis?))
                    (set! (-> *setting-control* default aspect-ratio) 'aspect4x3)
                    (set-aspect-ratio 'aspect4x3)
                    (true! (-> *pc-settings* aspect-ratio-auto?)))
                   ((= newx -1.0)
                    (set-aspect! *pc-settings* 4 3)
                    (true! (-> *pc-settings* use-vis?))
                    (set! (-> *setting-control* default aspect-ratio) 'aspect4x3)
                    (set-aspect-ratio 'aspect4x3))
                   ((= newx -2.0)
                    (set-aspect! *pc-settings* 4 3)
                    (true! (-> *pc-settings* use-vis?))
                    (set! (-> *setting-control* default aspect-ratio) 'aspect16x9)
                    (set-aspect-ratio 'aspect16x9))
                   (else
                    (set! (-> *setting-control* default aspect-ratio) 'aspect4x3)
                    (set-aspect! *pc-settings* newx newy))))
               (cpad-clear! 0 x)
               (cpad-clear! 0 circle)
               (sound-play "cursor-options")
               (commit-to-file *pc-settings*)
               (set! (-> obj next-display-state) (progress-screen invalid)))
              ((and (= (-> options (-> obj option-index) option-type) (game-option-type cheat-toggle))
                    (not (logtest? (-> *pc-settings* cheats-known) (ash 1 (the int (-> options (-> obj option-index) param1))))))
               (sound-play "cursor-options")
               (if (and (= *cheat-mode* 'debug) (cpad-hold? 0 l1) (cpad-hold? 0 r1))
                 (logior! (-> *pc-settings* cheats-known) (ash 1 (the int (-> options (-> obj option-index) param1))))))
              ((!= (-> options (-> obj option-index) option-type) (game-option-type yes-no))
               ;; not yes-no
               ;; set backups! we're entering some toggle or whatever
               (case (-> options (-> obj option-index) option-type)
                 (((game-option-type slider))
                  (set! (-> *progress-state* slider-backup)
                        (-> (the-as (pointer float) (-> options (-> obj option-index) value-to-modify)))))
                 (((game-option-type language))
                  (set! (-> *progress-state* language-backup)
                        (-> (the-as (pointer language-enum) (-> options (-> obj option-index) value-to-modify)))))
                 (((game-option-type on-off) (game-option-type normal-inverted))
                  (set! (-> *progress-state* on-off-backup)
                        (-> (the-as (pointer symbol) (-> options (-> obj option-index) value-to-modify)))))
                 (((game-option-type confirmation)) (set! (-> *progress-state* on-off-backup) #f))
                 (((game-option-type binding-assignment))
                  (set! *progress-pad-timeout* (-> *display* real-frame-counter))
                  ;; Inform the C++ side to start listening for input
                  (pc-set-waiting-for-bind! (-> options (-> obj option-index) bind-info device-type)
                                            (not (-> options (-> obj option-index) bind-info for-buttons?))
                                            (-> options (-> obj option-index) bind-info analog-min-range?)
                                            (-> options (-> obj option-index) bind-info input-idx)))
                 (((game-option-type cheat-toggle))
                  (set! (-> *progress-state* on-off-backup)
                        (logtest? (-> *pc-settings* cheats) (ash 1 (the int (-> options (-> obj option-index) param1)))))
                  (set! (-> (the-as (pointer symbol) (-> options (-> obj option-index) value-to-modify)))
                        (-> *progress-state* on-off-backup)))
                 (((game-option-type display-mode))
                  ;; display-mode just reuses language stuff
                  (case (pc-get-display-mode)
                    (('windowed #f) (set! (-> *progress-carousell* int-backup) 0))
                    (('fullscreen #t) (set! (-> *progress-carousell* int-backup) 1))
                    (('borderless) (set! (-> *progress-carousell* int-backup) 2))))
                 (((game-option-type msaa))
                  (case (-> *pc-settings* gfx-msaa)
                    ((2) (set! (-> *progress-carousell* int-backup) 1))
                    ((4) (set! (-> *progress-carousell* int-backup) 2))
                    ((8) (set! (-> *progress-carousell* int-backup) 3))
                    ((16) (set! (-> *progress-carousell* int-backup) 4))
                    (else (set! (-> *progress-carousell* int-backup) 0))))
                 ;; Grecharged-ambient-occlusion: AO mode + quality + strength carousells map 1:1 (no value translation).
                 (((game-option-type ambient-occlusion))
                  (set! (-> *progress-carousell* int-backup) (-> *pc-settings* ambient-occlusion)))
                 (((game-option-type ao-quality))
                  (set! (-> *progress-carousell* int-backup) (-> *pc-settings* ao-quality)))
                 (((game-option-type ao-strength))
                  (set! (-> *progress-carousell* int-backup) (-> *pc-settings* ao-strength)))
                 ;; Ggrass-density-presets: GRASS DENSITY preset backup (1:1, meme motif de carrousel).
                 (((game-option-type grass-density)) (set! (-> *progress-carousell* int-backup) (-> *pc-settings* recharged-grass-density-preset)))
                 ;; Grecharged-secondary-motion: PHYSICS DETAIL backup (1:1, meme motif de carrousel).
                 (((game-option-type physics-quality)) (set! (-> *progress-carousell* int-backup) (-> *pc-settings* physics-quality)))
                 (((game-option-type lod-bg))
                  (case (-> *pc-settings* lod-force-tfrag)
                    ((0) (set! (-> *progress-carousell* int-backup) 0))
                    ((1 2) (set! (-> *progress-carousell* int-backup) 1))
                    (else (set! (-> *progress-carousell* int-backup) 2))))
                 (((game-option-type lod-fg))
                  (cond
                    ((-> *pc-settings* ps2-lod-dist?) (set! (-> *progress-carousell* int-backup) 1))
                    (else (set! (-> *progress-carousell* int-backup) 0))))
                 (((game-option-type speaker))
                  (case (-> *pc-settings* subtitle-speaker?)
                    ((#t) (set! (-> *progress-carousell* int-backup) 0))
                    ((#f) (set! (-> *progress-carousell* int-backup) 1))
                    (('auto) (set! (-> *progress-carousell* int-backup) 2))))
                 (((game-option-type frame-rate))
                  (case (-> *pc-settings* target-fps)
                    ((60) (set! (-> *progress-carousell* int-backup) 0))
                    ((100) (set! (-> *progress-carousell* int-backup) 1))
                    ((150) (set! (-> *progress-carousell* int-backup) 2))))
                 (((game-option-type language-subtitles))
                  (let ((cur-lang (get-language-name (-> *pc-settings* subtitle-language))))
                    (dotimes (i (-> *subtitle-languages* length))
                      (if (= (-> *subtitle-languages* i) cur-lang) (set! (-> *progress-carousell* int-backup) i)))))
                 (((game-option-type language-text))
                  (let ((cur-lang (get-language-name (-> *pc-settings* text-language))))
                    (dotimes (i (-> *text-languages* length))
                      (if (= (-> *text-languages* i) cur-lang) (set! (-> *progress-carousell* int-backup) i))))))
               (sound-play "select-option")
               (cpad-clear! 0 x)
               (cpad-clear! 0 circle)
               (set! (-> obj selected-option) #t)
               (case (-> options (-> obj option-index) option-type)
                 (((game-option-type language))
                  (set! (-> obj language-selection) (-> *setting-control* current language))
                  (set! (-> obj language-direction) #t)
                  (set! (-> obj language-transition) #f)
                  (set! (-> obj language-x-offset) 0))
                 (else
                  (set! (-> *progress-carousell* selection) (-> *progress-carousell* int-backup))
                  (set! (-> *progress-carousell* direction) #t)
                  (set! (-> *progress-carousell* transition) #f)
                  (set! (-> *progress-carousell* x-offset) 0)
                  (case (-> options (-> obj option-index) option-type)
                    (((game-option-type display-mode)) (set! (-> *progress-carousell* current-carousell) *carousell-display-mode*))
                    (((game-option-type msaa)) (set! (-> *progress-carousell* current-carousell) *carousell-msaa*))
                    (((game-option-type ambient-occlusion)) (set! (-> *progress-carousell* current-carousell) *carousell-ambient-occlusion*))
                    (((game-option-type ao-quality)) (set! (-> *progress-carousell* current-carousell) *carousell-ao-quality*))
                    (((game-option-type ao-strength)) (set! (-> *progress-carousell* current-carousell) *carousell-ao-strength*))
                    ;; Ggrass-density-presets: GRASS DENSITY carousell list.
                    (((game-option-type grass-density)) (set! (-> *progress-carousell* current-carousell) *carousell-grass-density*))
                    ;; Gprecompute-deterministic-bake: MESH SUBDIVISION carousell list.
                    ;; Grecharged-secondary-motion: PHYSICS DETAIL carousell list.
                    (((game-option-type physics-quality)) (set! (-> *progress-carousell* current-carousell) *carousell-physics-quality*))
                    (((game-option-type lod-bg)) (set! (-> *progress-carousell* current-carousell) *carousell-lod-bg*))
                    (((game-option-type lod-fg)) (set! (-> *progress-carousell* current-carousell) *carousell-lod-bg*))
                    (((game-option-type speaker)) (set! (-> *progress-carousell* current-carousell) *carousell-speaker*))
                    (((game-option-type frame-rate)) (set! (-> *progress-carousell* current-carousell) *carousell-frame-rate*))
                    (((game-option-type language-subtitles)) (set! (-> *progress-carousell* current-carousell) *subtitle-languages*))
                    (((game-option-type language-text)) (set! (-> *progress-carousell* current-carousell) *text-languages*))))))))
           (else
            ;; an option was selected. write stuff!
            (if (= (-> options (-> obj option-index) option-type) (game-option-type confirmation))
              (if (-> *progress-state* on-off-backup) (sound-play "menu-stats") (sound-play "cursor-options"))
              (sound-play "start-options"))
            (set! (-> obj selected-option) #f)
            (case (-> options (-> obj option-index) option-type)
              (((game-option-type cheat-toggle))
               (let ((the-cheat (ash 1 (the int (-> options (-> obj option-index) param1)))))
                 (cond
                   ((-> (the (pointer symbol) (-> options (-> obj option-index) value-to-modify)))
                    (logior! (-> *pc-settings* cheats) the-cheat))
                   (else
                    (logclear! (-> *pc-settings* cheats) the-cheat)
                    (when (and *target* (= the-cheat (pc-cheats invinc)))
                      (logclear! (-> *target* state-flags) (state-flags invulnerable)))))))
              (((game-option-type aspect-ratio))
               ;; aspect ratio is first written to the backup. so this is for applying the change if we went through with it.
               (set! (-> *setting-control* default aspect-ratio)
                     (-> (the-as (pointer symbol) (-> options (-> obj option-index) value-to-modify)))))
              (((game-option-type aspect-native))
               (set! (-> *pc-settings* use-vis?) (-> (the-as (pointer symbol) (-> options (-> obj option-index) value-to-modify))))
               (if (-> *pc-settings* use-vis?)
                 (set! (-> *setting-control* current aspect-ratio) #f)
                 (set-aspect! *pc-settings* (-> *pc-settings* aspect-custom-x) (-> *pc-settings* aspect-custom-y))))
              (((game-option-type display-mode))
               ;; same thing.
               (case (-> *progress-carousell* int-backup)
                 ((0) (pc-set-display-mode! 'windowed (-> *pc-settings* window-width) (-> *pc-settings* window-height)))
                 ((1) (pc-set-display-mode! 'fullscreen 0 0))
                 ((2) (pc-set-display-mode! 'borderless 0 0))))
              (((game-option-type msaa))
               (case (-> *progress-carousell* int-backup)
                 ((0) (set! (-> *pc-settings* gfx-msaa) 1))
                 ((1) (set! (-> *pc-settings* gfx-msaa) 2))
                 ((2) (set! (-> *pc-settings* gfx-msaa) 4))
                 ((3) (set! (-> *pc-settings* gfx-msaa) 8))
                 ((4) (set! (-> *pc-settings* gfx-msaa) 16))))
              ;; Grecharged-ambient-occlusion: write the selected carousell index straight back (1:1). The
              ;; shared (commit-to-file *pc-settings*) at the end of this else-branch persists it.
              (((game-option-type ambient-occlusion))
               (set! (-> *pc-settings* ambient-occlusion) (-> *progress-carousell* int-backup)))
              (((game-option-type ao-quality))
               (set! (-> *pc-settings* ao-quality) (-> *progress-carousell* int-backup)))
              (((game-option-type ao-strength))
               (set! (-> *pc-settings* ao-strength) (-> *progress-carousell* int-backup)))
              ;; Ggrass-density-presets: GRASS DENSITY preset write-back (1:1, meme motif de carrousel).
              (((game-option-type grass-density)) (set! (-> *pc-settings* recharged-grass-density-preset) (-> *progress-carousell* int-backup)))
              ;; Grecharged-secondary-motion: PHYSICS DETAIL write-back (1:1, meme motif de carrousel).
              (((game-option-type physics-quality)) (set! (-> *pc-settings* physics-quality) (-> *progress-carousell* int-backup)))
              (((game-option-type lod-bg))
               (case (-> *progress-carousell* int-backup)
                 ((0) (set! (-> *pc-settings* lod-force-tfrag) 0) (set! (-> *pc-settings* lod-force-tie) 0))
                 ((1) (set! (-> *pc-settings* lod-force-tfrag) 2) (set! (-> *pc-settings* lod-force-tie) 2))
                 ((2) (set! (-> *pc-settings* lod-force-tfrag) 2) (set! (-> *pc-settings* lod-force-tie) 3))))
              (((game-option-type lod-fg))
               (case (-> *progress-carousell* int-backup)
                 ((0) (set! (-> *pc-settings* lod-force-actor) 0) (set! (-> *pc-settings* ps2-lod-dist?) #f))
                 ((1) (set! (-> *pc-settings* lod-force-actor) 0) (set! (-> *pc-settings* ps2-lod-dist?) #t))))
              (((game-option-type language-subtitles))
               (let ((lang (assoc (the binteger (-> *subtitle-languages* (-> *progress-carousell* int-backup))) *language-remap-info-pc*)))
                 (set! (-> *pc-settings* subtitle-language) (the pc-language (/ (the int (cadr lang)) 8)))))
              (((game-option-type language-text))
               (let ((lang (assoc (the binteger (-> *text-languages* (-> *progress-carousell* int-backup))) *language-remap-info-pc*)))
                 (set! (-> *pc-settings* text-language) (the pc-language (/ (the int (cadr lang)) 8))))
               (if (not (-> *progress-carousell* transition)) (load-level-text-files (-> obj display-level-index)))
               ;; Glang-mixed: the bank just reloaded — re-copy the name-override label
               ;; buffers now so same-menu-session navigation shows the new language.
               (refresh-runtime-option-labels!))
              (((game-option-type speaker))
               ;; same thing.
               (case (-> *progress-carousell* int-backup)
                 ((0) (set! (-> *pc-settings* subtitle-speaker?) #t))
                 ((1) (set! (-> *pc-settings* subtitle-speaker?) #f))
                 ((2) (set! (-> *pc-settings* subtitle-speaker?) 'auto))))
              (((game-option-type frame-rate))
               (case (-> *progress-carousell* int-backup)
                 ((0) (set-frame-rate! *pc-settings* 60 #t))
                 ((1) (set-frame-rate! *pc-settings* 100 #t))
                 ((2) (set-frame-rate! *pc-settings* 150 #t)))
               (set-video-mode (-> *setting-control* default video-mode))))
            ;; if the option has a `on-confirm` function, run it
            (when (nonzero? (-> options (-> obj option-index) on-confirm))
              ((-> options (-> obj option-index) on-confirm)))
            (commit-to-file *pc-settings*)))))))
  (none))

(defmethod respond-memcard ((obj progress))
  "logic for handling input in memcard screens."
  (let ((s5-0 (-> obj card-info)))
    (when (and s5-0 (not (-> obj in-transition)))
      ;; Gtouch-fix: memcard screens consume the confirm press HERE (respond-common
      ;; deliberately leaves x un-cleared for their nameless button rows), so the
      ;; touch-confirm flag must be OR-ed in too — before this, a tap on a
      ;; save/load slot or a yes-no dialog could only FOCUS it, never activate.
      (when (or (cpad-pressed? 0 x) (cpad-pressed? 0 circle) (-> *menu-touch* confirm?))
        (cpad-clear! 0 x)
        (cpad-clear! 0 circle)
        (set! (-> *menu-touch* confirm?) #f)
        (case (-> obj display-state)
          (((progress-screen load-game))
           (cond
             ((< (-> obj option-index) 4)
              (when (nonzero? (-> s5-0 file (-> obj option-index) present))
                (sound-play "start-options")
                (set! (-> *progress-state* which) (-> obj option-index))
                (set! (-> obj next-display-state) (progress-screen memcard-loading))))
             (else (sound-play "cursor-options") (set! (-> obj next-display-state) (progress-screen invalid)))))
          (((progress-screen save-game) (progress-screen save-game-title))
           (cond
             ((< (-> obj option-index) 4)
              (sound-play "start-options")
              (set! (-> *progress-state* which) (-> obj option-index))
              ;; save slot selected
              (if (zero? (-> s5-0 file (-> obj option-index) present))
                (set! (-> obj next-display-state) (progress-screen memcard-saving))
                (set! (-> obj next-display-state) (progress-screen memcard-data-exists))))
             ;; continue without saving
             ((and (= (-> obj display-state) (progress-screen save-game-title)) (= (-> obj option-index) 4))
              (sound-play "starts-options")
              (sound-volume-off)
              (set! (-> *game-info* mode) 'play)
              (if (= (-> *pc-settings* speedrunner-mode?) #t)
                ;; Start a new game differently if speedrunning mode is active
                (speedrun-start-full-game-run)
                ;; start the game normally
                (initialize! *game-info* 'game (the-as game-save #f) "intro-start"))
              (set-master-mode 'game))
             (else (sound-play "cursor-options") (set! (-> obj next-display-state) (progress-screen invalid)))))
          (((progress-screen memcard-insert))
           (sound-play "cursor-options")
           (set! (-> obj next-display-state) (progress-screen invalid)))
          (((progress-screen memcard-data-exists))
           (cond
             ((-> *progress-state* yes-no-choice)
              (sound-play "start-options")
              (set! (-> obj next-display-state) (progress-screen memcard-saving)))
             (else
              (sound-play "cursor-options")
              (if (= (-> obj display-state-stack 0) (progress-screen title))
                (set! (-> obj next-display-state) (progress-screen save-game-title))
                (set! (-> obj next-display-state) (progress-screen save-game))))))
          (((progress-screen memcard-no-data))
           (cond
             ((-> *progress-state* yes-no-choice)
              (sound-play "start-options")
              (set! (-> obj next-display-state) (progress-screen memcard-creating)))
             (else
              (sound-play "cursor-options")
              (sound-volume-off)
              (set! (-> *game-info* mode) 'play)
              ;; Start a new game differently if speedrunning mode is active
              (cond
                ((-> *pc-settings* speedrunner-mode?) (speedrun-start-full-game-run))
                ;; start the game normally
                (else (initialize! *game-info* 'game (the-as game-save #f) "intro-start")))
              (set-master-mode 'game))))
          (((progress-screen memcard-no-space) (progress-screen memcard-not-inserted) (progress-screen memcard-not-formatted))
           (cond
             ((= (-> obj display-state-stack 0) (progress-screen title))
              (sound-play "start-options")
              (sound-volume-off)
              (set! (-> *game-info* mode) 'play)
              ;; Start a new game differently if speedrunning mode is active
              (cond
                ((-> *pc-settings* speedrunner-mode?) (speedrun-start-full-game-run))
                ;; start the game normally
                (else (initialize! *game-info* 'game (the-as game-save #f) "intro-start")))
              (set-master-mode 'game))
             ((nonzero? (-> obj display-state-stack 0)) (sound-play "start-options") (set-master-mode 'game))
             (else (sound-play "cursor-options") (set! (-> obj next-display-state) (progress-screen invalid)))))
          (((progress-screen memcard-error-loading)
            (progress-screen memcard-error-saving)
            (progress-screen memcard-error-formatting)
            (progress-screen memcard-error-creating)
            (progress-screen memcard-auto-save-error)
            (progress-screen memcard-removed)
            (progress-screen auto-save)
            (progress-screen memcard-auto-save-disabled))
           (sound-play "cursor-options")
           (set! (-> obj next-display-state) (progress-screen invalid)))
          (((progress-screen pal-change-to-60hz))
           (cond
             ((-> *progress-state* yes-no-choice)
              (sound-play "start-options")
              (set! (-> *setting-control* default video-mode) (-> *progress-state* video-mode-choice))
              (set! (-> obj video-mode-timeout) (-> *display* real-frame-counter))
              (set! (-> obj next-display-state) (progress-screen pal-now-60hz)))
             (else
              (sound-play "cursor-options")
              (set! (-> *progress-state* video-mode-choice) 'pal)
              (set! (-> obj next-display-state) (progress-screen invalid)))))
          (((progress-screen pal-now-60hz))
           (cond
             ((not (-> *progress-state* yes-no-choice))
              (set! (-> *progress-state* video-mode-choice) 'pal)
              (set! (-> *setting-control* default video-mode) (-> *progress-state* video-mode-choice))
              (sound-play "cursor-options"))
             (else (sound-play "start-options")))
           (set! (-> obj next-display-state) (progress-screen invalid)))
          (((progress-screen no-disc) (progress-screen bad-disc))
           (when (is-cd-in?)
             (sound-play "cursor-options")
             (set! (-> obj next-display-state) (progress-screen invalid))))
          (((progress-screen quit))
           (cond
             ((-> *progress-state* yes-no-choice)
              (set! *quit-to-title* #t)
              (sound-play "start-options")
              (sound-volume-off)
              (set! (-> *game-info* mode) 'play)
              (initialize! *game-info* 'game (the-as game-save #f) "title-start"))
             (else (sound-play "cursor-options") (set! (-> obj next-display-state) (progress-screen invalid)))))
          (((progress-screen memcard-format))
           (cond
             ((-> *progress-state* yes-no-choice)
              (sound-play "start-options")
              (set! (-> obj next-display-state) (progress-screen memcard-formatting)))
             ((= (-> obj display-state-stack 0) (progress-screen title))
              (sound-play "start-options")
              (sound-volume-off)
              (set! (-> *game-info* mode) 'play)
              ;; Start a new game differently if speedrunning mode is active
              (cond
                ((-> *pc-settings* speedrunner-mode?) (speedrun-start-full-game-run))
                ;; start the game normally
                (else (initialize! *game-info* 'game (the-as game-save #f) "intro-start")))
              (set-master-mode 'game))
             (else (sound-play "cursor-options") (set! (-> obj next-display-state) (progress-screen invalid)))))
          (((progress-screen quit-title))
           (cond
             ((-> *progress-state* yes-no-choice)
              (sound-play "start-options")
              (commit-to-file *pc-settings*)
              (sound-volume-off)
              (kernel-shutdown))
             (else (sound-play "cursor-options") (set! (-> obj next-display-state) (progress-screen invalid)))))
          (((progress-screen memcard-disable-auto-save))
           (cond
             ((-> *progress-state* yes-no-choice)
              (sound-play "start-options")
              (set! (-> *setting-control* default auto-save) #f)
              (set! (-> obj next-display-state) (progress-screen memcard-auto-save-disabled)))
             (else (sound-play "cursor-options") (set! (-> obj next-display-state) (progress-screen invalid)))))))))
  0
  (none))

;; Grecharged-menu-overhaul MECHANISM 2 (live value on 100% of value-bearing rows): return the display
;; string of a carousell's CURRENT choice, read from the LIVE setting (not the *progress-carousell*
;; int-backup scratch, which is only valid while a row is being edited). Mirrors the select-time seeding
;; at the top of respond-common so an UNSELECTED carousell row can show its choice inline, exactly like
;; on-off rows already show ': ON'/': OFF' and sliders show ': 50'. Returns #f for the non-list types
;; (aspect-ratio / normal-inverted / confirmation) so the caller falls back to name-only.
(defun carousell-current-string ((ty game-option-type))
  (let ((lst (the (array text-id) #f))
        (idx 0))
    (case ty
      (((game-option-type display-mode))
       (set! lst *carousell-display-mode*)
       (set! idx (case (pc-get-display-mode) (('windowed #f) 0) (('fullscreen #t) 1) (('borderless) 2) (else 0))))
      (((game-option-type msaa))
       (set! lst *carousell-msaa*)
       (set! idx (case (-> *pc-settings* gfx-msaa) ((2) 1) ((4) 2) ((8) 3) ((16) 4) (else 0))))
      (((game-option-type ambient-occlusion)) (set! lst *carousell-ambient-occlusion*) (set! idx (-> *pc-settings* ambient-occlusion)))
      (((game-option-type ao-quality)) (set! lst *carousell-ao-quality*) (set! idx (-> *pc-settings* ao-quality)))
      (((game-option-type ao-strength)) (set! lst *carousell-ao-strength*) (set! idx (-> *pc-settings* ao-strength)))
      (((game-option-type grass-density)) (set! lst *carousell-grass-density*) (set! idx (-> *pc-settings* recharged-grass-density-preset)))
      (((game-option-type physics-quality)) (set! lst *carousell-physics-quality*) (set! idx (-> *pc-settings* physics-quality)))
      (((game-option-type lod-bg)) (set! lst *carousell-lod-bg*) (set! idx (case (-> *pc-settings* lod-force-tfrag) ((0) 0) ((1 2) 1) (else 2))))
      (((game-option-type lod-fg)) (set! lst *carousell-lod-bg*) (set! idx (if (-> *pc-settings* ps2-lod-dist?) 1 0)))
      (((game-option-type speaker)) (set! lst *carousell-speaker*) (set! idx (case (-> *pc-settings* subtitle-speaker?) ((#t) 0) ((#f) 1) (('auto) 2) (else 0))))
      (((game-option-type frame-rate)) (set! lst *carousell-frame-rate*) (set! idx (case (-> *pc-settings* target-fps) ((60) 0) ((100) 1) ((150) 2) (else 0)))))
    (if lst
      (begin
        (when (or (< idx 0) (>= idx (length lst))) (set! idx (max 0 (min idx (+ (length lst) -1)))))
        (carousell-option-string (-> lst idx)))
      (the string #f))))

(defmethod draw-options ((obj progress) (arg0 int) (arg1 int) (arg2 float))
  "common logic for drawing options menus."
  (let ((options (-> *options-remap* (-> obj display-state))))
    (when options
      ;; this menu has options to draw omg
      ;; Gtouch-menus: start a fresh per-frame layout capture for touch hit-testing.
      (set! (-> *menu-touch* n-rows) 0)
      (set! (-> *menu-touch* screen) (-> obj display-state))
      ;; V4 (owner: interlignes trop grands): tighten the row pitch on holo screens BEFORE y-off is
      ;; computed, so the centering AND the per-row advance both use the tightened HOLO_LINE_PITCH.
      (when (progress-holo-screen? (-> obj display-state)) (set! arg1 HOLO_LINE_PITCH))
      (let* ((line-amt (if (> (length options) PROGRESS_PC_PAGE_HEIGHT) (1- PROGRESS_PC_PAGE_HEIGHT) (length options)))
             (y-off (- arg0 (/ (* arg1 line-amt) 2)))
             (option-count 0)
             (unkx 27)
             (unk2 0)
             ;; Grecharged-menu-overhaul V2: only the navigable options/menu screens live inside the
             ;; half-width hologram. On those, the text box, width, scale and hint line all derive from the
             ;; holo frame constants; every other screen (memcard notices, file-select, stat pages) keeps
             ;; its original full-width layout untouched.
             (holo? (progress-holo-screen? (-> obj display-state)))
             (opt-x0 (if holo? HOLO_TEXT_X 17))
             (txt-w (if holo? HOLO_TEXT_W 370))
             (scl (if holo? HOLO_SCALE 1.0))
             (font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning)))
             (locked-str (lookup-text! *common-text* (text-id locked) #f)))
        ;; set the common params for the text drawing
        (set-width! font txt-w)
        (set-height! font 25)
        (set! (-> font flags) (font-flags shadow kerning middle middle-vert large))
        ;; set scroll arrow sprite vertical position right now
        (set! (-> obj particles 32 init-pos y) (the float (* 2 (- y-off 20))))
        ;; when scrolling we draw an extra line
        (cond
          ((progress-scrolling-down?)
           (set! y-off (+ (- y-off arg1) (* (the float arg1) (- 1.0 (-> *progress-scroll* transition))))))
          ((progress-scrolling-up?) (set! y-off (+ (- y-off arg1) (* (the float arg1) (-> *progress-scroll* transition))))))
        (let ((draw-arrows (and (not (-> obj in-transition))
                                (= (-> obj next-state name) 'progress-normal)
                                (> (length options) PROGRESS_PC_PAGE_HEIGHT)
                                (< (mod (-> *display* real-frame-counter) (seconds 0.2)) (seconds 0.1))))
              (draw-prev (< 0 *progress-scroll-start*))
              (draw-next (> (length options) *progress-scroll-end*)))
          (set! (-> obj particles 32 init-pos x)
                (the float (if (and draw-arrows draw-prev) (- 195 (-> *progress-process* 0 left-x-offset)) -320)))
          (set! (-> obj particles 33 init-pos x)
                (the float (if (and draw-arrows draw-next) (- 195 (-> *progress-process* 0 left-x-offset)) -320))))
        ;; cheating a bit and putting some screen-specific code here. it's not a big deal.
        (case (-> obj display-state)
          (((progress-screen music-player))
           (set-color! font (font-color default))
           (set-origin! font (- opt-x0 (-> obj left-x-offset)) 14)
           (set-scale! font (* 0.6 scl (-> obj transition-percentage-invert)))
           (print-game-text (lookup-text! *common-text* (text-id select-level) #f)
                            font
                            #f
                            (the int (* 128.0 (-> obj transition-percentage-invert)))
                            22))
          (((progress-screen flava-player))
           (set-color! font (font-color default))
           (set-origin! font (- opt-x0 (-> obj left-x-offset)) 14)
           (set-scale! font (* 0.6 scl (-> obj transition-percentage-invert)))
           (print-game-text (lookup-text! *common-text* (text-id select-flava) #f)
                            font
                            #f
                            (the int (* 128.0 (-> obj transition-percentage-invert)))
                            22)))
        (dotimes (index (length options))
          (let ((option-str (the string #f)) ;; the option text
                ;; V3-D (owner 2026-08-02): sections are spatially separated — option rows are INDENTED
                ;; SECTION_INDENT px to the right of their (left-hanging) section header, on holo screens.
                (option-x (if (and holo? (!= (-> options index option-type) (game-option-type group-header)))
                            (+ opt-x0 SECTION_INDENT)
                            opt-x0))
                (option-y y-off)
                (locked? #f))
            ;; hdr-output-visible : CE QUI EST DESSINE. Quand la rangee de sortie HDR passe dans
            ;; cette boucle, on rapporte au C++ l'etat que son libelle porte A CET INSTANT. C'est
            ;; la seule sonde qui dise a la fois « la page est affichee » et « voici la ligne
            ;; qu'elle montre » ; le C++ la compare au regime courant depuis SON fil, a SON
            ;; instant — un juge et son juge sur le meme fil ne comparent qu'une expression a
            ;; elle-meme. La garde est un ordre de CHARGEMENT, le meme drapeau que le crochet par
            ;; image : tant que le niveau superieur de ce fichier n'a pas tourne, ni le libelle ni
            ;; l'etat n'existent, et on ne saute nulle part.
            (when (and *hdr-label-hook-ready?*
                       (nonzero? (-> options index name-override))
                       (= (-> options index name-override) *hdr-output-label*))
              (pc-hdr-output-label-drawn! *hdr-output-state-last*))
            ;; Check if the option should be disabled
            (when (and (nonzero? (-> options index option-disabled-func))
                       (!= (-> options index option-disabled-func) #f)
                       ((-> options index option-disabled-func)))
              (set! locked? #t))
            (case (-> options index option-type)
              (((game-option-type yes-no))
               ;; yes-no option. text is either '->YES<- NO' or 'YES ->NO<-', not the most robust but this option is a strange hack anyway.
               (if (-> (the-as (pointer uint32) (-> options index value-to-modify)))
                 (set! option-str
                       (string-format "~30L~S~0L ~S"
                                      (lookup-text! *common-text* (text-id yes) #f)
                                      (lookup-text! *common-text* (text-id no) #f)))
                 (set! option-str
                       (string-format "~0L~S ~30L~S"
                                      (lookup-text! *common-text* (text-id yes) #f)
                                      (lookup-text! *common-text* (text-id no) #f)))))
              ;; menu option or simple button. just draw its text!
              (((game-option-type menu) (game-option-type button))
               ;; Goptions-reorder: prefer a runtime name-override when set (e.g. "ADVANCED SETTINGS"
               ;; for the renamed PS2 Options menu row); otherwise fall back to the localized name.
               (cond
                 ((nonzero? (-> options index name-override))
                  (set! option-str (-> options index name-override)))
                 ((nonzero? (-> options index name))
                  (set! option-str (lookup-text! *common-text* (-> options index name) #f)))
                 (else (set! option-str #f)))
               ;; if autosave disabled, update text and lock it
               (when (and (not (-> *setting-control* default auto-save)) (= (text-id disable-auto-save) (-> options index name)))
                 (set! option-str (lookup-text! *common-text* (text-id auto-save-disabled) #f))
                 (true! locked?))
               ;; checkpoint-select only unlocked after beating finalboss
               (when (and (not (task-closed? (game-task finalboss-movies) (task-status need-reminder)))
                          (= (text-id checkpoint-select) (-> options index name)))
                 (set! option-str (lookup-text! *common-text* (text-id cheat-req-beat-game) #f))
                 (true! locked?)))
              (((game-option-type button-music))
               ;; a button for the music player. has the text "locked" sometimes!
               (if (and (nonzero? (-> options index name)) (find-music-log (progress-get-music-by-index index)))
                 (set! option-str (lookup-text! *common-text* (-> options index name) #f))
                 (set! option-str locked-str)))
              (((game-option-type button-flava))
               ;; a button for the flava player. has the text "locked" sometimes!
               (if (and (nonzero? (-> options index name))
                        (find-flava-log (progress-get-music-by-index *progress-music*) (the int (-> options index param1))))
                 (set! option-str (lookup-text! *common-text* (-> options index name) #f))
                 (set! option-str locked-str)))
              (((game-option-type resolution) (game-option-type aspect-new))
               ;; resolution settings
               ;; prefer a runtime name-override label when one was set: it already
               ;; contains the full clean text (e.g. 'NATIVE 2400 X 1080' / '1280 X 576')
               (if (nonzero? (-> options index name-override))
                 (set! option-str (string-format "~S" (-> options index name-override)))
                 (set! option-str
                       (string-format (lookup-text! *common-text* (-> options index name) #f)
                                      (the int (-> options index param1))
                                      (the int (-> options index param2))))))
              (((game-option-type monitor))
               ;; monitor list
               (if (nonzero? (-> options index name-override))
                 (set! option-str (string-format "~S (~D)" (-> options index name-override) (+ 1 (the int (-> options index param1)))))
                 (set! option-str
                       (string-format (lookup-text! *common-text* (-> options index name) #f) (+ 1 (the int (-> options index param1)))))))
              (((game-option-type controller))
               ;; controller list
               (if (nonzero? (-> options index name-override))
                 (set! option-str (string-format "~S (~D)" (-> options index name-override) (+ 1 (the int (-> options index param1)))))
                 (set! option-str
                       (string-format (lookup-text! *common-text* (-> options index name) #f) (+ 1 (the int (-> options index param1)))))))
              (else
               (cond
                 ((and (-> obj selected-option) (= (-> obj option-index) index))
                  ;; this option is SELECTED!
                  (set-color! font (font-color default))
                  (set! (-> font origin x) (the float (- option-x (-> obj left-x-offset))))
                  (set! (-> font origin y) (the float (+ y-off -8)))
                  (set-scale! font (* 0.6 scl))
                  ;; we use the binding name for the selected text header
                  (if (= (-> options index option-type) (game-option-type binding-assignment))
                    ;; display timeout in seconds
                    (let ((time-left (the int (+ 11.0 (* (/ 1.0 TICKS_PER_SECOND) (* -1.0 (- (-> *display* real-frame-counter) *progress-pad-timeout*)))))))
                      ;; if the timeout is over, unselect the option
                      (when (<= time-left 0)
                        (set! (-> obj selected-option) #f)
                        (sound-play "menu-stats")
                        (pc-stop-waiting-for-bind!))
                      (when (not (pc-waiting-for-bind?))
                        (set! (-> obj selected-option) #f)
                        (sound-play "cursor-options"))
                      (print-game-text (string-format "~S (~4L~D~0L)" (-> options index name-override) time-left) font #f 128 22))
                    ;; prefer a runtime name-override label when one was set (e.g. FPS-counter toggle)
                    (if (nonzero? (-> options index name-override))
                      (print-game-text (-> options index name-override) font #f 128 22)
                      (print-game-text (lookup-text! *common-text* (-> options index name) #f) font #f 128 22)))
                  (set! option-y (+ y-off 7))
                  (case (-> options index option-type)
                    (((game-option-type slider))
                     ;; draw a slider and its text.
                     ;; this ugliness is just decompiler stuff. all it does is fade the alpha according to value.
                     (let* ((v1-82 (the-as uint #x8000ffff))
                            ;; calculate the percentage of the bar based on the actual range, instead of assuming 0-100
                            (percentage (lerp-scale 0.0 1.0 (-> (the-as (pointer float) (-> options index value-to-modify))) (-> options index param1) (-> options index param2)))
                            (a0-34 (logior (logand v1-82 -256) (shr (shl (the int (+ 64.0 (* 191.0 percentage))) 56) 56)))
                            (color (logior (logand a0-34 -65281) (shr (shl (shr (shl a0-34 56) 56) 56) 48))))
                       ;; Grecharged-menu-overhaul V2: inside the holo, the bar spans the narrow text box and
                       ;; the numeric value is centered over it; the wide full-screen bar stays on non-holo screens.
                       (cond
                         (holo?
                          (draw-percent-bar-w HOLO_TEXT_X (+ y-off 8) HOLO_TEXT_W percentage (the-as rgba color))
                          (set! option-x HOLO_TEXT_X))
                         (else
                          (draw-percent-bar (- 75 (-> obj left-x-offset)) (+ y-off 8) percentage (the-as rgba color))
                          (set! option-x (+ (the int (* 2.5 (* 100.0 percentage))) -100)))))
                     (if (= (-> options index slider-show-decimal?) #t)
                       (set! option-str (string-format "~,,1f" (-> (the-as (pointer float) (-> options index value-to-modify)))))
                       (set! option-str (string-format "~D" (the int (-> (the-as (pointer float) (-> options index value-to-modify))))))))
                    (((game-option-type on-off) (game-option-type normal-inverted) (game-option-type aspect-native))
                     ;; on-off option or some other toggle. same logic as yes-no. changed to cut down code duping.
                     (let ((on-str (case (-> options index option-type)
                                     (((game-option-type on-off) (game-option-type aspect-native)) (lookup-text! *common-text* (text-id on) #f))
                                     (((game-option-type normal-inverted)) (lookup-text! *common-text* (text-id inverted) #f))))
                           (off-str (case (-> options index option-type)
                                      (((game-option-type on-off) (game-option-type aspect-native)) (lookup-text! *common-text* (text-id off) #f))
                                      (((game-option-type normal-inverted)) (lookup-text! *common-text* (text-id normal) #f)))))
                       (if (-> (the-as (pointer symbol) (-> options index value-to-modify)))
                         (set! option-str (string-format "~30L~S~0L ~S" on-str off-str))
                         (set! option-str (string-format "~0L~S ~30L~S" on-str off-str)))))
                    ;; the same as yes-no, but we aren't changing an underlying value.
                    (((game-option-type confirmation))
                     (if (-> *progress-state* on-off-backup)
                       (set! option-str
                             (string-format "~30L~S~0L ~S"
                                            (lookup-text! *common-text* (text-id yes) #f)
                                            (lookup-text! *common-text* (text-id no) #f)))
                       (set! option-str
                             (string-format "~0L~S ~30L~S"
                                            (lookup-text! *common-text* (text-id yes) #f)
                                            (lookup-text! *common-text* (text-id no) #f)))))
                    (((game-option-type cheat-toggle))
                     (if (-> (the-as (pointer symbol) (-> options index value-to-modify)))
                       (set! option-str
                             (string-format "~30L~S~0L ~S"
                                            (lookup-text! *common-text* (text-id on) #f)
                                            (lookup-text! *common-text* (text-id off) #f)))
                       (set! option-str
                             (string-format "~0L~S ~30L~S"
                                            (lookup-text! *common-text* (text-id on) #f)
                                            (lookup-text! *common-text* (text-id off) #f)))))
                    (((game-option-type binding-assignment))
                     (let ((bind (pc-get-current-bind (-> options index bind-info) *pc-cpp-temp-string*)))
                       (cond
                         ((= bind #f) (set! option-str (string-format "~S" (lookup-text! *common-text* (text-id input-opts-binds-unset) #f))))
                         ((string= *pc-cpp-temp-string* "unknown")
                          (set! option-str (string-format "~S" (lookup-text! *common-text* (text-id input-opts-binds-unknown) #f))))
                         (else (set! option-str (string-format "~S" *pc-cpp-temp-string*))))))
                    (((game-option-type display-mode)
                      (game-option-type msaa)
                      (game-option-type ambient-occlusion)
                      (game-option-type ao-quality)
                      (game-option-type ao-strength)
                      (game-option-type grass-density)
                      (game-option-type physics-quality)
                      (game-option-type lod-bg)
                      (game-option-type lod-fg)
                      (game-option-type speaker)
                      (game-option-type frame-rate)
                      (game-option-type language-subtitles)
                      (game-option-type language-text))
                     ;; crunched down to one generic function.
                     (progress-draw-carousell-from-string-list (-> *progress-carousell* current-carousell)
                                                               font
                                                               y-off
                                                               (-> (the-as (pointer int) (-> options index value-to-modify)))))
                    (((game-option-type language))
                     ;; language carousell. who knew this could be so complicated.
                     (let ((old-lang (-> obj language-selection))
                           (new-lang (-> (the-as (pointer language-enum) (-> options index value-to-modify))))
                           (max-lang 6))
                       (if (-> obj language-transition)
                         (seekl! (-> obj language-x-offset) 200 (the int (* 10.0 (-> *display* time-adjust-ratio)))))
                       (when (>= (-> obj language-x-offset) 100)
                         (set! (-> obj language-selection) new-lang)
                         (set! old-lang new-lang)
                         (set! (-> obj language-transition) #f)
                         (set! (-> obj language-x-offset) 0))
                       (set! (-> font origin y) (the float (+ y-off 3)))
                       (set-color! font (font-color progress-blue))
                       0
                       (let ((next-lang (mod (+ old-lang 1) max-lang))
                             (prev-lang (mod (+ max-lang -1 old-lang) max-lang))
                             ;; these are used during the transition since it technically allows you to see 4 langs at once.
                             (next2-lang (mod (+ old-lang 2) max-lang))
                             (prev2-lang (mod (+ max-lang -2 old-lang) max-lang)))
                         (cond
                           ((-> obj language-direction)
                            (let ((a2-22 (- 200 (+ (-> obj language-x-offset) 100)))) (print-language-name prev-lang font a2-22 #f))
                            (set-color! font (font-color progress-blue))
                            (let ((a2-23 (+ (-> obj language-x-offset) 100)))
                              (cond
                                ((< a2-23 150) (print-language-name (the int next-lang) font a2-23 #t))
                                (else (let ((a2-24 (- 200 (-> obj language-x-offset)))) (print-language-name prev2-lang font a2-24 #f))))))
                           (else
                            (let ((a2-25 (+ (-> obj language-x-offset) 100)))
                              (cond
                                ((< a2-25 150) (print-language-name prev-lang font a2-25 #f))
                                (else (let ((a2-26 (- 200 (-> obj language-x-offset)))) (print-language-name (the int next2-lang) font a2-26 #t)))))
                            (set-color! font (font-color progress-blue))
                            (let ((a2-27 (- 200 (+ (-> obj language-x-offset) 100)))) (print-language-name (the int next-lang) font a2-27 #t)))))
                       (if (not (-> obj language-transition)) (set-color! font (font-color progress-selected)))
                       (print-language-name (the-as int old-lang) font (-> obj language-x-offset) (-> obj language-direction))))
                    (((game-option-type aspect-ratio))
                     ;; same as on-off but checks a different symbol
                     (if (= (-> (the-as (pointer symbol) (-> options index value-to-modify))) 'aspect4x3)
                       (set! option-str
                             (string-format "~30L~S~0L ~S"
                                            (lookup-text! *common-text* (text-id 4x3) #f)
                                            (lookup-text! *common-text* (text-id 16x9) #f)))
                       (set! option-str
                             (string-format "~0L~S ~30L~S"
                                            (lookup-text! *common-text* (text-id 4x3) #f)
                                            (lookup-text! *common-text* (text-id 16x9) #f)))))))
                 (else
                  ;; this option is not selected
                  (case (-> options index option-type)
                    (((game-option-type slider))
                     ;; Gtouch-fix: sliders show their CURRENT VALUE inline (like on-off
                     ;; rows show ': ON'). Before, an unselected slider showed only its
                     ;; name, so a tap that stepped the value gave ZERO visible feedback
                     ;; ('sliders not clickable at all').
                     (let ((label (if (nonzero? (-> options index name-override))
                                    (-> options index name-override)
                                    (lookup-text! *common-text* (-> options index name) #f))))
                       (cond
                         ((zero? (-> options index value-to-modify))
                          (set! option-str label))
                         ((= (-> options index slider-show-decimal?) #t)
                          (set! option-str
                                (string-format "~S: ~,,1f" label (-> (the-as (pointer float) (-> options index value-to-modify))))))
                         (else
                          (set! option-str
                                (string-format "~S: ~D" label (the int (-> (the-as (pointer float) (-> options index value-to-modify))))))))))
                    (((game-option-type aspect-ratio)
                      (game-option-type display-mode)
                      (game-option-type msaa)
                      (game-option-type ambient-occlusion)
                      (game-option-type ao-quality)
                      (game-option-type ao-strength)
                      (game-option-type grass-density)
                      (game-option-type physics-quality)
                      (game-option-type lod-bg)
                      (game-option-type lod-fg)
                      (game-option-type speaker)
                      (game-option-type frame-rate)
                      (game-option-type normal-inverted)
                      (game-option-type confirmation))
                     ;; Grecharged-menu-overhaul MECHANISM 2: give the CAROUSELL family a live inline value
                     ;; too (': CHOICE'), like on-off/slider rows already do. carousell-current-string reads
                     ;; the live setting and returns #f for the genuinely value-less types (aspect-ratio /
                     ;; normal-inverted / confirmation), which then fall back to name-only as before.
                     (let ((label (if (nonzero? (-> options index name-override))
                                    (-> options index name-override)
                                    (lookup-text! *common-text* (-> options index name) #f)))
                           (choice (carousell-current-string (-> options index option-type))))
                       (if choice
                         (set! option-str (string-format "~S: ~S" label choice))
                         (set! option-str label))))
                    (((game-option-type group-header))
                     ;; Grecharged-menu-overhaul MECHANISM 1: a non-selectable group header. It draws its
                     ;; label only (no value), in a distinct color, with the selection cursor never on it
                     ;; (focus nav skips it). Prefer name-override, else the text-id label.
                     (if (nonzero? (-> options index name-override))
                       (set! option-str (-> options index name-override))
                       (set! option-str (lookup-text! *common-text* (-> options index name) #f))))
                    (((game-option-type on-off) (game-option-type aspect-native))
                     ;; on-off options show their text + on or off
                     ;; prefer a runtime name-override label when one was set (e.g. FPS-counter toggle)
                     (let ((label (if (nonzero? (-> options index name-override))
                                    (-> options index name-override)
                                    (lookup-text! *common-text* (-> options index name) #f))))
                       (set! option-str
                             (string-format "~S: ~S"
                                            label
                                            (if (-> (the-as (pointer uint32) (-> options index value-to-modify)))
                                              (lookup-text! *common-text* (text-id on) #f)
                                              (lookup-text! *common-text* (text-id off) #f))))))
                    (((game-option-type binding-assignment))
                     ;; binding assignment options show their input + the current binding
                     (let ((bind (pc-get-current-bind (-> options index bind-info) *pc-cpp-temp-string*)))
                       (cond
                         ((= bind #f)
                          (set! option-str
                                (string-format "~S: ~10L~S~0L"
                                               (-> options index name-override)
                                               (lookup-text! *common-text* (text-id input-opts-binds-unset) #f))))
                         ((string= *pc-cpp-temp-string* "unknown")
                          (set! option-str
                                (string-format "~S: ~10L~S~0L"
                                               (-> options index name-override)
                                               (lookup-text! *common-text* (text-id input-opts-binds-unknown) #f))))
                         (else (set! option-str (string-format "~S: ~10L~S~0L" (-> options index name-override) *pc-cpp-temp-string*))))))
                    (((game-option-type cheat-toggle))
                     (cond
                       ((not (logtest? (-> *pc-settings* cheats-known) (ash 1 (the int (-> options index param1)))))
                        (true! locked?)
                        (case (ash 1 (the int (-> options index param1)))
                          (((pc-cheats eco-blue)
                            (pc-cheats eco-green)
                            (pc-cheats eco-red)
                            (pc-cheats eco-yellow)
                            (pc-cheats invinc)
                            (pc-cheats huge-head)
                            (pc-cheats mirror)
                            (pc-cheats no-tex))
                           (set! option-str (lookup-text! *common-text* (text-id cheat-req-100-percent) #f)))
                          (((pc-cheats sky)
                            (pc-cheats sidekick-blue)
                            (pc-cheats tunes)
                            (pc-cheats big-head)
                            (pc-cheats small-head)
                            (pc-cheats big-fist)
                            (pc-cheats big-head-npc))
                           (set! option-str (lookup-text! *common-text* (text-id cheat-req-beat-game) #f)))
                          (else
                           ;; (format 0 "weird case ~f #x~x~%" (-> options index param1) (ash 1 (the int (-> options index param1))))
                           (set! option-str locked-str))))
                       (else
                        (set! option-str
                              (string-format "~S: ~S"
                                             (lookup-text! *common-text* (-> options index name) #f)
                                             (if (logtest? (-> *pc-settings* cheats) (ash 1 (the int (-> options index param1))))
                                               (lookup-text! *common-text* (text-id on) #f)
                                               (lookup-text! *common-text* (text-id off) #f)))))))
                    (((game-option-type language))
                     ;; language options show their text + language name
                     (set! option-str
                           (string-format "~S: ~S"
                                          (lookup-text! *common-text* (-> options index name) #f)
                                          (lookup-text! *common-text*
                                                        (-> *language-name-remap* (-> (the-as (pointer uint64) (-> options index value-to-modify))))
                                                        #f))))
                    (((game-option-type language-subtitles))
                     (set! option-str
                           (string-format "~S: ~S"
                                          (lookup-text! *common-text* (-> options index name) #f)
                                          (lookup-text! *common-text* (get-language-name (-> *pc-settings* subtitle-language)) #f))))
                    (((game-option-type language-text))
                     (set! option-str
                           (string-format "~S: ~S"
                                          (lookup-text! *common-text* (-> options index name) #f)
                                          (lookup-text! *common-text* (get-language-name (-> *pc-settings* text-language)) #f)))))))))
            (when (or (<= (length options) PROGRESS_PC_PAGE_HEIGHT)
                      (and (not (progress-scrolling?)) (>= index *progress-scroll-start*) (< index *progress-scroll-end*))
                      (and (progress-scrolling-down?) (>= index (1- *progress-scroll-start*)) (< index *progress-scroll-end*))
                      (and (progress-scrolling-up?) (>= index *progress-scroll-start*) (< index (1+ *progress-scroll-end*))))
              ;; V3-D: a SECTION_GAP of blank vertical space ABOVE each section header (except the first
              ;; drawn row) — so a group reads as a group, not another item in a flat list.
              (when (and holo? (> option-count 0) (= (-> options index option-type) (game-option-type group-header)))
                (set! option-y (+ option-y SECTION_GAP)))
              (when option-str
                ;; draw the actual text!
                (let ((f0-23 (-> obj transition-percentage-invert))
                      (scroll-amt (-> *progress-scroll* transition)))
                  (cond
                    ((or (and (progress-scrolling-up?) (= index *progress-scroll-start*))
                         (and (progress-scrolling-down?) (= index (1- *progress-scroll-end*)))))
                    ((or (and (progress-scrolling-down?) (= index (1- *progress-scroll-start*)))
                         (and (progress-scrolling-up?) (= index *progress-scroll-end*)))
                     (set! scroll-amt (- 1.0 scroll-amt)))
                    (else (set! scroll-amt 1.0)))
                  (set-color! font
                              (cond
                                ;; Grecharged-menu-overhaul MECHANISM 1: group-header rows draw in a
                                ;; distinct heading color and are never shown selected/locked.
                                ((= (-> options index option-type) (game-option-type group-header))
                                 (font-color progress-blue))
                                ((and (!= index (-> obj option-index)) (or locked? (= locked-str option-str)))
                                 ;; for "locked" options!
                                 (font-color menu-invalid))
                                ((and (= index (-> obj option-index)) (not (or (progress-scrolling?) (-> obj in-transition))))
                                 (font-color progress-selected))
                                ;; V4 (owner: font not integrated with holo): normal holo rows are tinted
                                ;; CYAN so the text reads as PART of the holo projection (Jak2-style),
                                ;; not a plain white overlay dropped on top of it.
                                (else (if holo? (font-color cyan) (font-color default)))))
                  ;; V4 (owner: text not centered): center every holo row on HOLO_TEXT_CX (132 = frame
                  ;; center). The `middle` flag centers text within [origin.x, origin.x + width]; headers
                  ;; use the full HOLO_TEXT_W, option rows a symmetric SECTION_INDENT inset (narrower
                  ;; centered band = indented UNDER the header) — so BOTH end up centered on 132.
                  (when holo?
                    (set-width! font (if (= (-> options index option-type) (game-option-type group-header))
                                       HOLO_TEXT_W
                                       (- HOLO_TEXT_W (* 2 SECTION_INDENT)))))
                  (set! (-> font origin x) (the float (- option-x (-> obj left-x-offset))))
                  (set! (-> font origin y) (the float (the int (* (the float option-y) (if (-> options index scale) f0-23 1.0)))))
                  ;; Grecharged-menu-overhaul V2: shrink text into the half-width holo (scl); group-header
                  ;; SECTION titles draw slightly larger so they never read like a value row.
                  (let ((header? (= (-> options index option-type) (game-option-type group-header))))
                    (set-scale! font (* arg2 scl (if header? 1.15 1.0) f0-23 scroll-amt))
                    (print-game-text option-str font #f (the int (* 128.0 f0-23 scroll-amt)) 22)
                    ;; V2 MECHANISM 3 (sections, not items): draw a cyan rule under each SECTION header so it
                    ;; is unmistakably a heading, not a selectable entry.
                    (when (and holo? header?)
                      (let ((uy (+ (the int (* (the float option-y) (if (-> options index scale) f0-23 1.0))) 7)))
                        (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id sprite))
                          (draw-sprite2d-xy buf HOLO_TEXT_X uy HOLO_TEXT_W 1
                                            (new 'static 'rgba :r #x4c :g #xb4 :b #xff :a #x80))))))
                  ;; Gtouch-menus: record this drawn row's on-screen rect for tap hit-testing.
                  (menu-touch-record! index
                                      (the float (- option-x (-> obj left-x-offset)))
                                      (the float (the int (* (the float option-y) (if (-> options index scale) f0-23 1.0))))
                                      (* arg2 scl f0-23 scroll-amt))))
              ;; V3-D: headers consume an extra SECTION_GAP so the following options sit grouped below them.
              (+! y-off (if (and holo? (= (-> options index option-type) (game-option-type group-header)))
                          (+ arg1 SECTION_GAP)
                          arg1))
              (+! option-count 1))))
        ;; Grecharged-menu-overhaul V2 (off-screen-hint FIX + 100% coverage): one-line contextual HINT for
        ;; the FOCUSED row. The hint text-id is RESOLVED for every selectable row (explicit hint, else a
        ;; fallback by name/type — menu-resolve-hint), so 100% of rows show help. On holo screens the Y is
        ;; HOLO_HINT_Y, DERIVED from the frame bottom (inside 208, on-screen < 224) — no more magic origin-y
        ;; that grew with the row count and ran off the bottom. Non-holo screens keep the old formula but
        ;; clamped to stay on-screen.
        (let ((foc (-> obj option-index)))
          (when (and (>= foc 0) (< foc (length options)))
            (let ((h (menu-resolve-hint (-> options foc))))
              (when (nonzero? h)
                (let ((hint-y (if holo?
                                ;; V4 CLAMP (owner: hints escape the hologram): pin the hint Y so a 2-line
                                ;; hint stays fully INSIDE the frame bottom (HOLO_Y + HOLO_H = 208) — it can
                                ;; NEVER spill below the holo border.
                                (min HOLO_HINT_Y (- (+ HOLO_Y HOLO_H) 8))
                                (min 214 (+ arg0
                                            (/ (* arg1 (if (> (length options) PROGRESS_PC_PAGE_HEIGHT)
                                                         (+ PROGRESS_PC_PAGE_HEIGHT -1)
                                                         (length options))) 2)
                                            14)))))
                  ;; V4: inside the holo, the hint is CLAMPED to HOLO_HINT_W and centered on HOLO_TEXT_CX so
                  ;; it stays clear of the left/right border, and tinted cyan (part of the projection).
                  (when holo? (set-width! font HOLO_HINT_W))
                  (set-color! font (if holo? (font-color cyan) (font-color default)))
                  (set-origin! font
                               (if holo?
                                 (- (- HOLO_TEXT_CX (/ HOLO_HINT_W 2)) (-> obj left-x-offset))
                                 (- opt-x0 (-> obj left-x-offset)))
                               hint-y)
                  (set-scale! font (* 0.5 scl (-> obj transition-percentage-invert)))
                  (print-game-text (lookup-text! *common-text* h #f)
                                   font #f
                                   (the int (* 128.0 (-> obj transition-percentage-invert)))
                                   22))))))
        ;; Gtouch-fix: the 4 memcard file-slot rows are drawn by the (locked)
        ;; engine draw-memcard-file-select with its own fixed layout, NOT by the
        ;; text loop above (they are nameless button rows, option-str = #f), so
        ;; they were never published and save/load slots were tap-dead. Publish
        ;; them here with the measured slot-box geometry (device eae4df44: slot k
        ;; text center at normalized y = 0.1838 + 0.1831*k -> oy = 38.45 + 38.3*k
        ;; through the shared cy = MENU_TOUCH_Y_A*oy transform).
        (case (-> obj display-state)
          (((progress-screen load-game) (progress-screen save-game) (progress-screen save-game-title))
           (dotimes (slot 4)
             (menu-touch-record! slot 17.0 (+ 38.45 (* 38.3 (the float slot))) 1.0)))))))
  0
  (none))

(defun draw-memcard-speedrun-options ((obj progress) (arg0 font-context))
  (set-scale! arg0 0.85)
  (set-flags! arg0 (font-flags shadow kerning middle middle-vert large))
  (set-origin! arg0 (- 20 (-> obj left-x-offset)) 30)
  (set-width! arg0 360)
  (set-color! arg0 (font-color progress-blue))
  (set-height! arg0 20)
  (print-game-text-scaled (lookup-text! *common-text* (text-id speedrun-options-heading) #f)
                          (-> obj transition-percentage-invert)
                          arg0
                          128)
  (set-scale! arg0 0.6)
  (set-flags! arg0 (font-flags shadow kerning middle middle-vert large))
  (set-origin! arg0 (- 20 (-> obj left-x-offset)) 60)
  (set-width! arg0 360)
  (set-height! arg0 20)
  (set-color! arg0 (font-color progress-yellow))
  (print-game-text-scaled (lookup-text! *common-text* (text-id speedrun-options-warning) #f)
                          (-> obj transition-percentage-invert)
                          arg0
                          128)
  0)

(defun draw-memcard-auto-save-disabled ((obj progress) (arg0 font-context))
  (set-scale! arg0 0.6)
  (set-flags! arg0 (font-flags shadow kerning middle middle-vert large))
  (set-origin! arg0 (- 20 (-> obj left-x-offset)) 38)
  (set-width! arg0 360)
  (set-height! arg0 20)
  (print-game-text-scaled (lookup-text! *common-text* (text-id autosave-disabled-title) #f)
                          (-> obj transition-percentage-invert)
                          arg0
                          128)
  (set! (-> arg0 origin y) 72.0)
  (set-width! arg0 360)
  (set-height! arg0 60)
  (print-game-text-scaled (lookup-text! *common-text* (text-id autosave-disabled-msg) #f)
                          (-> obj transition-percentage-invert)
                          arg0
                          128)
  (set-scale! arg0 0.65)
  (set! (-> arg0 origin y) 120.0)
  (set-height! arg0 60)
  (print-game-text-scaled (lookup-text! *common-text* (text-id continue?) #f)
                          (-> obj transition-percentage-invert)
                          arg0
                          128)
  0)

(defun draw-memcard-disable-auto-save ((obj progress) (arg0 font-context))
  (set-origin! arg0 (- 50 (-> obj left-x-offset)) 70)
  (set-scale! arg0 0.6)
  (set-width! arg0 300)
  (set-height! arg0 40)
  (set-flags! arg0 (font-flags shadow kerning middle middle-vert large))
  (print-game-text-scaled (lookup-text! *common-text* (text-id disable-auto-save-query) #f)
                          (-> obj transition-percentage-invert)
                          arg0
                          128)
  0)

(defmethod draw-notice-screen ((obj progress))
  (hide-progress-icons)
  (when *common-text*
    (let ((a1-1 (new 'stack
                     'font-context
                     *font-default-matrix*
                     (- 70 (-> obj left-x-offset))
                     10
                     0.0
                     (font-color default)
                     (font-flags shadow kerning))))
      (case (-> obj display-state)
        (((progress-screen memcard-format)) (draw-memcard-format obj a1-1))
        (((progress-screen memcard-no-space) (progress-screen memcard-not-inserted) (progress-screen memcard-not-formatted))
         (draw-memcard-storage-error obj a1-1))
        (((progress-screen memcard-data-exists)) (draw-memcard-data-exists obj a1-1))
        (((progress-screen memcard-no-data)) (draw-memcard-no-data obj a1-1))
        (((progress-screen memcard-loading)
          (progress-screen memcard-saving)
          (progress-screen memcard-formatting)
          (progress-screen memcard-creating))
         (draw-memcard-accessing obj a1-1))
        (((progress-screen memcard-insert)) (draw-memcard-insert obj a1-1))
        (((progress-screen load-game) (progress-screen save-game) (progress-screen save-game-title))
         (draw-memcard-file-select obj a1-1))
        (((progress-screen memcard-auto-save-error)) (draw-memcard-auto-save-error obj a1-1))
        (((progress-screen memcard-removed)) (draw-memcard-removed obj a1-1))
        (((progress-screen memcard-error-loading)
          (progress-screen memcard-error-saving)
          (progress-screen memcard-error-formatting)
          (progress-screen memcard-error-creating))
         (draw-memcard-error obj a1-1))
        (((progress-screen auto-save)) (draw-auto-save obj a1-1))
        (((progress-screen pal-change-to-60hz)) (draw-pal-change-to-60hz obj a1-1))
        (((progress-screen pal-now-60hz)) (draw-pal-now-60hz obj a1-1))
        (((progress-screen no-disc)) (draw-no-disc obj a1-1))
        (((progress-screen bad-disc)) (draw-bad-disc obj a1-1))
        (((progress-screen quit) (progress-screen quit-title)) (draw-quit obj a1-1))
        (((progress-screen memcard-disable-auto-save)) (draw-memcard-disable-auto-save obj a1-1))
        (((progress-screen memcard-auto-save-disabled)) (draw-memcard-auto-save-disabled obj a1-1))
        (((progress-screen speedrun-options)) (draw-memcard-speedrun-options obj a1-1)))))
  0
  (none))

;; override the post handler for progress-normal
(set! (-> progress-normal post)
      (lambda :behavior progress ()
        (when (progress-scrolling?)
          (seek! (-> *progress-scroll* transition)
                 1.0
                 (* (/ 1.75 512) (-> self transition-speed) (-> *display* time-adjust-ratio))))
        (when (!= (-> self display-state) (-> *progress-scroll* last-screen))
          (progress-scroll-reset)
          (set! (-> *progress-scroll* last-screen) (-> self display-state)))
        ;; Grecharged-menu-overhaul V2: on the navigable options/menu screens, DROP the porthole panels +
        ;; orange tint backdrop (progress particles 0=tint, 1=left porthole, 2=right porthole — moved off
        ;; the emitter position exactly like hide-progress-icons does) and replace them with the bluish
        ;; hologram frame that CONTAINS the menu, PROJECTED by the orbiting comm-ship drone. Stat pages and
        ;; notice/memcard screens keep the original backdrop (else branch restores the emitter positions).
        (let ((holo? (progress-holo-screen? (-> self display-state))))
          (cond
            (holo?
             (set! (-> self particles 0 init-pos x) -320.0)   ;; orange tint   -> off
             (set! (-> self particles 1 init-pos x) -320.0)   ;; left porthole -> off
             (set! (-> self particles 2 init-pos x) -320.0)   ;; right porthole -> off
             (draw-menu-holo-frame!)
             (menu-projector-set-active! #t)
             ;; V4: ensure the REAL 3D speaker-mesh drone exists — spawn ONCE as a child of the progress
             ;; process (self here IS that process), exactly like the menu's fuel-cell/money icon meshes,
             ;; then reuse it every frame. Held by handle so a dead process is caught and respawned; a
             ;; failed spawn (pp = #f) is tolerated (the beam still draws in update-and-draw-menu-projector!).
             (when (not (handle->process *menu-drone-handle*))
               (let ((pp (manipy-spawn (new 'static 'vector :w 1.0) #f *voicebox-sg* #f
                                       :to self :stack *scratch-memory-top*)))
                 (when pp
                   (let ((mp (ppointer->process pp)))
                     (set! (-> (the-as process-drawable mp) draw dma-add-func) dma-add-process-drawable-hud)
                     (logior! (-> mp mask) (process-mask pause))
                     (logclear! (-> mp mask) (process-mask menu progress))
                     (set! *menu-drone-handle* (process->handle mp))))))
             (update-and-draw-menu-projector!))
            (else
             (set! (-> self particles 0 init-pos x) 256.0)    ;; restore the original backdrop off holo
             (set! (-> self particles 1 init-pos x) -42.0)
             (set! (-> self particles 2 init-pos x) 610.0)
             (menu-projector-set-active! #f)
             ;; V4: park the real drone mesh (scale 0 = invisible) on non-holo screens so it never shows on
             ;; the stat/notice pages; update-and-draw-menu-projector! restores its scale on holo frames.
             (let ((p (handle->process *menu-drone-handle*)))
               (when (and p (nonzero? (the-as int p)) (type-type? (-> p type) manipy))
                 (set-vector! (-> (the-as process-drawable p) root scale) 0.0 0.0 0.0 1.0))))))
        ;; draw the menus!!
        (let* ((a1-0 (-> self display-level-index))
               (gp-0 (-> *level-task-data* a1-0))
               (unk #t)
               (stats? #f))
          (case (-> self display-state)
            (((progress-screen fuel-cell)) (set! stats? #t) (draw-fuel-cell-screen self a1-0))
            (((progress-screen money)) (set! stats? #t) (draw-money-screen self a1-0))
            (((progress-screen buzzer)) (set! stats? #t) (draw-buzzer-screen self a1-0))
            (((progress-screen settings-title)
              (progress-screen title)
              (progress-screen sound-settings)
              (progress-screen game-ps2-options)
              (progress-screen resolution)
              (progress-screen aspect-ratio)
              (progress-screen secrets)
              (progress-screen cheats)
              (progress-screen monitor))
             (hide-progress-icons)
             (draw-options self 115 25 0.82))
            (((progress-screen settings) (progress-screen settings-title)) (hide-progress-icons) (draw-options self 115 25 0.78))
            (((progress-screen misc-options)) (hide-progress-icons) (draw-options self 115 25 0.79))
            (((progress-screen music-player)) (hide-progress-icons) (draw-options self 128 21 0.82))
            (((progress-screen flava-player)) (hide-progress-icons) (draw-options self 128 21 0.82))
            (((progress-screen speedrun-options)) (hide-progress-icons) (draw-notice-screen self) (draw-options self 155 25 0.65))
            (((progress-screen camera-options)
              (progress-screen checkpoint-select)
              (progress-screen speedrun-il-options)
              (progress-screen speedrun-cat-ext-options))
             ;; camera options lines are a bit too big
             (hide-progress-icons)
             (draw-options self 115 25 0.65))
            (((progress-screen input-options)
              (progress-screen select-controller)
              (progress-screen controller-binds)
              (progress-screen keyboard-binds)
              (progress-screen mouse-binds)
              (progress-screen controller-options)
              (progress-screen mouse-options)
              (progress-screen reassign-binds-options))
             (hide-progress-icons)
             (draw-options self 115 25 0.65))
            (((progress-screen gfx-ps2-options)) (hide-progress-icons) (draw-options self 115 25 0.67))
            ;; Grecharged-menu-overhaul RECADRAGE: the unified GRAPHISMES page (graphic-settings) draws with
            ;; the compact 0.70 layout — it now holds the longer recharged rows and its ~42 rows scroll (the
            ;; page-height/scroll machinery keys off length). The old recharged/grass pages keep the same
            ;; layout (still routable, though no hub row reaches them now).
            (((progress-screen graphic-settings)
              (progress-screen recharged-settings)
              (progress-screen grass-settings)
              (progress-screen debug-options))
             (hide-progress-icons) (draw-options self 115 25 0.70))
            (((progress-screen game-settings)) (hide-progress-icons) (draw-options self 115 25 0.70))
            (((progress-screen memcard-removed) (progress-screen memcard-auto-save-error))
             (draw-notice-screen self)
             (draw-options self 192 0 0.82))
            (((progress-screen memcard-no-data) (progress-screen memcard-auto-save-disabled))
             (draw-notice-screen self)
             (draw-options self 165 0 0.82))
            (((progress-screen memcard-format)) (draw-notice-screen self) (draw-options self 172 0 0.82))
            (((progress-screen memcard-no-space) (progress-screen memcard-not-inserted) (progress-screen memcard-not-formatted))
             (draw-notice-screen self)
             (draw-options self 195 0 0.82))
            (((progress-screen memcard-error-loading)
              (progress-screen memcard-error-saving)
              (progress-screen memcard-error-formatting)
              (progress-screen memcard-error-creating)
              (progress-screen memcard-auto-save-error)
              (progress-screen auto-save)
              (progress-screen load-game)
              (progress-screen save-game))
             (draw-notice-screen self)
             (draw-options self 190 0 0.82))
            (((progress-screen no-disc) (progress-screen bad-disc))
             (draw-notice-screen self)
             (if (is-cd-in?) (draw-options self 170 0 0.82)))
            (((progress-screen memcard-disable-auto-save))
             (draw-notice-screen self)
             (draw-options self 110 0 0.82))
            ;; Grecharged-menu-overhaul: quit / quit-title are multi-row button menus now, so they need a
            ;; real line step (was 0 = single yes/no row). draw-notice-screen still draws the "QUIT?"
            ;; prompt above via draw-quit.
            (((progress-screen quit) (progress-screen quit-title))
             (draw-notice-screen self)
             (draw-options self 140 28 0.78))
            (((progress-screen memcard-insert)) (draw-notice-screen self) (draw-options self 165 0 0.82))
            (((progress-screen memcard-data-exists)) (draw-notice-screen self) (draw-options self 168 0 0.82))
            (((progress-screen memcard-loading)
              (progress-screen memcard-saving)
              (progress-screen memcard-formatting)
              (progress-screen memcard-creating))
             (draw-notice-screen self))
            (((progress-screen save-game-title)) (draw-notice-screen self) (draw-options self 169 15 0.6))
            (else (format 0 "PROGRESS - You forgot to add a `progress-screen` case to draw options!")))
          (when stats?
            (let* ((v1-98 (cond
                            ((-> self stat-transition) 0)
                            ((= (-> self level-transition) 1) (- (-> self transition-offset)))
                            (else (-> self transition-offset))))
                   (f30-0 (the-as float (if (-> self stat-transition) 1.0 (-> self transition-percentage-invert))))
                   (s5-1 (new 'stack
                              'font-context
                              *font-default-matrix*
                              (- 32 (-> self left-x-offset))
                              (the int (* (+ 42.0 (the float (/ v1-98 2))) f30-0))
                              8325000.0
                              (font-color progress-blue)
                              (font-flags shadow kerning))))
              (set-width! s5-1 328)
              (set-height! s5-1 45)
              (set! (-> s5-1 flags) (font-flags shadow kerning middle middle-vert large))
              (print-game-text-scaled (lookup-text! *common-text* (-> gp-0 level-name-id) #f) f30-0 s5-1 (the int (* 128.0 f30-0))))))
        (case (-> self display-state)
          (((progress-screen fuel-cell) (progress-screen money) (progress-screen buzzer)) (draw-progress self)))
        (adjust-sprites self)
        (adjust-icons self)
        (none)))

;; override the enter handler for progress-going-out
(set! (-> progress-going-out enter)
      (lambda :behavior progress ()
        (sound-play "menu-close")
        (hide-progress-icons)
        ;; Grecharged-menu-overhaul V2: despawn the comm-ship projector overlay on menu close (counter).
        (menu-projector-set-active! #f)
        (remove-setting! 'music)
        (apply-settings *setting-control*)
        (progress-reset-music-parms)
        (commit-to-file *pc-settings*)
        (set! (-> self particles 3 init-pos x) -320.0)
        (set! (-> self particles 4 init-pos x) -320.0)
        (set! (-> self particles 32 init-pos x) -320.0)
        (set! (-> self particles 33 init-pos x) -320.0)
        (case (-> self display-state)
          (((progress-screen load-game) (progress-screen save-game) (progress-screen save-game-title))
           (set! (-> self transition-speed) 30.0)))
        (none)))

;; these need to be overridden as well
(set! (-> progress-going-out post) (-> progress-normal post))

(set! (-> progress-coming-in post) (-> progress-normal post))

;; override this as well...
(set! (-> progress-normal code)
      (lambda :behavior progress ()
        (loop
          (when (and (cpad-hold? 0 l1) (cpad-hold? 0 r1) *cheat-mode*)
            (when (and (< (-> self task-index) (-> *level-task-data* (-> self display-level-index) nb-of-tasks))
                       (>= (-> self task-index) 0))
              (let ((gp-0 (-> *level-task-data* (-> self display-level-index) task-info (-> self task-index) task-id)))
                (close-specific-task! gp-0 (task-status need-resolution))
                (send-event *target* 'get-pickup (pickup-type fuel-cell) (the float gp-0)))))
          (if (and (= (-> self display-state) (-> self next-display-state))
                   (= (-> self display-level-index) (-> self next-level-index)))
            (seekl! (-> self transition-offset)
                    0
                    (* (the int (* (-> self transition-speed) (-> *display* time-adjust-ratio)))
                       (if (or (-> self stat-transition) (nonzero? (-> self level-transition))) 2 1)))
            (seekl! (-> self transition-offset)
                    512
                    (* (the int (* (-> self transition-speed) (-> *display* time-adjust-ratio)))
                       (if (or (-> self stat-transition) (nonzero? (-> self level-transition))) 2 1))))
          (set-transition-progress! self (-> self transition-offset))
          (set! (-> self in-transition) (or (-> self force-transition) (nonzero? (-> self transition-offset))))
          (when (and (not (handle->process (-> *game-info* auto-save-proc)))
                     (or (-> self force-transition) (-> self in-transition))
                     (>= (-> self transition-offset)
                         (if (and (zero? (-> self level-transition))
                                  (nonzero? (-> self next-display-state))
                                  (!= (-> self next-display-state) 1)
                                  (!= (-> self next-display-state) 2))
                           512
                           256)))
            (if (>= (the-as int (-> self next-display-state)) 0) (enter! self (-> self next-display-state) 0) (pop! self))
            (set! (-> self display-level-index) (-> self next-level-index))
            (when (nonzero? (-> self level-transition))
              (set! (-> self task-index) (get-next-task-up -1 (-> self display-level-index)))
              (case (-> self level-transition)
                ((1) (set! (-> self level-transition) 2))
                ((2) (set! (-> self level-transition) 1))))
            (set! (-> self force-transition) #f))
          (when (zero? (-> self transition-offset))
            (set! (-> self stat-transition) #f)
            (set! (-> self level-transition) 0)
            0)
          (let ((gp-1 #f))
            (let ((v1-62 #f))
              (case (-> self display-state)
                (((progress-screen fuel-cell) (progress-screen money) (progress-screen buzzer))
                 (let ((s5-0 (-> self display-level-index)))
                   (when (and (< (mod (-> *display* real-frame-counter) (seconds 0.2)) (seconds 0.1))
                              (zero? (-> *progress-process* 0 in-out-position))
                              (not (-> self in-transition))
                              (zero? (-> self transition-offset)))
                     (set! gp-1 (!= s5-0 (get-next-level-up s5-0)))
                     (set! v1-62 (!= s5-0 (get-next-level-down s5-0)))))))
              (set! (-> self particles 3 init-pos x) (the float (if v1-62 (- 195 (-> *progress-process* 0 left-x-offset)) -320))))
            (set! (-> self particles 4 init-pos x) (the float (if gp-1 (- 195 (-> *progress-process* 0 left-x-offset)) -320))))
          (respond-common self)
          (set! (-> self next-display-state) (set-memcard-screen self (-> self next-display-state)))
          (let ((v1-74 (-> self display-state)))
            (cond
              ((or (= v1-74 (progress-screen fuel-cell)) (or (= v1-74 (progress-screen money)) (= v1-74 (progress-screen buzzer))))
               (respond-progress self))
              ((or (= v1-74 (progress-screen memcard-no-space))
                   (= v1-74 (progress-screen memcard-format))
                   (= v1-74 (progress-screen memcard-data-exists))
                   (= v1-74 (progress-screen memcard-insert))
                   (= v1-74 (progress-screen load-game))
                   (= v1-74 (progress-screen save-game))
                   (= v1-74 (progress-screen save-game-title))
                   (= v1-74 (progress-screen memcard-error-loading))
                   (= v1-74 (progress-screen memcard-error-saving))
                   (= v1-74 (progress-screen memcard-error-formatting))
                   (= v1-74 (progress-screen memcard-error-creating))
                   (= v1-74 (progress-screen memcard-auto-save-error))
                   (= v1-74 (progress-screen memcard-removed))
                   (= v1-74 (progress-screen memcard-no-data))
                   (= v1-74 (progress-screen memcard-not-inserted))
                   (= v1-74 (progress-screen memcard-not-formatted))
                   (= v1-74 (progress-screen auto-save))
                   (= v1-74 (progress-screen pal-change-to-60hz))
                   (= v1-74 (progress-screen pal-now-60hz))
                   (= v1-74 (progress-screen no-disc))
                   (= v1-74 (progress-screen bad-disc))
                   ;; Grecharged-menu-overhaul: quit / quit-title are now button menus handled entirely
                   ;; in respond-common (button case); they no longer go through respond-memcard's yes/no.
                   (= v1-74 (progress-screen memcard-auto-save-disabled))
                   (= v1-74 (progress-screen memcard-disable-auto-save)))
               (respond-memcard self))))
          (suspend))
        (none)))

) ;; end #when FLAG_MENU_OVERHAUL

(#unless FLAG_MENU_OVERHAUL


#| Code for the progress menu in the PC port. The original code is still loaded, this just has some overriden functions. |#

;;---------------------------
;;---------------------------
;; pc menu extra stuff

(defconstant PROGRESS_PC_PAGE_HEIGHT 7)

;; recharged-gating-real — LE SEUL JUGE DU GRIS, POUR LES TROIS LECTEURS.
;;
;; Il y avait trois endroits qui decidaient qu'une rangee est grisee (`draw-options` pour la
;; couleur, `respond-common` pour la sortie anticipee du bouton, `menu-touch-build-seq!` pour le
;; tactile), et chacun recopiait le meme test sur `option-disabled-func`. Les voici reunis.
;;
;; ET SURTOUT : une rangee qui porte un `gating-id` ne decide plus elle-meme. Elle DEMANDE au
;; C++, qui repond avec la table de `game/system/recharged_gating.cpp` — celle-la meme qui
;; applique la porte dans le moteur. C'est ce qui ferme le defaut de l'owner du 2026-09-10 : le
;; gris qu'il voit et l'extinction reelle ne peuvent plus etre deux regles differentes, puisque
;; c'est la meme colonne de la meme table qui les produit toutes les deux.
;;
;; Les rangees SANS `gating-id` (tout le reste du menu : resolution, son, camera...) gardent leur
;; lambda telle quelle : elles ne parlent pas de Recharged et ne sont pas le perimetre de l'item.
(defun option-locked? ((opt game-option))
  "#t si la rangee est grisee : inerte au confirm, dessinee en `menu-invalid`."
  (cond
    ((nonzero? (-> opt gating-id))
     (nonzero? (__pc-gating-disabled? (-> opt gating-id))))
    ((and (nonzero? (-> opt option-disabled-func))
          (!= (-> opt option-disabled-func) #f))
     (the-as symbol ((-> opt option-disabled-func))))
    (else #f)))


(defconstant PROGRESS_SCROLL_DIR_UP -1)

(defconstant PROGRESS_SCROLL_DIR_DOWN 1)

(defconstant GAME_MIN_RES_MULT 0.5)

(deftype progress-scroll (structure)
  ((transition  float)
   (start-index int16)
   (real-index  int16)
   (direction   int8)
   (last-screen progress-screen)))

(define *progress-scroll* (new 'static 'progress-scroll))

(defmacro progress-scrolling? ()
  `(< (-> *progress-scroll* transition) 1.0))

(defmacro progress-scrolling-up? ()
  `(and (progress-scrolling?) (= (-> *progress-scroll* direction) PROGRESS_SCROLL_DIR_UP)))

(defmacro progress-scrolling-down? ()
  `(and (progress-scrolling?) (= (-> *progress-scroll* direction) PROGRESS_SCROLL_DIR_DOWN)))

(defconstant *progress-scroll-start* (-> *progress-scroll* start-index))

(defconstant *progress-scroll-end* (+ -1 PROGRESS_PC_PAGE_HEIGHT (-> *progress-scroll* start-index)))

(defmacro progress-scroll-reset ()
  "resets scroll. nothing will be scrolling, as if it had finished."
  `(begin
    (set! (-> *progress-scroll* transition) 1.0)
    (set! (-> *progress-scroll* direction) 0)
    (set! (-> *progress-scroll* start-index) 0)))

(defmacro progress-scroll-up! ()
  `(begin
    (set! (-> *progress-scroll* transition) 0.0)
    (set! (-> *progress-scroll* direction) PROGRESS_SCROLL_DIR_UP)
    (1-! (-> *progress-scroll* start-index))))

(defmacro progress-scroll-down! ()
  `(begin
    (set! (-> *progress-scroll* transition) 0.0)
    (set! (-> *progress-scroll* direction) PROGRESS_SCROLL_DIR_DOWN)
    (1+! (-> *progress-scroll* start-index))))

(defun progress-fast-save-and-start-speedrun ((category speedrun-category))
  "saves to first slot, updates last-slot-saved for cursor, then starts speedrun"
  (set! (-> *progress-state* last-slot-saved) 0)
  (auto-save-command 'save 0 0 *default-pool*)
  (start-speedrun category))

;; used in title logo
(define *quit-to-title* #f)

;; ############################
;; Gtouch-menus: TOUCH-BROWSABLE MENUS  (owner 2026-07-02)
;; ############################
;; On Android the menus must be fully navigable by TAP (no d-pad needed): a tap
;; on a menu row focuses + activates it (enter a submenu / toggle / cycle a
;; carousel); a tap outside the list goes back. Purely ADDITIVE — the d-pad +
;; gamepad path is untouched, and the ENGINE menu source is untouched (all logic
;; lives here in pc/).
;;
;; Data flow: the android overlay (TouchOverlayView) forwards a NORMALIZED [0..1]
;; tap to C (NativeGk.onMenuTap); pc-get-touch-tap hands GOAL the tap + a "fresh"
;; flag. draw-options republishes each visible row's normalized on-screen rect
;; every frame (it already computes each row's font origin), and respond-common
;; hit-tests the tap to a row, then reproduces the EXACT d-pad interaction for
;; that row's type via a short synthetic-press sequence — so all existing
;; enter/toggle/cycle/commit logic is reused verbatim.
(define-extern pc-get-touch-tap (function (pointer int64) (pointer int64) (pointer int64) none))

(defconstant MENU_TOUCH_MAX_ROWS 12)   ;; >= PROGRESS_PC_PAGE_HEIGHT (+ scroll extra)

;; synthetic-press sequence tokens
(defconstant MT_TOK_NONE       0)
(defconstant MT_TOK_CONFIRM    1)  ;; x / circle
(defconstant MT_TOK_LEFT       2)  ;; d-pad left, "pressed" edge (cycle prev)
(defconstant MT_TOK_RIGHT      3)  ;; d-pad right, "pressed" edge (cycle next)
(defconstant MT_TOK_BACK       4)  ;; square / triangle
(defconstant MT_TOK_HOLD_LEFT  5)  ;; d-pad left, "held" (slider step)
(defconstant MT_TOK_HOLD_RIGHT 6)  ;; d-pad right, "held" (slider step)
(defconstant MT_TOK_UP         7)  ;; d-pad up (Gtouch-fix: tap-scroll long lists)
(defconstant MT_TOK_DOWN       8)  ;; d-pad down (Gtouch-fix: tap-scroll long lists)

;; Virtual->screen calibration (CONFIRMED ON-DEVICE eae4df44, 2026-07-02).
;; A menu row's NORMALIZED [0..1] on-screen center maps LINEARLY from the font
;; origin the row is drawn at:
;;   cy = MENU_TOUCH_Y_A * oy + MENU_TOUCH_Y_B
;;   cx = MENU_TOUCH_X_A * (ox + 185)             ;; +185 = half of the 370-wide row box (centered text)
;; Measured: title-menu rows at oy=40..165 (step 25) land at screen fractions
;; 0.19..0.79 (step ~0.12) -> slope 0.00478, offset ~0. The font SCALE does NOT
;; affect row position (only glyph size), so there is no fscale term. Since every
;; draw-options row uses option-x=17 + a `middle` (horizontal-center) flag, cx is
;; ~0.50 for all rows: the name is left of center, the value/arrows are right of
;; center, so a tap's left/right half selects decrement/increment.
(defconstant MENU_TOUCH_Y_A 0.00478)
(defconstant MENU_TOUCH_Y_B 0.0)
(defconstant MENU_TOUCH_X_A 0.002475)

(deftype menu-touch-row (structure)
  ((abs-index int16)
   (oy        float)    ;; raw font origin y (for calibration logging)
   (cx        float)    ;; normalized screen x of row center
   (cy        float)    ;; normalized screen y of row center
   (half-h    float)))  ;; normalized half-height (row selection band)

(deftype menu-touch-state (basic)
  ((n-rows      int32)
   (screen      progress-screen)
   (rows        menu-touch-row MENU_TOUCH_MAX_ROWS :inline)
   (tap-x       int64)   ;; scratch out-params for pc-get-touch-tap
   (tap-y       int64)
   (tap-f       int64)
   (seq         uint8 8) ;; synthetic-press token queue
   (seq-len     int32)
   (seq-pos     int32)
   (seq-screen  progress-screen) ;; screen the queue was built for (Gtouch-fix: stale guard)
   (confirm?    symbol)  ;; per-frame synthetic-press flags (respond-common ORs these in)
   (back?       symbol)
   (left?       symbol)
   (right?      symbol)
   (hold-left?  symbol)
   (hold-right? symbol)
   (up?         symbol)  ;; Gtouch-fix: tap-scroll of long option lists
   (down?       symbol)))

(define *menu-touch* (new 'static 'menu-touch-state :screen (progress-screen invalid)))

(defun menu-touch-record! ((abs-index int) (ox float) (oy float) (fscale float))
  "Gtouch-menus: publish one visible menu row's NORMALIZED on-screen rect so a
   tap can be hit-tested to it. Called once per DRAWN row from draw-options."
  (let ((n (-> *menu-touch* n-rows)))
    (when (< n MENU_TOUCH_MAX_ROWS)
      (let ((row (-> *menu-touch* rows n)))
        (set! (-> row abs-index) abs-index)
        (set! (-> row oy) oy)
        (set! (-> row cx) (* MENU_TOUCH_X_A (+ ox 185.0)))
        (set! (-> row cy) (+ (* MENU_TOUCH_Y_A oy) MENU_TOUCH_Y_B))
        (set! (-> row half-h) (* MENU_TOUCH_Y_A 12.5))
        (set! (-> *menu-touch* n-rows) (+ n 1)))))
  (none))

(defun menu-touch-push-seq! ((tok int))
  "Gtouch-menus: append one token to the synthetic-press queue."
  (when (< (-> *menu-touch* seq-len) 8)
    (set! (-> *menu-touch* seq (-> *menu-touch* seq-len)) tok)
    (1+! (-> *menu-touch* seq-len)))
  (none))

(defun menu-touch-set-seq-1! ((tok int))
  "Gtouch-menus: reset the queue to a single token."
  (set! (-> *menu-touch* seq-len) 0)
  (set! (-> *menu-touch* seq-pos) 0)
  (menu-touch-push-seq! tok)
  (none))

(defun menu-touch-emit! ((tok int))
  "Gtouch-menus: raise THIS frame's synthetic-press flag for one queue token."
  (cond
    ((= tok MT_TOK_CONFIRM)    (set! (-> *menu-touch* confirm?) #t))
    ((= tok MT_TOK_LEFT)       (set! (-> *menu-touch* left?) #t))
    ((= tok MT_TOK_RIGHT)      (set! (-> *menu-touch* right?) #t))
    ((= tok MT_TOK_BACK)       (set! (-> *menu-touch* back?) #t))
    ((= tok MT_TOK_HOLD_LEFT)  (set! (-> *menu-touch* hold-left?) #t))
    ((= tok MT_TOK_HOLD_RIGHT) (set! (-> *menu-touch* hold-right?) #t))
    ((= tok MT_TOK_UP)         (set! (-> *menu-touch* up?) #t))
    ((= tok MT_TOK_DOWN)       (set! (-> *menu-touch* down?) #t)))
  (none))

(defun menu-touch-build-seq! ((obj progress) (idx int) (left? symbol))
  "Gtouch-menus/Gtouch-fix: fill the queue with the synthetic d-pad presses that
   reproduce a tap on option `idx`. `left?` = tapped left of the row center
   (step down / cycle prev / YES), else right (step up / next / NO). Reuses the
   row's real behavior by replaying the same enter/change/commit presses a d-pad
   user would make. Two-state toggles FLIP from their CURRENT value (a d-pad
   LEFT always means ON and RIGHT always means OFF, so a positional choice made
   half the taps no-ops — the owner's 'toggles not clickable')."
  (set! (-> *menu-touch* seq-len) 0)
  (set! (-> *menu-touch* seq-pos) 0)
  (let* ((options (-> *options-remap* (-> obj display-state)))
         (typ (-> options idx option-type))
         (dir (if left? MT_TOK_LEFT MT_TOK_RIGHT))
         (hdir (if left? MT_TOK_HOLD_LEFT MT_TOK_HOLD_RIGHT)))
    (cond
      ;; disabled row: a tap does nothing (mirrors the confirm early-out)
      ((option-locked? (-> options idx))
       (set! (-> *menu-touch* seq-len) 0))
      ;; menus / buttons / action rows: a single confirm enters/activates
      ((or (= typ (game-option-type menu))
           (= typ (game-option-type button))
           (= typ (game-option-type button-music))
           (= typ (game-option-type button-flava))
           (= typ (game-option-type resolution))
           (= typ (game-option-type controller))
           (= typ (game-option-type monitor))
           (= typ (game-option-type aspect-new))
           (= typ (game-option-type binding-assignment)))
       (menu-touch-push-seq! MT_TOK_CONFIRM))
      ;; yes-no dialog row: pick YES (left half) / NO (right half), then confirm
      ;; so one tap both chooses AND activates (respond-memcard consumes the
      ;; confirm; before Gtouch-fix a tap only set the choice).
      ((= typ (game-option-type yes-no))
       (menu-touch-push-seq! dir)
       (menu-touch-push-seq! MT_TOK_CONFIRM))
      ;; on-off style toggles: one tap = FLIP. In respond-common LEFT sets the
      ;; value to #t/ON and RIGHT to #f/OFF, so derive the direction from the
      ;; CURRENT value instead of the tapped half.
      ((or (= typ (game-option-type on-off))
           (= typ (game-option-type normal-inverted))
           (= typ (game-option-type aspect-native)))
       (let ((flip-dir (if (and (nonzero? (-> options idx value-to-modify))
                                (-> (the-as (pointer symbol) (-> options idx value-to-modify))))
                         MT_TOK_RIGHT   ;; currently ON  -> set OFF
                         MT_TOK_LEFT))) ;; currently OFF -> set ON
         (menu-touch-push-seq! MT_TOK_CONFIRM)
         (menu-touch-push-seq! flip-dir)
         (menu-touch-push-seq! MT_TOK_CONFIRM)))
      ;; two-state aspect-ratio (4x3 <-> 16x9): same flip idea (LEFT=4x3, RIGHT=16x9)
      ((= typ (game-option-type aspect-ratio))
       (let ((flip-dir (if (and (nonzero? (-> options idx value-to-modify))
                                (= (-> (the-as (pointer symbol) (-> options idx value-to-modify))) 'aspect4x3))
                         MT_TOK_RIGHT   ;; currently 4x3 -> 16x9
                         MT_TOK_LEFT))) ;; currently 16x9 -> 4x3
         (menu-touch-push-seq! MT_TOK_CONFIRM)
         (menu-touch-push-seq! flip-dir)
         (menu-touch-push-seq! MT_TOK_CONFIRM)))
      ;; cheat toggles read their live state from the cheats bitfield
      ((= typ (game-option-type cheat-toggle))
       (let ((flip-dir (if (logtest? (-> *pc-settings* cheats) (ash 1 (the int (-> options idx param1))))
                         MT_TOK_RIGHT
                         MT_TOK_LEFT)))
         (menu-touch-push-seq! MT_TOK_CONFIRM)
         (menu-touch-push-seq! flip-dir)
         (menu-touch-push-seq! MT_TOK_CONFIRM)))
      ;; sliders: enter edit, ONE step by tapped half, commit. Repeated taps
      ;; keep stepping (one slider-step-size per tap).
      ((= typ (game-option-type slider))
       (menu-touch-push-seq! MT_TOK_CONFIRM)
       (menu-touch-push-seq! hdir)
       (menu-touch-push-seq! MT_TOK_CONFIRM))
      ;; everything else (carousels, language, confirmation, ...): enter edit,
      ;; cycle by tapped half, commit
      (else
       (menu-touch-push-seq! MT_TOK_CONFIRM)
       (menu-touch-push-seq! dir)
       (menu-touch-push-seq! MT_TOK_CONFIRM))))
  (none))

(defun menu-touch-poll! ((obj progress))
  "Gtouch-menus: read the newest tap; if new, hit-test it (nearest row by vertical
   center within the row band) and build the synthetic-press sequence for it, or
   go back if the tap was clearly outside the row list. No-op on desktop (the
   pc-get-touch-tap stub always reports flag=0)."
  (pc-get-touch-tap (&-> *menu-touch* tap-x) (&-> *menu-touch* tap-y) (&-> *menu-touch* tap-f))
  (when (and (nonzero? (-> *menu-touch* tap-f))
             (> (-> *menu-touch* n-rows) 0)
             (= (-> *menu-touch* screen) (-> obj display-state)))
    (let ((fx (/ (the float (-> *menu-touch* tap-x)) 10000.0))
          (fy (/ (the float (-> *menu-touch* tap-y)) 10000.0))
          (best -1)
          (best-d 999999.0)
          (best-band 0.05)
          (min-cy 999999.0)
          (max-cy -999999.0))
      ;; nearest row by vertical center (+ list extent for the scroll zones)
      (dotimes (i (-> *menu-touch* n-rows))
        (let* ((row (-> *menu-touch* rows i))
               (dy (fabs (- fy (-> row cy)))))
          (when (< (-> row cy) min-cy) (set! min-cy (-> row cy)))
          (when (> (-> row cy) max-cy) (set! max-cy (-> row cy)))
          (when (< dy best-d)
            (set! best-d dy)
            (set! best i)
            (set! best-band (-> row half-h)))))
      ;; concise per-tap diagnostic (one line, only when a tap lands on a menu)
      (format 0 "Gtm-tap fx=~f fy=~f n=~D best=~D d=~f~%"
              fx fy (-> *menu-touch* n-rows) best best-d)
      (cond
        ;; Gtouch-fix: on a SCROLLABLE list (more rows than the page shows), a tap
        ;; beyond the first/last visible row (by at least half a row) scrolls
        ;; instead of going back — rows past the fold (V-Sync/MSAA/Advanced/Back
        ;; on Graphic Options) were unreachable by touch. These zones must be
        ;; checked BEFORE the row hit-test: its 3x-band acceptance reaches ~1.8
        ;; row-pitches past the last row center, which swallowed the whole
        ;; below-list zone (a tap meant to scroll flipped the LAST row instead).
        ;; Back stays available via the Back row and on every non-scrollable
        ;; screen via tap-outside.
        ((and (> (length (-> *options-remap* (-> obj display-state))) PROGRESS_PC_PAGE_HEIGHT)
              (> fy (+ max-cy (* MENU_TOUCH_Y_A 12.5))))
         (format 0 "Gtm-tap scroll-down~%")
         (menu-touch-set-seq-1! MT_TOK_DOWN))
        ((and (> (length (-> *options-remap* (-> obj display-state))) PROGRESS_PC_PAGE_HEIGHT)
              (< fy (- min-cy (* MENU_TOUCH_Y_A 12.5))))
         (format 0 "Gtm-tap scroll-up~%")
         (menu-touch-set-seq-1! MT_TOK_UP))
        ((and (>= best 0) (< best-d (* 3.0 best-band)))
         ;; tap landed on (or near) a row -> focus it + reproduce its interaction
         (let* ((row (-> *menu-touch* rows best))
                (idx (the int (-> row abs-index)))
                (left? (< fx (-> row cx))))
           (set! (-> obj option-index) idx)
           (set! (-> obj last-option-index-change) (-> *display* real-frame-counter))
           (menu-touch-build-seq! obj idx left?)))
        (else
         ;; tapped clearly outside the row list -> go back
         (menu-touch-set-seq-1! MT_TOK_BACK)))
      ;; Gtouch-fix: remember which screen this sequence drives so a mid-sequence
      ;; screen change (submenu enter/exit) kills the leftover tokens instead of
      ;; replaying them as phantom presses on the new screen.
      (set! (-> *menu-touch* seq-screen) (-> obj display-state))
      ;; emit the first token of the freshly-built sequence THIS frame
      (when (> (-> *menu-touch* seq-len) 0)
        (menu-touch-emit! (the int (-> *menu-touch* seq 0)))
        (set! (-> *menu-touch* seq-pos) 1))))
  (none))

(defun menu-touch-drive! ((obj progress))
  "Gtouch-menus: per-frame touch driver. Clears this frame's synthetic-press
   flags, then either advances an in-flight press sequence or polls for a new
   tap. Called at the top of respond-common; its flags are ORed into the d-pad
   input guards so touch is additive."
  (set! (-> *menu-touch* confirm?) #f)
  (set! (-> *menu-touch* back?) #f)
  (set! (-> *menu-touch* left?) #f)
  (set! (-> *menu-touch* right?) #f)
  (set! (-> *menu-touch* hold-left?) #f)
  (set! (-> *menu-touch* hold-right?) #f)
  (set! (-> *menu-touch* up?) #f)
  (set! (-> *menu-touch* down?) #f)
  ;; Gtouch-fix: a screen change invalidates any in-flight sequence (its tokens
  ;; were built for the previous screen's focused row)
  (when (and (< (-> *menu-touch* seq-pos) (-> *menu-touch* seq-len))
             (!= (-> *menu-touch* seq-screen) (-> obj display-state)))
    (set! (-> *menu-touch* seq-len) 0)
    (set! (-> *menu-touch* seq-pos) 0))
  (cond
    ((< (-> *menu-touch* seq-pos) (-> *menu-touch* seq-len))
     ;; advance an in-flight synthetic sequence
     (menu-touch-emit! (the int (-> *menu-touch* seq (-> *menu-touch* seq-pos))))
     (1+! (-> *menu-touch* seq-pos)))
    (else
     ;; no sequence running -> poll for a fresh tap
     (menu-touch-poll! obj)))
  (none))

;; ############################
;; CAROUSELL STUFF
;; ############################

(deftype progress-carousell-state (structure)
  ((int-backup           int)
   (symbol-backup        symbol)
   (subtitle-backup      pc-language)
   (aspect-native-choice symbol)
   (current-carousell    (array text-id))
   (selection            int)
   (direction            symbol)
   (transition           symbol)
   (x-offset             int32)))

(define *progress-carousell* (new 'static 'progress-carousell-state))

(defmacro def-progress-carousell (name texts)
  `(define ,name (new 'static 'boxed-array :type text-id ,@(apply (lambda (x) `(text-id ,x)) texts))))

;; all carousells
(def-progress-carousell *carousell-display-mode* (windowed fullscreen borderless))

(def-progress-carousell *carousell-msaa* (off 2-times 4-times 8-times 16-times))

(def-progress-carousell *carousell-lod-bg* (lod-high lod-low))

(def-progress-carousell *carousell-lod-fg* (lod-high lod-low lod-ps2))

(def-progress-carousell *carousell-speaker* (speaker-always speaker-never speaker-auto))

;; framerate-uncap essai 2 : LA RANGEE DE CADENCE EST UNE LISTE DE CHOIX -- 30, 45, 60, 75,
;; 90, 120, 240, ILLIMITE (owner 2026-09-07). MEME ORDRE que `*frame-rate-choices*`
;; (pckernel-common.gc), qui porte les VALEURS : ici ce sont leurs libelles, et le verdict de
;; la preuve casse si les deux listes divergent (game/graphics/uncap.h, `uncap_v_choices`).
;; Les entrees sont des tags RESERVES #x17dc..#x17e3, jamais cherches dans une banque de texte
;; (meme route que HD LOOK et PHYSICS DETAIL) : une COMMON.TXT Android perimee ne peut pas les
;; transformer en « Unknown ID », et aucune des 20 langues n'est a regenerer.
;; Ce qui disparait : les deux listes `*carousell-frame-rate-100fps*` / `-150fps*` et la
;; bascule entre elles selon le rafraichissement du panneau. C'etait le « ca lock a 60 » --
;; sur un panneau 60 Hz la liste tombait a (60) et la rangee etait grisee, alors que le plafond
;; d'affichage n'a plus RIEN a voir avec le panneau depuis que la reference de temps en est
;; separee : 30 et 45 sont sous le panneau, 120 et 240 au-dessus et la presentation cesse
;; d'attendre le balayage (uncap::desired_swap_interval).
(define *carousell-frame-rate*
  (new 'static 'boxed-array :type text-id #x17dc #x17dd #x17de #x17df #x17e0 #x17e1 #x17e2 #x17e3))

;; Grecharged-ambient-occlusion: the AO mode carousell (Off/SSAO/HBAO/GTAO) and the AO quality carousell
;; (Low/Medium/High). The value strings live in game_custom_text_*.json (ids #x1708-#x170d) with matching
;; pc-text-* enum entries in text-h.gc (static arrays need compile-time text-id constants).
(def-progress-carousell *carousell-ambient-occlusion* (off pc-text-ssao pc-text-hbao pc-text-gtao))
(def-progress-carousell *carousell-ao-quality* (pc-text-ao-low pc-text-ao-medium pc-text-ao-high))
;; Grecharged-ambient-occlusion closing round: the AO strength carousell (Weaker/Default/Stronger),
;; a per-mode multiplier on the estimator intensity (ids #x1710-#x1712 + row label #x1713).
(def-progress-carousell *carousell-ao-strength* (pc-text-ao-weaker pc-text-ao-default pc-text-ao-stronger))
;; Grecharged-realtime-lighting: SHADOW QUALITY carousell (Low/Med/High = 1024/2048/4096 shadow-map res).
;; Reuses the AO low/med/high text-ids (they render LOW/MEDIUM/HIGH, which fits Shadow Quality).
;; Ggrass-density-presets (owner 2026-08-30): GRASS DENSITY carousell, five named steps. It REUSES the
;; five text-ids that the shipped shadow-quality row already draws — no new string id is allocated, so
;; the rendering of these labels is already proven in every shipped language.
(def-progress-carousell *carousell-grass-density* (pc-text-ao-very-low pc-text-ao-low pc-text-ao-medium pc-text-ao-high pc-text-ao-very-high))
;; Grecharged-directional-ambient ROUND 2: AMBIENT MODEL carousell (Hemisphere / SH / IBL).
;; Gpbr-fusion REOPEN #3: DISPLACEMENT carousell (Off / Parallax / Tessellation). Off reuses the
;; generic off text-id like *carousell-ambient-occlusion*; Parallax/Tessellation are new ids.
;; Gprecompute-deterministic-bake (owner 2026-08-26): MESH SUBDIVISION carousell (Off / Low / Mid /
;; High = 0/1/2/3 pre-subdivision ROUNDS handed to the hardware tessellator). It deliberately REUSES
;; the ENV PROBE text-ids — `off` plus pc-text-envprobe-low/mid/high already read Off/Low/Mid/High
;; and are present in every shipped COMMON.TXT — so NO new text id is allocated and no text bank is
;; touched: a stale Android COMMON.TXT cannot turn these four entries into "Unknown ID".
;; Gpbr-fusion REOPEN #3 (DEBUG, removable later): PBR TEST PRESET carousell — one-click intended-config
;; presets. On confirm the write-back arm applies the whole config (booleans + sliders + carousells).
;; Gpbr-fusion REOPEN #10 : le carrousel PBR ISOLATE est RETIRE, avec le pont C
;; `pc_set_pbr_isolate` et l'uniforme `u_pbr_bisect` : aucun des trois n'existe plus.
;; Grecharged-hd-models5: the four per-character HD LOOK carousells (JAK / DAXTER / KEIRA / SAMOS).
;; Their OPTION strings use the PBR-ISOLATE durability mechanism, NOT the COMMON.TXT text bank:
;; each entry is a RESERVED tag id (#x17b0..#x17b6 + #x17bc, past the last allocated text-h.gc id #x17ac)
;; that carousell-option-string resolves to a RUNTIME GLOBAL string (*hd-look-*-label*). That is why
;; raw ids appear here instead of (text-id sym): the static boxed-array needs a compile-time constant,
;; the ids are never looked up in a text bank, and a stale Android COMMON.TXT can never turn these
;; into "Unknown ID". English-only, exactly like the PBR ISOLATE options.
;;   #x17b0 ORIGINAL  #x17b1 HD  #x17b2 JAK II  #x17b3 JAK 3  #x17b4 PANTS  #x17b5 YOUNG
;;   #x17b6 JAK 3 MASKED (cycle-4 item 3: jakm-hd, over-nose scarf effect dropped at append)
;;   #x17bc JAK II PRISON (cycle-5 item 3: jakp-hd, jak2 ldjakbrn prison/experiments cutscene)
;;   (#x17bd was JAK 3 BAREFOOT / jakf-hd — the owner rejected that look on 2026-08-05 19:30 and it
;;    was removed completely, so #x17bd is FREE again and is the first free tag id.)
;; NOTE (owner 19:30): #x17b3 "JAK 3" and #x17b6 "JAK 3 MASKED" rendered INVERTED — the fix is a
;; swap of the ENTRY each look selects (jak-hd.gc hd-entry-for-char-look), NOT of these labels.
;; Defined UNCONDITIONALLY (not under FLAG_HD_MODELS), like the PBR ISOLATE option labels, so the
;; shared respond-common carousell arms compile in every build config; only the ROWS and their
;; wiring/labels are flag-gated.
(define *carousell-hd-look-jak* (new 'static 'boxed-array :type text-id #x17b0 #x17b1 #x17b2 #x17b3 #x17b6 #x17bc))
(define *carousell-hd-look-daxter* (new 'static 'boxed-array :type text-id #x17b0 #x17b1 #x17b4))
(define *carousell-hd-look-keira* (new 'static 'boxed-array :type text-id #x17b0 #x17b1 #x17b3))
(define *carousell-hd-look-samos* (new 'static 'boxed-array :type text-id #x17b0 #x17b1 #x17b5))
;; Grecharged-secondary-motion: PHYSICS DETAIL carousell (LIGHT / FULL / MAXIMUM). Uses the same
;; stale-text-bank-proof mechanism as the PBR ISOLATE / HD LOOK options, NOT the COMMON.TXT bank:
;; each entry is a RESERVED tag id (#x17b9..#x17bb, past the last allocated id #x17b6) that
;; carousell-option-string resolves to a RUNTIME GLOBAL string (*physics-light-label* etc.). The ids
;; are never looked up in a text bank, so a stale Android COMMON.TXT can never turn these into
;; "Unknown ID". English-only, exactly like the PBR ISOLATE options.
;;   #x17b9 LIGHT  #x17ba FULL  #x17bb MAXIMUM
;; Defined UNCONDITIONALLY (not under FLAG_PHYSICS), like the HD LOOK carousells, so the shared
;; respond-common carousell arms compile in every build config; only the ROWS and their
;; wiring/labels are flag-gated.
(define *carousell-physics-quality* (new 'static 'boxed-array :type text-id #x17b9 #x17ba #x17bb))

;; pad remap stuff
(define *progress-pad-timeout* (the-as time-frame 0)) ;; timeout for remap buttons

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  MENU OPTIONS
