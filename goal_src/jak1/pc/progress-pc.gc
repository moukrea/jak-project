;; Gdynamic-renderscale: forward declaration so the menu :on-change lambdas below can
;; call the helper, which is defined later in this file.
(define-extern apply-dynamic-rs-menu-mode! (function none))

(define *main-options-pc*
  (new 'static
       'boxed-array
       :type
       game-option
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id game-options)
            :scale #t
            :param3 (game-option-menu game-settings))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id graphic-options)
            :scale #t
            :param3 (game-option-menu graphic-settings))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id sound-options)
            :scale #t
            :param3 (game-option-menu sound-settings))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id load-game)
            :scale #t
            :param3 (game-option-menu load-game))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id save-game)
            :scale #t
            :param3 (game-option-menu save-game))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id disable-auto-save)
            :scale #t
            :param3 (game-option-menu memcard-disable-auto-save))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id quit-game)
            :scale #t
            :param3 (game-option-menu quit))
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t)))

(define *main-options-secrets*
  (new 'static
       'boxed-array
       :type
       game-option
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id game-options)
            :scale #t
            :param3 (game-option-menu game-settings))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id graphic-options)
            :scale #t
            :param3 (game-option-menu graphic-settings))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id sound-options)
            :scale #t
            :param3 (game-option-menu sound-settings))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id load-game)
            :scale #t
            :param3 (game-option-menu load-game))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id save-game)
            :scale #t
            :param3 (game-option-menu save-game))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id disable-auto-save)
            :scale #t
            :param3 (game-option-menu memcard-disable-auto-save))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id secrets)
            :scale #t
            :param3 (game-option-menu secrets))
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id quit-game)
            :scale #t
            :param3 (game-option-menu quit))
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t)))

(define *game-options-pc*
  (new 'static
       'boxed-array
       :type
       game-option
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id input-options)
            :scale #t
            :param3 (game-option-menu input-options))
       (new 'static
            'game-option
            :option-type (game-option-type on-off)
            :name (text-id play-hints)
            :scale #t
            :on-confirm
            (lambda ()
              (set! (-> *setting-control* default play-hints) (-> *pc-settings* memcard-play-hints?))))
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id subtitles) :scale #t)
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id hinttitles) :scale #t)
       (new 'static 'game-option :option-type (game-option-type language) :name (text-id language) :scale #t)
       (new 'static 'game-option :option-type (game-option-type language-subtitles) :name (text-id subtitles-language) :scale #t)
       (new 'static 'game-option :option-type (game-option-type language-text) :name (text-id text-language) :scale #t)
       (new 'static 'game-option :option-type (game-option-type speaker) :name (text-id subtitles-speaker) :scale #t)
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id misc-options)
            :scale #t
            :param3 (game-option-menu misc-options))
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t)))

;; Goptions-reorder (owner 2026-07-01): fixed desktop order —
;;   0 Aspect Ratio, 1 Game Resolution, 2 Dynamic Render Scale, 3 Render Scale/Min Render Scale,
;;   4 Min Target FPS (HIDDEN at runtime when Dynamic OFF), 5 FPS Counter, 6 V-Sync, 7 MSAA,
;;   8 Display mode, 9 Display, 10 Frame rate (desktop-only rows kept, grouped before Advanced),
;;   11 Advanced settings (renamed "PS2 Options" via name-override), 12 Back.
;; Row 4 (Min Target FPS) and row 3 (Render Scale) are position-locked: apply-dynamic-rs-menu-mode!
;; relabels/re-points row 3 and shows/hides row 4 by mutating the live `length` (see helper below).
;; Grecharged-buildsys-flags: build-time row exclusion. A (flag-row FLAG <row>) entry is
;; spliced into the static array ONLY when FLAG (a defglobalconstant from the generated
;; pc/recharged-flags.gc) is #t at compile time — off rows are truly absent from the CGO
;; (bare #when cannot drop elements inside a static boxed-array literal; the macro filters
;; at GOOS expansion time, before the static compiler counts elements).
(defmacro define-options-array (name elt-type &rest entries)
  `(define ,name
     (new 'static 'boxed-array :type ,elt-type
          ,@(apply (lambda (e) (if (eq? (car e) 'flag-row) (third e) e))
                   (filter (lambda (e) (if (eq? (car e) 'flag-row) (eval (second e)) #t))
                           entries)))))
;; full (Min-Target-FPS visible) lengths of the two graphics arrays; vulkan row is flagged.
;; hdr-display-output essai 3 : la rangee HDR OUTPUT a QUITTE ces tableaux (refus owner 09/09 :
;; elle vit sous RECHARGED SETTINGS, apres le bloc RECHARGED LIGHTING) ; longueurs d'avant l'item.
(#if FLAG_VULKAN_SUPPORT
  (defglobalconstant GFX_OPTIONS_PC_FULL_LEN 15)
  (defglobalconstant GFX_OPTIONS_PC_FULL_LEN 14))
(#if FLAG_VULKAN_SUPPORT
  (defglobalconstant GFX_OPTIONS_ANDROID_FULL_LEN 13)
  (defglobalconstant GFX_OPTIONS_ANDROID_FULL_LEN 12))
(define-options-array *graphic-options-pc*
       game-option
       ;; 0 Aspect Ratio
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id aspect-ratio)
            :scale #t
            :param3 (game-option-menu aspect-ratio))
       ;; 1 Game Resolution
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id game-resolution)
            :scale #t
            :param3 (game-option-menu resolution))
       ;; 2 DYNAMIC RENDER SCALE toggle. on-change writes the flag then re-points/relabels the
       ;; RENDER-SCALE slider row and shows/hides the Min Target FPS row.
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* dynamic-render-scale?) (the-as symbol val))
              (apply-dynamic-rs-menu-mode!)
              (none)))
       ;; 3 RENDER SCALE slider: edits render-scale (manual, OFF) OR min-render-scale (auto-scaler
       ;; FLOOR, ON). value-to-modify + label set by apply-dynamic-rs-menu-mode!. 10..100 step 10.
       (new 'static
            'game-option
            :option-type (game-option-type slider)
            :name (text-id vsync)
            :scale #t
            :param1 10.0
            :param2 100.0
            :slider-step-size 10.0
            :slider-show-decimal? #f)
       ;; 4 MINIMUM TARGET FRAMERATE slider: 25..60 step 5 -> *pc-settings* dyn-target-fps. label via
       ;; name-override. HIDDEN when Dynamic Render Scale is OFF (removed from the live list, not greyed).
       (new 'static
            'game-option
            :option-type (game-option-type slider)
            :name (text-id vsync)
            :scale #t
            :param1 25.0
            :param2 60.0
            :slider-step-size 5.0
            :slider-show-decimal? #f)
       ;; 5 FPS-counter overlay toggle. on-off; bound to *pc-settings* fps-counter? in init-game-options.
       ;; label provided at runtime via name-override (no engine text-id added).
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t)
       ;; 6 V-Sync
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t)
       ;; 7 MSAA
       (new 'static 'game-option :option-type (game-option-type msaa) :name (text-id msaa) :scale #t)
       ;; 8 Display mode (desktop only)
       (new 'static 'game-option :option-type (game-option-type display-mode) :name (text-id display-mode) :scale #t)
       ;; 9 Display / monitor (desktop only)
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id display)
            :scale #t
            :param3 (game-option-menu monitor)
            :option-disabled-func
            (lambda ()
              (= (pc-get-display-mode) 'windowed)))
       ;; 10 Frame rate -- MAX FRAME RATE (framerate-uncap essai 2). La clause
       ;; `(<= (pc-get-active-display-refresh-rate) 60)` est RETIREE : elle grisait la rangee sur
       ;; tout panneau 60 Hz, ce qui est litteralement le « ca lock a 60 max » de l'owner. Le
       ;; plafond d'affichage ne depend plus du panneau -- 30 et 45 sont EN DESSOUS, 120 et 240
       ;; au-dessus avec la presentation qui cesse d'attendre le balayage. Seul le mode
       ;; speedrun garde la rangee grisee (il impose 60).
       (new 'static
            'game-option
            :option-type (game-option-type frame-rate)
            :name (text-id frame-rate)
            :scale #t
            :option-disabled-func
            (lambda ()
              (-> *pc-settings* speedrunner-mode?)))
       ;; 11 RECHARGED SETTINGS submenu (Grecharged-hud-jak1). Inserted BEFORE Advanced per the phase
       ;; spec; shifts Advanced->12, Vulkan->13, Back->14 (see the reindexed init-game-options wiring +
       ;; the bumped MTF full-len 15 / graphic-options-set-mtf-visible! calls). label via name-override.
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id ps2-options)
            :scale #t
            :param3 (game-option-menu recharged-settings))
       ;; 12 Advanced settings (was "PS2 Options"; relabelled via name-override in init-game-options,
       ;; submenu unchanged).
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id ps2-options)
            :scale #t
            :param3 (game-option-menu gfx-ps2-options))
       ;; 13 VULKAN RENDERER toggle (Gvulkan-option). OFF = OpenGL (default), ON = Vulkan. label via
       ;; name-override; value-to-modify = gfx-renderer-vulkan? (bound in init-game-options). on-change
       ;; maps the toggle to *pc-settings* gfx-renderer, persists it, and tells the C++ runtime, which
       ;; selects the backend at the next launch (surface recreation ⇒ restart to switch).
       ;; row present only with --vulkan-support (Back shifts to 13 otherwise).
       (flag-row FLAG_VULKAN_SUPPORT
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* gfx-renderer-vulkan?) (the-as symbol val))
              (set! (-> *pc-settings* gfx-renderer)
                    (if val (pc-gfx-renderer vulkan) (pc-gfx-renderer opengl)))
              (pc-set-gfx-renderer! (-> *pc-settings* gfx-renderer))
              (commit-to-file *pc-settings*)
              (none))))
       ;; 14 Back
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t))

;; Android-only graphics options. Same owner order as *graphic-options-pc* but with the menu
;; items that don't make sense on a single-display phone HIDDEN (truly omitted, since the progress
;; menu renderer has no per-item hide flag — only disable):
;;   - "Display mode" (windowed/fullscreen/borderless: Android is always fullscreen)
;;   - "Display" (monitor select: Android has exactly one display)
;;   - "Frame rate (experimental)" : REMPLACEE par la rangee MAX FRAME RATE (index 8, framerate-uncap),
;;     qui plafonne la cadence d'AFFICHAGE seule (la reference de temps du moteur reste a 60).
;; Goptions-reorder order: 0 Aspect Ratio, 1 Game Resolution, 2 Dynamic Render Scale,
;;   3 Render Scale/Min Render Scale, 4 Min Target FPS (HIDDEN when Dynamic OFF), 5 FPS Counter,
;;   6 V-Sync, 7 MSAA, 8 Max Frame Rate, 9 Recharged Settings, 10 Advanced settings (renamed
;;   "PS2 Options"), 11 Vulkan Renderer (flagged), 12 Back. Wired in init-game-options.
(define-options-array *graphic-options-pc-android*
       game-option
       ;; 0 Aspect Ratio
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id aspect-ratio)
            :scale #t
            :param3 (game-option-menu aspect-ratio))
       ;; 1 Game Resolution
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id game-resolution)
            :scale #t
            :param3 (game-option-menu resolution))
       ;; 2 DYNAMIC RENDER SCALE toggle.
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* dynamic-render-scale?) (the-as symbol val))
              (apply-dynamic-rs-menu-mode!)
              (none)))
       ;; 3 RENDER SCALE slider: render-scale (OFF) / min-render-scale (ON); wired by
       ;; apply-dynamic-rs-menu-mode!. 10..100 step 10. NO on-change.
       (new 'static
            'game-option
            :option-type (game-option-type slider)
            :name (text-id vsync)
            :scale #t
            :param1 10.0
            :param2 100.0
            :slider-step-size 10.0
            :slider-show-decimal? #f)
       ;; 4 MINIMUM TARGET FRAMERATE slider: 25..60 step 5 -> dyn-target-fps. HIDDEN when Dynamic OFF.
       (new 'static
            'game-option
            :option-type (game-option-type slider)
            :name (text-id vsync)
            :scale #t
            :param1 25.0
            :param2 60.0
            :slider-step-size 5.0
            :slider-show-decimal? #f)
       ;; 5 FPS Counter
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t)
       ;; 6 V-Sync
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t)
       ;; 7 MSAA
       (new 'static 'game-option :option-type (game-option-type msaa) :name (text-id msaa) :scale #t)
       ;; 8 MAX FRAME RATE (framerate-uncap essai 2) -- LISTE DE CHOIX, plus un curseur.
       ;; owner 2026-09-07 : « plutot qu'un slider faudrait des choix comme 30, 45, 60, 75, 90,
       ;; 120, 240, Illimite ». C'est le PLAFOND D'AFFICHAGE et lui seul : la reference de temps
       ;; du moteur reste 60, donc la logique recoit toujours 60 ticks par seconde reelle et les
       ;; images en trop sont interpolees par l'alpha de l'horloge armee.
       ;; Le type `frame-rate` est celui de la rangee desktop : la nav gauche/droite, le dessin
       ;; selectionne et le dessin non selectionne sont DEJA cables pour lui (les grandes listes
       ;; de types de `respond-common` / `draw-options`). Un type neuf aurait demande sept armes
       ;; de plus pour le meme comportement. Etiquette par name-override -- elle porte la valeur
       ;; courante (`apply-frame-rate-menu-bounds!`), parce qu'une rangee de liste NON selectionnee
       ;; n'affiche que son nom, contrairement au curseur qui affichait « : 120 ».
       (new 'static
            'game-option
            :option-type (game-option-type frame-rate)
            :name (text-id frame-rate)
            :scale #t)
       ;; 9 RECHARGED SETTINGS submenu (Grecharged-hud-jak1). Inserted BEFORE Advanced per the phase
       ;; spec; shifts Advanced->10, Vulkan->11, Back->12 (see the reindexed init-game-options wiring +
       ;; the bumped MTF full-len 13 / graphic-options-set-mtf-visible! calls). label via name-override.
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id ps2-options)
            :scale #t
            :param3 (game-option-menu recharged-settings))
       ;; 10 Advanced settings (was "PS2 Options"; relabelled via name-override, submenu unchanged).
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id ps2-options)
            :scale #t
            :param3 (game-option-menu gfx-ps2-options))
       ;; 11 VULKAN RENDERER toggle (Gvulkan-option). OFF = OpenGL/GLES (default), ON = Vulkan. label via
       ;; name-override; value-to-modify = gfx-renderer-vulkan? (bound in init-game-options). on-change
       ;; maps the toggle to *pc-settings* gfx-renderer, persists it, and tells the C++ runtime (which
       ;; applies the new backend on the next launch). NOTE: on Android the Vulkan runtime is deferred —
       ;; the toggle persists the preference but the build keeps rendering with GLES for now.
       ;; row present only with --vulkan-support (Back shifts to 11 otherwise).
       (flag-row FLAG_VULKAN_SUPPORT
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* gfx-renderer-vulkan?) (the-as symbol val))
              (set! (-> *pc-settings* gfx-renderer)
                    (if val (pc-gfx-renderer vulkan) (pc-gfx-renderer opengl)))
              (pc-set-gfx-renderer! (-> *pc-settings* gfx-renderer))
              (commit-to-file *pc-settings*)
              (none))))
       ;; 12 Back
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t))

;; Grecharged-hud-jak1: the "Recharged Settings" submenu (reached from Graphics Options, row before
;; Advanced). One row for now: a "RECHARGED HUD" on-off toggle (label via name-override, value bound
;; to *pc-settings* recharged-hud? in init-game-options), then Back. The on-change persists the flag
;; immediately so the choice survives a relaunch even without a full menu commit.
(define-options-array *recharged-options-pc*
       game-option
       ;; 0 RECHARGED MASTER (Grecharged-master-toggle, owner 2026-07-21): the GLOBAL Recharged
       ;; ON/OFF. OFF forces the stock state of EVERY recharged feature at runtime (C++ composes
       ;; via the single Gfx::recharged_active helper; GOAL-side HUD gates AND with it) WITHOUT
       ;; resetting the individual toggles below — they grey out (option-disabled-func) and come
       ;; back exactly as configured when the master returns ON. Real label via
       ;; *recharged-master-label* (name-override; :name is the usual placeholder text-id => no
       ;; unknown-ID risk). All later rows shift +1 (see the init-game-options index arithmetic).
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-master?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none)))
       ;; 0 RECHARGED HUD toggle. :name is a placeholder (text-id vsync) like the other name-override
       ;; on-off rows; the real label comes from *recharged-hud-label*. row present only with --recharged-hud.
       (flag-row FLAG_RECHARGED_HUD
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            ;; Grecharged-master-toggle: greyed while the master is OFF (like the realtime-lighting block rows)
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?)))
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-hud?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none))))
       ;; 1 GRASS SETTINGS sub-submenu launcher (Grecharged-grass-poc POLISH#6). All grass settings
       ;; (toggle + near-dist + card-dist + density) moved into their OWN nested page (*grass-options-pc*)
       ;; so they reliably appear on device — owner: "les réglages n'apparaissent toujours pas ... ça
       ;; devrait être un sous-menu de ce sous-menu avec tous les settings pour l'herbe". A menu-type row:
       ;; :param3 opens the grass-settings screen; real label via *grass-settings-label* (name-override).
       ;; recharged-gating-real essai 2 : le lanceur pose la MEME question a la MEME table que les
       ;; rangees qu'il ouvre (« un ANCETRE est-il eteint ? »), au lieu de recopier la regle a la
       ;; main sur `recharged-master?` — une regle recopiee finit par diverger de celle qui agit.
       (new 'static 'game-option :option-type (game-option-type menu) :name (text-id ps2-options) :scale #t
            :option-disabled-func
            (lambda ()
              (nonzero? (__pc-gating-disabled? "grass")))
            :param3 (game-option-menu grass-settings))
       ;; 2 LOAD CUSTOM ASSETS on-off toggle (Gload-custom-assets). Real label via *load-custom-assets-label*
       ;; (name-override); value bound to *pc-settings* load-custom-assets? in init-game-options. The
       ;; on-change pushes the 0/1 flag to the runtime and persists it immediately.
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* load-custom-assets?) (the-as symbol val))
              (pc-set-load-custom-assets! (if val 1 0))
              (commit-to-file *pc-settings*)
              (none)))
       ;; 2c RECHARGED TEXTURES (Grecharged-bundled-textures) on-off toggle: the package-BUNDLED
       ;; first-party replacement textures (owner's Recharged set). ON => bundled base swaps;
       ;; OFF => stock (the user custom_assets dir keeps its own LOAD CUSTOM ASSETS gate and
       ;; always WINS over the bundle; the bundle's _height/_normal/_roughness PBR maps follow
       ;; the PBR toggle, not this row). Real label via *recharged-textures-label*
       ;; (name-override); value bound in init-game-options. on-change pushes 0/1 + persists;
       ;; applies on the next level load. All later indices shift +1 (see init-game-options).
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-textures?) (the-as symbol val))
              (pc-set-recharged-textures! (if val 1 0))
              (commit-to-file *pc-settings*)
              (none)))
       ;; lighting-legacy-purge (2026-09-11) : PBR MATERIALS RETIREE — rattachee au chemin unique :
       ;; le rendu PBR est desormais INCONDITIONNEL sous RECHARGED LIGHTING.
       ;; 3 ENHANCED MODELS (Grecharged-hd-models) on-off toggle. Loads jak2 detailed character models
       ;; (Jak/Daxter/Samos/Keira, jak1-look) in place of the stock low-poly meshes. Real label via
       ;; *enhanced-models-label*; value bound to *pc-settings* recharged-enhanced-models? in
       ;; init-game-options, where the row is HIDDEN unless the build ships the enhanced FR3 set
       ;; (pc-enhanced-models-available?). on-change persists + pushes to the loader (relaunch to apply
       ;; to Jak/Daxter — they live in the always-loaded common FR3; village NPCs apply on level reload).
       ;; row present only with --hd-models.
       (flag-row FLAG_HD_MODELS
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-enhanced-models?) (the-as symbol val))
              (pc-set-recharged-enhanced-models! (if val 1 0))
              (commit-to-file *pc-settings*)
              (none))))
       ;; 3b-3e Grecharged-hd-models5: the four per-character HD LOOK carousells, immediately after the
       ;; ENHANCED MODELS toggle they refine. Same FLAG_HD_MODELS gate as that row (5 HD rows total when
       ;; --hd-models is on, 0 otherwise) and they collapse with it when the enhanced FR3 set is absent
       ;; at runtime. Meme motif de carrousel : :name is a placeholder, the real label comes
       ;; from a name-override runtime global, there is no :on-change (respond-common backs up / writes
       ;; back the value), and the row is greyed unless its feature toggle is on — here ENHANCED MODELS,
       ;; exactly as DISPLACEMENT is greyed unless PBR MATERIALS is on.
       ;; JAK LOOK: ORIGINAL / HD / JAK II / JAK 3
       (flag-row FLAG_HD_MODELS
       (new 'static 'game-option :option-type (game-option-type hd-look-jak) :name (text-id msaa) :scale #t
            :option-disabled-func
            (lambda ()
              (or (not (-> *pc-settings* recharged-master?)) (not (-> *pc-settings* recharged-enhanced-models?))))))
       ;; DAXTER LOOK: ORIGINAL / HD / PANTS
       (flag-row FLAG_HD_MODELS
       (new 'static 'game-option :option-type (game-option-type hd-look-daxter) :name (text-id msaa) :scale #t
            :option-disabled-func
            (lambda ()
              (or (not (-> *pc-settings* recharged-master?)) (not (-> *pc-settings* recharged-enhanced-models?))))))
       ;; KEIRA LOOK: ORIGINAL / HD / JAK 3
       (flag-row FLAG_HD_MODELS
       (new 'static 'game-option :option-type (game-option-type hd-look-keira) :name (text-id msaa) :scale #t
            :option-disabled-func
            (lambda ()
              (or (not (-> *pc-settings* recharged-master?)) (not (-> *pc-settings* recharged-enhanced-models?))))))
       ;; SAMOS LOOK: ORIGINAL / HD / YOUNG
       (flag-row FLAG_HD_MODELS
       (new 'static 'game-option :option-type (game-option-type hd-look-samos) :name (text-id msaa) :scale #t
            :option-disabled-func
            (lambda ()
              (or (not (-> *pc-settings* recharged-master?)) (not (-> *pc-settings* recharged-enhanced-models?))))))
       ;; 4 FOLIAGE WIND (Grecharged-foliage-wind) on-off toggle. Light wind sway on jak1 palms (TIE)
       ;; + shrubs so the foliage reacts to a light breeze. Top-level Recharged row (owner: "un toggle
       ;; supplémentaire dans les Recharged Settings"), NOT in the grass page — it isn't a grass
       ;; setting, and the grass page already sits at PROGRESS_PC_PAGE_HEIGHT (7 rows). Real label via
       ;; *foliage-wind-label*; value bound to *pc-settings* recharged-foliage-wind? in
       ;; init-game-options. OFF (default) = stock render. on-change persists + pushes live (the
       ;; per-frame update-to-os bridge also pushes it, so the effect applies without relaunch).
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-foliage-wind?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none)))
       ;; 5 AMBIENT OCCLUSION (Grecharged-ambient-occlusion) carousell row: Off/SSAO/HBAO/GTAO. Multi-value
       ;; carousell like MSAA — :name is a placeholder (text-id msaa); the real label comes from
       ;; *ambient-occlusion-label* (name-override, wired in init-game-options). backup/select/write-back
       ;; mirror the msaa arms in respond-common (map 1:1 to *pc-settings* ambient-occlusion).
       (new 'static 'game-option :option-type (game-option-type ambient-occlusion) :name (text-id msaa) :scale #t)
       ;; 6 AO QUALITY carousell row: Low/Medium/High. Disabled (greyed) while AO is Off, mirroring the
       ;; display-mode disabled predicate. Real label via *ao-quality-label* (name-override).
       (new 'static
            'game-option
            :option-type (game-option-type ao-quality)
            :name (text-id msaa)
            :scale #t)
       ;; 7 AO STRENGTH carousell row (closing round): Weaker/Default/Stronger per-mode multiplier on the
       ;; estimator intensity. Disabled (greyed) while AO is Off, same conditional mechanism as AO QUALITY.
       ;; Real label via *ao-strength-label* (name-override).
       (new 'static
            'game-option
            :option-type (game-option-type ao-strength)
            :name (text-id msaa)
            :scale #t)
       ;; Glighting-hdr / SPEC-refonte-lumiere 6.2 : RECHARGED LIGHTING On/Off, REMPLACE SUR PLACE
       ;; l'ancienne rangee REALTIME LIGHTING. Meme position, meme index : aucun bras fw-idx ne
       ;; bouge (la renumerotation est la classe de bug Gmenu-flag-off, cf. la garde [RCH-MENU]).
       ;; POURQUOI le remplacement : « Realtime Lighting » ne voulait pas dire « notre eclairage »
       ;; mais « prendre le composite A/B plutot que C/E ». L'owner l'a eteint le 2026-09-06 et le
       ;; HDR a continue de tourner. `recharged-lighting?` est LE maitre de la refonte lumiere :
       ;; OFF = l'eclairage d'origine, ON = notre refonte, et le reste du Recharged (modeles HD,
       ;; herbe, textures, HUD) n'est PAS touche — c'est ce qui le distingue du master du projet.
       ;; lighting-legacy-purge (2026-09-11) : le champ legacy `realtime-lighting?` est SUPPRIME de
       ;; pc-settings. Sa CLE `settings.ini` garde une clause de lecture qui la CONSOMME sans rien
       ;; stocker (pckernel.gc) : sans elle, tout le reste du fichier repartirait au defaut.
       ;; `pc-set-rt-light!` suit desormais le maitre unique `recharged-lighting?`.
       ;; lighting-legacy-purge (2026-09-11) : MARQUEUR STATIQUE. `rch-hdr-row-parent` reperait le
       ;; parent de HDR OUTPUT par l'`option-type` de SHADOW QUALITY, unique et present DANS LE
       ;; TABLEAU STATIQUE. Cette rangee est retiree, et le seul appel de `rch-hdr-row-parent` qui
       ;; compte pour la preuve — `(pc-hdr-output-note! 2 ...)` en forme de niveau 0 — tourne AU
       ;; CHARGEMENT DU FICHIER, avant `init-game-options`. Un repere pose au cablage
       ;; (`name-override`) rendrait donc 0 a cet instant : verdict 7 de hdr-display-output casse
       ;; par un acquis voisin. `:hint` est ecrit ICI, dans le tableau statique, et lu par personne
       ;; d'autre dans le corps livre (`pc-text-hint-rtlight` #x1761 : zero autre occurrence dans
       ;; ce fichier — c'est le hint de l'ancienne rangee REALTIME LIGHTING, que celle-ci a
       ;; remplacee en place). Meme contrat que HDR OUTPUT, PHYSICS et EAU RECHARGEE.
       (flag-row FLAG_PBR
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :hint (text-id pc-text-hint-rtlight)
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-lighting?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none))))
       ;; Gmenu-census-cleanup (2026-09-02) — ENV PROBE (carrousel Off/Low/Mid/High) est RETIREE :
       ;; elle ne changeait RIEN a l'ecran et coutait du GPU a chaque image.
       ;; La preuve tient en une ligne : `FollowProbe.cpp:224` est le SEUL ecrivain de
       ;; `u_rt_probe_on` dans tout le depot et il ecrit le litteral 0 (« The SH-volume grid is
       ;; DELETED — force its world-projection OFF »). Or les CINQ lectures de `u_rt_probe_cube`
       ;; (pbr_fused.glsl:733, tfrag3.frag:540 et :961, shrub.frag:475, etie_base.frag:475,
       ;; tie_wind.frag:474) sont TOUTES sous `u_rt_probe_on != 0`. Aucun pixel ne lit jamais la
       ;; cubemap — mais aux paliers 1 a 3, FollowProbe.cpp:250-263 la rafraichissait et
       ;; regenerait ses mipmaps A CHAQUE IMAGE. Le reglage n'etait meme pas persiste
       ;; (zero occurrence de `follow-probe` dans pckernel.gc), donc il repartait a 1 a chaque
       ;; lancement : le joueur payait le cout sans pouvoir l'eteindre durablement.
       ;; dead-follow-probe (2026-09-10) : le retrait est DESORMAIS complet. Le champ
       ;; `follow-probe` de pc-settings, le type de menu `game-option-type follow-probe`,
       ;; `pc-set-follow-probe!` et le champ C++ `recharged_follow_probe` sont SUPPRIMES : le
       ;; reglage n'avait plus ni lecteur ni rangee, seulement un ecrivain. Le recensement qui
       ;; le prouve est `dead_probe_census` (kmachine.cpp), grandeur `dead_probe_sites`.
       ;; A REFAIRE DE ZERO le jour ou une grille de sondes revient et ou `u_rt_probe_on` peut
       ;; valoir 1 ; les text-ids `pc-text-envprobe-low/-mid/-high` sont RESTES en place (ce sont
       ;; des donnees de langue : les retirer renumeroterait un banc).
       ;; lighting-legacy-purge (2026-09-11) : AMBIENT MODEL RETIREE — reglage de l'ancien monde,
       ;; remplace par les items lighting-interiors et lighting-bake de la refonte.
       ;; lighting-legacy-purge (2026-09-11) : AMBIENT STRENGTH RETIREE — reglage de l'ancien
       ;; monde, remplace par l'item lighting-bake de la refonte.
       ;; Gmenu-census-cleanup (2026-09-02) — AMBIENT CONTRAST est RETIREE : elle ne change RIEN.
       ;; La valeur voyage correctement jusqu'au shader (background_common.cpp:3114 pousse bien
       ;; `u_rt_ambient_contrast`), et c'est precisement ce qui rendait le defaut invisible : la
       ;; coupure est PLUS LOIN. Ses QUATRE seules lectures — tfrag3.frag:556, shrub.frag:491,
       ;; etie_base.frag:491, tie_wind.frag:490 — vivent toutes dans le bloc « BAKED AMBIENT
       ;; curiosity path », ouvert par `if (u_rt_probe_on != 0)` (tfrag3.frag:532 -> :691), et
       ;; `u_rt_probe_on` vaut TOUJOURS 0 (FollowProbe.cpp:224, seul ecrivain). `pbr_fused.glsl`
       ;; et `pbr_helpers.glsl`, qui portent le chemin LIVRE, ne la mentionnent pas du tout.
       ;; lighting-legacy-purge (2026-09-11) : la cle `realtime-ambient-contrast` n'est plus ECRITE ;
       ;; elle garde une clause de lecture qui la CONSOMME, pour les settings.ini deja livres.
       ;; lighting-legacy-purge (2026-09-11) : SHADOW DISTANCE et SHADOW QUALITY RETIREES —
       ;; reglages de l'ancien monde, remplaces par l'item lighting-shadows de la refonte.
       ;; hdr-display-output (essai 3) : HDR OUTPUT — la sortie HDR vers l'ECRAN, sous-option de
       ;; RECHARGED LIGHTING (refus owner 09/09 : elle vivait dans Graphics, hors des reglages
       ;; Recharged dont elle depend). Derniere rangee du bloc eclairage, grisee comme lui. Ne
       ;; s'affiche que si l'ecran annonce un mode (pc-get-hdr-output-modes > 0) — sinon RETIREE du
       ;; tableau vivant (rch-hdr-row-hide-once!), jamais seulement grisee. Se retrouve par son
       ;; marqueur `hint` (pc-text-hint-hdr-output, affiche par rien), pas par un index ; le bloc
       ;; lighting-legacy-purge (2026-09-11) : le bloc PBR ne compte plus que DEUX rangees,
       ;; RECHARGED LIGHTING et HDR OUTPUT — c'est le terme `(* 2 FLAG_PBR_N)` des deux gardes.
       (flag-row FLAG_PBR
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :hint (text-id pc-text-hint-hdr-output)
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* hdr-output?) (the-as symbol val))
              (pc-set-hdr-output! (if val 1 0))
              (commit-to-file *pc-settings*)
              (none))))
       ;; lighting-legacy-purge (2026-09-11) : TEXTURE RELIEF RETIREE — reglage de l'ancien monde,
       ;; remplace par l'item pbr-per-material de la refonte.
       ;; lighting-legacy-purge (2026-09-11) : SPECULAR INTENSITY RETIREE — reglage de l'ancien
       ;; monde, remplace par l'item pbr-per-material de la refonte.
       ;; lighting-legacy-purge (2026-09-11) : DISPLACEMENT RETIREE — reglage de l'ancien monde,
       ;; supprime (le chemin TESSELLATION n'a jamais ete livre).
       ;; lighting-legacy-purge (2026-09-11) : MESH SUBDIVISION RETIREE — reglage de l'ancien monde,
       ;; supprime (le chemin TESSELLATION n'a jamais ete livre).
       ;; lighting-legacy-purge (2026-09-11) : PBR TEST PRESET et PBR ISOLATE RETIREES — outils de
       ;; bisection de l'ancien monde, ils n'ont plus d'objet apres la refonte.
       ;; water-ocean-mesh (SPEC-refonte-eau 1.2 regle 1) : EAU RECHARGEE. Rangee AUTO-LOCALISEE
       ;; par son marqueur `hint`, jamais par un index : c'est le contrat des rangees HDR OUTPUT et
       ;; PHYSICS, et c'est ce qui la rend immune aux renumerotations du bloc PBR.
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :hint (text-id pc-text-hint-recharged-water)
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-water?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none)))
       ;; lighting-legacy-purge (2026-09-11) : MODERN MATERIALS RETIREE — reglage de l'ancien monde,
       ;; remplace par l'item lighting-materials de la refonte.
       ;; Grecharged-lightprobes OWNER #3 UNIFICATION (2026-07-21): the three BAKED AMBIENT rows
       ;; (on/off, reflections, quality) were FOLDED into the unified AMBIENT group above — the
       ;; probe data now FEEDS the Ambient Model fidelity tiers (Hemisphere/SH/IBL), reflections
       ;; are a resource for PBR/water only. See menu-tree.md §11 [SUPPR] history.
       ;; Grecharged-title-logo-fullres (owner 2026-07-09): CRISP TITLE LOGO on-off toggle. The
       ;; title-screen JAK AND DAXTER logo (and the ND boot logo) are 3D merc models drawn into the
       ;; render-scaled scene FBO, so a low RENDER SCALE pixelates them on weak phones. ON defers
       ;; those models out of the scaled 3D pass and replays them at NATIVE resolution in the UI
       ;; pass, exactly like the HUD 3D icons (Grender-split). OFF (default) = stock pipeline.
       ;; :name is the usual (text-id vsync) placeholder (visible label comes from
       ;; *crisp-title-logo-label* via name-override). SELF-LOCATION marker is :hint instead — the
       ;; `hint` field is written by NO other row in this array and READ by nothing in the shipping
       ;; menu (the hint line belongs to the FLAG_MENU_OVERHAUL half, which does not compile), so it
       ;; is a unique, side-effect-free key. Do NOT use a distinctive :name for this: a row's `name`
       ;; is dispatched on elsewhere (e.g. the autosave lock relabels+locks ANY row named
       ;; disable-auto-save whenever autosave is off), and hand-counted tail offsets are the
       ;; Gmenu-flag-off / physics-row bug class.
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :hint (text-id pc-text-hint-resolution)
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* crisp-title-logo?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none)))
       ;; Gfixed-tick-interpolation (owner 2026-08-26) : FIXED TIMESTEP on-off toggle. OFF (defaut)
       ;; = chemin d'origine AU BIT PRES — la logique avance de la duree REELLE de l'image, donc a
       ;; 25 images/s un saut monte 19 % trop haut et a 120 il monte MOITIE moins. ON = la logique
       ;; avance par pas de 1/60 s exactement (le pas de la PS2), les pas que le temps reel reclame
       ;; en plus sont joues comme des tours de logique separes, et le rendu interpole entre deux
       ;; ticks. C'est exactement le defaut que l'owner decrit : « les sauts, les mouvements de
       ;; camera ca chie un peu dans la colle... sauts trop courts ».
       ;;
       ;; POURQUOI OFF PAR DEFAUT : le superviseur a desarme ce chantier le 2026-08-30 parce qu'un
       ;; build le portant ARME est parti chez l'owner avant que sa porte de sortie soit passee.
       ;; Cette ligne existe pour qu'il puisse l'armer LUI-MEME, sans adb et sans nouveau build —
       ;; c'est ce qui rend le chantier testable par son oeil, qui est la porte finale.
       ;; Gmenu-census-cleanup (2026-09-02) — PRECISION, parce que « desarme » se lit mal :
       ;; « desarme » veut dire DEFAUT A OFF (pckernel-impl.gc `(set! fixed-tick? #f)`), PAS un
       ;; consommateur neutralise. La chaine est VIVANTE de bout en bout : pc-set-fixed-tick! ->
       ;; kmachine `pc_set_fixed_tick` -> `fixed_tick.cpp set_enabled`/`enabled()` ->
       ;; `begin_render_frame` -> `fixed_tick_publish`, lu par drawable.gc (`time-ratio`),
       ;; main.gc (tours de logique de rattrapage), cam-update.gc et process-drawable-h.gc.
       ;; Cocher la case FAIT quelque chose. Le recensement a verifie ce point precisement parce
       ;; que le commentaire donnait le contraire a lire.
       ;; RESERVE CONNUE : si la propriete Android `debug.opengoal.fixed_tick` (ou la variable
       ;; d'environnement OG_FIXED_TICK) est posee, elle GAGNE en silence sur le choix du joueur
       ;; (fixed_tick.cpp:146-148) — et notre outillage pose souvent des `debug.opengoal.*`.
       ;;
       ;; Meme patron que CRISP TITLE LOGO juste au-dessus : :name est le placeholder habituel
       ;; (le libelle vient de *fixed-tick-label* par name-override) et l'AUTO-LOCALISATION se fait
       ;; sur :hint, un champ qu'aucune autre ligne de ce tableau n'ecrit et que rien ne lit dans le
       ;; menu livre. Ne PAS se localiser sur :name : le `name` d'une ligne est dispatche ailleurs,
       ;; et un decalage compte a la main est la classe de bug Gmenu-flag-off.
       ;; POSEE ICI, entre CRISP TITLE LOGO et le bloc PHYSICS, et pas ENTRE les deux lignes
       ;; PHYSICS : le cablage auto-localise [PHYS-MENU] d'`init-game-options` sort en FATAL si la ligne
       ;; immediatement AVANT PHYSICS DETAIL n'est pas une on-off (c'est ainsi qu'il retrouve le
       ;; toggle PHYSICS sans arithmetique). S'inserer la casserait l'audit.
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :hint (text-id pc-text-hint-framerate)
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?)))
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* fixed-tick?) (the-as symbol val))
              (pc-set-fixed-tick! (if val 1 0))
              (commit-to-file *pc-settings*)
              (none)))
       ;; Grecharged-secondary-motion: PHYSICS on-off toggle. Secondary-motion (chain) physics —
       ;; hair / cloth / straps swing with the animation instead of staying rigid. Real label via
       ;; *physics-label*; value bound to *pc-settings* physics? in init-game-options. Default ON
       ;; (the feature is opt-in at BUILD time, so a build that ships it wants it on). NOT tied to
       ;; the ENHANCED MODELS toggle — physics will also drive stock NPCs, so the only disable
       ;; predicate is the recharged master, exactly like FOLIAGE WIND. on-change persists + pushes
       ;; to the C++ solver (the per-frame update-to-os bridge pushes it too, so it applies live).
       ;; APPENDED AT THE TAIL, immediately before Back, so no existing row index
       ;; moves (the index-shift bug class fixed in Gmenu-flag-off; see init-game-options).
       ;; row present only with --physics.
       ;; Gmenu-census-cleanup (2026-09-02) : cette rangee porte desormais son PROPRE marqueur
       ;; d'auto-localisation, `:hint (text-id pc-text-hint-physics)`. Elle se faisait retrouver
       ;; par la rangee PHYSICS DETAIL placee juste apres (« la on-off qui precede le carrousel
       ;; physics-quality ») ; PHYSICS DETAIL vient d'etre retiree, il fallait donc un ancrage a
       ;; elle. Meme contrat que CRISP TITLE LOGO et FIXED TIMESTEP : `hint` n'est ecrit par
       ;; aucune autre rangee de ce tableau et n'est lu par rien dans le menu livre, donc toute
       ;; insertion future laisse le cablage juste et un rate echoue BRUYAMMENT.
       (flag-row FLAG_PHYSICS
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :hint (text-id pc-text-hint-physics)
            :option-disabled-func
            (lambda ()
              (not (-> *pc-settings* recharged-master?)))
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* physics?) (the-as symbol val))
              (pc-set-physics! (if val 1 0) (-> *pc-settings* physics-quality))
              (commit-to-file *pc-settings*)
              (none))))
       ;; Gmenu-census-cleanup (2026-09-02) — PHYSICS DETAIL (LIGHT / FULL / MAXIMUM) est RETIREE :
       ;; les TROIS niveaux produisent le MEME solveur, au bit pres, et ca se demontre par algebre
       ;; sur les valeurs livrees plutot que par une course.
       ;;   - Sur les 5 cles du bloc `[levels]` de recharged_assets/physics_chains.txt, QUATRE
       ;;     (`substeps`, `iters`, `collide`, `classmask`) n'ont AUCUN lecteur : elles sont rangees
       ;;     dans `s_phys_levels` (kmachine.cpp:1632-1640) et le seul lecteur de ce tableau est
       ;;     `pc_physics_level_param_mi`, dont les deux seuls appelants GOAL du depot
       ;;     (jak-hd-physics.gc:2516 et :2519) ne demandent que le parametre 4.
       ;;   - La 5e (`fixedhz`) est bien lue, mais son effet est NUL : elle ne sert que de PLANCHER
       ;;     de sous-pas, `nsf = 1 / 1 / 4` pour les niveaux 0/1/2 (fixedhz = 0 / 0 / 240), puis
       ;;     `ns = max(nsf, pset[24])` (jak-hd-physics.gc:2872). Les deux chaines livrees ont un
       ;;     maillon libre donc `axo = 1`, et `pset[24]` = `HardImpactSubstepsHi` = 4
       ;;     (physics_chains.txt:144 et :247). Donc ns = 4 AUX TROIS NIVEAUX.
       ;;   - Et meme si `fixedhz` mordait, LIGHT et FULL resteraient identiques entre eux : les
       ;;     deux declarent `fixedhz=0`.
       ;; Trois libelles, un seul comportement : c'est exactement « une option carrement inutilisee »
       ;; que l'owner denonce. La cle `physics-quality` RESTE dans settings.ini et reste poussee par
       ;; `pc-set-physics!`, donc la salle de mesure garde son levier ; seule la rangee part.
       ;; A REMETTRE le jour ou `substeps`/`iters`/`collide`/`classmask` auront un lecteur.
       ;; Grecharged-managed-assets: HD TEXTURE PACK on-off toggle — the DOWNLOADED
       ;; pack (managed_assets/<game>/, installed by the asset manager or
       ;; `gk --assets install`). ON => the compressed KTX2 pack replaces the baked
       ;; textures; OFF => bundled/stock instantly and with NO re-download, so it is a
       ;; real A/B switch. The user custom_assets dir still WINS over the pack (owner's
       ;; precedence rule), and WHICH preset to fetch is an install-time decision that
       ;; belongs to the downloader, not to a render toggle. Real label via
       ;; *managed-assets-label* (name-override); value bound in init-game-options from
       ;; mesh-browser-removal : la rangee de debug qui suivait celle-ci est SUPPRIMEE, donc
       ;; cette rangee est desormais l'avant-derniere (juste avant Back) ; aucun index anterieur
       ;; ne bouge, seules les constantes de longueur totale perdent 1.
       ;; the array LENGTH, and the row sits last-but-one (just before Back) so
       ;; no existing index shifts — only the total-length constants gain +1, exactly as
       ;; the tail PHYSICS rows did before it.
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* managed-assets?) (the-as symbol val))
              (pc-set-managed-assets! (if val 1 0))
              (commit-to-file *pc-settings*)
              (none)))
       ;; Back
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t))

;; Grecharged-grass-poc POLISH#6: the dedicated NESTED "Grass Settings" page, reached from the Recharged
;; Settings submenu. Holds ALL grass settings on their own page (owner wanted a sub-submenu so they show
;; reliably): the RECHARGED GRASS on-off toggle, the near-blade + card view-distance sliders, the
;; DENSITY PRESET carousell, the GRASS OVERHANG toggle, then Back (6 rows, under
;; PROGRESS_PC_PAGE_HEIGHT (7) so all show — the scroll machinery only engages when length > 7).
;; Ggrass-density-presets : la rangee GRASS MODE (PRECOMPUTED/LIVE) est RETIREE — le placement en
;; direct etait le chemin de 1 207 Mo sur lequel les plantages ont ete reproduits ; il ne se propose
;; plus. La cle `recharged-grass-precomputed?` reste dans settings.ini comme interrupteur de mesure.
;; Values/labels are wired at runtime in init-game-options; on-change persists to *pc-settings*.
(define-options-array *grass-options-pc*
       game-option
       ;; 0 RECHARGED GRASS toggle (real label via *recharged-grass-label*).
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-grass?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none)))
       ;; 1 NEAR GRASS DISTANCE slider (near-blade view distance, m).
       (new 'static 'game-option :option-type (game-option-type slider) :name (text-id vsync) :scale #t
            :param1 15.0 :param2 45.0 :slider-step-size 5.0 :slider-show-decimal? #f
            :on-change
            (lambda ((val object))
              (commit-to-file *pc-settings*)
              (none)))
       ;; 2 GRASS CARD DISTANCE slider (grass-card view distance, m; pushed further out).
       (new 'static 'game-option :option-type (game-option-type slider) :name (text-id vsync) :scale #t
            :param1 50.0 :param2 140.0 :slider-step-size 10.0 :slider-show-decimal? #f
            :on-change
            (lambda ((val object))
              (commit-to-file *pc-settings*)
              (none)))
       ;; 3 GRASS DENSITY — cinq paliers nommes (Ggrass-density-presets, owner 2026-08-30 : « on
       ;; s'en fiche de changer la densite au poil de cul, on veut juste plus ou moins dense »).
       ;; Chaque palier a SON bake livre, donc la densite demandee est TOUJOURS celle du bake charge :
       ;; il n'existe plus de valeur intermediaire capable de faire basculer le placement EN DIRECT.
       ;; Pas de :on-change — les rangees carrousel ecrivent dans la branche de retour partagee.
       (new 'static 'game-option :option-type (game-option-type grass-density) :name (text-id vsync) :scale #t)
       ;; 4 GRASS OVERHANG: 3D drooping grass over platform edges (near); far keeps the stock alpha texture
       ;; row present only with --grass-overhang.
       (flag-row FLAG_GRASS_OVERHANG
       (new 'static 'game-option :option-type (game-option-type on-off) :name (text-id vsync) :scale #t
            :on-change
            (lambda ((val object))
              (set! (-> *pc-settings* recharged-grass-overhang?) (the-as symbol val))
              (commit-to-file *pc-settings*)
              (none))))
       ;; 5 Back
       (new 'static 'game-option :option-type (game-option-type button) :name (text-id back) :scale #t))

;; label shown for the FPS-counter toggle (no engine text-id was added; rendered
;; via the game-option name-override path which progress-pc.gc honors for on-off rows)
;; NOTE: all-uppercase — the jak1 menu font maps uppercase ASCII to the correct
;; glyphs. La suite de cette note etait FAUSSE depuis la phase Gfont-urbanist : elle
;; disait que les minuscules ASCII sortaient en charabia. Mesure du 2026-09-05 sur
;; `goal_src/jak1/engine/gfx/font.gc` : les avances de `*font24-table*` pour 0x61-0x7a
;; valent 14,57 / 15,08 / 12,40 ... et 5,89 pour `i` et `l` — des chasses de MINUSCULES
;; Urbanist, ecrites par `recharged_assets/font/patch_font_tables.py` dans la source suivie.
;; La GRANDE police du menu (draw-options pose `font-flags ... large`) ecrit donc de vraies
;; minuscules, et tout le menu stock est deja livre en casse mixte (`0COMMON.TXT` #x0128 =
;; « Graphic Options »). C'est cette note perimee qui a fige les 40 libelles Recharged en
;; TOUT-MAJUSCULES — le defaut que l'owner nomme le 2026-09-04.
;; Glang-mixed: these labels are runtime BUFFERS (not static literals) so they can be
;; re-formatted from the text bank and follow the TEXT language (ids #x1700-#x1705 in
;; game_custom_text_*.json; languages without them fall back to English via the
;; fallback bank). English defaults formatted here cover boot-before-text-load.
(define *fps-counter-label* (new 'global 'string 128 (the-as string #f)))
(format (clear *fps-counter-label*) "FPS COUNTER")

