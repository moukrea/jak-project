;;-*-Lisp-*-
(in-package goal)
(require "pc/pckernel-h.gc")

#| This file has the game-specific implementation of the pckernel (see pckernel-h.gc and pckernel.gc). |#

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; constants
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; version: 1.11.0.0
(defconstant PC_KERNEL_VERSION (static-pckernel-version 1 11 0 0))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; types and enums
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; pc enum for languages. this is the game's languages + custom ones.
(defenum pc-language
  :type uint16
  (english 0)
  (french 1)
  (german 2)
  (spanish 3)
  (italian 4)
  (japanese 5)
  (uk-english 6)
  ;; custom
  (portuguese 7)
  (finnish 8)
  (swedish 9)
  (danish 10)
  (norwegian 11)
  (dutch 12)
  (br-portuguese 13)
  (hungarian 14)
  (catalan 15)
  (icelandic 16)
  (korean 17)
  (russian 18)
  (polish 19)
  (lithuanian 20)
  (czech 21)
  (croatian 22)
  (galician 23)
  (bosnian 24)
  (custom 999) ;; temp
  )

;; concept arts
(defenum pc-jak1-concept-art
  :bitfield #t
  :type uint64
  (test))

;; secrets and goodies
(deftype pc-game-secrets (structure)
  ((art               pc-jak1-concept-art) ;; concept art unlocked
   (music             pc-music-log-entry PC_MUSIC_LOG_LENGTH :inline)
   (hard-fish-hiscore int32)
   (hard-rats?        symbol) ;; enable this crap
   (hard-rats-hiscore int32)
   (hard-rats-hiwave  int32)
   (hero-mode?        symbol) ;; unsure how this should work
   (hud-map?          symbol) ;; enable map in HUD/progress?
   (hud-counters?     symbol) ;; enable level orb counter/global buzzer counter?
   (hud-watch?        symbol) ;; a watch that tells the time of day!
   (watch-12hr?       symbol) ;; 12-hour clock toggle
   )
  :pack-me)

;; The Jak 1 version of the pc-settings object.
(deftype pc-settings-jak1 (pc-settings)
  ((cheats              pc-cheats)
   (cheats-known        pc-cheats)
   (skip-movies?        symbol) ;; if on, enable cutscene skipping
   (subtitles?          symbol) ;; if on, cutscene subtitles will show up
   (text-language       pc-language) ;; language for game text
   (subtitle-language   pc-language) ;; language for subtitles
   (money-starburst?    symbol) ;; add a starburst to the money
   (extra-hud?          symbol) ;; extra hud elements.
   (recharged-master?   symbol) ;; Grecharged-master-toggle (owner 2026-07-21): GLOBAL Recharged ON/OFF. #f forces the stock state of EVERY recharged feature at runtime (C++ Gfx::recharged_active composes it at every gate; GOAL-side gates AND with it) WITHOUT resetting the individual toggles below — they come back exactly as configured when this returns #t.
   (recharged-hud?      symbol) ;; Grecharged-hud-jak1: optional "Recharged" HUD (heart/gauge/model). OFF = stock HUD.
   (recharged-grass?    symbol) ;; Grecharged-grass-poc: optional 3D grass on the training level. OFF = stock render.
   (recharged-grass-near-dist float) ;; Grecharged-grass-poc POLISH#4: near-blade view distance (m), slider-adjustable
   (recharged-grass-card-dist float) ;; Grecharged-grass-poc POLISH#4: grass-card view distance (m), slider-adjustable
   (recharged-grass-density-preset int32) ;; Ggrass-density-presets (owner 2026-08-30): grass density PRESET index (0=VERY LOW 1=LOW 2=MEDIUM 3=HIGH 4=VERY HIGH). Replaces the continuous percent slider IN PLACE (4 bytes for 4 bytes, same field order => no layout shift). Each preset has its OWN shipped bake, so the requested density is ALWAYS the loaded bake's density and the LIVE at-load placement path can no longer be selected.
   (recharged-grass-precomputed? symbol) ;; Grecharged-grass-precompute-mode: PRECOMPUTED (baked day-cycle tables) vs LIVE (full at-load scan). Same placement/fidelity; precomputed loads instantly.
   (recharged-grass-overhang? symbol) ;; Grecharged-grass-overhang: 3D drooping edge grass (near LOD only; far = stock alpha texture)
   (pbr-materials? symbol) ;; Grecharged-pbr-materials: realtime PBR lighting/shading over custom-asset materials. #f = stock shading.
   (pbr-texture-relief float) ;; Gpbr-fusion REOPEN #2: TEXTURE RELIEF slider (0..3, x on normal strength + parallax; 1.0 = pre-slider look, default 1.5)
   (pbr-specular-intensity float) ;; Gpbr-fusion REOPEN #6: SPECULAR INTENSITY slider (0..3, trims the residual highlight on smooth/metal texels; matte-dielectric default 0.15 — rough surfaces are matte via the shader matte_gate regardless)
   (pbr-displacement int32) ;; Gpbr-fusion REOPEN #3: DISPLACEMENT mode carousell (0 OFF, 1 PARALLAX, 2 TESSELLATION; default 1 PARALLAX)
   (follow-probe int32) ;; Grecharged-pbr-realtime-fusion: DYNAMIC FOLLOW-PROBE tier carousell (0 OFF, 1 LOW, 2 MID, 3 HIGH; default 1 LOW)
   (pbr-test-preset int32) ;; Gpbr-fusion REOPEN #3 (DEBUG, removable): PBR TEST PRESET carousell (0 ALL-IN, 1 FUSED, 2 FUSED FLAT, 3 PBR ONLY, 4 RT ONLY, 5 STOCK; default 1 FUSED). Only writes other settings; C++ never reads it.
   (pbr-isolate int32) ;; Gpbr-fusion REOPEN #10 (DEBUG, removable): PBR ISOLATE carousell = in-menu term bisection so the owner isolates the residual grass-facet source at his vantage with no adb (0 BOTH, 1 NORMAL-MAP ONLY, 2 PARALLAX ONLY, 3 NEITHER; default 0 BOTH). Raw index -> u_pbr_bisect mask in pc_set_pbr_isolate.
   (modern-materials? symbol) ;; Grecharged-materials-modern-parity: MODERN MATERIAL STACK (subsurface, clearcoat, anisotropy, energy compensation, ORM packing). #f = the accepted PBR path, bit-identical. Default OFF.
   (realtime-lighting? symbol) ;; Grecharged-realtime-lighting: SUN-ONLY realtime lighting (one sun, N.L per face, NO ambient). #f = stock/pbr-materials shading.
   (realtime-ambient? symbol)
   (realtime-ambient-strength float)
   (realtime-ambient-contrast float) ;; Grecharged-directional-ambient: ambient contrast (0.0..1.5 slider, default 1.0)
   (realtime-ambient-model int32) ;; Grecharged-directional-ambient ROUND 2: 0 HEMISPHERE, 1 SH, 2 IBL
   (realtime-shadow-dist float)
   (realtime-shadow-strength float) ;; Grecharged-realtime-lighting ROUND-5: cast-shadow darkening (0..1). shader residual = 1 - this.
   (realtime-shadow-quality int32)
   (recharged-foliage-wind? symbol) ;; Grecharged-foliage-wind: light wind sway for palms+shrubs. #f = stock.
   (crisp-title-logo? symbol) ;; Grecharged-title-logo-fullres: draw the title-screen JAK AND DAXTER logo (and the ND boot logo) at NATIVE resolution while the 3D world stays at RENDER SCALE. #f = stock pipeline.
   (ambient-occlusion   int32) ;; Grecharged-ambient-occlusion: 0=off 1=ssao 2=hbao 3=gtao. Default OFF (0).
   (ao-quality          int32) ;; Grecharged-ambient-occlusion: 0=low 1=medium 2=high. Default MEDIUM (1). Ignored while AO off.
   (ao-strength         int32) ;; Grecharged-ambient-occlusion closing round: 0=weaker 1=default 2=stronger. Default DEFAULT (1). Per-mode multiplier on the AO estimator intensity.
   (recharged-enhanced-models? symbol) ;; Grecharged-hd-models: load jak2 HD character models (Jak/Daxter/Samos/Keira, jak1-look) instead of stock low-poly. #f = stock. Only meaningful when the build ships the enhanced FR3 set.
   ;; Grecharged-hd-models5: per-character HD LOOK selection carousells. Each picks WHICH art variant
   ;; the enhanced-model loader uses for that character; index 0 is always the stock jak1 mesh, so the
   ;; rows stay meaningful even on a build where only some donor sets shipped. Only consulted while
   ;; recharged-enhanced-models? is on. Defaults are 1 (HD) = the jak1-look enhanced model, i.e. the
   ;; exact behaviour ENHANCED MODELS had before these rows existed.
   (hd-look-jak int32) ;; 0=ORIGINAL 1=HD 2=JAK II 3=JAK 3 4=JAK 3 MASKED (default 1 HD)
   (hd-look-daxter int32) ;; 0=ORIGINAL 1=HD 2=PANTS (default 1 HD)
   (hd-look-keira int32) ;; 0=ORIGINAL 1=HD 2=JAK 3 (default 1 HD)
   (hd-look-samos int32) ;; 0=ORIGINAL 1=HD 2=YOUNG (default 1 HD)
   (physics? symbol) ;; Grecharged-secondary-motion: secondary-motion chains on HD companions. #f = stock (no chain solve).
   (physics-quality int32) ;; Grecharged-secondary-motion: 0=LIGHT 1=FULL 2=MAXIMUM (data-driven levels in recharged_assets/physics_chains.txt)
   ;; Gprecompute-deterministic-bake: MESH SUBDIVISION level = the number of PRE-SUBDIVISION ROUNDS
   ;; the loader hands the hardware tessellator. 0=OFF (no refinement at all) 1=DEFAULT (shipped)
   ;; 2=MID 3=HIGH. Read by Loader.cpp through Gfx::g_global_settings.recharged_mesh_subdiv_rounds;
   ;; the refinement runs on the LOADER thread, so a change lands at the NEXT LEVEL LOAD.
   (mesh-subdiv int32)
   (load-custom-assets? symbol) ;; Gload-custom-assets: load user-supplied custom assets. OFF = stock assets only.
   (recharged-textures? symbol) ;; Grecharged-bundled-textures: use the package-bundled first-party Recharged replacement textures. #f = stock base textures.
   (managed-assets? symbol) ;; Grecharged-managed-assets: use the DOWNLOADED texture pack (managed_assets/<game>/) when one is installed. #f = bundled/stock, no re-download.
   ;; Gfixed-tick-interpolation (owner 2026-08-26) : PAS DE SIMULATION FIXE a 1/60 s.
   ;; #f = comportement d'origine AU BIT PRES (le pas suit la cadence d'affichage, ce qui
   ;; raccourcit les sauts et fait sauter des seuils d'etat des que le telephone descend
   ;; sous 60 images/s). #t = la logique avance par ticks de 1/60 s exactement, les pas
   ;; que le temps reel reclame en plus sont executes comme des tours de logique separes,
   ;; et le rendu interpole entre deux ticks. DEFAUT #f : une reecriture du pas de
   ;; simulation ne s'arme pas toute seule chez le joueur (superviseur 2026-08-30).
   (fixed-tick? symbol)
   (secrets             pc-game-secrets :inline) ;; hidden goodies and additional secrets!
   (scenes-seen         uint8 PC_SPOOL_LOG_LENGTH) ;; cutscenes that have been seen, by spool-anim (maybe use 8-char name or bits instead?)
   (memcard-play-hints? symbol)
   ;; Gvulkan-option: menu mirror of (-> obj gfx-renderer) as an on/off symbol for the "VULKAN RENDERER"
   ;; Graphics Options toggle (off = OpenGL/GLES default, on = Vulkan). RUNTIME ONLY — derived from
   ;; gfx-renderer on menu open; not persisted itself (gfx-renderer is what persists to settings.ini).
   (gfx-renderer-vulkan? symbol)))

(define *pc-settings* (the pc-settings-jak1 #f))

;; Grecharged-grass-poc: renderer bridges (registered in jak1 InitMachine_PCPort).
;; pc-set-recharged-grass! pushes the toggle; pc-set-jak-pos! pushes Jak's world
;; position for the grass trample. These externs are safe here (early), but the
;; per-frame push (the update-to-os override) lives in hud-classes-pc.gc: this file
;; compiles BEFORE target-h, so *target* is not yet visible here.
(define-extern pc-set-recharged-grass! (function int none))
;; Grecharged-master-toggle: pushes the GLOBAL Recharged master (0/1) to the runtime — C++
;; composes it with every individual feature flag via the single Gfx::recharged_active helper.
(define-extern pc-set-recharged-master! (function int none))
;; Gload-custom-assets: pushes the "load custom assets" toggle (0/1) to the runtime.
(define-extern pc-set-load-custom-assets! (function int none))
;; Grecharged-bundled-textures: pushes the bundled-textures toggle (0/1) to the runtime.
(define-extern pc-set-recharged-textures! (function int none))
(define-extern pc-set-managed-assets! (function int none))
;; Grecharged-grass-overhang: pushes the 3D drooping edge-grass toggle to the renderer.
;; Grecharged-buildsys-flags: extern present only with --grass-overhang (C++ side gated by OG_FEAT_GRASS_OVERHANG).
(#when FLAG_GRASS_OVERHANG
(define-extern pc-set-grass-overhang! (function int none)))
;; Grecharged-pbr-materials: pushes the PBR toggle and the current sun/shadow lighting to the renderer.
;; Grecharged-buildsys-flags: externs present only with --pbr (C++ side gated by OG_FEAT_PBR).
(#when FLAG_PBR
(define-extern pc-set-pbr! (function int none))
;; Grecharged-materials-modern-parity: MODERN MATERIALS master (0/1, int-FFI like pc-set-pbr!).
;; Flipping it C++-side also re-reads the surface table surfaces.json (pc_set_physics idiom).
(define-extern pc-set-modern-materials! (function int none))
(define-extern pc-set-pbr-sun! (function vector vector vector none))
;; Round-4 multi-light: push light-group 0 (soleil + lune verte + fill) to the renderer.
;; light-group (engine lights-h.gc) is not resolvable in this early pc compile context, so
;; the extern is typed as (function pointer none); the caller in hud-classes-pc.gc passes
;; the address of light-group 0 (which the renderer reads as a raw float block).
;; Round-5 suspect (c): push the VISIBLE sun's dome direction (*sky-parms* upload-data
;; sun 0 pos — the vector the sun sprite is placed with) so world shadows extend opposite
;; the on-screen sun (current-shadow is hard-clamped ~65deg and cannot).
(define-extern pc-set-pbr-sky-sun! (function vector none))
;; Grecharged-directional-ambient (owner playtest #3): push the GREEN SUN's real sky position
;; (*sky-parms* upload-data sun 1 pos) so it is a real 2nd directional light (day+night) that
;; also casts shadows at night — not the old synthesised opposite-of-sun night-only vector.
(define-extern pc-set-pbr-green-sun! (function vector none))
(define-extern pc-set-pbr-lights! (function pointer none))
;; Grecharged-realtime-lighting: SUN-ONLY realtime lighting master toggle + directional-ambient toggle.
(define-extern pc-set-rt-light! (function int none))
(define-extern pc-set-rt-ambient! (function int none))
;; Grecharged-directional-ambient: strength sent as an int PERCENT 0..50 (0.2 -> 20) — GOAL passes args
;; in GPRs so the C side takes an int (same int-FFI convention as dist/res/strength below).
(define-extern pc-set-rt-ambient-strength! (function int none))
;; Gpbr-fusion REOPEN #2: TEXTURE RELIEF sent as int PERCENT 0..300 (1.5 -> 150), SPECULAR INTENSITY 0..200 — same int-FFI convention.
(define-extern pc-set-pbr-texture-relief! (function int none))
(define-extern pc-set-pbr-specular-intensity! (function int none))
;; Gpbr-fusion REOPEN #3: DISPLACEMENT mode sent as raw int index (0 OFF / 1 PARALLAX / 2 TESSELLATION).
(define-extern pc-set-pbr-displacement! (function int none))
;; Grecharged-pbr-realtime-fusion: DYNAMIC FOLLOW-PROBE tier sent as raw int index (0 OFF / 1 LOW / 2 MID / 3 HIGH).
(define-extern pc-set-follow-probe! (function int none))
;; Gpbr-fusion REOPEN #10: PBR ISOLATE carousell sent as raw int index (0 BOTH / 1 NORMAL-MAP ONLY / 2 PARALLAX ONLY / 3 NEITHER); C++ maps it to the u_pbr_bisect mask.
(define-extern pc-set-pbr-isolate! (function int none))
;; Grecharged-directional-ambient: ambient CONTRAST sent as an int PERCENT 0..150 (1.0 -> 100) — same int-FFI convention.
(define-extern pc-set-rt-ambient-contrast! (function int none))
;; Grecharged-directional-ambient ROUND 2: ambient MODEL selector (0 hemisphere / 1 SH / 2 IBL).
(define-extern pc-set-rt-ambient-model! (function int none))
(define-extern pc-set-rt-shadow-dist! (function int none))
;; ROUND-5: cast-shadow strength. GOAL passes args in GPRs so the C side takes an int; we send
;; it as an int PERCENT 0..100 (0.8 -> 80), matching the int-FFI convention of dist/res.
(define-extern pc-set-rt-shadow-strength! (function int none))
(define-extern pc-set-rt-shadow-res! (function int none)))
;; Grecharged-ambient-occlusion: pushes (mode quality strength) to the C++ renderer (registered in kmachine.cpp).
;; mode 0=off/1=ssao/2=hbao/3=gtao, quality 0=low/1=medium/2=high, strength 0=weaker/1=default/2=stronger.
(define-extern pc-set-ambient-occlusion! (function int int int none))
;; Grecharged-foliage-wind: pushes the light wind sway toggle (0/1) to the renderer.
(define-extern pc-set-foliage-wind! (function int none))
;; Grecharged-title-logo-fullres: pushes the CRISP TITLE LOGO toggle (0/1) to the renderer. ON draws
;; the title-screen JAK AND DAXTER logo (and the ND boot logo) at NATIVE resolution while the 3D
;; world stays at RENDER SCALE. 0 = stock pipeline.
(define-extern pc-set-crisp-title-logo! (function int none))
;; Gprecompute-deterministic-bake: pushes the MESH SUBDIVISION level (pre-subdivision ROUND COUNT,
;; raw int 0 OFF / 1 DEFAULT / 2 MID / 3 HIGH) to the loader. Unconditional (the C++ field lives
;; outside OG_FEAT_PBR), applied at the next level load.
(define-extern pc-set-mesh-subdiv-rounds! (function int none))
;; Grecharged-hd-models: pushes the ENHANCED MODELS toggle (0/1) to the loader; queries whether the
;; enhanced FR3 set shipped in this build (1 = available, so the menu row is shown).
;; Grecharged-buildsys-flags: externs present only with --hd-models (C++ side gated by OG_FEAT_HD_MODELS).
(#when FLAG_HD_MODELS
(define-extern pc-set-recharged-enhanced-models! (function int none))
(define-extern pc-enhanced-models-available? (function int)))
;; Grecharged-secondary-motion: pushes the chain-physics toggle (0/1) + quality level to the C++ solver.
;; Extern present only with --physics (C++ side gated by OG_FEAT_PHYSICS).
(#when FLAG_PHYSICS
(define-extern pc-set-physics! (function int int none)))
;; Gfixed-tick-interpolation : pousse l'interrupteur du joueur (0/1) vers l'horloge a pas
;; fixe. PAS de `#when` : un symbole-fonction que le CGO appelle et que le .so ne fournit
;; pas fait sauter GOAL a l'adresse 0 (SIGILL) — le binding est donc inconditionnel.
(define-extern pc-set-fixed-tick! (function int none))
(define-extern pc-set-jak-pos! (function vector none))
(define-extern pc-grass-tramp-break! (function vector none)) ;; R28: instant grass-trample cancel at a breakable's break frame
;; Grecharged-grass-poc POLISH#4: push the two adjustable grass view-distances (a vector: x=near m, y=card m)
;; and Jak's ledge-grab point for the ledge-parting trample.
(define-extern pc-set-grass-dists! (function vector none))
(define-extern pc-set-jak-ledge! (function vector none))
;; Grecharged-grass-poc ROUND#21d: exact ground-actor world positions for the grass object-clip /
;; crate-trample (the pc-set-jak-pos! pattern; the Merc2 camera-space recovery is dead). The pc glue
;; (hud-classes-pc.gc update-to-os) calls clear!, add! per actor, publish! every ~30 frames.
;; add! args: kind (0 = CULL static, 1 = TRAMPLE breakable), the actor's root trans, ground-contact
;; radius as a GOAL-units integer (meters * 4096 — ints only across the C bridge).
(define-extern pc-grass-occ-clear! (function none))
(define-extern pc-grass-occ-add! (function int vector int none))
(define-extern pc-grass-occ-publish! (function none))
(define-extern pc-get-tod-hour (function int)) ;; Grecharged-grass-precompute-mode verification aid: debug.opengoal.tod.hour prop (hour*100; -1 = unset)
;; scratch vector reused each frame to hand the two distances to the bridge (avoids per-frame alloc).
(define *grass-dist-scratch* (new 'static 'vector :x 30.0 :y 95.0 :z 150.0 :w 1.0))

;; jak 1 discord rpc structure
(deftype discord-info (structure)
  ((fuel         (pointer float))
   (money-total  (pointer float))
   (buzzer-total (pointer float))
   (deaths       (pointer int32))
   (status       string)
   (level        string)
   (cutscene?    symbol)
   (ogreboss?    symbol)
   (plant-boss?  symbol)
   (racer?       symbol)
   (flutflut?    symbol)
   (time-of-day  (pointer float))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; debug settings
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *fallback-text-lookup?* #t)

(define *display-bug-report* #f)

(define *mood-override-debug* #f)

(define *mood-override-table* (new 'global 'inline-array 'float 8))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; resets
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmethod reset-misc ((obj pc-settings-jak1) (call-handlers symbol))
  "Set the default misc settings"
  ((method-of-type pc-settings reset-misc) obj call-handlers)
  (set! (-> obj text-language) (the pc-language (scf-get-language)))
  (set! (-> obj subtitle-language) (the pc-language (scf-get-language)))
  (set! (-> obj skip-movies?) #t)
  (set! (-> obj subtitles?) *debug-segment*)
  (cond
    ((and (= *default-territory* GAME_TERRITORY_SCEE) (= (-> obj text-language) (pc-language english)))
     (set! (-> obj text-language) (pc-language uk-english))
     ;(set! (-> obj subtitle-language) (pc-language uk-english))
     )
    ((= *default-territory* GAME_TERRITORY_SCEI)
     (set! (-> obj text-language) (pc-language japanese))
     ;(set! (-> obj subtitle-language) (pc-language japanese))
     )
    (else))
  (set! (-> obj money-starburst?) #f)
  (set! (-> obj extra-hud?) #f)
  (set! (-> obj recharged-master?) #t) ;; Grecharged-master-toggle: default ON (all shipped recharged defaults apply; OFF == pure vanilla)
  (set! (-> obj recharged-hud?) #f) ;; Grecharged-hud-jak1: default OFF so a fresh install matches stock exactly
  (set! (-> obj recharged-grass?) #t) ;; Grecharged-grass-poc: OWNER OVERRIDE 2026-07-10 — ships DEFAULT ON (toggle still exists; OFF == stock)
  (set! (-> obj recharged-grass-near-dist) 30.0) ;; POLISH#4 default near-blade view distance (m)
  (set! (-> obj recharged-grass-card-dist) 95.0) ;; POLISH#4 default grass-card view distance (m; pushed further)
  (set! (-> obj recharged-grass-density-preset) 2) ;; Ggrass-density-presets default = 2 MEDIUM, which IS the 150% that shipped until now: the default behaviour does not change.
  (set! (-> obj recharged-grass-precomputed?) #t) ;; precomputed preferred; renderer falls back to LIVE when no bake exists
  (set! (-> obj recharged-grass-overhang?) #f) ;; PARKED 2026-07-15 (owner): overhang default OFF until the feature is resumed (see reports/Grecharged-grass-overhang7/PARKED.md)
  (set! (-> obj pbr-materials?) #t) ;; Grecharged-pbr-materials: default ON (toggle still exists; OFF == stock shading)
  (set! (-> obj pbr-texture-relief) 1.5) ;; REOPEN #2 shipped default: noticeably stronger relief than the pre-slider look (1.0)
  (set! (-> obj pbr-specular-intensity) 0.15) ;; REOPEN #6 matte-dielectric default: LOW (matte is the norm; rough surfaces matte via shader matte_gate, slider only trims smooth/metal highlights)
  (set! (-> obj pbr-displacement) 1) ;; REOPEN #3 shipped default: PARALLAX (0 OFF / 1 PARALLAX / 2 TESSELLATION)
  (set! (-> obj follow-probe) 1) ;; Grecharged-pbr-realtime-fusion shipped default: LOW (0 OFF / 1 LOW / 2 MID / 3 HIGH)
  (set! (-> obj pbr-test-preset) 1) ;; REOPEN #3 (DEBUG): default FUSED (1) = the shipped config; carousell only, applies other settings on confirm
  (set! (-> obj pbr-isolate) 0) ;; REOPEN #10 (DEBUG): default BOTH (0) = full fused path unchanged; owner flips to isolate the facet term
  (set! (-> obj modern-materials?) #f) ;; Grecharged-materials-modern-parity: default OFF => #f = the accepted PBR shading, bit-identical
  (set! (-> obj realtime-lighting?) #f) ;; Grecharged-realtime-lighting: default OFF (opt-in; flip via settings.ini / debug prop). ON = sun-only lighting.
  (set! (-> obj realtime-ambient?) #t)
  (set! (-> obj realtime-ambient-strength) 0.2)
  (set! (-> obj realtime-ambient-contrast) 1.0) ;; Grecharged-directional-ambient: owner-validated shipped default (playtest 2026-07-20: SH + strength 0.2 + contrast 1.0). This GOAL default drives the fresh out-of-box value (pushed over the gfx.h C++ fallback via pc-set-rt-ambient-contrast!).
  (set! (-> obj realtime-ambient-model) 1) ;; default SH (directional over the full normal; shipped/out-of-box model, supervisor 2026-07-20). Hemisphere/IBL selectable.
  (set! (-> obj realtime-shadow-dist) 150.0)
  (set! (-> obj realtime-shadow-strength) 0.8) ;; Grecharged-realtime-lighting ROUND-5: default cast-shadow darkening (residual 0.2)
  (set! (-> obj realtime-shadow-quality) 2) ;; 0=VLow(512) 1=Low(1024) 2=Med(2048) 3=High(4096) 4=VHigh(8192)
  (set! (-> obj recharged-foliage-wind?) #f) ;; Grecharged-foliage-wind: light wind sway for palms+shrubs. #f = stock.
  (set! (-> obj crisp-title-logo?) #f) ;; Grecharged-title-logo-fullres: draw the title-screen JAK AND DAXTER logo (and the ND boot logo) at NATIVE resolution while the 3D world stays at RENDER SCALE. Default OFF => #f = stock pipeline.
  (set! (-> obj ambient-occlusion) 0) ;; Grecharged-ambient-occlusion: default OFF
  (set! (-> obj ao-quality) 1) ;; Grecharged-ambient-occlusion: default MEDIUM quality
  (set! (-> obj ao-strength) 1) ;; Grecharged-ambient-occlusion closing round: default DEFAULT strength
  (set! (-> obj recharged-enhanced-models?) #f)
  ;; Grecharged-hd-models5: per-character HD LOOK defaults — 1 = HD (the jak1-look enhanced model),
  ;; i.e. the pre-carousell ENHANCED MODELS behaviour. 0 = ORIGINAL (stock jak1 mesh) for every one.
  (set! (-> obj hd-look-jak) 1) ;; 0 ORIGINAL / 1 HD / 2 JAK II / 3 JAK 3 / 4 JAK 3 MASKED
  (set! (-> obj hd-look-daxter) 1) ;; 0 ORIGINAL / 1 HD / 2 PANTS
  (set! (-> obj hd-look-keira) 1) ;; 0 ORIGINAL / 1 HD / 2 JAK 3
  (set! (-> obj hd-look-samos) 1) ;; 0 ORIGINAL / 1 HD / 2 YOUNG
  (set! (-> obj physics?) #t) ;; Grecharged-secondary-motion: secondary-motion chains on HD companions — default ON (feature is opt-in at build time)
  (set! (-> obj physics-quality) 1) ;; 0=LIGHT 1=FULL 2=MAXIMUM (data-driven levels in recharged_assets/physics_chains.txt)
  (set! (-> obj mesh-subdiv) 1) ;; Gprecompute-deterministic-bake: 0=OFF 1=DEFAULT (shipped) 2=MID 3=HIGH pre-subdivision rounds
  (set! (-> obj load-custom-assets?) #f) ;; Gload-custom-assets: default OFF so a fresh install uses stock assets only
  (set! (-> obj recharged-textures?) #t) ;; Grecharged-bundled-textures: default ON — a plain install shows the owner's Recharged textures (the MASTER still forces stock when OFF)
  (set! (-> obj managed-assets?) #t) ;; Grecharged-managed-assets: default ON — a downloaded pack is meant to be seen (the MASTER still forces stock when OFF)
  (set! (-> obj fixed-tick?) #f) ;; Gfixed-tick-interpolation: defaut DESARME = sortie identique au bit a l'existant
  ;; original settings, minus 25 to be a bit more conservative
  (set! (-> obj memcard-volume-sfx) 50.0)
  (set! (-> obj memcard-volume-music) 40.0)
  (set! (-> obj memcard-volume-dialog) 75.0)
  (set! (-> obj memcard-vibration?) #t)
  (set! (-> obj memcard-play-hints?) #t)
  0)

(defmethod reset-extra ((obj pc-settings-jak1) (call-handlers symbol))
  "Set the default goodies settings"
  ((method-of-type pc-settings reset-extra) obj call-handlers)
  (set! (-> obj cheats) (pc-cheats))
  (set! (-> obj cheats-known) (pc-cheats))
  (dotimes (i PC_SPOOL_LOG_LENGTH)
    (set! (-> obj scenes-seen i) 0))
  (dotimes (i PC_MUSIC_LOG_LENGTH)
    (set! (-> obj secrets music i name) #f)
    (set! (-> obj secrets music i flava-mask) 0))
  (set! (-> obj secrets art) (pc-jak1-concept-art))
  (set! (-> obj secrets hard-fish-hiscore) 0)
  (set! (-> obj secrets hard-rats-hiscore) 0)
  (set! (-> obj secrets hard-rats-hiwave) 0)
  (set! (-> obj secrets hard-rats?) #f)
  (set! (-> obj secrets hero-mode?) #f)
  (set! (-> obj secrets hud-map?) #t)
  (set! (-> obj secrets hud-counters?) #t)
  (set! (-> obj secrets hud-watch?) #f)
  (set! (-> obj secrets watch-12hr?) #f)
  0)

