;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun get-video-params ()
  *video-parms*)

;; for debugging
(defenum pc-pat-skip-hack
  :bitfield #t
  (noentity 0)
  (nocamera 1)
  (noedge 2)
  (nolineofsight 12)
  (unknowncamera 13))
