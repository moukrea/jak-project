;;-*-Lisp-*-
(in-package goal)
(require "pc/hud-classes-pc.gc")
(require "engine/ui/text.gc")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Gloading-screen -- LE DESSIN (owner 2026-08-28, maquette fournie)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; La PORTE (quand dessiner) vit dans engine/game/main.gc : `loading-screen-held?` /
;; `loading-screen-shown?`, armees par la seule barriere de chargement. Ici, on ne fait que
;; peindre. Ce fichier ne decide de rien.
;;
;; POURQUOI CE FICHIER PEINT SON PROPRE NOIR. Le noir du moteur n'est pas un sprite : c'est un
;; quad plein ecran dessine par l'etage PCRTC APRES tous les buckets -- OpenGLRenderer.cpp:1937
;; sur bureau, android_opengl_renderer.cpp:1602 sur telephone. Rien de ce que GOAL emet dans un
;; bucket ne peut donc apparaitre par-dessus. main.gc eteint `bg-a-force` pendant la barriere et
;; c'est nous qui posons le fond.
;;
;; POURQUOI 512x224 EST BIEN L'ECRAN ENTIER, A TOUT FORMAT. Le nuanceur de sommets du chemin
;; direct (shaders/direct2.vert) fait `x_ndc = (x_gs*16 - 0x8000)/0x1000`, donc x_gs 1792..2304
;; -- 512 unites -- couvre [-1,1] quelle que soit la largeur de fenetre ; et `y *= SCISSOR_ADJUST`
;; avec SCISSOR_ADJUST = 512/448 pour jak1 (Shader.cpp:408) amene les 224 lignes exactement sur
;; [-1,1]. Aucune barre ne peut rester sur les cotes.
;;
;; DEUX REPERES, A NE PAS MELANGER :
;;   - le texte (`draw-string-xy-scaled`) et `draw-sprite2d-xy` travaillent en 512 x 224 ;
;;   - `rhud-add-vert` travaille en 512 x 448 (il fait `y_gs = 1936 + 0.5*py`).
;; Les fractions d'ecran ci-dessous sont donc multipliees par 224.0 ou par 448.0 selon l'appelant,
;; jamais par les deux.

;; Slots VRAM ou le runtime PC charge les deux images (RechargedHudTextures.cpp, base 8300).
(defconstant RHUD_TBP_LOADING_JAK 8311)
(defconstant RHUD_TBP_LOADING_PRECURSOR 8312)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; GEOMETRIE -- MESUREE SUR LA MAQUETTE DE L'OWNER, PAS CHOISIE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Toutes ces valeurs sortent de .autoport/mk_loading_assets.py applique a
;; .autoport/design/loading-screen-owner-mockup.png (1672x941, rapport 1,7768 -- 16:9 a 0,06 %).
;; Elles sont en FRACTIONS d'ecran, donc independantes de la resolution.
;;
;; RESERVE DECLAREE : le contrat de phase ecrit « ~40 % de la hauteur d'ecran » pour la
;; silhouette ; la maquette de l'owner en mesure 61,2 %. On reproduit LA MAQUETTE, parce que
;; c'est l'artefact qu'il a depose lui-meme, et la prose la resume de memoire. Une seule ligne a
;; changer si l'owner prefere son chiffre : LS_SIL_H.
(defconstant LS_SIL_CX 0.272129)   ;; centre x de la silhouette
(defconstant LS_SIL_CY 0.519660)   ;; centre y de la silhouette
(defconstant LS_SIL_H 0.612115)    ;; hauteur de la silhouette / hauteur d'ecran
(defconstant LS_SIL_WH 1.0243)     ;; largeur/hauteur de recharged_assets/loading_jak.png (590x576)

(defconstant LS_TEXT_RIGHT 0.8822) ;; bord DROIT de la bande « Loading... » (x 1475 / 1672)
(defconstant LS_TEXT_TOP 0.7216)   ;; haut de la bande de texte (y 679 / 941)
(defconstant LS_TEXT_SCALE 1.0407)  ;; grande police. CALIBREE, pas choisie : a 1,3 la trace rendait
                                    ;; ref-w=138,85 pour une cible de 111,16 (ratio 1,2491), donc
                                    ;; 1,3 / 1,2491 = 1,0407. Verifie par une seconde course.

(defconstant LS_GLYPH_TOP 0.8268)  ;; haut de la bande de glyphes (y 778 / 941)

;; Largeur CIBLE de la bande « Loading... », mesuree sur la maquette : x 1113..1475 sur 1672, soit
;; 0,21711 de la largeur d'ecran, donc 111,16 unites de la toile 512.
;; C'EST CE NOMBRE QUI CALIBRE `LS_TEXT_SCALE`, et il se lit dans une TRACE, pas a l'oeil :
;; `LOADSCREEN-LAYOUT ... ratio=` publie largeur-rendue / cible. Le reglage est bon quand ce
;; ratio vaut 1. Les captures d'ecran ne servent pas de verdict ici.
(defconstant LS_TEXT_W_TARGET 111.16)
;; `ratio=` de la trace se calcule sur la chaine ANGLAISE LITTERALE, jamais sur la chaine
;; localisee : la maquette a ete dessinee avec « Loading... », et la TAILLE de police doit rester
;; la meme dans toutes les langues -- c'est la LARGEUR qui varie d'une langue a l'autre, et c'est
;; voulu. Calibrer sur « Chargement... » retrecirait le francais pour le faire tenir dans la
;; largeur de l'anglais. La trace publie donc les deux : `texte-w` (la langue courante, ce qui est
;; reellement dessine) et `ref-w` (l'anglais, la base de calibration).

;; Table de glyphes precurseurs, A..Z, EXTRAITE de recharged_assets/font/precursor/precursor.json
;; (produite par la phase Gfont-urbanist depuis la planche fournie par l'owner). Les valeurs sont
;; recopiees, jamais recalculees. L'avance `adv` y est une CONVENTION declaree (largeur + 0,30 em) :
;; la planche est une grille de presentation et ne porte aucune metrique d'origine.
;; Em de dessin : 72 px. Atlas : 512x512.
(defconstant LS_PRECURSOR_EM 72.0)

