       (new 'static 'vector :x 0.003906 :y 0.597656 :z 0.103516 :w 0.730469) ;; Y
       (new 'static 'vector :x 0.134766 :y 0.597656 :z 0.203125 :w 0.734375) ;; Z
       ))

;; metriques dans l'em de dessin : x=largeur y=hauteur z=avance
(define *ls-precursor-metrics*
  (new 'static 'inline-array vector 26
       (new 'static 'vector :x 50.0000 :y 69.0000 :z 61.5200) ;; A
       (new 'static 'vector :x 56.0000 :y 69.0000 :z 67.5200) ;; B
       (new 'static 'vector :x 34.0000 :y 70.0000 :z 45.5200) ;; C
       (new 'static 'vector :x 48.0000 :y 72.0000 :z 59.5200) ;; D
       (new 'static 'vector :x 48.0000 :y 70.0000 :z 59.5200) ;; E
       (new 'static 'vector :x 38.0000 :y 69.0000 :z 49.5200) ;; F
       (new 'static 'vector :x 54.0000 :y 67.0000 :z 65.5200) ;; G
       (new 'static 'vector :x 35.0000 :y 72.0000 :z 46.5200) ;; H
       (new 'static 'vector :x 63.0000 :y 67.0000 :z 74.5200) ;; I
       (new 'static 'vector :x 59.0000 :y 64.0000 :z 70.5200) ;; J
       (new 'static 'vector :x 47.0000 :y 64.0000 :z 58.5200) ;; K
       (new 'static 'vector :x 57.0000 :y 67.0000 :z 68.5200) ;; L
       (new 'static 'vector :x 48.0000 :y 66.0000 :z 59.5200) ;; M
