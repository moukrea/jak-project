;; PRIMITIVES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ls-quad ((buf dma-buffer) (uv vector) (x0 float) (y0 float) (x1 float) (y1 float))
  "Quad texture aligne sur les axes : le rect UV `uv` (x=u0 y=v0 z=u1 w=v1) pose sur le rect
   ecran (x0,y0)-(x1,y1). x en unites 512, y en unites 448 -- le repere de `rhud-add-vert`.
   Meme giftag et meme ordre de sommets que `rhud-quad` (hud-classes-pc.gc), dont ceci n'est que
   la variante a UV libres : `rhud-quad` cable la toile entiere en 0..1 et ne sait pas decouper
   un glyphe dans un atlas."
  (with-cnt-vif-block (buf)
    ;; packed, 4 sommets, prim tri-strip/iip/tme/abe, regs st rgbaq xyzf2
    (dma-buffer-add-uint64 buf (logior 4 #x8000 (ash 1 46) (ash #x5c 47) (ash 3 60)) #x412)
    (rhud-add-vert buf (-> uv x) (-> uv y) (rhud-rgba 128 128 128 128) x0 y0)
    (rhud-add-vert buf (-> uv z) (-> uv y) (rhud-rgba 128 128 128 128) x1 y0)
    (rhud-add-vert buf (-> uv x) (-> uv w) (rhud-rgba 128 128 128 128) x0 y1)
    (rhud-add-vert buf (-> uv z) (-> uv w) (rhud-rgba 128 128 128 128) x1 y1))
  (none))

(defun ls-text-width ((str string) (scale float))
  "Largeur RENDUE de `str`, dans les unites x de la toile 512.
   NATURE : une longueur (l'avance de la plume), pas un compte de caracteres.
   REPERE : la toile 2D 512x224 -- LE MEME que celui ou `ls-quad` pose les glyphes precurseurs.

   LE FACTEUR QUI MANQUAIT, ET C'EST LE DEFAUT QUE L'OWNER A VU. `get-string-length`
   (engine/gfx/font.gc:1531) rend une avance en unites de PLUME : elle somme la colonne d'avance
   de `*font24-table*` et ne lit NI le champ `scale` du contexte NI la matrice de police.
   `draw-string-xy-scaled` (font.gc:1636), lui, multiplie `(-> *font-default-matrix* vector 0 x)`
   par son `scale` -- et cette case vaut `relative-x-scale`, reposee A CHAQUE FRAME par
   pckernel.gc:281 a `ASPECT_4X3 / aspect`. La largeur POSEE vaut donc `relative-x-scale x scale x
   avance`, quand cette fonction rendait `scale x avance` : SUR-ESTIMATION D'UN FACTEUR 4/3 en
   16:9 (0,75 de reciproque). La ligne precurseur etant calee sur ce nombre, elle sortait
   30,6 % plus large que le texte -- exactement ce que l'owner decrit.

   Le moteur connait ce facteur et l'applique deja partout ou il mesure une largeur pour la
   comparer a une position : engine/ui/text.gc:343 et :369 font
   `(* (get-string-length ...) (-> *video-parms* relative-x-scale))`. Ce site etait le seul a
   l'omettre.

   CONSEQUENCE DE CONCEPTION, DECLAREE : la largeur rendue depend donc du FORMAT de la fenetre.
   Ce n'est pas un defaut, c'est la convention du moteur -- le texte garde une taille constante
   par rapport a la HAUTEUR d'ecran au lieu de s'etirer avec la largeur. `LS_TEXT_SCALE` est cale
   sur le 16:9 de la maquette de l'owner."
  (let ((ctxt (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags kerning large))))
    (* scale (-> *video-parms* relative-x-scale) (get-string-length str ctxt))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; LE DESSIN
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *ls-traced* #f)

;; Bornes x REELLEMENT posees par le dernier appel a `ls-draw-precursor`, en unites de la toile
;; 512. Ce ne sont PAS les bornes demandees : elles sont relevees sur les coordonnees des quads
;; effectivement emis, donc elles constatent ce qui est dessine au lieu de republier la consigne.
;; C'est ce qui permet de publier « largeur du texte » et « largeur de la ligne precurseur » cote
;; a cote sans que l'une des deux soit un miroir de l'autre.
(define *ls-sil-frame* 0)   ;; derniere cellule de planche posee -- publiee, jamais lue par le dessin
(define *ls-precursor-scale* 0.0)  ;; unites x de la toile 512 par pixel de l'atlas de glyphes
(define *ls-precursor-x0* 0.0)
(define *ls-precursor-x1* 0.0)

(defun ls-draw-precursor ((buf dma-buffer) (word string) (right float) (top float) (target-w float) (fx float))
  "Dessine `word` (MAJUSCULES ASCII A-Z + espaces) en glyphes precurseurs, cale pour que son
   ENCRE occupe exactement `target-w` unites x, bord droit de l'encre en `right`, mediane des
   glyphes a `top` + un demi-em (unites 448). Rend l'avance totale dans l'em de dessin.

   L'OWNER 2026-08-29 : « le texte Chargement... est moins large que son pendant en Precursor,
   ce que je voulais eviter ». LA CAUSE COTE PRECURSEUR EST ICI, ET C'EST UN ECHANGE DE GRANDEUR :
   la version precedente mettait a l'echelle la SOMME DES AVANCES, pas l'ETENDUE DE L'ENCRE. Or
   une avance porte le blanc qui suit le glyphe. En calant `somme des avances = target-w`, l'encre
   couvrait `target-w - s*(avance_dernier - largeur_dernier)` -- moins que la cible -- et le
   dernier glyphe s'arretait avant `right`. Le meme echange de denominateur a l'autre bout de la
   chaine (une largeur de texte SUR-ESTIMEE) additionne son erreur a celle-ci. On cale donc sur
   l'ETENDUE DE L'ENCRE : `somme des avances sauf la derniere, plus la largeur de la derniere`.
   Par construction, le bord droit de l'encre du dernier glyphe tombe alors EXACTEMENT sur `right`
   et son bord gauche sur `right - target-w`.

   POURQUOI LE MOT EST TRANSLITTERE HORS LIGNE. Dans l'encodage de texte de jak1 les MINUSCULES
   ne sont pas de l'ASCII -- common/util/font/dbs/font_db_jak1.cpp reaffecte les octets 0x60-0x65
   a des kanji. Les MAJUSCULES, elles, ne figurent pas dans `encode_info_jak1` et passent donc en
   ASCII. On lit ici une entree de banque DEJA en majuscules (text-id pc-text-loading-precursor)
   et on ne fait plus qu'une correspondance octet -> index de glyphe. Un octet hors A-Z est
   ignore sans bruit : le japonais et le coreen portent une chaine VIDE et ne dessinent rien,
   c'est le repli declare dans recharged_assets/font/precursor/README.md."
  (let ((n (length word))
        (total 0.0)
        (ink 0.0))
    ;; 1re passe : l'avance totale ET l'etendue de l'encre, dans l'em de dessin. `ink` suit le
    ;; bord droit de l'encre du dernier glyphe pose, `total` le stylo.
    (let ((p (-> word data)))
      (dotimes (i n)
        (let ((c (the int (-> p i))))
          (cond
            ((and (>= c 65) (<= c 90))
             (set! ink (+ total (-> *ls-precursor-metrics* (- c 65) x)))
             (set! total (+ total (-> *ls-precursor-metrics* (- c 65) z))))
            ((= c 32) (set! total (+ total (* 0.5 LS_PRECURSOR_EM))))
            (else (empty))))))
    (set! *ls-precursor-x0* 0.0)
    (set! *ls-precursor-x1* 0.0)
    (when (> ink 0.0)
      ;; 2e passe : poser les glyphes. `s` est en unites x par pixel de dessin ; une longueur en
      ;; unites x vaut la meme longueur physique que (elle / fx) en unites y, d'ou la hauteur.
      (let* ((s (/ target-w ink))
             (pen (- right target-w))
             (first #t))
        (set! *ls-precursor-scale* s)
        (rhud-set-shader buf RHUD_TBP_LOADING_PRECURSOR)
        (let ((p (-> word data)))
          (dotimes (i n)
            (let ((c (the int (-> p i))))
              (cond
                ((and (>= c 65) (<= c 90))
                 (let* ((gi (- c 65))
                        (gw (* s (-> *ls-precursor-metrics* gi x)))
                        (gh (/ (* s (-> *ls-precursor-metrics* gi y)) fx))
                        (gy (+ top (/ (* s (-> *ls-precursor-metrics* gi w)) fx))))
                   (ls-quad buf (-> *ls-precursor-uv* gi) pen gy (+ pen gw) (+ gy gh))
                   ;; bornes RELEVEES sur les quads emis, pas calculees d'avance
                   (when first (set! first #f) (set! *ls-precursor-x0* pen))
                   (set! *ls-precursor-x1* (+ pen gw))
                   (set! pen (+ pen (* s (-> *ls-precursor-metrics* gi z))))))
                ((= c 32) (set! pen (+ pen (* s 0.5 LS_PRECURSOR_EM))))
                (else (empty))))))))
    total))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; INSTRUMENT DE CAPTURE (owner 2026-08-29, retour n.4)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; « Deja c'est pas l'animation ou Jak court vu de cote du tout, c'est plus de la marche... Et en
;; plus la silhouette animee a l'air d'aller vers la gauche au lieu de la droite (et prise avec un
;; angle bizarre) en plus de mal boucler »
;;
;; QUATRE REPROCHES, ET LE LOG DE LA CAPTURE PRECEDENTE NE PERMET DE TRANCHER AUCUN DES QUATRE :
;; `grep -c ANIM` y rend ZERO. On a monte une planche sans jamais publier ce que le personnage
;; faisait. Cette fonction publie, PAR FRAME, les quatre grandeurs qui decident -- et elles sont
;; toutes lues sur l'etat du moteur, jamais sur l'image.
;;
;; 1. MARCHE OU COURSE : ce n'est pas un choix d'animation, c'est un FONDU. jak1 n'a qu'un etat de
;;    locomotion au sol (`target-walk`, target.gc:374) qui empile `eichar-walk-ja` sur le canal 0
;;    et `eichar-run-ja` sur le canal 3 ; le canal 6 porte le melange (target.gc:578), pilote par
;;    la vitesse : 100 % marche sous 16384 u/s, 100 % course au-dessus de 36864 (target.gc:556-559).
;;    `melange=` EST la reponse a « c'est plus de la marche », et `v=` en est la cause.
;; 2. DIRECTION : `dx` est la difference d'abscisse ECRAN entre Jak et un point a 1 m DEVANT lui,
;;    obtenue en projetant les deux par `transform-point-vector!` -- donc par la matrice de camera
;;    du moteur, pas par un raisonnement de signes. `dx > 0` = il court vers la DROITE de l'ecran,
;;    ce que l'owner demande. C'est aussi ce qui dit si un miroir est necessaire au montage.
;; 3. ANGLE : `camy-jaky` est la hauteur de la camera au-dessus de la racine de Jak (l'elevation
;;    de la vue), et `fov` la focale REELLEMENT en vigueur -- `cam-orbit` ne la pose jamais, il
;;    HERITE de l'etat precedent (defaut 64 degres), et une focale large a 6 m deforme le profil.
;; 4. BOUCLE : `f=` et `len=` donnent la periode du cycle a la source, dans les frames de logique
;;    ou la planche l'echantillonne. Le montage n'a plus a la deviner sur les pixels.
;;
;; NATURE / REPERE, pour chaque colonne : `f` et `len` sont des frames de DONNEES d'animation ;
;; `melange` est sans dimension (0..1) ; `v` est en unites/seconde du moteur ; `sx` et `dx` sont
;; en unites GS de la toile 512 (2048 = centre de l'ecran) ; `camy-jaky` en unites monde
;; (4096 = 1 m) ; `fov` en degres GOAL.
;; CE QUE CA LIT QUAND LE DEFAUT EST ABSENT : `melange` = 1,0 (course pure), `dx` > 0, `camy-jaky`
;; proche de la mi-hauteur du sujet, et `f` qui monte lineairement puis retombe a 0.
;;
;; ETEINT PAR DEFAUT, ET ALLUME UNIQUEMENT DEPUIS LA CONSOLE : aucun chemin de jeu ne le pose.
(define *ls-capture-trace* #f)

;; INSTRUMENT, ET IL A UNE RAISON MESUREE. La preuve de largeur
;; (.autoport/gls_width_proof.sh + gls_measure_widths.py) isole la bande de texte et la bande de
;; glyphes dans l'IMAGE PRODUITE, sans rien supposer de leur position. La silhouette de COURSE
;; livree ce cycle est nettement plus large que la pose quasi immobile du cycle precedent : elle
;; chevauche maintenant la bande de texte en x ET en y, et l'allemand est ressorti a 1 456 px de
;; « largeur de texte » au lieu de 855 -- la mesure agregeait le personnage et la phrase.
;; Eteindre la silhouette pendant CETTE mesure isole ce qu'elle pretend mesurer. Vrai par defaut ;
;; aucun chemin de jeu ne le pose.
(define *ls-draw-silhouette* #t)

(defun ls-capture-trace ()
  "Publier l'etat du sujet pour UNE frame de capture. Voir le pave ci-dessus."
  (when (and *ls-capture-trace* *target*)
    (let ((skel (-> *target* skel)))
      (when (> (-> skel active-channels) 6)
        (let ((p0 (new 'stack-no-clear 'vector))
              (p1 (new 'stack-no-clear 'vector))
              (s0 (new 'stack-no-clear 'vector))
              (s1 (new 'stack-no-clear 'vector))
              (dir (new 'stack-no-clear 'vector)))
          (set! (-> p0 quad) (-> *target* control trans quad))
          (vector-normalize-copy! dir (-> *target* control transv) 4096.0)
          (vector+! p1 p0 dir)
          (transform-point-vector! s0 p0)
          (transform-point-vector! s1 p1)
          (format 0 "CAPFRAME afc=~D marche=~S f=~f len=~D~%"
                  (-> *display* actual-frame-counter)
                  (-> skel root-channel 0 frame-group name)
                  (-> skel root-channel 0 frame-num)
                  (-> skel root-channel 0 frame-group data 0 length))
          (format 0 "CAPRUN course=~S f=~f len=~D melange=~f v=~f~%"
                  (-> skel root-channel 3 frame-group name)
                  (-> skel root-channel 3 frame-num)
                  (-> skel root-channel 3 frame-group data 0 length)
                  (-> skel root-channel 6 frame-interp)
                  (-> *target* control unknown-float01))
          (format 0 "CAPVUE sx=~f dx=~f camy-jaky=~f fov=~f~%"
                  (-> s0 x)
                  (- (-> s1 x) (-> s0 x))
                  (- (-> *math-camera* trans y) (-> p0 y))
                  (-> *math-camera* fov))))))
  (none))

(defun loading-screen-draw ()
  "Peindre l'ecran de chargement. Appele par le display-loop (engine/game/main.gc, post-sync-draw)
   UNIQUEMENT quand `loading-screen-held?` est vrai -- c'est-a-dire uniquement pendant qu'une
   barriere de chargement retient la scene.

   Le FOND est peint des que la barriere tient ; le CONTENU attend le SEUIL
   (`loading-screen-shown?`), pour qu'une barriere qui s'ouvre presque aussitot ne produise pas
   un clignotement.

   Bucket `debug-no-zbuf` (68), et depuis post-sync-draw : c'est le dernier ecrivain de ce bucket
   dans la frame, donc on peint par-dessus le HUD et par-dessus le compteur de FPS -- celui-ci est
   ajoute au MEME bucket depuis `(update *pc-settings*)` a la fin de l'iteration precedente."
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
    ;; Etat GS explicite : melange alpha standard, test de profondeur neutralise. On ne se repose
    ;; pas sur l'etat ambiant du bucket -- c'est ce qui rend le fond opaque de facon reproductible.
    (dma-buffer-add-gs-set buf
                           (alpha-1 (new 'static 'gs-alpha :b 1 :d 1))
                           (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24) :zmsk 1))
                           (test-1 (new 'static 'gs-test :zte 1 :ztst (gs-ztest always))))
    ;; --- 1. le fond noir, plein ecran ---
    (draw-sprite2d-xy buf 0 0 512 224 (new 'static 'rgba :a #x80))
    (when (loading-screen-shown?)
      (+! *loading-screen-frames* 1)
      ;; Trace bornee : la 1re frame montree de l'episode, puis une ligne par seconde. C'est la
      ;; PREUVE D'EXECUTION du chemin de dessin -- un compteur qui monte, lisible aussi bien dans
      ;; la sortie x86 que dans logcat sur l'appareil. Un commentaire ne prouverait rien.
      (when (or (= *loading-screen-frames* 1) (zero? (mod *loading-screen-frames* 60)))
        (format 0 "LOADSCREEN-SHOW arm=~D frames=~D~%" *loading-screen-arms* *loading-screen-frames*)
        ;; CE QUE LES DEUX HORLOGES ONT AVANCE DEPUIS LE DEBUT DE L'EPISODE, COTE A COTE.
        ;; NATURE : deux durees. REPERE : les DEUX en 1/300 s -- l'horloge de l'ecran de
        ;; chargement recoit le meme `scaled-seconds` que `base-frame-counter`, elle ne s'en
        ;; distingue QUE par le garde `paused?`. La ligne les publie ramenees en millisecondes.
        ;; C'EST CE MEME CONTROLE QUI A REFUTE MON PREMIER CHOIX D'HORLOGE : avec
        ;; `real-integral-frame-counter` il rendait `integ-ms=2466,7` contre `base-ms=4933,3`,
        ;; facteur EXACTEMENT 2 a 30 images/s, parce que ce compteur compte des frames CIBLES.
        ;; CE QU'ELLE LIT QUAND LE DEFAUT EST ABSENT : les deux colonnes montent ensemble.
        ;; QUAND IL EST PRESENT (menu ouvert, donc chargement de partie) : `base-ms` reste a 0
        ;; pendant que `integ-ms` monte. C'est le controle de la correction d'horloge, sur la
        ;; ligne meme ou le verdict se forme, et il ne coute rien.
        (format 0 "LOADSCREEN-CLOCK arm=~D pause=~A mode=~A integ-ms=~f base-ms=~f~%"
                *loading-screen-arms*
                (paused?)
                *master-mode*
                (* 3.3333333 (the float (- (loading-screen-clock) *loading-screen-since*)))
                (* 3.3333333 (the float (- (current-time) *loading-screen-since-base*)))))
      (let ((fx (rhud-aspect-fx)))
        ;; --- 2. la silhouette, UNE CELLULE de la planche choisie par le temps ecoule ---
        (when *ls-draw-silhouette*
        (let* ((h448 (* LS_SIL_H 448.0))
               (w512 (* (* h448 LS_SIL_WH) fx))
               (cx (* LS_SIL_CX 512.0))
               (cy (* LS_SIL_CY 448.0))
               (fr (mod (/ (* LS_SIL_FRAMES (- (loading-screen-clock) *loading-screen-since*))
                           LS_SIL_PERIOD)
                        LS_SIL_FRAMES))
               (col (the float (mod fr LS_SIL_COLS)))
               (row (the float (/ fr LS_SIL_COLS)))
               (du (/ 1.0 (the float LS_SIL_COLS)))
               (dv (/ 1.0 (the float LS_SIL_ROWS))))
          (set! *ls-sil-frame* (the int fr))
          (rhud-set-shader buf RHUD_TBP_LOADING_JAK)
          (let ((uv (new 'stack-no-clear 'vector)))
            (set! (-> uv x) (* col du))
            (set! (-> uv y) (* row dv))
            (set! (-> uv z) (* (+ col 1.0) du))
            (set! (-> uv w) (* (+ row 1.0) dv))
            (ls-quad buf
                     uv
                     (- cx (* 0.5 w512))
                     (- cy (* 0.5 h448))
                     (+ cx (* 0.5 w512))
                     (+ cy (* 0.5 h448))))))
        ;; --- 3. le texte localise, puis 4. les glyphes a SA largeur mesuree ---
        ;; `*common-text*` vaut #f tant que la banque n'est pas chargee (text-h.gc:1034) et
        ;; `lookup-text!` la dereferencerait : on garde. Et on demande le mode « #f si absent »
        ;; pour ne jamais peindre « UNKNOWN ID » a l'ecran.
        (when *common-text*
          (let ((str (lookup-text! *common-text* (text-id pc-text-loading) #t)))
            (when str
              ;; DE LA BOITE DE PLUME A L'ENCRE. `ls-text-width` rend l'avance TOTALE de la
              ;; chaine ; l'ENCRE dessinee, elle, s'arrete avant. Mesure sur l'image PRODUITE,
              ;; CINQ langues, 1920 px de large : le bord droit de l'encre tombe a 1680 quand la
              ;; boite de plume finit a 1694 -- **14 px, exactement le meme dans les cinq**, donc
              ;; une propriete du DERNIER CARACTERE et pas de la chaine.
              ;; Toutes les langues livrees terminent par « ... ». Ce retrait vaut la MOITIE de
              ;; l'avance d'un point : `ls-text-width "."` rend 7,73 unites de toile dans cette
              ;; configuration, et le retrait mesure en vaut 3,73 -- 3,7 % d'ecart. On retranche
              ;; donc une grandeur que le moteur CALCULE, jamais un nombre pose a la main, et la
              ;; prediction est refutable : le controle est la re-mesure de l'image apres coup
              ;; (elle est passee de -14/-17 px a l'ecart publie dans widths.txt).
              ;; RESERVE : une langue qui ne terminerait pas par un point verrait ce retrait
              ;; legerement faux. Les cinq mesurees terminent par « ... ».
              (let* ((trail (* 0.5 (ls-text-width "." LS_TEXT_SCALE)))
                     (w (- (ls-text-width str LS_TEXT_SCALE) trail))
                     (right (- (* LS_TEXT_RIGHT 512.0) trail)))
                (let ((word (lookup-text! *common-text* (text-id pc-text-loading-precursor) #t)))
                  (when word
                    (let ((adv (ls-draw-precursor buf word right (* LS_GLYPH_TOP 448.0) w fx)))
                      (when (not *ls-traced*)
                        (set! *ls-traced* #t)
                        ;; plusieurs lignes, parce qu'un appel GOAL est plafonne a 8 parametres.
                        ;; NATURE : des LONGUEURS. REPERE : la toile 512 pour les unites, et le
                        ;; framebuffer reel pour les pixels. CE QU'ELLES LISENT QUAND LE DEFAUT
                        ;; EST ABSENT : `texte-px` et `precurseur-px` egaux.
                        ;; `precurseur-*` est RELEVE sur les coordonnees des quads emis, jamais
                        ;; recalcule depuis la consigne.
                      (let ((ref (ls-text-width "Loading..." LS_TEXT_SCALE)))
                        (format 0
                                "LOADSCREEN-LAYOUT texte-w=~f ref-w=~f cible-w=~f ratio=~f~%"
                                w
                                ref
                                LS_TEXT_W_TARGET
                                (/ ref LS_TEXT_W_TARGET)))
                      (format 0 "LOADSCREEN-GEOM droite=~f glyphes-adv-em=~f fx=~f~%" right adv fx)
                      (let* ((pxu (/ (the float (-> *pc-settings* framebuffer-width)) 512.0))
                             (pw (- *ls-precursor-x1* *ls-precursor-x0*)))
                        (format 0
                                "LOADSCREEN-WIDTH texte-u=~f precurseur-u=~f texte-px=~f precurseur-px=~f ecart-px=~f rxs=~f~%"
                                w
                                pw
                                (* w pxu)
                                (* pw pxu)
                                (* (- pw w) pxu)
                                (-> *video-parms* relative-x-scale)))
                      ;; PIXELLISATION : combien de pixels de l'atlas pour un pixel d'ecran.
                      ;; > 1 = l'atlas est REDUIT a l'affichage (bon). < 1 = il est AGRANDI, et
                      ;; c'est l'escalier que l'owner a vu. Le filtrage est publie a cote : le
                      ;; TEX1 pose par `rhud-set-shader` vaut #x60, soit BILINEAIRE, et
                      ;; DirectRenderer.cpp:444-447 le traduit en GL_LINEAR (+ mipmaps).
                      (let ((pxu (/ (the float (-> *pc-settings* framebuffer-width)) 512.0)))
                        (format 0 "LOADSCREEN-GLYPH atlas-px-par-px-ecran=~f em=~f filtrage=bilineaire~%"
                                (/ 1.0 (* *ls-precursor-scale* pxu))
                                LS_PRECURSOR_EM))
                      (format 0 "LOADSCREEN-SIL images=~D cols=~D rangees=~D boucle-ticks=~D~%"
                              LS_SIL_FRAMES LS_SIL_COLS LS_SIL_ROWS LS_SIL_PERIOD)))))
                ;; le texte en DERNIER : `draw-string` repose ses propres registres GS.
                (draw-string-xy-scaled str
                                       buf
                                       (the int (- right w))  ;; = bord gauche de la boite de plume
                                       (the int (* LS_TEXT_TOP 224.0))
                                       (font-color white)
                                       (font-flags kerning large)
                                       LS_TEXT_SCALE))))))))
  (none))
