;;-*-Lisp-*-
(in-package goal)
(require "pc/hud-classes-pc.gc")
(require "engine/ui/text.gc")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Gloading-screen -- LE DESSIN (owner 2026-08-28, maquette fournie)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; La PORTE (quand dessiner) vit dans engine/game/main.gc : `loading-screen-held?` /
;; `loading-screen-shown?`, armees par la seule barriere de chargement. Ici, on ne fait que
;; peindre. Ce fichier ne decide de rien.
;;
;; POURQUOI CE FICHIER PEINT SON PROPRE NOIR. Le noir du moteur n'est pas un sprite : c'est un
;; quad plein ecran dessine par l'etage PCRTC APRES tous les buckets -- OpenGLRenderer.cpp:1937
;; sur bureau, android_opengl_renderer.cpp:1602 sur telephone. Rien de ce que GOAL emet dans un
;; bucket ne peut donc apparaitre par-dessus. main.gc eteint `bg-a-force` pendant la barriere et
;; c'est nous qui posons le fond.
;;
;; POURQUOI 512x224 EST BIEN L'ECRAN ENTIER, A TOUT FORMAT. Le nuanceur de sommets du chemin
;; direct (shaders/direct2.vert) fait `x_ndc = (x_gs*16 - 0x8000)/0x1000`, donc x_gs 1792..2304
;; -- 512 unites -- couvre [-1,1] quelle que soit la largeur de fenetre ; et `y *= SCISSOR_ADJUST`
;; avec SCISSOR_ADJUST = 512/448 pour jak1 (Shader.cpp:408) amene les 224 lignes exactement sur
;; [-1,1]. Aucune barre ne peut rester sur les cotes.
;;
;; DEUX REPERES, A NE PAS MELANGER :
;;   - le texte (`draw-string-xy-scaled`) et `draw-sprite2d-xy` travaillent en 512 x 224 ;
;;   - `rhud-add-vert` travaille en 512 x 448 (il fait `y_gs = 1936 + 0.5*py`).
;; Les fractions d'ecran ci-dessous sont donc multipliees par 224.0 ou par 448.0 selon l'appelant,
;; jamais par les deux.

;; Slots VRAM ou le runtime PC charge les deux images (RechargedHudTextures.cpp, base 8300).
(defconstant RHUD_TBP_LOADING_JAK 8311)
(defconstant RHUD_TBP_LOADING_PRECURSOR 8312)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; GEOMETRIE -- MESUREE SUR LA MAQUETTE DE L'OWNER, PAS CHOISIE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Toutes ces valeurs sortent de .autoport/mk_loading_assets.py applique a
;; .autoport/design/loading-screen-owner-mockup.png (1672x941, rapport 1,7768 -- 16:9 a 0,06 %).
;; Elles sont en FRACTIONS d'ecran, donc independantes de la resolution.
;;
;; RESERVE DECLAREE : le contrat de phase ecrit « ~40 % de la hauteur d'ecran » pour la
;; silhouette ; la maquette de l'owner en mesure 61,2 %. On reproduit LA MAQUETTE, parce que
;; c'est l'artefact qu'il a depose lui-meme, et la prose la resume de memoire. Une seule ligne a
;; changer si l'owner prefere son chiffre : LS_SIL_H.
(defconstant LS_SIL_CX 0.272129)   ;; centre x de la silhouette
(defconstant LS_SIL_CY 0.519660)   ;; centre y de la silhouette
(defconstant LS_SIL_H 0.847035)    ;; hauteur de la CELLULE de planche / hauteur d'ecran.
                                   ;; La maquette de l'owner mesure le SUJET a 0,612115 de la
                                   ;; hauteur d'ecran ; le sujet occupe 0,7227 de la HAUTEUR de sa
                                   ;; cellule -- une foulee de course l'etale, il est plus LARGE
                                   ;; que haut (rapport 1,30) et la cellule est carree, avec une
                                   ;; marge transparente obligatoire sinon les mipmaps de la
                                   ;; planche melangent deux images voisines. 0,612115 / 0,7227.
                                   ;; POSEE par gls_apply_silhouette_constants.py depuis la mesure
                                   ;; du montage, jamais recopiee a la main.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; LA SILHOUETTE EST UNE SEQUENCE ANIMEE (owner 2026-08-29, retour n.3)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; « la silhouette de Jak and Daxter en train de courir lateralement vers la droite... bah c'est
;; pas anime ! J'avais explicitement demande de capturer cette animation in game. »
;;
;; `recharged_assets/loading_jak.png` n'est plus une image : c'est une PLANCHE de LS_SIL_COLS x
;; LS_SIL_ROWS cellules de taille egale, produite par .autoport/mk_loading_silhouette.py depuis
;; une capture en jeu de l'animation de course reelle. Les cellules sont parcourues en
;; ligne d'abord, de 0 a LS_SIL_FRAMES-1.
;;
;; L'HORLOGE EST `(loading-screen-clock)`, PAS UN COMPTEUR DE FRAMES ET PLUS `(current-time)`.
;; `*loading-screen-frames*` avancerait d'un pas par image produite : la course serait deux fois
;; plus rapide a 60 images/s qu'a 30, or 30 ou moins est precisement le regime d'un chargement.
;;
;; ET `(current-time)` NE CONVIENT PAS NON PLUS, POUR UNE RAISON QUI SE LIT DANS LE CODE :
;; engine/draw/drawable.gc:1013 met son increment sous `(when (not (paused?)))`, et `paused?`
;; (main.gc:608) est vrai des que le menu est ouvert -- donc pendant le chargement d'une partie
;; lance depuis ce menu. La silhouette y serait EXACTEMENT figee, et le seuil de 0,5 s jamais
;; franchi. Le detail complet, avec la refutation de `real-frame-counter` (que game-save.gc:631
;; REMPLACE au milieu d'un chargement de partie), est dans engine/game/main-h.gc.
;;
;; UNITE : 1/300 s, la meme que `(seconds x)` -- et elle NE DEPEND PAS du reglage de frequence
;; d'images du joueur, contrairement a `real-integral-frame-counter` que j'avais pris d'abord et
;; que la ligne de controle a refute (facteur 2 EXACT a 30 images/s). `LS_SIL_PERIOD` s'ecrit donc
;; en 300emes de seconde : la periode mesuree a la capture, en frames de logique a 60 Hz, vaut
;; CINQ FOIS ce nombre.
;;
;; RESERVE DECLAREE, ET ELLE N'EST PAS REPARABLE ICI : sur l'appareil, l'increment de cette
;; horloge est plafonne a 4 frames par frame rendue et le retard est JETE
;; (android/gk_android_main.cpp:787-789, :793-799, :833-835). Une frame plus longue que 66,7 ms
;; fait donc passer la boucle au ralenti, quelle que soit l'horloge choisie. C'est pour cela que
;; le vrai correctif du gel est ailleurs -- dans la taille des tranches du chargeur bloquant,
;; game/graphics/opengl_renderer/loader/Loader.h:kLoadingScreenSliceMs -- et que la mesure du
;; gel, elle, est prise cote C++ sur une VRAIE horloge (`LOADSCREEN-GAP`).
(defconstant LS_SIL_COLS 4)
(defconstant LS_SIL_ROWS 4)
(defconstant LS_SIL_FRAMES 16)
(defconstant LS_SIL_PERIOD 175)
;; 175 = 35 frames de logique a 60 Hz x 5, soit 0,5833 s. UNITE : 1/300 s, celle de
;; `loading-screen-clock`. La conversion x5 se fait en UN SEUL endroit,
;; .autoport/gls_apply_silhouette_constants.py, qui lit la valeur dans le rapport du montage et la
;; pose ici -- pas de transcription a la main, c'est ainsi qu'on perd un facteur.
;;
;; ELLE EST MESUREE SUR L'ANIMATION, PAS SUR LES PIXELS, ET LE PIEGE EST NOMME. `eichar-run` fait
;; 16 frames de donnees et avance de 0,4311 frame d'animation par frame de logique a la vitesse de
;; course pleine : la periode vaut donc 15 / 0,4311 = 34,79 frames de logique. Le second
;; instrument, la similarite d'images, rend 17 -- soit P/2 a 2,3 % pres, parce qu'une silhouette
;; vue de COTE se repete presque a la DEMI-foulee (les deux jambes donnent un contour voisin).
;; Boucler sur 17 ferait sauter la jambe la plus proche a chaque demi-cycle. Le montage publie les
;; deux et REFUSE de livrer s'ils ne s'accordent ni sur P ni sur P/2.
;; LE CYCLE PRECEDENT LIVRAIT 32 : ni 17 ni 35. C'etait 16 cellules x un pas ENTIER de 2, un
;; nombre choisi pour sa commodite. Les cellules sont maintenant placees a round(k.P/16), donc la
;; boucle se referme EXACTEMENT sur une periode ; raccord mesure 0,00944 contre 0,04637 pour le
;; pire depart possible de la meme fenetre.
(defconstant LS_SIL_WH 1.0)                ;; largeur/hauteur d'UNE cellule de la planche

(defconstant LS_TEXT_RIGHT 0.8822) ;; bord DROIT de la bande « Loading... » (x 1475 / 1672)
(defconstant LS_TEXT_TOP 0.7216)   ;; haut de la bande de texte (y 679 / 941)
(defconstant LS_TEXT_SCALE 1.3876)  ;; grande police. CALIBREE, pas choisie -- et RECALIBREE le
                                    ;; 2026-08-29 quand la mesure de largeur a ete corrigee (voir
                                    ;; `ls-text-width`). La valeur precedente, 1,0407, avait ete
                                    ;; calee contre une largeur SUR-ESTIMEE de 4/3 : le texte etait
                                    ;; donc rendu 25 % plus petit que la maquette.
                                    ;; 111,16 / (0,75 x 106,8092) = 1,3876, ou 106,8092 est l'avance
                                    ;; de « Loading... » dans *font24-table* et 0,75 la valeur de
                                    ;; `relative-x-scale` en 16:9 -- le format de la maquette.

(defconstant LS_GLYPH_TOP 0.8268)  ;; haut de la bande de glyphes (y 778 / 941)

;; Largeur CIBLE de la bande « Loading... », mesuree sur la maquette : x 1113..1475 sur 1672, soit
;; 0,21711 de la largeur d'ecran, donc 111,16 unites de la toile 512.
;; C'EST CE NOMBRE QUI CALIBRE `LS_TEXT_SCALE`, et il se lit dans une TRACE, pas a l'oeil :
;; `LOADSCREEN-LAYOUT ... ratio=` publie largeur-rendue / cible. Le reglage est bon quand ce
;; ratio vaut 1. Les captures d'ecran ne servent pas de verdict ici.
(defconstant LS_TEXT_W_TARGET 111.16)
;; `ratio=` de la trace se calcule sur la chaine ANGLAISE LITTERALE, jamais sur la chaine
;; localisee : la maquette a ete dessinee avec « Loading... », et la TAILLE de police doit rester
;; la meme dans toutes les langues -- c'est la LARGEUR qui varie d'une langue a l'autre, et c'est
;; voulu. Calibrer sur « Chargement... » retrecirait le francais pour le faire tenir dans la
;; largeur de l'anglais. La trace publie donc les deux : `texte-w` (la langue courante, ce qui est
;; reellement dessine) et `ref-w` (l'anglais, la base de calibration).

;; Table de glyphes precurseurs, A..Z, EXTRAITE de recharged_assets/font/precursor/precursor.json,
;; elle-meme produite par .autoport/mk_precursor_atlas.py depuis la planche fournie par l'owner.
;; Les valeurs sont recopiees, jamais recalculees. L'avance `adv` est une CONVENTION declaree
;; (largeur + 0,16 em) : la planche est une grille de presentation et ne porte aucune metrique
;; d'origine.
;;
;; ATLAS REFAIT LE 2026-08-29, SUR DEUX DEFAUTS MESURES QUE L'OWNER A VUS :
;;   1. POLARITE. L'ancienne generation devinait la polarite PAR GLYPHE (« l'encre est
;;      minoritaire ») ; faux pour les formes pleines, donc E, G, H, K, M, P et S -- exactement
;;      les sept dont l'encre couvre plus de la moitie de la boite -- etaient retournes
;;      (fond blanc, glyphe noir). Elle est maintenant etablie UNE SEULE FOIS sur la planche.
;;   2. PIXELLISATION. L'atlas livre etait STRICTEMENT BINAIRE (2 niveaux de gris, 0 pixel
;;      intermediaire) alors que la planche source est antialiasee, et ses glyphes ne faisaient
;;      que 33 a 63 px de large pour un rendu ecran de 52 a 61 px : un agrandissement de ~1,1x
;;      d'un masque binaire. Em porte de 72 a 288 px, antialiasing conserve : le rendu ecran est
;;      desormais une REDUCTION (~0,24x), jamais un agrandissement.
;; Em de dessin : 288 px. Atlas : 2048x2048.
(defconstant LS_PRECURSOR_EM 288.0)

