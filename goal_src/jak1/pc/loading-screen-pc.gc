(define *ls-precursor-uv*
  (new 'static 'inline-array vector 26
       (new 'static 'vector :x 0.003906 :y 0.003906 :z 0.101562 :w 0.138672) ;; A
       (new 'static 'vector :x 0.134766 :y 0.003906 :z 0.244141 :w 0.138672) ;; B
       (new 'static 'vector :x 0.265625 :y 0.003906 :z 0.332031 :w 0.140625) ;; C
       (new 'static 'vector :x 0.396484 :y 0.003906 :z 0.490234 :w 0.144531) ;; D
       (new 'static 'vector :x 0.527344 :y 0.003906 :z 0.621094 :w 0.140625) ;; E
       (new 'static 'vector :x 0.658203 :y 0.003906 :z 0.732422 :w 0.138672) ;; F
       (new 'static 'vector :x 0.003906 :y 0.152344 :z 0.109375 :w 0.283203) ;; G
       (new 'static 'vector :x 0.134766 :y 0.152344 :z 0.203125 :w 0.292969) ;; H
       (new 'static 'vector :x 0.265625 :y 0.152344 :z 0.388672 :w 0.283203) ;; I
       (new 'static 'vector :x 0.396484 :y 0.152344 :z 0.511719 :w 0.277344) ;; J
       (new 'static 'vector :x 0.527344 :y 0.152344 :z 0.619141 :w 0.277344) ;; K
       (new 'static 'vector :x 0.658203 :y 0.152344 :z 0.769531 :w 0.283203) ;; L
       (new 'static 'vector :x 0.003906 :y 0.300781 :z 0.097656 :w 0.429688) ;; M
       (new 'static 'vector :x 0.134766 :y 0.300781 :z 0.210938 :w 0.431641) ;; N
       (new 'static 'vector :x 0.265625 :y 0.300781 :z 0.353516 :w 0.427734) ;; O
       (new 'static 'vector :x 0.396484 :y 0.300781 :z 0.460938 :w 0.431641) ;; P
       (new 'static 'vector :x 0.527344 :y 0.300781 :z 0.634766 :w 0.423828) ;; Q
       (new 'static 'vector :x 0.658203 :y 0.300781 :z 0.740234 :w 0.419922) ;; R
       (new 'static 'vector :x 0.003906 :y 0.449219 :z 0.072266 :w 0.570312) ;; S
       (new 'static 'vector :x 0.134766 :y 0.449219 :z 0.226562 :w 0.574219) ;; T
       (new 'static 'vector :x 0.265625 :y 0.449219 :z 0.353516 :w 0.570312) ;; U
       (new 'static 'vector :x 0.396484 :y 0.449219 :z 0.519531 :w 0.572266) ;; V
