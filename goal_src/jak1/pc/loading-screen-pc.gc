       (new 'static 'vector :x 45.0000 :y 62.0000 :z 56.5200) ;; U
       (new 'static 'vector :x 63.0000 :y 63.0000 :z 74.5200) ;; V
       (new 'static 'vector :x 54.0000 :y 63.0000 :z 65.5200) ;; W
