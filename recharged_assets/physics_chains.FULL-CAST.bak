# ---- Klaww / the ogre boss (village2 cutscenes + the Snowy Mountain fight) ----
# Naughty Dog literally named these joints "Dangler": this rig is the single clearest case in the
# game of the owner's "objets suspendus/attaches" plus "les ventres des personnages en surpoids"
# (`stomach`). The beard is declared as FOUR single-joint chains rather than one 4-link strand
# because `beardCluster` reads as a cluster of separate strands and the shipped hierarchy could not
# be verified offline: a single-joint chain springs correctly under EITHER topology, where a
# mis-declared 4-link chain would be dropped whole. Each strand still hangs off its own animated
# parent, so the result is the same beard motion with one less assumption.
[model ogreboss-lod0 ogreboss-village2-lod0]
chain beardA class=primary stiffness=2.2 damping=0.24 gravity=0.30 maxangle=22 inertia=1.0 stretch=0.02 radius=70 anim=excite excite=0.5 hang=0 family=A radii=260
j beardA
chain beardB class=primary stiffness=2.2 damping=0.24 gravity=0.30 maxangle=22 inertia=1.0 stretch=0.02 radius=70 anim=excite excite=0.5 hang=0 family=A radii=260
j beardB
chain beardC class=primary stiffness=2.2 damping=0.24 gravity=0.30 maxangle=22 inertia=1.0 stretch=0.02 radius=70 anim=excite excite=0.5 hang=0 family=A radii=260
j beardC
chain beardD class=primary stiffness=2.2 damping=0.24 gravity=0.30 maxangle=22 inertia=1.0 stretch=0.02 radius=70 anim=excite excite=0.5 hang=0 family=A radii=260
j beardD
chain chestDanglerL class=secondary stiffness=3.0 damping=0.40 gravity=0.60 maxangle=14 inertia=1.0 stretch=0.01 radius=40 gradient=0.6 hang=0.25 family=B radii=24,24,24
j LchestDanglerA
j LchestDanglerB
j LchestDanglerC
chain chestDanglerR class=secondary stiffness=3.0 damping=0.40 gravity=0.60 maxangle=14 inertia=1.0 stretch=0.01 radius=40 gradient=0.6 hang=0.25 family=B radii=24,24,24
j RchestDanglerA
j RchestDanglerB
j RchestDanglerC
chain chestDangleL class=secondary stiffness=3.0 damping=0.40 gravity=0.60 maxangle=14 inertia=1.0 stretch=0.01 radius=40 gradient=0.6 hang=0.25 family=B radii=260
j LchestDangleA
chain chestDangleR class=secondary stiffness=3.0 damping=0.40 gravity=0.60 maxangle=14 inertia=1.0 stretch=0.01 radius=40 gradient=0.6 hang=0.25 family=B radii=260
j RchestDangleA
chain backDangler class=secondary stiffness=3.0 damping=0.40 gravity=0.60 maxangle=18 inertia=1.0 stretch=0.03 radius=40 gradient=0.6 family=B hang=0.50 radii=24,24
j backDanglerA
j backDanglerB
chain armDangler class=secondary stiffness=3.0 damping=0.40 gravity=0.60 maxangle=18 inertia=1.0 stretch=0.03 radius=40 gradient=0.6 family=B hang=0.50 radii=24,24
j RarmDangler
j RarmDanglerToo
chain hairFrontL class=primary stiffness=2.2 damping=0.24 gravity=0.25 maxangle=24 inertia=1.0 stretch=0.02 radius=60 rootlock=0 gradient=1 hang=0 family=A radii=260,260 xchain=hairFrontR
j LhairFrontA
j LhairFrontB
chain hairFrontR class=primary stiffness=2.2 damping=0.24 gravity=0.25 maxangle=24 inertia=1.0 stretch=0.02 radius=60 rootlock=0 gradient=1 hang=0 family=A radii=260,260 xchain=hairFrontL
j RhairFrontA
j RhairFrontB
chain belly class=secondary stiffness=2.15 damping=0.30 gravity=0.05 maxangle=10 inertia=1.0 stretch=0.01 radius=120 mass=3.2 swing=0.45 couple=2.6 hang=0 family=A radii=260
j stomach
chain shackle class=accessory stiffness=4.4 damping=0.40 gravity=0.50 maxangle=12 inertia=1.0 stretch=0.02 radius=40 family=B hang=0.50 radii=260
j Lshackle
