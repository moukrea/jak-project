[model jak-hd]
# owner cycle-3 D: "c'est juste le BOUT DU BOUT de sa coiffe qui bouge". The chain is TWO joints and
# rootlock=1 pinned the first, so exactly one link could ever move. Root freed (the retired colskip=1 kept it
# out of the skull volume it is glued to) + a wider cone: the whole strand bends, the root still
# rides the skull because its position is constrained to the animated anchor.
chain hair class=primary stiffness=2.4 damping=0.26 gravity=0.15 maxangle=26 inertia=1.0 stretch=0.02 radius=80 rootlock=0 gradient=1 rootfree=0.5 hang=0 family=A radii=260,260 xchain=collarL,collarR,earL,earR
j MhairA
j MhairB
# owner cycle-3 E: Jak's EARS get a LIGHT physics, and owner cycle-3 A names them as the case where
# the authored animation must WIN — ND acts with these bones (they react, they pin back). authored=
# is deliberately low (0.12 of chain length) and authstiff high: the moment the animator touches
# them the sim hands over, and gives the bone back progressively when the action ends.
chain earL class=secondary stiffness=3.2 damping=0.30 gravity=0.05 maxangle=11 inertia=1.0 stretch=0.015 radius=40 rootlock=0 gradient=1 rootfree=0.5 authored=0.35 authrise=12 authfall=3 authstiff=6 hang=0 family=A radii=172,196 xchain=collarL,collarR,earR,hair
j Learbase
j Learmid
chain earR class=secondary stiffness=3.2 damping=0.30 gravity=0.05 maxangle=11 inertia=1.0 stretch=0.015 radius=40 rootlock=0 gradient=1 rootfree=0.5 authored=0.35 authrise=12 authfall=3 authstiff=6 hang=0 family=A radii=172,188 xchain=collarL,collarR,earL,hair
j Rearbase
j Rearmid
chain collarL class=secondary stiffness=3.0 damping=0.33 gravity=0.2 maxangle=12 inertia=1.0 stretch=0.02 radius=60 hang=0.3 family=B radii=260 xchain=earL,earR,hair
